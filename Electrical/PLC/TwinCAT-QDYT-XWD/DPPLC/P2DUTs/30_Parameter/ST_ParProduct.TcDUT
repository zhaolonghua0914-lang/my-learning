         fGMInterval                            :REAL:=2 ;     //隔膜间距
         iRunMode                               :UINT;   //运行模式    1：空跑隔膜    2：不带隔膜整机空跑   3：只跑1#      4::连续制片模式     5：标准模式      
         iMainVel                                  :UINT;  //运行速度 PPM (最大值180)          整机效率=iMainVel*4  

         
       

