  <DUT Name="conAn_date" Id="{8bb7fa6c-9ef7-4108-969f-b247adc70907}">
    <Declaration><![CDATA[TYPE conAn_date ://正极取片
STRUCT
	
	An_GohomeHMI:BOOL;//正极回原点启动
	An_GohomeDone:BOOL;//正极回原点完成
