	P3ShortTestRec: 	ShortTestReceiveData;  //短路测试返回数据
	P3ShortTestSend  : 	ShortTestSendData;  //短路测试发送数据
	
	P3ShortSendCrtl AT  %Q*:    ST_SendTestStatus;//发送控制字
	P3ShortReCrtl   AT  %I*: 	ST_ReceiveTestStatus;//接收控制字
	
	Pass1:BOOL;//强制下料到1#；
