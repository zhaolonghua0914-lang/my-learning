	I702 AT %I* :ARRAY [1..16] OF BOOL; //输入信号
	I703 AT %I* :ARRAY [1..16] OF BOOL; //输入信号
	
	Q601 AT %Q* :ARRAY [1..16] OF BOOL; //输出信号
	Q602 AT %Q* :ARRAY [1..16] OF BOOL; //输出信号
	Q603 AT %Q* :ARRAY [1..16] OF BOOL; //输出信号
