    <Declaration><![CDATA[
VAR_GLOBAL
	
//P3 输入、输出信号
    I601 AT %I* :ARRAY [1..16] OF BOOL; //输入信号
	I602 AT %I* :ARRAY [1..16] OF BOOL; //输入信号
