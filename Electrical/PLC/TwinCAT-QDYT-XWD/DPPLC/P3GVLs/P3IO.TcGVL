	Q702 AT %Q* :ARRAY [1..16] OF BOOL; //输出信号
	AI60 AT %I* :ARRAY [0..3] OF INT; //模拟量输入信号
	AO60 AT %Q* :ARRAY [0..3] OF INT; //模拟量输出信号	
	chengzhong		AT %I*  : 	USINT;//称重临时用
