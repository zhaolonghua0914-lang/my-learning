	(*欧姆龙驱动器力矩模式
	输出：
		6071 目标扭矩  INT16    0.1%  -5000~5000   （建议设置为PDO
		6072 最大扭矩 UINT16    0.1%  0~5000		（建议在驱动器中设置好
		3031 -01  力矩模式下的速度限制 单位rpm ，0-20000  INT32   出厂20000
	输入：当前力矩 6072
	*)
	(*
(*0821增加张力伺服参数*)
	iTartgetTorque	AT%Q*:ARRAY[2..2]OF INT:=[-80,80];		(*单位为0.1%*)
	iMaxVelo		AT%Q*:ARRAY[2..2]OF UDINT:=NumOfDancers[8000];	(*单位为0.1rpm*)
	iActualTorque	AT%I* :ARRAY[2..2]OF  INT;							(*单位为0.1%*)
	iSetDriveMode 	AT %Q*		:ARRAY [1..NumOfDrives] OF SINT := NumOfDrives[CSP];	(*驱动器的模式输出，8为位置模式*)
*)





]]></Declaration>
  </GVL>
</TcPlcObject>