//预留数据交互
YL_I      		    AT %I*:ARRAY[1..50] OF BOOL ; //预留 1、气压不足报警；2、叠台一储气罐压力、3、叠台二储气罐压力、4、叠台三储气罐压力
YL_Q     				AT %Q*:ARRAY[1..50] OF BOOL ; //预留输；
YL_INT1     		AT %I*:ARRAY[1..50] OF INT  ; //预留输入INT；
YL_INT2     		AT %Q*:ARRAY[1..50] OF INT  ; //预留输出INT；
YL_GVL  :ARRAY [1..60] OF BOOL;//内部预留；1.叠台一正极送片流水线安全点动条件 2.叠台一负极送片流水线安全点动条件 3.叠台二正极送片流水线安全点动条件 4.叠台二负极送片流水线安全点动条件 5.叠台三正极送片流水线安全点动条件 6.叠台三负极送片流水线安全点动条件

//风机；
 dDrauFan                   :ARRAY[1..30] OF BOOL;   	// 风机  1、风机1开 ；2、风机2开；


//网络拓扑状态
