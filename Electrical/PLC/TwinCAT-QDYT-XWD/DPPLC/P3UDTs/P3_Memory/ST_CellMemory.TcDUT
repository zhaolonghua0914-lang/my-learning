Classes					 :STRING;//班次
Cell_result				 :INT;//综合评定结果;1、OK 2、短路NG 3、测厚NG 4、扫码NG
An_stuff_No				 :STRING;//正极极卷号，1、同卷，2、异卷
Ca_stuff_No				 :STRING;//负极极卷号，1、同卷，2、异卷
