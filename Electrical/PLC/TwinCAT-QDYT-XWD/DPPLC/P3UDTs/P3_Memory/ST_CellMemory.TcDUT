DTcadescendh	 : REAL ;// 	叠台负极片下降高度
Shortpress	 : REAL ;// 	短路测试压力（Kg)
coldActPos	 : REAL ;// 	冷压板实际位置
HeatActPos	 : REAL ;// 	热压板实际位置
Chipdata   :ARRAY[1..240]  OF Mes2 ;//极片数据                               	
END_STRUCT
END_TYPE
