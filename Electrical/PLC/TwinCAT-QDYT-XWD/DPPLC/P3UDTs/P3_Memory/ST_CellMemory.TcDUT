P3CellCode			:STRING(49);//后段二维码胶条码	
P3BlueCode			:STRING(49);//后段蓝胶条码		

ColdPress_PVTime			 :UINT;//冷压时间实际值
OvenTemp_NO              :INT;// 预热工位号
OvenTemp_PVTime			 :UDINT;//预热实际时间
HotPress_PVTime			 :UINT;//热压时间实际值

DiaphragmUnwindingTension2		:ARRAY[1..240]  OF	REAL	;//	隔膜放卷张力每一片
DTDebugMode           :BOOL;//叠台调试模式    

//20240417WCZ
LYDLineinitPos	 : REAL ;// 	左压刀开合初始位
