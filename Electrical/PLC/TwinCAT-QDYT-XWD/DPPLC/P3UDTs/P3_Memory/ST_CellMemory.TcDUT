An_MQ_Slice				 :ARRAY[1..120]  OF		ST_BeltData;//正极模切极片数据
Ca_MQ_Slice				 :ARRAY[1..120]  OF		ST_BeltData;//负极模切极片数据
Overhang_TF 			 :BOOL;//对齐度NG踢废信号

core_final_result                       :  STRING(1024)  ;   // 电芯最终结果  
DP_PLC_Evaluation_result                :  STRING(1024)  ;   // 叠片PLC评定结果  
DP_MES_Evaluation_result                :  STRING(1024)  ;   // 叠片MES接口评定结果  
RY_PLC_Evaluation_result                :  STRING(1024)  ;   // 热压PLC评定结果
RY_MES_Evaluation_result                :  STRING(1024)  ;   // 热压MES接口评定结果
DP_NG_particulars                       :  STRING(1024)  ;   // 叠片NG详情    
RY_NG_particulars                       :  STRING(1024)  ;   //  热压NG详情 

DP_Internal_decision_details            :  STRING(1024)  ;   // 叠片内部判定详情
DP_External_decision_details            :  STRING(1024)  ;   // 叠片外部判定详情 
RY_Internal_decision_details            :  STRING(1024)  ;   // 热压内部判定详情 
RY_External_decision_details            :  STRING(1024)  ;   // 热压外部判定详情

//PC写给PLC的-----先下发给叠台，叠台再和模切做通讯
PostiveCode			:STRING(49);//正极条码		
NegativeCode			:STRING(49);//负极条码		
Station_Code			:STRING(49);//叠台隔膜条码		
