  (****Status**)
   SaveParaOK:                      BOOL;           //保存参数OK
   PIDON:                             BOOL;          //PID功能开启
   AutoTuningON:                  BOOL;          //自整定开启
   AutoTuningerr:                   BOOL;          //自整定故障
   HeatingON:                       BOOL;          //加热中
   CoolingON:                       BOOL;          //制冷中
   AutoTuningOK:                  BOOL;          //自整定OK

END_STRUCT
END_TYPE
]]></Declaration>
