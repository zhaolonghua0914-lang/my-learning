	fAcc:=                       8000 , //  stP4CutCtrl.fAcc
	fDec:=                      8000 , //stP4CutCtrl.fDec
	Delay_Time:=             T#5S , 
	bHomed=>               stP4CutCtrl.bHomed  , 
	Pos_Done=>             stP4CutCtrl.Pos_Done, 
	Home_Alm=>            stP4CutCtrl.Home_Alm, 
	Pos_Alm=>                stP4CutCtrl.Pos_Alm , 
	stJXCE:=                    stP4Cut                    );
stP4Cut.in_Act_Pos;


//stP4CutCtrl.bStop:=(stP4CutCtrl.Home_Alm OR   stP4CutCtrl.Pos_Alm ) AND stSysState.bReset;


IF stSysState.bReset THEN
  IF  arrAxis[VirAxisNo.P2_VirTimeWind].Status.ControlLoopClosed  AND arrAxis[VirAxisNo.P2_VirTimeWind].Status.NotMoving   THEN
	  arrAxisPar[VirAxisNo.P2_VirTimeWind].fVelocity_of_Velo:=100;
	  arrAxisCtrl[VirAxisNo.P2_VirTimeWind].Cmd.bMoveVelo:=TRUE;
  END_IF
END_IF

