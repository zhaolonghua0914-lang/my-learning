    <Action Name="Pusle" Id="{87e0ff25-a954-4bba-9464-ae6c719d5af0}">
      <Implementation>
        <ST><![CDATA[(*
/////////////////////////////////////////时钟脉冲////////////////////////////////////////////////////////////
//fbPulseCtrl1(PT_OFF:=T#2MS, PT_ON:=T#2MS, Q=>, RT=>);
fbPulseCtrl[1](PT_OFF:=T#2MS, PT_ON:=T#2MS,   );
fbPulseCtrl[2](PT_OFF:=T#4MS, PT_ON:=T#4MS,    );
fbPulseCtrl[3](PT_OFF:=T#10MS, PT_ON:=T#10MS,   );

fbPulseCtrl[4](PT_OFF:=T#300MS, PT_ON:=T#300MS,   );
fbPulseCtrl[5](PT_OFF:=T#3S, PT_ON:=T#3S,    );
fbPulseCtrl[6](PT_OFF:=T#5S, PT_ON:=T#5S,   );
fbPulseCtrl[7](PT_OFF:=T#10S, PT_ON:=T#10S,  );
fbPulseCtrl[8](PT_OFF:=T#250MS, PT_ON:=T#250MS,   );

fbPulseCtrl[9](PT_OFF:=T#2S, PT_ON:=T#200MS,   );

fbPulseCtrl[1].Q;
fbPulseCtrl[1].RT;
fbPulseCtrl[2].Q;
fbPulseCtrl[2].RT;
fbPulseCtrl[3].Q;
fbPulseCtrl[3].RT;
fbPulseCtrl[4].Q;
fbPulseCtrl[4].RT;
fbPulseCtrl[5].Q;
fbPulseCtrl[5].RT;
fbPulseCtrl[6].Q;
fbPulseCtrl[6].RT;
fbPulseCtrl[7].Q;
fbPulseCtrl[7].RT;
fbPulseCtrl[8].Q;
fbPulseCtrl[8].RT;


IF bWaterOn AND ( bWaterOn2   OR    ABS( arrAxisCtrl[P1AxisNo.GMWind_U].Status.fActVelo)>=5 AND  ABS (arrAxisCtrl[P1AxisNo.GMWind_D].Status.fActVelo)>=5 )   THEN
  //P3EL2889S[3,5]:= fbPulseCtrl[9].Q;
   P1EL2889S[3,1]:= fbPulseCtrl[9].Q;
   P1EL2889S[3,2]:= fbPulseCtrl[9].Q;

   P2EL2889S[4,1]:=fbPulseCtrl[9].Q	;	
   P2EL2889S[4,2]:=fbPulseCtrl[9].Q;	

   P2EL2889S[4,3]:=fbPulseCtrl[9].Q	;	
   P2EL2889S[4,4]:=fbPulseCtrl[9].Q;	

ELSE
  //P3EL2889S[3,5]:= FALSE;
   P1EL2889S[3,1]:= FALSE;
   P1EL2889S[3,2]:= FALSE;
   P2EL2889S[4,1]:= FALSE	;	
   P2EL2889S[4,2]:= FALSE;	

   P2EL2889S[4,3]:=FALSE	;	
   P2EL2889S[4,4]:=FALSE;	
END_IF


//P1EL2889S[3,1]


*)













]]></ST>
      </Implementation>
    </Action>
    <Action Name="TempBasic" Id="{57d4ab82-770c-4f71-bb9a-03580deee2f7}">
      <Implementation>
        <ST><![CDATA[

FOR i:=1 TO MaxTemp DO   //显示温度转换
	IF TempPVs[i].iPV1<>9999 THEN
		TempPVs[i].fPV1:=TempPVs[i].iPV1/10;	
	ELSE
		TempPVs[i].fPV1:=999.9;
	END_IF
    arrTempCtrl[i].fPVShow1:=TempPVs[i].fPV1;
	
	IF TempPVs[i].iPV2<>9999 THEN
		TempPVs[i].fPV2:=TempPVs[i].iPV2/10;
	ELSE
		TempPVs[i].fPV2:=999.9;
	END_IF
	 arrTempCtrl[i].fPVShow2:=TempPVs[i].fPV2;

	IF TempPVs[i].iPV3<>9999 THEN
		TempPVs[i].fPV3:=TempPVs[i].iPV3/10;
	ELSE
		TempPVs[i].fPV3:=999.9;
	END_IF
	 arrTempCtrl[i].fPVShow3:=TempPVs[i].fPV3;

	IF TempPVs[i].iPV4<>9999 THEN
		TempPVs[i].fPV4:=TempPVs[i].iPV4/10;
	ELSE
		TempPVs[i].fPV4:=999.9;
	END_IF
    arrTempCtrl[i].fPVShow4:=TempPVs[i].fPV4;
END_FOR

//温度控制
FOR i:=1 TO MaxTemp DO
     fbTemp[i](bReset:=P3_SystemRUN.bReset , ParTemp:=arrTempPar[i] , TempCtrl:=arrTempCtrl[i] );
END_FOR










































]]></ST>
      </Implementation>
    </Action>
