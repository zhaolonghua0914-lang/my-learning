 END_IF



//////////////////热压驱动电机条件


IF P3_SystemRUN.iMode=3 AND (arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] OR LREAL_TO_REAL(arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.fActPos)<=arrAxisParV2[P3AxisNo.P3_M2_OvenCarrying].arrTargetPoint[6]) 
