//贴胶下料冷压
IF NOT Permit_Cold_Press  AND NOT Cold_Press_Finish THEN
	PermitColdPressRack:=TRUE;//冷压允许上料信号
	ELSE
	PermitColdPressRack:=FALSE;	
END_IF
//烤箱下料至热压及冷压上料至烤箱
IF NOT Permit_Hot_Press AND NOT Hot_Press_Finish THEN
	PermitHotPressRack:=TRUE;//热压允许上料信号
	ELSE
	PermitHotPressRack:=FALSE;	
END_IF

//测厚平台上料
IF NOT Permit_Thickness AND NOT Thickness_Finish THEN
	Permit_ThicknessRack:=TRUE;
	ELSE
	Permit_ThicknessRack:=FALSE;
END_IF
//分拣放料
IF NOT Permit_TakeMaterial THEN
	Permit_BlankingRack:=TRUE;
	ELSE
	Permit_BlankingRack:=FALSE;
END_IF

//冷压下压条件
IF  arrAxisCtrl[P3AxisNo.P3M1_ColdpreSupPlateLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreSupPlateLine].Status.Homed 
AND P3Senser.P3_ColdEmptyPress AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[44] THEN
	b_Press_condition[1]:=TRUE;
	ELSE
	b_Press_condition[1]:=FALSE;		
END_IF

//热压下压条件
IF  arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.Homed 
AND P3Senser.P3_HotEmptyPress AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[45] THEN
	b_Press_condition[2]:=TRUE;
	ELSE
	b_Press_condition[2]:=FALSE;		
END_IF

//轴回原、点动、走定位条件
/////////////////////////////冷压上料夹平移电机条件
IF P3_SystemRUN.iMode=3 AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreRetracting].Cmd.arrbRealPoint[1] THEN
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.JogP_Condition:=TRUE;
   ELSE 
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.JogP_Condition:=FALSE;
 END_IF

IF P3_SystemRUN.iMode=3 AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreRetracting].Cmd.arrbRealPoint[1] THEN
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.JogN_Condition:=TRUE;
   ELSE 
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.JogN_Condition:=FALSE;
 END_IF
 
 IF arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Enabled AND NOT arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Error AND P3_SystemRUN.iMode=3 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Homed AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.NoMoving 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreRetracting].Cmd.arrbRealPoint[1] 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[1] 
(*OR  arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[5]   OR  arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[6] )*) THEN
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.GoPoint_Condition[1]:=TRUE;
   ELSE 
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.GoPoint_Condition[1]:=FALSE;
 END_IF
 
  IF arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Enabled AND NOT arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Error AND P3_SystemRUN.iMode=3 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Homed AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.NoMoving 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreRetracting].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[1] 
(*OR  arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[5]   OR  arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[6] *) THEN
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.GoPoint_Condition[2]:=TRUE;
   ELSE 
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.GoPoint_Condition[2]:=FALSE;
 END_IF
 
 IF arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Enabled AND NOT arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Error AND P3_SystemRUN.iMode=3 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Homed AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.NoMoving 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreRetracting].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[1] 
(*OR  arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[5]   OR  arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[6] *) THEN
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.GoPoint_Condition[3]:=TRUE;
   ELSE 
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.GoPoint_Condition[3]:=FALSE;
 END_IF
 
 IF arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Enabled AND NOT arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Error AND P3_SystemRUN.iMode=3 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Homed AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.NoMoving 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreRetracting].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[1] 
(*OR  arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[5]   OR  arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[6] *) THEN
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.GoPoint_Condition[4]:=TRUE;
   ELSE 
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.GoPoint_Condition[4]:=FALSE;
 END_IF
 
     IF arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Enabled AND NOT arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Error AND P3_SystemRUN.iMode=3 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Homed AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.NoMoving 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreRetracting].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[5]
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreUpDown].Cmd.arrbRealPoint[5] THEN
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.GoPoint_Condition[5]:=TRUE;
   ELSE 	
   arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Cmd.GoPoint_Condition[5]:=FALSE;
 END_IF
 
      IF arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Enabled AND NOT arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Error AND P3_SystemRUN.iMode=3 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Homed AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.NoMoving 
AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreRetracting].Cmd.arrbRealPoint[1] AND (arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[1] 
