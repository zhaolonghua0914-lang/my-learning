AND (arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] OR LREAL_TO_REAL(arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.fActPos)<=arrAxisParV2[P3AxisNo.P3_M2_OvenCarrying].arrTargetPoint[6]) 
AND (LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.fActPos)>=arrAxisPar[P3AxisNo.P3_M4_WeighLine].arrTargetPoint[1]) AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Cmd.arrbRealPoint[1] THEN
   arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.GoPoint_Condition[1]:=TRUE;
   ELSE 
