 END_IF

 IF  LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Status.fActPos) <= arrAxisPar[P3AxisNo.P3_TapeAdvance].arrTargetPoint[4] AND 
    ((*arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] OR*) LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.fActPos) >= (arrAxisPar[P3AxisNo.P3_M4_SortingoutCarrying].arrTargetPoint[7]-1)) AND
    ((*arrAxisCtrl[P3AxisNo.P3_M4_OffloadingUpDown].Cmd.arrbRealPoint[1] OR*) LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_OffloadingCarrying].Status.fActPos) <= (arrAxisPar[P3AxisNo.P3_M4_OffloadingCarrying].arrTargetPoint[3]+1)) THEN
   arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Cmd.GoPoint_Condition[7]:=TRUE;
   ELSE 
   arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Cmd.GoPoint_Condition[7]:=FALSE;
 END_IF

 IF  P3_SystemRUN.iMode=3 THEN
   arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Cmd.GoPoint_Condition[8]:=TRUE;
   ELSE 
   arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Cmd.GoPoint_Condition[8]:=FALSE;
 END_IF
 ///////////////////贴胶头进退电机条件
///////////////////贴胶头进退电机条件
 IF  P3_SystemRUN.iMode=3 AND NOT arrCyCtrl[P3CYNo.P3TapeLift].Status.ONState AND  arrCyCtrl[P3CYNo.P3TapeLift].Status.OFFState 
     AND arrCyCtrl[P3CYNo.P3TapeLift].Io.DOStatus2 AND NOT arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Io.biPosLimit THEN
  arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.JogP_Condition:=TRUE;
   ELSE 
   arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.JogP_Condition:=FALSE;
 END_IF	 

 IF  P3_SystemRUN.iMode=3 AND NOT arrCyCtrl[P3CYNo.P3TapeLift].Status.ONState AND  arrCyCtrl[P3CYNo.P3TapeLift].Status.OFFState 
     AND  arrCyCtrl[P3CYNo.P3TapeLift].Io.DOStatus2 AND NOT arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Io.biNegLimit THEN
  arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.JogN_Condition:=TRUE;
   ELSE 
   arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.JogN_Condition:=FALSE;
 END_IF	 
 
 IF  P3_SystemRUN.iMode=3 AND NOT arrCyCtrl[P3CYNo.P3TapeLift].Status.ONState AND  arrCyCtrl[P3CYNo.P3TapeLift].Status.OFFState 
     AND  arrCyCtrl[P3CYNo.P3TapeLift].Io.DOStatus2 THEN
     arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.GoPoint_Condition[1]:=TRUE;
  ELSE 
   arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.GoPoint_Condition[1]:=FALSE;
 END_IF	 
 
 IF  P3_SystemRUN.iMode=3 AND NOT arrCyCtrl[P3CYNo.P3TapeLift].Status.ONState AND  arrCyCtrl[P3CYNo.P3TapeLift].Status.OFFState 
     AND  arrCyCtrl[P3CYNo.P3TapeLift].Io.DOStatus2 THEN
     arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.GoPoint_Condition[2]:=TRUE;
  ELSE 
   arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.GoPoint_Condition[2]:=FALSE;
 END_IF	  
 
 IF  (arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Cmd.arrbRealPoint[1] OR  arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Cmd.arrbRealPoint[2] OR 
     arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Cmd.arrbRealPoint[3]) AND NOT arrCyCtrl[P3CYNo.P3TapeLift].Status.ONState 
     AND  arrCyCtrl[P3CYNo.P3TapeLift].Status.OFFState  AND  arrCyCtrl[P3CYNo.P3TapeLift].Io.DOStatus2 THEN
     arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.GoPoint_Condition[3]:=TRUE;
  ELSE 
   arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.GoPoint_Condition[3]:=FALSE;
 END_IF	 
 
 IF  P3_SystemRUN.iMode=3 AND NOT arrCyCtrl[P3CYNo.P3TapeLift].Status.ONState AND  arrCyCtrl[P3CYNo.P3TapeLift].Status.OFFState 
     AND  arrCyCtrl[P3CYNo.P3TapeLift].Io.DOStatus2 THEN
     arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.GoPoint_Condition[4]:=TRUE;
  ELSE 
   arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.GoPoint_Condition[4]:=FALSE;
 END_IF	 
 
//电芯平移气缸条件
IF arrCyCtrl[P3CYNo.P3CellPush].Status.OFFState  AND 
   LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Status.fActPos) <= (arrAxisPar[P3AxisNo.P3_TapeAdvance].arrTargetPoint[4]+5) AND
   (LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.fActPos) >= (arrAxisPar[P3AxisNo.P3_M4_SortingoutCarrying].arrTargetPoint[7]-1)) AND
   (LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_OffloadingCarrying].Status.fActPos) <= (arrAxisPar[P3AxisNo.P3_M4_OffloadingCarrying].arrTargetPoint[3]+1)) THEN
	arrCyCtrl[P3CYNo.P3CellAdvance].Cmd.OnCondition:=TRUE;
ELSE
	arrCyCtrl[P3CYNo.P3CellAdvance].Cmd.OnCondition:=FALSE;	
END_IF
	arrCyCtrl[P3CYNo.P3CellAdvance].Cmd.OFFCondition:=TRUE;	

IF arrCyCtrl[P3CYNo.P3CellPush].Status.OFFState  THEN
   arrCyCtrl[P3CYNo.P3CellAdvance].Cmd.OFFCondition:=TRUE;
ELSE  
   arrCyCtrl[P3CYNo.P3CellAdvance].Cmd.OFFCondition:=FALSE;
END_IF	
	
//拉胶气缸条件
IF arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Status.fActPos <= arrAxisPar[P3AxisNo.P3_TapeAdvance].arrTargetPoint[1]+0.5 AND
   arrCyCtrl[P3CYNo.P3TapeCut].Status.OFFState THEN
	arrCyCtrl[P3CYNo.P3TapeLift].Cmd.OnCondition:=TRUE;
ELSE
	arrCyCtrl[P3CYNo.P3TapeLift].Cmd.OnCondition:=FALSE;
END_IF
 
//切胶气缸条件
IF  arrCyCtrl[P3CYNo.P3TapeLift].Status.OFFState THEN
	arrCyCtrl[P3CYNo.P3TapeLift].Cmd.OnCondition:=TRUE;
ELSE
	arrCyCtrl[P3CYNo.P3TapeLift].Cmd.OnCondition:=FALSE;
END_IF

//电芯旋转气缸条件
IF  arrCyCtrl[P3CYNo.P3CellPushSpin].Io.DIOnSwitch OR arrCyCtrl[P3CYNo.P3CellPush].Io.DIOFFSwitch  THEN
	arrCyCtrl[P3CYNo.P3CellSpin].Cmd.OnCondition:=TRUE;
	arrCyCtrl[P3CYNo.P3CellSpin].Cmd.OFFCondition:=TRUE;
ELSE
	arrCyCtrl[P3CYNo.P3CellSpin].Cmd.OnCondition:=FALSE;
	arrCyCtrl[P3CYNo.P3CellSpin].Cmd.OFFCondition:=FALSE;
END_IF

//拉胶气缸条件
IF   arrAxisCtrl[P3AxisNo.P3_TapeAdvance].Cmd.arrbRealPoint[1]   THEN
	arrCyCtrl[P3CYNo.P3TapeLift].Cmd.OnCondition:=TRUE;
ELSE
	arrCyCtrl[P3CYNo.P3TapeLift].Cmd.OnCondition:=FALSE;
END_IF

//测厚台托板气缸条件
IF   arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Io.DIOnSwitch  THEN
	arrCyCtrl[P3CYNo.P3ThicknessSupport].Cmd.OnCondition:=TRUE;
	arrCyCtrl[P3CYNo.P3ThicknessSupport].Cmd.OFFCondition:=TRUE;
ELSE
	arrCyCtrl[P3CYNo.P3ThicknessSupport].Cmd.OnCondition:=FALSE;
	arrCyCtrl[P3CYNo.P3ThicknessSupport].Cmd.OFFCondition:=FALSE;
END_IF
//测厚台切换气缸条件
IF   arrCyCtrl[P3CYNo.P3ThicknessSupport].Io.DIOFFSwitch AND arrCyCtrl[P3CYNo.P3ThicknessPressure].Io.DIOFFSwitch THEN
	arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Cmd.OnCondition:=TRUE;
	arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Cmd.OFFCondition:=TRUE;
ELSE
	arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Cmd.OnCondition:=FALSE;
	arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Cmd.OFFCondition:=FALSE;
END_IF
//测厚台压板气缸条件
IF   arrCyCtrl[P3CYNo.P3ThicknessSupport].Io.DIOFFSwitch AND arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Io.DIOFFSwitch THEN
	arrCyCtrl[P3CYNo.P3ThicknessPressure].Cmd.OnCondition:=TRUE;
ELSE
	arrCyCtrl[P3CYNo.P3ThicknessPressure].Cmd.OnCondition:=FALSE;
END_IF






]]></ST>
    </Implementation>
    <LineIds Name="LateBlanking_Condition">
      <LineId Id="23594" Count="1783" />
      <LineId Id="25399" Count="1" />
      <LineId Id="25408" Count="19" />
      <LineId Id="25401" Count="6" />
      <LineId Id="3230" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>