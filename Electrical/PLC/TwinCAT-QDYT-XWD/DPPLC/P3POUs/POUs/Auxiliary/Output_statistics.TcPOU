//运行时间统计
P3TimeData(
	Alm:= b_Alarm[4] , 
	Wait:=P3_SystemRUN.iMode=3 AND NOT b_Alarm[4] , 
	Run:=P3_SystemRUN.iMode=1 , 
	XL_Wait:=(Step36=1910 OR Step36=1917 ) AND P3_SystemRUN.iMode=1  , 
	Query:=HDQuery, 
	date1:=HDdate , 	
	STTimedata=> );

//稼动率
OEE1(
	Alm:=M_Sys .p1state=4 OR  M_Sys .p1state=5 OR 
               P2M1_DTSysState.bErrorStop OR  P2M1_WJSysState.bErrorStop OR
               P2M2_DTSysState.bErrorStop OR  P2M2_WJSysState.bErrorStop OR
               P2M3_DTSysState.bErrorStop OR  P2M3_WJSysState.bErrorStop OR
               b_Alarm[4]  , 
	Wait:= , 
	Run:=  M_Sys .p1state=1 AND
                 P2M1_MachCtrl.U.DT_iMode=1 AND P2M1_MachCtrl.U.WJ_iMode=1 AND P2M1_MachCtrl.U.TJ_iMode=1 AND 
                 P2M2_MachCtrl.U.DT_iMode=1 AND P2M2_MachCtrl.U.WJ_iMode=1 AND P2M2_MachCtrl.U.TJ_iMode=1  AND
                 P2M3_MachCtrl.U.DT_iMode=1 AND P2M3_MachCtrl.U.WJ_iMode=1 AND P2M3_MachCtrl.U.TJ_iMode=1   AND
                 P3_SystemRUN.iMode=1, 
	OEE=> OEE );
*)

