IF (arrTempCtrl[92].Tem_fPV>(arrTempPar[92].fTempSet+ABS(arrTempPar[92].fTempArea)) OR arrTempCtrl[92].Tem_fPV<(arrTempPar[92].fTempSet-ABS(arrTempPar[92].fTempArea))) AND NOT P3User2_Par.Oven_Shield[21] AND P3_SystemRUN.iMode=1 THEN
	P3_Tem_Error[92]:=TRUE;//烤箱21的4板温度不在正常设定温度范围内报警
END_IF




//热压
IF (arrTempCtrl[93].Tem_fPV>(arrTempPar[93].fTempSet+ABS(arrTempPar[93].fTempArea)) OR arrTempCtrl[93].Tem_fPV<(arrTempPar[93].fTempSet-ABS(arrTempPar[93].fTempArea))) AND P3_SystemRUN.iMode=1  THEN
	P3_Tem_Error[93]:=TRUE;//热压上板温度不在正常设定温度范围内报警
END_IF

IF (arrTempCtrl[94].Tem_fPV>(arrTempPar[94].fTempSet+ABS(arrTempPar[94].fTempArea)) OR arrTempCtrl[94].Tem_fPV<(arrTempPar[94].fTempSet-ABS(arrTempPar[94].fTempArea))) AND P3_SystemRUN.iMode=1 THEN
	P3_Tem_Error[94]:=TRUE;//热压下板温度不在正常设定温度范围内报警
END_IF



















































]]></ST>
    </Implementation>
