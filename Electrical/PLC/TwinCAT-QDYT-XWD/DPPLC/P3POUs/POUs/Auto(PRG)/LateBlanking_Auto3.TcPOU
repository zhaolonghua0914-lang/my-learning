a:=0;
IF CellMemory[CellNo.OvenMoveClip1].ScanCode=2 OR B_OVEN THEN
	Step32:=2000;
	ELSE
	Step32:=1100;	
END_IF*)

1100:
a:=a+1;
IF a>42 OR a<1 THEN
	a:=1;
END_IF
IF  NOT P3User2_Par.Oven_cell[a] AND NOT P3User2_Par.Oven_cell_Shield[a] THEN
J:=a;//找出低位空电芯位
P3User2_Par.V:=J+12;
Step32:=1110;
END_IF	

1110:
M_MOD:= J MOD 2;
IF M_MOD>0 THEN
K:=REAL_TO_INT(TRUNC(J/2)+1);
END_IF
IF M_MOD=0 THEN
K:=REAL_TO_INT(TRUNC(J/2));
END_IF
Step32:=1115;


1115:
IF (J=6 OR J=12 OR J=18 OR J=24 OR J=30 OR J=36 OR J=42 ) 
	AND  LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.fActPos)<=WeighLine_1 //称重上料平移在安全位置
	(*AND PermitHotPressRack*) AND arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.Homed AND arrAxisCtrl[P3AxisNo.P3_M4_WeighWhirling].Cmd.arrbRealPoint[3] 
	AND arrAxisCtrl[P3AxisNo.P3_M4_WeighWhirling].Status.NoMoving AND arrAxisCtrl[P3AxisNo.P3_M4_WeighWhirling].Status.Homed AND CellMemory[CellNo.OvenMoveClip1].Cell THEN
		Step32:=1120;	
ELSIF J<>6 AND J<>12 AND J<>18 AND J<>24 AND J<>30 AND J<>36 AND J<>42 THEN
		Step32:=1120;	
END_IF



1120://P3_M2烤箱上料夹升降电机去初始位
IF NOT SingleStep[3] THEN
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND  Oven_POS1 AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] 
		AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.iGoSetPos:=43;	
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving AND Oven_CYOFF_condition THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF		
		Step32:=1130;
		Z:=K MOD 3;		
	END_IF
END_IF



1130://没有烤箱对射感应器报警
IF P3Senser.P3_Ovendoorswitch1 AND P3Senser.P3_Ovendoorswitch2 AND P3Senser.P3_Ovendoorswitch3 THEN
	Step32:=1132;
	Z:=K MOD 3;		
END_IF
IF NOT P3Senser.P3_Ovendoorswitch1 THEN
	P3_Error[17]	:=TRUE;//烤箱1对射感应器报警
END_IF
IF NOT P3Senser.P3_Ovendoorswitch2 THEN
	P3_Error[18]	:=TRUE;//烤箱2对射感应器报警
END_IF
IF NOT P3Senser.P3_Ovendoorswitch3 THEN
	P3_Error[19]	:=TRUE;//烤箱3对射感应器报警
END_IF



1132://烤箱气缸 N 打开
IF NOT SingleStep[3] THEN
	
	arrCyCtrl[P3_Oven[K]].Cmd.bON:=TRUE;
	
	IF arrCyCtrl[P3_Oven[K]].Io.DIOnSwitch AND NOT arrCyCtrl[P3_Oven[K]].Status.Error1 THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF	
	step32:=1135;
	END_IF
END_IF




1135://P3_M2烤箱上料夹搬运电机去烘烤J位条件
IF NOT SingleStep[3] THEN
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND arrCyCtrl[P3_Oven[K]].Io.DIOnSwitch AND NOT arrCyCtrl[P3_Oven[K]].Status.Error1 AND Oven_POS1 AND
		NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[J] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving AND  CellMemory[CellNo.OvenMoveClip1].Cell 
		AND ((Z=1 AND  P3Senser.P3_Ovendoorswitch2 AND P3Senser.P3_Ovendoorswitch3)
		OR (Z=2 AND  P3Senser.P3_Ovendoorswitch1 AND P3Senser.P3_Ovendoorswitch3) OR (Z=0 AND  P3Senser.P3_Ovendoorswitch1 AND P3Senser.P3_Ovendoorswitch2))  THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.iGoSetPos:=J;//烤箱上料夹搬运电机去烘烤J位
		OvenCarryTorMark:=TRUE;//烤箱上料夹搬运力矩超限报警标志	
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[J] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving THEN
		OvenCarryTorMark:=FALSE;//烤箱上料夹搬运力矩超限报警标志
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF	
	Step32:=1140;	
	END_IF
END_IF
IF (Z=2 AND NOT  P3Senser.P3_Ovendoorswitch1) OR (Z=0 AND NOT  P3Senser.P3_Ovendoorswitch1) OR (Z=1 AND P3Senser.P3_Ovendoorswitch1) THEN
	IF NOT alarm_Oven[1].Q THEN
		alarm_Oven[1].IN:=TRUE;
	ELSE
		P3_Error[17]:=TRUE;//烤箱1对射感应器报警
	END_IF
ELSE
	    alarm_Oven[1].IN:=FALSE;
	
END_IF

IF (Z=0 AND NOT  P3Senser.P3_Ovendoorswitch2) OR (Z=1 AND NOT  P3Senser.P3_Ovendoorswitch2) OR (Z=2 AND P3Senser.P3_Ovendoorswitch2) THEN
