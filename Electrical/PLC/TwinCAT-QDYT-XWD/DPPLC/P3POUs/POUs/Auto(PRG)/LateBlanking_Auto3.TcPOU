IF (Z=0 AND NOT  P3Senser.P3_Ovendoorswitch2) OR (Z=1 AND NOT  P3Senser.P3_Ovendoorswitch2) OR (Z=2 AND P3Senser.P3_Ovendoorswitch2) THEN
