		AND PermitHotPressRack AND arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.Homed AND arrAxisCtrl[P3AxisNo.P3_M4_WeighWhirling].Cmd.arrbRealPoint[3] 
		AND  NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[45] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving 
		AND ((G=1 AND  P3Senser.P3_Ovendoorswitch2 AND P3Senser.P3_Ovendoorswitch3)
		OR (G=2 AND  P3Senser.P3_Ovendoorswitch1 AND P3Senser.P3_Ovendoorswitch3) OR (G=0 AND  P3Senser.P3_Ovendoorswitch1 AND P3Senser.P3_Ovendoorswitch2)) THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.iGoSetPos:=45;//烤箱上料夹搬运去热压位
		OvenCarryTorMark:=TRUE;//烤箱上料夹搬运力矩超限报警标志	
