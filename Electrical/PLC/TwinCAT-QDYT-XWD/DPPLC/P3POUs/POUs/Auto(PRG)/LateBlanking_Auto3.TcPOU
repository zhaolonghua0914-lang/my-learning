		alarm_Oven[2].IN:=TRUE;
	ELSE
		P3_Error[18]:=TRUE;//烤箱2对射感应器报警
	END_IF
ELSE
	    alarm_Oven[2].IN:=FALSE;
END_IF

IF (Z=1 AND NOT  P3Senser.P3_Ovendoorswitch3) OR (Z=2 AND NOT  P3Senser.P3_Ovendoorswitch3) OR (Z=0 AND P3Senser.P3_Ovendoorswitch3) THEN
