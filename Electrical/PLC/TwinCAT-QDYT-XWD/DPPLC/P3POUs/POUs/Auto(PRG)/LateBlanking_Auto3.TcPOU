<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="LateBlanking_Auto3" Id="{dc769acc-bc1b-45d6-bdda-7efb7574bd68}" SpecialFunc="None">
    <Declaration><![CDATA[//烤箱下料至热压及冷压上料至烤箱
PROGRAM LateBlanking_Auto3
VAR
	i :INT:=1;
	i1 :INT;
	i2 :INT;
	i3 :INT;
	a :INT:=0;
	b:INT:=0;
	J :INT:=0;
	K :INT:=0;
	M :INT:=0;
	N :INT:=0;
	H :INT:=1;
	G :INT;
	Z :INT;
	M_MOD :REAL;
	Oven_Time_1: Oven_Time;
	AQ12: BOOL;
	aq13: BOOL;
	Auxiliary :ARRAY[1..2] OF BOOL;//辅助功能
	Oven_status: INT;//电芯是否满料
	SingleStep_3 : R_TRIG;
	Oven_Time :TIME;
	N_OFFState_4 :Tc2_Standard.TON;
	K_OFFState_4 :Tc2_Standard.TON;
	//stTime		:TIMESTRUCT;
	NT_GetTime1: NT_GetTime;
	strTime: STRING;
	wHour1	:UDINT;
	wHour	:UDINT;
	wMinute	:UDINT;	
	wSecond	:UDINT;
	S_Miao :UDINT;
	Shift_Time1	:UDINT;
	Shift_Time2	:UDINT;
	alarm_Oven :ARRAY[1..10] OF Tc2_Standard.TON;
	Cell_WZ :INT;
	OvenMoveClip_ton :ARRAY[1..10] OF Tc2_Standard.TON;

	ScanStep:UINT;//扫码自动步 
	ScanStart:BOOL;//扫码开始--扫码流程
	ScanFinish:BOOL;//扫码完成--扫码流程
	
	StickStep:UINT;//贴胶自动步
	StickStart:BOOL;//贴胶允许
	StickFinish:BOOL;//贴胶完成
	
	ScanCodeFB						: CS_CodeTcp;//二维码胶扫码
	MesCodeFB						: CS_CodeTcp;//Mes上传扫码(第二次扫码，确认二维码胶条码和电芯绑定的条码是否一致)
	ScanAgainTON:TON;
	iNgCount:INT;
	MESAgainTON :ARRAY[1..2] OF TON;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ACT_Scan();
P3_Oven_Time();

alarm_Oven[1](PT:=T#300MS);
alarm_Oven[2](PT:=T#300MS);
alarm_Oven[3](PT:=T#300MS);
alarm_Oven[4](PT:=T#5S);
alarm_Oven[5](PT:=T#5S);
alarm_Oven[6](PT:=T#5S);
OvenMoveClip_ton[1](PT:=T#1S);
OvenMoveClip_ton[2](PT:=T#1S);
MESAgainTON[1](PT:=T#3S);
MESAgainTON[2](PT:=T#3S);
ScanAgainTON(PT:=T#2S);
ScanAgainTON.IN:=(ScanStep=700 AND NOT Scan_finish);
Oven_POS1:=(arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] OR arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[46])
AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving
AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Homed 
AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Io.biHomeSwitch ;//烤箱进退初始位
P3_Error[93]:=(arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] OR arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[46])
AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving
AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Homed 
AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Io.biHomeSwitch ;//烤箱进退初始位感应器不亮报警

//烤箱门全部关闭,烤箱平移及升降、进退安全条件
IF  arrCyCtrl[P3_Oven[1]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[2]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[3]].Io.DIOFFSwitch AND 
	arrCyCtrl[P3_Oven[4]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[5]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[6]].Io.DIOFFSwitch AND 
	arrCyCtrl[P3_Oven[7]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[8]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[9]].Io.DIOFFSwitch AND 
	arrCyCtrl[P3_Oven[10]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[11]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[12]].Io.DIOFFSwitch AND 
	arrCyCtrl[P3_Oven[13]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[14]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[15]].Io.DIOFFSwitch AND 
	arrCyCtrl[P3_Oven[16]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[17]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[18]].Io.DIOFFSwitch AND 
	arrCyCtrl[P3_Oven[19]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[20]].Io.DIOFFSwitch AND arrCyCtrl[P3_Oven[21]].Io.DIOFFSwitch THEN
 	 	Oven_CYOFF_condition:=TRUE;
	ELSE
		Oven_CYOFF_condition:=FALSE;
END_IF

//烤箱门前面打开,烤箱平移及升降、进退安全条件
IF  arrCyCtrl[P3_Oven[1]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[2]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[3]].Io.DIONSwitch OR 
	arrCyCtrl[P3_Oven[4]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[5]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[6]].Io.DIONSwitch OR 
	arrCyCtrl[P3_Oven[7]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[8]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[9]].Io.DIONSwitch OR 
	arrCyCtrl[P3_Oven[10]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[11]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[12]].Io.DIONSwitch OR 
	arrCyCtrl[P3_Oven[13]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[14]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[15]].Io.DIONSwitch OR 
	arrCyCtrl[P3_Oven[16]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[17]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[18]].Io.DIONSwitch OR 
	arrCyCtrl[P3_Oven[19]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[20]].Io.DIONSwitch OR arrCyCtrl[P3_Oven[21]].Io.DIONSwitch OR
	NOT arrCyCtrl[P3_Oven[1]].Io.DIOFFSwitch OR    NOT  arrCyCtrl[P3_Oven[2]].Io.DIOFFSwitch OR  NOT  arrCyCtrl[P3_Oven[3]].Io.DIOFFSwitch OR  
    NOT arrCyCtrl[P3_Oven[4]].Io.DIOFFSwitch OR    NOT  arrCyCtrl[P3_Oven[5]].Io.DIOFFSwitch OR  NOT  arrCyCtrl[P3_Oven[6]].Io.DIOFFSwitch OR      
    NOT arrCyCtrl[P3_Oven[7]].Io.DIOFFSwitch OR    NOT  arrCyCtrl[P3_Oven[8]].Io.DIOFFSwitch OR  NOT  arrCyCtrl[P3_Oven[9]].Io.DIOFFSwitch OR 
    NOT arrCyCtrl[P3_Oven[10]].Io.DIOFFSwitch OR    NOT  arrCyCtrl[P3_Oven[11]].Io.DIOFFSwitch OR  NOT  arrCyCtrl[P3_Oven[12]].Io.DIOFFSwitch OR
    NOT arrCyCtrl[P3_Oven[13]].Io.DIOFFSwitch OR    NOT  arrCyCtrl[P3_Oven[14]].Io.DIOFFSwitch OR  NOT  arrCyCtrl[P3_Oven[15]].Io.DIOFFSwitch OR 
    NOT arrCyCtrl[P3_Oven[16]].Io.DIOFFSwitch OR    NOT  arrCyCtrl[P3_Oven[17]].Io.DIOFFSwitch OR  NOT  arrCyCtrl[P3_Oven[18]].Io.DIOFFSwitch OR 
    NOT arrCyCtrl[P3_Oven[19]].Io.DIOFFSwitch OR    NOT  arrCyCtrl[P3_Oven[20]].Io.DIOFFSwitch OR  NOT  arrCyCtrl[P3_Oven[21]].Io.DIOFFSwitch THEN        
 	 	Oven_CYON_condition:=TRUE;
	ELSE
		Oven_CYON_condition:=FALSE;
END_IF

IF  arrCyCtrl[P3_Oven[1]].Status.Error1 OR arrCyCtrl[P3_Oven[1]].Status.Error2 OR arrCyCtrl[P3_Oven[2]].Status.Error1 OR arrCyCtrl[P3_Oven[2]].Status.Error2 OR
	arrCyCtrl[P3_Oven[3]].Status.Error1 OR arrCyCtrl[P3_Oven[3]].Status.Error2 OR arrCyCtrl[P3_Oven[4]].Status.Error1 OR arrCyCtrl[P3_Oven[4]].Status.Error2 OR
	arrCyCtrl[P3_Oven[5]].Status.Error1 OR arrCyCtrl[P3_Oven[5]].Status.Error2 OR arrCyCtrl[P3_Oven[6]].Status.Error1 OR arrCyCtrl[P3_Oven[6]].Status.Error2 OR
	arrCyCtrl[P3_Oven[7]].Status.Error1 OR arrCyCtrl[P3_Oven[7]].Status.Error2 OR arrCyCtrl[P3_Oven[8]].Status.Error1 OR arrCyCtrl[P3_Oven[8]].Status.Error2 OR
	arrCyCtrl[P3_Oven[9]].Status.Error1 OR arrCyCtrl[P3_Oven[9]].Status.Error2 OR arrCyCtrl[P3_Oven[10]].Status.Error1 OR arrCyCtrl[P3_Oven[10]].Status.Error2 OR
	arrCyCtrl[P3_Oven[11]].Status.Error1 OR arrCyCtrl[P3_Oven[11]].Status.Error2 OR arrCyCtrl[P3_Oven[12]].Status.Error1 OR arrCyCtrl[P3_Oven[12]].Status.Error2 OR
	arrCyCtrl[P3_Oven[13]].Status.Error1 OR arrCyCtrl[P3_Oven[13]].Status.Error2 OR arrCyCtrl[P3_Oven[14]].Status.Error1 OR arrCyCtrl[P3_Oven[14]].Status.Error2 OR
	arrCyCtrl[P3_Oven[15]].Status.Error1 OR arrCyCtrl[P3_Oven[15]].Status.Error2 OR arrCyCtrl[P3_Oven[16]].Status.Error1 OR arrCyCtrl[P3_Oven[16]].Status.Error2 OR
	arrCyCtrl[P3_Oven[17]].Status.Error1 OR arrCyCtrl[P3_Oven[17]].Status.Error2 OR arrCyCtrl[P3_Oven[18]].Status.Error1 OR arrCyCtrl[P3_Oven[18]].Status.Error2 OR
	arrCyCtrl[P3_Oven[19]].Status.Error1 OR arrCyCtrl[P3_Oven[19]].Status.Error2 OR arrCyCtrl[P3_Oven[20]].Status.Error1 OR arrCyCtrl[P3_Oven[20]].Status.Error2 OR
	arrCyCtrl[P3_Oven[21]].Status.Error1 OR arrCyCtrl[P3_Oven[21]].Status.Error2 THEN
	Oven_CY_STOP:=TRUE;
	ELSE
	Oven_CY_STOP:=FALSE;

END_IF


IF P3_SystemRUN.iMode=3 AND Step32<=10 THEN
	Oven_PB_condition:=TRUE;
ELSE
	Oven_PB_condition:=FALSE;	
END_IF



NT_GetTime1(
	NETID:='' ,
	START:=Pulse._1s.RT ,
	TMOUT:= ,
	BUSY=> ,
	ERR=> ,
	ERRID=> ,
	TIMESTR=>stTime );
	
strTime:=CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT( CONCAT(CONCAT( WORD_TO_STRING(stTime.wYear),'-'), WORD_TO_STRING(stTime.wMonth)),'-'),WORD_TO_STRING(stTime.wDay)),
             ' '),WORD_TO_STRING(stTime.wHour)),':'),WORD_TO_STRING(stTime.wMinute)),':'),WORD_TO_STRING(stTime.wSecond));
	
Puttime:=	strTime;
Outtime:=	strTime;	 
	
wMinute:=WORD_TO_UDINT(stTime.wMinute);	
wSecond:=WORD_TO_UDINT(stTime.wSecond);			 
wHour1:=WORD_TO_UDINT(stTime.wHour);			 
IF 	wHour1=0 THEN
	wHour:=24;
	ELSE
	wHour:=	wHour1;	
END_IF	 
			 
S_Miao:=wHour*60*60+wMinute*60+wSecond;	
		 
P3_Oven_Time();
N_OFFState_4(PT:=T#200MS);
K_OFFState_4(PT:=T#3S);

WeighLine_1:=arrAxisPar[P3AxisNo.P3_M4_WeighLine].arrTargetPoint[1]+5;
Oven_Time:=UDINT_TO_TIME(P3Par.Oven_Shijian*60000);


SingleStep_3 (CLK:=P3_Start[3]OR (NOT StepModel[3]) , Q=>);
IF  SingleStep_3.Q  THEN
	SingleStep[3]:=FALSE;
END_IF

i:=i+1;
IF i<1 OR i>42 THEN
	i:=1;
END_IF

//判断烤箱状态
Auxiliary[1]:=FALSE;
Auxiliary[2]:=FALSE;
FOR i:=1 TO 42 DO 
     Auxiliary[1]:=Auxiliary[1] OR (P3User2_Par.Oven_cell[i] AND NOT P3User2_Par.Oven_cell_Shield[i]);
	  Auxiliary[2]:=Auxiliary[2] OR (NOT P3User2_Par.Oven_cell[i] AND NOT P3User2_Par.Oven_cell_Shield[i]);
END_FOR
IF NOT Auxiliary[1] AND Auxiliary[2] THEN
	Oven_status:=1;//烤箱空电芯
ELSIF Auxiliary[1] AND Auxiliary[2] THEN
	Oven_status:=2;//烤箱有电芯
ELSIF Auxiliary[1] AND NOT Auxiliary[2] THEN
	Oven_status:=3;//烤箱满电芯
END_IF;


//测试
fDataMax:=P3User2_Par.Oven_Finish_Time[1];
FOR i:=1 TO 42 DO
	IF fDataMax<=P3User2_Par.Oven_Finish_Time[i] AND P3User2_Par.Oven_finish[i] AND P3User2_Par.Oven_cell[i] AND  NOT P3User2_Par.Oven_cell_Shield[i]  THEN
		fDataMax:=P3User2_Par.Oven_Finish_Time[i];
		Cell_WZ:=i;
	END_IF
END_FOR








IF P3_SystemRUN.iMode=1  AND LateBlanking_init_OK[3]  THEN
CASE Step32 OF
1://气缸和轴回初始状态
IF NOT SingleStep[3] THEN
	
	N_OFFState_4.IN:=FALSE;	
	K_OFFState_4.IN:=FALSE;	
	Cell_WZ:=0;
	arrCyCtrl[P3CYNo.P3OvenMoveClip].Cmd.bOFF:=TRUE;//烤箱上料夹气缸张开
	
	IF NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving AND NOT Oven_CYON_condition AND Oven_CYOFF_condition THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.iGoSetPos:=43;//P3_M2烤箱上料夹进退电机回初始位
		OvenRetractTorMark:=TRUE;//烤箱上料夹进退力矩超限报警标志	
	END_IF
	
	IF arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND Oven_POS1
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving AND NOT Oven_CYON_condition AND Oven_CYOFF_condition THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.iGoSetPos:=43;	//P3_M2烤箱上料夹升降电机回初始位
	END_IF
	
	IF arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] AND  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[43] 
		AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Homed AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Enabled 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving AND NOT Oven_CYON_condition  AND Oven_POS1 AND Oven_CYOFF_condition THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.iGoSetPos:=43;	//P3_M2烤箱上料夹搬运电机回初始位
		OvenCarryTorMark:=TRUE;//烤箱上料夹搬运力矩超限报警标志
	END_IF
	
	IF arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving AND Oven_POS1 AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[43] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving 
		AND arrCyCtrl[P3CYNo.P3OvenMoveClip].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3OvenMoveClip].Status.Error2 AND Oven_POS1 THEN
		OvenRetractTorMark:=FALSE;//烤箱上料夹进退力矩超限报警标志
		OvenCarryTorMark:=FALSE;//烤箱上料夹搬运力矩超限报警标志
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF	
	Step32:=10;	
	END_IF
END_IF

10:
a:=0;
b:=0;
J:=0;
M:=0;
M_MOD:=-1;
FOR i:=1 TO 42 BY 1 DO
IF (Oven_status=2 OR Oven_status=3) AND PermitHotPressRack AND P3User2_Par.Oven_finish[i] AND  NOT P3User2_Par.Oven_cell_Shield[i] AND Cell_WZ<>0 THEN
	Step32:=20;//判断烤箱有没有电芯、是否有烤箱烘烤完成信号和允许热压信号，准备去取热压
ELSIF (Oven_status=1 OR Oven_status=2) AND Cold_Press_Finish THEN
	Step32:=1020;//判断烤箱有没有空电芯位、是否有冷压完成信号	
END_IF
END_FOR


///////////////////烤箱下料至热压
20:
b:=b+1;
IF b>42 OR b<1 THEN
	b:=1;
END_IF
IF  P3User2_Par.Oven_finish[b] AND NOT P3User2_Par.Oven_cell_Shield[b]  AND P3User2_Par.Oven_cell[b] THEN
M:=Cell_WZ;//找出低位烘烤时间完成的电芯
P3User2_Par.W:=M+12;
Step32:=30;
END_IF	


30://找出 M 电芯所在的气缸 N
M_MOD:= M MOD 2;
IF M_MOD>0 THEN
N:=REAL_TO_INT(TRUNC(M/2)+1);
END_IF
IF M_MOD=0 THEN
N:=REAL_TO_INT(TRUNC(M/2));
END_IF
Step32:=35;	

35://三个烤箱对射感应有信号则跳至40步
IF P3Senser.P3_Ovendoorswitch1 AND P3Senser.P3_Ovendoorswitch2 AND P3Senser.P3_Ovendoorswitch3 THEN
	Step32:=40;
	G:=N MOD 3;	
END_IF
IF NOT P3Senser.P3_Ovendoorswitch1 THEN
	P3_Error[17]	:=TRUE;//烤箱1对射感应器报警
END_IF
IF NOT P3Senser.P3_Ovendoorswitch2 THEN
	P3_Error[18]	:=TRUE;//烤箱2对射感应器报警
END_IF
IF NOT P3Senser.P3_Ovendoorswitch3 THEN
	P3_Error[19]	:=TRUE;//烤箱3对射感应器报警
END_IF

40://烤箱气缸 N 打开
IF NOT SingleStep[3] THEN
	
	arrCyCtrl[P3_Oven[N]].Cmd.bON:=TRUE;
	
	IF arrCyCtrl[P3_Oven[N]].Io.DIOnSwitch AND NOT arrCyCtrl[P3_Oven[N]].Status.Error1 THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF	
	Step32:=45;
	END_IF
END_IF


45://P3_M2烤箱上料夹进退电机回初始位
IF NOT SingleStep[3] THEN
	
	IF NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving AND arrCyCtrl[P3_Oven[N]].Io.DIOnSwitch THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.iGoSetPos:=43;	
		OvenCarryTorMark:=TRUE;//烤箱上料夹搬运力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43]  AND Oven_POS1  AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving THEN
		OvenCarryTorMark:=FALSE;//烤箱上料夹搬运力矩超限报警标志
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF		
	Step32:=50;	
	END_IF
END_IF

50://P3_M2烤箱上料夹升降电机回初始位
IF NOT SingleStep[3] THEN
	
	
	IF   arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND Oven_POS1 AND
		NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.iGoSetPos:=43;	
	END_IF
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF	
	Step32:=53;	
	END_IF
END_IF

53:
IF (M=6 OR M=12 OR M=18 OR M=24 OR M=30 OR M=36 OR M=42 ) 
	AND  LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.fActPos)<=WeighLine_1 //称重上料平移在安全位置
	AND PermitHotPressRack AND arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.Homed AND arrAxisCtrl[P3AxisNo.P3_M4_WeighWhirling].Cmd.arrbRealPoint[3] 
	AND arrAxisCtrl[P3AxisNo.P3_M4_WeighWhirling].Status.NoMoving THEN
		Step32:=55;	//有允许热压信号，称重上料夹旋转在称重位，跳至55步
ELSIF M<>6 AND M<>12 AND M<>18 AND M<>24 AND M<>30 AND M<>36 AND M<>42 THEN
		Step32:=55;	
END_IF





55://P3_M2烤箱上料夹搬运电机去烘烤M位
IF NOT SingleStep[3] THEN
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND arrCyCtrl[P3_Oven[N]].Io.DIOnSwitch AND NOT arrCyCtrl[P3_Oven[N]].Status.Error1 AND Oven_POS1 AND PermitHotPressRack AND
		NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[M] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving AND ((G=1 AND  P3Senser.P3_Ovendoorswitch2 AND P3Senser.P3_Ovendoorswitch3)
		OR (G=2 AND  P3Senser.P3_Ovendoorswitch1 AND P3Senser.P3_Ovendoorswitch3) OR (G=0 AND  P3Senser.P3_Ovendoorswitch1 AND P3Senser.P3_Ovendoorswitch2)) THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.iGoSetPos:=M;	
		OvenCarryTorMark:=TRUE;//烤箱上料夹搬运力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[M] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving THEN
		OvenCarryTorMark:=FALSE;//烤箱上料夹搬运力矩超限报警标志
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF		
	Step32:=60;	
	END_IF
END_IF

IF (G=2 AND NOT  P3Senser.P3_Ovendoorswitch1) OR (G=0 AND NOT  P3Senser.P3_Ovendoorswitch1) OR (G=1 AND  P3Senser.P3_Ovendoorswitch1)  THEN
	IF NOT alarm_Oven[1].Q THEN
		alarm_Oven[1].IN:=TRUE;
