		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving AND PermitHotPressRack
		AND arrCyCtrl[P3_Oven[N]].Io.DIOnSwitch AND NOT arrCyCtrl[P3_Oven[N]].Status.Error1 AND arrCyCtrl[P3CYNo.P3OvenMoveClip].Io.DIOFFSwitch 
        AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[M] 
		AND (arrAxisParV2[P3AxisNo.P3_M2_OvenUpDown].arrTargetPoint[M]-arrAxis[P3AxisNo.P3_M2_OvenUpDown].NcToPlc.ActPos >=(Oven_par[2]-0.1)) THEN(*XFP0510*)
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.iGoSetPos:=M;
		OvenRetractTorMark:=TRUE;//烤箱上料夹进退力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[M] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving THEN
