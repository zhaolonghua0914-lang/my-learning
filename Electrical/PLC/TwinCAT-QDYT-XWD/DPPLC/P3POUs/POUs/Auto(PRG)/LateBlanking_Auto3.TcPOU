END_IF


1140://P3_M2烤箱上料夹升降电机去烘烤J位条件
IF NOT SingleStep[3] THEN
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND arrCyCtrl[P3_Oven[K]].Io.DIOnSwitch AND NOT arrCyCtrl[P3_Oven[K]].Status.Error1 AND Oven_POS1 AND  CellMemory[CellNo.OvenMoveClip1].Cell AND 
		NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[J] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving AND   CellMemory[CellNo.OvenMoveClip1].Cell THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.iGoSetPos:=J;	//烤箱上料夹升降电机去烘烤J位
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[J] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
