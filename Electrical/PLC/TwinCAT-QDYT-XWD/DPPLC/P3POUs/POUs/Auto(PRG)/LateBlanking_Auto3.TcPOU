		END_IF
	END_IF



1160://烤箱上料夹气缸松开
IF NOT SingleStep[3] THEN
	
	arrCyCtrl[P3CYNo.P3OvenMoveClip].Cmd.bOFF:=TRUE;
	
	IF arrCyCtrl[P3CYNo.P3OvenMoveClip].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3OvenMoveClip].Status.Error2 THEN
		IF  StepModel[3] THEN
