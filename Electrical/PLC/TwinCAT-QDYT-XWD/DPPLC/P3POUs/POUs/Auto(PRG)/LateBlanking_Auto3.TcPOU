	END_IF
END_IF

IF (Z=2 AND NOT  P3Senser.P3_Ovendoorswitch1) OR (Z=0 AND NOT  P3Senser.P3_Ovendoorswitch1) OR (Z=1 AND P3Senser.P3_Ovendoorswitch1) THEN
	IF NOT alarm_Oven[1].Q THEN
