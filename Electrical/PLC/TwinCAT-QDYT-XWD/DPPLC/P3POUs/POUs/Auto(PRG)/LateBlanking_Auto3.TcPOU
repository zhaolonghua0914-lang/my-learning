	END_IF
END_IF

1170://P3_M2烤箱上料夹进退电机去初始位

IF NOT SingleStep[3] THEN
	
	IF  NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving  AND arrCyCtrl[P3CYNo.P3OvenMoveClip].Io.DIOFFSwitch THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.iGoSetPos:=43;
		OvenRetractTorMark:=TRUE;//烤箱上料夹进退力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43]  
	AND Oven_POS1 
	AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving 
	AND NOT P3Senser.P3_Kxslgy THEN
		OvenRetractTorMark:=FALSE;//烤箱上料夹进退力矩超限报警标志
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF	
	Step32:=1175;	
	END_IF
END_IF

1175://记忆从烤箱上料夹子转移烤箱J
P3User2_Par.Oven_cell[J]:=TRUE;
CellMemory[P3User2_Par.V]:=CellMemory[CellNo.OvenMoveClip1];
