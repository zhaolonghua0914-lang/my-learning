	END_IF
END_IF

63://烤箱上料夹升降放料位与辅助位换算
	IF NOT SingleStep[3] THEN(*XFP0510*)
		IF arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND arrCyCtrl[P3_Oven[N]].Io.DIOnSwitch AND NOT arrCyCtrl[P3_Oven[N]].Status.Error1 AND PermitHotPressRack AND
			  NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled 
			  AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
