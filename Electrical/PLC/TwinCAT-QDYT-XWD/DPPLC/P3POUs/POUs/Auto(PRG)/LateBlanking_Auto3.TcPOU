2010://P3_M2烤箱上料夹搬运电机回初始位
IF NOT SingleStep[3] THEN
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND
		NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Homed
        AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.iGoSetPos:=43;	
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[43] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF		
	Step32:=2020;	
	END_IF
END_IF

2020:
IF PermitHotPressRack AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.NoMoving 
		AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.NoMoving THEN
	step32:=2025;
	END_IF

	
2025://P3_M2烤箱上料夹升降电机去热压位
IF NOT SingleStep[3] THEN
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND 
		NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.iGoSetPos:=43;	
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving  THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF		
	Step32:=2030;	
	END_IF
END_IF
	
	
2030://P3_M2烤箱上料夹搬运电机去热压位
IF NOT SingleStep[3] THEN
	
	IF arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] AND  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND PermitHotPressRack AND
        arrAxisCtrl[P3AxisNo.P3_M4_WeighWhirling].Cmd.arrbRealPoint[3] AND arrAxisCtrl[P3AxisNo.P3_M4_WeighWhirling].Status.NoMoving AND 
	 	LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.fActPos)<=WeighLine_1  AND arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.Homed//称重上料平移在安全位置
		AND  NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[45] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.iGoSetPos:=45;	
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[45] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF	
	Step32:=2050;	
	END_IF
END_IF



2050://P3_M2烤箱上料夹升降电机去热压位
IF NOT SingleStep[3] THEN
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND 
		NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[45] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.iGoSetPos:=45;	
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[45] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving  THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF		
	Step32:=2060;	
	END_IF
END_IF

2060://P3_M2烤箱上料夹进退电机去热压位
IF NOT SingleStep[3] THEN
	
	IF NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[45] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.iGoSetPos:=45;
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[45] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF		
	Step32:=2065;	
	END_IF
END_IF

2065://P3_M2烤箱上料夹升降电机去热压位
IF NOT SingleStep[3] THEN
  
	IF	NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[47] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.iGoSetPos:=47;	
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[47] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving  THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF		
	Step32:=2070;	
	END_IF
END_IF






2070://烤箱上料夹气缸张开
IF NOT SingleStep[3] THEN
arrCyCtrl[P3CYNo.P3OvenMoveClip].Cmd.bOFF:=TRUE;
IF arrCyCtrl[P3CYNo.P3OvenMoveClip].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3OvenMoveClip].Status.Error2 THEN
IF  StepModel[3] THEN
SingleStep[3]:=TRUE;
ELSE
SingleStep[3]:=FALSE;
END_IF		
step32:=2080;
END_IF
END_IF

2080://P3_M2烤箱上料夹进退电机回初始位
IF NOT SingleStep[3] THEN
IF NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Homed 
AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving THEN
arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.iGoSetPos:=43;
END_IF
IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving THEN
IF  StepModel[3] THEN
SingleStep[3]:=TRUE;
ELSE
SingleStep[3]:=FALSE;
END_IF		
Step32:=2090;	
END_IF
END_IF

2090://记忆从烤箱上料夹子转移到热压工位
CellMemory[CellNo.Hotpress]:=CellMemory[CellNo.OvenMoveClip1];
MEMSET(ADR(CellMemory[CellNo.OvenMoveClip1]),0,SIZEOF(CellMemory[CellNo.OvenMoveClip1]));
Step32:=2100;

2100://该电芯是扫码NG直接跳过热压
IF NOT B_OVEN THEN
Hot_Press_Finish:=TRUE;
Step32:=2110;
ELSE
Permit_Hot_Press:=TRUE;
Permit_ShortTest:=TRUE;
Step32:=2110;
END_IF

2110://P3_M2烤箱上料夹升降电机回初始位
IF NOT SingleStep[3] THEN
	
	IF arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND 
		NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.iGoSetPos:=43;	
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[43] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving  THEN
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF	
	Step32:=1;	
	END_IF
END_IF
*)
END_CASE
END_IF

IF (step32=1135 OR step32=1140) AND NOT arrCyCtrl[P3_Oven[K]].Status.ONState THEN
	tip_8[K]:=TRUE; //烤箱上料时，对应烤箱门未打开
ELSE
    tip_8[K]:=FALSE;	
END_IF	

IF step32>=55 AND step32<=70  AND NOT arrCyCtrl[P3_Oven[N]].Status.ONState THEN
	tip_9[N]:=TRUE; //烤箱下料时，对应烤箱门未打开
ELSE
    tip_9[N]:=FALSE;	
END_IF	

IF  Step32>=40 AND  Step32<=105 THEN
			FOR i1:=1 TO 21 BY 1 DO 
					IF NOT  arrCyCtrl[P3_Oven[ i1]].Io.DIOFFSwitch AND    i1<>N THEN
						P3_Error[47]:=TRUE;//烤箱下料时，除对应下料烤箱以外有门未关
						tip_10[i1]:=TRUE; //烤箱下料时，有烤箱门未关闭
					END_IF
		   END_FOR
END_IF

IF  Step32>=1132 AND  Step32<=1185 THEN
			FOR i2:=1 TO 21 BY 1 DO 
					IF NOT  arrCyCtrl[P3_Oven[ i2]].Io.DIOFFSwitch AND    i2<>k THEN
						P3_Error[46]:=TRUE;//烤箱上料时，除对应下料烤箱以外有门未关
						tip_10[i2]:=TRUE; //烤箱上料时，有烤箱门未关闭
					END_IF
		   END_FOR
END_IF

IF  Step32=1 THEN
			FOR i3:=1 TO 21 BY 1 DO 
					IF NOT  arrCyCtrl[P3_Oven[ i3]].Io.DIOFFSwitch THEN
						P3_Error[48]:=TRUE;//烤箱上料搬运运动时，有门未关
					END_IF
		   END_FOR
END_IF


IF  Step32>=80 AND  Step32<=150 THEN
	IF NOT P3Senser.P3_Kxslgy THEN
		P3_Error[34]:=TRUE;//烤箱下料至热压上料时，未检测到电芯报警
	END_IF
END_IF

IF  Step32>=1060 AND  Step32<=1155 THEN
	IF NOT  P3Senser.P3_Kxslgy THEN
		P3_Error[35]:=TRUE;//冷压下料至烤箱上料时，未检测到电芯报警
	END_IF
END_IF

IF Step32=1170 AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] AND   P3Senser.P3_Kxslgy THEN
	P3_Error[87]:=TRUE;//在烤箱下料完成后，检测到夹爪有电芯报警
END_IF
]]></ST>
    </Implementation>
    <Action Name="ACT_Scan" Id="{64afb04a-81d5-4922-bb82-fc217ebd6865}">
      <Implementation>
        <ST><![CDATA[
//	ScanStart:BOOL;//扫码开始
//	ScanFinish:BOOL;//扫码完成	
CASE ScanStep OF
0:
		Scan_start:=FALSE;//扫码开始--扫码枪
		Scan_finish:=FALSE;//扫码完成--扫码枪
		IF ScanStart THEN//扫码开始
				ScanStep:=50;
		END_IF
50:
		ScanStart:=FALSE;//扫码开始--扫码流程
		ScanFinish:=FALSE;//扫码完成	--扫码流程		
		ScanStep:=100;	
100:
		IF P3User2_Par.Shield[4] OR  P3User2_Par.Shield[23] THEN //扫码屏蔽
				ScanStep:=750;	
		ELSE
				ScanStep:=200;	
		END_IF

200://烤箱上料夹进退走扫码位
IF NOT SingleStep[3] THEN
		IF  NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[46] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Error 
			AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Homed 	AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Enabled 
			AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving THEN
				arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.iGoSetPos:=46;
				OvenRetractTorMark:=TRUE;//烤箱上料夹进退力矩超限报警标志
			END_IF	
		IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[46]	 THEN
				OvenRetractTorMark:=FALSE;//烤箱上料夹进退力矩超限报警标志
				arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.iGoSetPos:=0;
				ScanStep:=300;
			IF  StepModel[3] THEN
				SingleStep[3]:=TRUE;
			ELSE
				SingleStep[3]:=FALSE;
			END_IF
		END_IF
END_IF
300://烤箱上料夹升降走扫码位
IF NOT SingleStep[3] THEN
		IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[46]	AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[46] 
			AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed 
			AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
				arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.iGoSetPos:=46;
		END_IF	
		IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[46]	 THEN
				arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.iGoSetPos:=0;
				ScanStep:=400;	
			IF  StepModel[3] THEN
				SingleStep[3]:=TRUE;
			ELSE
				SingleStep[3]:=FALSE;
			END_IF
		END_IF
END_IF
400://烤箱上料夹搬运走扫码位
IF NOT SingleStep[3] THEN
		IF arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[46]	AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[46]
			AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[46]	AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Error 
			AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Homed AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.NoMoving THEN
				arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.iGoSetPos:=46;
		END_IF	
		IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[46]	THEN
				arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.iGoSetPos:=0;
				ScanStep:=500;	
			IF  StepModel[3] THEN
				SingleStep[3]:=TRUE;
			ELSE
				SingleStep[3]:=FALSE;
			END_IF
		END_IF
END_IF
	
500:
IF NOT SingleStep[3] THEN
		IF arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[46] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[46] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[46] THEN
				ScanStep:=600;	
			IF  StepModel[3] THEN
				SingleStep[3]:=TRUE;
			ELSE
				SingleStep[3]:=FALSE;
			END_IF
		END_IF
END_IF
600://扫码开始
		Scan_start:=TRUE;//扫码开始
		Scan_finish:=FALSE;//扫码完成
		ScanStep:=700;	
700:
		IF Scan_finish THEN//扫码完成
			ScanStep:=750;	
		ELSIF ScanAgainTON.Q THEN
			ScanStep:=600;
		END_IF
750:
		Scan_start:=FALSE;//扫码开始
		Scan_finish:=FALSE;//扫码完成
		ScanStep:=1100;	

1100:
		ScanFinish:=TRUE;//扫码完成	--扫码流程	
		ScanStep:=1200;	
1200:
		IF NOT ScanFinish THEN
				ScanStep:=0;	
		END_IF
		
END_CASE
]]></ST>
      </Implementation>
    </Action>
