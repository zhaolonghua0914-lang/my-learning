IF NOT SingleStep[3] THEN
	
	IF  NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[J] AND NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Homed 
		AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.Enabled AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving AND   CellMemory[CellNo.OvenMoveClip1].Cell
         AND arrCyCtrl[P3_Oven[K]].Io.DIOnSwitch AND NOT arrCyCtrl[P3_Oven[K]].Status.Error1  AND NOT  arrCyCtrl[P3CYNo.P3OvenMoveClip].Io.DIOnSwitch  
         AND  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Cmd.arrbRealPoint[J] AND  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.arrbRealPoint[J] THEN
		arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.iGoSetPos:=J;//烤箱上料夹进退电机去烘烤J位
		OvenRetractTorMark:=TRUE;//烤箱上料夹进退力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[J] AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Status.NoMoving THEN
		OvenRetractTorMark:=FALSE;//烤箱上料夹进退力矩超限报警标志
		IF  StepModel[3] THEN
			SingleStep[3]:=TRUE;
		ELSE
			SingleStep[3]:=FALSE;
		END_IF	
	Step32:=1155;	
	END_IF
END_IF


1155://烤箱上料夹升降运行位置与放烤箱辅助位换算
	IF NOT SingleStep[3] THEN
		IF  arrCyCtrl[P3_Oven[K]].Io.DIOnSwitch AND NOT arrCyCtrl[P3_Oven[K]].Status.Error1  AND
			  NOT arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Error AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Homed AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.Enabled 
			  AND arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Status.NoMoving THEN
					arrAxisParV2[P3AxisNo.P3_M2_OvenUpDown].fVelocity_of_Rel := 20   ;
					arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.fPosition_of_Rel :=-Oven_par[1] ;
					arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Cmd.bMoveRel :=  TRUE ;
					
		END_IF
		
		IF arrAxisParV2[P3AxisNo.P3_M2_OvenUpDown].arrTargetPoint[J]-arrAxis[P3AxisNo.P3_M2_OvenUpDown].NcToPlc.SetPos  >=(Oven_par[1]-0.1)  AND arrAxisCtrlV2[P3AxisNo.P3M1_ColdpreUpDown].Status.NoMoving THEN
