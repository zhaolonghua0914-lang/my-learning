    <Action Name="Act_07_Scan" Id="{69ee625c-91b2-4de2-96ef-f14b08878829}">
      <Implementation>
        <ST><![CDATA[
StickIDGlue.Scan_IP:='192.168.10.25';
Scan_TON[1](PT:=T#1MS);
Scan_TON[2](PT:=T#1MS);
Scan_TON[3](PT:=T#1MS);
Scan_TON[4](PT:=T#100MS);


////////////////////////人工扫码复扫/////////////////////////////
Scan_code_Z (CLK:=StickIDGlue.ScanCode_AgainStart, Q=>);
IF Scan_code_Z.Q AND  ScanID_step=0 THEN
	 ScanID_step:=10;
END_IF
///////////////////////////////////////////////////////////



CASE ScanID_step OF
		0:
		IF StickIDGlue.ScanCode_start AND NOT P3_Error[104] AND NOT P3_Error[105]AND NOT P3User2_Par.Shield[4] THEN
			StickIDGlue.ScanCode_start:=FALSE;
		 	StickIDGlue.Code_State:=0;
			ScanID_step:=10;
		ELSIF P3User2_Par.Shield[4] THEN
			StickIDGlue.ScanCode_start:=FALSE;
		 	StickIDGlue.Code_State:=0;
			ScanID_step:=70;
		END_IF
	
		10:
			Scan_TON[1].IN:=FALSE;
			Scan_TON[2].IN:=FALSE;
			Scan_TON[3].IN:=FALSE;
			ScanID_step:=20;
			
		20:
			StickIDGlue.bScan_init:=TRUE;
			Scan_TON[1].IN:=TRUE;
			IF Scan_TON[1].Q THEN
				StickIDGlue.bScan_init:=FALSE;
				Scan_TON[1].IN:=FALSE;
				ScanID_step:=30;
			END_IF

		30:
			StickIDGlue.bTcpOpen:=TRUE;
			Scan_TON[2].IN:=TRUE;
			IF Scan_TON[2].Q THEN
				StickIDGlue.bTcpOpen:=FALSE;
				Scan_TON[2].IN:=FALSE;
				ScanID_step:=40;
			END_IF

		40:
			IF StickIDGlue.bTcpOpen_OK THEN
				StickIDGlue.ScanCode_finish:=FALSE;
				ScanID_step:=50;
			END_IF
		
		50:
			StickIDGlue.bScan_start:=TRUE;
			Scan_TON[3].IN:=TRUE;
			IF Scan_TON[3].Q THEN
				StickIDGlue.bScan_start:=FALSE;
				Scan_TON[3].IN:=FALSE;
				ScanID_step:=60;
			END_IF
		60:
			Scan_TON[4].IN:=TRUE;
			IF 	Scan_TON[4].Q THEN
				ScanID_step:=70;
				Scan_TON[4].IN:=FALSE;
			END_IF

		70:
		IF NOT  P3User2_Par.Shield[4] THEN
				IF  StickIDGlue.Code_State=1 THEN
						IDCodeBuffer[1]:=StickIDGlue.strCode;
						IDCodeStatus[1]:=1;
						StickIDGlue.ScanCode_finish:=TRUE;
						ScanID_step:=80;		
				 ELSIF StickIDGlue.Code_State=2 AND I<3 THEN
						 ScanID_step:=10;
						 I:=I+1;	 	
				ELSIF 	StickIDGlue.Code_State=2 AND I>=3 THEN
						IDCodeBuffer[1]:='';
						IDCodeStatus[1]:=2;
						StickIDGlue.ScanCode_finish:=TRUE;
						P3_Error[106]:=TRUE;//扫二维码码NG报警
						I:=0;
						ScanID_step:=80;
				END_IF
		ELSE
				IDCodeBuffer[1]:='A1234567890ABCDEF';
				IDCodeStatus[1]:=1;
				StickIDGlue.ScanCode_finish:=TRUE;
				ScanID_step:=80;
		END_IF
		80:
			IF NOT StickIDGlue.ScanCode_finish THEN
				ScanID_step:=0;
			END_IF
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="Act_08_Init" Id="{f5791c9d-bcf0-4ca8-9505-66563f8e0fac}">
      <Implementation>
        <ST><![CDATA[//烤箱上下料初始化
IF P3_SystemRUN.iMode=3 AND LateBlanking_init_start[10] THEN
		LateBlanking_init_OK[10]:=FALSE;
		LateBlanking_init_start[10]:=FALSE;	
		Init_step[10]:=1;
END_IF

IF P3_SystemRUN.iMode=3 (*AND P3Tail[1].Init_Done AND P3Tail[4].Init_Done	*)THEN
	CASE Init_step[10] OF
		1:
			LateBlanking_init_OK[10]:=FALSE;
			CodeStartMark:=FALSE;
			CutStep:=0;
			Step39:=0;
			StickIDGlue.StandbyCode_Step1:=0;
			StickIDGlue.StandbyCode_Step2:=0;
			StickIDGlue.StandbyCode_Done:=FALSE;
			StickIDGlue.StandbyCode_Finish:=FALSE;
			StickIDGlue.PermitFilling:=FALSE;
			StickIDGlue.PermitMaterial:=FALSE;
			StickIDGlue.strCode:='';
			StickIDGlue.Code_State:=0;
			StickIDGlue.strCode_1:='';
			StickIDGlue.Code_State_1:=0;
			StickIDGlue.strCode_2:='';
			StickIDGlue.Code_State_2:=0;
			IDGlueMount2:=0;
			FOR i :=1 TO 4 DO
				IDCodeBuffer[i]:='';//二维码缓存，，1：扫码位条码，，2：中间缓存，，3：取胶位条码
				IDCodeStatus[i]:=0;//二维码缓存状态，，1：ok，，2：ng，，3：取胶位条码
			END_FOR
			Init_step[10]:=10;

		10:
			IF arrAxisCtrl[P3AxisNo.P3_IDPut].Status.NoMoving AND arrAxisCtrl[P3AxisNo.P3_IDLift].Status.NoMoving THEN
					arrCyCtrl[P3CYNo.P3_GlueVacuum].Cmd.bON:=FALSE;	
					arrCyCtrl[P3CYNo.P3_GlueVacuum].Cmd.bOFF:=TRUE;	
					Init_step[10]:=20;
			END_IF	
		20:
			arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.bStop:=TRUE;
			arrAxisCtrl[P3AxisNo.P3_IDLift].Cmd.bStop:=TRUE;
			Init_step[10]:=30;
			
			
		30:
			arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.bStop:=FALSE;
			arrAxisCtrl[P3AxisNo.P3_IDLift].Cmd.bStop:=FALSE;
			Init_step[10]:=40;
			
		40:
			arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.bReset:=TRUE; 	
			arrAxisCtrl[P3AxisNo.P3_IDLift].Cmd.bReset:=TRUE;
			Init_step[10]:=50;
			
		50:
			arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.bReset:=FALSE; 	
			arrAxisCtrl[P3AxisNo.P3_IDLift].Cmd.bReset:=FALSE;
			Init_step[10]:=60;
			
		60:
			arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.bEnable:=TRUE; 
			arrAxisCtrl[P3AxisNo.P3_IDLift].Cmd.bEnable:=TRUE; 
			IF arrAxisCtrl[P3AxisNo.P3_IDPut].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_IDLift].Status.Enabled THEN
					Init_step[10]:=70;	
			END_IF
		
		70://二维码拉胶回原
	
			arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.bHome:=TRUE;
			Init_step[10]:=80;	
			
		80:
			Init3_TON[2].IN:=TRUE;	
			IF arrAxisCtrl[P3AxisNo.P3_IDPut].Status.Homed AND NOT arrAxisCtrl[P3AxisNo.P3_IDPut].Status.Moving  THEN
				arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.bHome:=FALSE;
				Init3_TON[2].IN:=FALSE;	
				Init_step[10]:=90;
			END_IF
				
		90://二维码贴胶平移和二维码拉胶回初始位
			IF arrAxisCtrl[P3AxisNo.P3_IDPut].Status.Homed AND arrAxisCtrl[P3AxisNo.P3_IDPut].Status.NoMoving THEN 																													                                																 							
				IF arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.arrbRealPoint[1] THEN
					arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.iGoSetPos:=0;		
				ELSE
					arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.iGoSetPos:=1;  
				END_IF
			END_IF
			IF arrAxisCtrl[P3AxisNo.P3_IDPut].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_IDPut].Status.Homed AND arrAxisCtrl[P3AxisNo.P3_IDPut].Status.NoMoving THEN
				Init_step[10]:=100;
			END_IF
	
		100://二维码贴胶头升降回原
			arrAxisCtrl[P3AxisNo.P3_IDLift].Cmd.bHome:=TRUE;
			Init_step[10]:=110;	
			
		110:	
			IF arrAxisCtrl[P3AxisNo.P3_IDLift].Status.Homed AND NOT arrAxisCtrl[P3AxisNo.P3_IDLift].Status.Moving THEN 
				arrAxisCtrl[P3AxisNo.P3_IDLift].Cmd.bHome:=FALSE;	
				Init_step[10]:=120;
			END_IF
				
		120://二维码贴胶头升降至初始位
			IF arrAxisCtrl[P3AxisNo.P3_IDLift].Status.Homed AND arrAxisCtrl[P3AxisNo.P3_IDLift].Status.NoMoving THEN 																													                                																 							
				IF arrAxisCtrl[P3AxisNo.P3_IDLift].Cmd.arrbRealPoint[1] THEN
					arrAxisCtrl[P3AxisNo.P3_IDLift].Cmd.iGoSetPos:=0;
						Init_step[10]:=130;
				ELSE
					arrAxisCtrl[P3AxisNo.P3_IDLift].Cmd.iGoSetPos:=1;  
				END_IF
			END_IF
		
		130://二维码拉胶夹紧气缸打开
				arrCyCtrl[P3CYNo.P3_GluePull].Cmd.bOFF:=TRUE;//二维码拉胶夹紧气缸
			IF arrCyCtrl[P3CYNo.P3_GluePull].Io.DIOFFSwitch AND NOT arrCyCtrl[P3CYNo.P3_GluePull].Status.Error2 THEN
				Init_step[10]:=140;
			END_IF		
			
		140:
			arrCyCtrl[P3CYNo.P3_GlueExtend].Cmd.bOFF:=TRUE;//二维码蹬胶气缸退回
			arrCyCtrl[P3CYNo.P3_GluePress].Cmd.bON:=TRUE;//二维码压胶气缸压紧	
			arrCyCtrl[P3CYNo.P3_GlueCut].Cmd.bOFF:=TRUE;//二维码切胶气缸退回
			IF arrCyCtrl[P3CYNo.P3_GluePress].Io.DIONSwitch  AND arrCyCtrl[P3CYNo.P3_GlueCut].Io.DIOFFSwitch   THEN
					Init_step[10]:=150;
			END_IF	
		150:

			Step39:=0;
			Init_step[10]:=160;
			k2:=0;
			InitBJMark:=TRUE;	
		160:
			LateBlanking_init_OK[10]:=TRUE;
			Init_step[10]:=999;

	END_CASE
END_IF


]]></ST>
      </Implementation>
    </Action>
    <Action Name="SingeMode" Id="{e32af34d-e5f4-478f-a59d-0b7ea0706cf6}">
      <Implementation>
        <ST><![CDATA[
		
SingleStep_10 (CLK:=P3_Start[10] , Q=>);
IF  SingleStep_10.Q OR NOT StepModel[10] THEN
	SingleStep[10]:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
