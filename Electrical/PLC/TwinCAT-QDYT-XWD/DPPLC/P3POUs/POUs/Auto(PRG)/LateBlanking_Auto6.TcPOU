	IF 	arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] 
	AND	NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[1] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving 
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.iGoSetPos:=1;	
		SortingCarryTorMark:=TRUE;//电芯分选夹搬运力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving THEN
		SortingCarryTorMark:=FALSE;//电芯分选夹搬运力矩超限报警标志
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	
	Step35:=3150;
	END_IF	
END_IF

3150:
Step35:=1;



4000://P3_M4电芯分拣夹搬运去测厚位
IF NOT SingleStep[6] THEN
	
	IF 	arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] 
	AND	NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[3] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving 
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.iGoSetPos:=3;	
		SortingCarryTorMark:=TRUE;//电芯分选夹搬运力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[3] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving THEN
		SortingCarryTorMark:=FALSE;//电芯分选夹搬运力矩超限报警标志
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=4010;	
	END_IF	
END_IF	



4010://测厚完成信号，测厚气缸到位
IF NOT SingleStep[6] THEN
 IF Thickness_Finish  AND arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Status.Error1 
	AND  arrCyCtrl[P3CYNo.P3ThicknessPressure].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3ThicknessPressure].Status.Error2 AND
	arrCyCtrl[P3CYNo.P3ThicknessSupport].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3ThicknessSupport].Status.Error1 THEN 
	IF StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=4020;
END_IF
END_IF


4020://P3_M4电芯分拣夹升降去测厚辅助位
IF NOT SingleStep[6] THEN
	
	IF  NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[9] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving 
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[3] THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=9;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[9] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=4040;
	END_IF	
END_IF	


///ihgdfg
4040://电芯分选夹开合气缸夹紧
IF NOT SingleStep[6] THEN
	
	arrCyCtrl[P3CYNo.P3SortClamp].Cmd.bOFF:=TRUE;
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bON:=TRUE;//分选夹归正气缸伸出
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bOFF:=FALSE;//分选夹归正气缸伸出
	IF arrCyCtrl[P3CYNo.P3SortClamp].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3SortClamp].Status.Error2 AND
       arrCyCtrl[P3CYNo.P3SortPush].Status.ONState THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=4060;	
	END_IF
END_IF
	
4060://P3_M4电芯分拣夹升降去测厚位
IF NOT SingleStep[6] THEN
	
	IF  NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[3] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=3;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[3] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=4080;
	P3SortLifting_TON[6].IN:=FALSE;	
	END_IF	
END_IF	



4080://电芯分选夹升降气缸缩回
IF NOT SingleStep[6] THEN
	
	arrCyCtrl[P3CYNo.P3SortLifting].Cmd.bOFF:=TRUE;
	P3SortLifting_TON[6].IN:=TRUE;	
	IF P3SortLifting_TON[6].Q(*arrCyCtrl[P3CYNo.P3SortLifting].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3SortLifting].Status.Error2*) THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=4090;
	P3SortLifting_TON[6].IN:=FALSE;		
	END_IF	
END_IF

4090://电芯记忆从测厚平台转移到分选夹子
CellMemory[CellNo.SortClip2]:=CellMemory[CellNo.Thickness];
MEMSET(ADR(CellMemory[CellNo.Thickness]),0,SIZEOF(CellMemory[CellNo.Thickness]));
Step35:=4100;	


4100://P3_M4电芯分拣夹升降去初始位
IF NOT SingleStep[6] THEN
	
	IF  NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=1;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		Thickness_Finish:=FALSE;
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=4110;
	Thickness_Finish:=FALSE;
	END_IF		
END_IF	

4110://P3_M4电芯分拣夹搬运去厚度烘烤 NG位
IF NOT SingleStep[6] THEN
	
	IF 	arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[6] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving 
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.iGoSetPos:=6;
		SortingCarryTorMark:=TRUE;//电芯分选夹搬运力矩超限报警标志	
	END_IF
	
	IF  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[6] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving THEN
		SortingCarryTorMark:=FALSE;//电芯分选夹搬运力矩超限报警标志
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=4120;	
	END_IF
END_IF

4120:
	IF Push_NG_condition[3] THEN
		P3_Production.OutFlag1:=FALSE;
		P3_Production.NGFlag[4]:=FALSE;//测厚NG料
		P3_Production.NGFlag[6]:=FALSE;//烘烤NG料
		Step35:=4130;
	END_IF

4130://P3_M4电芯分拣夹升降去称重和测厚NG位
IF NOT SingleStep[6] THEN
	
	IF  NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[6] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving
	AND NOT NG_Auto[3].Full
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[6]THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=6;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[6] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=4140;
	END_IF	
END_IF

4140://电芯分选夹升降气缸伸出
IF NOT SingleStep[6] THEN
	
	arrCyCtrl[P3CYNo.P3SortLifting].Cmd.bON:=TRUE;
	
	IF arrCyCtrl[P3CYNo.P3SortLifting].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3SortLifting].Status.Error1 THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=4150;	
	END_IF	
END_IF
	
4150://电芯分选夹开合气缸张开
IF NOT SingleStep[6] THEN
	
	arrCyCtrl[P3CYNo.P3SortClamp].Cmd.bON:=TRUE;
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bOFF:=TRUE;//分选夹归正气缸缩回
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bON:=FALSE;//分选夹归正气缸缩回
	IF arrCyCtrl[P3CYNo.P3SortClamp].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3SortClamp].Status.Error1 AND
       arrCyCtrl[P3CYNo.P3SortPush].Status.OFFState THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=4160;
	END_IF	
END_IF


4160://清掉分选夹子的电芯记忆
MEMSET(ADR(CellMemory[CellNo.SortClip2]),0,SIZEOF(CellMemory[CellNo.SortClip2]));	
Step35:=4180;	
	
4180://P3_M4电芯分拣夹升降去初始位
IF NOT SingleStep[6] THEN
	
	IF  NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=1;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	
	Step35:=4190;
	END_IF	
END_IF

4190://P3_M4电芯分拣夹搬运去初始位
IF NOT SingleStep[6] THEN
	
	IF 	arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] 
	AND	NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[1] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving 
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.iGoSetPos:=1;	
		SortingCarryTorMark:=TRUE;//电芯分选夹搬运力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving THEN
		SortingCarryTorMark:=FALSE;//电芯分选夹搬运力矩超限报警标志
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF
		
		Step35:=4200;
	END_IF	
END_IF
	
4200:
Step35:=1;




END_CASE
END_IF

CASE Step35 OF

195://测厚完成信号，上位机开始上传数据
PC_finish:=FALSE;
Step35:=197;
	
197://测厚完成信号，上位机开始上传数据
IF (Thickness_Finish AND NOT PC_finish)OR P3User2_Par.Shield[5] THEN
	PC_start:=TRUE;
	PC_finish_ton.IN:=FALSE;
	Step35:=198;
END_IF

198://上位机上传数据完成，保存记忆
	IF  PC_finish OR P3User2_Par.Shield[5]  THEN
		PC_start:=FALSE;
		PC_finish:=FALSE;
		PC_finish_CS:=0;
		Step35:=200;
		Output_step:=100;
		Step_Men:=10;//记忆保存
	ELSIF (NOT PC_finish  AND NOT PC_start AND PC_finish_CS=0)AND NOT P3User2_Par.Shield[5] THEN
			PC_finish_ton.IN:=TRUE;
	ELSIF (NOT PC_finish AND P3_Error[5] AND NOT PC_start)AND NOT P3User2_Par.Shield[5] THEN
		Step35:=195;//重新上传
	END_IF
	IF PC_finish_ton.Q THEN
		PC_finish_CS:=PC_finish_CS+1;
		Step35:=195;
	END_IF

END_CASE



CASE Step_Men OF
	
	10:
		CellMemory[80]:=CellMemory[79];
		Step_Men:=20;
		
	20:
		CellMemory[79]:=CellMemory[78];
		Step_Men:=30;
		
	30:
		CellMemory[78]:=CellMemory[77];
		Step_Men:=40;
		
	40:
		CellMemory[77]:=CellMemory[76];
		Step_Men:=50;
		
	50:
		CellMemory[76]:=CellMemory[75];
		Step_Men:=60;
		
	60:
		CellMemory[75]:=CellMemory[74];
		Step_Men:=70;
		
	70:
		CellMemory[74]:=CellMemory[73];
		Step_Men:=80;
		
	80:
		CellMemory[73]:=CellMemory[72];
		Step_Men:=90;
		
	90:
		CellMemory[72]:=CellMemory[71];
		Step_Men:=100;
		
	100:
		CellMemory[71]:=CellMemory[70];
		Step_Men:=110;
	
	110:
		CellMemory[70]:=CellMemory[CellNo.Thickness];
		Step_Men:=120;	
		
	120:
		Step_Men:=666;

END_CASE




