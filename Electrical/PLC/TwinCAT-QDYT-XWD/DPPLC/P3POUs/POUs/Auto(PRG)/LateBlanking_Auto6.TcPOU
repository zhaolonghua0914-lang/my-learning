<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="LateBlanking_Auto6" Id="{b27f848f-d2f6-4c5c-97fc-57c645c0b415}" SpecialFunc="None">
    <Declaration><![CDATA[//分拣中
PROGRAM LateBlanking_Auto6
VAR
	ShortTest_NG_Push: CS_SetpMoterV2;
	weigh_NG_Push: CS_SetpMoterV2;
	Thickness_NG_Push: CS_SetpMoterV2;
	SingleStep_6 : R_TRIG;
	NG_Auto :ARRAY[1..4] OF FB_SetMoter_auto;
	ScanNgCount :INT;
	MesNgCount :INT;
	Cold1Count :INT;
	cold2Count :INT;
	cold3Count :INT;
	I:INT;
	Step_Men :UINT;
	P3SortLifting_TON :ARRAY[1..8] OF Tc2_Standard.TON;
	PC_finish_ton :ton;
	PC_finish_CS :INT;
	P3MotionGoWorkTON :ARRAY[1..4] OF TON;
	P3MotionHave:ARRAY[1..4] OF F_TRIG;
	P3DelayTon:ARRAY[1..10] OF Tc2_Standard.TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
//排杆电机

P3Senser.P3_PoleMotor2_JogP := stP3NgPushMoter[2].bo_Up;
P3Senser.P3_PoleMotor2_JogN := stP3NgPushMoter[2].bo_Down;
stP3NgPushMoter[2].biSensor:=P3Senser.P3_PoleMotor2_Height;
stP3NgPushMoter[2].biBoxSensor:=P3Senser.P3_PoleMotor2_Reach;
stP3NgPushMoter[2].biUpSensor:=P3Senser.P3_PoleMotor2_P_OT;
stP3NgPushMoter[2].biDownSensor:=P3Senser.P3_PoleMotor2_N_OT;
stP3NgPushMoter[2].bHave:=P3Senser.P3_PoleMotor2_bHave;


P3Senser.P3_PoleMotor3_JogP := stP3NgPushMoter[3].bo_Up;
P3Senser.P3_PoleMotor3_JogN := stP3NgPushMoter[3].bo_Down;
stP3NgPushMoter[3].biSensor:=P3Senser.P3_PoleMotor3_Height;
stP3NgPushMoter[3].biBoxSensor:=P3Senser.P3_PoleMotor3_Reach;
stP3NgPushMoter[3].biUpSensor:=P3Senser.P3_PoleMotor3_P_OT;
stP3NgPushMoter[3].biDownSensor:=P3Senser.P3_PoleMotor3_N_OT;
stP3NgPushMoter[3].bHave:=P3Senser.P3_PoleMotor3_bHave;

P3Senser.P3_PoleMotor4_JogP := stP3NgPushMoter[4].bo_Up;
P3Senser.P3_PoleMotor4_JogN := stP3NgPushMoter[4].bo_Down;
stP3NgPushMoter[4].biSensor:=P3Senser.P3_PoleMotor4_Height;
stP3NgPushMoter[4].biBoxSensor:=P3Senser.P3_PoleMotor4_Reach;
stP3NgPushMoter[4].biUpSensor:=P3Senser.P3_PoleMotor4_P_OT;
stP3NgPushMoter[4].biDownSensor:=P3Senser.P3_PoleMotor4_N_OT;
stP3NgPushMoter[4].bHave:=P3Senser.P3_PoleMotor4_bHave;

Push_NG_condition[2]:=stP3NgPushMoter[2].biBoxSensor AND NOT Push_NG_Full[2] AND stP3NgPushMoter[2].HomeDone;
Push_NG_condition[3]:=stP3NgPushMoter[3].biBoxSensor AND NOT Push_NG_Full[3] AND stP3NgPushMoter[3].HomeDone;
Push_NG_condition[4]:=stP3NgPushMoter[4].biBoxSensor AND NOT Push_NG_Full[4] AND stP3NgPushMoter[4].HomeDone;

Push_NG[2]:=(Step35>=1070 AND Step35<=1120); 
Push_NG[3]:=((Step35>=2070 AND Step35<=2120) OR (Step35>=4130 AND Step35<=4180)); 
Push_NG[4]:=(Step35>=3080 AND Step35<=3130); 


P3SortLifting_TON[1](PT:=T#500MS);
P3SortLifting_TON[2](PT:=T#500MS);
P3SortLifting_TON[3](PT:=T#500MS);
P3SortLifting_TON[4](PT:=T#500MS);
P3SortLifting_TON[5](PT:=T#500MS);
P3SortLifting_TON[6](PT:=T#500MS);
P3SortLifting_TON[7](PT:=T#500MS);
P3SortLifting_TON[8](PT:=T#500MS);
PC_finish_ton(PT:=T#5S);
P3MotionGoWorkTON[1](PT:=T#2S);
P3MotionGoWorkTON[2](PT:=T#2S);
P3MotionGoWorkTON[3](PT:=T#2S);
P3MotionGoWorkTON[4](PT:=T#2S);
P3DelayTon[1](PT:=T#1S);
//对齐度NG料盒有料信号下降沿 计时2S 触发 上升定位
P3MotionHave[1](CLK:=P3Senser.P3_PoleMotor1_bHave , Q=> );//
IF  P3MotionHave[1].Q AND NOT  P3Senser.P3_PoleMotor1_bHave THEN
	P3MotionGoWorkTON[1].IN:=TRUE;
END_IF
IF P3MotionGoWorkTON[1].Q THEN
	P3Motion.stP3NgPushMoter[1].bGoWorkPos:=TRUE;
	P3MotionGoWorkTON[1].IN:=FALSE;
END_IF
//对齐度NG料盒有料信号下降沿 触发 上升定位
P3MotionHave[2](CLK:=P3Senser.P3_PoleMotor2_bHave , Q=> );
IF  P3MotionHave[2].Q AND NOT  P3Senser.P3_PoleMotor2_bHave THEN
	P3MotionGoWorkTON[2].IN:=TRUE;
END_IF
IF P3MotionGoWorkTON[2].Q THEN
	P3Motion.stP3NgPushMoter[2].bGoWorkPos:=TRUE;
	P3MotionGoWorkTON[2].IN:=FALSE;
END_IF
//对齐度NG料盒有料信号下降沿 触发 上升定位
P3MotionHave[3](CLK:=P3Senser.P3_PoleMotor3_bHave , Q=> );
IF  P3MotionHave[3].Q AND NOT  P3Senser.P3_PoleMotor3_bHave THEN
	P3MotionGoWorkTON[3].IN:=TRUE;
END_IF
IF P3MotionGoWorkTON[3].Q THEN
	P3Motion.stP3NgPushMoter[3].bGoWorkPos:=TRUE;
	P3MotionGoWorkTON[3].IN:=FALSE;
END_IF
//对齐度NG料盒有料信号下降沿 触发 上升定位
P3MotionHave[4](CLK:=P3Senser.P3_PoleMotor4_bHave , Q=> );
IF  P3MotionHave[4].Q AND NOT  P3Senser.P3_PoleMotor4_bHave THEN
	P3MotionGoWorkTON[4].IN:=TRUE;
END_IF
IF P3MotionGoWorkTON[4].Q THEN
	P3Motion.stP3NgPushMoter[4].bGoWorkPos:=TRUE;
	P3MotionGoWorkTON[4].IN:=FALSE;
END_IF



ACT1();
WeighLine_2:=arrAxisPar[P3AxisNo.P3_M4_WeighLine].arrTargetPoint[1]-5;
Offloading_1:=arrAxisPar[P3AxisNo.P3_M4_OffloadingCarrying].arrTargetPoint[1]+5;
SingleStep_6 (CLK:=P3_Start[6] , Q=>);
IF  SingleStep_6.Q OR NOT StepModel[6] THEN
	SingleStep[6]:=FALSE;
END_IF

IF P3_SystemRUN.iMode=1  AND LateBlanking_init_OK[6]  THEN
CASE Step35 OF
1://电芯分选的气缸回初始状态
    arrCyCtrl[P3CYNo.P3SortPush].Cmd.bOFF:=TRUE;//分选夹归正气缸缩回
    arrCyCtrl[P3CYNo.P3SortClamp].Cmd.bON:=TRUE;//电芯分选夹开合气缸张开
	arrCyCtrl[P3CYNo.P3SortLifting].Cmd.bON:=TRUE;//电芯分选夹升降气缸缩回
	P3SortLifting_TON[1].IN:=FALSE;
	P3SortLifting_TON[2].IN:=FALSE;
	P3SortLifting_TON[3].IN:=FALSE;
	P3SortLifting_TON[4].IN:=FALSE;
	P3SortLifting_TON[5].IN:=FALSE;
	P3SortLifting_TON[6].IN:=FALSE;
	Thickness_Finish:=FALSE;	
IF arrCyCtrl[P3CYNo.P3SortClamp].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3SortClamp].Status.Error1 AND arrCyCtrl[P3CYNo.P3SortLifting].Status.ONState 
	AND NOT arrCyCtrl[P3CYNo.P3SortLifting].Status.Error1 AND arrCyCtrl[P3CYNo.P3SortPush].Status.OFFState THEN 
	Step35:=10;
END_IF

10://电芯分选的电机回初始状态
IF NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] 
AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error 
AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled 
AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
	arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=1;//P3_M4电芯分拣夹升降去初始位
END_IF

IF	arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1]
AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[1] 
AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Error 
AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Homed 
AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Enabled 
AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving 
AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState THEN
	arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.iGoSetPos:=1;	//P3_M4电芯分拣夹搬运去初始位
	SortingCarryTorMark:=TRUE;//电芯分选夹搬运力矩超限报警标志
END_IF

IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] 
AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving 
AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[1] 
AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving THEN
	SortingCarryTorMark:=FALSE;//电芯分选夹搬运力矩超限报警标志
	Step35:=15;	
END_IF	

15:
PC_finish:=FALSE;
arrCyCtrl[P3CYNo.P3SortRotate].Cmd.bOFF:=TRUE;//电芯分选夹旋转气缸回0度
IF  arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3SortRotate].Status.Error2  THEN
Step35:=20;	
END_IF


20://称重完成,允许测厚
IF  Weigh_Finish AND Permit_ThicknessRack AND CellMemory[CellNo.Weight].Cell THEN
	Step35:=30;
	
END_IF
(*IF  Permit_Weigh AND NOT Weigh_Finish AND Permit_ThicknessRack AND CellMemory[CellNo.Weight].Cell AND NOT Shield[2] AND P3_SystemRUN.bReset THEN
	weight_step:=10;
END_IF*)

30://P3_M4电芯分选夹搬运去称重位
IF NOT SingleStep[6] THEN
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bOFF:=TRUE;//分选夹归正气缸缩回
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bON:=FALSE;//分选夹归正气缸缩回
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] 
	AND LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.fActPos)>=WeighLine_2//安全条件
	AND arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.Homed 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[2] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving 
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.iGoSetPos:=2;//电芯分选夹搬运去称重位	
		SortingCarryTorMark:=TRUE;//电芯分选夹搬运力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[2] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving THEN
		SortingCarryTorMark:=FALSE;//电芯分选夹搬运力矩超限报警标志
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=35;	
	END_IF
END_IF	

35://P3_M4电芯分选夹升降去称重辅助位
IF NOT SingleStep[6] THEN
	
	IF NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[8] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving 
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[2] THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=8;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[8] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=60;	
	END_IF
END_IF	
	
60://电芯分选夹开合气缸闭合
IF NOT SingleStep[6] THEN
	
	arrCyCtrl[P3CYNo.P3SortClamp].Cmd.bOFF:=TRUE;
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bON:=TRUE;//分选夹归正气缸伸出
	IF arrCyCtrl[P3CYNo.P3SortClamp].Status.OFFState AND arrCyCtrl[P3CYNo.P3SortPush].Status.ONState AND
       NOT arrCyCtrl[P3CYNo.P3SortClamp].Status.Error2 THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=65;	
	END_IF
END_IF

65://P3_M4电芯分拣夹升降去称重位
IF NOT SingleStep[6] THEN
	
	IF NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[2] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=2;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[2] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=70;	
	P3SortLifting_TON[1].IN:=FALSE;
	END_IF
END_IF	

70://电芯分选夹升降气缸缩回
IF NOT SingleStep[6] THEN
	
	arrCyCtrl[P3CYNo.P3SortLifting].Cmd.bOFF:=TRUE;
	P3SortLifting_TON[1].IN:=TRUE;
	IF P3SortLifting_TON[1].Q(* AND arrCyCtrl[P3CYNo.P3SortLifting].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3SortLifting].Status.Error2*) THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF			
	Step35:=75;	
	P3SortLifting_TON[1].IN:=FALSE;
	END_IF	
END_IF


	
75://P3_M4电芯分拣夹升降去初始位
IF NOT SingleStep[6] THEN
	
	IF NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=1;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=80;		
	END_IF
END_IF	


80://电芯记忆从称重平台转移到分选夹子
Weigh_Finish:=FALSE;
CellMemory[CellNo.SortClip1]:=CellMemory[CellNo.Weight];
MEMSET(ADR(CellMemory[CellNo.Weight]),0,SIZEOF(CellMemory[CellNo.Weight]));
Step35:=90;	




90://P3_M4电芯分拣夹搬运去测厚位
IF NOT SingleStep[6] THEN
	
	IF  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND 
		NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[3] 
		AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Error 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Enabled 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving 
		AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState  THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.iGoSetPos:=3;	
		SortingCarryTorMark:=TRUE;//电芯分选夹搬运力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[3] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving THEN
		SortingCarryTorMark:=FALSE;//电芯分选夹搬运力矩超限报警标志
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=100;	
	END_IF
END_IF	

100://判断是否有测厚允许上料信号
IF Permit_ThicknessRack  AND arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Status.Error1 
	AND  arrCyCtrl[P3CYNo.P3ThicknessPressure].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3ThicknessPressure].Status.Error2 AND
	arrCyCtrl[P3CYNo.P3ThicknessSupport].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3ThicknessSupport].Status.Error1 THEN 
	Step35:=150;
END_IF


150://P3_M4电芯分拣夹升降去测厚位
IF NOT SingleStep[6] THEN
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bOFF:=TRUE;//分选夹归正气缸缩回
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bON:=FALSE;//分选夹归正气缸缩回	

	IF  NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[3] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving 
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[3] THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=3;
	END_IF
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[3] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=160;	
	END_IF
END_IF	

160://电芯分选夹升降气缸上升
IF NOT SingleStep[6] THEN
	
	arrCyCtrl[P3CYNo.P3SortLifting].Cmd.bON:=TRUE;
	
	IF arrCyCtrl[P3CYNo.P3SortLifting].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3SortLifting].Status.Error1 THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=165;	
	END_IF	
END_IF

165://P3_M4电芯分拣夹升降去测厚辅助位条件
IF NOT SingleStep[6] THEN
	IF  NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[9] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=9;//电芯分拣夹升降去测厚辅助位
	END_IF
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[9] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=170;	
	END_IF
END_IF	
	
170://电芯分选夹开合气缸张开
IF NOT SingleStep[6] THEN
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bOFF:=TRUE;//分选夹归正气缸缩回
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bON:=FALSE;//分选夹归正气缸缩回
	arrCyCtrl[P3CYNo.P3SortClamp].Cmd.bON:=TRUE;
	
	IF arrCyCtrl[P3CYNo.P3SortClamp].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3SortClamp].Status.Error1  AND
       arrCyCtrl[P3CYNo.P3SortPush].Status.OFFState    THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=185;

	END_IF
END_IF


185://电芯记忆从分选夹子转移到测厚平台
CellMemory[CellNo.Thickness]:=CellMemory[CellNo.SortClip1];
MEMSET(ADR(CellMemory[CellNo.SortClip1]),0,SIZEOF(CellMemory[CellNo.SortClip1]));
Step35:=190;

	
190://P3_M4电芯分拣夹升降去初始位
IF NOT SingleStep[6] THEN
	
	IF NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=1;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
			IF NOT  P3User2_Par.Shield[3] THEN
				Step35:=193;
				PC_finish:=FALSE;	
				Permit_Thickness := TRUE ;					
			ELSE	
				Step35:=193;
				PC_finish:=FALSE;	
				Permit_Thickness:=FALSE;
				Thickness_Finish:=TRUE;
			END_IF
	END_IF	
END_IF	

193://测厚完成，记录产出时间
IF Thickness_Finish OR  P3User2_Par.Shield[3] THEN
CellMemory[CellNo.Thickness].Out_Time:=Outtime;
Step35:=195;
END_IF
	
200://NG料统计
IF Thickness_Finish AND CellMemory[CellNo.Thickness].Hough=1 
AND (CellMemory[CellNo.Thickness].ScanCode=1 OR P3User2_Par.Shield[4])  
AND (CellMemory[CellNo.Thickness].ShortTest=1 OR P3User2_Par.Shield[1]) 
(*AND (CellMemory[CellNo.Thickness].Weight=1 OR P3User2_Par.Shield[2] ) *)
AND (CellMemory[CellNo.Thickness].Thickness=1 OR P3User2_Par.Shield[3]) 
AND ((NOT P3User2_Par.Shield[11] AND CellMemory[CellNo.Thickness].DT_station_No='1#')
OR (NOT P3User2_Par.Shield[12] AND CellMemory[CellNo.Thickness].DT_station_No='2#')
OR (NOT P3User2_Par.Shield[13] AND CellMemory[CellNo.Thickness].DT_station_No='3#'))
AND ((CellMemory[CellNo.Thickness].Cell_cold_result AND CellMemory[CellNo.Thickness].Cell_cold_result1 AND CellMemory[CellNo.Thickness].Cell_cold_result2) OR P3User2_Par.Shield[5]) 
AND NOT CellMemory[CellNo.Thickness].DTDebugMode      THEN
	Step35:=500;
	P3_Production.OutFlag1:=TRUE;
ELSIF (P3User2_Par.Shield[11] AND CellMemory[CellNo.Thickness].DT_station_No='1#' AND Thickness_Finish) OR
      ((*P2M1_MachCtrl.DT_b.DT_DebugMode AND*) CellMemory[CellNo.Thickness].DT_station_No='1#' AND CellMemory[CellNo.Thickness].DTDebugMode AND Thickness_Finish) THEN
	P3_Production.OutFlag1:=TRUE;
	P3_Production.NGFlag[10]:=TRUE;//踢一号叠台首检料
	IF CellMemory[CellNo.Thickness].DTDebugMode THEN
	   P3_Error[83]:=TRUE ;//1号叠台调试模式踢料报警
	END_IF
	Step35:=1000;
ELSIF (P3User2_Par.Shield[12] AND CellMemory[CellNo.Thickness].DT_station_No='2#' AND Thickness_Finish ) OR
      ((*P2M2_MachCtrl.DT_b.DT_DebugMode AND*) CellMemory[CellNo.Thickness].DT_station_No='2#' AND CellMemory[CellNo.Thickness].DTDebugMode AND Thickness_Finish) THEN
	P3_Production.OutFlag1:=TRUE;
	P3_Production.NGFlag[11]:=TRUE;//踢二号叠台首检料
	IF CellMemory[CellNo.Thickness].DTDebugMode THEN
	   P3_Error[84]:=TRUE ;//2号叠台调试模式踢料报警
	END_IF	
	Step35:=1000;
ELSIF (P3User2_Par.Shield[13] AND CellMemory[CellNo.Thickness].DT_station_No='3#' AND Thickness_Finish ) OR
      ((*P2M3_MachCtrl.DT_b.DT_DebugMode AND*) CellMemory[CellNo.Thickness].DT_station_No='3#' AND CellMemory[CellNo.Thickness].DTDebugMode AND Thickness_Finish) THEN
	P3_Production.OutFlag1:=TRUE;
	P3_Production.NGFlag[12]:=TRUE;//踢三号叠台首检料
	IF CellMemory[CellNo.Thickness].DTDebugMode THEN
	   P3_Error[85]:=TRUE ;//3号叠台调试模式踢料报警
	END_IF
	Step35:=1000;		
ELSIF  CellMemory[CellNo.Thickness].ShortTest<>1 AND Thickness_Finish THEN//踢短路NG料
	P3_Production.OutFlag1:=TRUE;
	P3_Production.NGFlag[2]:=TRUE;//踢短路NG料
	Step35:=1000;
ELSIF CellMemory[CellNo.Thickness].Hough=2  AND Thickness_Finish THEN
	Step35:=1000;
	P3_Production.OutFlag1:=TRUE;//对齐度NG料
ELSIF Thickness_Finish AND CellMemory[CellNo.Thickness].Thickness<>1 THEN//踢测厚NG料
	P3_Production.OutFlag1:=TRUE;
	P3_Production.NGFlag[4]:=TRUE;//测厚NG料
	Step35:=4000;
ELSIF Thickness_Finish AND CellMemory[CellNo.Thickness].OvenShift_NG_T THEN//踢烤箱NG料
	P3_Production.OutFlag1:=TRUE;
	P3_Production.NGFlag[6]:=TRUE;//烤箱超时NG料
	Step35:=4000;
ELSIF (NOT CellMemory[CellNo.Thickness].Cell_cold_result OR NOT CellMemory[CellNo.Thickness].Cell_cold_result1 OR NOT CellMemory[CellNo.Thickness].Cell_cold_result2 ) 
		AND NOT P3User2_Par.Shield[5] AND Thickness_Finish THEN //踢MES不良的NG料
	IF NOT CellMemory[CellNo.Thickness].Cell_cold_result THEN//冷压上料MES判断
		Cold1Count:=Cold1Count+1;
	ELSIF NOT CellMemory[CellNo.Thickness].Cell_cold_result1 THEN//校对数据MES判断
		Cold2Count:=Cold2Count+1;
	ELSIF NOT CellMemory[CellNo.Thickness].Cell_cold_result2 THEN//热压下料MES判断
		Cold3Count:=Cold3Count+1;	
	END_IF
	P3_Production.OutFlag1:=TRUE;
	P3_Production.NGFlag[5]:=TRUE;	//MES卡站NG
	Step35:=3000;
ELSIF CellMemory[CellNo.Thickness].ScanCode<>1  AND Thickness_Finish THEN//踢扫码NG料
	P3_Production.OutFlag1:=TRUE;
	P3_Production.NGFlag[1]:=TRUE;//踢扫码NG料
	Step35:=3000;
(*ELSIF CellMemory[CellNo.Thickness].Weight<>1 AND Thickness_Finish THEN//踢称重NG料
	P3_Production.OutFlag1:=TRUE;
	P3_Production.NGFlag[3]:=TRUE;//踢称重NG料
	Step35:=2000;*)
END_IF


500://测厚完成，测厚台切换气缸打开
 IF Thickness_Finish  AND arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3ThicknessMeasuringSwitch].Status.Error1 
	AND  arrCyCtrl[P3CYNo.P3ThicknessPressure].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3ThicknessPressure].Status.Error2 AND
	arrCyCtrl[P3CYNo.P3ThicknessSupport].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3ThicknessSupport].Status.Error1 THEN 
	Step35:=515;
END_IF


515://电芯分选夹升降去初始位

IF NOT SingleStep[6] THEN
	
	IF NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=1;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=517;	
	END_IF	
END_IF

517://电芯分选夹搬运去测厚位条件
IF NOT SingleStep[6] THEN
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] 
	AND LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.fActPos)>=WeighLine_2//安全条件
	AND arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.Homed 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[3] 
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.iGoSetPos:=3;	//电芯分选夹搬运去测厚位
		SortingCarryTorMark:=TRUE;//电芯分选夹搬运力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[3] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving THEN
		SortingCarryTorMark:=FALSE;//电芯分选夹搬运力矩超限报警标志
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=520;	
	END_IF
END_IF

520://P3_M4电芯分拣夹升降去测厚辅助位条件
IF NOT SingleStep[6] THEN
	
	IF 	// NOT P3Senser.P3_CacheSensor AND
	NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[9]
	AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving 
	AND arrCyCtrl[P3CYNo.P3SortRotate].Status.OFFState 
	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[3]THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=9;//P3_M4电芯分拣夹升降去测厚辅助位
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[9] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=530;	
	END_IF
END_IF	

530://电芯分选夹开合气缸夹紧
IF NOT SingleStep[6] THEN
	
	arrCyCtrl[P3CYNo.P3SortClamp].Cmd.bOFF:=TRUE;
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bOFF:=FALSE;//分选夹归正气缸伸出
	 arrCyCtrl[P3CYNo.P3SortPush].Cmd.bON:=TRUE;//分选夹归正气缸伸出
	IF arrCyCtrl[P3CYNo.P3SortClamp].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3SortClamp].Status.Error2 AND
       arrCyCtrl[P3CYNo.P3SortPush].Status.ONState   THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=550;	
	END_IF
END_IF
	
550://P3_M4电芯分拣夹升降去测厚位
IF NOT SingleStep[6] THEN
	
	IF NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[3] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=3;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[3] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=575;
	P3SortLifting_TON[2].IN:=FALSE;	
	END_IF
END_IF	


575://电芯分选夹升降气缸压紧
IF NOT SingleStep[6] THEN
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bON:=TRUE;//分选夹归正气缸伸出
	arrCyCtrl[P3CYNo.P3SortLifting].Cmd.bOFF:=TRUE;
	P3SortLifting_TON[2].IN:=TRUE;	
	IF P3SortLifting_TON[2].Q(*arrCyCtrl[P3CYNo.P3SortLifting].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3SortLifting].Status.Error2*) THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=580;
	P3SortLifting_TON[2].IN:=FALSE;		
	END_IF	
END_IF

580://电芯记忆从测厚平台转移到分选夹子
CellMemory[CellNo.SortClip2]:=CellMemory[CellNo.Thickness];
MEMSET(ADR(CellMemory[CellNo.Thickness]),0,SIZEOF(CellMemory[CellNo.Thickness]));
Step35:=585;	


585://P3_M4电芯分拣夹升降去初始位
IF NOT SingleStep[6] THEN
	
	IF NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=1;
	END_IF
	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		Thickness_Finish:=FALSE;	
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=590;
	END_IF	
END_IF	

590://判断是否有允许放料信号
IF NOT SingleStep[6] THEN
IF (NOT P3User2_Par.Shield[22] AND Uppercorepermit) OR (P3User2_Par.Shield[22] AND Permit_BlankingRack) THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=595;	
END_IF
END_IF

595://P3_M4电芯分拣夹搬运去放料位
IF NOT SingleStep[6] THEN
	IF LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_OffloadingCarrying].Status.fActPos)<=Offloading_1//电芯下料搬运夹安全条件
		AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[4] 
		AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Error 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.Enabled 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving 
		AND arrCyCtrl[P3CYNo.P3CellAdvance].Status.OFFState 
        AND NOT arrCyCtrl[P3CYNo.P3CellAdvance].Status.ONState 
		//AND arrCyCtrl[P3CYNo.P3CellSpin].Status.OFFState 
		AND  arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Cmd.arrbRealPoint[8] 
		AND NOT arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Status.Error 
		AND arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Status.Homed
		AND arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Status.Enabled 
		AND arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Status.NoMoving
		THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.iGoSetPos:=4;	
		SortingCarryTorMark:=TRUE;//电芯分选夹搬运力矩超限报警标志
	END_IF
	
	IF  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[4] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Status.NoMoving THEN
		SortingCarryTorMark:=FALSE;//电芯分选夹搬运力矩超限报警标志
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
		IF P3User2_Par.Shield[20] THEN
			Step35:=605;
		ELSE
			Step35:=600;	
		END_IF
	END_IF	
END_IF	

600://电芯分选夹旋转气缸回90度
IF NOT SingleStep[6] THEN
	P3DelayTon[1].IN:=FALSE;
	arrCyCtrl[P3CYNo.P3SortRotate].Cmd.bON:=TRUE;
	
	IF arrCyCtrl[P3CYNo.P3SortRotate].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3SortClamp].Status.Error1 THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF
	P3DelayTon[1].IN:=TRUE;	
	IF P3DelayTon[1].Q THEN
		Step35:=605;
	END_IF	
	END_IF
END_IF

605://P3_M4电芯分拣夹升降去放料位
IF NOT SingleStep[6] THEN	
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bOFF:=TRUE;//分选夹归正气缸缩回
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bON:=FALSE;//分选夹归正气缸缩回	

	IF 	NOT P3Senser.P3_CacheSensor 
		AND	NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[4] 
		AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving  
		AND arrCyCtrl[P3CYNo.P3CellAdvance].Status.OFFState 
        AND NOT arrCyCtrl[P3CYNo.P3CellAdvance].Status.ONState 
		AND arrCyCtrl[P3CYNo.P3CellSpin].Status.OFFState 
		AND arrCyCtrl[P3CYNo.P3SortRotate].Status.ONState
		AND  arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Cmd.arrbRealPoint[8] 
		AND NOT arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Status.Error 
		AND arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Status.Homed
		AND arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Status.Enabled 
		AND arrAxisCtrl[P3AxisNo.P3_TapeTranslation].Status.NoMoving 
		AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Cmd.arrbRealPoint[4]THEN
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.iGoSetPos:=4;
	END_IF	
	IF arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF	
	Step35:=610;	
	END_IF
END_IF		

610://电芯分选夹升降气缸伸出
IF NOT SingleStep[6] THEN
	
	arrCyCtrl[P3CYNo.P3SortLifting].Cmd.bON:=TRUE;
	
	IF arrCyCtrl[P3CYNo.P3SortLifting].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3SortLifting].Status.Error1 THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF		
	Step35:=615;	
	END_IF	
END_IF

615: //电芯分选夹升降走相对位置下降一定高度再打开开合气缸
IF NOT SingleStep[6] THEN
	
	IF   arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.arrbRealPoint[4] AND NOT arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Error AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Homed
	 	AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		arrAxisPar[P3AxisNo.P3_M4_SortingoutUpDown].fVelocity_of_Rel := 20   ;
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.fPosition_of_Rel := 3  ;
		arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Cmd.bMoveRel :=  TRUE ;
	END_IF
	
	IF arrAxis[P3AxisNo.P3_M4_SortingoutUpDown].NcToPlc.SetPos - arrAxisPar[P3AxisNo.P3_M4_SortingoutUpDown].arrTargetPoint[4] >=2.5  AND arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Status.NoMoving THEN
		IF  StepModel[6] THEN
			SingleStep[6]:=TRUE;
		ELSE
			SingleStep[6]:=FALSE;
		END_IF
	Step35:=620;
	END_IF	
END_IF
	
620://电芯分选夹开合气缸张开
IF NOT SingleStep[6] THEN
	
	arrCyCtrl[P3CYNo.P3SortClamp].Cmd.bON:=TRUE;
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bOFF:=TRUE;//分选夹归正气缸缩回
	arrCyCtrl[P3CYNo.P3SortPush].Cmd.bON:=FALSE;//分选夹归正气缸缩回
