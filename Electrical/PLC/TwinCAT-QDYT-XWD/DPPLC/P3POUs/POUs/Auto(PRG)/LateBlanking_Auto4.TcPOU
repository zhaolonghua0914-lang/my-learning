<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="LateBlanking_Auto4" Id="{360cb696-b44b-4c9a-9b62-47ca4ad334bf}" SpecialFunc="None">
    <Declaration><![CDATA[//热压中
PROGRAM LateBlanking_Auto4
VAR
	FB_CSP_Velo_Torque_Hot: FB_CSP_Velo_Torque;
	SingleStep_4 : R_TRIG;
	b_Hot_TON :ARRAY[1..10] OF ton;
	Sampling_1: Sampling;
	Sampling1: Sampling;
	BlowTime:TON;
	BlowCloseTime:TON;
	rt: R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Hot_Press();
b_Hot_TON[2](PT:=T#200MS);
b_Hot_TON[3](PT:=T#1S);
Hotbusy:=FB_CSP_Velo_Torque_Hot.Busy;

//清零自动复位
b_Hot_TON[1](IN:=Press_Clear[2],PT:=T#300MS);
IF b_Hot_TON[1].Q THEN
	Press_Clear[2]:=FALSE;
END_IF


FB_CSP_Velo_Torque_Hot.Hold_Time:=P3Par.P3_Press_Time[2]*1000;
P3Senser.P3_Hot_clear:=Press_Clear[2];

SingleStep_4 (CLK:=P3_Start[4] , Q=>);
IF  SingleStep_4.Q OR NOT StepModel[4]  THEN
	SingleStep[4]:=FALSE;
END_IF

IF Permit_Blow[2] AND P3_SystemRUN.iMode=1 AND
   LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.fActPos) <= arrAxisPar[P3AxisNo.P3_M3_HotPressingActuated].arrTargetPoint[4] AND
   LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.fActPos) > arrAxisPar[P3AxisNo.P3_M3_HotPressingActuated].arrTargetPoint[5] THEN
   arrCyCtrl[P3CYNo.P3HotBlow].Cmd.bON:=TRUE;
   arrCyCtrl[P3CYNo.P3HotBlow].Cmd.bOFF:=FALSE; 
END_IF   

IF P3_SystemRUN.iMode=1 AND 
   LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.fActPos) <= arrAxisPar[P3AxisNo.P3_M3_HotPressingActuated].arrTargetPoint[5]  THEN
   arrCyCtrl[P3CYNo.P3HotBlow].Cmd.bON:=FALSE;
   arrCyCtrl[P3CYNo.P3HotBlow].Cmd.bOFF:=TRUE;
END_IF   

(*BlowTime(IN:=Permit_Blow[2], PT:=T#0S , Q=> , ET=> );
BlowCloseTime(IN:=arrCyCtrl[P3CYNo.P3HotBlow].Cmd.bON, PT:=T#2S , Q=> , ET=> );
IF BlowTime.Q THEN//热压吹气
	arrCyCtrl[P3CYNo.P3HotBlow].Cmd.bON:=TRUE;
	arrCyCtrl[P3CYNo.P3HotBlow].Cmd.bOFF:=FALSE;
ELSIF BlowCloseTime.Q THEN
	arrCyCtrl[P3CYNo.P3HotBlow].Cmd.bON:=FALSE;
	arrCyCtrl[P3CYNo.P3HotBlow].Cmd.bOFF:=TRUE;
END_IF*)


IF P3_SystemRUN.iMode=1  AND LateBlanking_init_OK[4]  THEN
CASE Step33 OF
1://轴和气缸回初始状态
IF NOT SingleStep[4] THEN
	
	arrCyCtrl[P3CYNo.P3HotPressTensed].Cmd.bON:=TRUE;//热压麦拉膜气缸松开
	
	IF  (NOT arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Cmd.arrbRealPoint[1]) AND (NOT arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.Error) AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Cmd.iGoSetPos:=1;	//P3_M3热压驱动电机去初始位
	END_IF
	
	IF  arrCyCtrl[P3CYNo.P3ShortTest].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3ShortTest].Status.Error2 AND
		(NOT arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.arrbRealPoint[1]) AND (NOT arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.Error) AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.iGoSetPos:=1;	//P3_M3热压麦拉膜电机去初始位
	END_IF
	
	IF  arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.NoMoving AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.arrbRealPoint[1] 
		AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.NoMoving (*AND arrCyCtrl[P3CYNo.P3HotPressTensed].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3HotPressTensed].Status.Error1 *)THEN
		IF  StepModel[4] THEN
			SingleStep[4]:=TRUE;
		ELSE
			SingleStep[4]:=FALSE;
		END_IF		
	Step33:=10;	
	END_IF
	END_IF

10://有允许热压信号、热压驱动在初始位、热压有电芯记忆、热压托板开合在初始位，则跳至15步
	IF NOT SingleStep[4] THEN
		IF  Permit_Hot_Press AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Cmd.arrbRealPoint[1] AND  CellMemory[CellNo.Hotpress].Cell AND
			NOT Hot_Press_Finish AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.arrbRealPoint[1]THEN
			Step33:=15;
			HotPress_start:=FALSE;
			Press_Clear[2]:=TRUE;		
			IF  StepModel[4] THEN
				SingleStep[4]:=TRUE;
			ELSE
				SingleStep[4]:=FALSE;
			END_IF	
		END_IF
	END_IF

15://热压压力、温度上下限
	CellMemory[CellNo.Hotpress].HotPress_SV:=P3Par.P3_Press_SV[2];
	CellMemory[CellNo.Hotpress].HotPress_SV_H:=P3Par.P3_Press_SV[2]+150;
	CellMemory[CellNo.Hotpress].HotPress_SV_L:=P3Par.P3_Press_SV[2]-150;
	CellMemory[CellNo.Hotpress].HotPress_Time:=TIME_TO_UINT(P3Par.P3_Press_Time[2]);
	CellMemory[CellNo.Hotpress].HotPress_PVTime:=TIME_TO_UINT(P3Par.P3_Press_Time[2]);
	CellMemory[CellNo.Hotpress].HotTemp_SV:=arrTempPar[93].fTempSet;
	CellMemory[CellNo.Hotpress].HotTemp_H:=arrTempPar[93].fTempSet+5;
	CellMemory[CellNo.Hotpress].HotTemp_L:=arrTempPar[93].fTempSet-5;
	CellMemory[CellNo.Hotpress].HotTemp_PV:=arrTempCtrl[93].Tem_fPV;
	Step33:=20;



20://热压托板开合去张开位条件
	IF NOT SingleStep[4] THEN
	    arrCyCtrl[P3CYNo.P3HotPressTensed].Cmd.bON:=TRUE;//冷压麦拉膜气缸张紧
		
		IF  (arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] OR LREAL_TO_REAL(arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.fActPos)<(arrAxisParV2[P3AxisNo.P3_M2_OvenCarrying].arrTargetPoint[45]+1)) AND 
			LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Status.fActPos)<=(arrAxisPar[P3AxisNo.P3_M4_WeighLine].arrTargetPoint[1]+2) AND
			(NOT arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.arrbRealPoint[2]) AND (NOT arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.Error)
			AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.Homed AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.NoMoving THEN
			arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.iGoSetPos:=2;	//P3_M1冷压麦拉膜电机去张开位
		END_IF
		
		IF  arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.NoMoving 
			(*AND arrCyCtrl[P3CYNo.P3HotPressTensed].Status.ONState AND NOT arrCyCtrl[P3CYNo.P3HotPressTensed].Status.Error1*) THEN
			IF  StepModel[4] THEN
				SingleStep[4]:=TRUE;
			ELSE
				SingleStep[4]:=FALSE;
			END_IF
		HotPress_start:=FALSE;
		Step33:=25;	
		END_IF
	END_IF

25://检测电芯是否偏移
	IF NOT SingleStep[4] THEN
		IF NOT P3Senser.P3_HotOffset_L THEN
			IF  StepModel[4] THEN
				SingleStep[4]:=TRUE;
			ELSE
				SingleStep[4]:=FALSE;
			END_IF
	    b_Hot_TON[3].IN:=FALSE;
		Step33:=30;	
		ELSE
			P3_Error[50]:=TRUE;//热压位电芯位置偏移报警
		//	Step33:=888;
		END_IF
	END_IF
	
30://满足条件，热压开始，开始走PID
	IF NOT SingleStep[4] THEN
		IF  (arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Cmd.arrbRealPoint[43] OR LREAL_TO_REAL(arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Status.fActPos)<arrAxisParV2[P3AxisNo.P3_M2_OvenCarrying].arrTargetPoint[45]) AND 
		arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.NoMoving 
		AND Permit_Hot_Press  AND b_Press_condition[2] AND CellMemory[CellNo.Hotpress].Cell THEN
			HotPress_start:=TRUE;
			Step33:=35;
			Sampling_finish[2]:=FALSE;
			  b_Hot_TON[3].IN:=FALSE;
			IF  StepModel[4] THEN
				SingleStep[4]:=TRUE;
			ELSE
				SingleStep[4]:=FALSE;
			END_IF
		ELSIF NOT b_Press_condition[2] THEN
		       IF NOT b_Hot_TON[3].Q   THEN
		          b_Hot_TON[3].IN:=TRUE;
	           ELSE
	              P3_Error[63]:=TRUE;//热压空压报警
	           END_IF
		          b_Hot_TON[3].IN:=FALSE;	
	   END_IF
	END_IF
	

END_CASE
END_IF


IF P3_SystemRUN.iMode=1 OR P3_SystemRUN.iMode=3 THEN
CASE Step33 OF

35://热压实际压力等于采集平均值
IF Sampling_finish[2] THEN
CellMemory[CellNo.Hotpress].HotPress_PV:=Sampling_mean[2]; 
CellMemory[CellNo.Hotpress].Shortpress:=Sampling_mean[2]; 
//CellMemory[CellNo.Hotpress].HeatActPos:=LREAL_TO_REAL(arrAxisCtrlV2[P3AxisNo.P3_M3_HotPressingActuated].Status.fActPos);
   Step33:=40;	
 END_IF
	
	
40:
b_Hot_TON[2].IN:=TRUE;
IF FB_CSP_Velo_Torque_Hot.HoldOK AND FB_CSP_Velo_Torque_Hot.Done AND b_Hot_TON[2].Q THEN
HotPress_start:=FALSE;
b_Hot_TON[2].IN:=FALSE;
 Step33:=50;	
END_IF 




50://短路测试夹气缸上升,热压完成
	IF ShortTest_Finish OR P3User2_Par.Shield[1] THEN
		arrCyCtrl[P3CYNo.P3ShortTest].Cmd.bOFF:=TRUE;
		IF arrCyCtrl[P3CYNo.P3ShortTest].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3ShortTest].Status.Error2 THEN	
			Step33:=60;
		
		END_IF
	END_IF	
60://检测电芯是否偏移
	IF NOT SingleStep[4] THEN
		IF NOT P3Senser.P3_HotOffset_L THEN
			IF  StepModel[4] THEN
				SingleStep[4]:=TRUE;
			ELSE
				SingleStep[4]:=FALSE;
			END_IF
		Step33:=70;	
		ELSE
			P3_Error[50]:=TRUE;//热压位电芯位置偏移报警
		//	Step33:=888;
		END_IF
	END_IF

70://热压麦拉张紧气缸张开，热压驱动、托板开合电机去初始位
IF NOT SingleStep[4] THEN
	
	arrCyCtrl[P3CYNo.P3HotPressTensed].Cmd.bON:=TRUE;//热压麦拉膜气缸
	
	IF  (NOT arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Cmd.arrbRealPoint[1]) AND (NOT arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.Error) 
		AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.Homed AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.Enabled 
		AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Cmd.iGoSetPos:=1;	//P3_M3热压驱动电机去初始位
	END_IF
	
	IF  arrCyCtrl[P3CYNo.P3ShortTest].Status.OFFState AND NOT arrCyCtrl[P3CYNo.P3ShortTest].Status.Error2  AND	(NOT arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.arrbRealPoint[1]) 
	AND (NOT arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.Error) AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.Homed 
		AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.Enabled AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.NoMoving THEN
		arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.iGoSetPos:=1;	//P3_M3热压麦拉膜电机去初始位
	END_IF
	
	IF  arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.NoMoving
		 AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Status.NoMoving THEN
			IF  StepModel[4] THEN
				SingleStep[4]:=TRUE;
			ELSE
				SingleStep[4]:=FALSE;
			END_IF
			Hot_Press_Finish:=TRUE;
    			Permit_Hot_Press:=FALSE;		
			Step33:=1;	
		END_IF	
	END_IF




END_CASE
END_IF

rt (CLK:=Pressing[2] , Q=>);
IF rt .Q THEN
	CellMemory[CellNo.Hotpress].HeatActPos:=LREAL_TO_REAL(arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Status.fActPos);
END_IF
]]></ST>
    </Implementation>
    <Action Name="Hot_Press" Id="{d7961ef2-0413-4e94-b049-fd57a5ced31b}">
      <Implementation>
        <NWL>
          <XmlArchive>
