  <POU Name="P3IOLink" Id="{531ff1ad-88e3-43e9-8c4e-3636fec73eba}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P3IOLink
VAR
//	tFlash: TON;
//	bFlash:BOOL;
//	bIOinit: BOOL;
	XXX: INT;
	Q20815: BOOL;
	AA: INT;

     arrFilter_AD               : ARRAY[1..MaxAINo]  OF  FB_Filter_AD ;




	I1: INT;

    rt01   :Tc2_Standard.R_TRIG;
    rt02   :Tc2_Standard.R_TRIG;

     parDAOld                   :ARRAY[1..44] OF INT;   
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[

P3_AI();
P3_AO();
P3_AutoLink();
P3_InPut();
P3_LimitSwitch();
P3_OutPut();

















]]></ST>
