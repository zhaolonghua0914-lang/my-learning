arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Io.biNegLimit:=  arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Io.DigitalInputs.17;
arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Io.DigitalInputs.17;

arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Io.DigitalInputs;//热压托板开合电机
