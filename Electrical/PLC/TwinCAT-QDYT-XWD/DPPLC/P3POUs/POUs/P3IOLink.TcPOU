P3Press.Readybtn:=I609[15]  ;//	备胶按钮
P3Senser.P3_BuleHavetape:=I609[16]  ;//后段蓝胶胶带有料检测

arrCyCtrl[P3CYNo.P3CellPush].Io.DIOnSwitch:=I701[1]	;//电芯压紧气缸伸出位	
