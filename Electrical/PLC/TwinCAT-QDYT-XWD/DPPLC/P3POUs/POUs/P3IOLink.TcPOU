arrAxisCtrl[P3AxisNo.P3M1_ColdpreSupPlateLine].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3M1_ColdpreSupPlateLine].Io.DigitalInputs.7;

arrAxisCtrl[P3AxisNo.P3M1_ColdpreActuated].Io.DigitalInputs;//冷压驱动电机
