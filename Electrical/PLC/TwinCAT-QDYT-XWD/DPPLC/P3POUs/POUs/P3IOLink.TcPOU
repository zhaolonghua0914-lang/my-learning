arrAxisCtrl[P3AxisNo.P3M1_ColdpreActuated].Io.biNegLimit:=  arrAxisCtrl[P3AxisNo.P3M1_ColdpreActuated].Io.DigitalInputs.17;
arrAxisCtrl[P3AxisNo.P3M1_ColdpreActuated].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3M1_ColdpreActuated].Io.DigitalInputs.17;

arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Io.DigitalInputs;//烤箱上料夹搬运电机
arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Io.biPosLimit :=  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Io.DigitalInputs.16;
arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Io.biNegLimit :=  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Io.DigitalInputs.17;
arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Io.biHomeSwitch :=arrAxisCtrlV2[P3AxisNo.P3_M2_OvenCarrying].Io.DigitalInputs.2;

arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Io.DigitalInputs;//烤箱上料夹进退电机
arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Io.biPosLimit := arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Io.DigitalInputs.16;
//arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Io.biNegLimit :=  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Io.DigitalInputs.17;
arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Io.biHomeSwitch := arrAxisCtrlV2[P3AxisNo.P3_M2_OvenRetracting].Io.DigitalInputs.17;

arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Io.DigitalInputs;//烤箱上料夹升降电机
arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Io.biPosLimit:=  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Io.DigitalInputs.16;
arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Io.biNegLimit:=  arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Io.DigitalInputs.17;
arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Io.biHomeSwitch:= arrAxisCtrlV2[P3AxisNo.P3_M2_OvenUpDown].Io.DigitalInputs.2;

arrAxisCtrl[P3AxisNo.P3_M3_HotPressingActuated].Io.DigitalInputs;//热压驱动电机
