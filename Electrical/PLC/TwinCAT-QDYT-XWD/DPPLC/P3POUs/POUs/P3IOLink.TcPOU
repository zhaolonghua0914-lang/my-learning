arrAxisCtrl[P3AxisNo.P3M1_ColdpreUpDown].Io.biNegLimit:=  arrAxisCtrl[P3AxisNo.P3M1_ColdpreUpDown].Io.DigitalInputs.17;
arrAxisCtrl[P3AxisNo.P3M1_ColdpreUpDown].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3M1_ColdpreUpDown].Io.DigitalInputs.2;

arrAxisCtrl[P3AxisNo.P3M1_ColdpreSupPlateLine].Io.DigitalInputs;//冷压托板开合电机
