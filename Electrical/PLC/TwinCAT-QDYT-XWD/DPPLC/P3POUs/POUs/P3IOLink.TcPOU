	Torque_P3.TapeAdvanceTorSet:=HMI_TorErrLimt_D[179];//后段贴胶平移报警力矩设定
	
	Torque_P3.ColdpreLineTor:=iActTorque_D[160];//冷呀上料夹平移实时力矩
	Torque_P3.ColdpreRetractTor:=iActTorque_D[161];//冷压上料夹进退实时力矩
	Torque_P3.ColdpreWhirlTor:=iActTorque_D[162];//冷压上料夹旋转实时力矩
	Torque_P3.ColdpreActTor:=iActTorque_D[165];//冷压驱动实时力矩
	Torque_P3.OvenCarryTor:=iActTorque_D[166];//烤箱上料夹搬运实时力矩
	Torque_P3.OvenRetractTor:=iActTorque_D[167];//烤箱上料夹进退实时力矩
	Torque_P3.HotpreActTor:=iActTorque_D[170];//热压驱动实时力矩
	Torque_P3.WeighLineTor:=iActTorque_D[171];//称重上料夹平移实时力矩
	Torque_P3.WeighWhirlTor:=iActTorque_D[173];//称重上料夹旋转实时力矩
	Torque_P3.SortingCarryTor:=iActTorque_D[174];//电芯分选夹搬运实时力矩
	Torque_P3.OffloadCarryTor:=iActTorque_D[176];//电芯下料夹搬运实时力矩
	
	Torque_P3.TapeTranslationTor:=iActTorque_D[178];//后段贴胶头进退实时力矩
	Torque_P3.TapeAdvanceTor:=iActTorque_D[179];//后段贴胶平移实时力矩
	
(*
	HMI_TorAlarm_D[160]:=Torque_P3.ColdpreLineTorAlarm;//冷呀上料夹平移力矩超限报警
	HMI_TorAlarm_D[161]:=Torque_P3.ColdpreRetractTorAlarm;//冷压上料夹进退力矩超限报警
	HMI_TorAlarm_D[162]:=Torque_P3.ColdpreWhirlTorAlarm;//冷压上料夹旋转力矩超限报警
	HMI_TorAlarm_D[165]:=Torque_P3.ColdpreActTorAlarm;//冷压驱动力矩超限报警
	HMI_TorAlarm_D[166]:=Torque_P3.OvenCarryTorAlarm;//烤箱上料夹搬运力矩超限报警
	HMI_TorAlarm_D[167]:=Torque_P3.OvenRetractTorAlarm;//烤箱上料夹进退力矩超限报警
	HMI_TorAlarm_D[170]:=Torque_P3.HotpreActTorAlarm;//热压驱动力矩超限报警
	HMI_TorAlarm_D[171]:=Torque_P3.WeighLineTorAlarm;//称重上料夹平移力矩超限报警
	HMI_TorAlarm_D[173]:=Torque_P3.WeighWhirlTorAlarm;//称重上料夹旋转力矩超限报警
	HMI_TorAlarm_D[174]:=Torque_P3.SortingCarryTorAlarm;//电芯分选夹搬运力矩超限报警
	HMI_TorAlarm_D[176]:=Torque_P3.OffloadCarryTorAlarm;//电芯下料夹搬运力矩超限报警
*)	
	
	HMI_TorAlarm_D[178]:=Torque_P3.TapeTranslationTorSetAlarm;//后段贴胶头进退力矩超限报警
	HMI_TorAlarm_D[179]:=Torque_P3.TapeAdvanceTorSetAlarm;//后段贴胶平移力矩超限报警]]></ST>
