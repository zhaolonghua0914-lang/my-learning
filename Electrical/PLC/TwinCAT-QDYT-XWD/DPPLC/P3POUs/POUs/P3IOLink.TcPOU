      </Implementation>
    </Action>
    <Action Name="P3_OutPut" Id="{cd2fb587-5353-4b25-9a07-184990d21b33}">
      <Implementation>
        <ST><![CDATA[//尾段下料
Q601[1]:=arrCyCtrl[P3CYNo.P3ColdPressTensed].Io.DOStatus2	;//	冷压麦拉张紧气缸伸出
Q601[2]:=arrCyCtrl[P3CYNo.P3ColdPressTensed].Io.DOStatus1	;//	冷压麦拉张紧气缸缩回
