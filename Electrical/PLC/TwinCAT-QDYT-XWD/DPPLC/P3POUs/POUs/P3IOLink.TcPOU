    <Action Name="P3_AI" Id="{7a383c27-e243-48c9-82cf-973cc7c4c2aa}">
      <Implementation>
        <ST><![CDATA[//尾段下料

arrFilter_AD[28].AD	:=AI60[0];  //冷压压力检测
arrFilter_AD[29].AD	:=AI60[1];  //热压压力检测

//转换
FOR  I1:=28 TO 29   DO
  arrFilter_AD[I1](
	  iMode:=         2, 
	  AD:=					arrFilter_AD[I1].AD               , 
	  iLimitH:=         parFilterAD[I1].iLimitH  , 
	  iLimitL:=          parFilterAD[I1].iLimitL   , 
	  fRangeH:=      parFilterAD[I1].fRangeH , 
	  fRangeL:=       parFilterAD[I1].fRangeL , 
	  fPointNum:=   15 , 
	  Out_Value=>);
END_FOR

//P3Par.P3_AD_Press[1]:=arrFilter_AD[28].Out_Value;
//P3Par.P3_AD_Press[2]:=arrFilter_AD[29].Out_Value;]]></ST>
      </Implementation>
    </Action>
