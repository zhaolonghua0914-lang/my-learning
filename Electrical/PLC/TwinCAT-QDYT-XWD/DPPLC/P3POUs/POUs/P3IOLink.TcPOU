P3Senser.P3_Securitydoorswitch9:=I609[9]	;//外罩门禁9	
P3Senser.P3_Securitydoorswitch10:=I609[10]  ;//外罩门禁10	
P3Senser.P3_Securitydoorswitch11:=I609[11]  ;//外罩门禁11	
P3Senser.P3_Securitydoorswitch12:=I609[12]  ;//外罩门禁12	
P3Press.Gluebtn:=I609[13]  ;//拉胶按钮
