//力矩
	Torque_P3.ColdpreLineTorSet:=HMI_TorErrLimt_D[160];//冷呀上料夹平移报警力矩设定
	Torque_P3.ColdpreRetractTorSet:=HMI_TorErrLimt_D[161];//冷压上料夹进退报警力矩设定
