    <Action Name="P3_LimitSwitch" Id="{8eef36a3-2974-4c7a-ac0e-f90572f6e7b3}">
      <Implementation>
        <ST><![CDATA[//尾段下料

arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Io.DigitalInputs;//冷压上料夹平移电机
