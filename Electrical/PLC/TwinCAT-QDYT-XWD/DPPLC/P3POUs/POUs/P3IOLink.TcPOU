arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Io.biNegLimit:=  arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Io.DigitalInputs.7;
arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3_M3_HotPressingLine].Io.DigitalInputs.7;

arrAxisCtrl[P3AxisNo.P3_M4_OffloadingCarrying].Io.DigitalInputs;//电芯下料夹搬运电机
arrAxisCtrl[P3AxisNo.P3_M4_OffloadingCarrying].Io.biPosLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_OffloadingCarrying].Io.DigitalInputs.16;
arrAxisCtrl[P3AxisNo.P3_M4_OffloadingCarrying].Io.biNegLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_OffloadingCarrying].Io.DigitalInputs.17;
arrAxisCtrl[P3AxisNo.P3_M4_OffloadingCarrying].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3_M4_OffloadingCarrying].Io.DigitalInputs.17;

arrAxisCtrl[P3AxisNo.P3_M4_OffloadingUpDown].Io.DigitalInputs;//电芯下料夹升降电机
arrAxisCtrl[P3AxisNo.P3_M4_OffloadingUpDown].Io.biPosLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_OffloadingUpDown].Io.DigitalInputs.16;
arrAxisCtrl[P3AxisNo.P3_M4_OffloadingUpDown].Io.biNegLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_OffloadingUpDown].Io.DigitalInputs.17;
arrAxisCtrl[P3AxisNo.P3_M4_OffloadingUpDown].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3_M4_OffloadingUpDown].Io.DigitalInputs.2;

arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Io.DigitalInputs;//电芯分选夹搬运电机
arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Io.biPosLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Io.DigitalInputs.16;
arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Io.biNegLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Io.DigitalInputs.17;
arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3_M4_SortingoutCarrying].Io.DigitalInputs.17;

arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Io.DigitalInputs;//电芯分选夹升降电机
arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Io.biPosLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Io.DigitalInputs.16;
arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Io.biNegLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Io.DigitalInputs.17;
arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3_M4_SortingoutUpDown].Io.DigitalInputs.2;

arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Io.DigitalInputs;//称重上料夹平移电机
arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Io.biPosLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Io.DigitalInputs.16;
arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Io.biNegLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Io.DigitalInputs.17;
arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3_M4_WeighLine].Io.DigitalInputs.17;

arrAxisCtrl[P3AxisNo.P3_M4_WeighUpDown].Io.DigitalInputs;//称重上料夹升降电机
arrAxisCtrl[P3AxisNo.P3_M4_WeighUpDown].Io.biPosLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_WeighUpDown].Io.DigitalInputs.16;
arrAxisCtrl[P3AxisNo.P3_M4_WeighUpDown].Io.biNegLimit:=  arrAxisCtrl[P3AxisNo.P3_M4_WeighUpDown].Io.DigitalInputs.17;
arrAxisCtrl[P3AxisNo.P3_M4_WeighUpDown].Io.biHomeSwitch:=arrAxisCtrl[P3AxisNo.P3_M4_WeighUpDown].Io.DigitalInputs.2;

arrAxisCtrl[P3AxisNo.P3_M4_WeighWhirling].Io.DigitalInputs;//称重上料夹旋转电机
