    <Action Name="Act01_Status" Id="{e100397f-6dec-4b98-b5b1-732964c54967}">
      <Implementation>
        <ST><![CDATA[Axis.ReadStatus();

;

IF Axis.Status.Error  THEN
	Error := TRUE;
	ErrorMessage := 'Axis Error';
	ErrorID := Axis.Status.ErrorID;
ELSIF Axis.NcToPlc.ActPos > MaxPressPosition THEN
	Error := TRUE;
	ErrorMessage := 'Axis Position lager then max position';
	ErrorID := 10;
ELSIF Option.Velocity <=0 THEN
	Error := TRUE;
	ErrorMessage := 'Axis absoulte motion Velo set error in option params';
	ErrorID := 11;
ELSIF Option.FastReachVelo <=0 THEN
	Error := TRUE;
	ErrorMessage := 'Axis fast Reach motion Velo set error in option params';
	ErrorID := 12;
ELSIF Option.BufferVelo <=0 THEN
	Error := TRUE;
	ErrorMessage := 'Axis buffer motion Velo set error in option params';
	ErrorID := 13;
ELSIF Actual_Torque  > (DeadZone_Max + 300) AND (eWorkStep =100 OR eWorkStep = 200) THEN
	Error := TRUE;
	ErrorMessage := 'Axis StartPressPosition lager then max Torque';
	ErrorID := 14;
END_IF

CASE eErrorStep OF
0:
	IF Error THEN	
		eErrorStep := 100;
	END_IF
	
100:
	mcStop.Execute := TRUE;
	IF Axis.Status.NotMoving THEN
		mcStop.Execute := FALSE;
		eErrorStep := 200;
	END_IF
	
200:
	mcStop.Execute := FALSE;
	IF NOT Error THEN;
		eErrorStep := 0;
	END_IF
END_CASE ]]></ST>
      </Implementation>
    </Action>
    <Action Name="Act02_ToqueMove" Id="{c200ca68-1c5c-47f1-9598-38761ee43aef}">
      <Implementation>
        <ST><![CDATA[(*IF EnablePID=TRUE THEN
	ErrorTorque:=Target_Torque-Actual_Torque;;
	IF Actual_Torque< Target_Torque*0.01 THEN	(*快速下降区*)
		fPIDVelocity:=Option.FastReachVelo;
	ELSIF Actual_Torque>=Target_Torque*0.02 AND ErrorTorque>Target_Torque*0.02 THEN	(*缓冲区*)
		fPIDVelocity:=Option.BufferVelo;						(*系数需要调节*)
	ELSIF ErrorTorque>DeadZone THEN				(*精确调整区*)
		fPIDVelocity:=ErrorTorque*0.00001;		(*系数需要调节*)
	ELSIF ABS(ErrorTorque)<=DeadZone THEN		(*死区*)
		fPIDVelocity:=0;
	ELSIF ErrorTorque<-DeadZone THEN			(*过冲回调区*)
		fPIDVelocity:=ErrorTorque*0.002;		(*系数需要调节*)
	END_IF
ELSE
	fPIDVelocity:=0;
END_IF
*)

IF EnablePID=TRUE THEN
	ErrorTorque:=Target_Torque-Actual_Torque;;
	IF Actual_Torque< Target_Torque*0.005 THEN	(*快速下降区*)
		fPIDVelocity:=Option.FastReachVelo;
	ELSIF Actual_Torque>=Target_Torque*0.03*Press_Fast_xs AND ErrorTorque>Press_Slow_xs*Target_Torque*0.03 THEN	(*缓冲区*)
		fPIDVelocity:=Option.BufferVelo;						(*系数需要调节*)
	ELSIF ErrorTorque>DeadZone THEN				(*精确调整区*)
		fPIDVelocity:=ErrorTorque*0.0001;		(*系数需要调节*)
	ELSIF ABS(ErrorTorque)<=DeadZone THEN		(*死区*)
		fPIDVelocity:=0;
	ELSIF ErrorTorque<-DeadZone THEN			(*过冲回调区*)
		fPIDVelocity:=ErrorTorque*0.0005;		(*系数需要调节*)
	END_IF
ELSE
	fPIDVelocity:=0;
END_IF


CASE eTorqueStep OF
0:
	IF EnablePID THEN
		eTorqueStep := 1000;
	END_IF
	
(*实际压力与设定压力比较*)	
1000:
	mcStop.Execute := FALSE;
	IF 		fPIDVelocity > 0 THEN MoveVel.Execute := FALSE; eTorqueStep := 1200;
	ELSIF 	fPIDVelocity = 0 THEN MoveVel.Execute := FALSE; eTorqueStep := 1300;
	ELSIF 	fPIDVelocity < 0 THEN MoveVel.Execute := FALSE; eTorqueStep := 1400;
	END_IF

(*下压*)	
1200:
	MoveVel.Direction:=MC_Positive_Direction;
	MoveVel.BufferMode:=MC_BlendingNext;
	MoveVel.Velocity :=ABS(fPIDVelocity) ;
	MoveVel.Execute := TRUE;
	eTorqueStep := 1000;
	
(*停止*)	
1300:
	mcStop.Execute := TRUE;
	IF Axis.Status.NotMoving THEN
		mcStop.Execute := FALSE;
		eTorqueStep := 1000;
	END_IF 
	
(*上抬*)	
1400:
	MoveVel.Direction:=MC_Negative_Direction;
	MoveVel.BufferMode:=MC_BlendingNext;
	MoveVel.Velocity :=ABS(fPIDVelocity) ;
	MoveVel.Execute := TRUE;
	eTorqueStep := 1000;	
END_CASE


]]></ST>
      </Implementation>
    </Action>
    <Action Name="Act10_Auto" Id="{5299c1af-1f65-49d8-9d24-f861871fd3bd}">
      <Implementation>
        <ST><![CDATA[error_ton(PT:=T#30S);
Stop_ton(PT:=T#100MS);
Axis1_TON(PT:=T#20S);

	IF eWorkStep = 1250  THEN
	IF NOT Axis1_TON.Q THEN
		Axis1_TON.IN:=TRUE;
	ELSE
		Error:=TRUE;
	END_IF
ELSE
	    Axis1_TON.IN:=FALSE;
END_IF



//触发条件
rtStart(CLK:=Start_Torque , Q=> );
CASE eWorkStep OF
0:
	CurrentPressTime := T#0MS;
	Pressing := FALSE;	
	Busy := FALSE;
	MoveAbs.Execute := FALSE;
	Stop_ton.IN:=FALSE;
	tOutTime(IN:=FALSE);
	IF 	rtStart.Q THEN
		Busy := TRUE;
		Done:= FALSE;
	    HoldOK := FALSE;
		mcStop.Execute := FALSE;
		Start_Torque:=FALSE;
		eWorkStep := 20;
	END_IF

20://下压安全条件
	IF Press_condition AND NOT Error1 AND Axis.Status.ControlLoopClosed  THEN
		eWorkStep := 100;
		ELSE
		eWorkStep := 0;
		Error1:=TRUE;
	END_IF


	
(*运动到预压初始位置*)	
100:
	MoveAbs.Position := StartPressPosition ;
	MoveAbs.Velocity := Option.Velocity;
	MoveAbs.Acceleration := Option.Acc;
	MoveAbs.Deceleration := Option.Dec;
	MoveAbs.Jerk := Option.Jerk;
	MoveAbs(Execute:= TRUE ,Axis:= Axis);
	IF 	Axis.Status.NotMoving AND ABS(Axis.NcToPlc.ActPos-StartPressPosition)<0.01 THEN
		MoveAbs(Execute:= FALSE ,Axis:= Axis);
		eWorkStep := 200;
	END_IF

(*判读是否达到设定压力的范围*)	
200:	
	EnablePID := TRUE;
	error_ton.IN:=EnablePID;
	tOutTime(IN:= TRUE, PT:=T#40S , Q=> , ET=> );
	IF Actual_Torque >= DeadZone_Min AND Actual_Torque <= DeadZone_Max THEN
		eWorkStep := 1000;
		error_ton.IN:=FALSE;
	ELSIF tOutTime.Q OR Axis.Status.SoftLimitMaxExceeded THEN
		Pressing := FALSE;
		eTorqueStep := 0;
		EnablePID := FALSE;
		MoveVel.Execute := FALSE;
		mcStop.Execute := FALSE;
		HoldOK := TRUE;
		Error := TRUE;
		tonHoldPress.IN := FALSE;
		tOutTime(IN:=FALSE);
		eWorkStep := 1200;
	END_IF
	
(*保压中*)
1000:
	error_ton.IN:=FALSE;
	Pressing := TRUE;
 	tonHoldPress.IN := TRUE;
	CurrentPressTime := tonHoldPress.ET;
	IF tonHoldPress.Q THEN
		CurrentPressTime:= tonHoldPress.PT;
		Pressing := FALSE;
		eTorqueStep := 0;
		EnablePID := FALSE;
		MoveVel.Execute := FALSE;
		mcStop.Execute := FALSE;
		tonHoldPress.IN := FALSE;
		HoldOK := TRUE;
		eWorkStep := 1200;
	ELSIF Axis.Status.SoftLimitMaxExceeded THEN
		Pressing := FALSE;
		eTorqueStep := 0;
		EnablePID := FALSE;
		MoveVel.Execute := FALSE;
		mcStop.Execute := FALSE;
		HoldOK := TRUE;
		Error := TRUE;
		tonHoldPress.IN := FALSE;
		eWorkStep := 1200;
	END_IF

1100:
	MoveAbs.Execute:=FALSE;
	mcStop.Execute := TRUE;
	IF mcStop.Done THEN
		mcStop.Execute := FALSE;
		eWorkStep := 1150;
	END_IF
	
1150:
	IF //AxisArr[1].Status.NotMoving 
        Axis.Status.NotMoving   THEN
		mcStop.Execute := FALSE;
		eWorkStep := 1200;
	END_IF
	
(*升降电机返回初始位置*)	

1200:
	mcStop.Execute := TRUE;
	EnablePID:=FALSE;
	eTorqueStep := 0;
	Stop_ton.IN:=TRUE;
	IF Stop_ton.Q THEN
		eWorkStep := 1250;
	END_IF

1250:
	mcStop.Execute := FALSE;
	MoveAbs.Position := InitPosition ;
	MoveAbs.Velocity := Option.Velocity; 
	MoveAbs.Acceleration := Option.Acc;
	MoveAbs.Deceleration := Option.Dec;
	MoveAbs.Jerk := Option.Jerk;
	MoveAbs.BufferMode := MC_Aborting;
	MoveAbs.Execute := TRUE;
	BlowPermit:=TRUE;//吹气允许
	Stop_ton.IN:=FALSE;
	IF 	Axis.Status.NotMoving AND ABS(Axis.NcToPlc.ActPos-InitPosition)<0.01 THEN
		BlowPermit:=FALSE;//吹气允许
		MoveAbs.Execute := FALSE;
		eWorkStep := 1300;
	END_IF
	
1300:
	Done:= TRUE;
	Busy := FALSE;
	IF NOT Start_Torque THEN
		eWorkStep := 0;
	END_IF	 
END_CASE



]]></ST>
      </Implementation>
    </Action>
