<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_CSP_Velo_Torque" Id="{7f89ab80-7fba-4c81-818b-e1bce7a04e6a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CSP_Velo_Torque

VAR_IN_OUT
	Start_Torque			:BOOL	;//控制命令
	Axis : Axis_Ref;
	
END_VAR

VAR_INPUT
	
	Reset					:BOOL	;//复位
	Target_Torque			:REAL	;//设定压力
	Actual_Torque			:REAL	;//实际压力-从压力传感器获取
	DeadZone				:REAL	;//死区范围
	Hold_Time				:TIME	;//保压时间
	InitPosition			:REAL	;//初始位置
	StartPressPosition		:REAL	;//预压起始位置
	MaxPressPosition		:REAL	;//最大下压位置
	Press_Fast_xs:REAL;    //快速系数
	Press_Slow_xs:REAL;   //慢速系数
	Press_condition :BOOL;
	Option : ST_TorqueMotion ;	
END_VAR

VAR_OUTPUT
	Done				: BOOL		;//完成
	Busy				: BOOL		;//执行中
	Pressing			: BOOL		;//压合中
	CurrentPressTime 	: TIME;		;//实时压合时间
	HoldOK				: BOOL		;//保压中
	Error				: BOOL		;//热压超时报警
	ErrorID				: UDINT		;//报警ID
	ErrorMessage		: STRING	;//报警消息
	Error1				: BOOL		;//安全条件不满足不在报警
	BlowPermit			:BOOL;//吹气允许
END_VAR


VAR 	
	eWorkStep: INT;
	rtStart: R_trig;
	
	MoveAbs : MC_MoveAbsolute ;
	MoveVel : MC_MoveVelocity ;
	mcStop : MC_Halt;
	fPIDVelocity: LREAL;
	eTorqueStep: INT;
	bStart: BOOL;
	DeadZone_Min: REAL;
	DeadZone_Max: REAL;
	tonHoldPress: Ton;
	ErrorTorque: REAL;
	EnablePID: BOOL;
	eErrorStep: INT;
	error_ton :Tc2_Standard.TON;
	Stop_ton :Tc2_Standard.TON;
    Axis1_TON :Tc2_Standard.TON;
	tOutTime:TON;//超时
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Act01_Status();

//死区范围
DeadZone_Min := Target_Torque - DeadZone ;
DeadZone_Max := Target_Torque + DeadZone ;

//保压计时
tonHoldPress(IN:= , PT:=Hold_Time, Q=> , ET=> );

IF  Error AND Reset AND eWorkStep<>0  AND ABS(Axis.NcToPlc.ActPos-InitPosition)<0.01THEN
	eWorkStep := 0;
	eTorqueStep := 0;
	EnablePID := FALSE;
	MoveVel.Execute := FALSE;
	tonHoldPress.IN := FALSE;
	HoldOK := FALSE;
	Busy := FALSE;
	Pressing := FALSE;
ELSE
	ErrorMessage := '';
	ErrorID := 0;
	


END_IF

IF Reset THEN
	Error  := FALSE;
	Error1 := FALSE;
	ErrorMessage := '';
	ErrorID := 0;
END_IF

Act02_ToqueMove();
Act10_Auto();
Act00_CallFB();





]]></ST>
    </Implementation>
