			IF P2M3_DTSysState.FlgManua AND P2Btn.P2M3_EmStopbtn1 THEN//三号叠台
				P2M3_Step0:=300;
			END_IF  
  			IF P2M3_WJSysState.FlgManua AND P2Btn.P2M3_EmStopbtn1 THEN//三号尾卷
				P2M3_Step1:=300;
				P2M3_Step2:=300;
			END_IF  

			(*
 (************************急停********************************) 
400://Stoping
   stSysState.iMode:=4;
    P2M1_EStop();  
   iMainSetp:=450;  
      
450: //急停跳出 
	IF  NOT  stSysState.btnEstop   THEN  
        tonEStop(IN:=FALSE , PT:=T#50MS );
	    iMainSetp:=0;
    ELSE
         tonEStop(IN:=TRUE , PT:=T#50MS );
         IF  tonEStop.Q THEN
              tonEStop(IN:=FALSE , PT:=T#50MS );
              iMainSetp:=400;   
         END_IF
   	 END_IF
*)
END_CASE

(**************************************************************************************一号叠台******************************************************************************)
CASE  P2M1_Step0 OF
		300://手动状态
				P2M1_MachCtrl.U.DT_iMode:=3;//手动状态
				P2M1_Step0:=310;
		310://等待切换到自动启动  
				IF  P2M1_DTSysState.FlgAuto AND P2M1_MachCtrl.DT_b.ALLIniti_Done AND NOT P2M1_DTSysState.bErrorStop 
					AND  P2M1_MachCtrl.DT_b.DiaphragmPartNumberOK (*AND P2M1_MachCtrl.DT_b.BluePartNumberOK  *)THEN//在自动下、在轴回原点完成、没有报警
							IF P2M1DT_R_TRIG[0].Q THEN
								P2M1_DTSysState.bwindow:=TRUE;//触发弹窗
								P2M1_Step0:=315;
							END_IF
				END_IF
				
		315:
				IF  P2M1_DTSysState.FlgAuto AND P2M1_MachCtrl.DT_b.ALLIniti_Done AND NOT P2M1_DTSysState.bErrorStop 
					AND  P2M1_MachCtrl.DT_b.DiaphragmPartNumberOK AND P2M1_DTSysState.bccdstate  THEN//在自动下、在轴回原点完成、没有报警
							IF P2M1DT_R_TRIG[0].Q AND NOT P2M1_DTSysState.bwindow  THEN
								P2M1_MachCtrl.U.DT_iMode:=1;//自动状态
								P2M1_Step0:=320;
							END_IF
							
				ELSIF P2M1_DTSysState.FlgManua OR P2M1_DTSysState.bErrorStop OR NOT P2M1_DTSysState.bccdstate  THEN//
					P2M1_DTSysState.hmiAuto:=FALSE;
					P2M1_Step0:=300;		
				END_IF		    
				
				
		320://判断是否切换到手动、是否有报警，则切换到手动
				IF P2M1_DTSysState.FlgManua OR P2M1_DTSysState.bErrorStop OR P2Btn.P2M1_Stopbtn  THEN//
					P2M1_DTSysState.hmiAuto:=FALSE;
					P2M1_Step0:=300;
				END_IF
 (************************急停********************************) 
		400://Stoping
		   P2M1_MachCtrl.U.DT_iMode:=4;
			P2M1_EStop();  
		   P2M1_Step0:=450;  
			  
		450: //急停跳出 
			IF  NOT  P2Btn.P2M1_EmStopbtn1   THEN  
				P2M1_tonEStop1(IN:=FALSE , PT:=T#50MS );
				P2M1_Step0:=300;
			ELSE
				 P2M1_tonEStop1(IN:=TRUE , PT:=T#50MS );
				 IF  P2M1_tonEStop1.Q THEN
					  P2M1_tonEStop1(IN:=FALSE , PT:=T#50MS );
					  P2M1_Step0:=400;   
				 END_IF
			 END_IF						
				
				
				
END_CASE
