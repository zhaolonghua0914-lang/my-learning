    <Action Name="Condition" Id="{e2926472-23c9-4b17-ae43-484d70996bfe}">
      <Implementation>
        <ST><![CDATA[FOR i:=1 TO 185 DO 
   IF  i<>14 AND i<>60 AND i<>106 THEN	
			IF arrAxisCtrl[i].Io.biNegLimit=TRUE THEN
				arrAxisCtrl[i].Cmd.JogN_Condition:=FALSE;
				ELSE
				arrAxisCtrl[i].Cmd.JogN_Condition:=TRUE;
			END_IF
			IF arrAxisCtrl[i].Io.biPosLimit=TRUE   THEN
				arrAxisCtrl[i].Cmd.JogP_Condition:=FALSE;
				ELSE
				arrAxisCtrl[i].Cmd.JogP_Condition:=TRUE;
			END_IF
	END_IF
END_FOR

YL_Q[20]:=arrAxisCtrl[2].Cmd.arrbRealPoint[4];//叠台一正极送片流水线安全点动条件
YL_Q[21]:=arrAxisCtrl[10].Cmd.arrbRealPoint[1];//叠台一负极送片流水线安全点动条件 
YL_Q[22]:=arrAxisCtrl[48].Cmd.arrbRealPoint[4];//叠台二正极送片流水线安全点动条件 
YL_Q[23]:=arrAxisCtrl[56].Cmd.arrbRealPoint[1];//叠台二负极送片流水线安全点动条件 
YL_Q[24]:=arrAxisCtrl[94].Cmd.arrbRealPoint[4];//叠台三正极送片流水线安全点动条件 
YL_Q[25]:=arrAxisCtrl[102].Cmd.arrbRealPoint[1];//叠台三负极送片流水线安全点动条件
//增加相应的自动启动条件











]]></ST>
      </Implementation>
    </Action>
    <Action Name="CyBasic" Id="{77ceec0a-c831-4bb8-9be6-4c7cf4119d92}">
      <Implementation>
        <ST><![CDATA[


//叠台1
FOR i11[1]:=1 TO 10 DO//
    fbCy[i11[1]](bReset:=stSysState.bReset ,AutoRun:=P2M1_MachCtrl.U.DT_iMode=1, stCyCtrl:=arrCyCtrl[i11[1]] );
END_FOR
   fbCy[89](bReset:=stSysState.bReset ,AutoRun:=P2M1_MachCtrl.U.WJ_iMode=1, stCyCtrl:=arrCyCtrl[89] );

FOR i11[2]:=11 TO 28 DO//
    fbCy[i11[2]](bReset:=stSysState.bReset ,AutoRun:=P2M1_MachCtrl.U.WJ_iMode=1, stCyCtrl:=arrCyCtrl[i11[2]] );
END_FOR
 
//叠台2  
FOR i11[3]:=29 TO 38 DO//
    fbCy[i11[3]](bReset:=stSysState.bReset ,AutoRun:=P2M2_MachCtrl.U.DT_iMode=1, stCyCtrl:=arrCyCtrl[i11[3]] );
END_FOR
FOR i11[4]:=39 TO 56 DO//
    fbCy[i11[4]](bReset:=stSysState.bReset ,AutoRun:=P2M2_MachCtrl.U.WJ_iMode=1, stCyCtrl:=arrCyCtrl[i11[4]] );
END_FOR
 fbCy[90](bReset:=stSysState.bReset ,AutoRun:=P2M2_MachCtrl.U.WJ_iMode=1, stCyCtrl:=arrCyCtrl[90] ); 
 
//叠台3
FOR i11[5]:=57 TO 66 DO//
    fbCy[i11[5]](bReset:=stSysState.bReset ,AutoRun:=P2M3_MachCtrl.U.DT_iMode=1, stCyCtrl:=arrCyCtrl[i11[5]] );
END_FOR
FOR i11[6]:=67 TO 88 DO//
    fbCy[i11[6]](bReset:=stSysState.bReset ,AutoRun:=P2M3_MachCtrl.U.WJ_iMode=1, stCyCtrl:=arrCyCtrl[i11[6]] );
END_FOR
fbCy[91](bReset:=stSysState.bReset ,AutoRun:=P2M3_MachCtrl.U.WJ_iMode=1, stCyCtrl:=arrCyCtrl[91] ); 
  

FOR i11[7]:=92 TO 229 DO//
    fbCy[i11[7]](bReset:=stSysState.bReset ,AutoRun:=, stCyCtrl:=arrCyCtrl[i11[7]] );
END_FOR
(*
//气缸控制   刷新周期可以慢
FOR i:=1 TO MaxP2Cy DO//
    fbCy[i](bReset:=stSysState.bReset , stCyCtrl:=arrCyCtrl[i] );
END_FOR
*)









































]]></ST>
      </Implementation>
    </Action>
    <Action Name="DPDispatch" Id="{1812855a-1a39-4ba9-a18f-2f004c925cd7}">
      <Implementation>
        <ST><![CDATA[//20240504 CF
fMinTime:=MIN(P2M1_Par.stDT_date.SinglePosTime,P2M2_Par.stDT_date.SinglePosTime,P2M3_Par.stDT_date.SinglePosTime);

bDiffVel[1]:=P2M1_Par.stDT_date.SinglePosTime>fMinTime OR arrAxisCtrl[P2M1_Axise.VirAxisName.VirMain].Cmd.fOverride<100;//叠台1叠片速度不同标志位
bDiffVel[2]:=P2M2_Par.stDT_date.SinglePosTime>fMinTime OR arrAxisCtrl[P2M2_Axise.VirAxisName.VirMain].Cmd.fOverride<100;//叠台2叠片速度不同标志位
bDiffVel[3]:=P2M3_Par.stDT_date.SinglePosTime>fMinTime OR arrAxisCtrl[P2M3_Axise.VirAxisName.VirMain].Cmd.fOverride<100;//叠台3叠片速度不同标志位

IF iSyncStep=0 THEN
	IF P2User1_Par.bSyncMode=1 THEN
		iSyncStep:=100;
	ELSE
		P2M1_MachCtrl.DTRunStatus.bSyncStart:=TRUE;
		P2M2_MachCtrl.DTRunStatus.bSyncStart:=TRUE;
		P2M3_MachCtrl.DTRunStatus.bSyncStart:=TRUE;
	END_IF
END_IF

IF iSyncStep=100 THEN//复位启动信号
	P2M1_MachCtrl.DTRunStatus.bSyncStart:=FALSE;
	P2M2_MachCtrl.DTRunStatus.bSyncStart:=FALSE;
	P2M3_MachCtrl.DTRunStatus.bSyncStart:=FALSE;
	iSyncStep:=200;
END_IF
		
IF iSyncStep=200 THEN//判断是否同步准备好或者放弃同步
	IF (P2M1_MachCtrl.DTRunStatus.bSyncReady OR P2M1_MachCtrl.DTRunStatus.bJumpSync) 
			AND  (P2M2_MachCtrl.DTRunStatus.bSyncReady OR P2M2_MachCtrl.DTRunStatus.bJumpSync)
			AND  (P2M3_MachCtrl.DTRunStatus.bSyncReady OR P2M3_MachCtrl.DTRunStatus.bJumpSync) THEN
			iSyncStep:=300;
	END_IF
END_IF
	
IF iSyncStep=300 THEN//开始同步启动
	P2M1_MachCtrl.DTRunStatus.bSyncStart S=P2M1_MachCtrl.DTRunStatus.bSyncReady;
	P2M2_MachCtrl.DTRunStatus.bSyncStart S=P2M2_MachCtrl.DTRunStatus.bSyncReady;
	P2M3_MachCtrl.DTRunStatus.bSyncStart S=P2M3_MachCtrl.DTRunStatus.bSyncReady;
	iSyncStep:=400;
END_IF

IF iSyncStep=400 THEN//启动完成
	IF 	NOT P2M1_MachCtrl.DTRunStatus.bSyncStart AND NOT P2M2_MachCtrl.DTRunStatus.bSyncStart
		AND NOT P2M3_MachCtrl.DTRunStatus.bSyncStart THEN
		iSyncStep:=200;
	END_IF
END_IF





P2M1_MachCtrl.DTRunStatus.ReadyAllow2;//模切给叠台1正极允许取料信号-------调度用
(*
(**********************************************叠片调度程序****************************************************)
P2M1AutoRuning:=P2M1_MachCtrl.DTRunStatus.DT_AutoRuning;//叠台1自动运行中
P2M2AutoRuning:=P2M2_MachCtrl.DTRunStatus.DT_AutoRuning;//叠台2自动运行中
P2M3AutoRuning:=P2M3_MachCtrl.DTRunStatus.DT_AutoRuning;//叠台3自动运行中

P2M1ReadyTemp:=P2M1_MachCtrl.DTRunStatus.DT_ReadyTemp;//叠台1输出取片准备好信号
P2M2ReadyTemp:=P2M2_MachCtrl.DTRunStatus.DT_ReadyTemp;//叠台2输出取片准备好信号
P2M3ReadyTemp:=P2M3_MachCtrl.DTRunStatus.DT_ReadyTemp;//叠台3输出取片准备好信号

P2M1_MachCtrl.DTRunStatus.DT_ReadyAllow:=P2M1ReadyAllow;//模切调度让叠台1容许取片信号
P2M2_MachCtrl.DTRunStatus.DT_ReadyAllow:=P2M2ReadyAllow;//模切调度让叠台2容许取片信号
P2M3_MachCtrl.DTRunStatus.DT_ReadyAllow:=P2M3ReadyAllow;//模切调度让叠台3容许取片信号

P2M1_MachCtrl.DTRunStatus.ReadyAllow2;//模切给叠台1正极允许取料信号-------调度用
//P2M2_MachCtrl.DTRunStatus.ReadyAllow2;//模切给叠台1正极允许取料信号-------调度用
//P2M3_MachCtrl.DTRunStatus.ReadyAllow2;//模切给叠台1正极允许取料信号-------调度用

P2M1_MachCtrl.DT_b.iDTRunStatus;
iDispatchMode;  //调度模式

//
IF P2M1_MachCtrl.An_b.AN_BeltDone THEN//DT1信号复位
	P2M1ReadyAllow:=FALSE;
END_IF
IF P2M2_MachCtrl.An_b.AN_BeltDone THEN//DT2信号复位
	P2M2ReadyAllow:=FALSE;
END_IF
IF P2M3_MachCtrl.An_b.AN_BeltDone THEN//DT3信号复位
	P2M3ReadyAllow:=FALSE;
END_IF





   (*****************************当前叠台运行中状态******************************************)
       IF  P2M1AutoRuning  AND NOT  P2M2AutoRuning   AND NOT  P2M3AutoRuning  THEN 
		   iDPAutoRuningSEL:=1;
       ELSIF  NOT P2M1AutoRuning  AND   P2M2AutoRuning   AND NOT  P2M3AutoRuning  THEN 
		   iDPAutoRuningSEL:=2;
       ELSIF  NOT P2M1AutoRuning  AND NOT  P2M2AutoRuning   AND   P2M3AutoRuning  THEN 
		   iDPAutoRuningSEL:=3;		   
       ELSIF   P2M1AutoRuning  AND   P2M2AutoRuning   AND  NOT  P2M3AutoRuning  THEN 
		   iDPAutoRuningSEL:=12;				   
       ELSIF   P2M1AutoRuning  AND  NOT P2M2AutoRuning   AND    P2M3AutoRuning  THEN 
		   iDPAutoRuningSEL:=13;			   
       ELSIF  NOT P2M1AutoRuning  AND   P2M2AutoRuning   AND    P2M3AutoRuning  THEN 
		   iDPAutoRuningSEL:=23;			   
       ELSIF   P2M1AutoRuning  AND   P2M2AutoRuning   AND    P2M3AutoRuning  THEN 
		   iDPAutoRuningSEL:=123;			  
       ELSIF  NOT  P2M1AutoRuning  AND NOT  P2M2AutoRuning   AND  NOT  P2M3AutoRuning  THEN 
		   iDPAutoRuningSEL:=0;			   
	END_IF
iDispatchMode:=TRUE;
CASE  iDispatchSetp   OF
0:   
	IF iDispatchMode  THEN  //     空跑模式是不是强制给调度信号
		IF  P2M1_MachCtrl.DTRunStatus.ReadyAllow2  AND NOT P2M1ReadyAllow   AND NOT P2M2ReadyAllow  AND NOT P2M3ReadyAllow   THEN
			iDispatchSetp:=100;   //调度模式
		END_IF     
	ELSE
		iDispatchSetp:=500;  //独立模式
	END_IF

100:
	FOR i:=1 TO 7 DO
		tDecideTim[i].IN :=FALSE;
	END_FOR
       IF iDPAutoRuningSEL=1 THEN
             iDispatchSetp:=110;
	ELSIF  iDPAutoRuningSEL=2 THEN	  
		   iDispatchSetp:=120;
	ELSIF  iDPAutoRuningSEL=3 THEN	  
		   iDispatchSetp:=130;		  
	ELSIF  iDPAutoRuningSEL=12 THEN	  
		   iDispatchSetp:=140;		  
	ELSIF  iDPAutoRuningSEL=13 THEN	  
		   iDispatchSetp:=150;
	ELSIF  iDPAutoRuningSEL=23 THEN	  
		   iDispatchSetp:=160;
	ELSIF  iDPAutoRuningSEL=123 THEN      
		   iDispatchSetp:=170;	  
	ELSIF  iDPAutoRuningSEL=0 THEN	  
		   iDispatchSetp:=0;	  	   
    	END_IF
   
 110:// iDPAutoRuningSEL=1
	IF  P2M1ReadyTemp THEN
		P2M1ReadyAllow:=TRUE;  
		iDispatchSetp:=111;
	ELSIF   iDPAutoRuningSEL<>1 THEN
		 iDispatchSetp:=0;
	END_IF
 111:
 	tDecideTim[1](IN:=TRUE , PT:=T#1.5S , Q=> , ET=> );
	IF  NOT  P2M1ReadyAllow  THEN    //如果没有复位怎么办？
		iDispatchSetp:=0;
	ELSIF tDecideTim[1].Q THEN
		IF P2M1ReadyAllow  THEN//超时，当前周期放弃取片//AND P2M1AutoRuning
			P2M1ReadyAllow:=FALSE;
			tDecideTim[1](IN:=FALSE);
			iDispatchSetp:=0;
			//P2M1_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF 
	END_IF

 120:// iDPAutoRuningSEL=2
	IF  P2M2ReadyTemp THEN
		P2M2ReadyAllow:=TRUE;  
		iDispatchSetp:=121;
	ELSIF   iDPAutoRuningSEL<>2 THEN
		iDispatchSetp:=0;
	END_IF
 121:
 	tDecideTim[2](IN:=TRUE , PT:=T#1.5S , Q=> , ET=> );
	IF  NOT  P2M2ReadyAllow  THEN    //如果没有复位怎么办？
		iDispatchSetp:=0;
	ELSIF tDecideTim[2].Q THEN
		IF P2M2ReadyAllow  THEN//AND P2M2AutoRuning
			tDecideTim[2](IN:=FALSE);
			iDispatchSetp:=0;
			//P2M2_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF 
	END_IF

	
 130:// iDPAutoRuningSEL=3
	IF  P2M3ReadyTemp THEN
		P2M3ReadyAllow:=TRUE;  
		iDispatchSetp:=131;
	ELSIF   iDPAutoRuningSEL<>3 THEN
		iDispatchSetp:=0;
	END_IF
 131:
 	tDecideTim[3](IN:=TRUE , PT:=T#1.5S , Q=> , ET=> );
	IF  NOT  P2M3ReadyAllow  THEN    //如果没有复位怎么办？
		iDispatchSetp:=0;
	ELSIF tDecideTim[3].Q THEN
		IF P2M3ReadyAllow  THEN//AND P2M3AutoRuning
			//P2M3_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
			tDecideTim[3](IN:=FALSE);
			iDispatchSetp:=0;	
		END_IF 
	END_IF	
	
	
 140:// iDPAutoRuningSEL=12
	IF  P2M1ReadyTemp  AND  P2M2ReadyTemp   THEN
		P2M1ReadyAllow:=TRUE;  
		P2M2ReadyAllow:=TRUE;  
		iDispatchSetp:=141;
	ELSIF   iDPAutoRuningSEL<>12 THEN
		iDispatchSetp:=0;
	END_IF 
 141:
 	tDecideTim[4](IN:=TRUE  , PT:=T#1.5S , Q=> , ET=> );
	IF  NOT  P2M1ReadyAllow   AND  NOT  P2M2ReadyAllow   THEN    //如果没有复位怎么办？
		iDispatchSetp:=0;
	ELSIF tDecideTim[4].Q THEN
		IF P2M1ReadyAllow  THEN
			P2M1ReadyAllow:=FALSE;
			//P2M1_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF
		IF P2M2ReadyAllow THEN
			P2M2ReadyAllow:=FALSE;
			//P2M2_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF
		IF NOT  P2M1ReadyAllow   AND  NOT  P2M2ReadyAllow   THEN    //如果没有复位怎么办？
			tDecideTim[4](IN:=FALSE );
			iDispatchSetp:=0;
		END_IF
	END_IF		
	
 150:// iDPAutoRuningSEL=13
	IF  P2M1ReadyTemp  AND  P2M3ReadyTemp   THEN
		P2M1ReadyAllow:=TRUE;  
		P2M3ReadyAllow:=TRUE;  
		iDispatchSetp:=151;
	ELSIF   iDPAutoRuningSEL<>13 THEN
		iDispatchSetp:=0;
	END_IF
 151:
 	tDecideTim[5](IN:=TRUE , PT:=T#1.5S , Q=> , ET=> );
	IF  NOT  P2M1ReadyAllow   AND  NOT  P2M3ReadyAllow   THEN    //如果没有复位怎么办？
		iDispatchSetp:=0;
	ELSIF tDecideTim[5].Q THEN 
		IF P2M1ReadyAllow  THEN
			P2M1ReadyAllow:=FALSE;
			//P2M1_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF
		IF P2M3ReadyAllow THEN
			P2M3ReadyAllow:=FALSE;
			//P2M3_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF
		IF NOT  P2M1ReadyAllow   AND  NOT  P2M3ReadyAllow   THEN    //如果没有复位怎么办？
			tDecideTim[5](IN:=FALSE );
			iDispatchSetp:=0;
		END_IF
	END_IF			

 160:// iDPAutoRuningSEL=23
	IF  P2M2ReadyTemp  AND  P2M3ReadyTemp   THEN
		P2M2ReadyAllow:=TRUE;  
		P2M3ReadyAllow:=TRUE;  
		iDispatchSetp:=161;
	ELSIF   iDPAutoRuningSEL<>23 THEN
		iDispatchSetp:=0;
	END_IF
 161:
 	tDecideTim[6](IN:=TRUE , PT:=T#1.5S , Q=> , ET=> );
	IF  NOT  P2M2ReadyAllow   AND  NOT  P2M3ReadyAllow   THEN    //如果没有复位怎么办？
		iDispatchSetp:=0;

	ELSIF tDecideTim[6].Q THEN
		IF P2M2ReadyAllow  THEN
			P2M2ReadyAllow:=FALSE;
			//P2M2_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF
		IF P2M3ReadyAllow THEN
			P2M3ReadyAllow:=FALSE;
			//P2M3_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF
		IF NOT  P2M2ReadyAllow   AND  NOT  P2M3ReadyAllow   THEN    //如果没有复位怎么办？
			tDecideTim[6](IN:=FALSE );
			iDispatchSetp:=0;
		END_IF

	END_IF		
	
	
 170:// iDPAutoRuningSEL=123
	IF  P2M1ReadyTemp  AND  P2M2ReadyTemp  AND  P2M3ReadyTemp  THEN
		P2M1ReadyAllow:=TRUE;  
		P2M2ReadyAllow:=TRUE;  
		P2M3ReadyAllow:=TRUE;  
		iDispatchSetp:=171;
	ELSIF   iDPAutoRuningSEL<>123 THEN
		iDispatchSetp:=0;
	END_IF
   
 171:
 	tDecideTim[7](IN:=TRUE , PT:=T#1.5S , Q=> , ET=> );
	IF  NOT  P2M1ReadyAllow   AND  NOT  P2M2ReadyAllow    AND  NOT  P2M3ReadyAllow      THEN    //如果没有复位怎么办？
		iDispatchSetp:=0;
	ELSIF tDecideTim[7].Q THEN
		IF P2M1ReadyAllow  THEN
			P2M1ReadyAllow:=FALSE;
			//P2M1_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF
		IF P2M2ReadyAllow  THEN
			P2M2ReadyAllow:=FALSE;
			//P2M2_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF
		IF P2M3ReadyAllow THEN
			P2M3ReadyAllow:=FALSE;
			//P2M3_MachCtrl.DT_b.Error[63]:=TRUE ;//叠台卡流程
		END_IF
		IF NOT  P2M1ReadyAllow AND NOT  P2M2ReadyAllow   AND  NOT  P2M3ReadyAllow   THEN    //如果没有复位怎么办？
			tDecideTim[7](IN:=FALSE );
			iDispatchSetp:=0;
		END_IF
	END_IF			
	


500:
	P2M1ReadyAllow:=TRUE;
	P2M2ReadyAllow:=TRUE;
	P2M3ReadyAllow:=TRUE;
	iDispatchSetp:=0;
END_CASE
*)
;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Init" Id="{7ac58c4b-5964-4af8-8022-f3c1cbdb1158}">
      <Implementation>
        <ST><![CDATA[
//整机初始化
(**
1.P1INIT  
2.P2INIT
3.P3INIT
4.P4INIT
5.缓存凸轮表创建
6.Time轴跑速度模式
*)

CASE iMainInitSetp OF
0:
    IF  NOT   stSysState.bInitDone THEN
         iMainInitSetp:=10;
    END_IF
10:
    FOR i:=1 TO MaxAxes DO 
		arrAxisCtrl[i].Cmd.bEnable:=TRUE;
		arrAxisCtrl[i].Cmd.bEnableFw:=TRUE;
		arrAxisCtrl[i].Cmd.bEnableBw:=TRUE;
	(*其他操作指令*)  
		arrAxisCtrl[i].Cmd.bHome:=FALSE;
		arrAxisCtrl[i].Cmd.bJog_Bw:=FALSE;
		arrAxisCtrl[i].Cmd.bHalt:=FALSE;
		arrAxisCtrl[i].Cmd.bJog_Fw:=FALSE;
		arrAxisCtrl[i].Cmd.bMoveAbs:=FALSE;
		arrAxisCtrl[i].Cmd.bMoveVelo:=FALSE;
		arrAxisCtrl[i].Cmd.bMoveRel:=FALSE;
		arrAxisCtrl[i].Cmd.bReset:=FALSE;
		arrAxisCtrl[i].Cmd.bStop:=FALSE;
		arrAxisCtrl[i].Cmd.bSetPos:=FALSE;
		IF i=6 OR i=7 OR i=8 OR i=17 OR i=18 OR i=19 OR i=52 OR i=53 OR i=54 OR i=63 OR i=64 OR 
			i=65 OR i=98 OR i=99 OR i=100 OR i=109 OR i=110 OR i=111  THEN
				arrAxisCtrl[i].Cmd.Axis_R:=0.05;
		ELSE
				arrAxisCtrl[i].Cmd.Axis_R:=0.15;
		END_IF
    END_FOR
      //stP4CutCtrl.bServON:=TRUE;  //P4切刀上使能
    K1:=0;
    iMainInitSetp:=20;
20: //复位一次
   bInitReset:=TRUE;
   iMainInitSetp:=30;
30:
   K1:=K1+1;
   IF  K1>=10 THEN
        bInitReset:=FALSE;
        iMainInitSetp:=40;
   ELSE
     iMainInitSetp:=20;
   END_IF

40://P1---P4 Init
  P2M1_MachCtrl.U.P2Init:=TRUE;
   P2M2_MachCtrl.U.P2Init:=TRUE;
  P2M3_MachCtrl.U.P2Init:=TRUE;
   P2M1_MachCtrl.U.P2InitDone:=FALSE;
   P2M2_MachCtrl.U.P2InitDone:=FALSE;
   P2M3_MachCtrl.U.P2InitDone:=FALSE;
   iMainInitSetp:=42;
42:
   IF  P2M1_MachCtrl.U.P2InitDone AND   P2M2_MachCtrl.U.P2InitDone  AND P2M3_MachCtrl.U.P2InitDone   THEN //AND   stSysState.bP2InitDone  AND  stSysState.bP3InitDone AND   stSysState.bP4InitDone 	   
		 P2M1_MachCtrl.U.P2Init:=FALSE;
		 P2M2_MachCtrl.U.P2Init:=FALSE;
   		P2M3_MachCtrl.U.P2Init:=FALSE;
        iMainInitSetp:=50;
    END_IF

50: //复位一次
   bInitReset:=TRUE;
   iMainInitSetp:=54;

54: //Time 轴跑速度
  IF  arrAxis[VirAxisNo.P2M1_VirTimeWind].Status.ControlLoopClosed THEN
	  arrAxisPar[VirAxisNo.P2M1_VirTimeWind].fVelocity_of_Velo:=100;
	  arrAxisCtrl[VirAxisNo.P2M1_VirTimeWind].Cmd.bMoveVelo:=TRUE;
  END_IF
   IF  arrAxis[VirAxisNo.P2M1_VirGM].Status.ControlLoopClosed THEN
	  arrAxisPar[VirAxisNo.P2M1_VirGM].fVelocity_of_Velo:=100;
	  arrAxisCtrl[VirAxisNo.P2M1_VirGM].Cmd.bMoveVelo:=TRUE;
  END_IF
  
    IF  arrAxis[VirAxisNo.P2M2_VirTimeWind].Status.ControlLoopClosed THEN
	  arrAxisPar[VirAxisNo.P2M2_VirTimeWind].fVelocity_of_Velo:=100;
	  arrAxisCtrl[VirAxisNo.P2M2_VirTimeWind].Cmd.bMoveVelo:=TRUE;
	END_IF
	 IF  arrAxis[VirAxisNo.P2M2_VirGM].Status.ControlLoopClosed THEN
	  arrAxisPar[VirAxisNo.P2M2_VirGM].fVelocity_of_Velo:=100;
	  arrAxisCtrl[VirAxisNo.P2M2_VirGM].Cmd.bMoveVelo:=TRUE;
  END_IF
	
	
	IF  arrAxis[VirAxisNo.P2M3_VirTimeWind].Status.ControlLoopClosed THEN
	  arrAxisPar[VirAxisNo.P2M3_VirTimeWind].fVelocity_of_Velo:=100;
	  arrAxisCtrl[VirAxisNo.P2M3_VirTimeWind].Cmd.bMoveVelo:=TRUE;
	END_IF
   IF  arrAxis[VirAxisNo.P2M3_VirGM].Status.ControlLoopClosed THEN
	  arrAxisPar[VirAxisNo.P2M3_VirGM].fVelocity_of_Velo:=100;
	  arrAxisCtrl[VirAxisNo.P2M3_VirGM].Cmd.bMoveVelo:=TRUE;
  END_IF
	
	bInitReset:=FALSE;
	 iMainInitSetp:=55;
55:
   IF arrAxis[VirAxisNo.P2M1_VirTimeWind].Status.ConstantVelocity AND arrAxis[VirAxisNo.P2M2_VirTimeWind].Status.ConstantVelocity AND arrAxis[VirAxisNo.P2M3_VirTimeWind].Status.ConstantVelocity  AND
       arrAxis[VirAxisNo.P2M1_VirGM].Status.ConstantVelocity    AND arrAxis[VirAxisNo.P2M2_VirGM].Status.ConstantVelocity  AND arrAxis[VirAxisNo.P2M3_VirGM].Status.ConstantVelocity   THEN
        stSysState.bInitDone:=TRUE;
        iMainInitSetp:=0;
  END_IF

END_CASE


























]]></ST>
      </Implementation>
    </Action>
    <Action Name="MotionBasic" Id="{fb8630d6-0a10-4874-9e9a-39faae64df62}">
      <Implementation>
        <ST><![CDATA[//伺服电机
//叠台1
FOR i10[1]:=1 TO 30 DO
	arrAxisPar[i10[1]].bLimitSwitchEn:=FALSE;//限位报警
  	csAxis[i10[1]](bReset:=stSysState.bReset ,AutoRun:=P2M1_MachCtrl.U.DT_iMode=1, Axis:=arrAxis[i10[1]] , stAxisCtrl:=arrAxisCtrl[i10[1]] , stAxisPar:=arrAxisPar[i10[1]] ); 
END_FOR
FOR i10[2]:=31 TO 46 DO
	arrAxisPar[i10[2]].bLimitSwitchEn:=FALSE;//限位报警
  	csAxis[i10[2]](bReset:=stSysState.bReset ,AutoRun:=P2M1_MachCtrl.U.WJ_iMode=1, Axis:=arrAxis[i10[2]] , stAxisCtrl:=arrAxisCtrl[i10[2]] , stAxisPar:=arrAxisPar[i10[2]] ); 
END_FOR

//叠台2
FOR i10[3]:=47 TO 76 DO
	arrAxisPar[i10[3]].bLimitSwitchEn:=FALSE;//限位报警
  	csAxis[i10[3]](bReset:=stSysState.bReset ,AutoRun:=P2M2_MachCtrl.U.DT_iMode=1, Axis:=arrAxis[i10[3]] , stAxisCtrl:=arrAxisCtrl[i10[3]] , stAxisPar:=arrAxisPar[i10[3]] ); 
END_FOR
FOR i10[4]:=77 TO 92 DO
	arrAxisPar[i10[4]].bLimitSwitchEn:=FALSE;//限位报警
  	csAxis[i10[4]](bReset:=stSysState.bReset ,AutoRun:=P2M2_MachCtrl.U.WJ_iMode=1, Axis:=arrAxis[i10[4]] , stAxisCtrl:=arrAxisCtrl[i10[4]] , stAxisPar:=arrAxisPar[i10[4]] ); 
END_FOR
//叠台3

FOR i10[5]:=93 TO 122 DO
	arrAxisPar[i10[5]].bLimitSwitchEn:=FALSE;//限位报警
  	csAxis[i10[5]](bReset:=stSysState.bReset ,AutoRun:=P2M3_MachCtrl.U.DT_iMode=1, Axis:=arrAxis[i10[5]] , stAxisCtrl:=arrAxisCtrl[i10[5]] , stAxisPar:=arrAxisPar[i10[5]] ); 
END_FOR
FOR i10[6]:=123TO 138 DO
	arrAxisPar[i10[6]].bLimitSwitchEn:=FALSE;//限位报警
  	csAxis[i10[6]](bReset:=stSysState.bReset ,AutoRun:=P2M3_MachCtrl.U.WJ_iMode=1, Axis:=arrAxis[i10[6]] , stAxisCtrl:=arrAxisCtrl[i10[6]] , stAxisPar:=arrAxisPar[i10[6]] ); 
END_FOR

//虚轴备用
FOR i10[7]:=139 TO 159 DO
	arrAxisPar[i10[7]].bLimitSwitchEn:=FALSE;//限位报警
  	csAxis[i10[7]](bReset:=stSysState.bReset ,AutoRun:=, Axis:=arrAxis[i10[7]] , stAxisCtrl:=arrAxisCtrl[i10[7]] , stAxisPar:=arrAxisPar[i10[7]] ); 
END_FOR

(*FOR i10:=1 TO MaxP2Axes DO
	arrAxisPar[i10].bLimitSwitchEn:=FALSE;//限位报警
  	csAxis[i10](bReset:=stSysState.bReset , Axis:=arrAxis[i10] , stAxisCtrl:=arrAxisCtrl[i10] , stAxisPar:=arrAxisPar[i10] ); 
END_FOR
*)
//一号叠台主轴参数
arrAxisPar[141].fMaxAccDec:=200000;
arrAxisPar[141].fMaxVel:=8000;
arrAxisPar[141].fConVelPercentage:=0.92;
//二号叠台主轴参数
arrAxisPar[145].fMaxAccDec:=200000;
arrAxisPar[145].fMaxVel:=8000;
arrAxisPar[145].fConVelPercentage:=0.92;
//三号叠台主轴参数
arrAxisPar[149].fMaxAccDec:=200000;
arrAxisPar[149].fMaxVel:=8000;
arrAxisPar[149].fConVelPercentage:=0.92;

FOR i:=1 TO Max_Dust DO
  fbDustMotor[i](stSetpMotor:=arrDustMotor[i]);
END_FOR
















]]></ST>
      </Implementation>
    </Action>
    <Action Name="P2M1_EStop" Id="{d8f62bd2-8222-4d9d-8ce8-bb3d89eb5599}">
      <Implementation>
        <ST><![CDATA[
//CASE iMainEStopSetp OF




 FOR I1:=1 TO 46 BY 1 DO
	arrAxisCtrl[I1].Cmd. bHome:=FALSE;
	arrAxisCtrl[I1].Cmd. bJog_Bw:=FALSE;	
	arrAxisCtrl[I1].Cmd. bJog_Fw:=FALSE;		
    arrAxisCtrl[I1].Cmd. bMoveAbs:=FALSE;		
    arrAxisCtrl[I1].Cmd. bMoveRel:=FALSE;	
    arrAxisCtrl[I1].Cmd. bMoveVelo:=FALSE;		
    arrAxisCtrl[I1].Cmd.bMoveModulo:=FALSE;	
    arrAxisCtrl[I1].Cmd. bSetPos:=FALSE;	    	
    arrAxisCtrl[I1].Cmd. iGoSetPos:=0;	  		
	//arrAxisCtrl[I1].bEnable:=TRUE;
	IF  arrAxisCtrl[I1].Status.Moving  AND NOT arrAxisCtrl[I1].Cmd.bStop   AND  NOT arrAxis[I1] .Status.Coupled THEN   //对运动中的轴执行STOP
	    arrAxisCtrl[I1].Cmd. bStop:=TRUE;	
	END_IF;		
END_FOR;














]]></ST>
      </Implementation>
    </Action>
    <Action Name="P2M1Alarm" Id="{ee04bc42-ca03-4a9c-924a-e0da2283e387}">
      <Implementation>
        <ST><![CDATA[
(*****************************************************************************************一号叠台**************************************************************************************************)
//气缸报警
FOR K1:=1 TO 10 DO 
     arrCYOnAlarm[K1]:=  arrCyCtrl[K1] .Status.Error1;
     arrCYOFFAlarm[K1]:=  arrCyCtrl[K1] .Status.Error2;
END_FOR
P2M1_DTCYHaveAlarm:=FALSE;
FOR K1:=1 TO 10 DO 
      P2M1_DTCYHaveAlarm:=P2M1_DTCYHaveAlarm OR arrCYOnAlarm[K1] OR  arrCYOFFAlarm[K1];
END_FOR
//轴报警
FOR K1:=1 TO 30 DO 
	  arrAxisAlarm[K1]:=arrAxis[K1] .Status.Error AND  arrAxis[K1] .Status.ErrorID<>16#42A0;
END_FOR
P2M1_DTAxisHaveAlarm:=FALSE;//复位轴报警
FOR K1:=1 TO 30 DO 
	   P2M1_DTAxisHaveAlarm:= P2M1_DTAxisHaveAlarm  OR arrAxisAlarm[K1] OR HMI_TorAlarm_D[K1];
END_FOR

P2M1_AnHaveAlarm:=FALSE;//复位正极取极片有报警
P2M1_CaHaveAlarm:=FALSE;//复位负极取极片有报警
P2M1_DTHaveAlarm:=FALSE;//复位叠台有报警
P2M1_DoorAlarm:=false;//复位安全门报警
FOR K1:=0 TO 80 DO 
      P2M1_AnHaveAlarm:=P2M1_AnHaveAlarm OR P2M1_MachCtrl.An_b.Error[K1] ;
	  P2M1_CaHaveAlarm:=P2M1_CaHaveAlarm OR P2M1_MachCtrl.Ca_b.Error[K1] ;
	  P2M1_DTHaveAlarm:=P2M1_DTHaveAlarm OR P2M1_MachCtrl.DT_b.Error[K1];
	  P2M1_DoorAlarm:=P2M1_DoorAlarm OR P2M1_MachCtrl.DT_b.Door_error[K1];
END_FOR

P2M1_MachCtrl.DT_b.Error[64]:=NOT P3User2_Par.Shield[5] AND NOT P2M1_MachCtrl.DT_b.DT_DebugMode AND (Mes1.Error[8] OR Mes1.Error[11] OR Mes1.Error[14] OR Mes1.Error[17] OR Mes1.Error[20] OR Mes1.Error[23]);//功能开关状态报警

//P3_Error[59] 清洁报警
P2M1_DTSysState.bErrorStop:=P2M1_DTCYHaveAlarm OR P2M1_DTAxisHaveAlarm OR P2M1_AnHaveAlarm OR P2M1_CaHaveAlarm OR P2M1_DTHaveAlarm OR 
                            P2M1_DoorAlarm (*OR NOT P2M1_MachCtrl.DT_b.bTensionOK *)OR QY_error OR (AxisHandautomatic[1].error OR P3_Error[59] AND 
                            NOT Axis_error[20] AND NOT Axis_error[21] AND NOT Axis_error[22] AND NOT Axis_error[23] AND NOT Axis_error[24] AND NOT Axis_error[14] ) ;

(*****************************************************************************************一号尾卷贴胶**************************************************************************************************)
//气缸报警
P2M1_WJCYHaveAlarm:=FALSE;
FOR K1:=10 TO 28 DO 
      P2M1_WJCYHaveAlarm:=P2M1_WJCYHaveAlarm OR (arrCyCtrl[K1] .Status.Error1 AND K3<>13) OR  arrCyCtrl[K1] .Status.Error2;;
END_FOR
//轴报警
P2M1_WJAxisHaveAlarm:=FALSE;//复位轴报警
FOR K1:=10 TO 28 DO 
      P2M1_WJAxisHaveAlarm:=P2M1_WJAxisHaveAlarm OR P2M1_WJAxisHaveAlarm OR (arrAxis[K1] .Status.Error AND  arrAxis[K1] .Status.ErrorID<>16#42A0) OR HMI_TorAlarm_D[K1] ;
END_FOR


P2M1_WJHaveAlarm:=FALSE;//复位尾卷有报警
P2M1_TJHaveAlarm:=FALSE;//复位贴胶有报警
FOR K1:=0 TO 29 DO 
	  P2M1_WJHaveAlarm:=P2M1_WJHaveAlarm OR P2M1_MachCtrl.WJ_b.Error[K1];
	  P2M1_TJHaveAlarm:=P2M1_TJHaveAlarm OR P2M1_MachCtrl.TJ_b.Error[K1];
END_FOR

P2M1_WJSysState.bErrorStop:=P2M1_WJCYHaveAlarm OR P2M1_WJAxisHaveAlarm OR P2M1_WJHaveAlarm OR P2M1_TJHaveAlarm OR P2M1_DoorAlarm OR QY_error OR  AxisHandautomatic[2].error;

//三色灯
IF P2M1_MachCtrl.DT_b.Overhang_Warm THEN
	P2Btn.P2M1_Tricolorlamp_Red:=FALSE;
	P2Btn.P2M1_Tricolorlamp_Yellow:=TRUE;
	P2Btn.P2M1_Tricolorlamp_Green:=FALSE;	
ELSE
	IF P2M1_WJSysState.bErrorStop THEN
		P2Btn.P2M1_Tricolorlamp_Red:=TRUE;
		P2Btn.P2M1_Tricolorlamp_Yellow:=FALSE;
		P2Btn.P2M1_Tricolorlamp_Green:=FALSE;
	ELSIF P2M1_MachCtrl.U.DT_iMode=3 OR P2M1_MachCtrl.U.WJ_iMode=3 OR P2M1_MachCtrl.U.TJ_iMode=3 THEN
		P2Btn.P2M1_Tricolorlamp_Red:=FALSE;
		P2Btn.P2M1_Tricolorlamp_Yellow:=TRUE;
		P2Btn.P2M1_Tricolorlamp_Green:=FALSE;	
	ELSIF  P2M1_MachCtrl.U.DT_iMode=1 AND P2M1_MachCtrl.U.WJ_iMode=1 AND P2M1_MachCtrl.U.TJ_iMode=1 THEN
		P2Btn.P2M1_Tricolorlamp_Red:=FALSE;
		P2Btn.P2M1_Tricolorlamp_Yellow:=FALSE;
		P2Btn.P2M1_Tricolorlamp_Green:=TRUE;		
	END_IF
END_IF

rDoorAlarm[1](CLK:= P2M1_DoorAlarm AND NOT  P2M1_DTCYHaveAlarm AND NOT P2M1_DTAxisHaveAlarm AND NOT P2M1_AnHaveAlarm AND NOT P2M1_CaHaveAlarm
                             AND NOT P2M1_DTHaveAlarm AND NOT QY_error AND NOT P2M1_DError);
  IF rDoorAlarm[1].Q THEN
	  P2M1_DError:=TRUE;
  END_IF
  
  IF NOT P2M1_DTSysState.bErrorStop AND P2M1_DError THEN
	  P2M1_DError:=FALSE;
  END_IF
(*
//轴手动对比报警
AxisHandautomatic[1](
	Notmoing:=arrAxis[141].Status.NotMoving AND arrAxis[1].Status.NotMoving AND arrAxis[2].Status.NotMoving AND arrAxis[3].Status.NotMoving AND
              arrAxis[4].Status.NotMoving AND arrAxis[5].Status.NotMoving AND arrAxis[6].Status.NotMoving AND arrAxis[7].Status.NotMoving AND 
              arrAxis[8].Status.NotMoving AND arrAxis[9].Status.NotMoving AND arrAxis[10].Status.NotMoving  AND arrAxis[11].Status.NotMoving AND 
              arrAxis[12].Status.NotMoving AND arrAxis[13].Status.NotMoving AND arrAxis[14].Status.NotMoving   AND arrAxis[15].Status.NotMoving AND 
              arrAxis[16].Status.NotMoving  AND arrAxis[17].Status.NotMoving AND arrAxis[18].Status.NotMoving   AND arrAxis[19].Status.NotMoving AND 
              arrAxis[20].Status.NotMoving  AND arrAxis[21].Status.NotMoving AND arrAxis[22].Status.NotMoving   AND arrAxis[23].Status.NotMoving AND 
               arrAxis[24].Status.NotMoving  AND arrAxis[25].Status.NotMoving AND arrAxis[26].Status.NotMoving   AND arrAxis[27].Status.NotMoving AND 
              arrAxis[28].Status.NotMoving AND arrAxis[29].Status.NotMoving AND arrAxis[30].Status.NotMoving,  
	Run:=P2M1_DTSysState.hmiAuto , 
	i:=1 , 
	j:= 30, 
	Reset:=P2M1_MachCtrl.DT_b.DTIniti_Hbtn , 
	error=> );

AxisHandautomatic[2](
	Notmoing:=arrAxis[31].Status.NotMoving AND arrAxis[32].Status.NotMoving AND arrAxis[33].Status.NotMoving AND arrAxis[34].Status.NotMoving AND
              arrAxis[35].Status.NotMoving AND arrAxis[36].Status.NotMoving AND arrAxis[37].Status.NotMoving AND arrAxis[38].Status.NotMoving AND 
              arrAxis[39].Status.NotMoving AND arrAxis[40].Status.NotMoving AND arrAxis[41].Status.NotMoving AND arrAxis[42].Status.NotMoving AND 
              arrAxis[43].Status.NotMoving AND arrAxis[44].Status.NotMoving  , 
	Run:=P2M1_WJSysState.hmiAuto , 
	i:=31 , 
	j:= 14, 
	Reset:=P2M1_MachCtrl.WJ_b.WZIniti_Hbtn OR  P2M1_MachCtrl.TJ_b.TJIniti_Hbtn, 
	error=> );
*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="P2M2_EStop" Id="{7499748d-a2f0-4ce4-aa94-08fa876b4a0f}">
      <Implementation>
        <ST><![CDATA[ FOR I3:=47 TO 92 BY 1 DO
	arrAxisCtrl[I3].Cmd. bHome:=FALSE;
	arrAxisCtrl[I3].Cmd. bJog_Bw:=FALSE;	
	arrAxisCtrl[I3].Cmd. bJog_Fw:=FALSE;		
    arrAxisCtrl[I3].Cmd. bMoveAbs:=FALSE;		
    arrAxisCtrl[I3].Cmd. bMoveRel:=FALSE;	
    arrAxisCtrl[I3].Cmd. bMoveVelo:=FALSE;		
    arrAxisCtrl[I3].Cmd.bMoveModulo:=FALSE;	
    arrAxisCtrl[I3].Cmd. bSetPos:=FALSE;	    	
    arrAxisCtrl[I3].Cmd. iGoSetPos:=0;	  		
	//arrAxisCtrl[I1].bEnable:=TRUE;
	IF  arrAxisCtrl[I3].Status.Moving  AND NOT arrAxisCtrl[I3].Cmd.bStop   AND  NOT arrAxis[I3] .Status.Coupled THEN   //对运动中的轴执行STOP
	    arrAxisCtrl[I3].Cmd. bStop:=TRUE;	
	END_IF;		
END_FOR;]]></ST>
      </Implementation>
    </Action>
    <Action Name="P2M2Alarm" Id="{376174c7-0405-4bec-b984-b8d9eb3e097c}">
      <Implementation>
        <ST><![CDATA[(*****************************************************************************************二号叠台**************************************************************************************************)
//气缸报警
FOR K2:=29 TO 38 DO 
     arrCYOnAlarm[K2]:=  arrCyCtrl[K2] .Status.Error1;
     arrCYOFFAlarm[K2]:=  arrCyCtrl[K2] .Status.Error2;
END_FOR
P2M2_DTCYHaveAlarm:=FALSE;//复位气缸报警
FOR K2:=29 TO 38 DO 
      P2M2_DTCYHaveAlarm:=P2M2_DTCYHaveAlarm OR (arrCYOnAlarm[K2]  AND K3<>41) OR  arrCYOFFAlarm[K2];
END_FOR
//轴报警
FOR K2:=47 TO 76 DO 
     arrAxisAlarm[K2]:=  arrAxis[K2] .Status.Error AND  arrAxis[K2] .Status.ErrorID<>16#42A0 ;
END_FOR
P2M2_DTAxisHaveAlarm:=FALSE;//复位轴报警
FOR K2:=47 TO 76 DO 
      P2M2_DTAxisHaveAlarm:=P2M2_DTAxisHaveAlarm OR arrAxisAlarm[K2] OR HMI_TorAlarm_D[K2];
END_FOR

P2M2_AnHaveAlarm:=FALSE;//复位正极取极片有报警
P2M2_CaHaveAlarm:=FALSE;//复位负极取极片有报警
P2M2_DTHaveAlarm:=FALSE;//复位叠台有报警
P2M2_DoorAlarm:=false;//复位安全门报警
FOR K2:=0 TO 80 DO 
      P2M2_AnHaveAlarm:=P2M2_AnHaveAlarm OR P2M2_MachCtrl.An_b.Error[K2] ;
	  P2M2_CaHaveAlarm:=P2M2_CaHaveAlarm OR P2M2_MachCtrl.Ca_b.Error[K2] ;
	  P2M2_DTHaveAlarm:=P2M2_DTHaveAlarm OR P2M2_MachCtrl.DT_b.Error[K2];
	  P2M2_DoorAlarm:=P2M2_DoorAlarm OR P2M2_MachCtrl.DT_b.Door_error[K2];
END_FOR

P2M2_MachCtrl.DT_b.Error[64]:=NOT P3User2_Par.Shield[5] AND NOT P2M2_MachCtrl.DT_b.DT_DebugMode AND (Mes1.Error[9] OR Mes1.Error[12] OR Mes1.Error[15] OR Mes1.Error[18] OR Mes1.Error[21] OR Mes1.Error[24]);//功能开关状态报警	

//P3_Error[59] 清洁报警
P2M2_DTSysState.bErrorStop:=P2M2_DTCYHaveAlarm OR P2M2_DTAxisHaveAlarm OR P2M2_AnHaveAlarm OR P2M2_CaHaveAlarm OR P2M2_DTHaveAlarm OR 
                            P2M2_DoorAlarm (*OR NOT P2M2_MachCtrl.DT_b.bTensionOK *)OR QY_error OR ( AxisHandautomatic[3].error OR P3_Error[59] AND  
                            NOT Axis_error[66] AND NOT Axis_error[67] AND NOT Axis_error[68] AND NOT Axis_error[69] AND NOT Axis_error[70] AND NOT Axis_error[60]);
(*****************************************************************************************二号尾卷贴胶**************************************************************************************************)
//气缸报警
FOR K2:=38 TO 56 DO 
     arrCYOnAlarm[K2]:=  arrCyCtrl[K2] .Status.Error1;
     arrCYOFFAlarm[K2]:=  arrCyCtrl[K2] .Status.Error2;
END_FOR
P2M2_WJCYHaveAlarm:=FALSE;//复位气缸报警
FOR K2:=38 TO 56 DO 
      P2M2_WJCYHaveAlarm:=P2M2_WJCYHaveAlarm OR arrCYOnAlarm[K2] OR  arrCYOFFAlarm[K2];
END_FOR
//轴报警
FOR K2:=77 TO 90 DO 
     arrAxisAlarm[K2]:=  arrAxis[K2] .Status.Error AND  arrAxis[K2] .Status.ErrorID<>16#42A0 ;
END_FOR
P2M2_WJAxisHaveAlarm:=FALSE;//复位轴报警
FOR K2:=77 TO 90 DO 
      P2M2_WJAxisHaveAlarm:=P2M2_WJAxisHaveAlarm OR arrAxisAlarm[K2] OR HMI_TorAlarm_D[K2];
END_FOR

P2M2_WJHaveAlarm:=FALSE;//复位尾卷有报警
P2M2_TJHaveAlarm:=FALSE;//复位贴胶有报警
FOR K2:=0 TO 29 DO 
	  P2M2_WJHaveAlarm:=P2M2_WJHaveAlarm OR P2M2_MachCtrl.WJ_b.Error[K2];
	  P2M2_TJHaveAlarm:=P2M2_TJHaveAlarm OR P2M2_MachCtrl.TJ_b.Error[K2];
END_FOR

P2M2_WJSysState.bErrorStop:=P2M2_WJCYHaveAlarm OR P2M2_WJAxisHaveAlarm OR P2M2_WJHaveAlarm OR P2M2_TJHaveAlarm OR P2M2_DoorAlarm OR QY_error OR AxisHandautomatic[4].error; 

//三色灯
IF P2M2_MachCtrl.DT_b.Overhang_Warm THEN
	P2Btn.P2M2_Tricolorlamp_Red:=FALSE;
	P2Btn.P2M2_Tricolorlamp_Yellow:=TRUE;
	P2Btn.P2M2_Tricolorlamp_Green:=FALSE;	
ELSE
	IF P2M2_WJSysState.bErrorStop THEN
		P2Btn.P2M2_Tricolorlamp_Red:=TRUE;
		P2Btn.P2M2_Tricolorlamp_Yellow:=FALSE;
		P2Btn.P2M2_Tricolorlamp_Green:=FALSE;
	ELSIF P2M2_MachCtrl.U.DT_iMode=3 OR P2M2_MachCtrl.U.WJ_iMode=3 OR P2M2_MachCtrl.U.TJ_iMode=3 THEN
		P2Btn.P2M2_Tricolorlamp_Red:=FALSE;
		P2Btn.P2M2_Tricolorlamp_Yellow:=TRUE;
		P2Btn.P2M2_Tricolorlamp_Green:=FALSE;	
	ELSIF  P2M2_MachCtrl.U.DT_iMode=1 AND P2M2_MachCtrl.U.WJ_iMode=1 AND P2M2_MachCtrl.U.TJ_iMode=1 THEN
		P2Btn.P2M2_Tricolorlamp_Red:=FALSE;
		P2Btn.P2M2_Tricolorlamp_Yellow:=FALSE;
		P2Btn.P2M2_Tricolorlamp_Green:=TRUE;		
	END_IF
END_IF

rDoorAlarm[2](CLK:= P2M2_DoorAlarm AND NOT  P2M2_DTCYHaveAlarm AND NOT P2M2_DTAxisHaveAlarm AND NOT P2M2_AnHaveAlarm AND NOT P2M2_CaHaveAlarm
                             AND NOT P2M2_DTHaveAlarm AND NOT QY_error AND NOT P2M2_DError);
  IF rDoorAlarm[2].Q THEN
	  P2M2_DError:=TRUE;
  END_IF
  
  IF NOT P2M2_DTSysState.bErrorStop AND P2M2_DError THEN
	  P2M2_DError:=FALSE;
  END_IF
(*
//轴手动对比报警
AxisHandautomatic[3](
	Notmoing:=arrAxis[145].Status.NotMoving AND arrAxis[47].Status.NotMoving AND arrAxis[48].Status.NotMoving AND arrAxis[49].Status.NotMoving AND
              arrAxis[50].Status.NotMoving AND arrAxis[51].Status.NotMoving AND arrAxis[52].Status.NotMoving AND arrAxis[53].Status.NotMoving AND 
              arrAxis[54].Status.NotMoving AND arrAxis[55].Status.NotMoving AND arrAxis[56].Status.NotMoving  AND arrAxis[57].Status.NotMoving AND 
              arrAxis[58].Status.NotMoving AND arrAxis[59].Status.NotMoving AND arrAxis[60].Status.NotMoving   AND arrAxis[61].Status.NotMoving AND 
              arrAxis[62].Status.NotMoving  AND arrAxis[63].Status.NotMoving AND arrAxis[64].Status.NotMoving   AND arrAxis[65].Status.NotMoving AND 
              arrAxis[66].Status.NotMoving  AND arrAxis[67].Status.NotMoving AND arrAxis[68].Status.NotMoving   AND arrAxis[69].Status.NotMoving AND 
               arrAxis[70].Status.NotMoving  AND arrAxis[71].Status.NotMoving AND arrAxis[72].Status.NotMoving   AND arrAxis[73].Status.NotMoving AND 
              arrAxis[74].Status.NotMoving AND arrAxis[75].Status.NotMoving AND arrAxis[76].Status.NotMoving,  
	Run:=P2M2_DTSysState.hmiAuto , 
	i:=47 , 
	j:= 30, 
	Reset:=P2M2_MachCtrl.DT_b.DTIniti_Hbtn , 
	error=> );

AxisHandautomatic[4](
	Notmoing:=arrAxis[77].Status.NotMoving AND arrAxis[78].Status.NotMoving AND arrAxis[79].Status.NotMoving AND arrAxis[80].Status.NotMoving AND
              arrAxis[81].Status.NotMoving AND arrAxis[82].Status.NotMoving AND arrAxis[83].Status.NotMoving AND arrAxis[84].Status.NotMoving AND 
              arrAxis[85].Status.NotMoving AND arrAxis[86].Status.NotMoving AND arrAxis[87].Status.NotMoving AND arrAxis[88].Status.NotMoving AND 
              arrAxis[89].Status.NotMoving AND arrAxis[90].Status.NotMoving  , 	
	Run:=P2M2_WJSysState.hmiAuto , 
	i:=77 , 
	j:= 14, 
	Reset:=P2M2_MachCtrl.WJ_b.WZIniti_Hbtn OR  P2M2_MachCtrl.TJ_b.TJIniti_Hbtn, 
	error=> );
*)
]]></ST>
      </Implementation>
    </Action>
    <Action Name="P2M3_EStop" Id="{98c88f4e-3723-4076-b118-6c4180373e73}">
      <Implementation>
        <ST><![CDATA[ FOR I6:=93 TO 138 BY 1 DO
	arrAxisCtrl[I6].Cmd. bHome:=FALSE;
	arrAxisCtrl[I6].Cmd. bJog_Bw:=FALSE;	
	arrAxisCtrl[I6].Cmd. bJog_Fw:=FALSE;		
    arrAxisCtrl[I6].Cmd. bMoveAbs:=FALSE;		
    arrAxisCtrl[I6].Cmd. bMoveRel:=FALSE;	
    arrAxisCtrl[I6].Cmd. bMoveVelo:=FALSE;		
    arrAxisCtrl[I6].Cmd.bMoveModulo:=FALSE;	
    arrAxisCtrl[I6].Cmd. bSetPos:=FALSE;	    	
    arrAxisCtrl[I6].Cmd. iGoSetPos:=0;	  		
	//arrAxisCtrl[I1].bEnable:=TRUE;
	IF  arrAxisCtrl[I6].Status.Moving  AND NOT arrAxisCtrl[I6].Cmd.bStop   AND  NOT arrAxis[I6] .Status.Coupled THEN   //对运动中的轴执行STOP
	    arrAxisCtrl[I6].Cmd. bStop:=TRUE;	
	END_IF;		
END_FOR;]]></ST>
      </Implementation>
    </Action>
    <Action Name="P2M3Alarm" Id="{b9981034-c94f-46fe-bfe8-606eaa915b5f}">
      <Implementation>
        <ST><![CDATA[(*****************************************************************************************三号叠台**************************************************************************************************)
//气缸报警
FOR K3:=57 TO 66 DO 
     arrCYOnAlarm[K3]:=  arrCyCtrl[K3] .Status.Error1;
     arrCYOFFAlarm[K3]:=  arrCyCtrl[K3] .Status.Error2;
END_FOR
P2M3_DTCYHaveAlarm:=FALSE;//复位气缸报警
FOR K3:=57 TO 66 DO 
      P2M3_DTCYHaveAlarm:=P2M3_DTCYHaveAlarm OR arrCYOnAlarm[K3] OR  arrCYOFFAlarm[K3];
END_FOR
//轴报警
FOR K3:=93 TO 122 DO 
     arrAxisAlarm[K3]:=  arrAxis[K3] .Status.Error AND  arrAxis[K3] .Status.ErrorID<>16#42A0 ;
END_FOR
P2M3_DTAxisHaveAlarm:=FALSE;//复位轴报警
FOR K3:=93 TO 122 DO 
      P2M3_DTAxisHaveAlarm:=P2M3_DTAxisHaveAlarm OR arrAxisAlarm[K3] OR HMI_TorAlarm_D[K3];
END_FOR

P2M3_AnHaveAlarm:=FALSE;//复位正极取极片有报警
P2M3_CaHaveAlarm:=FALSE;//复位负极取极片有报警
P2M3_DTHaveAlarm:=FALSE;//复位叠台有报警
P2M3_DoorAlarm:=FALSE;//复位安全门报警
FOR K3:=0 TO 80 DO 
      P2M3_AnHaveAlarm:=P2M3_AnHaveAlarm OR P2M3_MachCtrl.An_b.Error[K3] ;
	  P2M3_CaHaveAlarm:=P2M3_CaHaveAlarm OR P2M3_MachCtrl.Ca_b.Error[K3] ;
	  P2M3_DTHaveAlarm:=P2M3_DTHaveAlarm OR P2M3_MachCtrl.DT_b.Error[K3];
	  P2M3_DoorAlarm:=P2M3_DoorAlarm OR P2M3_MachCtrl.DT_b.Door_error[K3];
END_FOR

P2M3_MachCtrl.DT_b.Error[64]:=NOT P3User2_Par.Shield[5] AND NOT P2M3_MachCtrl.DT_b.DT_DebugMode AND  (Mes1.Error[10] OR Mes1.Error[13] OR Mes1.Error[16] OR Mes1.Error[19] OR Mes1.Error[22] OR Mes1.Error[25]);//功能开关状态报警

//P3_Error[59] 清洁报警
P2M3_DTSysState.bErrorStop:=P2M3_DTCYHaveAlarm OR P2M3_DTAxisHaveAlarm OR P2M3_AnHaveAlarm OR P2M3_CaHaveAlarm OR P2M3_DTHaveAlarm OR
                            P2M3_DoorAlarm (*OR NOT P2M3_MachCtrl.DT_b.bTensionOK*) OR QY_error OR (AxisHandautomatic[5].error  OR P3_Error[59] AND 
                            NOT Axis_error[112] AND NOT Axis_error[113] AND NOT Axis_error[114] AND NOT Axis_error[115] AND NOT Axis_error[116] AND NOT Axis_error[106]);
(*****************************************************************************************三号尾卷贴胶**************************************************************************************************)
//气缸报警
FOR K3:=66 TO 85 DO 
     arrCYOnAlarm[K3]:=  arrCyCtrl[K3] .Status.Error1;
     arrCYOFFAlarm[K3]:=  arrCyCtrl[K3] .Status.Error2;
END_FOR
P2M3_WJCYHaveAlarm:=FALSE;//复位气缸报警
FOR K3:=66 TO 85 DO 
      P2M3_WJCYHaveAlarm:=P2M3_WJCYHaveAlarm OR (arrCYOnAlarm[K3] AND K3<>69) OR  arrCYOFFAlarm[K3];
END_FOR
//轴报警
FOR K3:=123 TO 136 DO 
     arrAxisAlarm[K3]:=  arrAxis[K3] .Status.Error AND  arrAxis[K3] .Status.ErrorID<>16#42A0 ;
END_FOR
P2M3_WJAxisHaveAlarm:=FALSE;//复位轴报警
FOR K3:=123 TO 136 DO 
      P2M3_WJAxisHaveAlarm:=P2M3_WJAxisHaveAlarm OR arrAxisAlarm[K3]OR HMI_TorAlarm_D[K3];
END_FOR

P2M3_WJHaveAlarm:=FALSE;//复位尾卷有报警
P2M3_TJHaveAlarm:=FALSE;//复位贴胶有报警
FOR K2:=0 TO 29 DO 
	  P2M3_WJHaveAlarm:=P2M3_WJHaveAlarm OR P2M3_MachCtrl.WJ_b.Error[K2];
	  P2M3_TJHaveAlarm:=P2M3_TJHaveAlarm OR P2M3_MachCtrl.TJ_b.Error[K2];
END_FOR

P2M3_WJSysState.bErrorStop:=P2M3_WJCYHaveAlarm OR P2M3_WJAxisHaveAlarm OR P2M3_WJHaveAlarm OR P2M3_TJHaveAlarm OR P2M3_DoorAlarm OR QY_error OR AxisHandautomatic[6].error;


//三色灯
IF P2M3_MachCtrl.DT_b.Overhang_Warm THEN
	P2Btn.P2M3_Tricolorlamp_Red:=FALSE;
	P2Btn.P2M3_Tricolorlamp_Yellow:=TRUE;
	P2Btn.P2M3_Tricolorlamp_Green:=FALSE;	
ELSE
	IF P2M3_WJSysState.bErrorStop THEN
		P2Btn.P2M3_Tricolorlamp_Red:=TRUE;
		P2Btn.P2M3_Tricolorlamp_Yellow:=FALSE;
		P2Btn.P2M3_Tricolorlamp_Green:=FALSE;
	ELSIF P2M3_MachCtrl.U.DT_iMode=3 OR P2M3_MachCtrl.U.WJ_iMode=3 OR P2M3_MachCtrl.U.TJ_iMode=3 THEN
		P2Btn.P2M3_Tricolorlamp_Red:=FALSE;
		P2Btn.P2M3_Tricolorlamp_Yellow:=TRUE;
		P2Btn.P2M3_Tricolorlamp_Green:=FALSE;	
	ELSIF  P2M3_MachCtrl.U.DT_iMode=1 AND P2M3_MachCtrl.U.WJ_iMode=1 AND P2M3_MachCtrl.U.TJ_iMode=1 THEN
		P2Btn.P2M3_Tricolorlamp_Red:=FALSE;
		P2Btn.P2M3_Tricolorlamp_Yellow:=FALSE;
		P2Btn.P2M3_Tricolorlamp_Green:=TRUE;		
	END_IF
END_IF

rDoorAlarm[3](CLK:= P2M3_DoorAlarm AND NOT  P2M3_DTCYHaveAlarm AND NOT P2M3_DTAxisHaveAlarm AND NOT P2M3_AnHaveAlarm AND NOT P2M3_CaHaveAlarm
                             AND NOT P2M3_DTHaveAlarm AND NOT QY_error AND NOT P2M3_DError);
  IF rDoorAlarm[3].Q THEN
	  P2M3_DError:=TRUE;
  END_IF
  
  IF NOT P2M3_DTSysState.bErrorStop AND P2M3_DError THEN
	  P2M3_DError:=FALSE;
  END_IF

(*
//轴手动对比报警
AxisHandautomatic[5](
	Notmoing:=arrAxis[149].Status.NotMoving AND arrAxis[93].Status.NotMoving AND arrAxis[94].Status.NotMoving AND arrAxis[95].Status.NotMoving AND
              arrAxis[96].Status.NotMoving AND arrAxis[97].Status.NotMoving AND arrAxis[98].Status.NotMoving AND arrAxis[99].Status.NotMoving AND 
              arrAxis[100].Status.NotMoving AND arrAxis[101].Status.NotMoving AND arrAxis[102].Status.NotMoving  AND arrAxis[103].Status.NotMoving AND 
              arrAxis[104].Status.NotMoving AND arrAxis[105].Status.NotMoving AND arrAxis[106].Status.NotMoving   AND arrAxis[107].Status.NotMoving AND 
              arrAxis[108].Status.NotMoving  AND arrAxis[109].Status.NotMoving AND arrAxis[110].Status.NotMoving   AND arrAxis[111].Status.NotMoving AND 
              arrAxis[112].Status.NotMoving  AND arrAxis[113].Status.NotMoving AND arrAxis[114].Status.NotMoving   AND arrAxis[115].Status.NotMoving AND 
               arrAxis[116].Status.NotMoving  AND arrAxis[117].Status.NotMoving AND arrAxis[118].Status.NotMoving   AND arrAxis[119].Status.NotMoving AND 
              arrAxis[120].Status.NotMoving AND arrAxis[121].Status.NotMoving AND arrAxis[122].Status.NotMoving,  
	Run:=P2M3_DTSysState.hmiAuto , 
	i:=93 , 
	j:= 30, 
	Reset:=P2M3_MachCtrl.DT_b.DTIniti_Hbtn , 
	error=> );

AxisHandautomatic[6](
	Notmoing:=arrAxis[123].Status.NotMoving AND arrAxis[124].Status.NotMoving AND arrAxis[125].Status.NotMoving AND arrAxis[126].Status.NotMoving AND
              arrAxis[127].Status.NotMoving AND arrAxis[128].Status.NotMoving AND arrAxis[129].Status.NotMoving AND arrAxis[130].Status.NotMoving AND 
              arrAxis[131].Status.NotMoving AND arrAxis[132].Status.NotMoving AND arrAxis[133].Status.NotMoving AND arrAxis[134].Status.NotMoving AND 
              arrAxis[135].Status.NotMoving AND arrAxis[136].Status.NotMoving  , 		
	Run:=P2M3_WJSysState.hmiAuto , 
	i:=123 , 
	j:= 14, 
	Reset:=P2M3_MachCtrl.WJ_b.WZIniti_Hbtn OR  P2M3_MachCtrl.TJ_b.TJIniti_Hbtn, 
	error=> );
	*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="Pusle" Id="{68750299-f42d-4f2a-9f43-16bde33b084d}">
      <Implementation>
        <ST><![CDATA[(*
/////////////////////////////////////////时钟脉冲////////////////////////////////////////////////////////////
//fbPulseCtrl1(PT_OFF:=T#2MS, PT_ON:=T#2MS, Q=>, RT=>);
fbPulseCtrl[1](PT_OFF:=T#2MS, PT_ON:=T#2MS,   );
fbPulseCtrl[2](PT_OFF:=T#4MS, PT_ON:=T#4MS,    );
fbPulseCtrl[3](PT_OFF:=T#10MS, PT_ON:=T#10MS,   );

fbPulseCtrl[4](PT_OFF:=T#300MS, PT_ON:=T#300MS,   );
fbPulseCtrl[5](PT_OFF:=T#3S, PT_ON:=T#3S,    );
fbPulseCtrl[6](PT_OFF:=T#5S, PT_ON:=T#5S,   );
fbPulseCtrl[7](PT_OFF:=T#10S, PT_ON:=T#10S,  );
fbPulseCtrl[8](PT_OFF:=T#250MS, PT_ON:=T#250MS,   );

fbPulseCtrl[9](PT_OFF:=T#2S, PT_ON:=T#200MS,   );

fbPulseCtrl[1].Q;
fbPulseCtrl[1].RT;
fbPulseCtrl[2].Q;
fbPulseCtrl[2].RT;
fbPulseCtrl[3].Q;
fbPulseCtrl[3].RT;
fbPulseCtrl[4].Q;
fbPulseCtrl[4].RT;
fbPulseCtrl[5].Q;
fbPulseCtrl[5].RT;
fbPulseCtrl[6].Q;
fbPulseCtrl[6].RT;
fbPulseCtrl[7].Q;
fbPulseCtrl[7].RT;
fbPulseCtrl[8].Q;
fbPulseCtrl[8].RT;


IF bWaterOn AND ( bWaterOn2   OR    ABS( arrAxisCtrl[P1AxisNo.GMWind_U].Status.fActVelo)>=5 AND  ABS (arrAxisCtrl[P1AxisNo.GMWind_D].Status.fActVelo)>=5 )   THEN
  //P3EL2889S[3,5]:= fbPulseCtrl[9].Q;
   P1EL2889S[3,1]:= fbPulseCtrl[9].Q;
   P1EL2889S[3,2]:= fbPulseCtrl[9].Q;

   P2EL2889S[4,1]:=fbPulseCtrl[9].Q	;	
   P2EL2889S[4,2]:=fbPulseCtrl[9].Q;	

   P2EL2889S[4,3]:=fbPulseCtrl[9].Q	;	
   P2EL2889S[4,4]:=fbPulseCtrl[9].Q;	

ELSE
  //P3EL2889S[3,5]:= FALSE;
   P1EL2889S[3,1]:= FALSE;
   P1EL2889S[3,2]:= FALSE;
   P2EL2889S[4,1]:= FALSE	;	
   P2EL2889S[4,2]:= FALSE;	

   P2EL2889S[4,3]:=FALSE	;	
   P2EL2889S[4,4]:=FALSE;	
END_IF


//P1EL2889S[3,1]


*)













]]></ST>
      </Implementation>
    </Action>
