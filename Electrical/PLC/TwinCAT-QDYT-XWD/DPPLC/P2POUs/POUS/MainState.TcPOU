<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MainState" Id="{a206b14c-720d-45cc-a380-a7b0911432bc}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MainState
VAR
	iMainSetp :INT;
	bEstop: BOOL;
	fbDustMotor       :ARRAY[1..Max_Dust]   OF   CS_DustMoter;
	P2M1iMainSetp :INT;
	P2M2iMainSetp :INT;	
	P2M3iMainSetp :INT;	
	
	I1: UINT;
	iErrorSetp: INT;
	iLightSel: INT;
	bTurnOn: BOOL;
	bDoor_Stop: BOOL;
	I2: INT;
	I4: INT;
	I5: INT;
	i: UINT;
	iCode2: ICode;
	ExtSetVel: LREAL;
	ExtSetPos: LREAL;
	ExtSetAcc: LREAL;
	ExtSetDec: DINT;
	InitSetp: INT;
	
	rtStoping: R_TRIG;
	iMainInitSetp: INT;
	iMainEStopSetp: INT;
	K1: UINT;
	bInitReset: BOOL;
	DA1: INT;
	Code1: BOOL;
	Code2: BOOL;
	Code3: BOOL;
	Code4: BOOL;
	CyCtrl: INT;
	bWaterOn: BOOL;
	
	Execute: BOOL;
	bCoeWrite_GlueFeed: BOOL;
	bWaterOn2: BOOL;
	//i10: UINT;
	// 一号叠台
	P2M1_Step0: INT;
	// 二号叠台
	P2M2_Step0: INT;
	// 三号叠台
	P2M3_Step0: INT;
	// 一号尾卷
	P2M1_Step1: INT;
	// 二号尾卷
	P2M2_Step1: INT;
	// 三号尾卷
	P2M3_Step1: INT;
	P2M1DT_R_TRIG: ARRAY[0..5] OF R_TRIG;
	// 二号叠台
	P2M2DT_R_TRIG: ARRAY[0..9] OF R_TRIG;
	// 一号尾卷
	P2M1WJ_R_TRIG: ARRAY[0..9] OF  R_TRIG;
	// 二号尾卷
	P2M2WJ_R_TRIG: ARRAY[0..9] OF  R_TRIG;
	// 三号叠台
	P2M3DT_R_TRIG: ARRAY[0..9] OF R_TRIG;
	// 三号尾卷
	P2M3WJ_R_TRIG: ARRAY[0..9] OF R_TRIG;
	K2: UINT;
	// 二号叠台报警
	K3: UINT;
	P2M3_Step2: INT;
	P2M2_Step2: INT;
	P2M1_Step2: INT;
	P2M3TJ_R_TRIG: R_TRIG;
	P2M1TJ_R_TRIG: R_TRIG;
	P2M2TJ_R_TRIG: R_TRIG;
	I3: INT;
	I6: INT;
	P2M1_tonEStop1: TON;
	P2M1_tonEStop2: TON;
	P2M1_tonEStop3: TON;
	P2M2_tonEStop1: TON;
	P2M2_tonEStop3: TON;
	P2M2_tonEStop2: TON;
	P2M3_tonEStop1: TON;
	P2M3_tonEStop2: TON;
	P2M3_tonEStop3: TON;
	P2M1_AutobtnR_TRIG: R_TRIG;
	P2M1_AutobtnF_TRIG: F_TRIG;
	P2M2_AutobtnR_TRIG: R_TRIG;
	P2M2_AutobtnF_TRIG: F_TRIG;
	P2M3_AutobtnR_TRIG: R_TRIG;
	P2M3_AutobtnF_TRIG: F_TRIG;
	tCycleTimer: TON;
	bSave: BOOL;
	rt10: R_TRIG;
	bReadDataFirstCyle: BOOL;
	testii: INT;
	testii2: INT;
	bSaveDataTest: BOOL;
	bReadDataCyle2: BOOL;
	rtSaveData: R_TRIG;
	tDecideTim: ARRAY[1..20] OF TON;
END_VAR

VAR
	R_TRIG_Bt: 			ARRAY[1..10]OF R_TRIG;
	TON20:Tc2_Standard.TON;	
//	TON21:Tc2_Standard.TON;	
	rt100:Tc2_Standard.R_TRIG;
	rt101:Tc2_Standard.R_TRIG;
	
	tDelayBuzze:TON;

	RT200:ARRAY[1..4] OF Tc2_Standard.R_TRIG;

	
	csAxis                 :ARRAY[1..MaxP2Axes] OF   CS_AxisCtrl;
	fbCy                   :ARRAY[1..MaxP2Cy]    OF   FB_Cylinder;
    //fbRec                 :ARRAY[1..MaxRec]   OF   FB_Rectify;
  //  fbTemp             :ARRAY[1..MaxTemp]   OF   FB_Temperature;



    csCodeTcp:CS_CodeTcp;
    fbCamInTest: MC_CamIn;//主轴与驱动凸轮耦合

//速度模式验证
	MC_ExtSetPointGenDisable: MC_ExtSetPointGenDisable;
	MC_ExtSetPointGenEnable: MC_ExtSetPointGenEnable;
    MC_ExtSetPointGenOut:        Tc2_MC2.ST_McOutputs;
    MC_ExtSetPointGenOut2:        Tc2_MC2.ST_McOutputs;

    tonEStop:                     Tc2_Standard.TON;

   
  fbP4NGSetpMoter  : CS_SetpMoter;



        mc_Home    :MC_Home;

        fbCoeWrite_GlueFeed:       FB_EcCoeSdoWrite;
     	wEncodeHome                    :WORD:=6;
      //fbDataXML  :FB_DataXML;  
	  
	   AxisHandautomatic:ARRAY[1..6] OF FB_AxisHandautomatic;

//叠台调度	   
	   P2M1AutoRuning: BOOL;
	P2M2AutoRuning: BOOL;
	P2M3AutoRuning: BOOL;
	P2M1ReadyTemp: BOOL;
	P2M2ReadyTemp: BOOL;
	P2M3ReadyTemp: BOOL;
	P2M1ReadyAllow: BOOL;
	P2M2ReadyAllow: BOOL;
	P2M3ReadyAllow: BOOL;
	// 调度模式  TRUE：调度模式     FALSE：独立模式
	iDispatchMode: BOOL;
	iDispatchSetp: INT;
	iDispatchSetp2: INT;
	iDPAutoRuningSEL: INT;
	
	rDoorAlarm :ARRAY[1..3]OF R_TRIG;
	
	iSyncStep:INT;//叠台同步启动调度步序 20240504CF
	fMinTime:REAL;//最快的叠片时间
	
	i11:ARRAY[1..10]   OF UINT;
	i10:ARRAY[1..10]   OF UINT;
END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[stSysState.btnAuto;
stSysState.btnManul;
stSysState.btnStart;
stSysState.btnStop;
stSysState.btnReset;
stSysState.btnEstop;//常开  

AA1;

IF NOT P2Btn.P2M1_EmStopbtn1 OR NOT P2Btn.P2M2_EmStopbtn1 OR NOT P2Btn.P2M3_EmStopbtn1 THEN
		stSysState.btnEstop:=TRUE;
ELSE
		stSysState.btnEstop:=FALSE;
END_IF

R_TRIG_Bt[1](CLK:= stSysState.btnStart   OR  stSysState.hmiStart);//启动按钮
R_TRIG_Bt[2](CLK:= stSysState.btnStop   OR  stSysState.hmiStop);//停止按钮
R_TRIG_Bt[4](CLK:=   stSysState.btnAuto OR  stSysState.hmiAuto);//切换到自动
R_TRIG_Bt[5](CLK:=  NOT stSysState.btnAuto);//
R_TRIG_Bt[6](CLK:=stSysState.btnEstop);
R_TRIG_Bt[7](CLK:=stSysState.btnReset OR  stSysState.hmiReset OR P2Btn.P2M1_Resetebtn OR P2Btn.P2M2_Resetebtn OR P2Btn.P2M3_Resetebtn );//复位
R_TRIG_Bt[8](CLK:=  NOT stSysState.hmiAuto);
//复位时判断时间主轴是否启动
IF R_TRIG_Bt[7].Q THEN
		  IF  arrAxis[VirAxisNo.P2M1_VirTimeWind].Status.ControlLoopClosed THEN
			  arrAxisPar[VirAxisNo.P2M1_VirTimeWind].fVelocity_of_Velo:=100;
			  arrAxisCtrl[VirAxisNo.P2M1_VirTimeWind].Cmd.bMoveVelo:=TRUE;
		  END_IF
		  
		  IF  arrAxis[VirAxisNo.P2M1_VirGM].Status.ControlLoopClosed THEN
			  arrAxisPar[VirAxisNo.P2M1_VirGM].fVelocity_of_Velo:=100;
			  arrAxisCtrl[VirAxisNo.P2M1_VirGM].Cmd.bMoveVelo:=TRUE;
		  END_IF
		  
		  IF  arrAxis[VirAxisNo.P2M2_VirTimeWind].Status.ControlLoopClosed THEN
			  arrAxisPar[VirAxisNo.P2M2_VirTimeWind].fVelocity_of_Velo:=100;
			  arrAxisCtrl[VirAxisNo.P2M2_VirTimeWind].Cmd.bMoveVelo:=TRUE;
		  END_IF
		  IF  arrAxis[VirAxisNo.P2M2_VirGM].Status.ControlLoopClosed THEN
			  arrAxisPar[VirAxisNo.P2M2_VirGM].fVelocity_of_Velo:=100;
			  arrAxisCtrl[VirAxisNo.P2M2_VirGM].Cmd.bMoveVelo:=TRUE;
		  END_IF
		  
		  IF  arrAxis[VirAxisNo.P2M3_VirTimeWind].Status.ControlLoopClosed THEN
			  arrAxisPar[VirAxisNo.P2M3_VirTimeWind].fVelocity_of_Velo:=100;
			  arrAxisCtrl[VirAxisNo.P2M3_VirTimeWind].Cmd.bMoveVelo:=TRUE;
		  END_IF
		  IF  arrAxis[VirAxisNo.P2M3_VirGM].Status.ControlLoopClosed THEN
			  arrAxisPar[VirAxisNo.P2M3_VirGM].fVelocity_of_Velo:=100;
			  arrAxisCtrl[VirAxisNo.P2M3_VirGM].Cmd.bMoveVelo:=TRUE;
		  END_IF 
		  
  END_IF


IF R_TRIG_Bt[4].Q THEN  //自动
	stSysState.FlgAuto:=TRUE;
	stSysState.FlgManua:=FALSE;
END_IF
IF R_TRIG_Bt[5].Q  OR  R_TRIG_Bt[8].Q   THEN  //手动
	stSysState.FlgAuto:=FALSE;
	stSysState.FlgManua:=TRUE;
END_IF
stSysState.bReset:=R_TRIG_Bt[7].Q  OR  bInitReset    ;  //复位

IF R_TRIG_Bt[7].Q OR stSysState.bReset THEN
	FOR i:=1 TO 159 DO
		HMI_TorAlarm_D[i]:=FALSE;
	END_FOR
END_IF

IF R_TRIG_Bt[7].Q OR stSysState.bReset THEN
	FOR i5:=1 TO 30 DO
		P2M1_MachCtrl.DT_b.Error_tips[i5]:=FALSE ;
		P2M2_MachCtrl.DT_b.Error_tips[i5]:=FALSE ; 
		P2M3_MachCtrl.DT_b.Error_tips[i5]:=FALSE ; 
	END_FOR
END_IF

(**********************************************************************************************************一号叠台面板控制********************************************************************************************)
P2M1_AutobtnR_TRIG(CLK:=P2Btn.P2M1_Autobtn , Q=> );//一号手自动切换上升沿
P2M1_AutobtnF_TRIG(CLK:=P2Btn.P2M1_Autobtn , Q=> );//一号手自动切换下降沿
IF P2M1_AutobtnR_TRIG.Q THEN
	P2M1_DTSysState.hmiAuto:=TRUE;//叠台自动标志
	P2M1_WJSysState.hmiAuto:=TRUE;//贴胶自动标志
	//P2M1_DTSysState.bwindow:=TRUE;//触发弹窗
END_IF
IF P2M1_AutobtnF_TRIG.Q THEN
	P2M1_DTSysState.hmiAuto:=FALSE;//叠台自动标志
	P2M1_WJSysState.hmiAuto:=FALSE;//贴胶自动标志
	P2M1_DTSysState.bwindow:=FALSE;//触发弹窗
END_IF

P2M1_DTSysState.bccdstate:=NOT P2M1_MachCtrl.DT_b.Error[20] AND ((NOT P2M1_Par.iModeEN.CCD_ChosesHMIEN AND 
                           NOT P2M1_Par.iModeEN.DT_CCD_TwoModelEN AND NOT P2M1_Par.iModeEN.DT_OverhangEN)OR P2M1_Par.iModeEN.EmptyRunModeEN);
P2M1_MachCtrl.DT_b.DT_Start:=(*P2M1_DTSysState.hmiStart OR*) P2Btn.P2M1_Startbtn ;//1号叠台启动
P2M1_sysControl.btn.System_Rrestbtn:=stSysState.hmiReset OR P2Btn.P2M1_Resetebtn ;//系统复位


//一号叠台
P2M1DT_R_TRIG[0](CLK:=(*P2M1_DTSysState.hmiStart OR*) P2Btn.P2M1_Startbtn , Q=> );//一号叠台自动启动
IF (*P2M1_DTSysState.hmiAuto OR*)P2Btn.P2M1_Autobtn THEN
	P2M1_DTSysState.FlgManua:=FALSE;//叠台手动标志
	P2M1_DTSysState.FlgAuto:=TRUE;//叠台自动标志
ELSE
	P2M1_DTSysState.FlgManua:=TRUE;//叠台手动标志
	P2M1_DTSysState.FlgAuto:=FALSE;//叠台自动标志	
END_IF

IF P2M1DT_R_TRIG[0].Q THEN
	IF NOT P2M1_MachCtrl.DT_b.DiaphragmPartNumberOK AND NOT P2M1_MachCtrl.DT_b.PartNumberOff THEN
		P2M1_MachCtrl.DT_b.Error_tips[1]:=TRUE ;   //叠台1隔膜料号未OK
	ELSE
		P2M1_MachCtrl.DT_b.Error_tips[1]:=FALSE ;   //叠台1隔膜料号未OK
	END_IF
	IF NOT P2M1_MachCtrl.DT_b.BluePartNumberOK AND NOT P2M1_MachCtrl.DT_b.PartNumberOff THEN
		P2M1_MachCtrl.DT_b.Error_tips[2]:=TRUE ;   //叠台1蓝胶料号未OK
	ELSE
		P2M1_MachCtrl.DT_b.Error_tips[2]:=FALSE ;   //叠台1蓝胶料号未OK
	END_IF
END_IF





//一号尾卷贴胶
//P2M1_MachCtrl.TJ_b.StickerStart_HMI:=P2M1_WJSysState.hmiStart;
P2M1WJ_R_TRIG[0](CLK:=P2M1_MachCtrl.WJ_b.TailCurlStart OR P2Btn.P2M1_Startbtn , Q=> );//一号尾尾卷自动启动
P2M1TJ_R_TRIG(CLK:=P2M1_MachCtrl.TJ_b.StickerStart_HMI OR P2Btn.P2M1_Startbtn , Q=> );//一号尾尾卷自动启动
IF P2M1_WJSysState.hmiAuto THEN
	P2M1_WJSysState.FlgManua:=FALSE;//尾卷贴胶手动标志
	P2M1_WJSysState.FlgAuto:=TRUE;//尾卷贴胶自动标志
ELSE
	P2M1_WJSysState.FlgManua:=TRUE;//尾卷贴胶手动标志
	P2M1_WJSysState.FlgAuto:=FALSE;//尾卷贴胶自动标志	
END_IF



(**********************************************************************************************************二号叠台面板控制********************************************************************************************)
P2M2_AutobtnR_TRIG(CLK:=P2Btn.P2M2_Autobtn , Q=> );//二号手自动切换上升沿
P2M2_AutobtnF_TRIG(CLK:=P2Btn.P2M2_Autobtn , Q=> );//二号手自动切换下降沿
IF P2M2_AutobtnR_TRIG.Q THEN
	P2M2_DTSysState.hmiAuto:=TRUE;//叠台自动标志
	P2M2_WJSysState.hmiAuto:=TRUE;//贴胶自动标志
	//P2M2_DTSysState.bwindow:=TRUE;//触发弹窗
END_IF
IF P2M2_AutobtnF_TRIG.Q THEN
	P2M2_DTSysState.hmiAuto:=FALSE;//叠台自动标志
	P2M2_WJSysState.hmiAuto:=FALSE;//贴胶自动标志
	P2M2_DTSysState.bwindow:=FALSE;//触发弹窗
END_IF

P2M2_DTSysState.bccdstate:=NOT P2M2_MachCtrl.DT_b.Error[20] AND ((NOT P2M2_Par.iModeEN.CCD_ChosesHMIEN AND 
                           NOT P2M2_Par.iModeEN.DT_CCD_TwoModelEN AND NOT P2M2_Par.iModeEN.DT_OverhangEN) OR P2M2_Par.iModeEN.EmptyRunModeEN);
P2M2_MachCtrl.DT_b.DT_Start:=(*P2M2_DTSysState.hmiStart OR *) P2Btn.P2M2_Startbtn;//系统启动
P2M2_sysControl.btn.System_Rrestbtn:=stSysState.hmiReset OR P2Btn.P2M2_Resetebtn ;//系统复位
//二号叠台
P2M2DT_R_TRIG[0](CLK:=(*P2M2_DTSysState.hmiStart OR*) P2Btn.P2M2_Startbtn , Q=> );//二号叠台启动
IF (*P2M2_DTSysState.hmiAuto*)P2Btn.P2M2_Autobtn THEN
	P2M2_DTSysState.FlgManua:=FALSE;//叠台手动标志
	P2M2_DTSysState.FlgAuto:=TRUE;//叠台自动标志
ELSE
	P2M2_DTSysState.FlgManua:=TRUE;//叠台手动标志
	P2M2_DTSysState.FlgAuto:=FALSE;//叠台自动标志	
END_IF
IF P2M2DT_R_TRIG[0].Q THEN
	IF NOT P2M2_MachCtrl.DT_b.DiaphragmPartNumberOK AND NOT P2M2_MachCtrl.DT_b.PartNumberOff THEN
		P2M2_MachCtrl.DT_b.Error_tips[1]:=TRUE ;   //叠台2隔膜料号未OK
	ELSE
		P2M2_MachCtrl.DT_b.Error_tips[1]:=FALSE ;   //叠台2隔膜料号未OK
	END_IF
	IF NOT P2M2_MachCtrl.DT_b.BluePartNumberOK AND NOT P2M2_MachCtrl.DT_b.PartNumberOff THEN
		P2M2_MachCtrl.DT_b.Error_tips[2]:=TRUE ;   //叠台2蓝胶料号未OK
	ELSE
		P2M2_MachCtrl.DT_b.Error_tips[2]:=FALSE ;   //叠台2蓝胶料号未OK
	END_IF
END_IF

//二号叠台尾卷贴胶
P2M2WJ_R_TRIG[0](CLK:=P2M2_MachCtrl.WJ_b.TailCurlStart OR P2Btn.P2M2_Startbtn  , Q=> );//一号尾尾卷贴胶自动启动
P2M2TJ_R_TRIG(CLK:=P2M2_MachCtrl.TJ_b.StickerStart_HMI OR P2Btn.P2M2_Startbtn , Q=> );//三号尾尾卷自动启动
IF P2M2_WJSysState.hmiAuto THEN
	P2M2_WJSysState.FlgManua:=FALSE;//尾卷贴胶手动标志
	P2M2_WJSysState.FlgAuto:=TRUE;//尾卷贴胶自动标志
ELSE
	P2M2_WJSysState.FlgManua:=TRUE;//尾卷贴胶手动标志
	P2M2_WJSysState.FlgAuto:=FALSE;//尾卷贴胶自动标志	
END_IF

(**********************************************************************************************************三号叠台面板控制********************************************************************************************)
P2M3_AutobtnR_TRIG(CLK:=P2Btn.P2M3_Autobtn , Q=> );//三号手自动切换上升沿
P2M3_AutobtnF_TRIG(CLK:=P2Btn.P2M3_Autobtn , Q=> );//三号手自动切换下降沿
IF P2M3_AutobtnR_TRIG.Q THEN
	P2M3_DTSysState.hmiAuto:=TRUE;//叠台自动标志
	P2M3_WJSysState.hmiAuto:=TRUE;//贴胶自动标志
	//P2M3_DTSysState.bwindow:=TRUE;//触发弹窗
END_IF
IF P2M3_AutobtnF_TRIG.Q THEN
	P2M3_DTSysState.hmiAuto:=FALSE;//叠台自动标志
	P2M3_WJSysState.hmiAuto:=FALSE;//贴胶自动标志
	P2M3_DTSysState.bwindow:=FALSE;//触发弹窗
END_IF

P2M3_DTSysState.bccdstate:=NOT P2M3_MachCtrl.DT_b.Error[20] AND ((NOT P2M3_Par.iModeEN.CCD_ChosesHMIEN AND 
                           NOT P2M3_Par.iModeEN.DT_CCD_TwoModelEN AND NOT P2M3_Par.iModeEN.DT_OverhangEN) OR P2M3_Par.iModeEN.EmptyRunModeEN);
P2M3_MachCtrl.DT_b.DT_Start:=(*P2M3_DTSysState.hmiStart OR *) P2Btn.P2M3_Startbtn ;//系统启动
P2M3_sysControl.btn.System_Rrestbtn:=stSysState.hmiReset OR P2Btn.P2M3_Resetebtn ;//系统复位

//三号叠台
P2M3DT_R_TRIG[0](CLK:=(*P2M3_DTSysState.hmiStart OR*) P2Btn.P2M3_Startbtn , Q=> );//三号叠台自动启动
IF (*P2M3_DTSysState.hmiAuto*)P2Btn.P2M3_Autobtn THEN
	P2M3_DTSysState.FlgManua:=FALSE;//叠台手动标志
	P2M3_DTSysState.FlgAuto:=TRUE;//叠台自动标志
ELSE
	P2M3_DTSysState.FlgManua:=TRUE;//叠台手动标志
	P2M3_DTSysState.FlgAuto:=FALSE;//叠台自动标志	
END_IF
IF P2M3DT_R_TRIG[0].Q THEN
	IF NOT P2M3_MachCtrl.DT_b.DiaphragmPartNumberOK AND NOT P2M3_MachCtrl.DT_b.PartNumberOff THEN
		P2M3_MachCtrl.DT_b.Error_tips[1]:=TRUE ;   //叠台3隔膜料号未OK
	ELSE
		P2M3_MachCtrl.DT_b.Error_tips[1]:=FALSE ;   //叠台3隔膜料号未OK
	END_IF
	IF NOT P2M3_MachCtrl.DT_b.BluePartNumberOK AND NOT P2M3_MachCtrl.DT_b.PartNumberOff THEN
		P2M3_MachCtrl.DT_b.Error_tips[2]:=TRUE ;   //叠台3蓝胶料号未OK
	ELSE
		P2M3_MachCtrl.DT_b.Error_tips[2]:=FALSE ;   //叠台3蓝胶料号未OK
	END_IF
END_IF


//三号尾卷贴胶自动启动
P2M3WJ_R_TRIG[0](CLK:=P2M3_MachCtrl.WJ_b.TailCurlStart OR P2Btn.P2M3_Startbtn  , Q=> );//三号尾尾卷自动启动
P2M3TJ_R_TRIG(CLK:=P2M3_MachCtrl.TJ_b.StickerStart_HMI OR P2Btn.P2M3_Startbtn  , Q=> );//三号尾尾卷自动启动

IF P2M3_WJSysState.hmiAuto THEN
	P2M3_WJSysState.FlgManua:=FALSE;//尾卷贴胶手动标志
	P2M3_WJSysState.FlgAuto:=TRUE;//尾卷贴胶自动标志
ELSE
	P2M3_WJSysState.FlgManua:=TRUE;//尾卷贴胶手动标志
	P2M3_WJSysState.FlgAuto:=FALSE;//尾卷贴胶自动标志	
END_IF


//TON20(IN:=stSysState.btnReset AND stSysState.btnStop , PT:=T#5S , Q=> , ET=> ); //长按复位和停止5秒系统复位

CASE iMainSetp OF 
		0:// 初始化
					Init();
					stSysState.iMode:=0;
				 IF  stSysState.bInitDone THEN
					 iMainSetp:=88;	
				  END_IF
		88:  //1号、2号、3号叠台切换手动模式
			IF P2M1_DTSysState.FlgManua AND P2Btn.P2M1_EmStopbtn1 THEN//一号叠台
				P2M1_Step0:=300;
			END_IF
			IF P2M1_WJSysState.FlgManua AND P2Btn.P2M1_EmStopbtn1 THEN//一号尾卷
				P2M1_Step1:=300;
				P2M1_Step2:=300;
			END_IF			
		
	
			IF P2M2_DTSysState.FlgManua AND P2Btn.P2M2_EmStopbtn1 THEN//二号叠台
				P2M2_Step0:=300;
			END_IF
			IF P2M2_WJSysState.FlgManua AND P2Btn.P2M2_EmStopbtn1 THEN//二号尾卷
				P2M2_Step1:=300;
				P2M2_Step2:=300;
