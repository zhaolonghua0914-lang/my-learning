P2M3_Par.Code.sRemoteHost :='192.168.10.26';
//P2M1_Par.Code.sRemotePot :=25;
P2M3_MachCtrl.DT_b.Dust_name:=3;
//电芯记忆

P2M3_MachCtrl.DT_b.DT_No:='3#';
//P2M3_MachCtrl.DT_b.Machine_No:='155AH';
P2M3_MachCtrl.DT_b.DiaphragmUnwindingTension:=arrFilter_ADV2[3].Out_Value;
P2M3_MachCtrl.DT_b.DT_Memory:=CellNo.Dietai3;
P2M3_MachCtrl.WJ_b.WJ_Memory:=CellNo.Weijuan3;
P2M3_MachCtrl.TJ_b.TJ_Memory:=CellNo.Gluing3;
P2M3_Par.stDT_date.AnMQ_MES:=AnMQ_MES3;
P2M3_Par.stDT_date.CaMQ_MES:=CaMQ_MES3;
P2M3_MachCtrl.DT_b.Put_time:=Puttime;



P2M3_MachCtrl.TJ_b.WhirlingSafe:=(arrAxisCtrl[P2AxisNo.P2M3_GluingWhirling].Status.Homed AND (arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[1]
OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[5] OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[6])) 
OR ( ( arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos>(arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[4]+10) OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos<(arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[4]-10))
     AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Homed );
	 
	 
	 
	 

//力矩保护
	P2M3_Torque.An_CarryingTorSet:=HMI_TorErrLimt_D[93];//正极搬运1移位报警力矩设定
	P2M3_Torque.An_DTCarryingTorSet:=HMI_TorErrLimt_D[96];//正极叠台搬运报警力矩值设定
	P2M3_Torque.Ca_Carrying1TorSet:=HMI_TorErrLimt_D[101];//负极搬运1平移报警力矩设定
	P2M3_Torque.Ca_Carrying2TorSet:=HMI_TorErrLimt_D[104];//负极搬运2平移报警力矩设定
	P2M3_Torque.Ca_DTCarryingTorSet:=HMI_TorErrLimt_D[107];//负极叠台搬运平移报警力矩设定
	P2M3_Torque.TailCurlTorSet:=HMI_TorErrLimt_D[123];//尾卷夹电芯平移报警力矩设定
	P2M3_Torque.TailCurlWhirlTorSet:=HMI_TorErrLimt_D[126];//尾卷夹电芯旋转报警力矩设定
	P2M3_Torque.TailCurlSEPTATorSet:=HMI_TorErrLimt_D[127];//夹膜平移旋转报警力矩设定
	//P2M3_Torque.TailCurlRetTorSet:=HMI_TorErrLimt_D[125];//尾卷夹电芯伸缩力矩设定
	
	P2M3_Torque.An_CarryingTor:=iActTorque_D[93];//正极搬运1移位实时力矩
	P2M3_Torque.An_DTCarryingTor:=iActTorque_D[96];//正极叠台搬运实时力矩
	P2M3_Torque.Ca_Carrying1Tor:=iActTorque_D[101];//负极搬运1平移实时力矩
	P2M3_Torque.Ca_Carrying2Tor:=iActTorque_D[104];//负极搬运2平移实时力矩
	P2M3_Torque.Ca_DTCarryingTor:=iActTorque_D[107];//负极叠台搬运平移实时力矩
	P2M3_Torque.TailCurlTor:=iActTorque_D[123];//尾卷夹电芯平移实时力矩
	P2M3_Torque.TailCurlWhirlTor:=iActTorque_D[126];//尾卷夹电芯旋转实时力矩
	P2M3_Torque.TailCurlSEPTATor:=iActTorque_D[127];//夹膜平移旋转实时力矩
	//P2M3_Torque.TailCurlRetTor:=iActTorque_D[125];//尾卷夹电芯伸缩实时力矩
	
	HMI_TorAlarm_D[93]:=P2M3_Torque.An_CarryingTorAlarm;//正极搬运1移位力矩超限报警
	HMI_TorAlarm_D[96]:=P2M3_Torque.An_DTCarryingTorAlarm;//正极叠台搬运力矩超限报警
	HMI_TorAlarm_D[101]:=P2M3_Torque.Ca_Carrying1TorAlarm;//负极搬运1平移力矩超限报警
	HMI_TorAlarm_D[104]:=P2M3_Torque.Ca_Carrying2TorAlarm;//负极搬运2平移力矩超限报警
	HMI_TorAlarm_D[107]:=P2M3_Torque.Ca_DTCarryingTorAlarm;//负极叠台搬运平移力矩超限报警
	HMI_TorAlarm_D[123]:=P2M3_Torque.TailCurlTorAlarm;//尾卷夹电芯平移力矩超限报警
	HMI_TorAlarm_D[126]:=P2M3_Torque.TailCurlWhirlTorAlarm;//尾卷夹电芯旋转力矩超限报警
	HMI_TorAlarm_D[127]:=P2M3_Torque.TailCurlSEPTATorAlarm;//夹膜平移旋转力矩超限报警
	//HMI_TorAlarm_D[125]:=P2M3_Torque.TailCurlRetTorAlarm;//尾卷夹电芯伸缩力矩超限报警
