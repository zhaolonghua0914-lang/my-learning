<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="IOLink" Id="{a31dc54c-6693-4026-89c2-f9762f8c620d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM IOLink
VAR
//	tFlash: TON;
//	bFlash:BOOL;
//	bIOinit: BOOL;
	XXX: INT;
	Q20815: BOOL;
	AA: INT;

     arrFilter_AD               : ARRAY[1..MaxAINo]  OF  FB_Filter_AD ;
      arrFilter_ADV2               : ARRAY[1..3]  OF  FB_Filter_ADV2 ;


    Test:BOOL;
	I1: INT;

    rt01   :Tc2_Standard.R_TRIG;
    rt02   :Tc2_Standard.R_TRIG;

     parDAOld                   :ARRAY[1..44] OF INT;   
	 q:INT;


END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[P2_InPut();

P2_OutPut();

AI();

//LimitSwitch();

P2_AutoLink();
P2M1_AutoLink();
P2M2_AutoLink();
P2M3_AutoLink();
LimitSwitch();


IF fbPulseCtrl[4].RT THEN
      AO();
END_IF
(*
//rt01(CLK:=arrCyCtrl[P3CYNo.RollPress].Cmd.bON , Q=> );
//rt02(CLK:=arrCyCtrl[P3CYNo.RollPress].Cmd.bOFF , Q=> );
IF rt01.Q THEN
    P3EL4004S[3,1]:=parDA[33]	 ;//重力补偿
  //  P3EL4004S[3,2]:=parDA[34]	 ;
END_IF
IF rt02.Q THEN
    P3EL4004S[3,1]:=22000;//重力补偿
 //   P3EL4004S[3,2]:=20000;
END_IF



*)





AA;







]]></ST>
    </Implementation>
    <Action Name="AI" Id="{3066b8ec-5c98-4636-a876-edfda9b0608e}">
      <Implementation>
        <ST><![CDATA[//1号叠片
arrFilter_AD[1].AD	:=AI30[1];	//1号叠片	隔膜卷径超声波检测
arrFilter_AD[1].iMode:=2;
arrFilter_AD[1].fPointNum:=20;

arrFilter_AD[2].AD	:=AI30[2];	//1号叠片	隔膜放卷纠偏前检测
arrFilter_AD[2].iMode:=2;
arrFilter_AD[2].fPointNum:=20;//30;

arrFilter_AD[3].AD	:=AI30[3];	//1号叠片	隔膜放卷纠偏后检测
arrFilter_AD[3].iMode:=2;
arrFilter_AD[3].fPointNum:=20;//30;

//arrFilter_AD[4].AD	:=AI30[4];//1号叠片	隔膜张力检测
arrFilter_ADV2[1].AD	:=AI30[4];//1号叠片	隔膜张力检测
arrFilter_ADV2[1].iMode:=2;
arrFilter_ADV2[1].fPointNum:=1000;
//2号叠片
arrFilter_AD[5].AD	:=ABS(AI40[1]);	//2号叠片	隔膜卷径超声波检测
arrFilter_AD[5].iMode:=2;
arrFilter_AD[5].fPointNum:=20;

arrFilter_AD[6].AD	:=ABS(AI40[2]);	//2号叠片	隔膜放卷纠偏前检测
arrFilter_AD[6].iMode:=2;
arrFilter_AD[6].fPointNum:=20;//30;

arrFilter_AD[7].AD	:=ABS(AI40[3]);	//2号叠片	隔膜放卷纠偏后检测
arrFilter_AD[7].iMode:=2;
arrFilter_AD[7].fPointNum:=20;//30;

//arrFilter_AD[8].AD	:=ABS(AI40[4]);//2号叠片	隔膜张力检测
arrFilter_ADV2[2].AD	:=ABS(AI40[4]);//2号叠片	隔膜张力检测
arrFilter_ADV2[2].iMode:=2;
arrFilter_ADV2[2].fPointNum:=1000;
//3号叠片
arrFilter_AD[9].AD	:=ABS(AI50[1]);	//3号叠片	隔膜卷径超声波检测
arrFilter_AD[9].iMode:=2;
arrFilter_AD[9].fPointNum:=20;

arrFilter_AD[10].AD	:=ABS(AI50[2]);	//3号叠片	隔膜放卷纠偏前检测
arrFilter_AD[10].iMode:=2;
arrFilter_AD[10].fPointNum:=20;//30;

arrFilter_AD[11].AD	:=ABS(AI50[3]);	//3号叠片	隔膜放卷纠偏后检测
arrFilter_AD[11].iMode:=2;
arrFilter_AD[11].fPointNum:=20;//30;

//arrFilter_AD[12].AD	:=ABS(AI50[4]);//3号叠片	隔膜张力检测
arrFilter_ADV2[3].AD	:=ABS(AI50[4]);//3号叠片	隔膜张力检测
arrFilter_ADV2[3].iMode:=2;
arrFilter_ADV2[3].fPointNum:=1000;

FOR  I1:=1 TO  12  DO//MaxAINo
	IF  I1=4  THEN
           arrFilter_ADV2[1](
			  iMode:=         , 
			  AD:=				arrFilter_ADV2[1].AD, 
			  iLimitH:=         parFilterAD[4].iLimitH  , 
			  iLimitL:=          parFilterAD[4].iLimitL   , 
			  fRangeH:=      parFilterAD[4].fRangeH , 
			  fRangeL:=       parFilterAD[4].fRangeL , 
			  fPointNum:=    , 
			  Out_Value=>    );
  ELSIF  I1=8 THEN
           arrFilter_ADV2[2](
			  iMode:=         , 
			  AD:=			    arrFilter_ADV2[2].AD, 
			  iLimitH:=         parFilterAD[8].iLimitH  , 
			  iLimitL:=          parFilterAD[8].iLimitL   , 
			  fRangeH:=      parFilterAD[8].fRangeH , 
			  fRangeL:=       parFilterAD[8].fRangeL , 
			  fPointNum:=    , 
			  Out_Value=>);
  ELSIF  I1=12 THEN
           arrFilter_ADV2[3](
			  iMode:=         , 
			  AD:=				arrFilter_ADV2[3].AD, 
			  iLimitH:=         parFilterAD[12].iLimitH  , 
			  iLimitL:=          parFilterAD[12].iLimitL   , 
			  fRangeH:=      parFilterAD[12].fRangeH , 
			  fRangeL:=       parFilterAD[12].fRangeL , 
			  fPointNum:=    , 
			  Out_Value=>);
ELSE
	  arrFilter_AD[I1](
		  iMode:=         , 
		  AD:=				arrFilter_AD[I1].AD               , 
		  iLimitH:=         parFilterAD[I1].iLimitH  , 
		  iLimitL:=          parFilterAD[I1].iLimitL   , 
		  fRangeH:=      parFilterAD[I1].fRangeH , 
		  fRangeL:=       parFilterAD[I1].fRangeL , 
		  fPointNum:=    , 
		  Out_Value=>);
END_IF

END_FOR
//一号叠台
//P2M1_MachCtrl.DT_b.fWindDiameter:=arrFilter_AD[1].Out_Value;
P2M1_MachCtrl.DT_b.RecDevPV:=arrFilter_AD[2].Out_Value;
P2M1_MachCtrl.DT_b.RecDevPV1:=arrFilter_AD[3].Out_Value;
P2M1_MachCtrl.DT_b.TenAnglePos:=LREAL_TO_REAL(arrAxis[P2M1_Axise.AxisName.SEPTATension].NcToPlc.ActPos);	
P2M1_Par.stDT_date.fRectifyMaxValue:= parFilterAD[2].fRangeH;
P2M1_Par.stDT_date.fRectifyMinValue:=parFilterAD[2].fRangeL;
arrFilter_ADV2[1].Out_Value;

//二号叠台
//P2M2_MachCtrl.DT_b.fWindDiameter:=arrFilter_AD[5].Out_Value;
P2M2_MachCtrl.DT_b.RecDevPV:=arrFilter_AD[6].Out_Value;
P2M2_MachCtrl.DT_b.RecDevPV1:=arrFilter_AD[7].Out_Value;
P2M2_MachCtrl.DT_b.TenAnglePos:=LREAL_TO_REAL(arrAxis[P2M2_Axise.AxisName.SEPTATension].NcToPlc.ActPos);	//2号叠片	隔膜张力检测;
P2M2_Par.stDT_date.fRectifyMaxValue:= parFilterAD[6].fRangeH;
P2M2_Par.stDT_date.fRectifyMinValue:=parFilterAD[6].fRangeL;
arrFilter_ADV2[2].Out_Value;
//三号叠台
//P2M3_MachCtrl.DT_b.fWindDiameter:=arrFilter_AD[9].Out_Value;
P2M3_MachCtrl.DT_b.RecDevPV:=arrFilter_AD[10].Out_Value;
P2M3_MachCtrl.DT_b.RecDevPV1:=arrFilter_AD[11].Out_Value;
P2M3_MachCtrl.DT_b.TenAnglePos:=LREAL_TO_REAL(arrAxis[P2M3_Axise.AxisName.SEPTATension].NcToPlc.ActPos);	//3号叠片	隔膜张力检测
P2M3_Par.stDT_date.fRectifyMaxValue:= parFilterAD[10].fRangeH;
P2M3_Par.stDT_date.fRectifyMinValue:=parFilterAD[10].fRangeL;
arrFilter_ADV2[3].Out_Value;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="AO" Id="{e0afcd14-2c13-4243-a1ac-4ecb59a4e3c7}">
      <Implementation>
        <ST><![CDATA[;]]></ST>
      </Implementation>
    </Action>
    <Action Name="LimitSwitch" Id="{3b1dd21a-6ecf-4887-aef4-8c3e09e356c7}">
      <Implementation>
        <ST><![CDATA[
//1号叠台
arrAxisCtrl[P2AxisNo.P2M1_AnCarryingLine].Io.DigitalInputs;//一号叠台正极搬运平移//直线电机
arrAxisCtrl[P2AxisNo.P2M1_AnCarryingLine].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_AnCarryingLine].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_AnCarryingLine].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_AnCarryingLine].Io.DigitalInputs.18;
arrAxisCtrl[P2AxisNo.P2M1_AnCarryingLine].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_AnCarryingLine].Io.DigitalInputs.20;

arrAxisCtrl[P2AxisNo.P2M1_AnCarryingUpDown].Io.DigitalInputs;//一号叠台正极送片搬运升降
arrAxisCtrl[P2AxisNo.P2M1_AnCarryingUpDown].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_AnCarryingUpDown].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_AnCarryingUpDown].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_AnCarryingUpDown].Io.DigitalInputs.2;
arrAxisCtrl[P2AxisNo.P2M1_AnCarryingUpDown].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_AnCarryingUpDown].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_AnCarryingWhirling].Io.DigitalInputs;//一号叠台正极搬运旋转
arrAxisCtrl[P2AxisNo.P2M1_AnCarryingWhirling].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_AnCarryingWhirling].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_AnCarryingWhirling].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_AnCarryingWhirling].Io.DigitalInputs.2;
arrAxisCtrl[P2AxisNo.P2M1_AnCarryingWhirling].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_AnCarryingWhirling].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_AndeviationX1].Io.DigitalInputs;//一号叠台正极纠偏平台X1
arrAxisCtrl[P2AxisNo.P2M1_AndeviationX1].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_AndeviationX1].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_AndeviationX1].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_AndeviationX1].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_AndeviationX1].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_AndeviationX1].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_AndeviationX2].Io.DigitalInputs;//一号叠台正极纠偏平台X2
arrAxisCtrl[P2AxisNo.P2M1_AndeviationX2].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_AndeviationX2].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_AndeviationX2].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_AndeviationX2].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_AndeviationX2].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_AndeviationX2].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_AndeviationY].Io.DigitalInputs;//一号叠台正极纠偏平台Y
arrAxisCtrl[P2AxisNo.P2M1_AndeviationY].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_AndeviationY].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_AndeviationY].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_AndeviationY].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_AndeviationY].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_AndeviationY].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingLine].Io.DigitalInputs;//一号叠台正极搬运平移1//直线电机
arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingLine].Io.biPosLimit:=  arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingLine].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingLine].Io.biNegLimit:=   arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingLine].Io.DigitalInputs.18;
arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingLine].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingLine].Io.DigitalInputs.20;

arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingUpDown].Io.DigitalInputs;//一号叠台正极搬运升降
arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingUpDown].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingUpDown].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingUpDown].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingUpDown].Io.DigitalInputs.2;
arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingUpDown].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_AnDTCarryingUpDown].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_CaBelt].Io.DigitalInputs;//一号叠台正极送片皮带
//arrAxisCtrl[P2AxisNo.P2M1_CaBelt].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_CaBelt].Io.DigitalInputs.16;
//arrAxisCtrl[P2AxisNo.P2M1_CaBelt].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CaBelt].Io.DigitalInputs.17;
//arrAxisCtrl[P2AxisNo.P2M1_CaBelt].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CaBelt].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine1].Io.DigitalInputs;//一号叠台负极搬运平移1//直线电机
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine1].Io.biPosLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine1].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine1].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine1].Io.DigitalInputs.18;
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine1].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine1].Io.DigitalInputs.20;

arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine2].Io.DigitalInputs;//一号叠台负极搬运平移2//直线电机
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine2].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine2].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine2].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine2].Io.DigitalInputs.18;
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine2].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CaCarryingLine2].Io.DigitalInputs.20;

arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown1].Io.DigitalInputs;//一号叠台负极送片搬运1升降
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown1].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown1].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown1].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown1].Io.DigitalInputs.2;
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown1].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown1].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown2].Io.DigitalInputs;//一号叠台负极送片搬运2升降
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown2].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown2].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown2].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown2].Io.DigitalInputs.2;
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown2].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CaCarryingUpDown2].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_CaCarryingWhirling1].Io.DigitalInputs;//一号叠台负极送片搬运1旋转
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingWhirling1].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_CaCarryingWhirling1].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingWhirling1].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CaCarryingWhirling1].Io.DigitalInputs.2;
arrAxisCtrl[P2AxisNo.P2M1_CaCarryingWhirling1].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CaCarryingWhirling1].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_CadeviationX1].Io.DigitalInputs;//一号叠台负极纠偏平台X1
arrAxisCtrl[P2AxisNo.P2M1_CadeviationX1].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_CadeviationX1].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_CadeviationX1].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CadeviationX1].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_CadeviationX1].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CadeviationX1].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_CadeviationX2].Io.DigitalInputs;//一号叠台负极纠偏平台X2
arrAxisCtrl[P2AxisNo.P2M1_CadeviationX2].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_CadeviationX2].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_CadeviationX2].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CadeviationX2].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_CadeviationX2].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CadeviationX2].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_CadeviationY].Io.DigitalInputs;//一号叠台负极纠偏平台Y
arrAxisCtrl[P2AxisNo.P2M1_CadeviationY].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_CadeviationY].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_CadeviationY].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CadeviationY].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_CadeviationY].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CadeviationY].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingLine].Io.DigitalInputs;//一号叠台负极搬运平移//直线电机
arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingLine].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingLine].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingLine].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingLine].Io.DigitalInputs.18;
arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingLine].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingLine].Io.DigitalInputs.20;

arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingUpDown].Io.DigitalInputs;//一号叠台负极叠片搬运升降
arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingUpDown].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingUpDown].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingUpDown].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingUpDown].Io.DigitalInputs.2;
arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingUpDown].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_CaDTCarryingUpDown].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_DTUpDown].Io.DigitalInputs;//一号叠台升降
arrAxisCtrl[P2AxisNo.P2M1_DTUpDown].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_DTUpDown].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_DTUpDown].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_DTUpDown].Io.DigitalInputs.2;
arrAxisCtrl[P2AxisNo.P2M1_DTUpDown].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_DTUpDown].Io.DigitalInputs.2;


////////////////////////////////////
arrAxisCtrl[P2AxisNo.P2M1_GluingLine].Io.DigitalInputs;//一号叠台侧胶夹平移
arrAxisCtrl[P2AxisNo.P2M1_GluingLine].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_GluingLine].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_GluingLine].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_GluingLine].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_GluingLine].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_GluingLine].Io.DigitalInputs.2;

arrAxisCtrl[P2AxisNo.P2M1_GluingRetracting].Io.DigitalInputs;//一号叠台贴胶头进退
arrAxisCtrl[P2AxisNo.P2M1_GluingRetracting].Io.biPosLimit:= arrAxisCtrl[P2AxisNo.P2M1_GluingRetracting].Io.DigitalInputs.16;
arrAxisCtrl[P2AxisNo.P2M1_GluingRetracting].Io.biNegLimit:=  arrAxisCtrl[P2AxisNo.P2M1_GluingRetracting].Io.DigitalInputs.17;
arrAxisCtrl[P2AxisNo.P2M1_GluingRetracting].Io.biHomeSwitch:=arrAxisCtrl[P2AxisNo.P2M1_GluingRetracting].Io.DigitalInputs.2;

