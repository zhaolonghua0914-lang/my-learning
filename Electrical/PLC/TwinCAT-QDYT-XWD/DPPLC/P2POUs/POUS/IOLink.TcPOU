	P2M1_Torque.TailCurlWhirlTorSet:=HMI_TorErrLimt_D[34];//尾卷夹电芯旋转报警力矩设定
	P2M1_Torque.TailCurlSEPTATorSet:=HMI_TorErrLimt_D[35];//夹膜平移旋转报警力矩设定
	//P2M1_Torque.TailCurlRetTorSet:=HMI_TorErrLimt_D[33];//尾卷夹电芯伸缩力矩设定
	
	P2M1_Torque.An_CarryingTor:=iActTorque_D[1];//正极搬运1移位实时力矩
	P2M1_Torque.An_DTCarryingTor:=iActTorque_D[4];//正极叠台搬运实时力矩
	P2M1_Torque.Ca_Carrying1Tor:=iActTorque_D[9];//负极搬运1平移实时力矩
	P2M1_Torque.Ca_Carrying2Tor:=iActTorque_D[12];//负极搬运2平移实时力矩
	P2M1_Torque.Ca_DTCarryingTor:=iActTorque_D[15];//负极叠台搬运平移实时力矩
	P2M1_Torque.TailCurlTor:=iActTorque_D[31];//尾卷夹电芯平移实时力矩
	P2M1_Torque.TailCurlWhirlTor:=iActTorque_D[34];//尾卷夹电芯旋转实时力矩
	P2M1_Torque.TailCurlSEPTATor:=iActTorque_D[35];//夹膜平移旋转实时力矩
	//P2M1_Torque.TailCurlRetTor:=iActTorque_D[33];//尾卷夹电芯伸缩实时力矩
	
	HMI_TorAlarm_D[1]:=P2M1_Torque.An_CarryingTorAlarm;//正极搬运1移位力矩超限报警
	HMI_TorAlarm_D[4]:=P2M1_Torque.An_DTCarryingTorAlarm;//正极叠台搬运力矩超限报警
	HMI_TorAlarm_D[9]:=P2M1_Torque.Ca_Carrying1TorAlarm;//负极搬运1平移力矩超限报警
	HMI_TorAlarm_D[12]:=P2M1_Torque.Ca_Carrying2TorAlarm;//负极搬运2平移力矩超限报警
	HMI_TorAlarm_D[15]:=P2M1_Torque.Ca_DTCarryingTorAlarm;//负极叠台搬运平移力矩超限报警
	HMI_TorAlarm_D[31]:=P2M1_Torque.TailCurlTorAlarm;//尾卷夹电芯平移力矩超限报警
	HMI_TorAlarm_D[34]:=P2M1_Torque.TailCurlWhirlTorAlarm;//尾卷夹电芯旋转力矩超限报警
	HMI_TorAlarm_D[35]:=P2M1_Torque.TailCurlSEPTATorAlarm;//夹膜平移旋转力矩超限报警
