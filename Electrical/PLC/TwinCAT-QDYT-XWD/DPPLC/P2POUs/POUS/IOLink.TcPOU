OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[5] OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[6])) 
OR ( ( arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos>(arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[2]+10) OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos<(arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[2]-10))
     AND arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.Homed );
	 
	 
//力矩保护
	P2M1_Torque.An_CarryingTorSet:=HMI_TorErrLimt_D[1];//正极搬运1移位报警力矩设定
	P2M1_Torque.An_DTCarryingTorSet:=HMI_TorErrLimt_D[4];//正极叠台搬运报警力矩值设定
