 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.GoPoint_Condition[6]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.GoPoint_Condition[6]:=FALSE;	
