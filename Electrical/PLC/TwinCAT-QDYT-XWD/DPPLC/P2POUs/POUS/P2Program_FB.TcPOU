IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.GoPoint_Condition[1]:=TRUE;
