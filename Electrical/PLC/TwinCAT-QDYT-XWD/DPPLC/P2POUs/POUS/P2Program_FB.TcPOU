    <Action Name="P2_Init" Id="{16af0b7d-bde0-4a33-b066-e793414cc290}" FolderPath="08Init\">
      <Implementation>
        <ST><![CDATA[//上电初始化
	CASE Mach_Control.U.Step[0] OF 
			0://等待上电初始化启动
				IF Mach_Control.U.P2Init AND NOT Mach_Control.U.P2InitDone THEN
					Mach_Control.U.Step[0] :=10;
				END_IF
			10://气缸类型初始化,气控阀类型初始化
					//气缸类型初始化
					arrCyCtrl[arrCyNo.CylinderName.	AnScrapbinCy		].Cmd.iType:=	1	;//	正极片NG收纳盒
					arrCyCtrl[arrCyNo.CylinderName.	CaScrapbinCy		].Cmd.iType:=	1	;//	负极片NG收纳盒
					arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy		].Cmd.iType:=	1	;//	负极片NG收纳盒升降
					arrCyCtrl[arrCyNo.CylinderName.	PoleInflationCy		].Cmd.iType:=	3	;//	隔膜放卷气胀轴
					arrCyCtrl[arrCyNo.CylinderName.	PoleTapeSplicerLCy		].Cmd.iType:=	1	;//	隔膜接带左压板气缸
					arrCyCtrl[arrCyNo.CylinderName.	PoleTapeSplicerRCy		].Cmd.iType:=	1	;//	隔膜接带右压板气缸
					arrCyCtrl[arrCyNo.CylinderName.PreDiaph		].Cmd.iType:=	1	;//	叠台压隔膜气缸
					arrCyCtrl[arrCyNo.CylinderName.	PoleTapeCy		].Cmd.iType:=	1	;//	隔膜夹紧气缸
					arrCyCtrl[arrCyNo.CylinderName.	PoleHotCutterCy		].Cmd.iType:=	1	;//	隔膜热切升降
					arrCyCtrl[arrCyNo.CylinderName.	PoleSplintCy_U		].Cmd.iType:=	1	;//	夹膜上夹板
					arrCyCtrl[arrCyNo.CylinderName.	PoleSplintCy_D		].Cmd.iType:=	1	;//	夹膜下夹板
					arrCyCtrl[arrCyNo.CylinderName.	TailCurlSplintCy		].Cmd.iType:=	1	;//	尾卷夹爪开合
					arrCyCtrl[arrCyNo.CylinderName.	CurlingSplintCy_L		].Cmd.iType:=	3	;//	长卷针夹开合
					arrCyCtrl[arrCyNo.CylinderName.	CurlingSplintCy_S		].Cmd.iType:=	3	;//	短卷针夹开合
					//arrCyCtrl[arrCyNo.CylinderName.	CurlingSplintCy_S_1		].Cmd.iType:=	2	;//	短卷针夹开合_1
					arrCyCtrl[arrCyNo.CylinderName.	TailCurlLineCy		].Cmd.iType:=	1	;//	尾卷压辊平移缸
					arrCyCtrl[arrCyNo.CylinderName.	TailCurlUpdownCy		].Cmd.iType:=	1	;//	尾卷压辊升降缸
					arrCyCtrl[arrCyNo.CylinderName.	StandbyGlueCy		].Cmd.iType:=	2	;//	备胶气缸
					arrCyCtrl[arrCyNo.CylinderName.	CodeStandbyGlueCy		].Cmd.iType:=	2	;//	备二维码胶气缸
					arrCyCtrl[arrCyNo.CylinderName.	GlueClampsCy		].Cmd.iType:=	1	;//	贴胶夹爪气缸
					arrCyCtrl[arrCyNo.CylinderName.	GluePressCy		].Cmd.iType:=	1	;//	压胶气缸
					arrCyCtrl[arrCyNo.CylinderName.	CodeGluePressCy		].Cmd.iType:=	1	;//	压二维码胶气缸
					arrCyCtrl[arrCyNo.CylinderName.	GlueCutCy		].Cmd.iType:=	1	;//	切胶气缸
					arrCyCtrl[arrCyNo.CylinderName.	codeGlueCutCy		].Cmd.iType:=	1	;//	切二维码胶气缸
					arrCyCtrl[arrCyNo.CylinderName.	PullGluePoleCy		].Cmd.iType:=	4	;//	拉胶杆抱紧
					arrCyCtrl[arrCyNo.CylinderName.	PullGlueCy		].Cmd.iType:=	1	;//	拉胶气缸
					arrCyCtrl[arrCyNo.CylinderName.	GlueNGCy		].Cmd.iType:=	1	;//	踢废胶气缸
					arrCyCtrl[arrCyNo.CylinderName.	PullGlueModelCy		].Cmd.iType:=	1	;//	贴胶治具气缸
					//气控阀类型初始化				
					arrCyCtrl[arrCyNo.ElectValveName.	AnBeltVacuum		].Cmd.iType:=	4	;//	正极模切送料分段皮带1取料处真空
					arrCyCtrl[arrCyNo.ElectValveName.	AnBeltVacuumBark		].Cmd.iType:=	4	;//	正极模切送料分段皮带1取料处破真空
					arrCyCtrl[arrCyNo.ElectValveName.	CaMQBeltVacuum		].Cmd.iType:=	4	;//	负极模切送料分段皮带1取料处真空
					arrCyCtrl[arrCyNo.ElectValveName.	CaMQBeltVacuumBark		].Cmd.iType:=	4	;//	负极模切送料分段皮带1取料处破真空
					arrCyCtrl[arrCyNo.ElectValveName.	AnCarryingVacuum		].Cmd.iType:=	4	;//	正极送片搬运升降真空
					arrCyCtrl[arrCyNo.ElectValveName.	AnCarryingVacuumBark		].Cmd.iType:=	4	;//	正极送片搬运升降破真空
					arrCyCtrl[arrCyNo.ElectValveName.	AndeviationVacuum		].Cmd.iType:=	4	;//	正极纠偏平台真空
					arrCyCtrl[arrCyNo.ElectValveName.	AndeviationIonizedWind		].Cmd.iType:=	4	;//	正极纠偏平台除尘风刀
					arrCyCtrl[arrCyNo.ElectValveName.	AndeviationVacuumBark		].Cmd.iType:=	4	;//	正极纠偏平台破真空
					arrCyCtrl[arrCyNo.ElectValveName.	AnDTCarryingVacuum		].Cmd.iType:=	4	;//	正极叠片搬运升降真空
					//arrCyCtrl[arrCyNo.ElectValveName.	AnDTCarryingJRVacuum		].Cmd.iType:=	4	;//	正极叠台搬运升降极耳真空
					arrCyCtrl[arrCyNo.ElectValveName.	AnDTCarryingVacuumBark		].Cmd.iType:=	4	;//	正极叠片搬运升降破真空
					arrCyCtrl[arrCyNo.ElectValveName.	CaCarryingVacuum1		].Cmd.iType:=	4	;//	负极送片搬运升降1真空
					arrCyCtrl[arrCyNo.ElectValveName.	CaCarryingVacuumBark1		].Cmd.iType:=	4	;//	负极送片搬运升降1破真空
					arrCyCtrl[arrCyNo.ElectValveName.	CaLoadUpBeltVacuum		].Cmd.iType:=	4	;//	负极送片皮带末端真空
					arrCyCtrl[arrCyNo.ElectValveName.	CaLoadUpBeltVacuumBark		].Cmd.iType:=	4	;//	负极送片皮带末端破真空
					arrCyCtrl[arrCyNo.ElectValveName.	CaCarryingVacuum2		].Cmd.iType:=	4	;//	负极送片搬运升降2真空
					arrCyCtrl[arrCyNo.ElectValveName.	CaCarryingVacuumBark2		].Cmd.iType:=	4	;//	负极送片搬运升降2破真空
					arrCyCtrl[arrCyNo.ElectValveName.	CadeviationVacuum		].Cmd.iType:=	4	;//	负极纠偏平台真空
					arrCyCtrl[arrCyNo.ElectValveName.	CadeviationVacuumBark		].Cmd.iType:=	4	;//	负极纠偏平台破真空
					arrCyCtrl[arrCyNo.ElectValveName.	CadeviationIonizedWind		].Cmd.iType:=	4	;//	负极纠偏平台除尘风刀
					arrCyCtrl[arrCyNo.ElectValveName.	CaDTCarryingVacuum		].Cmd.iType:=	4	;//	负极叠片搬运升降真空
					//arrCyCtrl[arrCyNo.ElectValveName.	CaDTCarryingJRVacuum		].Cmd.iType:=	4	;//	负极叠片搬运升降极耳真空
					arrCyCtrl[arrCyNo.ElectValveName.	CaDTCarryingVacuumBark		].Cmd.iType:=	4	;//	负极叠片搬运升降破真空
					arrCyCtrl[arrCyNo.ElectValveName.	PoleTapeDustRemoval		].Cmd.iType:=	4	;//	隔膜接带平台除尘
					arrCyCtrl[arrCyNo.ElectValveName.	PoleTapeVacuum		].Cmd.iType:=	4	;//	隔膜接带平台真空
					arrCyCtrl[arrCyNo.ElectValveName.	BlueGlueVacuum1		].Cmd.iType:=	4	;//	备胶组件蓝胶真空1
					arrCyCtrl[arrCyNo.ElectValveName.	BlueGlueVacuum2		].Cmd.iType:=	4	;//	备胶组件蓝胶真空2
					arrCyCtrl[arrCyNo.ElectValveName.	codeGlueVacuum1		].Cmd.iType:=	4	;//	备胶组件二维码胶真空1
					arrCyCtrl[arrCyNo.ElectValveName.	codeGlueVacuum2		].Cmd.iType:=	4	;//	备胶组件二维码胶真空2
					arrCyCtrl[arrCyNo.ElectValveName.	PastesGlueVacuum		].Cmd.iType:=	4	;//	备胶组件贴胶头真空
					arrCyCtrl[arrCyNo.ElectValveName.	DTVacuum		].Cmd.iType:=	4	;//	叠片台真空
					arrCyCtrl[arrCyNo.ElectValveName.	PoleSplintVacuum_D		].Cmd.iType:=	4	;//	夹膜下夹板真空
					arrCyCtrl[arrCyNo.ElectValveName.WJ_blow		].Cmd.iType:=	4	;//	夹电芯吹气
					arrCyCtrl[arrCyNo.ElectValveName.WJShortvacuum		].Cmd.iType:=	4	;//短卷针张开真空
					//屏蔽初赋值					
					Mach_Control.U.Step[0] :=20;
					
			20://计算从左到右、从右到左移动时隔膜变化量
					CaCrectCamStep0:=10;//负极取片凸轮创建
					AnCrectCamStep0:=10;//正极取片凸轮创建
					YDCrectCamStep0:=10;//叠台压刀凸轮创建
					GMCreatCamStep0:=10;//叠台缓存凸轮创建
					WZCreatCamStep0:=10;//尾卷凸轮创建
					Mach_Control.U.Step[0] :=30;
			30://判断隔膜变数据是否完成
					IF CaCrectCamStep0=6666 AND AnCrectCamStep0=6666 AND YDCrectCamStep0=6666 AND  GMCreatCamStep0=6666 AND WZCreatCamStep0=6666 THEN
						Mach_Control.U.Step[0] :=40;
					END_IF;
			40:
				arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Cmd.bON:=TRUE;
				Mach_Control.U.P2Init :=FALSE;//复位上电初始化完成
				Mach_Control.U.P2InitDone:=TRUE;//置位上电初始化完成
				Mach_Control.U.Step[0] :=0;
	END_CASE

	arrCyCtrl[arrCyNo.ElectValveName.	CaCarryingVacuumBark2		].Cmd.bON;
	
	
	
	
	
	]]></ST>
      </Implementation>
    </Action>
    <Action Name="Stick_Condition" Id="{6d491691-6dcf-4533-adc2-8f59ccef7d7a}" FolderPath="05StickGlue \">
      <Implementation>
        <ST><![CDATA[//贴胶平移，贴胶旋转轴移动允许  AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.fSetPos>=arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[1]+0.2 AND arrAxisPar[AxiseNo.AxisName.TailCurlWhirling].arrTargetPoint[1] 
IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed 
AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving 
AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[1] 
AND  ((arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.fSetPos>=arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[1]-1 AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.TailCurlRetracting].arrTargetPoint[1]+1) OR
		 arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1]  )
AND  ((DTselect=1 AND (arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos <=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[2]-300 OR 
            arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos >=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[2]+300)) OR    
         (DTselect=2 AND (arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos <=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[3]-300 OR 
			 arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos >=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[3]+300)) OR
		 (DTselect=3 AND (arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos <=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[4]-300 OR 
			 arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos >=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[4]+300))  OR 
		( arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[1] OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[5] OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[6]) )
(*AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed 
AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] 
AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed 
AND(((arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.fSetPos>= (arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[1]-1) 
AND (arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] 
OR arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[3] 
OR  arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[4])) 
OR((arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.fSetPos>= (arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[5]-1)) 
AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[2])))*)    THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[0]:=TRUE;
	GluingLineagree:=TRUE;//侧贴胶平移轴、侧贴胶旋转轴动作允许
ELSE
	GluingLineagree:=FALSE;
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[0]:=FALSE;
END_IF


//贴胶旋转轴移动允许
IF GluingLineagree THEN
	GluingWhirlingagree:=TRUE;//侧贴胶平移轴、侧贴胶旋转轴动作允许
ELSE
	GluingWhirlingagree:=FALSE;
END_IF


Mach_Control.TJ_b.WhirlingSafe:=(*arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving
                        AND*) arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[1]
						AND (arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.fActPos <= (arrAxisPar[AxiseNo.AxisName.GluingLine].arrTargetPoint[10]+1)) AND
                         ((DTselect=1 AND (arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos <=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[2]-300 OR 
                              arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos >=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[2]+300)) OR
						(DTselect=2 AND (arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos <=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[3]-300 OR 
													  arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos >=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[3]+300)) OR
						(DTselect=3 AND (arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos <=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[4]-300 OR 
													  arrAxisCtrl[P3AxisNo.P3M1_ColdpreLine].Status.fActPos >=  arrAxisPar[P3AxisNo.P3M1_ColdpreLine].arrTargetPoint[4]+300))  OR 
						 ( arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[1] OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[5] OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[6]) );

					//AND (arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.fSetPos >= (arrAxisPar[AxiseNo.AxisName.GluingLine].arrTargetPoint[10]-1));

//侧贴胶平移运动允许
arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[0]:=GluingLineagree OR Mach_Control.TJ_b.AxisConditionEN ;
arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[1]:=GluingLineagree OR Mach_Control.TJ_b.AxisConditionEN ;
//侧贴胶旋转运动允许
arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.GoPoint_Condition[0]:=GluingLineagree OR Mach_Control.TJ_b.AxisConditionEN ;
arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.GoPoint_Condition[1]:=GluingLineagree OR Mach_Control.TJ_b.AxisConditionEN ;


//侧贴胶平移、旋转在下料位，侧贴胶夹爪气缸张开，允许尾卷下电芯
IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[1] AND 
	 arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[1] AND
	arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Io.DIOnSwitch THEN
	Mach_Control.TJ_b.Stickerragree:=TRUE;	
ELSE
	Mach_Control.TJ_b.Stickerragree:=FALSE;		
END_IF
//贴胶完成，允许冷压取电芯
IF Mach_Control.TJ_b.StickerDone AND Mach_Control.TJ_b.StickerFlag AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[2]  THEN
	Mach_Control.TJ_b.StickerOffloading:=TRUE;
ELSE
	Mach_Control.TJ_b.StickerOffloading:=FALSE; 	
END_IF
//拉胶在安全位，允许贴胶头前进、后退
IF arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving AND 
	(arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.fActPos<= arrAxisPar[AxiseNo.AxisName.GluingUpDown].arrTargetPoint[4] OR
	arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.fActPos>= arrAxisPar[AxiseNo.AxisName.GluingUpDown].arrTargetPoint[2]) 
	AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
	GluingRetractingagree:=TRUE;//贴胶头前进轴动作允许
ELSE
	GluingRetractingagree:=FALSE;
END_IF

arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.GoPoint_Condition[0]:=GluingRetractingagree OR Mach_Control.TJ_b.AxisConditionEN ;
arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.GoPoint_Condition[1]:=GluingRetractingagree OR Mach_Control.TJ_b.AxisConditionEN ;
arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.GoPoint_Condition[2]:=GluingRetractingagree OR Mach_Control.TJ_b.AxisConditionEN ;
arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.GoPoint_Condition[3]:=GluingRetractingagree OR Mach_Control.TJ_b.AxisConditionEN ;
arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.GoPoint_Condition[4]:=GluingRetractingagree OR Mach_Control.TJ_b.AxisConditionEN ;
arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.GoPoint_Condition[5]:=GluingRetractingagree OR Mach_Control.TJ_b.AxisConditionEN ;
//拉胶升降允许动作
IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed AND 
	arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.fActPos<= arrAxisPar[AxiseNo.AxisName.GluingRetracting].arrTargetPoint[1]+0.2 AND 
	arrCyCtrl[arrCyNo.CylinderName.codeGlueCutCy].Status.ONState AND
	arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Status.ONState AND
	arrCyCtrl[arrCyNo.CylinderName.GlueNGCy].Status.OFFState AND 
	arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Status.ONState  THEN
	GluingUpDownagree:=TRUE; 
ELSE
	GluingUpDownagree:=false;	
END_IF
arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[1]:=GluingUpDownagree OR Mach_Control.TJ_b.AxisConditionEN ;	
arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[2]:=GluingUpDownagree OR Mach_Control.TJ_b.AxisConditionEN ;	
arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[3]:=GluingUpDownagree OR Mach_Control.TJ_b.AxisConditionEN ;	
arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[4]:=GluingUpDownagree OR Mach_Control.TJ_b.AxisConditionEN ;	
arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[5]:=GluingUpDownagree OR Mach_Control.TJ_b.AxisConditionEN ;	
arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[6]:=GluingUpDownagree OR Mach_Control.TJ_b.AxisConditionEN ;	
arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[7]:=GluingUpDownagree OR Mach_Control.TJ_b.AxisConditionEN ;	
arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[8]:=GluingUpDownagree OR Mach_Control.TJ_b.AxisConditionEN ;	


//气缸条件
IF arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Status.OFFState  THEN
	arrCyCtrl[arrCyNo.CylinderName.GlueNGCy].Cmd.OnCondition:=TRUE;
ELSE
	arrCyCtrl[arrCyNo.CylinderName.GlueNGCy].Cmd.OnCondition:=FALSE;
END_IF

/////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////
////////////////////////////////////////////电机条件
//侧贴胶平移
IF  Mach_Control.U.WJ_iMode=3 
  AND GluingLineagree
 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 
AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed 
AND GluingLineagree
 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 
AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed 
AND GluingLineagree
 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 
AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed 
AND GluingLineagree
 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[3]:=FALSE;	
