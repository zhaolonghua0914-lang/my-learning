    <Action Name="TorqueCheckAlarm" Id="{9368cef5-7da8-49c8-ad73-37958a5fcbe1}" FolderPath="09Manual\">
      <Implementation>
        <ST><![CDATA[//力矩超限报警断使能
	IF 	Ca_Carrying1TorMark THEN//负极搬运1平移力矩判断标志位
		 IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Moving AND (ABS(Torque.Ca_Carrying1Tor)>=Torque.Ca_Carrying1TorSet)  THEN
			Torque.Ca_Carrying1TorAlarm:=TRUE;
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.bEnable:=FALSE;
			//Ca_Carrying1TorMark:=FALSE;
			//Step_InitCaDT:=0;
		END_IF
	END_IF
	IF ABS(Torque.Ca_Carrying1Tor)<Torque.Ca_Carrying1TorSet AND Sys_Control.btn.System_Rrestbtn THEN
		Torque.Ca_Carrying1TorAlarm:=FALSE;
	END_IF
	
	IF 	Ca_Carrying2TorMark THEN//负极搬运2平移力矩判断标志位
		 IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Moving AND (ABS(Torque.Ca_Carrying2Tor)>=Torque.Ca_Carrying2TorSet)  THEN
			Torque.Ca_Carrying2TorAlarm:=TRUE;
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bEnable:=FALSE;
			//Ca_Carrying2TorMark:=FALSE;
			//Step_InitCaDT:=0;
		END_IF
	END_IF
	IF ABS(Torque.Ca_Carrying2Tor)<Torque.Ca_Carrying2TorSet AND Sys_Control.btn.System_Rrestbtn THEN
		Torque.Ca_Carrying2TorAlarm:=FALSE;
	END_IF
	
	IF 	Ca_DTCarryingTorMark THEN//负极叠台搬运平移力矩判断标志位	
		 IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Moving AND (ABS(Torque.Ca_DTCarryingTor)>=Torque.Ca_DTCarryingTorSet)  THEN
			Torque.Ca_DTCarryingTorAlarm:=TRUE;
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bEnable:=FALSE;
			//Ca_DTCarryingTorMark:=FALSE;
			//Step_InitCaDT:=0;
		END_IF
	END_IF
	IF ABS(Torque.Ca_DTCarryingTor)<Torque.Ca_DTCarryingTorSet AND Sys_Control.btn.System_Rrestbtn THEN
		Torque.Ca_DTCarryingTorAlarm:=FALSE;
	END_IF	

//力矩超限报警断使能
	IF 	An_CarryingTorMark THEN//正极搬运1移位力矩判断标志位
		 IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Moving AND (ABS(Torque.An_CarryingTor)>=Torque.An_CarryingTorSet)  THEN
			Torque.An_CarryingTorAlarm:=TRUE;
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bEnable:=FALSE;
			//An_CarryingTorMark:=FALSE;//正极搬运1移位力矩判断标志位
			//Step_InitAnDT:=0;
		END_IF
	END_IF
	IF ABS(Torque.An_CarryingTor)<Torque.An_CarryingTorSet AND Sys_Control.btn.System_Rrestbtn THEN
		Torque.An_CarryingTorAlarm:=FALSE;
	END_IF
	
	IF 	An_DTCarryingTorMark THEN//正极叠台搬运力矩判断标志位	
		 IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Moving AND (ABS(Torque.An_DTCarryingTor)>=Torque.Ca_Carrying1TorSet)  THEN
			Torque.An_DTCarryingTorAlarm:=TRUE;
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bEnable:=FALSE;
			An_DTCarryingTorMark:=FALSE;//正极叠台搬运力矩判断标志位	
			//Step_InitAnDT:=0;
		END_IF
	END_IF
	IF ABS(Torque.An_DTCarryingTor)<Torque.Ca_Carrying1TorSet AND Sys_Control.btn.System_Rrestbtn THEN
		Torque.An_DTCarryingTorAlarm:=FALSE;
	END_IF
	
//力矩超限报警断使能
	IF 	TailCurlTorMark THEN//尾卷夹电芯平移力矩判断标志位
		 IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Moving AND (ABS(Torque.TailCurlTor)>=Torque.TailCurlTorSet)  THEN
			Torque.TailCurlTorAlarm:=TRUE;
			arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.bEnable:=FALSE;
			//TailCurlTorMark:=FALSE;
			//TailCurlStep1:=0;
		END_IF
	END_IF
	IF ABS(Torque.TailCurlTor)<Torque.TailCurlTorSet AND Sys_Control.btn.System_Rrestbtn THEN
		Torque.TailCurlTorAlarm:=FALSE;
	END_IF
	
	IF 	TailCurlWhirlTorMark THEN//尾卷夹电芯旋转力矩判断标志位
		 IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.Moving AND (ABS(Torque.TailCurlWhirlTor)>=Torque.TailCurlWhirlTorSet)  THEN
			Torque.TailCurlWhirlTorAlarm:=TRUE;
			arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.bEnable:=FALSE;
			//TailCurlWhirlTorMark:=FALSE;
			//TailCurlStep1:=0;
		END_IF
	END_IF
	IF ABS(Torque.TailCurlWhirlTor)<Torque.TailCurlWhirlTorSet AND Sys_Control.btn.System_Rrestbtn THEN
		Torque.TailCurlWhirlTorAlarm:=FALSE;
	END_IF

	IF 	TailCurlSEPTATorMark THEN//夹膜平移力矩判断标志位
		 IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Moving AND (ABS(Torque.TailCurlSEPTATor)>=Torque.TailCurlSEPTATorSet)  THEN
			Torque.TailCurlSEPTATorAlarm:=TRUE;
			arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bEnable:=FALSE;
			//TailCurlSEPTATorMark:=FALSE;
			//TailCurlStep1:=0;
		END_IF
	END_IF
	IF ABS(Torque.TailCurlSEPTATor)<Torque.TailCurlSEPTATorSet AND Sys_Control.btn.System_Rrestbtn THEN
		Torque.TailCurlSEPTATorAlarm:=FALSE;
	END_IF	
(*
	IF 	TailCurlRetMark THEN//尾卷夹电芯伸缩力矩判断标志	
		 IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Moving AND (ABS(Torque.TailCurlRetTor)>=Torque.TailCurlRetTorSet)  THEN
			Torque.TailCurlRetTorAlarm:=TRUE;
			arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.bEnable:=FALSE;
			//TailCurlRetMark:=FALSE;
			//TailCurlStep1:=0;
		END_IF
	END_IF
	IF ABS(Torque.TailCurlRetTor)<Torque.TailCurlRetTorSet AND Sys_Control.btn.System_Rrestbtn THEN
		Torque.TailCurlRetTorAlarm:=FALSE;
	END_IF	
*)
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Vacuum_Signal" Id="{ab559ec6-3f98-42f2-92ab-58cac331ad05}" FolderPath="09Manual\">
      <Implementation>
        <ST><![CDATA[(**************************************************分段皮带***********************************************************)
(*
//正极模切送料分段皮带
fbAnBeltVacuum( Vacuumsel:= , 
						   	tPTtime:= , 	
							VarrCyCtrl1:=arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuum] , 
							VarrCyCtrl2:=arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark] );

//负极模切送料分段皮带
fbCaMQBeltVacuum(Vacuumsel:= , 
								tPTtime:= , 
								VarrCyCtrl1:=arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuum] , 
								VarrCyCtrl2:=arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark] );

//负极送片皮带末端真空
fbCaLoadUpBeltVacuum(Vacuumsel:= , 
										tPTtime:= , 
										VarrCyCtrl1:=arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuum] , 
										VarrCyCtrl2:=arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark] );




(**************************************************叠片吸盘***********************************************************)
//正极送片搬运升降真空
fbAnCarryingVacuum(Vacuumsel:= , 
									tPTtime:= , 
									VarrCyCtrl1:=arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum] , 
									VarrCyCtrl2:=arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark] );

//正极叠片搬运升降真空
fbAnDTCarryingVacuum(Vacuumsel:= , 
										tPTtime:= , 
										VarrCyCtrl1:=arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum] , 
										VarrCyCtrl2:=arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark] );

//正极纠偏平台真空
fbAndeviationVacuum(Vacuumsel:= , 
									tPTtime:= , 
									VarrCyCtrl1:=arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum] , 
									VarrCyCtrl2:=arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark] );

									
//负极送片搬运升降1真空
fbCaCarryingVacuum1(Vacuumsel:= , 
									tPTtime:= , 
									VarrCyCtrl1:=arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1], 
									VarrCyCtrl2:=arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark1] );

//负极送片搬运升降2真空
fbCaCarryingVacuum2(Vacuumsel:= , 
									tPTtime:= , 
									VarrCyCtrl1:=arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2] , 
									VarrCyCtrl2:=arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark2] );
 
//负极叠片搬运升降真空
fbCaDTCarryingVacuum(Vacuumsel:= , 
										tPTtime:= , 
										VarrCyCtrl1:=arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum] , 
										VarrCyCtrl2:=arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuumBark] );
 
//负极纠偏平台真空
fbCadeviationVacuum(Vacuumsel:= , 
									tPTtime:= , 
									VarrCyCtrl1:=arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum] , 
									VarrCyCtrl2:=arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark] );

*)


(***********************************正极分段皮带皮带末端真空控制*******************************************)
(*
//正极取料中,模切皮带破真空V1
IF Mach_Control.An_b.An_MainBelting THEN
	IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[2] THEN
		//fbAnBeltVacuum.Vacuumsel:=2;//正极模切送料分段皮带破真空开
		arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bON:=TRUE;//正极模切送料分段皮带破真空打开
		arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bOFF:=FALSE;//正极模切送料分段皮带破真空打关
	END_IF
ELSIF Mach_Control.An_b.AN_BeltDone OR Mach_Control.U.Step[0]=20 THEN //OR Mach_Control.U.DT_iMode = 1 
	arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bON:=FALSE;//正极模切送料分段皮带破真空打开
	arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bOFF:=TRUE;//正极模切送料分段皮带破真空打关
	//fbAnBeltVacuum.Vacuumsel:=1;//正极模切送料分段皮带真空打开	
END_IF	
*)	

///V2
rtVacuum2(CLK:=Mach_Control.An_b.An_MainBelting  , Q=> );
ftVacuum2(CLK:=Mach_Control.An_b.An_MainBelting    , Q=> );
IF  rtVacuum2.Q THEN//破真空
      arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bON:=TRUE;//正极模切送料分段皮带破真空打开
     arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bOFF:=FALSE;//正极模切送料分段皮带破真空打关
END_IF
IF  ftVacuum2.Q THEN//开真空
     arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bOFF:=TRUE;//正极模切送料分段皮带破真空打关
    arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bON:=FALSE;//正极模切送料分段皮带破真空打开
END_IF




(***********************************负极分段皮带皮带末端真空控制*******************************************)
(*
//负极取料中,模切皮带破真空V1
IF Mach_Control.Ca_b.Ca_MainBelting THEN
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bON:=TRUE;//负极送片皮带末端真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bOFF:=FALSE;//负极送片皮带末端真空关	
		//fbCaMQBeltVacuum.Vacuumsel:=2;//负极模切分段皮带破真空开
	END_IF	
ELSIF Mach_Control.Ca_b.Ca_BeltDone  OR Mach_Control.U.Step[0]=20 THEN //OR Mach_Control.U.DT_iMode = 1
	arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bON:=FALSE;//负极送片皮带末端真空开	
	arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bOFF:=TRUE;//负极送片皮带末端真空关	
	//fbCaMQBeltVacuum.Vacuumsel:=1;//负极模切分段皮带真空打开
END_IF
*)

///V2
rtVacuum3(CLK:=Mach_Control.Ca_b.Ca_MainBelting  , Q=> );
ftVacuum3(CLK:=Mach_Control.Ca_b.Ca_MainBelting    , Q=> );
IF  rtVacuum3.Q THEN//破真空
		arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bON:=TRUE;//负极模切分段皮带破真空打开
		arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bOFF:=FALSE;//负极模切分段皮带破真空打关
END_IF
IF  ftVacuum3.Q THEN//开真空
		arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bOFF:=TRUE;//负极模切分段皮带破真空打关
		arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bON:=FALSE;//负极模切分段皮带破真空打开
END_IF



(*******************************************负极缓存皮带末端真空控制**************************************************)
//负极送片搬运输出取片中 打开破真空      取片搬运复位开真空此时吸盘离开皮带5mm          
(*
//负极取料中,缓存皮带破真空V1
IF NOT  Mach_Control.U.EmptyRunMode  THEN
	IF Mach_Control.Ca_b.Ca_CacheBelting THEN
		
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[2] THEN
			arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bON:=TRUE;//负极送片皮带末端真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bOFF:=FALSE;//负极送片皮带末端真空关	
			//fbCaLoadUpBeltVacuum.Vacuumsel:=2;//负极送片皮带末端破真空开
		END_IF
	ELSIF arrAxisCtrl[AxiseNo.AxisName.CaBelt].Status.Moving  OR Mach_Control.U.Step[0]=20 THEN //OR Mach_Control.U.DT_iMode = 1
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bON:=FALSE;//负极送片皮带末端真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bOFF:=TRUE;//负极送片皮带末端真空关	
		//fbCaLoadUpBeltVacuum.Vacuumsel:=1;//负极送片皮带末端真空开
	END_IF
END_IF
*)

arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Status.OFFState;
arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Status.ONState;
///V2
rtVacuum1(CLK:=Mach_Control.Ca_b.Ca_CacheBelting , Q=> );
ftVacuum1(CLK:=Mach_Control.Ca_b.Ca_CacheBelting , Q=> );
	IF rtVacuum1.Q THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bOFF:=FALSE;//负极送片皮带末端真空关
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bON:=TRUE;//负极送片皮带末端真空开
	END_IF
	IF ftVacuum1.Q THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bOFF:=TRUE;//负极送片皮带末端真空关
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bON:=FALSE;//负极送片皮带末端真空开
	END_IF











  //  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fActPos<= arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown2].arrTargetPoint[2]-5



(*
IF  Mach_Control.U.EmptyRunMode  THEN
	IF Mach_Control.Ca_b.Ca_CacheBelting AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[2] AND
		NOT arrAxisCtrl[AxiseNo.AxisName.CaBelt].Status.Moving THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bON:=TRUE;//负极送片皮带末端真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bOFF:=FALSE;//负极送片皮带末端真空关	
		//fbCaLoadUpBeltVacuum.Vacuumsel:=2;//负极送片皮带末端破真空开
	ELSIF arrAxisCtrl[AxiseNo.AxisName.CaBelt].Status.Moving  OR Mach_Control.U.Step[0]=20 THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bON:=FALSE;//负极送片皮带末端真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bOFF:=TRUE;//负极送片皮带末端真空关	
		//fbCaLoadUpBeltVacuum.Vacuumsel:=1;//负极送片皮带末端真空开
	END_IF
END_IF	
*)
	

(*
//正极取料中,模切皮带破真空
IF Mach_Control.An_b.An_MainBelting THEN
	IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[2] THEN
		fbAnBeltVacuum.Vacuumsel:=2;//正极模切送料分段皮带破真空开
	END_IF
ELSIF Mach_Control.An_b.AN_BeltDone OR Mach_Control.U.DT_iMode = 1 OR Mach_Control.U.Step[0]=20 THEN
	fbAnBeltVacuum.Vacuumsel:=1;//正极模切送料分段皮带真空打开	
END_IF		

//负极取料中,模切皮带破真空
IF Mach_Control.Ca_b.Ca_MainBelting THEN
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] THEN
		fbCaMQBeltVacuum.Vacuumsel:=2;//负极模切分段皮带破真空开
	END_IF	
ELSIF Mach_Control.Ca_b.Ca_BeltDone OR Mach_Control.U.DT_iMode = 1 OR Mach_Control.U.Step[0]=20 THEN
	fbCaMQBeltVacuum.Vacuumsel:=1;//负极模切分段皮带真空打开
END_IF


	//正极取料中,控制皮带破真空
	IF Mach_Control.An_b.An_MainBelting   THEN//AND Mach_Control.An_b.An_MainBeltOK 
			arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bON:=TRUE;//正极模切送料分段皮带破真空打开
			arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bOFF:=FALSE;//正极模切送料分段皮带破真空打关
	ELSE
			arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bOFF:=TRUE;//正极模切送料分段皮带破真空打关
			arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bON:=FALSE;//正极模切送料分段皮带破真空打开
	END_IF
	//负极取料中,控制皮带破真空
	IF Mach_Control.Ca_b.Ca_MainBelting   THEN//AND Mach_Control.Ca_b.Ca_MainBeltOK 
		arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bON:=TRUE;//负极模切分段皮带破真空打开
		arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bOFF:=FALSE;//负极模切分段皮带破真空打关
	ELSE
		arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bOFF:=TRUE;//负极模切分段皮带破真空打关
		arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bON:=FALSE;//负极模切分段皮带破真空打开
	END_IF
	IF(* Mach_Control.Ca_b.Ca_CacheBelting  AND *)Mach_Control.Ca_b.Ca_CacheBeltDLOK AND arrAxisCtrl[AxiseNo.AxisName.CaBelt].Status.NoMoving THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bOFF:=FALSE;//负极送片皮带末端真空关
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bON:=TRUE;//负极送片皮带末端真空开					
	ELSE
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bOFF:=TRUE;//负极送片皮带末端真空关
		arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bON:=FALSE;//负极送片皮带末端真空开
	END_IF
*)


]]></ST>
      </Implementation>
    </Action>
    <Action Name="WJ_SingMode" Id="{d0eb5e68-a938-4084-9e04-c870824da561}" FolderPath="09Manual\">
      <Implementation>
        <ST><![CDATA[						IF Mach_Control.TJ_b.SinStepMode THEN//尾卷单步模式
							TailCurlSinStep:=TRUE;
						ELSE
							TailCurlSinStep:=FALSE;
						END_IF		]]></ST>
      </Implementation>
    </Action>
