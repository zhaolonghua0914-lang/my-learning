IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF (*arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] AND*)  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

IF (*arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[2] AND*)  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.GoPoint_Condition[3]:=FALSE;	
END_IF

IF (*arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] AND*)  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.GoPoint_Condition[4]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.GoPoint_Condition[4]:=FALSE;	
END_IF

IF (*arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] AND*)  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.GoPoint_Condition[5]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.GoPoint_Condition[5]:=FALSE;	
END_IF


//负极送片搬运1旋转
IF Mach_Control.U.DT_iMode=3  AND
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[1]  THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF


//负极纠偏平台X1
IF Mach_Control.U.DT_iMode=3  OR  (DP_Step0>=6015 AND   DP_Step0<=6041)   THEN
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.Home_Condition:=FALSE;	
