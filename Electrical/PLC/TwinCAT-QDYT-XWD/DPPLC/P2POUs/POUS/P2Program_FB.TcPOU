	arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 AND arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed  AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] 
AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[3] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] 
OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 AND arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed  AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] 
AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[3] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] 
OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

//尾卷长卷针平移
IF  Mach_Control.U.WJ_iMode=3 
OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Status.OFFState
OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Status.OFFState
     AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[4]   OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF


//尾卷短卷针平移
IF  (Mach_Control.U.WJ_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Io.biHomeSwitch)
OR Mach_Control.WJ_b.AxisConditionEN   THEN
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed  AND arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Status.OFFState
OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed  AND arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Status.OFFState
    AND  arrCyCtrl[arrCyNo.ElectValveName.WJShortvacuum].Io.DOStatus1 AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[4]    OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

//尾卷长卷针旋转
IF  Mach_Control.U.WJ_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.LCurlingneedleLine].arrTargetPoint[1]  
OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Homed 
AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  
OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

//尾卷短卷针旋转
IF  Mach_Control.U.WJ_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.SCurlingneedleLine].arrTargetPoint[1]  
OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Homed 
AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]  
OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF



]]></ST>
      </Implementation>
    </Action>
    <Action Name="TailCurl_Gohome" Id="{d7f9db1b-58aa-4409-80d5-a4cdd578f4b1}" FolderPath="04TailCurl\">
      <Implementation>
        <ST><![CDATA[Tailcurl_GohomeOverTon(IN:= , PT:=T#90S , Q=> , ET=> );//叠台回原点超时报警延时

//判断回原点的状态
IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND 
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Homed AND 
	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND 
	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND 
	arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed AND arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed AND WZIniti_Done THEN
		Mach_Control.WJ_b.WZIniti_Done:=TRUE;//初始化完成	
ELSE
		Mach_Control.WJ_b.WZIniti_Done:=FALSE;//初始化完成	
END_IF

IF Mach_Control.U.WJ_iMode=3 THEN//在手动状态下
	IF  Tailcurl_Gohoming THEN
			IF 	NOT Tailcurl_GohomeOverTon.Q THEN
				    Tailcurl_GohomeOverTon.IN:=TRUE;
			ELSE
				IF 	Tailcurl_GohomeOverTon.Q THEN
					Tailcurl_Gohoming:=FALSE;
					TailCurlStep1:=0;
				     Mach_Control.WJ_b.Error[19]:=TRUE;//尾卷回原点超时报警
				     Tailcurl_GohomeOverTon.IN:=FALSE;
				END_IF	 
					 
			END_IF
	
	ELSE
			Tailcurl_GohomeOverTon.IN:=FALSE;
	END_IF
	
	IF r_TailCurl_init.Q THEN
		Tailcurl_GohomeDone:=FALSE;//尾卷回原点完成
		Tailcurl_Gohoming:=FALSE;//尾卷回原点中
		TailCurlStep1:=0;
		Mach_Control.WJ_b.WZIniti_Done:=FALSE;//负极取片回原点完成
		WZIniti_Done:=FALSE;//负极取片回原点完成
	END_IF	

	//尾卷贴胶初始化
	r_TailCurl_init(CLK:=Mach_Control.WJ_b.WZIniti_Hbtn , Q=> );
	f_TailCurl_init(CLK:=Mach_Control.WJ_b.WZIniti_Hbtn   , Q=> );
	tTailCurlTON(IN:= , PT:=T#0.5S , Q=> , ET=> );
	CASE TailCurlStep1 OF
	0://启动尾卷贴胶初始化，气缸复位
		IF f_TailCurl_init.Q THEN	
			Tailcurl_GohomeDone:=FALSE;//尾卷回原点完成
		    Tailcurl_Gohoming:=TRUE;//尾卷回原点中
			TailCurlStep1:=1;
		END_IF
	1://回原点完成复位
			WZIniti_Done:=FALSE;//初始化完成	
			TailCurlStep3 :=0;
			TailCurlStep4:=0;
			TailCurlStep5:=0;
			TailCurlStep6:=0;
			
			arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.fOverride:=100;
			arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.fOverride:=100;
			arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=100;
						
			tailCult_GearInMultiMaster.Enable:=FALSE;
			tailCurlGearInEnable:=FALSE;
			tailCurlGearInEnable1:=FALSE;
			tailRetGearInEnable:=FALSE;//夹电芯平移与夹电芯伸缩电子齿轮
			CurlingneedleLineEnable:=FALSE;
			tailCult_GearInMultiMaster.Enable:=FALSE;
			
			 Mach_Control.DT_b.OffloadDone:=FALSE;
			 Mach_Control.WJ_b.TailCurlDone	:=FALSE;
			 //Mach_Control.DT_b.OffloadRequest:=FALSE;//复位电芯下料请求	
			 Mach_Control.WJ_b.TailCultOffloading:=FALSE;
			CellMemory[Mach_Control.WJ_b.WJ_Memory].Cell:=FALSE;	
			TailCurlStart:=FALSE;//复位尾卷启动
			Mach_Control.WJ_b.TailCurlDone	:=FALSE;	//尾卷完成
			arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bMoveAbs:=FALSE;//主轴启动
			CurlingneedleLineEnable:=FALSE;//长、短卷针平移电子齿轮耦合启动
			tailCurlGearInEnable:=FALSE;//电子齿轮耦合		
			tTailCurlTON.IN:=FALSE;
			arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bDynamitcsParSel:=1;
			fbCamInEndWindX.bGearOutMode:=FALSE;//夹膜平移轴凸轮耦合
			IF NOT WZIniti_Done AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bDynamitcsParSel=1 THEN
				TailCurlStep1:=10;
			END_IF
	10://气缸复位，尾卷状态复位
			IF  NOT 	tTailCurlTON.Q THEN	
					tTailCurlTON.IN:=TRUE;
					//arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S_1].Cmd.bON:=TRUE;//尾卷短卷针泄压关闭
					arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Cmd.bOFF:=TRUE;//尾卷长卷针张开
					arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Cmd.bOFF:=TRUE;//尾卷短卷针张开	
					arrCyCtrl[arrCyNo.ElectValveName.WJShortvacuum].Cmd.bON:=TRUE;//短卷针张开真空开
					arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;//隔膜热切升降气缸收回
					arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Cmd.bOFF:=TRUE;//隔膜隔膜下夹板气缸收回
					arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Cmd.bOFF:=TRUE;//尾卷压轮升降气缸收回
					arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Cmd.bOFF:=TRUE;//尾卷取料夹爪气缸张开	
			ELSE
					IF arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Io.DIOFFSwitch AND arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Io.DIOFFSwitch AND 
					   arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Io.DIOFFSwitch AND arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Io.DIOFFSwitch THEN
					   tTailCurlTON.IN:=FALSE;
					   TailCurlStep1:=20;
					END_IF	
			END_IF	
	20:
			fbCamInEndWindX.bCamInExecute:=FALSE;//夹膜平移凸轮耦合
			fbCamInEndWindY.bCamInExecute:=FALSE;//夹膜升降凸轮耦合
			tailCurl1_GearIn.Execute:=FALSE;//短卷针齿轮耦合
			tailCurl2_GearIn.Execute:=FALSE;//长卷针齿轮耦合
			IF NOT fbCamInEndWindX.bCamInExecute AND NOT fbCamInEndWindY.bCamInExecute AND 
				NOT tailCurl1_GearIn.Execute AND NOT tailCurl2_GearIn.Execute THEN
				TailCurlStep1:=21;
			END_IF
	21://解除凸轮耦合
			arrCyCtrl[arrCyNo.CylinderName.TailCurlLineCy].Cmd.bOFF:=TRUE;//尾卷压轮平移气缸收回
			arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.bGearOut:=TRUE;//尾卷短卷针旋转轴解耦
			arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.bGearOut:=TRUE;//尾卷长卷针旋转轴解耦
			arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.bGearOut:=TRUE;//尾卷夹电芯平移轴解耦
			arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bGearOut:=TRUE;//尾卷夹膜平移轴解耦 
			arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.bGearOut:=TRUE;//尾卷夹膜升降轴解耦 
			IF NOT arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Coupled AND  NOT arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Coupled AND 
				NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Coupled AND 
				NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Coupled THEN
				TailCurlStep1:=25;
			END_IF

	 25:
		 IF NOT arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Io.biHomeSwitch  THEN
			  Mach_Control.WJ_b.Error[20]:=TRUE;//尾卷短卷针神伸缩回原点时,短卷针旋转原点传感器未亮报警
			  TailCurlStep1:=0;
		  ELSE 	 
			 TailCurlStep1:=30;
		 END_IF			
			

    30://尾卷长卷针伸缩轴回原点、尾卷短卷针伸缩轴回原点	
						IF NOT tTailCurlTON.Q THEN
								arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.bHome:=TRUE;//尾卷短卷针平移回原点
								arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.bHome:=TRUE;//尾卷长卷针平移回原点
								tTailCurlTON.IN:=TRUE;
						ELSE
								IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.NoMoving  AND
									 arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving THEN
										arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.bHome:=FALSE;//尾卷短卷针平移回原点
										arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.bHome:=FALSE;//尾卷长卷针平移回原点
										tTailCurlTON.IN:=FALSE;
										TailCurlStep1:=35; 
								END_IF
						END_IF
			
		35:
						IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving THEN
							IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=1;//尾卷长卷针平移至初始位
							END_IF
						END_IF	
						IF 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.NoMoving THEN
							IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.iGoSetPos:=1;//尾卷短卷针平移至初始位
							END_IF
						END_IF		
							IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving
								   AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.NoMoving THEN
									arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.bHome:=FALSE;//尾卷长卷针旋转回原点
									arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.bHome:=FALSE;//尾卷短卷针旋转回原点
									TailCurlStep1:=40; 
							END_IF
			
	40:
						IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving AND
						arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving THEN
						//IF NOT tTailCurlTON.Q THEN
								arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.bHome:=TRUE;//尾卷长卷针旋转回原点
								arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.bHome:=TRUE;//尾卷短卷针旋转回原点
								//tTailCurlTON.IN:=TRUE;
						//ELSE
								//IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.NoMoving AND 
								//	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.NoMoving  THEN
									//tTailCurlTON.IN:=FALSE;
									TailCurlStep1:=50; 
								//END_IF	
						END_IF
	50://
					IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.NoMoving AND 
						arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.NoMoving  THEN
							TailCurlStep1:=51; 	
                            tTailCurlTON.IN:=FALSE;					
					END_IF
	51://夹电芯伸缩回原
			//IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
				arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.bHome:=TRUE;//尾卷夹电芯伸缩回原点
				TailCurlStep1:=52; 
				tTailCurlTON.IN:=TRUE;
			//END_IF
	52:
		IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving AND
           tTailCurlTON.Q  THEN
			arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.bHome:=FALSE;
			TailCurlStep1:=53; 
			tTailCurlTON.IN:=FALSE;
		END_IF					
					
	53://夹电芯平移回原
					IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND 			
						arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed  AND   arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed  AND
						(arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.TailCurlWhirling].arrTargetPoint[1]+1 AND
						arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fSetPos>=arrAxisPar[AxiseNo.AxisName.TailCurlWhirling].arrTargetPoint[1]-1	) OR 
						(arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.TailCurlWhirling].arrTargetPoint[2]+1 AND
						arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fSetPos>=arrAxisPar[AxiseNo.AxisName.TailCurlWhirling].arrTargetPoint[2]-1	)  THEN
							arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.bHome:=TRUE;//尾卷夹电芯平移回原点
							TailCurlTorMark:=TRUE;//尾卷夹电芯平移力矩判断标志位
							TailCurlStep1:=54; 
							tTailCurlTON.IN:=TRUE;
                     ELSE
						    TailCurlStep1:=0; 
						     Mach_Control.WJ_b.Error[8]:=TRUE;//夹电芯平移回原点时条件不满足报警
					END_IF					
	54:
		IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND
            tTailCurlTON.Q  THEN
			arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.bHome:=FALSE;
			TailCurlStep1:=60; 	
            tTailCurlTON.IN:=FALSE;	
		END_IF		
	
	60://夹电芯平移轴移至初始位、夹电芯伸缩轴移至初始位
						IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
							TailCurlTorMark:=FALSE;//尾卷夹电芯平移力矩判断标志位
							IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=1;
							END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
							IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=1;
							END_IF
						END_IF	
						IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND
							arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
							TailCurlStep1:=70;
						END_IF
	70:		
			IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND
			arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
			//IF NOT tTailCurlTON.Q THEN
				arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.bHome:=TRUE;//尾卷夹电芯升降回原点
				arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.bHome:=TRUE;//尾卷夹膜升降回原点
				//tTailCurlTON.IN:=TRUE;
			//ELSE
				IF NOT  arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed THEN
					TailCurlStep1:=75;
				END_IF
			END_IF	
	75:
		IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving AND 
			arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
			arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.bHome:=FALSE;//尾卷夹电芯升降回原点
			arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.bHome:=FALSE;//尾卷夹膜升降回原点
			TailCurlStep1:=90;
		END_IF
    (*
    80:		
	     IF  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND
			 arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] AND
             arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fSetPos <5 (*AND NOT  arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Io.biHomeSwitch*) AND
             arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed THEN
			      arrAxisPar[AxiseNo.AxisName.TailCurlWhirling].arrTargetPoint[10]:=5;
					IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[10] AND NOT   arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.NotMoving THEN
						arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
						TailCurlWhirlTorMark:=FALSE;//尾卷夹电芯旋转力矩判断标志位
						TailCurlStep1:=81;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=10;
						TailCurlWhirlTorMark:=TRUE;//尾卷夹电芯旋转力矩判断标志位
					END_IF
		 END_IF
		 
	81:	
       IF arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed  THEN
          arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.bHome:=TRUE;//尾卷夹旋转回原点
		  TailCurlWhirlTorMark:=TRUE;//尾卷夹电芯旋转力矩判断标志位
		  TailCurlStep1:=82;	
	 END_IF  
		
	82:	
      IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.Homed AND arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.NotMoving THEN	
		    arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.bHome:=FALSE;//尾卷夹旋转回原点
		    TailCurlStep1:=90;	
		   	TailCurlWhirlTorMark:=FALSE;//尾卷夹电芯旋转力矩判断标志位
	  END_IF
	 	IF   arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fSetPos <-10 AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Io.biHomeSwitch THEN
			 arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.bHome:=FALSE;//尾卷夹旋转回原点
			  arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.bStop:=TRUE;
			  TailCurlWhirlTorMark:=FALSE;//尾卷夹电芯旋转力矩判断标志位
			  TailCurlStep1:=9999;		
		END_IF		
		*)
 
	90://夹电芯旋转轴旋转至初始位
		IF 	arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed AND arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.NotMoving AND
           arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1]  THEN
			IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
				TailCurlWhirlTorMark:=FALSE;//尾卷夹电芯旋转力矩判断标志位
				TailCurlStep1:=100;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=1;
				TailCurlWhirlTorMark:=TRUE;//尾卷夹电芯旋转力矩判断标志位
			END_IF
		END_IF
	100://各轴移至初始位
		IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.iGoSetPos:=1;//尾卷长卷针旋转至初始位
			END_IF
		END_IF				
		IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=1;//尾卷长卷针平移至初始位
			END_IF
		END_IF		
	
		IF 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.iGoSetPos:=1;//尾卷短卷针旋转至初始位
			END_IF
		END_IF				
		IF 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.iGoSetPos:=1;//尾卷短卷针平移至初始位
			END_IF
		END_IF		
				
		IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=1;//尾卷夹膜升降到初始位
			END_IF
		END_IF
		IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=1;//尾卷夹电芯升降至初始位
			END_IF
		END_IF				
		IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.NoMoving AND 
			arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving AND 
			arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.NoMoving AND 
			arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving AND 
			arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving AND 
			arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
			TailCurlStep1:=110;
		END_IF	
	110://夹膜平移回初始位
				IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.NotMoving THEN	
							TailCurlStep1:=120;
							
				ELSE
							IF  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1]
								AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5]
                                (*TailCurlSEPTALineGoargee OR arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].NcToPlc.SetPos<= arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[1]+50*) THEN	
									IF 	arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed AND arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.NotMoving THEN
												IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] THEN
													arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=0;
													TailCurlSEPTATorMark:=FALSE;//夹膜平移力矩判断标志
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=1;//尾卷夹膜平移至初始位
													TailCurlSEPTATorMark:=TRUE;//夹膜平移力矩判断标志
												END_IF
									END_IF		
							ELSE
										tTailCurlTON.IN:=FALSE;
										Mach_Control.WJ_b.Error[2]:=TRUE;//夹膜平移回原点条件不满足报警
										Tailcurl_Gohoming:=FALSE;//尾卷回原点中
										TailCurlStep1:=9999;		
							END_IF
				END_IF
				
	120://夹电芯平移去取电芯等待位		
			 IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] AND
				arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] AND
				arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND
				arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Io.DIOFFSwitch AND arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Io.DIOFFSwitch AND
				 arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving   AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1]THEN
	 
					IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[11]  THEN
						arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
						WZIniti_Done:=TRUE;//负极取片回原点完成
						Tailcurl_GohomeDone:=TRUE;//尾卷回原点完成
						Tailcurl_Gohoming:=FALSE;
						TailCurlStep1:=0;
						Mach_Control.WJ_b.TailCurlStep[1]:=0;
						TailCurlStep4:=0;
						TailCurlTorMark:=FALSE;//尾卷夹电芯平移力矩判断标志位
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=11;//夹电芯平移移至取电芯等待位
						TailCurlTorMark:=TRUE;//尾卷夹电芯平移力矩判断标志位
					END_IF	
			 END_IF		
				
	END_CASE
	
END_IF

	IF Mach_Control.U.WJ_iMode=3 AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.Homed AND arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Moving AND
		arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fSetPos <-10 AND TailCurlStep1<>82 AND  arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed  THEN
	    arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.bHome:=FALSE;//尾卷夹旋转回原点
	    arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.bStop:=TRUE;
	END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="TailCurlCam" Id="{cca7155a-7700-41b7-b06f-53f8094cb4b7}" FolderPath="04TailCurl\">
      <Implementation>
        <ST><![CDATA[WJ_Cam_ton[1](PT:=T#100MS);
WJ_Cam_ton[2](PT:=T#100MS);
WJ_Cam_ton[3](PT:=T#100MS);
WJ_Cam_ton[4](PT:=T#100MS);
WJ_Cam_ton[5](PT:=T#100MS);

//尾卷凸轮曲线生成
CASE  iEndWindCam  OF   
10://计算相间距
    I20:=0;
    fMaxPosEndWind:=360;         // REAL
    fMinPosEndWind:=0;          //  REAL
    iNumberOfPointEndWind:=3600; //INT
    fIntervalEndWind:=(360-0)*0.5/ iNumberOfPointEndWind ;
    bEndWindCamDataEnable:=FALSE;
   	MEMSET(ADR(arrDeltaXmm),0,SIZEOF(arrDeltaXmm)); //  ARRAY[0..3600,0..1]  OF LREAL;  
    MEMSET(ADR(arrDeltaYmm),0,SIZEOF(arrDeltaYmm)); //  ARRAY[0..3600,0..1]  OF LREAL;  
    iEndWindCam:=20;  //INT

20:
   fbRoll_New.fAngleRel:=fAngleRel:=I20*fIntervalEndWind;
   bEndWindCamDataEnable:=TRUE;
    iEndWindCam:=30;

30:
   IF NOT  bEndWindCamDataEnable      THEN
           arrDeltaXmm[I20,0] := I20;
           arrDeltaXmm[I20,1] :=fbRoll_New.AxisXmm;

           arrDeltaYmm[I20,0] :=I20;
           arrDeltaYmm[I20,1] :=fbRoll_New.AxisYmm;

         I20:=I20+1;
		IF I20>iNumberOfPointEndWind THEN

			iEndWindCam:=666;  
		ELSE
               iEndWindCam:=20;  
		 END_IF
   END_IF

END_CASE


fbRoll_New(
	Enable:=bEndWindCamDataEnable , 
    fAngleRel:=fbRoll_New.fAngleRel,
	Width:= Par.Mechaical.fCellWidth , 
	Thick:=  Par.Mechaical.fCellThick, 
	r1:=        Par.Mechaical.fCellRadii  );
fbRoll_New.AxisXmm;
fbRoll_New.AxisYmm;



fbCreatCamEndWindX(
	Reset:=                               stSysState.bReset  , 
	bCreatTable:=                     fbCreatCamEndWindX.bCreatTable  , 
	iTable:=                             TableNo.M_TailCurlLine   , 
	arrCalculateTableData:=     arrDeltaXmm , 
	axisSlave:=                         arrAxis[AxiseNo.AxisName.TailCurlSEPTALine] , 
	axisMaster:=                      arrAxis[AxiseNo.VirAxisName.VirTailCurl] , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
  fbCreatCamEndWindX.bCreatTableDone;
  fbCreatCamEndWindX.bCreatTableError;
  fbCreatCamEndWindX.bError;


fbCreatCamEndWindY(
	Reset:=                               stSysState.bReset  , 
	bCreatTable:=                     fbCreatCamEndWindY.bCreatTable  , 
	iTable:=                            TableNo.M_TailCurlUpDown   , 
	arrCalculateTableData:=     arrDeltaYmm , 
	axisSlave:=                        arrAxis[AxiseNo.AxisName.TailCurlSEPTAUpDown] , 
	axisMaster:=                     arrAxis[AxiseNo.VirAxisName.VirTailCurl] , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
  fbCreatCamEndWindY.bCreatTableDone;
  fbCreatCamEndWindY.bCreatTableError;
  fbCreatCamEndWindY.bError;
  
 tWZCreateCamTON(IN:= , PT:=T#0.5S , Q=> , ET=> );
IF Mach_Control.U.DT_iMode=3 OR Mach_Control.U.DT_iMode=0 THEN//在手动状态下
				  //从触摸屏上创建尾卷凸轮
				  rWZCreateCam_TRIG(CLK:=Mach_Control.WJ_b.CreateCamStart , Q=> );
				  IF rWZCreateCam_TRIG.Q THEN
					  tWZCreateCamTON.IN:=FALSE;
					  WZCreatCamStep0:=10;
					  Mach_Control.WJ_b.Error[0]:=FALSE;
				  END_IF
END_IF				  
				  //尾卷凸轮创建自动程序
				  CASE WZCreatCamStep0 OF
							10:
									IF NOT   tWZCreateCamTON.Q THEN
											fbCreatCamEndWindX.bCreatTable :=FALSE;
											fbCreatCamEndWindY.bCreatTable:=FALSE;
											Mach_Control.WJ_b.CreateCamDone:=FALSE;
											tWZCreateCamTON.IN:=TRUE;
									ELSE
											tWZCreateCamTON.IN:=FALSE;
											WZCreatCamStep0:=11;
									END_IF
				  
							11:
									IF  NOT WJ_Cam_ton[1].Q THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bStop:=TRUE;
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.bStop:=TRUE;
										WJ_Cam_ton[1].IN:=TRUE;
									ELSE
										WJ_Cam_ton[1].IN:=FALSE;
										WZCreatCamStep0:=12;
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bStop:=FALSE;
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.bStop:=FALSE;
									END_IF
					
							12:
									IF  NOT WJ_Cam_ton[2].Q THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bReset:=TRUE;	
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.bReset:=TRUE;	
										WJ_Cam_ton[2].IN:=TRUE;
									 ELSE
										 WJ_Cam_ton[2].IN:=FALSE;
										 WZCreatCamStep0:=13;
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bReset:=FALSE;	
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.bReset:=FALSE;	
									 END_IF
									
							13:
									arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bEnable:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.bEnable:=TRUE;
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Enabled  THEN
										 WZCreatCamStep0:=20;
									END_IF		
						
				
									
							20://计算尾卷数据
									iEndWindCam:=10;
									Mach_Control.WJ_b.CreateCamDone:=FALSE;
									WZCreatCamStep0:=30;
							30://等持凸轮数据计算完成
								IF iEndWindCam=666 THEN
									WZCreatCamStep0:=40;
								END_IF
							40://创建尾卷平移凸轮，升降凸轮
									fbCreatCamEndWindX.bCreatTable :=TRUE;
									fbCreatCamEndWindY.bCreatTable:=TRUE;
									WZCreatCamStep0:=50;
							50://等待凸轮创建完成
									IF fbCreatCamEndWindX.bCreatTableDone AND fbCreatCamEndWindY.bCreatTableDone THEN
										Mach_Control.WJ_b.CreateCamDone:=TRUE;//尾卷凸轮创建完成
										WZCreatCamStep0:=6666;
									ELSE
											IF fbCreatCamEndWindX.bCreatTableError OR fbCreatCamEndWindY.bCreatTableError THEN
												Mach_Control.WJ_b.Error[0]:=TRUE;//尾卷凸轮创建失败
												WZCreatCamStep0:=6666;
											END_IF
									END_IF
				  END_CASE
(************************************************************凸轮耦合*****************************************************************************)
//夹膜平移凸轮耦合
//fbCamInEndWindX.ParCamIn.MasterScaling:=-0.05;
fbCamInEndWindX.ParCamIn.MasterScaling:=0.05;
fbCamInEndWindX.ParCamIn.SlaveScaling:=-1;
fbCamInEndWindX(  
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInEndWindX.bCamInExecute, 
	iTable1:=                   TableNo.M_TailCurlLine  , 
	ParCamIn:= , 
    axisMaster:=              arrAxis[AxiseNo.VirAxisName.VirTailCurl], 
	axisSlave:=                 arrAxis[AxiseNo.AxisName.TailCurlSEPTALine]   , 
	bError=> , 
	bReady=> , 
	bInSync=> );

P2M1_MachCtrl.WJ_b.Error[1]:=fbCamInEndWindX.bError;
fbCamInEndWindX.bReady;
fbCamInEndWindX.bInSync;
//夹膜升降凸轮耦合
fbCamInEndWindY.ParCamIn.MasterScaling:=0.05;
fbCamInEndWindY(  
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInEndWindY.bCamInExecute, 
	iTable1:=                   TableNo.M_TailCurlUpDown  , 
	ParCamIn:=               , 
    axisMaster:=              arrAxis[AxiseNo.VirAxisName.VirTailCurl], 
	axisSlave:=                arrAxis[AxiseNo.AxisName.TailCurlSEPTAUpDown]   , 
	bError=> , 
	bReady=> , 
	bInSync=> );

P2M1_MachCtrl.WJ_b.Error[2]:=fbCamInEndWindY.bError;
fbCamInEndWindY.bReady;
fbCamInEndWindY.bInSync;
(************************************************************齿轮耦合*****************************************************************************)
tailCurl1_GearIn(
	Master:=arrAxis[AxiseNo.VirAxisName.VirTailCurl] , 
	Slave:=arrAxis[AxiseNo.AxisName.SCurlingneedleWhirling] , 
	Execute:=tailCurl1_GearIn.Execute , 
