fbAnCrectCamCarryingWhirling.fMoveLength:=ABS(arrAxisPar[AxiseNo.AxisName.AnCarryingWhirling].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.AnCarryingWhirling].arrTargetPoint[2]);
fbAnCrectCamCarryingWhirling(
	bCreatTable:=                fbAnCrectCamCarryingWhirling.bCreatTable , 
	Reset:=                          stSysState.bReset  ,  
	iTable:=                       TableNo.M_AnCarryingWhirling  , 
	fMoveLength:=             , 
	fMasterKeyPos:=          240 , //180
	
	axisMaster:=                 arrAxis[AxiseNo.VirAxisName.VirMain] ,  
    axisSlave:=                    arrAxis[AxiseNo.AxisName.AnCarryingWhirling] ,  
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );

fbAnCrectCamCarryingWhirling.bCreatTableDone;
fbAnCrectCamCarryingWhirling.bCreatTableError;
fbAnCrectCamCarryingWhirling.bError;



//正极叠片搬运平移凸轮创建
fbAnCrectCamDTCarryingLine.fMoveLength:=ABS(arrAxisPar[AxiseNo.AxisName.AnDTCarryingLine].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.AnDTCarryingLine].arrTargetPoint[2]);
fbAnCrectCamDTCarryingLine(
	bCreatTable:=                fbAnCrectCamDTCarryingLine.bCreatTable , 
	Reset:=                          stSysState.bReset  ,  
	iTable:=                       TableNo.M_AnDTCarryingLine  , 
	fMoveLength:=             , 
	fMasterKeyPos:=          250 , //180
	
	axisMaster:=                 arrAxis[AxiseNo.VirAxisName.VirMain] ,  
    axisSlave:=                    arrAxis[AxiseNo.AxisName.AnDTCarryingLine] ,  
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
fbAnCrectCamDTCarryingLine.bCreatTableDone;
fbAnCrectCamDTCarryingLine.bCreatTableError;
fbAnCrectCamDTCarryingLine.bError;



(**********20240528SJ***************)
arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[10]:=6; //等待高度  参数可调
arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[11]:=18; //抬升高度  参数可调
arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[4]:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[3]-arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[10];  //等待位置    以放片位为基准
//arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[1]:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[3]-arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[11];  //安全位置

//正极叠片搬运升降取片凸轮创建
fbAnCrectCamDTCarryingUpDown(//取片
	bCreatTable:=fbAnCrectCamDTCarryingUpDown.bCreatTable, 
	Reset:=stSysState.bReset  , 
	iTable:=TableNo.M_AnDTCarryingUpDown , 
	fMoveLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[10]-(arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[3]-arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[2]) , //取片高度
	fSaveLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[10]-arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[11]        , //安全高度
	//fInitLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[4],//升降轴耦合初始位
	fMasterKeyPos1:=125 , //
	fMasterKeyPos2:=250 , //
	fMasterKeyPos3:=260 , //
	fMasterKeyPos4:= 320, //
	fMasterKeyPos5:=359 , //
	fMasterKeyPos6:= , //
	fSlaveVelo:=0.25 , //
	axisSlave:=arrAxis[AxiseNo.AxisName.AnDTCarryingUpDown]  , 
	axisMaster:=arrAxis[AxiseNo.VirAxisName.VirMain]  , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
fbAnCrectCamDTCarryingUpDown.bCreatTableDone;
fbAnCrectCamDTCarryingUpDown.bCreatTableError;
fbAnCrectCamDTCarryingUpDown.bError;


//正极叠片搬运升降放片凸轮创建
fbAnCrectCamDTCarryingUpDown1(//放片
	bCreatTable:=fbAnCrectCamDTCarryingUpDown1.bCreatTable, 
	Reset:=stSysState.bReset  , 
	iTable:=TableNo.M_AnDTCarryingUpDown1 , 
	fMoveLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[10] ,//放片高度 
	fSaveLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[10]-arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[11]  , //安全高度
	//fInitLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[4],//升降轴耦合初始位
	fMasterKeyPos1:=120 , //208
	fMasterKeyPos2:=250 , //256
	fMasterKeyPos3:=260 , //256
	fMasterKeyPos4:=342 , //328
	fMasterKeyPos5:=359 , //328
	fSlaveVelo:=0.25 , //
	axisSlave:=arrAxis[AxiseNo.AxisName.AnDTCarryingUpDown]  , 
	axisMaster:=arrAxis[AxiseNo.VirAxisName.VirMain]  , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
	
fbAnCrectCamDTCarryingUpDown1.bCreatTableDone;
fbAnCrectCamDTCarryingUpDown1.bCreatTableError;
fbAnCrectCamDTCarryingUpDown1.bError;

//正极叠片搬运升降避让凸轮创建
fbAnCrectCamDTCarryingUpDown3(//放片
	bCreatTable:=fbAnCrectCamDTCarryingUpDown3.bCreatTable, 
	Reset:=stSysState.bReset  , 
	iTable:=TableNo.M_AnDTCarryingUpDown3 , 
	//fMoveLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[10] ,//放片高度 
	fSaveLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[10]-arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[11]  , //安全高度
	//fInitLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[4],//升降轴耦合初始位
	fMasterKeyPos1:=130 , //208
	fMasterKeyPos2:=260 , //256
	//fMasterKeyPos3:=260 , //256
	//fMasterKeyPos4:=342 , //328
//	fMasterKeyPos5:=359 , //328
//	fSlaveVelo:=0.25 , //
	axisSlave:=arrAxis[AxiseNo.AxisName.AnDTCarryingUpDown]  , 
	axisMaster:=arrAxis[AxiseNo.VirAxisName.VirMain]  , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
	
fbAnCrectCamDTCarryingUpDown3.bCreatTableDone;
fbAnCrectCamDTCarryingUpDown3.bCreatTableError;
fbAnCrectCamDTCarryingUpDown3.bError;









An_CamTON(IN:= , PT:=T#0.5S , Q=> , ET=> );
IF Mach_Control.U.DT_iMode=3 OR Mach_Control.U.DT_iMode=0 THEN//在手动状态下
				//在触摸屏上创建正极取片凸轮
				//rAnCreate_TRIG(CLK:=Mach_Control.An_b.CreateCamStart , Q=> );
								rAnCreate_TRIG(CLK:=(Mach_Control.An_b.CreateCamStart 
									AND	NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Coupled
									AND	NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Coupled
									AND	NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Coupled
									AND	NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Coupled) , Q=> );
				IF rAnCreate_TRIG.Q THEN
					An_CamTON.IN:=FALSE;
					AnCrectCamStep0:=10;
					Mach_Control.An_b.Error[0]:=FALSE;
				END_IF
END_IF				
				//正极凸轮创建自动
				CASE AnCrectCamStep0 OF
					
							10:
									IF NOT An_CamTON.Q THEN
										An_CamTON.IN:=TRUE;
									   fbAnCrectCamCarryingLine.bCreatTable:=FALSE;//正极送片搬运平移凸轮创建
									   fbAnCrectCamCarryingUpDown.bCreatTable:=FALSE;//正极送片搬运升降取片凸轮创建
									  fbAnCrectCamUpDown_4.bCreatTable:=FALSE;//正极送片搬运升降取片凸轮创建
									  fbAnCrectCamCarryingUpDown1.bCreatTable:=FALSE;//正极送片搬运升降放片凸轮创建
									  fbAnCrectCamCarryingUpDown3.bCreatTable:=FALSE;//正极送片搬运升降放片凸轮创建								  
									  fbAnCrectCamCarryingWhirling.bCreatTable:=FALSE;//正极送片搬运旋转凸轮创建
									   fbAnCrectCamDTCarryingLine.bCreatTable :=FALSE;//正极叠片搬运平移凸轮创建
									   fbAnCrectCamDTCarryingUpDown.bCreatTable:=FALSE;//正极叠片搬运升降取片凸轮创建
									   fbAnCrectCamDTCarryingUpDown1.bCreatTable:=FALSE;//正极叠片搬运升降放片凸轮创建
									   fbAnCrectCamDTCarryingUpDown3.bCreatTable:=FALSE;//正极叠片搬运升降放片凸轮创建
									   Mach_Control.An_b.CreateCamDone:=FALSE;
									ELSE
										An_CamTON.IN:=FALSE;
									   AnCrectCamStep0:=11;
									 END_IF
							
							11:
								IF  NOT An_Cam_ton[1].Q THEN
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bStop:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bStop:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bStop:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bStop:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bStop:=TRUE;
									An_Cam_ton[1].IN:=TRUE;
								ELSE
									An_Cam_ton[1].IN:=FALSE;
									AnCrectCamStep0:=12;
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bStop:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bStop:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bStop:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bStop:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bStop:=FALSE;
								END_IF

							12:
								IF  NOT An_Cam_ton[2].Q THEN
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bReset:=TRUE;	
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bReset:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bReset:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bReset:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bReset:=TRUE;
									An_Cam_ton[2].IN:=TRUE;
								 ELSE
									 An_Cam_ton[2].IN:=FALSE;
									 AnCrectCamStep0:=13;
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bReset:=FALSE;	
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bReset:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bReset:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bReset:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bReset:=FALSE;
								 END_IF
								 
							13:
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bEnable:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bEnable:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bEnable:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bEnable:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bEnable:=TRUE;
									IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Enabled AND
										arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Enabled
										AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Enabled THEN
										 AnCrectCamStep0:=20;
									END_IF


		   
							20://创建凸轮
									  fbAnCrectCamCarryingLine.bCreatTable:=TRUE;//正极送片搬运平移凸轮创建
									  fbAnCrectCamCarryingUpDown.bCreatTable:=TRUE;//正极送片搬运升降取片凸轮创建
									  fbAnCrectCamUpDown_4.bCreatTable:=TRUE;//正极送片搬运升降取片凸轮创建
									  
									  fbAnCrectCamCarryingUpDown1.bCreatTable:=TRUE;//正极送片搬运升降放片凸轮创建
									   fbAnCrectCamCarryingUpDown3.bCreatTable:=TRUE;//正极送片搬运升降放片凸轮创建
									  fbAnCrectCamCarryingWhirling.bCreatTable:=TRUE;//正极送片搬运旋转凸轮创建
									   fbAnCrectCamDTCarryingLine.bCreatTable :=TRUE;//正极叠片搬运平移凸轮创建
									   fbAnCrectCamDTCarryingUpDown.bCreatTable:=TRUE;//正极叠片搬运升降取片凸轮创建
									   fbAnCrectCamDTCarryingUpDown1.bCreatTable:=TRUE;//正极叠片搬运升降放片凸轮创建
									    fbAnCrectCamDTCarryingUpDown3.bCreatTable:=TRUE;//正极叠片搬运升降放片凸轮创建
									   
									   Mach_Control.An_b.CreateCamDone:=FALSE;
									   AnCrectCamStep0:=30;
							30://等待凸轮创建完成
									IF fbAnCrectCamCarryingLine.bCreatTableDone AND fbAnCrectCamUpDown_4.bCreatTableDone(*fbAnCrectCamCarryingUpDown.bCreatTableDone*) AND fbAnCrectCamCarryingUpDown1.bCreatTableDone  AND fbAnCrectCamCarryingWhirling.bCreatTableDone AND 
										fbAnCrectCamDTCarryingLine.bCreatTableDone AND fbAnCrectCamDTCarryingUpDown.bCreatTableDone AND fbAnCrectCamDTCarryingUpDown1.bCreatTableDone  AND 
                                        fbAnCrectCamCarryingUpDown3.bCreatTableDone AND  fbAnCrectCamDTCarryingUpDown3.bCreatTableDone  THEN
										Mach_Control.An_b.CreateCamDone:=TRUE;
										 AnCrectCamStep0:=6666;
										ELSE
												IF fbAnCrectCamCarryingLine.bCreatTableError OR fbAnCrectCamCarryingUpDown.bCreatTableError OR fbAnCrectCamCarryingUpDown1.bCreatTableError OR fbAnCrectCamCarryingWhirling.bCreatTableError OR 
													fbAnCrectCamCarryingLine.bCreatTableError OR fbAnCrectCamDTCarryingUpDown.bCreatTableError OR fbAnCrectCamDTCarryingUpDown1.bCreatTableError OR fbAnCrectCamUpDown_4.bCreatTableError OR 
                                                  fbAnCrectCamCarryingUpDown3.bCreatTableError OR  fbAnCrectCamDTCarryingUpDown3.bCreatTableError   THEN
													Mach_Control.An_b.Error[0]:=TRUE;//正极取片凸轮创建失败报警
													AnCrectCamStep0:=9999;
												END_IF
									END_IF
				END_CASE







(***********************************正极凸轮耦合***********************************************)
(*
      fbAnCamInCarryingLine                      :FB_CamIn ;    
      fbAnCamInCarryingUpDown               :FB_CamIn ;    
      fbAnCamInDTCarryingLine                    :FB_CamIn ;    
      fbAnCamInDTCarryingUpDown             :FB_CamIn ;     
*)
//正极送片搬运平移凸轮耦合
fbAnCamInCarryingLine.ParCamIn.SlaveScaling;
fbAnCamInCarryingLine.ParCamIn.MasterScaling:=fAnScaling;//20240508 CF
fbAnCamInCarryingLine(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbAnCamInCarryingLine.bCamInExecute, 
	iTable1:=                   TableNo.M_AnCarryingLine  , 
	iTable2:=                   , 
	iTableSel:=                 , 
	ParCamIn:= , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.AnCarryingLine] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

(*Mach_Control.An_b.Error[9]:=*)fbAnCamInCarryingLine.bError;
fbAnCamInCarryingLine.bReady;
fbAnCamInCarryingLine.bInSync;

//正极送片搬运升降凸轮耦合
fbAnCamInCarryingUpDown(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbAnCamInCarryingUpDown.bCamInExecute, 
	iTable1:=                   TableNo.M_AnCarryingUpDown  , 
	iTable2:=                    TableNo.M_AnCarryingUpDown1 , 
	iTable3:=                    TableNo.M_AnCarryingUpDown3 , 
	iTableSel:=                  , 
	ParCamIn:=                  , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.AnCarryingUpDown] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

(*Mach_Control.An_b.Error[10]:=*)fbAnCamInCarryingUpDown.bError;
fbAnCamInCarryingUpDown.bReady;
fbAnCamInCarryingUpDown.bInSync;
//正极送片搬运旋转凸轮耦合
fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling;
fbAnCamInCarryingWhirling.ParCamIn.MasterScaling:=fAnScaling;//20240508 CF
fbAnCamInCarryingWhirling(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbAnCamInCarryingWhirling.bCamInExecute, 
	iTable1:=                   TableNo.M_AnCarryingWhirling  , 
	iTable2:=                    , 
	iTableSel:=                  , 
	ParCamIn:=                  , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.AnCarryingWhirling] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

(*Mach_Control.An_b.Error[11]:=*)fbAnCamInCarryingWhirling.bError;
fbAnCamInCarryingWhirling.bReady;
fbAnCamInCarryingWhirling.bInSync;



//正极叠片搬运平移凸轮耦合
fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling;
fbAnCamInDTCarryingLine(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbAnCamInDTCarryingLine.bCamInExecute, 
	iTable1:=                   TableNo.M_AnDTCarryingLine  , 
	iTable2:=                   , 
	iTableSel:=                 , 
	ParCamIn:=                , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.AnDTCarryingLine] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );
(*Mach_Control.An_b.Error[12]:=*)fbAnCamInDTCarryingLine.bError;
fbAnCamInDTCarryingLine.bReady;
fbAnCamInDTCarryingLine.bInSync;


//正极叠片搬运升降凸轮耦合
fbAnCamInDTCarryingUpDown(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbAnCamInDTCarryingUpDown.bCamInExecute, 
	iTable1:=                   TableNo.M_AnDTCarryingUpDown  , 
	iTable2:=                    TableNo.M_AnDTCarryingUpDown1, 
	iTable3:=                    TableNo.M_AnDTCarryingUpDown3, 
	iTableSel:=                  , 
	ParCamIn:=                  , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.AnDTCarryingUpDown] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

(*Mach_Control.An_b.Error[13]:=*)fbAnCamInDTCarryingUpDown.bError;
fbAnCamInDTCarryingUpDown.bReady;
fbAnCamInDTCarryingUpDown.bInSync;


IF fbAnCamInCarryingLine.bError OR fbAnCamInCarryingUpDown.bError OR fbAnCamInCarryingWhirling.bError OR fbAnCamInDTCarryingLine.bError OR fbAnCamInDTCarryingUpDown.bError THEN
		Mach_Control.An_b.Error[11]:=TRUE;//正极有凸轮耦合报警
	ELSE		
		Mach_Control.An_b.Error[11]:=FALSE;
END_IF
















]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_Conditions" Id="{db591942-a85b-4f07-82e9-699e491aec5b}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[//正极纠偏平台允许放料条件
IF  NOT Mach_Control.An_b.An_deviationFalg AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed AND NOT arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Error AND 
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] AND 
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed AND NOT arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Error AND 
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] AND 
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed AND NOT arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Error AND 
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
	Mach_Control.An_b.An_deviationFPOK:=TRUE;
ELSE
	Mach_Control.An_b.An_deviationFPOK:=FALSE;
END_IF 
(*
//正极纠偏平台允许取料条件
IF Mach_Control.An_b.An_deviationFalg AND  (Mach_Control.An_b.An_deviationDone OR Mach_Control.U.CCD_ChosesHMI OR Mach_Control.U.EmptyRunMode) THEN
	Mach_Control.An_b.An_deviationDPOK:=TRUE;
ELSE
	Mach_Control.An_b.An_deviationDPOK:=FALSE;
END_IF
*)
//正极送片搬运平移在安全位，正极送片升降在安全位，允许正极叠片搬运平移到纠偏位
IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] AND 
 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[1] THEN
	Mach_Control.An_b.CarryingSafepos[0]:=TRUE;
ELSE
	Mach_Control.An_b.CarryingSafepos[0]:=FALSE;
END_IF
//正极隔膜平移在负极片位、正极送片搬运升降在安全位，允许正极叠片搬动至叠台位
IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] AND 
	 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[1] THEN
	Mach_Control.An_b.CarryingSafepos[1]:=TRUE;
ELSE		
	Mach_Control.An_b.CarryingSafepos[1]:=FALSE;
END_IF
//正极送片搬运升降在安全位，允许正极送片搬运平移至取流水线极片位
IF  arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[1] THEN
		Mach_Control.An_b.CarryingSafepos[2]:=TRUE;
ELSE
		Mach_Control.An_b.CarryingSafepos[2]:=FALSE;	
END_IF
//正极送片搬运升降在安全位、正极叠片搬运平移在安全位，允许正极送片搬运平移纠偏位
IF  arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[1] AND 
 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[2]  THEN
		Mach_Control.An_b.CarryingSafepos[3]:=TRUE;
ELSE
		Mach_Control.An_b.CarryingSafepos[3]:=FALSE;	
END_IF
//允许正极纠偏平台移动
IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND 
	((arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[4]+2) OR arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbGoSetPos[1]) AND 
	((arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[4]+2) OR arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbGoSetPos[2])THEN
	Mach_Control.An_b.CarryingSafepos[4]:=TRUE;
ELSE
	Mach_Control.An_b.CarryingSafepos[4]:=FALSE;
END_IF
//正极取流水线机械手在安全位，允许模切流水线移动
(*
IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND NOT Mach_Control.An_b.An_MainBelting AND
	(arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[4]+0.2 OR arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[2]) THEN
	Mach_Control.An_b.AN_BeltSafe:=TRUE;
ELSE
	Mach_Control.An_b.AN_BeltSafe:=FALSE;
END_IF
*)
(*
IF  Mach_Control.An_b.An_MainBelting  THEN
	Mach_Control.An_b.AN_BeltSafe:=TRUE;
ELSIF NOT Mach_Control.An_b.An_MainBelting AND  arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
	Mach_Control.An_b.AN_BeltSafe:=FALSE;
END_IF
*)
IF  Mach_Control.An_b.An_MainBelting  THEN
	Mach_Control.An_b.AN_BeltSafe:=TRUE;
ELSE
	Mach_Control.An_b.AN_BeltSafe:=FALSE;
END_IF

//正极主流水线取片完成延时复位
An_BeltTon(IN:=Mach_Control.An_b.AN_BeltDone , PT:=T#0.1S , Q=> , ET=> );
IF An_BeltTon.Q THEN
	Mach_Control.An_b.AN_BeltDone :=FALSE;
END_IF


//正极跳取条件1:空跑(空叠隔膜)
An_JumpRules[1]:=Mach_Control.U.EmptyRunMode OR (Mach_Control.DT_b.SinStepMode AND An_Step0<>150);
//正极跳取条件2:手动
An_JumpRules[2]:=Mach_Control.U.DT_iMode<>1;
//正极跳取条件3:叠完电芯后空叠隔膜
An_JumpRules[3]:=Mach_Control.DT_b.DP_Mode AND Mach_Control.An_b.An_Quantited=Par.stDT_date.An_Quantity AND Par.stDT_date.An_Quantity<>0  ;
//正极跳取条件4:叠完电芯后下料
An_JumpRules[4]:=DP_Step0>=6000;//(DP_Step0>=6030 AND DP_Step0<6041) ;
//正极跳取条件5:正极剔废,
An_JumpRules[5]:=(An_Step2<>0 AND An_Step2<>6666) ; 
//正极跳取条件6:接带、蓝胶判断
An_JumpRules[6]:=Bnt_Blueflaging AND Mach_Control.Ca_b.Ca_Quantited>=Par.stDT_date.DT_Overhang_SUM AND Par.stDT_date.DT_Overhang_SUM>0 
				AND Mach_Control.Ca_b.Ca_Quantited>Mach_Control.An_b.An_Quantited AND An_StandbyStep1<1000;//已经进入取片流程则取完当前片
//正极跳取条件7:取片升降有片
An_JumpRules[7]:= Mach_Control.An_b.An_CarryingFalg  ;
//正极跳取条件8:对齐度踢废
An_JumpRules[8]:=Mach_Control.DT_b.DT_Oerhang_Z=2 AND  Par.stDT_date.DT_Overhang_SUM>0 AND Mach_Control.Ca_b.Ca_Quantited>=Par.stDT_date.DT_Overhang_SUM
				AND Mach_Control.An_b.An_Quantited<Mach_Control.Ca_b.Ca_Quantited  AND  Mach_Control.DT_b.DT_CellNG_TF AND Mach_Control.DT_b.Overhang_TF 
				AND((NOT Mach_Control.DT_b.FirstEmpFold AND   bFirstFoldFinish[1]) OR (Mach_Control.DT_b.FirstEmpFold)) AND An_StandbyStep1<1000;//已经进入取片流程则取完当前片
//正极跳取条件9:负极剔废
An_JumpRules[9]:=(Ca_Step2<>0 AND Ca_Step2<>6666) ;
//正极跳取条件10:首层空叠隔膜流程
An_JumpRules[10]:=NOT bFirstFoldFinish[1]AND NOT Mach_Control.DT_b.FirstEmpFold ; 			
//正极跳取条件
Mach_Control.An_b.JumpPiceReady:=An_JumpRules[1] OR An_JumpRules[2] OR An_JumpRules[3] OR An_JumpRules[4] OR An_JumpRules[5]
				OR An_JumpRules[6] OR An_JumpRules[7] OR An_JumpRules[8]  OR An_JumpRules[9] OR An_JumpRules[10] OR DP_Step0=162;	//速度不一样如果平移没到位放弃取片 20240509 CF	
//正极取片条件
Mach_Control.An_b.GetPiceReady:=NOT Mach_Control.An_b.JumpPiceReady (*AND  arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4]*)
				AND ABS(arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.fSetPos-arrAxisPar[AxiseNo.AxisName.AnCarryingLine].arrTargetPoint[1])<0.5 AND  arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1]
				AND Mach_Control.U.DT_iMode=1 AND NOT Mach_Control.An_b.An_CarryingFalg ;//20240509 CF 升降位置判断屏蔽
		
(*				
////////////////判断叠台是否需要极片
//南昌原版
JumpPiceReady_temp1:=Mach_Control.An_b.An_Quantited<Mach_Control.Ca_b.Ca_Quantited AND Par.stDT_date.An_Quantity<>0  AND
 	 				 Par.stDT_date.Ca_Quantity <>0 AND  Mach_Control.DT_b.DT_CellNG_TF AND
	 				 Mach_Control.Ca_b.Ca_Quantited>=Par.stDT_date.DT_Overhang_SUM AND Par.stDT_date.DT_Overhang_SUM>0  AND
     				 Mach_Control.DT_b.DT_Oerhang_Z=2 AND  NOT Mach_Control.U.EmptyRunMode;

JumpPiceReady_temp2:=Bnt_Blueflaging AND ((Mach_Control.An_b.An_Quantited=0 AND Mach_Control.Ca_b.Ca_Quantited=0) OR
 					 Mach_Control.Ca_b.Ca_Quantited>Mach_Control.An_b.An_Quantited);

JumpPiceReady_temp3:= Mach_Control.An_b.An_Quantited >= Par.stDT_date.An_Quantity  AND
  					  Mach_Control.Ca_b.Ca_Quantited >= Par.stDT_date.Ca_Quantity AND
                      Par.stDT_date.An_Quantity<>0  AND Par.stDT_date.Ca_Quantity <>0;
					  
JumpPiceReady_temp4:= (Ca_Step2<>0 AND Ca_Step2<>6666 AND Mach_Control.U.DT_iMode=1)OR (Mach_Control.An_b.An_Quantited >= Par.stDT_date.An_Quantity 
					 AND  Mach_Control.Ca_b.Ca_Quantited >= (Par.stDT_date.Ca_Quantity-1)) OR
					   (Bnt_Blueflaging AND Mach_Control.Ca_b.Ca_Quantited>=Par.stDT_date.DT_Overhang_SUM AND Par.stDT_date.DT_Overhang_SUM>0);

					   
//正极送片搬运搬运取片准备好
IF Mach_Control.U.DT_iMode=1 AND NOT Mach_Control.An_b.An_CarryingFalg AND NOT JumpPiceReady_temp4 AND (DP_Step0<>6030 AND DP_Step0<>6040 AND 
Mach_Control.An_b.An_Quantited <= Par.stDT_date.An_Quantity  AND  Mach_Control.Ca_b.Ca_Quantited < Par.stDT_date.Ca_Quantity) AND
   arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND
   arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND
   arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1]AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Homed  THEN
   Mach_Control.An_b.GetPiceReady:=TRUE;
ELSE
   Mach_Control.An_b.GetPiceReady:=FALSE;	
END_IF

//正极送片搬运不取片
IF Mach_Control.U.DT_iMode<>1 OR Mach_Control.An_b.An_CarryingFalg OR JumpPiceReady_temp1 OR JumpPiceReady_temp2 OR JumpPiceReady_temp3 OR JumpPiceReady_temp4 OR Mach_Control.U.EmptyRunMode THEN
	Mach_Control.An_b.JumpPiceReady:=TRUE;
ELSE
	Mach_Control.An_b.JumpPiceReady:=FALSE;	
END_IF


//合肥原版
(*
(********************正极取片准备好********************)															
Mach_Control.An_b.GetPiceReady:=NOT Mach_Control.An_b.JumpPiceReady AND 
							arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND
							arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND
							arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1]AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Homed AND 
							(DP_Step0<>6030 AND DP_Step0<>6040)  ;													

(********************正极放弃取片********************)
Mach_Control.An_b.JumpPiceReady:=Mach_Control.U.DT_iMode<>1 OR Mach_Control.An_b.An_CarryingFalg OR Blueflaging OR Mach_Control.U.EmptyRunMode
															OR Mach_Control.An_b.An_Quantited=Par.stDT_date.An_Quantity;
*)

*)


/////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////
////////////////////////////////////////////电机条件
//正极送片搬运平移
IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[4]+1 AND
 	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving	AND Mach_Control.U.DT_iMode=3 THEN
arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.Home_Condition:=TRUE;
ELSE
arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.Home_Condition:=FALSE;	
END_IF

IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[4]+1 AND
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving AND Mach_Control.U.DT_iMode=3 
    AND 	arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Io.DIOnSwitch  THEN
arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[4]+1 AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed  AND
	 arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND Mach_Control.U.DT_iMode=3 AND 	arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Io.DIOnSwitch AND
	 arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[2] THEN//比较值要根据实际值修改
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

//正极送片搬运升降
IF Mach_Control.U.DT_iMode=3  THEN
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF (*arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] AND*)  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

IF (*arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[2] AND*)  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.GoPoint_Condition[3]:=FALSE;	
END_IF

IF (*arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] AND*)  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.GoPoint_Condition[4]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.GoPoint_Condition[4]:=FALSE;	
END_IF

//正极送片搬运旋转
IF Mach_Control.U.DT_iMode=3 AND
 	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fSetPos <= arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[1]+1 AND 
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Io.DIOnSwitch   THEN
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.Home_Condition:=FALSE;	
END_IF


IF Mach_Control.U.DT_iMode=3 AND
 	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fSetPos <= arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[1]+1 AND 
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Io.DIOnSwitch    THEN
	   arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.JogP_Condition:=TRUE;
	   arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.JogN_Condition:=TRUE;
 ELSE 
	   arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.JogP_Condition:=FALSE;
	   arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.JogN_Condition:=FALSE;
 END_IF

IF Mach_Control.U.DT_iMode=3 AND 
	(arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[1] (*OR arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4]*))AND
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Homed AND 
    arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Io.DIOnSwitch   THEN
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND 
	(arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[1] (*OR arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4]*)) AND
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Homed AND
   arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Io.DIOnSwitch  THEN
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

//正极纠偏平台X1
IF Mach_Control.U.DT_iMode=3  OR  (DP_Step0>=6015 AND   DP_Step0<=6041)   THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.GoPoint_Condition[3]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.GoPoint_Condition[4]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.GoPoint_Condition[4]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.GoPoint_Condition[5]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.GoPoint_Condition[5]:=FALSE;	
END_IF

//正极纠偏平台X2
IF Mach_Control.U.DT_iMode=3  OR  (DP_Step0>=6015 AND   DP_Step0<=6041)   THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.GoPoint_Condition[3]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.GoPoint_Condition[4]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.GoPoint_Condition[4]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.GoPoint_Condition[5]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.GoPoint_Condition[5]:=FALSE;	
END_IF

//正极纠偏平台Y
IF Mach_Control.U.DT_iMode=3  OR  (DP_Step0>=6015 AND   DP_Step0<=6041)   THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.GoPoint_Condition[3]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.GoPoint_Condition[4]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.GoPoint_Condition[4]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.GoPoint_Condition[5]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.GoPoint_Condition[5]:=FALSE;	
END_IF

//正极叠台搬运平移1
IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.fSetPos<= arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[4]+1 AND
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.AnCarryingLine].arrTargetPoint[1] AND 
	arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Io.DIOnSwitch  AND NOT arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Io.DIOFFSwitch AND
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState THEN
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.JogP_Condition:=TRUE;
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.JogN_Condition:=TRUE;
   ELSE 
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.JogP_Condition:=FALSE;
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.JogN_Condition:=FALSE;
 END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.fSetPos<= arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[4]+1 AND
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] AND arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState  THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.fSetPos<= arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[4]+1 AND
 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] AND
    arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF


//正极叠台搬运升降1
IF Mach_Control.U.DT_iMode=3  THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND  arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.GoPoint_Condition[3]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.GoPoint_Condition[4]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.GoPoint_Condition[4]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.GoPoint_Condition[5]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.GoPoint_Condition[5]:=FALSE;	
END_IF
//正极NG料盒伸缩气缸条件
IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[5] (*AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1]*)  THEN
	arrCyCtrl[arrCyNo.CylinderName.	AnScrapbinCy].Cmd.OnCondition:=TRUE;
    arrCyCtrl[arrCyNo.CylinderName.	AnScrapbinCy].Cmd.OffCondition:=TRUE;
ELSE	
	arrCyCtrl[arrCyNo.CylinderName.	AnScrapbinCy].Cmd.OnCondition:=FALSE;
    arrCyCtrl[arrCyNo.CylinderName.	AnScrapbinCy].Cmd.OffCondition:=FALSE;	
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_Gohome" Id="{83239e74-87c6-438f-8764-5df8d705d23f}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[An_GohomeTon(IN:= , PT:=T#1S , Q=> , ET=> );//正极取片回原点延时
An_GohomeOverTon(IN:= , PT:=T#90S , Q=> , ET=> );//负正回原点超时报警延时
rAn_Gohome_TRIG(CLK:=Mach_Control.An_b.An_GohomeHMI , Q=> );//正极取片回原点启动
fAn_Gohome_FRIG(CLK:=Mach_Control.An_b.An_GohomeHMI , Q=> );//负极回原点启动
//判断正极是否回原点完成
IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND  arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed  AND 
 	arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Homed AND 				
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed AND
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed	AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND An_GohomeDone THEN	
		Mach_Control.An_b.An_GohomeDone:=TRUE;//负极取片回原点完成
ELSE
		Mach_Control.An_b.An_GohomeDone:=FALSE;//负极取片回原点完成
END_IF




IF Mach_Control.U.DT_iMode=3 THEN//在手动状态下
		IF rAn_Gohome_TRIG.Q THEN
			Step_InitAnDT:=0;
			An_GohomeDone:=FALSE;
			An_Gohoming:=FALSE;//负极取片回原点中
			Mach_Control.An_b.An_GohomeDone:=FALSE;//负极取片回原点完成
		END_IF	
END_IF		
IF Mach_Control.U.DT_iMode=3 THEN//在手动状态下
	
//回原点超时报警	

IF  An_Gohoming THEN
		IF 	NOT An_GohomeOverTon.Q THEN
			    An_GohomeOverTon.IN:=TRUE;
		ELSE
			IF 	 An_GohomeOverTon.Q THEN
				An_Gohoming:=FALSE;
			     Mach_Control.An_b.Error[19]:=TRUE;//负极回原点超时报警
			     An_GohomeOverTon.IN:=FALSE;
			END_IF	 
				 
		END_IF

ELSE
		An_GohomeOverTon.IN:=FALSE;
END_IF




//正极取料机构初始C化
CASE Step_InitAnDT OF
0://等待正极回原点启动	
IF fAn_Gohome_FRIG.Q THEN
	An_Gohoming:=TRUE;//负极取片回原点中
	Mach_Control.An_b.An_GohomeHMI:=FALSE;
	Step_InitAnDT:=1;
END_IF
1://复位回原点完成
	An_GohomeDone:=FALSE;//正极回原点完成
	An_GohomeTon.IN:=FALSE;								
	IF NOT An_GohomeDone THEN
		Step_InitAnDT:=10;
	END_IF
10:
Mach_Control.An_b.An_CarryingFalg:=FALSE;//正极搬运升降有料标记
Mach_Control.An_b.An_DPCarryingFalg:=FALSE;//正极叠片搬运有料标记
Mach_Control.An_b.An_deviationFalg :=FALSE;//正极纠偏有料标记


An_StandbyStep0:=0;//正极纠偏平台自动步
An_StandbyStep1:=0;//正极取片备料步清零
An_StandbyStep2:=0;//叠正极片，判断真空、破真空
An_StandbyStep3:=0;//叠正极片，判断主轴是否完成
Mach_Control.An_b.AN_BeltDone:=FALSE;//取流水线取极片完成	
Mach_Control.An_b.An_MainBelting:=FALSE;// 复位正极搬运升降取极片中
An_Step0:=0;
An_Step1:=0;
An_Step2:=0;
An_Step3:=0;
An_StandbyStep0:=0;
An_Demarcate_Step0:=0;
An_RecdevPla_Step0:=0;						
Step_InitAnDT:=20;	
20:
	fbAnCamInCarryingLine.bCamInExecute:=FALSE;//正极送片搬运平移
	fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极送片搬运升降
	fbAnCamInCarryingWhirling.bCamInExecute:=FALSE;//正极送片搬运旋转
	fbAnCamInDTCarryingLine.bCamInExecute:=FALSE;//正极叠片搬运平移
	fbAnCamInDTCarryingUpDown.bCamInExecute:=FALSE;//正极叠片搬运升降
	IF NOT fbAnCamInCarryingLine.bCamInExecute AND NOT fbAnCamInCarryingUpDown.bCamInExecute AND 
		NOT  fbAnCamInCarryingWhirling.bCamInExecute AND NOT fbAnCamInDTCarryingLine.bCamInExecute AND 
		NOT  fbAnCamInDTCarryingUpDown.bCamInExecute THEN
				Step_InitAnDT:=25;	
	END_IF									
25:
arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bHalt:=TRUE;//正极送片搬运轴解耦
arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bHalt:=TRUE;//正极叠片搬运解耦
arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bHalt:=TRUE;//正极送片搬运平移轴解耦
arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bHalt:=TRUE;//正极叠片搬运平移轴解耦
arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bHalt:=TRUE;//正极送片搬运旋转轴解耦	
IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving AND 
   NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND
   NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving AND 
   NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.NoMoving AND
   NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.NoMoving THEN
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bHalt:=FALSE;//正极送片搬运轴解耦
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bHalt:=FALSE;//正极叠片搬运解耦
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bHalt:=FALSE;//正极送片搬运平移轴解耦
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bHalt:=FALSE;//正极叠片搬运平移轴解耦
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bHalt:=FALSE;//正极送片搬运旋转轴解耦	
			Step_InitAnDT:=30;	
END_IF		
30:
arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bEnable:=TRUE;//正极送片搬运轴
arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bEnable:=TRUE;//正极叠片搬运
arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bEnable:=TRUE;//正极送片搬运平移轴
arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bEnable:=TRUE;//正极叠片搬运平移轴
arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bEnable:=TRUE;//正极送片搬运旋转轴	
arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.bEnable:=TRUE;//正极纠偏X1
arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.bEnable:=TRUE;//正极纠偏X2
arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.bEnable:=TRUE;//正极纠偏Y						
IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Enabled AND 
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Enabled AND 
   arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Enabled AND 
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Enabled AND 
   arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Enabled AND
   arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Enabled AND 
   arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Enabled AND
   arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Enabled THEN
		Step_InitAnDT:=35;	
ELSIF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error OR 
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error OR 
   arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Error OR 
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Error OR 
   arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Error OR
   arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Error OR 
   arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Error OR
   arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Error THEN
	An_Gohoming:=FALSE;//正极取片回原点中
		Step_InitAnDT:=9999;	
END_IF		

				
35://正极送片搬运升降、正极叠片搬运升降轴回原点
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bHome:=TRUE;//正极送片搬运轴回原点
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bHome:=TRUE;//正极叠片搬运回原点
	Step_InitAnDT:=40;
	
40://判断回原点是否完成
	IF NOT An_GohomeTon.Q THEN
			An_GohomeTon.IN:=TRUE;
	ELSE		
				IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed  AND 
					arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving  THEN
					arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bHome:=FALSE;//正极送片搬运轴回原点
					arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bHome:=FALSE;//正极叠片搬运回原点
					An_GohomeTon.IN:=FALSE;
					Step_InitAnDT:=45;
				ELSIF  arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error THEN
						arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bHome:=FALSE;//正极送片搬运轴回原点
						arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bHome:=FALSE;//正极叠片搬运回原点
						An_GohomeTon.IN:=FALSE;
						An_Gohoming:=FALSE;//正极取片回原点中
						Step_InitAnDT:=9999;	  
				END_IF
	END_IF
45:
	IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[5]  THEN
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
			Step_InitAnDT:=50;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=5;
		END_IF	
	END_IF		
	IF  arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error THEN
		An_Gohoming:=FALSE;//正极取片回原点中
		Step_InitAnDT:=9999;
	END_IF		
	
50://NG料盒气缸伸出
IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[5] OR arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Io.DIOnSwitch THEN
	arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;//正极纠偏气缸伸出
	IF  arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState THEN
		Step_InitAnDT:=60;	
	ELSIF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.Error1 OR  arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.Error2 THEN
		An_Gohoming:=FALSE;//正极取片回原点中
		Step_InitAnDT:=9999;
	END_IF	
ELSE
	Mach_Control.An_b.Error[41] :=TRUE;//正极机械手初始化时，叠台搬运升降不在避让位
	An_Gohoming:=FALSE;//正极取片回原点中
	Step_InitAnDT:=9999;
END_IF	
	
60://正极送片搬运平移、叠片搬运平移、送片搬运旋转轴回原点、正极纠偏X1、正极纠偏X2、正极纠偏Y回原点
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bHome:=TRUE;//正极送片搬运平移轴回原点
	//arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bHome:=TRUE;//正极送片搬运旋转轴回原点								
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.bHome:=TRUE;//正极纠偏X1
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.bHome:=TRUE;//正极纠偏X2				
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.bHome:=TRUE;//正极纠偏Y	
	An_CarryingTorMark:=TRUE;//正极搬运1移位力矩判断标志位									
	Step_InitAnDT:=70;
70://判断正极送片搬运平移、叠片搬运平移、送片搬运旋转回原点是否完成
	IF NOT An_GohomeTon.Q THEN		
		An_GohomeTon.IN:=TRUE;
	ELSE		
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving (*AND
		 arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Homed*) AND  arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.NoMoving  AND   						
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND 
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND
			arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving   THEN
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bHome:=FALSE;//正极送片搬运平移轴回原点
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bHome:=FALSE;//正极叠片搬运平移轴回原点
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bHome:=FALSE;//正极送片搬运旋转轴回原点		
			arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.bHome:=FALSE;//正极纠偏X1		
			arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.bHome:=FALSE;//正极纠偏X2
			arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.bHome:=FALSE;//正极纠偏Y
			An_CarryingTorMark:=FALSE;//正极搬运1移位力矩判断标志位			
			An_GohomeTon.IN:=FALSE;
			Step_InitAnDT:=75;
		ELSIF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Error OR				
			arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Error OR 
			arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Error THEN
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bHome:=FALSE;//正极送片搬运平移轴回原点
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bHome:=FALSE;//正极叠片搬运平移轴回原点
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bHome:=FALSE;//正极送片搬运旋转轴回原点		
			arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.bHome:=FALSE;//正极纠偏X1		
			arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.bHome:=FALSE;//正极纠偏X2
			arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.bHome:=FALSE;//正极纠偏Y
			An_GohomeTon.IN:=FALSE;
			An_Gohoming:=FALSE;//正极取片回原点中
			Step_InitAnDT:=9999;
		END_IF
	END_IF
75:
	//极送片搬运平移轴移动至初始位
	IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] THEN
		   arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.iGoSetPos:=0;
		 ELSE
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.iGoSetPos:=1; 
		END_IF	
	END_IF
	(*//正极送片搬运旋转轴移动至初始位
	IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1]  THEN
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.iGoSetPos:=1;
		END_IF
	END_IF*)
	//正极纠偏X1
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1]  THEN
			arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=1;
		END_IF
	END_IF
	//正极纠偏X2
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1]  THEN
			arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=1;
		END_IF
	END_IF	
	//正极纠偏Y
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1]  THEN
			arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=1;
		END_IF
	END_IF								
	
	IF 	arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving AND
		(*arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1] AND *)arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1]	 AND	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
					Step_InitAnDT:=80;
					arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bHome:=TRUE;//正极送片搬运旋转轴回原点
					
	ELSIF  arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Error AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Error AND 
		arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Error THEN
		An_Gohoming:=FALSE;//正极取片回原点中
		Step_InitAnDT:=9999;
	END_IF	
80://正极送片搬运旋转轴回原点	
IF  arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Homed		THEN
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bHome:=FALSE;//正极送片搬运旋转轴回原点	
	Step_InitAnDT:=83;	
END_IF			

83://正极送片搬运旋转轴移动至初始位
	IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1]  THEN
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.iGoSetPos:=0;
			Step_InitAnDT:=85;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.iGoSetPos:=1;
		END_IF
	END_IF

85://叠片搬运回原点							
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bHome:=TRUE;//正极叠片搬运平移轴回原点
	An_DTCarryingTorMark:=TRUE;//正极叠台搬运力矩判断标志位	
	Step_InitAnDT:=90;	
90://判断叠片搬运回原点是否完成
	IF NOT An_GohomeTon.Q THEN
		An_GohomeTon.IN:=TRUE;
	ELSE
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.NoMoving  THEN
			An_GohomeTon.IN:=FALSE;	
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bHome:=FALSE;//正极叠片搬运平移轴回原点
			An_DTCarryingTorMark:=FALSE;//正极叠台搬运力矩判断标志位	
			Step_InitAnDT:=100;
		ELSIF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Error THEN
			An_GohomeTon.IN:=FALSE;	
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bHome:=FALSE;//正极叠片搬运平移轴回原点
		    An_Gohoming:=FALSE;//正极取片回原点中
			Step_InitAnDT:=9999;
		END_IF
	END_IF
100://轴移动到初始位置	
	//正极叠片搬运平移轴移动至初始位
	IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1]  THEN
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.iGoSetPos:=0;
			Step_InitAnDT:=110;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.iGoSetPos:=1;
		END_IF	
	ELSIF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Error THEN
		An_Gohoming:=FALSE;//正极取片回原点中
		Step_InitAnDT:=9999;
	END_IF
110:
	arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;//正极搬运升降取料真空关
	arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;//正极搬运升降取料真空关
	
	arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=TRUE;//正极搬运升降取料破真空关
	arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=FALSE;//正极搬运升降取料破真空关
	
	arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=TRUE;//正极纠偏平台真空关
	arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=FALSE;//正极纠偏平台真空关
	
	arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bOFF:=TRUE;//正极纠偏平台破真空关
	arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bON:=FALSE;//正极纠偏平台破真空关
	
	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运真空关
	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运真空关
	
	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运破真空关	
	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极叠片搬运破真空关				
	//正极送片搬运升降移动至等待位
	IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
		   arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;
		 ELSE
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;
		END_IF
	END_IF
	//正极叠片搬运升降移动至等待位
	IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving THEN
		IF  arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
				arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
		 ELSE
				arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;
		END_IF	
	END_IF		
	IF  	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving  AND 
		arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving  THEN
		An_GohomeDone:=TRUE;//正极回原点完成
		An_Gohoming:=FALSE;//正极取片回原点中
		Step_InitAnDT:=0;
	ELSIF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error THEN
		An_Gohoming:=FALSE;//正极取片回原点中
		Step_InitAnDT:=9999;
	END_IF
END_CASE
END_IF				]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_OverNG" Id="{011afc7e-2d04-4747-ab6c-dc606d984c7a}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[DT_TON[1](IN:= , PT:=T#300MS , Q=> , ET=> );//
DT_TON[2](IN:= , PT:=T#300MS , Q=> , ET=> );//
DT_TON[3](IN:= , PT:=T#200MS , Q=> , ET=> );//
DT_TON[4](IN:= , PT:=T#200MS , Q=> , ET=> );//
(*******************************************************************************************************踢正极对齐度NG片**************************************************************************************************************************)
 IF   An_OverNGStep=1630 THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.fOverride:=50;
 ELSE
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.fOverride:=100;
 END_IF
 

 
 IF  AnOverNGcount>=3 OR CaOverNGcount>=3 THEN
     OversequelNG:=TRUE;	
 END_IF
 
IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下
   CASE An_OverNGStep OF   
			1000://判断正极叠台搬运是否有片，有片的话放到纠偏台
						fAnScaling:=1;//20240508 CF
		            	fCaScaling:=1;//20240508 CF		
						AnOverNGcount:=AnOverNGcount+1;
						IF arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch AND  Mach_Control.An_b.An_DPCarryingFalg  THEN//正极再取片位且叠台搬运有片,把当前片放到纠偏台
							An_OverNGStep:=1010;
						ELSE
							An_OverNGStep:=1050;	
						END_IF
	
			1010://纠偏台回初始位
				//纠偏平台X1移动至初始位
				IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					//纠偏平台X2移动至初始位
					IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					//纠偏平台X2移动至初始位
					IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
						DT_SingeMode();//单步选择	
						An_OverNGStep:=1020;
                        DT_TON[3].IN:=FALSE; 	
					END_IF	
				END_IF
			1020://叠台搬运极片放回纠偏台
				IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1]  AND NOT Mach_Control.An_b.An_deviationFalg THEN 
						IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
							arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
					    ELSE
							arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=2;//正极叠台搬运下降至取片位
					    END_IF
                   END_IF
				       IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
				           	/// 吸盘破真空    纠偏台开真空
				
							arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运升降真空关
							arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运升降真空关
						
							arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;	//正极纠偏台真空			
							arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;	//正极纠偏台真空	   
							DT_SingeMode();//单步选择	
							An_OverNGStep:=1030;
							DT_TON[3].IN:=TRUE;
							Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台有料标记
						    Mach_Control.An_b.An_DPCarryingFalg:=FALSE;//正极搬运真空吸盘有料标记复位
	                    END_IF
				END_IF
			1030://叠台搬运极片上升至凸轮耦合初始高度
				IF NOT DP_SinStepe  AND DT_TON[3].Q THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4]  THEN
						arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
						/// 吸盘破真空    纠偏台开真空
						Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台有料标记
						Mach_Control.An_b.An_DPCarryingFalg:=FALSE;//正极搬运真空吸盘有料标记复位
						Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[2];
						DT_SingeMode();//单步选择	
						An_OverNGStep:=1050;
						DT_TON[3].IN:=FALSE;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极搬运升降2上升至凸轮耦合初始高度
					END_IF			
				END_IF		   
		
            1050://判断主轴是否停止、是否在初始位、是否有轴在耦合中
					IF NOT DP_SinStepe THEN
								IF arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling THEN
									DT_SingeMode();//单步选择
									An_OverNGStep:=1070;
								ELSE
									DP_Step1:=100;//调用主轴回初始位子程序
									DT_SingeMode();//单步选择
									An_OverNGStep:=1060;
								END_IF
			    	END_IF		
			1060://判断主轴的模长的当前位置是否为0
				IF NOT DP_SinStepe THEN
					IF DP_Step1=6666 AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling  THEN
						DT_SingeMode();//单步选择
						An_OverNGStep:=1070;
					END_IF	
				END_IF							

			1070://判断NG气缸是否在安全位
					IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
						arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
						arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
						arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState AND 
                        arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]    THEN
						An_OverNGStep:=1100;		
					ELSE
						An_OverNGStep:=1080;	
					END_IF
			1080:
						arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Cmd.bOFF:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Cmd.bON:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Cmd.bON:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;
						IF   arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND  arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
							arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
							arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState THEN
							An_OverNGStep:=1090;									
						END_IF
			1090:
					arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;
					IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND  arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] 
                         AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
						An_OverNGStep:=1100;	
					END_IF	

              1100:
						IF NOT DP_SinStepe AND TailCurlSEPTA_SafePos THEN		
									Scan_TON[2].IN:=TRUE;	
										IF 	An_CarryingPos1  THEN//正极搬运、叠片各轴在初始位
											         Scan_TON[1].IN:=TRUE;	
													 DTPosError[11]:=FALSE;
													 IF CA_CarryingPos2  THEN//负极在叠片位	
														             DTPosError[12]:=FALSE;
																IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]   THEN													
																	DT_SingeMode();//单步选择											
																	An_OverNGStep:=1200;//													
																ELSE
																	Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在正极叠片位，也不在正极叠片位报警
																//	An_OverNGStep:=9991;	
																END_IF;
													ELSIF CA_CarryingPos1  THEN//负极在取片位	
                                                                  DTPosError[12]:=FALSE;																	
																IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]  THEN
																	DT_SingeMode();//单步选择										
																	An_OverNGStep:=1300;//
																ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] THEN
																	DT_SingeMode();//单步选择										
																	An_OverNGStep:=1400;//
																ELSE
																	Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在正极叠片位，也不在正极叠片位报警
																	//An_OverNGStep:=9992;	
																END_IF;							
													ELSIF Scan_TON[1].Q THEN
																Scan_TON[1].IN:=FALSE;	
																//An_OverNGStep:=9993;
															   DTPosError[12]:=TRUE;
													END_IF
							    	ELSE
											IF (Ca_Step0=0 OR Ca_Step0=6666) AND (Ca_Step3=0 OR Ca_Step3=6666) AND Scan_TON[2].Q THEN
												Scan_TON[2].IN:=FALSE;		
												//An_OverNGStep:=9994;
												DTPosError[11]:=TRUE;
											END_IF
								END_IF
					END_IF		

              1600:	 //正极叠片升降移动至放片高度 		  
	           			IF NOT DP_SinStepe THEN					
									 IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
										NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[2] AND
                                             arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]       THEN
											IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[3] THEN
												arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=3;//正极叠片升降移动至等待高度
											END_IF
									END_IF   	
								IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[3] THEN
								    DT_SingeMode();//单步选择
									An_OverNGStep:=1610;
								END_IF		
                       END_IF	   
		1610://	右刀升降轴上升至张开高度
						     arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极叠片搬运升降真空开
	                    	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//正极叠片搬运升降真空开
						IF NOT DP_SinStepe THEN								
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[15] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=15;//右压刀升降上升至抽刀高度
									END_IF
								END_IF				
								IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[15] THEN
							     	DT_SingeMode();//单步选择
									An_OverNGStep:=1620;
								END_IF
						END_IF	   
	
            1620://	右压刀开合轴至张开位			   
					   IF NOT DP_SinStepe THEN
										IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.NoMoving THEN
												IF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[2] THEN
													arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=2;//右压刀开合至张开位	
												END_IF		
										END_IF;	
											IF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[2] THEN
													DT_SingeMode();//单步选择
													An_OverNGStep:=1630;											
											END_IF
							END_IF;
				   
	
         1630:	 //正极叠片升降移动至a等待高度 		  
	           			IF NOT DP_SinStepe THEN					
								 IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
									NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[2] AND
										 arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[2]     THEN
										IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
											arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极叠片升降移动至等待高度
										END_IF
								END_IF 
                                (*
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=1;//右压刀升降上升至初始高度
									END_IF
								END_IF													
  	                            *)
								IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[15] AND
                                    arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving  AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving    THEN
						         	DT_SingeMode();//单步选择
									An_OverNGStep:=1670;
								END_IF		
                       END_IF	   						
 (*
  		1640://	压刀升降上升至初始高度	
					IF NOT DP_SinStepe THEN								
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=1;//右压刀升降上升至初始高度
									END_IF
								END_IF				
								IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
							     	DT_SingeMode();//单步选择
									An_OverNGStep:=1641;
								END_IF
						END_IF	   
	
		1641://	右压刀开合移至初始位		
			       IF NOT DP_SinStepe THEN
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=0;
											DT_SingeMode();//单步选择
											An_OverNGStep:=1650;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=1;//右压刀开合至初始位
										END_IF		
                                END_IF;	
					END_IF;				
					
		   	1650://右压刀升降下降至初始位，压隔膜			
					  IF NOT DP_SinStepe THEN
	                         	IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
									     	DT_SingeMode();//单步选择
									    	An_OverNGStep:=1670;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=1;//右压刀升降轴下降至初始高度
										END_IF
									END_IF							  
					  
					  END_IF					   
					   
		     //1660:	 //判断真空					   
	*)

           1670://判断主轴是否停止、是否在初始位、是否有轴在耦合中
					IF NOT DP_SinStepe THEN
								IF arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling THEN
									DT_SingeMode();//单步选择
									An_OverNGStep:=1691;
								ELSE
									DP_Step1:=100;//调用主轴回初始位子程序
									DT_SingeMode();//单步选择
									An_OverNGStep:=1690;
								END_IF
			    	END_IF		
			1690://判断主轴的模长的当前位置是否为0
				IF NOT DP_SinStepe THEN
					IF DP_Step1=6666 AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling  THEN
						DT_SingeMode();//单步选择
						An_OverNGStep:=1691;
					END_IF	
				END_IF				
		1691:
			    IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND (arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] OR arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[15] ) AND
					    arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState  AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
                        arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState   THEN
					An_OverNGStep:=1695;
				END_IF	
		
		    1695://				
					IF An_CarryingPos2 THEN//正极在叠片位
							An_OverNGStep:=1700;//
					ELSIF An_CarryingPos1  THEN//正极在取片位
							 An_OverNGStep:=1800;//
					ELSE
						  DTPosError[11]:=TRUE;//踢正极对齐度NG片 时，正极取片即不在取片位，也不在叠片位
					END_IF;
		
	

	        1800://	调用正极NG踢废		
                    DT_TON[2].IN:=FALSE;	
					CCD.Over.Start.iPhotoDo:=2;
					CCD.Over.Finish.OverhandResult:=0;
					Mach_Control.DT_b.OverhandResult:=0;
					Mach_Control.DT_b.CDD_OverStart:=TRUE;
					
			        Mach_Control.An_b.An_Quantited:=Mach_Control.An_b.An_Quantited-1;//正极已叠片数减一
                    An_Step2:=10; 
                    An_OverNGStep:=1810;

			1810://判断负极叠台搬运是否有片，有片的话放到纠偏台
			         DT_TON[2].IN:=TRUE;	
						IF arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch AND  Mach_Control.Ca_b.Ca_DPCarryingFalg  THEN//负极再取片位且叠台搬运有片,把当前片放到纠偏台
							An_OverNGStep:=1820;
						ELSE
							An_OverNGStep:=1850;	
						END_IF
	
			1820://纠偏台回初始位
				//纠偏平台X1移动至初始位
				IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					//纠偏平台X2移动至初始位
					IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					//纠偏平台X2移动至初始位
					IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
						DT_SingeMode();//单步选择	
						An_OverNGStep:=1830;	
						DT_TON[4].IN:=FALSE;
					END_IF	
				END_IF
			1830://叠台搬运极片放回纠偏台
				IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1]  AND NOT Mach_Control.Ca_b.Ca_deviationFalg THEN 
						IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
							arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
					    ELSE
							arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=2;//负极d叠台搬运下降至取片位
					    END_IF
                   END_IF
				       IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
				           	/// 吸盘破真空    纠偏台开真空
							arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;	//负极叠台搬运升降真空	真空
							arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;	//负极叠台搬运升降真空破真空								
							arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;	//负极纠偏台真空			
							arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;	//负极纠偏台真空	   
							DT_SingeMode();//单步选择	
							An_OverNGStep:=1840;
							DT_TON[4].IN:=TRUE;
							Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位位纠偏平台有料标记
							Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;//负极搬运真空吸盘有料标记复位
	                    END_IF
				END_IF
			1840://叠台搬运极片上升至凸轮耦合初始高度
				IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] AND DT_TON[4].Q THEN
						arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
						/// 吸盘破真空    纠偏台开真空
						Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位位纠偏平台有料标记
						Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;//负极搬运真空吸盘有料标记复位
						Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[9];
						DT_SingeMode();//单步选择	
						An_OverNGStep:=1850;
						DT_TON[4].IN:=FALSE;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极搬运升降2上升至凸轮耦合初始高度
					END_IF			
				END_IF		   
		

			
	        1860://等待正极NG踢废完成		
  
				
					 IF 	An_Step2=6666 THEN
						    An_OverNGStep:=0;
							DP_Step0:=0;
                           // An_OverNGMark:=FALSE;	
					 END_IF
	  END_CASE
END_IF

 CASE An_OverNGStep OF  
	 
		1850://
                  
				   IF Mach_Control.DT_b.OverhandResult<>3 AND  DT_TON[2].Q THEN
					  Mach_Control.An_b.Error[22]:=TRUE;//正极叠台搬运升降真空报警，电芯上有片，请拿掉 
				   END_IF
			
				 IF 	 Mach_Control.DT_b.OverhandResult=3 THEN
					     DT_TON[2].IN:=FALSE;	
						An_OverNGStep:=1860;
				 END_IF
 
 
 
 
     1200: //正到负取正极NG对其度片,	正极搬运与叠片各轴在初始位,负极在叠片位
	             VirMain_TON.IN:=FALSE;   
				//正到负_正极送片搬运平移轴凸轮耦合
				fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=1;
				fbAnCamInCarryingLine.bCamInExecute:=TRUE;	
		    	fbAnCamInCarryingUpDown.iTableSel:=3;      //20240528SJ
                fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;
			//正到负_正极叠片平移轴凸轮耦合
				fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
				fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;			
                fbAnCamInDTCarryingUpDown.iTableSel:=3;   //  //20240528SJ
                fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;
			//正到负_正极搬运旋转轴凸轮耦合		
				fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=1;
				fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;						
			
			//正到负_负极送片搬运平移轴凸轮耦合
				fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=-1;
				fbCaCamInCarryingLine2.bCamInExecute:=TRUE;
			   fbCaCamInCarryingUpDown2.iTableSel:=3; //20240528SJ
               fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;
			//正到负_负极叠片搬运平移轴凸轮耦合
				fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
				fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;
			    fbCaCamInDTCarryingUpDown.iTableSel:=3;  //20240528SJ
                fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
			//正到负_ 缓存轴轮耦合
				fbCamInGMBuffer2.iTableSel:=1;
				 fbCamInGMBuffer2.bCamInExecute:=TRUE;
			//正到负_隔膜平移轴凸轮耦合
				fbCamInGMDanserMove.iTableSel:=1;
				fbCamInGMDanserMove.bCamInExecute:=TRUE;
			
			//正到负_放卷虚轴凸轮耦合
				 fbCamInVirGMDriver2.iTableSel :=1;
				 fbCamInVirGMDriver2.bCamInExecute:=TRUE;		
					
					//判断凸轮是否耦合完成
						IF  fbAnCamInCarryingLine.bInSync  AND  fbAnCamInDTCarryingLine.bInSync AND fbAnCamInCarryingWhirling.bInSync AND 
							 fbCaCamInCarryingLine2.bInSync AND fbCaCamInDTCarryingLine.bInSync AND
							 fbCamInGMBuffer2.bInSync AND fbCamInGMDanserMove.bInSync AND 
							 fbCamInVirGMDriver2.bInSync   AND
							 fbAnCamInCarryingUpDown.bInSync AND fbAnCamInDTCarryingUpDown.bInSync AND fbCaCamInCarryingUpDown2.bInSync AND fbCaCamInDTCarryingUpDown.bInSync AND  
                            Mach_Control.U.DT_iMode=1  THEN
							An_OverNGStep:=1210;//
						ELSIF   fbAnCamInCarryingLine.bError  OR  fbAnCamInDTCarryingLine.bError OR 
							 fbCaCamInCarryingLine2.bError OR fbCaCamInDTCarryingLine.bError OR
							 fbCamInGMBuffer2.bError OR fbCamInGMDanserMove.bError OR 
							  fbAnCamInCarryingUpDown.bError OR fbAnCamInDTCarryingUpDown.bError OR fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingUpDown.bError OR  
							 fbCamInVirGMDriver2.bError THEN
								Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
								An_OverNGStep:=9991;										
						END_IF		
			1210://主轴启动
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;
									arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;		
									
									IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
										VirMain_TON.IN:=FALSE;
										arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
										An_OverNGStep:=1500;	
									ELSE
										IF NOT VirMain_TON.Q THEN
											VirMain_TON.IN:=TRUE;
										ELSE
											VirMain_TON.IN:=FALSE;
											Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
											An_OverNGStep:=10001;	
									END_IF	
				 	    END_IF		

           1300: //正到负取正极NG对其度片,正极搬运与叠片各轴在初始位,, 负极在取片位,  隔膜平移在负极位
		              VirMain_TON.IN:=FALSE;
						//正到负_正极送片搬运平移轴凸轮耦合
					fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=1;
					fbAnCamInCarryingLine.bCamInExecute:=TRUE;					
					fbAnCamInCarryingUpDown.iTableSel:=3;      //20240528SJ
					fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;
				//正到负_正极叠片平移轴凸轮耦合
					fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
					fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;		
					fbAnCamInDTCarryingUpDown.iTableSel:=3;   //  //20240528SJ
					fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;

			//正到负_正极搬运旋转轴凸轮耦合		
				fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=1;
				fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;							
								
					//判断凸轮是否耦合完成
						IF  fbAnCamInCarryingLine.bInSync AND fbAnCamInDTCarryingLine.bInSync AND  fbAnCamInCarryingWhirling.bInSync  AND 
                            fbAnCamInCarryingUpDown.bInSync AND  fbAnCamInDTCarryingUpDown.bInSync AND 
                            Mach_Control.U.DT_iMode=1 THEN
							An_OverNGStep:=1310;//
						ELSIF fbAnCamInCarryingLine.bError OR  fbAnCamInDTCarryingLine.bError  OR   fbAnCamInCarryingUpDown.bError OR   fbAnCamInDTCarryingUpDown.bError   THEN
								Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
								An_OverNGStep:=9992;										
						END_IF			   
		   
			1310://主轴启动
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;
									arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;			
						
									IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
										VirMain_TON.IN:=FALSE;
										arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
										An_OverNGStep:=1500;	
									ELSE
										IF NOT VirMain_TON.Q THEN
											VirMain_TON.IN:=TRUE;
										ELSE
											VirMain_TON.IN:=FALSE;
											Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
											An_OverNGStep:=10002;	
									END_IF	
				 	    END_IF							
										
	       1400: //正到负取正极NG对其度片,正极搬运与叠片各轴在初始位,, 负极在取片位,  隔膜平移在正极位	
			              VirMain_TON.IN:=FALSE;
						//正到负_正极送片搬运平移轴凸轮耦合
						fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=1;
						fbAnCamInCarryingLine.bCamInExecute:=TRUE;				
						fbAnCamInCarryingUpDown.iTableSel:=3;      //20240528SJ
						fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;

					//正到负_正极叠片平移轴凸轮耦合
						fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
						fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;
					   fbAnCamInDTCarryingUpDown.iTableSel:=3;   //  //20240528SJ
                       fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;
						
						
					//正到负_正极搬运旋转轴凸轮耦合		
						fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=1;
						fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;						
						
					//正到负_ 缓存轴轮耦合
						fbCamInGMBuffer2.iTableSel:=1;
						 fbCamInGMBuffer2.bCamInExecute:=TRUE;
						 
					//正到负_隔膜平移轴凸轮耦合
						fbCamInGMDanserMove.iTableSel:=1;
						fbCamInGMDanserMove.bCamInExecute:=TRUE;
						
					//正到负_放卷虚轴凸轮耦合
						 fbCamInVirGMDriver2.iTableSel :=1;
						 fbCamInVirGMDriver2.bCamInExecute:=TRUE;			   
						
					//判断凸轮是否耦合完成
						IF   fbAnCamInCarryingLine.bInSync  AND  fbAnCamInDTCarryingLine.bInSync AND   fbAnCamInCarryingWhirling.bInSync AND
							 fbCamInGMBuffer2.bInSync AND fbCamInGMDanserMove.bInSync AND 
							 fbAnCamInCarryingUpDown.bInSync AND fbAnCamInDTCarryingUpDown.bInSync AND 
							 fbCamInVirGMDriver2.bInSync  AND 
                            Mach_Control.U.DT_iMode=1  THEN
							An_OverNGStep:=1410;//
						ELSIF  fbAnCamInCarryingLine.bError  OR  fbAnCamInDTCarryingLine.bError OR 
							     fbCamInGMBuffer2.bError OR fbCamInGMDanserMove.bError OR 
								 fbAnCamInCarryingUpDown.bError OR  fbAnCamInDTCarryingUpDown.bError OR
							     fbCamInVirGMDriver2.bError THEN
										Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
										An_OverNGStep:=9993;										
						END_IF		
	
			1410://主轴启动
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;
									arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;					
									IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
										VirMain_TON.IN:=FALSE;
										arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
										An_OverNGStep:=1500;	
									ELSE
										IF NOT VirMain_TON.Q THEN
											VirMain_TON.IN:=TRUE;
										ELSE
											VirMain_TON.IN:=FALSE;
											Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
											An_OverNGStep:=10003;	
									END_IF	
				 	    END_IF							
   
			1500://
				(*IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>230 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<240 AND Mach_Control.Ca_b.Ca_DPCarryingFalg  THEN//198
					IF Mach_Control.DT_b.DT_CCD_TwoModel THEN
							CCD.CaRec.Finish.RectifyX1:=0;
							CCD.CaRec.Finish.RectifyX2:=0;
							CCD.CaRec.Finish.RectifyY:=0;		
							CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零									
							Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
							CCD.CaRec.Start.iPhotoDo:=2;//启动CCD第二次拍照									
					END_IF			
				END_IF	*)		
				
				IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
					DP_Step1:=100;//解除耦合，主轴回零子程序			
					An_OverNGStep:=1510;	
				END_IF	
			1510://			
				IF NOT DP_SinStepe THEN
					IF DP_Step1=6666 AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling  THEN
						DT_SingeMode();//单步选择
						An_OverNGStep:=1600;
					END_IF	
				END_IF	

		    1700://	/踢正极NG对齐度片回正极取片位,(正极轴不动 ) ,正极搬运叠片各轴在叠片位		
			         VirMain_TON.IN:=FALSE;
					//负到正_正极搬运平移轴凸轮耦合
					fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=-1;
					fbAnCamInCarryingLine.bCamInExecute:=TRUE;
					fbAnCamInCarryingUpDown.iTableSel:=3;      //20240528SJ
                   fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;
					
					//负到正_正极叠片平移轴凸轮耦合
					fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
					fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;	
					fbAnCamInDTCarryingUpDown.iTableSel:=3;   //  //20240528SJ
					fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;

					//负到正_正极搬运旋转轴凸轮耦合
						fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=-1;
						fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;								
				
				IF fbAnCamInCarryingLine.bInSync  AND 
					fbAnCamInDTCarryingLine.bInSync  AND
					fbAnCamInCarryingWhirling.bInSync AND  
                    fbAnCamInCarryingUpDown.bInSync AND   fbAnCamInDTCarryingUpDown.bInSync AND  
                    Mach_Control.U.DT_iMode=1  THEN   
					DT_SingeMode();//单步选择		
					An_OverNGStep:=1710;
				ELSIF fbAnCamInCarryingLine.bError OR //  fbCaCamInCarryingUpDown2.bError or
					  fbAnCamInDTCarryingLine.bError  OR  fbAnCamInCarryingUpDown.bError OR    fbAnCamInDTCarryingUpDown.bError   THEN   
					Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
					An_OverNGStep:=9994;
				END_IF		

				1710://主轴启动
				      				
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;
									arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;			
						IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
							VirMain_TON.IN:=FALSE;
							arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
							An_OverNGStep:=1720;	
						ELSE
								IF NOT VirMain_TON.Q THEN
									VirMain_TON.IN:=TRUE;
								ELSE
									VirMain_TON.IN:=FALSE;
									Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
									An_OverNGStep:=10004;	
							END_IF	
					   END_IF				

			1720://
				IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
					DP_Step1:=100;//解除耦合，主轴回零子程序			
					An_OverNGStep:=1730;	
				END_IF	
	
				
			1730://			
				IF NOT DP_SinStepe THEN
					IF DP_Step1=6666 AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling  THEN
						DT_SingeMode();//单步选择
						An_OverNGStep:=1800;
					END_IF	
				END_IF	
									
 END_CASE


	


]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_Rectifydev" Id="{ccc449a1-cf6c-4267-a739-407e3c7a54c2}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[rAnCCD_Ton(IN:= , PT:=T#1.5S , Q=> , ET=> );//正极CCD拍照超时报警
IF (NOT Mach_Control.An_b.An_deviationFalg AND Mach_Control.U.DT_iMode=1) AND NOT Mach_Control.An_b.Demarcateing   THEN
//IF NOT Mach_Control.An_b.An_deviationFalg THEN
	Mach_Control.An_b.RectifydevDone:=FALSE;
	An_CCD_Done:=FALSE;
	CCD.AnRec.Finish.RectifyX1:=0;
	CCD.AnRec.Finish.RectifyX2:=0;
	CCD.AnRec.Finish.RectifyY:=0;
END_IF

rAnCCD_Ton1(IN:=Mach_Control.An_b.An_CCDStart , PT:=T#0.1S , Q=> , ET=> );//正极CCD拍照启动复位
IF rAnCCD_Ton1.Q THEN
	Mach_Control.An_b.An_CCDStart :=FALSE;
END_IF


An_CQ_ton(IN:=arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Io.DOStatus1 , PT:=T#0.3S , Q=> , ET=>);
IF An_CQ_ton.Q THEN
	Mach_Control.An_b.An_Rectifydev_CQ:=FALSE;
	arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Cmd.bON:=FALSE;//正极纠偏平台除尘
	arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Cmd.bOFF:=TRUE;//正极纠偏平台除尘
END_IF



IF rAnUse[2].Q THEN
	CCD.AnRec.Finish.RectifyResult:=0;
	CCD.AnRec.Finish.RectifyX1:=0;
	CCD.AnRec.Finish.RectifyX2:=0;
	CCD.AnRec.Finish.RectifyY:=0;												
END_IF



IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下
//判断负极是否允许取纠偏
IF (Mach_Control.An_b.An_deviationFalg AND (An_CCD_Done OR Mach_Control.An_b.RectifydevDone)) (*AND CCD.AnRec.Finish.RectifyResult=1 AND Mach_Control.An_b.RectifydevDone)*) OR
	 (Mach_Control.An_b.An_deviationFalg AND CCD.AnRec.Finish.RectifyResult<>1 AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] AND 	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1]  AND 	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] )OR
	(Mach_Control.U.CCD_ChosesHMI  OR Mach_Control.U.EmptyRunMode)	 THEN
	Mach_Control.An_b.An_deviationDPOK:=TRUE;//取正极 偏平台极片允许
ELSE
	Mach_Control.An_b.An_deviationDPOK:=FALSE;
END_IF 	

	CASE An_StandbyStep0 OF
			0://判断正极纠偏平台是否有极片
				IF Mach_Control.An_b.An_deviationFalg AND NOT Mach_Control.U.EmptyRunMode  THEN
						IF NOT An_CCD_Done THEN
							CCD.AnRec.Finish.RectifyResult:=0;
							CCD.AnRec.Finish.RectifyX1:=0;
							CCD.AnRec.Finish.RectifyX2:=0;
							CCD.AnRec.Finish.RectifyY:=0;
							iMD11:=1;
							An_StandbyStep0:=10;
						END_IF
				ELSE
						iMD11:=2;
						An_RecdevPla_Step0:=0;
						Mach_Control.An_b.RectifydevStart :=FALSE;
						An_StandbyStep0:=10;
				END_IF
			10://正极纠偏平台回初始位
			IF  NOT Mach_Control.U.EmptyRunMode THEN
					Mach_Control.An_b.RectifydevStart :=FALSE;//复位纠偏启动
					Mach_Control.An_b.RectifydevDone:=FALSE;//复位纠偏完成
					IF Mach_Control.An_b.CarryingSafepos[4] THEN
							//纠偏平台X1移动至初始位
							IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Error THEN
								IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=1;
								END_IF					
							END_IF
							//纠偏平台X2移动至初始位
							IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Error THEN
								IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=1;
								END_IF					
							END_IF
							//纠偏平台X2移动至初始位
							IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Error THEN
								IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=1;
								END_IF					
							END_IF	
							IF 	 arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] AND 	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1]  AND 	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
									IF  iMD11=1 THEN
											 An_StandbyStep0:=101;
											 rAnCCD_Ton.IN:=FALSE;
									 ELSIF  iMD11=2 THEN
											An_StandbyStep0:=0;
									 END_IF  			
							END_IF						
					END_IF
	END_IF
			101:
					CCD.AnRec.Finish.RectifyResult:=0;
					Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照						
					CCD.AnRec.Start.iPhotoDo:=1;//第一次拍照	
					CCD.AnRec.Start.stPoleNo:=Par.stDT_date.An_MQ_Slice[1].stPoleNo;	
					An_StandbyStep0:=110;	
			110:
					IF NOT rAnCCD_Ton.Q THEN						
						rAnCCD_Ton.IN:=TRUE;
						IF Mach_Control.An_b.An_deviationCCDDone OR Mach_Control.U.CCD_ChosesHMI THEN
							rAnCCD_Ton.IN:=FALSE;
							An_CCD_Done:=TRUE;
							An_StandbyStep0:=111;
						END_IF
					ELSE
							rAnCCD_Ton.IN:=FALSE;
							Mach_Control.An_b.Error[7]:=TRUE;//正极CCD第一次拍照超时
							An_StandbyStep0:=9999;
					END_IF
			
			111://启动拍照			
					Mach_Control.An_b.An_CCDStart :=FALSE;//启动CCD拍照						
					rAnCCD_Ton.IN:=FALSE;
					An_StandbyStep0:=0;					

	END_CASE
ELSE
//正极纠偏平台CCD标定自动
IF Mach_Control.An_b.DemarcateStart THEN
	CCD.AnRec.Start.iPhotoDo:=1;//第一次拍照	
END_IF
An_Demarcate(
	Step0:=An_Demarcate_Step0,
	AxisX1_NO:=AxiseNo.AxisName.AndeviationX1 , //正极纠偏X1轴号
	AxisX2_NO:=AxiseNo.AxisName.AndeviationX2 , //正极纠偏X2轴号
	AxisY_NO:=AxiseNo.AxisName.AndeviationY , //正极纠偏Y轴号
	DemarcateStart:=Mach_Control.An_b.DemarcateStart , //纠偏平台CCD标定启动
	CCDStart:=Mach_Control.An_b.An_CCDStart , //CCD拍照启动
	CCDNo:=CCD.AnRec.iDemCount,//CCD拍照次数
	DemarcateResult:=CCD.AnRec.iDemarcatResult,//标定结果
	DemarcateDone:=Mach_Control.An_b.DemarcateDone ,//CCD标定完成
	Demarcateing:=Mach_Control.An_b.Demarcateing,	//CCD标定中
	Error :=Mach_Control.An_b.Error[8]  );//CCD标定NG
END_IF
//正极纠偏自动
rAn_RecdevPlaR_TRIG(CLK:=Mach_Control.An_b.An_deviationFalg AND (CCD.AnRec.Finish.RectifyResult=1 OR CCD.AnRec.Finish.RectifyResult=2 ) AND NOT Mach_Control.U.CCD_ChosesHMI AND NOT Mach_Control.An_b.RectifydevDone AND 
										 		(CCD.AnRec.Finish.RectifyX1<>0 OR CCD.AnRec.Finish.RectifyX2<>0 OR CCD.AnRec.Finish.RectifyY<>0) AND CCD.AnRec.Start.iPhotoDo=1  , Q=> );//AND NOT Mach_Control.An_b.An_VacuumErrorNG
IF rAn_RecdevPlaR_TRIG.Q  THEN//AND NOT Blueflaging
	Mach_Control.An_b.RectifydevStart:=TRUE;
END_IF

//纠偏结果限定
IF (CCD.AnRec.Finish.RectifyX1>=15 OR CCD.AnRec.Finish.RectifyX2>=15 OR CCD.AnRec.Finish.RectifyY>=10 OR
	CCD.AnRec.Finish.RectifyX1<=-15 OR CCD.AnRec.Finish.RectifyX2<=-15 OR CCD.AnRec.Finish.RectifyY<=-10) AND NOT Mach_Control.An_b.Demarcateing THEN
	CCD.AnRec.Finish.RectifyX1:=0;
	CCD.AnRec.Finish.RectifyX2:=0;
	CCD.AnRec.Finish.RectifyY:=0;
END_IF


CCD.AnRec.Finish.Offset_X:=fCaOffsetMean_X;
CCD.AnRec.Finish.Offset_Y:=fCaOffsetMean_Y;

An_RecdevPla(
	Step0:=An_RecdevPla_Step0,
	RecdevStart:=Mach_Control.An_b.RectifydevStart , //正极纠偏平台纠偏启动
	RecdevDone:=Mach_Control.An_b.RectifydevDone , //正极纠偏平台纠偏完成
	RecdevAgree:=Mach_Control.An_b.CarryingSafepos[4] , //正极纠偏平台纠偏允许
	AxisX1_NO:=AxiseNo.AxisName.AndeviationX1  , //正极纠偏平台X1轴号
	AxisX2_NO:=AxiseNo.AxisName.AndeviationX2 , //正极纠偏平台X2轴号
	AxisY_NO:=AxiseNo.AxisName.AndeviationY  , //正极纠偏平台Y轴号
	CCD_X1:=CCD.AnRec.Finish.RectifyX1 ,//正极纠偏平台X1纠偏量
	CCD_X2:=CCD.AnRec.Finish.RectifyX2 , //正极纠偏平台X2纠偏量
	CCD_Y:=CCD.AnRec.Finish.RectifyY );//正极纠偏平台Y纠偏量
	
//纠偏平台重复精度测试
AN_RectifyTry_fb(
	Execute:=Mach_Control.An_b.RectifyTryStart AND Mach_Control.U.DT_iMode=3 , //纠偏平台重复精度测试启动 
	AxisNO_X:=AxiseNo.AxisName.AndeviationX1 , 
	AxisNO_Y:= AxiseNo.AxisName.AndeviationX2, 
	AxisNO_R:=AxiseNo.AxisName.AndeviationY , 
	Demarcate_X:=Par.stDT_date.An_Demarcate_X , //纠偏平台重复精度测试X纠偏量
	Demarcate_Y:=Par.stDT_date.An_Demarcate_Y , //纠偏平台重复精度测试Y纠偏量
	Demarcate_R:=Par.stDT_date.An_Demarcate_R ,  //纠偏平台重复精度测试R纠偏量
	CCDNo:=Par.stDT_date.An_CCDNo, //纠偏平台重复精度测试次数
	CCDStart:= Mach_Control.An_b.An_CCDStart );
	
//吸盘重复精度测试		
An_SuckerTest_fb(
	Execute:=Mach_Control.An_b.SuckerTestStart AND Mach_Control.U.DT_iMode=3 , //吸盘重复精度测试启动 , 
	AxisNO_1:= AxiseNo.AxisName.AnDTCarryingUpDown, 
	AxisNO_2:=AxiseNo.AxisName.AnDTCarryingLine , 
	AxisNO_X:= AxiseNo.AxisName.AndeviationX1 , 
	AxisNO_Y:= AxiseNo.AxisName.AndeviationX2, 
	AxisNO_R:= AxiseNo.AxisName.AndeviationY , 
	DTCarryingVacuum:=arrCyNo.ElectValveName.AnDTCarryingVacuum , 
	deviationVacuum:= arrCyNo.ElectValveName.AndeviationVacuum, 
	deviationVacuumBark:=arrCyNo.ElectValveName.AndeviationVacuumBark, 
	CCDCount:= Par.stDT_date.An_CCDCount, //吸盘重复精度测试次数
	CCDStart:=Mach_Control.An_b.An_CCDStart,	
	CCD_X1:=CCD.AnRec.Finish.RectifyX1 ,//正极纠偏平台X1纠偏量
	CCD_X2:=CCD.AnRec.Finish.RectifyX2 , //正极纠偏平台X2纠偏量
	CCD_Y:=CCD.AnRec.Finish.RectifyY,//正极纠偏平台Y纠偏量
    DTiMode:= Mach_Control.U.DT_iMode  );
	
	//正极通讯监控
rtAn_CCDTest1(CLK:=Mach_Control.An_b.bAnCCD_TestDo , Q=> );
IF rtAn_CCDTest1.Q THEN
	bAn_CCDTest1:=FALSE;
	bAn_CCDTest2:=FALSE;
END_IF
IF Mach_Control.An_b.bAnCCD_TestDo THEN
	rtAn_CCDTest2(CLK:=Mach_Control.An_b.An_CCDStart , Q=> );
	rtAn_CCDTest3(CLK:=CCD.AnRec.Finish.RectifyResult<>0 , Q=> );
	rtAn_CCDTest4(CLK:=Mach_Control.An_b.An_deviationCCDDone , Q=> );
	IF rtAn_CCDTest2.Q THEN
		bAn_CCDTest1:=TRUE;
		bAn_CCDTest2:=TRUE;
		CCD.AnRec.Finish.RectifyResult:=0;
	END_IF
	IF rtAn_CCDTest3.Q THEN
		bAn_CCDTest1:=FALSE;
	END_IF	
	IF rtAn_CCDTest4.Q THEN
		bAn_CCDTest2:=FALSE;
	END_IF
	tonAn_CCDTest1(IN:=bAn_CCDTest1 , PT:=T#999MS , Q=> , ET=> );
	tonAn_CCDTest2(IN:=bAn_CCDTest2 , PT:=T#999MS , Q=> , ET=> );
	IF bAn_CCDTest1 THEN
		Mach_Control.An_b.iAnCCD_RectifyCT:= TIME_TO_INT(tonAn_CCDTest1.ET);
	END_IF
	IF bAn_CCDTest2 THEN
		Mach_Control.An_b.iAnCCD_PhotoCT:= TIME_TO_INT(tonAn_CCDTest2.ET);
	END_IF
	IF tonAn_CCDTest1.Q THEN
		Mach_Control.An_b.bAnCCD_TestDo:=FALSE;
	END_IF
END_IF
	
//正极白班NG计数
IF HMI_Hour>=8 AND HMI_Hour<20 AND An_Step2>50 AND An_Step2<70 THEN
  IF CCD.AnRec.Finish.NG_Code = 1 THEN
   CCD.AnRec.DayNgclassification.X1_NG :=CCD.AnRec.DayNgclassification.X1_NG+1 ;
   CCD.AnRec.Finish.NG_Code := 0 ;
  ELSIF CCD.AnRec.Finish.NG_Code = 2 THEN
   CCD.AnRec.DayNgclassification.X2_NG := CCD.AnRec.DayNgclassification.X2_NG+1 ;  
   CCD.AnRec.Finish.NG_Code := 0 ;
  ELSIF CCD.AnRec.Finish.NG_Code = 3 THEN
   CCD.AnRec.DayNgclassification.Y_NG := CCD.AnRec.DayNgclassification.Y_NG+1 ;  
   CCD.AnRec.Finish.NG_Code := 0 ;
  ELSIF CCD.AnRec.Finish.NG_Code = 4 THEN
   CCD.AnRec.DayNgclassification.R_NG := CCD.AnRec.DayNgclassification.R_NG+1 ;   
   CCD.AnRec.Finish.NG_Code := 0 ; 
  ELSIF CCD.AnRec.Finish.NG_Code = 5 THEN 
   CCD.AnRec.DayNgclassification.other_NG :=  CCD.AnRec.DayNgclassification.other_NG+1;
   CCD.AnRec.Finish.NG_Code := 0 ;
  END_IF	
END_IF  

DayClear1(CLK:=(HMI_Hour=8 AND HMI_Minute=0 AND HMI_Second=0 ) , Q=> );
NightClear1(CLK:=(HMI_Hour=20 AND HMI_Minute=0 AND HMI_Second=0) , Q=> );

//正极白班N清零
IF DayClear1.Q  THEN
  Par.stDT_date.An_Rectifydev_DayNG:=0;
END_IF 

IF CCD.AnRec.DayNgclassification.NgClear[1] OR DayClear1.Q  THEN
   CCD.AnRec.DayNgclassification.X1_NG :=0 ;
END_IF

IF CCD.AnRec.DayNgclassification.NgClear[2] OR DayClear1.Q  THEN
   CCD.AnRec.DayNgclassification.X2_NG :=0 ;
END_IF

IF CCD.AnRec.DayNgclassification.NgClear[3] OR DayClear1.Q  THEN
   CCD.AnRec.DayNgclassification.Y_NG :=0 ;
END_IF

IF CCD.AnRec.DayNgclassification.NgClear[4] OR DayClear1.Q  THEN
   CCD.AnRec.DayNgclassification.R_NG :=0 ;
END_IF	

IF CCD.AnRec.DayNgclassification.NgClear[5] OR DayClear1.Q  THEN
   CCD.AnRec.DayNgclassification.other_NG :=0 ;
END_IF	
	
//正极晚班NG计数
IF ((HMI_Hour>=0 AND HMI_Hour<8) OR  (HMI_Hour>=20 AND HMI_Hour<=23)) AND An_Step2>50 AND An_Step2<70  THEN
  IF CCD.AnRec.Finish.NG_Code = 1 THEN
   CCD.AnRec.NightNgclassification.X1_NG :=CCD.AnRec.NightNgclassification.X1_NG+1 ;
   CCD.AnRec.Finish.NG_Code := 0 ;
  ELSIF CCD.AnRec.Finish.NG_Code = 2 THEN
   CCD.AnRec.NightNgclassification.X2_NG := CCD.AnRec.NightNgclassification.X2_NG+1 ;  
   CCD.AnRec.Finish.NG_Code := 0 ;
  ELSIF CCD.AnRec.Finish.NG_Code = 3 THEN
   CCD.AnRec.NightNgclassification.Y_NG := CCD.AnRec.NightNgclassification.Y_NG+1 ;  
   CCD.AnRec.Finish.NG_Code := 0 ;
  ELSIF CCD.AnRec.Finish.NG_Code = 4 THEN
   CCD.AnRec.NightNgclassification.R_NG := CCD.AnRec.NightNgclassification.R_NG+1 ;   
   CCD.AnRec.Finish.NG_Code := 0 ; 
  ELSIF CCD.AnRec.Finish.NG_Code = 5 THEN 
   CCD.AnRec.NightNgclassification.other_NG :=  CCD.AnRec.NightNgclassification.other_NG+1;
   CCD.AnRec.Finish.NG_Code := 0 ;
  END_IF	
END_IF  

//正极晚班NG清零
IF  NightClear1.Q  THEN
   Par.stDT_date.An_Rectifydev_NightNG:=0;
END_IF

IF CCD.AnRec.NightNgclassification.NgClear[1] OR NightClear1.Q  THEN
   CCD.AnRec.NightNgclassification.X1_NG :=0 ;
END_IF

IF CCD.AnRec.NightNgclassification.NgClear[2] OR NightClear1.Q  THEN
   CCD.AnRec.NightNgclassification.X2_NG :=0 ;
END_IF

IF CCD.AnRec.NightNgclassification.NgClear[3] OR NightClear1.Q  THEN
   CCD.AnRec.NightNgclassification.Y_NG :=0 ;
END_IF

IF CCD.AnRec.NightNgclassification.NgClear[4] OR NightClear1.Q  THEN
   CCD.AnRec.NightNgclassification.R_NG :=0 ;
END_IF	

IF CCD.AnRec.NightNgclassification.NgClear[5] OR NightClear1.Q  THEN
   CCD.AnRec.NightNgclassification.other_NG :=0 ;
END_IF	]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_StandbyMain" Id="{d6a1760a-b5d3-4ed9-8dba-4c61cfb6eab1}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[An_TON[1](PT:=T#0.5S);//正极拍照结果超时报警
An_TON[2](PT:=T#5S);//叠台主轴启动超时报警延时
An_TON[3](PT:=T#0.5S);
An_TON[5](PT:=T#10MS);
An_TON[6](PT:=T#0.2S);
An_TON[7](PT:=T#0.3S);
An_TON[8](PT:=T#0.3S);
An_TON[9](PT:=T#0.1S);
An_TON[10](PT:=T#2.5S);
An_TON[11](PT:=T#2.5S);
//An_StandbyStep1



IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下	
	(**********************************************************************正极备料自动**********************************************************************************)
	CASE An_StandbyStep1 OF
	1000://处理负极片取 AND AN_CarryingPos1
		IF NOT DP_SinStepe THEN
			An_TON[7].IN:=TRUE;
			IF Mach_Control.An_b.An_CarryingFalg AND  Mach_Control.An_b.An_DPCarryingFalg AND  NOT Mach_Control.An_b.An_deviationFalg   AND 
			   ( CCD.AnRec.Finish.RectifyResult=1 OR Mach_Control.U.CCD_ChosesHMI	  OR Mach_Control.U.EmptyRunMode (*OR Blueflaging*)	)THEN	
					An_StandbyStep1:=6666;	//正极取料完成
			//正极搬运、叠台搬运、纠偏平台都无料---状态1
			ELSIF NOT Mach_Control.An_b.An_CarryingFalg AND  NOT Mach_Control.An_b.An_DPCarryingFalg AND NOT Mach_Control.An_b.An_deviationFalg  THEN   // 状态1  0   0    0		 	OK   				      	                             
				IF AN_CarryingPos1 THEN 
					An_StandbyStep1:=2000;//取流水线的极片	
				ELSIF AN_CarryingPos2 THEN 
					iND1:=3;
					An_StandbyStep1:=6000;//
				ELSIF (An_Step0=6666 OR An_Step0=0) AND ( An_Step3=6666 OR An_Step3=0) AND An_TON[7].Q THEN
					//Mach_Control.DT_b.Error[8]:=TRUE;//取正极片凸轮耦合时，正极取片轴不在取片位也不在叠片位报警
					An_StandbyStep1:=9993;
					AnPosError[1]:=TRUE;
				END_IF		
			//正极搬运吸盘有料，叠台搬运、纠偏台无料----状态2
			ELSIF Mach_Control.An_b.An_CarryingFalg AND  NOT Mach_Control.An_b.An_DPCarryingFalg AND  NOT Mach_Control.An_b.An_deviationFalg AND   Mach_Control.Ca_b.Ca_Quantited<>0 THEN  // 状态2  1  0  0		
				IF AN_CarryingPos1 THEN  		
					IF Mach_Control.An_b.An_deviationFPOK   THEN//需要判断热切横移轴在安全位
						DT_SingeMode();//单步选择		
						iND1:=1;	
						An_StandbyStep1:=6000;//通过凸轮耦合放极片到纠偏平台
					END_IF
				ELSIF AN_CarryingPos2  THEN			
					An_StandbyStep1:=2500;//  负极送片搬运放片到纠偏台					      					
				ELSIF (An_Step0=6666 OR An_Step0=0)  AND ( An_Step3=6666 OR An_Step3=0) AND An_TON[7].Q THEN
					//Mach_Control.DT_b.Error[8]:=TRUE;//叠负极片凸轮耦合时，负极取片轴不在耦合位报警
					An_StandbyStep1:=9993;
					AnPosError[2]:=TRUE;									   										 
				END_IF	
			//正极搬运、叠台搬运无料，纠偏台有料----状态3	
			ELSIF NOT Mach_Control.An_b.An_CarryingFalg AND  NOT Mach_Control.An_b.An_DPCarryingFalg AND  Mach_Control.An_b.An_deviationFalg THEN // 状态3    0  0  1
				IF AN_CarryingPos1 THEN  									
					IF (CCD.AnRec.Finish.RectifyResult=1 OR  Mach_Control.U.CCD_ChosesHMI OR Mach_Control.U.EmptyRunMode  (*OR  Blueflaging *))  THEN								        	
						An_TON[1].IN:=FALSE;				
						An_StandbyStep1:=2100;//取流水线的极片、同时取纠偏平台的极片
					ELSIF CCD.AnRec.Finish.RectifyResult=2 OR CCD.AnRec.Finish.RectifyResult= 3 OR CCD.AnRec.Finish.RectifyResult= 4  THEN
						//   DT_SingeMode();//单步选择			
						An_TON[1].IN:=FALSE;			
						An_StandbyStep1:=2200;//取纠偏平台的极片，再踢纠偏平台的NG片，同时取流水线的片
					ELSE
						IF NOT An_TON[1].Q THEN
							An_TON[1].IN:=TRUE;
						ELSE
							An_TON[1].IN:=FALSE;
							Mach_Control.An_b.Error[36]:=TRUE;//正极CCD第一次拍照超时
							An_StandbyStep1:=9999;
						END_IF
					END_IF
				ELSIF  AN_CarryingPos2 THEN
					IF Mach_Control.An_b.An_deviationDPOK   THEN//   
						DT_SingeMode();//单步选择		
						iND1:=2;	
						An_StandbyStep1:=6000;//通过凸轮耦合放极片到纠偏平台
					END_IF
				ELSIF (An_Step0=6666 OR An_Step0=0)  AND ( An_Step3=6666 OR An_Step3=0) AND An_TON[7].Q THEN
					//Mach_Control.DT_b.Error[8]:=TRUE;//叠负极片凸轮耦合时，负极取片轴不在耦合位报警
					 An_StandbyStep1:=9993;
					 AnPosError[3]:=TRUE;
				END_IF		
			//正极搬运吸盘有料，叠台搬运无料，纠偏台有料-----状态4
			ELSIF Mach_Control.An_b.An_CarryingFalg AND  NOT Mach_Control.An_b.An_DPCarryingFalg AND   Mach_Control.An_b.An_deviationFalg  THEN 
				IF Mach_Control.An_b.An_deviationDPOK AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1]AND 
					arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.NoMoving
					AND (An_Step3=6666 OR An_Step3=0) THEN				
					An_StandbyStep1:=4000;//单独取纠偏平台
					An_Step3:=10;	
				END_IF
			//正极搬运吸盘无料，叠台搬运有纠偏OK料，纠偏平台无料-----状态5，流水取料且不丢NG
			ELSIF  ( Mach_Control.An_b.An_DPCarryingFalg AND  CCD.AnRec.Finish.RectifyResult=1 OR Mach_Control.U.EmptyRunMode OR  Mach_Control.U.CCD_ChosesHMI(* OR  Blueflaging*)	) AND NOT  Mach_Control.An_b.An_deviationFalg AND (An_Step0=6666 OR An_Step0=0) THEN// 状态4 正常       0 (1)     1 0    				
				IF  AN_CarryingPos1 THEN   
					IF  NOT Mach_Control.An_b.An_CarryingFalg THEN
						An_StandbyStep1:=2000;//取流水线的极片		
					END_IF
				ELSIF    An_TON[7].Q THEN// ------------------------20231209新增(An_Step0=6666 OR An_Step0=0)  AND
					  //Mach_Control.DT_b.Error[8]:=TRUE;//叠负极片凸轮耦合时，负极取片轴不在耦合位报警
					   An_StandbyStep1:=9993;
					   AnPosError[4]:=TRUE;
				END_IF			
			//	正极搬运吸盘无料，叠台搬运有纠偏NG料，纠偏台无料----状态6，取流水线极片且叠台搬运丢NG片			
			ELSIF  ( Mach_Control.An_b.An_DPCarryingFalg AND  CCD.AnRec.Finish.RectifyResult<>1 ) AND  NOT  Mach_Control.An_b.An_deviationFalg AND  NOT    Mach_Control.U.CCD_ChosesHMI AND (An_Step0=6666 OR An_Step0=0) THEN			// 状态5        0 (1)     1 0    
				   IF  AN_CarryingPos1 THEN      		
					  IF  NOT Mach_Control.an_b.An_CarryingFalg THEN    
						An_StandbyStep1:=2300;//踢纠偏平台的NG片，同时取流水线的片	     
					  ELSIF   Mach_Control.an_b.An_CarryingFalg THEN     
						An_StandbyStep1:=2400;//踢纠偏平台的NG片，同时取流水线的片	    
					  END_IF      
				   ELSIF   An_TON[7].Q THEN// ------------------------20231209新增(An_Step0=6666 OR An_Step0=0)
					  //Mach_Control.DT_b.Error[8]:=TRUE;//叠负极片凸轮耦合时，负极取片轴不在耦合位报警
					   An_StandbyStep1:=9993;
					   AnPosError[5]:=TRUE;
				  END_IF				
			END_IF	
		END_IF
	//取料流程调用				
	2000://调用取流水线子程序
		IF NOT DP_SinStepe THEN
			IF An_Step0=0 OR An_Step0=6666 THEN
				An_Step0:=10;//正极取流水线子程序
			END_IF
			DT_SingeMode();//单步选择		
			An_StandbyStep1:=2010;	
		END_IF	
	2010://判断取料是否完成
		IF An_Step0=6666 THEN
			DT_SingeMode();//单步选择		
			An_StandbyStep1:=1000;	
		END_IF				
	2100://调用取流水线子程序，取纠偏极片子程序
		IF NOT DP_SinStepe THEN
			IF An_Step0=0 OR An_Step0=6666 THEN
				An_Step0:=10;//正极取流水线子程序
			END_IF
				An_Step3:=10;//正极取纠偏平台子程序
				DT_SingeMode();//单步选择					
				An_StandbyStep1:=2110;	
		END_IF
	2110://判断正极取片流水线的极片、取纠偏平台的极片是否完成
		IF NOT DP_SinStepe THEN
			IF 	An_Step0=6666 AND 	An_Step3=6666 THEN
				DT_SingeMode();//单步选择							
				An_StandbyStep1:=1000;	
			END_IF
		END_IF			
	2200://先取纠偏平台的极片，同时根据条件判断是否可以取流水线的极片
		IF NOT DP_SinStepe THEN
			An_Step0:=10;//正极取流水线子程序
			An_Step3:=10;//正极取纠偏平台子程序
			 DT_SingeMode();//单步选择								
			An_StandbyStep1:=2210;	
		END_IF
	2210://判断取纠极片是否完成
		IF NOT DP_SinStepe THEN
			IF An_Step0=6666 AND An_Step3=6666 THEN
				An_Step2:=10;
				DT_SingeMode();//单步选择								
				An_StandbyStep1:=2220;
			END_IF
		END_IF
	2220://判断取流水线极片，踢NG极片是否完成
		IF NOT DP_SinStepe THEN
			IF   An_Step2=6666  THEN
				 DT_SingeMode();//单步选择							
				An_StandbyStep1:=1000;
			END_IF	
		END_IF
	2300://调用取流水线极片，调用踢NG片子程序
		IF NOT DP_SinStepe THEN
			An_Step0:=10;//正极取流水线子程序
			//An_Step3:=10;//正极取纠偏平台子程序
			 DT_SingeMode();//单步选择								
			An_StandbyStep1:=2310;	
		END_IF
	2310://判断取流水线极片、踢NG片是否完成
		IF NOT DP_SinStepe THEN
			IF An_Step0=6666 (*AND An_Step3=6666*) THEN
				An_Step2:=10;
				DT_SingeMode();//单步选择								
				An_StandbyStep1:=2320;
			END_IF
		END_IF
	2320:				
		IF NOT DP_SinStepe THEN
			IF   An_Step2=6666  THEN
				 DT_SingeMode();//单步选择							
				An_StandbyStep1:=1000;
			END_IF	
		END_IF			
	2400://调用踢NG片子程序
		IF NOT DP_SinStepe THEN							
			 DT_SingeMode();//单步选择								
			An_StandbyStep1:=2410;	
		END_IF
	2410://判断取流水线极片、踢NG片是否完成
		IF NOT DP_SinStepe THEN		
			An_Step2:=10;
			DT_SingeMode();//单步选择								
			An_StandbyStep1:=2420;							
		END_IF
	2420:				
		IF NOT DP_SinStepe THEN
			IF   An_Step2=6666  THEN
				DT_SingeMode();//单步选择							
				An_StandbyStep1:=1000;
			END_IF	
		END_IF			
	2500:
		IF NOT DP_SinStepe THEN
			An_Step1:=10;
			DT_SingeMode();//单步选择						
			An_StandbyStep1:=2510;	
		 END_IF
	2510:
		IF NOT DP_SinStepe THEN
			IF An_Step1=6666 THEN
				DT_SingeMode();//单步选择					
				An_StandbyStep1:=1000;
			END_IF
		END_IF									
	3030:		  // OK
		IF NOT DP_SinStepe THEN
			IF AN_CarryingPos1  THEN//正极搬运、叠片各轴在初始位
				IF CA_CarryingPos2  THEN//负极在叠片位
					IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] THEN
						 DT_SingeMode();//单步选择	
						 IF  NOT Mach_Control.Ca_b.Ca_DPCarryingFalg  AND  Mach_Control.Ca_b.Ca_deviationFalg  AND Mach_Control.Ca_b.Ca_deviationDPOK AND TailCurlSEPTA_SafePos THEN  //叠片搬运需要取片
								 iCaCamInSel2:=1;
						  ELSE
								iCaCamInSel2:=2;
						 END_IF    
						An_StandbyStep1:=3110;//
					ELSE
						Mach_Control.DT_b.Error[6]:=TRUE;//隔膜平移不在正极片位
						An_StandbyStep1:=9991;
					END_IF
				 ELSIF  CA_CarryingPos1 THEN //负极取片位
					IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] THEN
						  DT_SingeMode();//单步选择									
						  An_StandbyStep1:=3040;//
					ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]  THEN
							  DT_SingeMode();//单步选择			
								An_StandbyStep1:=3050;//
					ELSE
						Mach_Control.DT_b.Error[6]:=TRUE;//隔膜平移不在正极片位
						An_StandbyStep1:=9992;
					END_IF					
				ELSE
					//Mach_Control.DT_b.Error[7]:=TRUE;//叠正极片凸轮耦合时，负极取片即不在取片位，也不在叠片位
					An_StandbyStep1:=9994;
					AnPosError[7]:=TRUE;
				END_IF
			ELSE
				//Mach_Control.DT_b.Error[8]:=TRUE;//叠正极片凸轮耦合时，正极片不在取片位
				An_StandbyStep1:=9993;
				AnPosError[6]:=TRUE;
			END_IF
		END_IF		
	4000:
		IF An_Step3=6666 THEN
			An_StandbyStep1:=4100;
		END_IF
	
	4100:
		An_StandbyStep1:=1000;
	6000://判断主轴是否停止、是否在初始位、是否有轴在耦合中
		IF NOT DP_SinStepe THEN
			IF arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling THEN
				DT_SingeMode();//单步选择
				An_StandbyStep1:=6024;
			ELSE
				DP_Step1:=100;//调用主轴回初始位子程序
				DT_SingeMode();//单步选择
				An_StandbyStep1:=6020;
			END_IF
		END_IF
	6020://判断主轴的模长的当前位置是否为0
		IF NOT DP_SinStepe THEN
			IF DP_Step1=6666 AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling  THEN
				DT_SingeMode();//单步选择
				An_StandbyStep1:=6024;
			END_IF	
		END_IF	
   6024://判断NG气缸是否在安全位        无NG踢废气缸
	IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState AND
        arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND( arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] OR (An_OverNGMark AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[15] ))  THEN
		An_StandbyStep1:=6030;		
	ELSE
		An_StandbyStep1:=6025;	
	END_IF   
 6025:
	arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Cmd.bON:=TRUE;
	//arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;
	IF   arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND  arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
	arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState
	AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON THEN
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;		
		IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState  AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND
            ( arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] OR (An_OverNGMark AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[15] ))  THEN						
			An_StandbyStep1:=6024;				
		END_IF														
	END_IF  
			
	6030:						
		IF iND1=1 THEN
			An_StandbyStep1:=3030;	
		ELSIF iND1=2 THEN
			An_StandbyStep1:=3230;	
		ELSIF iND1=3 THEN
			An_StandbyStep1:=3330;			
		END_IF																												
	END_CASE
ELSE
	An_TON[1].IN:=FALSE;
	An_TON[2].IN:=FALSE;
END_IF

	
CASE An_StandbyStep1 OF
3040://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在取极片位      OK
	//正到负_正极送片搬运平 移轴凸轮耦合
	fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=1;
	fbAnCamInCarryingLine.bCamInExecute:=TRUE;
	//正到负_正极送片搬运升降轴放片凸轮耦合
	fbAnCamInCarryingUpDown.iTableSel:=2;
	fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;
	//正到负_正极搬运旋转轴凸轮耦合
	fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=1;
	fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;
	
	//正到负_正极叠片平移轴凸轮耦合
	fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
	fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;
	
	fbAnCamInDTCarryingUpDown.iTableSel:=3;   //  //20240528SJ
    fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;
	
	//负到正_缓存轴凸轮耦合
	fbCamInGMBuffer.iTableSel:=1;
	fbCamInGMBuffer.bCamInExecute:=TRUE;					
	//负到正_隔膜平移轴凸轮耦合
	fbCamInGMDanserMove.iTableSel:=1;
	fbCamInGMDanserMove.bCamInExecute:=TRUE;
	//隔膜驱动
	fbCamInVirGMDriver.iTableSel:=1;
	fbCamInVirGMDriver.bCamInExecute:=TRUE;		
																
	//I判断凸轮耦合是否完成
		IF fbAnCamInCarryingLine.bInSync AND fbAnCamInCarryingUpDown.bInSync AND fbAnCamInCarryingWhirling.bInSync AND
			fbAnCamInDTCarryingLine.bInSync AND  fbAnCamInDTCarryingUpDown.bInSync AND ////  //20240528SJ
			 fbCamInGMBuffer.bInSync AND fbCamInGMDanserMove.bInSync  AND  fbCamInVirGMDriver.bInSync    THEN 
			DT_SingeMode();//单步选择	
			An_StandbyStep1:=3060;
		ELSIF fbAnCamInCarryingLine.bError OR fbAnCamInCarryingUpDown.bError OR fbAnCamInCarryingWhirling.bError OR
			fbAnCamInDTCarryingLine.bError OR 
			 fbCamInGMBuffer.bError OR fbCamInGMDanserMove.bError  OR  fbCamInVirGMDriver.bError  THEN 	   
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			An_StandbyStep1:=9995;
		END_IF		

		3060://主轴启动    OK					  
			IF fbAnCamInCarryingLine.bInSync AND fbAnCamInCarryingUpDown.bInSync AND fbAnCamInCarryingWhirling.bInSync AND
				fbAnCamInDTCarryingLine.bInSync AND  fbCamInGMBuffer.bInSync AND  fbCamInGMDanserMove.bInSync  AND
				fbCamInVirGMDriver.bInSync    AND
				AN_CarryingPos1 AND  CA_CarryingPos1 AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
				arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;	
			END_IF			
			
			IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
				An_TON[2].IN:=FALSE;			
				An_StandbyStep1:=3070;
				An_StandbyStep2:=100;	//判断真空、破真空
				An_StandbyStep3:=100;
				DP_Step8:=200;//纠偏平台有无极片复检
			ELSE
				IF NOT An_TON[2].Q THEN
					An_TON[2].IN:=TRUE;
				ELSE
					An_TON[2].IN:=FALSE;
					Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;
					An_StandbyStep1:=10000;	
				END_IF
			END_IF	


		3050://负极搬运、叠片各轴在初始位，隔膜平移轴正极叠片位、正极叠片在取极片位    OK
						//正到负_正极送片搬运平移轴凸轮耦合
							fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=1;
							fbAnCamInCarryingLine.bCamInExecute:=TRUE;						
						//正到负_正极送片搬运升降轴放片凸轮耦合
							fbAnCamInCarryingUpDown.iTableSel:=2;
							fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;
						//正到负_正极叠片平移轴凸轮耦合
							fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
							fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;		
							
							fbAnCamInDTCarryingUpDown.iTableSel:=3;   //  //20240528SJ
							fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;
			
						//正到负_正极搬运旋转轴凸轮耦合		
							fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=1;
							fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;								 
						//判断凸轮耦合是否完成
							IF fbAnCamInCarryingLine.bInSync AND fbAnCamInCarryingUpDown.bInSync   AND fbAnCamInCarryingWhirling.bInSync AND
                                  fbAnCamInDTCarryingLine.bInSync   AND   fbAnCamInDTCarryingUpDown.bInSync         THEN
			                        DT_SingeMode();//单步选择		
								    An_StandbyStep1:=3080;
							ELSIF fbAnCamInCarryingLine.bError OR  fbAnCamInCarryingUpDown.bError  OR fbAnCamInCarryingWhirling.bError  OR 
                                     fbAnCamInDTCarryingLine.bError   OR  fbAnCamInDTCarryingUpDown.bError     THEN
								Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
								An_StandbyStep1:=9996;								
							END_IF				
		3080://主轴启动    OK					  
			IF fbAnCamInCarryingLine.bInSync AND fbAnCamInCarryingUpDown.bInSync   AND fbAnCamInCarryingWhirling.bInSync AND
                  		fbAnCamInDTCarryingLine.bInSync  AND
 				  AN_CarryingPos1 AND  CA_CarryingPos1 AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] THEN
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
				arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;	
			END_IF			
			
			IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
						arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
						An_TON[2].IN:=FALSE;			
						An_StandbyStep1:=3090;
						An_StandbyStep2:=100;	//判断真空、破真空
						An_StandbyStep3:=100;
						DP_Step8:=200;//纠偏平台有无极片复检
			ELSE
						IF NOT An_TON[2].Q THEN
							An_TON[2].IN:=TRUE;
						ELSE
							An_TON[2].IN:=FALSE;
							Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
							arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;
							An_StandbyStep1:=10000;	
						END_IF
			END_IF	
	

		3110://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在放极片初始位       OK
						//正到负_正极送片搬运平移轴凸轮耦合
							fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=1;
							fbAnCamInCarryingLine.bCamInExecute:=TRUE;	
						//正到负_正极送片搬运升降轴放片凸轮耦合
							fbAnCamInCarryingUpDown.iTableSel:=2;
							fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;
						//正到负_正极搬运旋转轴凸轮耦合		
							fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=1;
							fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;		
							
						//正到负_正极叠片平移轴凸轮耦合
							fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
							fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;	

							fbAnCamInDTCarryingUpDown.iTableSel:=3;   //  //20240528SJ
                            fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;
												
						//正到负_负极送片搬运平移轴凸轮耦合
							fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=-1;
							fbCaCamInCarryingLine2.bCamInExecute:=TRUE;
							fbCaCamInCarryingUpDown2.iTableSel:=3; //20240528SJ
                            fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;
							
							
					 IF  	iCaCamInSel1=1 THEN	
						//正到负_负极送片搬运升降轴取片凸轮耦合 
					//		fbCaCamInCarryingUpDown2.iTableSel:=1;
					//		 fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;
					 END_IF
		 
						//正到负_负极叠片搬运平移轴凸轮耦合
							fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
							fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;
					 IF  	iCaCamInSel2=1 THEN			
						//正到负_负极叠片搬运升降轴取片凸轮耦合
							fbCaCamInDTCarryingUpDown.iTableSel:=1;
							fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
					ELSE
							fbCaCamInDTCarryingUpDown.iTableSel:=3;   //20240528SJ
							fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;		
				     END_IF	
						
					
									//负到正_缓存轴凸轮耦合
							fbCamInGMBuffer.iTableSel:=1;
							fbCamInGMBuffer.bCamInExecute:=TRUE;					
						//负到正_隔膜平移轴凸轮耦合
							fbCamInGMDanserMove.iTableSel:=1;
							fbCamInGMDanserMove.bCamInExecute:=TRUE;
                       //隔膜驱动
							fbCamInVirGMDriver.iTableSel:=1;
						    fbCamInVirGMDriver.bCamInExecute:=TRUE;				
							
				
						//判断凸轮是否耦合完成
							IF fbAnCamInCarryingLine.bInSync AND fbAnCamInCarryingUpDown.bInSync AND  fbAnCamInCarryingWhirling.bInSync AND
                                fbAnCamInDTCarryingLine.bInSync AND   fbAnCamInDTCarryingUpDown.bInSync AND 
							   	fbCaCamInCarryingLine2.bInSync      AND   fbCaCamInCarryingUpDown2.bInSync    AND   // (  (fbCaCamInCarryingUpDown2.bInSync AND iCaCamInSel1=1) OR       iCaCamInSel1=2 ) 
							 	fbCaCamInDTCarryingLine.bInSync AND  (  (fbCaCamInDTCarryingUpDown.bInSync   AND iCaCamInSel2=1)  OR  (  iCaCamInSel2=2  AND fbCaCamInDTCarryingUpDown.bInSync )   )    AND
                                fbCamInGMBuffer.bInSync AND  fbCamInGMDanserMove.bInSync  AND  fbCamInVirGMDriver.bInSync  THEN
 
										IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
											DP_SinStepe:=TRUE;
										ELSE
											DP_SinStepe:=FALSE;	
										END_IF
										An_StandbyStep1:=3120;	
							ELSIF fbAnCamInCarryingLine.bError OR fbAnCamInCarryingUpDown.bError OR  fbAnCamInCarryingWhirling.bError OR
                                fbAnCamInDTCarryingLine.bError OR fbAnCamInDTCarryingUpDown.bError OR
							     fbCaCamInCarryingLine2.bError   OR fbCaCamInCarryingUpDown2.bError     OR
							 	 fbCaCamInDTCarryingLine.bError OR fbCaCamInDTCarryingUpDown.bError   OR
                                 fbCamInGMBuffer.bError OR  fbCamInGMDanserMove.bError  OR  fbCamInVirGMDriver.bError  THEN
									Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
									An_StandbyStep1:=9997;	
							END_IF
	3120://主轴启动		
			IF fbAnCamInCarryingLine.bInSync AND fbAnCamInCarryingUpDown.bInSync AND  fbAnCamInCarryingWhirling.bInSync AND
				fbAnCamInDTCarryingLine.bInSync AND fbCaCamInCarryingLine2.bInSync    AND
			     // (  (fbCaCamInCarryingUpDown2.bInSync AND iCaCamInSel1=1) OR       iCaCamInSel1=2 )     AND
				fbCaCamInDTCarryingLine.bInSync AND  (  (fbCaCamInDTCarryingUpDown.bInSync   AND iCaCamInSel2=1)  OR  iCaCamInSel2=2 )    AND
				 fbCamInGMBuffer.bInSync AND  fbCamInGMDanserMove.bInSync  AND  fbCamInVirGMDriver.bInSync  AND
 				AN_CarryingPos1 AND  CA_CarryingPos2 AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] THEN
						arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
						arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
						arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
						arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;	
		    END_IF				
			
			IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10 THEN
						arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
						An_TON[2].IN:=FALSE;	
						An_StandbyStep1:=3130;
						An_StandbyStep2:=200;
						An_StandbyStep3:=200;
						DP_Step8:=200;//纠偏平台有无极片复检
			ELSE
						IF NOT An_TON[2].Q THEN
							An_TON[2].IN:=TRUE;
						ELSE
							An_TON[2].IN:=FALSE;
							Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
							arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
							An_StandbyStep1:=10000;	
						END_IF
			END_IF
	
	3230	:				//OK			
		//正极送片搬运平移
		fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=-1;
		fbAnCamInCarryingLine.bCamInExecute:=TRUE;						
		//正极送片搬运升降
		fbAnCamInCarryingUpDown.iTableSel:=3;       //20240528SJ  
		fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;		
		//正极送片搬运旋转
		fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=-1;
		fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;		
						
		//正极叠台搬运平移
		fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
		fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;	
		//正极叠片搬运升降
		fbAnCamInDTCarryingUpDown.iTableSel:=1;       //    
		fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;		
	
	
		  IF fbAnCamInCarryingLine.bInSync AND fbAnCamInCarryingWhirling.bInSync AND   fbAnCamInCarryingUpDown.bInSync AND
				fbAnCamInDTCarryingLine.bInSync   AND  fbAnCamInDTCarryingUpDown.bInSync   THEN 
				  DT_SingeMode();//单步选择		
				  An_StandbyStep1:=3240;
		 ELSIF fbAnCamInCarryingLine.bError OR fbAnCamInCarryingWhirling.bError OR  fbAnCamInCarryingUpDown.bError OR
				fbAnCamInDTCarryingLine.bError   OR  fbAnCamInDTCarryingUpDown.bError   THEN 
					 Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
					 An_StandbyStep1:=9998;
		END_IF	 

	3240:					//OK	
				IF fbAnCamInCarryingLine.bInSync AND fbAnCamInCarryingWhirling.bInSync AND
					fbAnCamInDTCarryingLine.bInSync   AND  fbAnCamInDTCarryingUpDown.bInSync  AND AN_CarryingPos2  THEN 	
					  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
					  arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
					  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
					  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;				
				END_IF	
	
				IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fModuloActPos>=5  THEN		
						arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;
						An_TON[2].IN:=FALSE;		
						An_StandbyStep1:=3250;	
						An_StandbyStep2:=300;//正极取极片
						An_StandbyStep3:=300;
				ELSE
						IF NOT An_TON[2].Q THEN
							An_TON[2].IN:=TRUE;
						ELSE
					 	An_TON[2].IN:=FALSE;
							Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
							arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
							An_StandbyStep1:=10000;	
						END_IF
			  END_IF

	3330:		//OK	
		//正极送片搬运平移
			fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=-1;
			fbAnCamInCarryingLine.bCamInExecute:=TRUE;							
		//正极送片搬运升降取片
		  fbAnCamInCarryingUpDown.iTableSel:=3;       //20240528SJ   
		  fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;			
		
		//正极叠台搬运平移
				fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
				fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;	
				fbAnCamInDTCarryingUpDown.iTableSel:=3;   //  //20240528SJ
                fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;
					
		//	正极送片搬运旋转
			fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=-1;
			fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;		
					
		IF fbAnCamInCarryingLine.bInSync AND  fbAnCamInCarryingUpDown.bInSync AND
			fbAnCamInDTCarryingLine.bInSync   AND fbAnCamInCarryingWhirling.bInSync AND  fbAnCamInDTCarryingUpDown.bInSync   THEN   
			  DT_SingeMode();//单步选择		
			  An_StandbyStep1:=3340;
		ELSIF fbAnCamInCarryingLine.bError  OR  fbAnCamInCarryingUpDown.bError OR 
			fbAnCamInDTCarryingLine.bError  OR fbAnCamInCarryingWhirling.bError  OR   fbAnCamInDTCarryingUpDown.bError  THEN   
				 Mach_Control.DT_b.Error[29]:=TRUE;//凸轮耦合报警
				 An_StandbyStep1:=9998;
		END_IF	 	

	3340:  //OK
				IF fbAnCamInCarryingLine.bInSync AND fbAnCamInDTCarryingLine.bInSync   AND fbAnCamInCarryingWhirling.bInSync  AND 
					 AN_CarryingPos2  THEN   
					  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
					  arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
					  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
					  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;	
				END_IF	 			
				
				IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=5  THEN		
						arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;
							An_TON[2].IN:=FALSE;
							An_StandbyStep1:=3350;
							An_StandbyStep2:=400;//						
							An_StandbyStep3:=400;//正极主分料皮带清零
				ELSE
						IF NOT An_TON[2].Q THEN
						    An_TON[2].IN:=TRUE;
						ELSE
						An_TON[2].IN:=FALSE;
						Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
						arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
						An_StandbyStep1:=10000;	
					END_IF
			  END_IF				
END_CASE					

]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_StandbyMain2" Id="{822b154d-4b92-4db6-bd6e-00153bcc683b}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[
//An_StandbyStep2-------真空处理
//An_StandbyStep3-------主轴位置判断

CASE An_StandbyStep2 OF
100://正极叠片     负极在取片位
       bStandbyStep1_3:=FALSE;
       bStandbyStep1_4:=FALSE;
       An_StandbyStep2:=110; 
	   
110:
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=20  AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=30     THEN
	//正送片搬运极取片处理
		IF   arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] AND 
		      NOT Mach_Control.Ca_b.Ca_CarryingFalg    AND  ( Mach_Control.Ca_b.Ca_CacheBeltDLOK OR  Mach_Control.U.EmptyRunMode )  AND 
		      NOT  Mach_Control.Ca_b.Ca_CacheBelting   AND NOT  bStandbyStep1_3  THEN
			   Ca_Step0:=10;//负极取流水线子程序
			   bStandbyStep1_3:=TRUE;
		END_IF
					
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] AND 
			NOT Mach_Control.Ca_b.Ca_DPCarryingFalg AND   Mach_Control.Ca_b.Ca_deviationFalg AND  ( CCD.CaRec.Finish.RectifyResult=1 OR Mach_Control.U.EmptyRunMode  )  AND 
			NOT  bStandbyStep1_4   THEN
			Ca_Step3:=10;//正极取纠偏平台子程序
			bStandbyStep1_4:=TRUE;
		END_IF
		 
	ELSIF  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>245  THEN
		An_StandbyStep2:=120;
	END_IF
		
120:	
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260  AND   arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=320   THEN//198
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;////搬运真空破真空				
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;////搬运真空破真空		

			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;////搬运真空破真空				
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;////搬运真空破真空
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//纠偏平台开真空
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//纠偏平台开真空
			//IF Mach_Control.An_b.An_CarryingFalg THEN
				Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台上有料标记
				Mach_Control.An_b.An_CarryingFalg :=FALSE;//复位正极搬运机械手有料标记
			//END_IF
			Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[0];
			An_StandbyStep2:=6666;
	END_IF	
					
				
 200:	     // 状态2         1         0       0     iMD1:=1;	  	Ca_StandbyStep0:=6000;//通过凸轮耦合放极片到纠偏平台
	 IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=CamOutArgel+15 THEN   //整机叠片搬运
			 IF iCaCamInSel2=1  THEN	 
				 arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空开
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运真空开
			 END_IF
			An_StandbyStep2:=205;
	 END_IF
205:
	 IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=235 THEN   //整机叠片搬运
			IF Mach_Control.DT_b.DT_CCD_TwoModel  AND iCaCamInSel2=1    THEN												
				CCD.CaRec.Finish.RectifyResult:=0;
				CCD.CaRec.Finish.RectifyX1:=0;
				CCD.CaRec.Finish.RectifyX2:=0;
				CCD.CaRec.Finish.RectifyY:=0;												
				Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
				CCD.CaRec.Start.iPhotoDo:=2;//第二次拍照
				CCD.CaRec.Start.stPoleNo:=Par.stDT_date.Ca_MQ_Slice[8].stPoleNo;  //???????????????????????????
			END_IF
			An_StandbyStep2:=210;
	END_IF 
 210:
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=250  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=(250+6) AND NOT Mach_Control.Ca_b.Ca_CacheBelting THEN
		//IF iCaCamInSel1=1  THEN   //  正极送片搬运  
			IF ( Mach_Control.Ca_b.Ca_CacheBeltDLOK  OR  Mach_Control.U.EmptyRunMode )     AND   NOT Mach_Control.Ca_b.Ca_CarryingFalg  THEN
				Ca_Step0:=10;  //调用升降取片流程 
			ELSE
				IF NOT Mach_Control.Ca_b.Ca_CarryingFalg THEN
					//fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极升解除耦合
					Mach_Control.Ca_b.Ca_CacheBelting:=FALSE;//正极搬运升降取极片中	
					arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;	//负极送片搬运升降真空									
					arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=TRUE;	//负极送片搬运升降真空			
				END_IF																									
				IF NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
					arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=4;//移动至流水线上方
				END_IF	
			END_IF	
		//ELSE	    		
		//		;
		//END_IF			
	An_StandbyStep2:=220;
	END_IF
				
  220:			
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260   AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=320  THEN//198
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;////搬运真空破真空				
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;////搬运真空破真空
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;////搬运真空破真空				
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;////搬运真空破真空
		arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//纠偏平台开真空
		arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//纠偏平台开真空
		//IF Mach_Control.An_b.An_CarryingFalg THEN
			Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台上有料标记
			Mach_Control.An_b.An_CarryingFalg:=FALSE;//复位负极送片搬运吸盘上有料标记			
		//END_IF
		Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[0];
	
		IF 	 iCaCamInSel2=1  THEN
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;	//负极叠台搬运升降真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;	//负极叠台搬运升降真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=FALSE;	//负极纠偏台真空破真空			
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=TRUE;	//负极纠偏台真空破真空											
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bON:=TRUE;	//负极纠偏台真空破真空			
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bOFF:=FALSE;	//负极纠偏台真空破真空	
			//IF Mach_Control.Ca_b.Ca_deviationFalg THEN		
				Mach_Control.Ca_b.Ca_DPCarryingFalg :=TRUE;//正极叠片搬运吸盘上有料标记
				Mach_Control.Ca_b.Ca_deviationFalg:=FALSE;//置位纠偏平台上有料标记
			//END_IF
			Par.stDT_date.Ca_MQ_Slice[9]:=Par.stDT_date.Ca_MQ_Slice[8];
		ELSE
			;
		END_IF	
	An_StandbyStep2:=666;
	END_IF			

300:	     // 状态2         1         0       0     iMD1:=1;	  	Ca_StandbyStep0:=6000;//通过凸轮耦合放极片到纠偏平台
 			 IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=CamOutArgel+15 THEN   //整机叠片搬运
						arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//正极叠片搬运真空
						arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极叠片搬运真空
			    An_StandbyStep2:=305;
			 END_IF
305:
			IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=235 THEN
				    //	正极送片搬运			在子流程中处理								
					IF Mach_Control.DT_b.DT_CCD_TwoModel     THEN												
						CCD.AnRec.Finish.RectifyResult:=0;
						CCD.AnRec.Finish.RectifyX1:=0;
						CCD.AnRec.Finish.RectifyX2:=0;
						CCD.AnRec.Finish.RectifyY:=0;												
						Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
						CCD.AnRec.Start.iPhotoDo:=2;//第二次拍照
						CCD.CaRec.Start.stPoleNo:=Par.stDT_date.Ca_MQ_Slice[8].stPoleNo;  //???????????????????????????
					END_IF	
					 An_StandbyStep2:=310;
			END_IF		 
 310:
				IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=250  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=(250+6) AND NOT Mach_Control.An_b.An_MainBelting THEN
							 IF (Mach_Control.An_b.An_MainBeltOK  OR  Mach_Control.U.EmptyRunMode )  AND  NOT Mach_Control.An_b.An_CarryingFalg (*AND NOT Mach_Control.An_b.JumpPiceReady*)  THEN
								//fbAnCarryingVacuum.Vacuumsel:=1;										
								// Mach_Control.An_b.An_MainBelting:=TRUE;//正极搬运升降取极片中	 
								An_Step0:=10;  //调用升降取片流程 
							 ELSE
									//fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极升解除耦合
									Mach_Control.An_b.An_MainBelting:=FALSE;//正极搬运升降取极片中	
									arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=FALSE;////搬运真空破真空				
									arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;////搬运真空破真空
									arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;////搬运真空破真空				
									arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=FALSE;////搬运真空破真空									
									IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;//移动至流水线上方
									END_IF	
							END_IF	
				          An_StandbyStep2:=320;
				END_IF
				
320:			
			IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260    AND    	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=320  THEN//198
					//正极送片搬运
						arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//叠台搬运真空开		
						arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//叠台搬运真空开	
						arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=FALSE;//纠偏平台真空关
						arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=TRUE;//纠偏平台真空关		
						arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bON:=TRUE;//纠偏平台破真空
						arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bOFF:=FALSE;//纠偏平台破开真空	
						//IF Mach_Control.An_b.An_deviationFalg THEN
							Mach_Control.An_b.An_DPCarryingFalg:=TRUE;//复位负极送片搬运吸盘上有料标记
							Mach_Control.An_b.An_deviationFalg:=FALSE;//置位纠偏平台上有料标记
						//END_IF
						Par.stDT_date.An_MQ_Slice[2]:=Par.stDT_date.An_MQ_Slice[1];
				
				 An_StandbyStep2:=666;
			END_IF	
			


400:    
				IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=250  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=(250+6) AND NOT Mach_Control.An_b.An_MainBelting THEN   
								 IF (Mach_Control.An_b.An_MainBeltOK  OR  Mach_Control.U.EmptyRunMode ) AND NOT Mach_Control.An_b.An_CarryingFalg (*AND NOT Mach_Control.An_b.JumpPiceReady*)  THEN
									arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=TRUE;////搬运真空			
									arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=FALSE;////搬运真空						
								   //  Mach_Control.An_b.An_MainBelting:=TRUE;//正极搬运升降取极片中	 
									 An_Step0:=10;  //调用升降取片流程 
							     ELSE
									 	//fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极升解除耦合
										Mach_Control.An_b.An_MainBelting:=FALSE;//正极搬运升降取极片中	
										arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;////搬运真空			
										arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=FALSE;////搬运真空			
										arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=FALSE;////搬运破真空			
										arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;////搬运破真空																		
										IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
											arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;//移动至流水线上方
										END_IF	
							    END_IF	
		
				            An_StandbyStep2:=666;
				END_IF


(************************************NG纠偏流程*********************************************)
600:		//负极搬运放片到纠偏平台
			IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260  AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=320  THEN//198	
						arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;	//正极叠台搬运升降真空	真空
						arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;	//正极叠台搬运升降真空破真空											
						arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;	//正极纠偏台真空			
						arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;	//正极纠偏台真空
					//IF Mach_Control.An_b.An_CarryingFalg THEN	               
						Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台上有料标记 
						Mach_Control.An_b.An_CarryingFalg:=FALSE;//复位负极送片搬运吸盘上有料标记				
					//END_IF
					Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[0];
			          An_StandbyStep2:=666;
		    END_IF					
				
END_CASE			

CASE An_StandbyStep3 OF 
	
100://		
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Cmd.bON:=TRUE;//正极纠偏平台除尘
		arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Cmd.bOFF:=FALSE;//正极纠偏平台除尘
		DT_SingeMode();//单步选择		
		DP_Step1:=100;//解耦
		An_StandbyStep3:=110;
	END_IF;			
 110:
	IF DP_Step1=6666 THEN
		An_StandbyStep1:=1000;	
		An_StandbyStep3:=6666;
	END_IF	


	200:	
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		//	Mach_Control.Ca_b.Ca_CacheBelting:=FALSE;//负极搬运升降取极片中	
		DT_SingeMode();//单步选择
		DP_Step1:=100;
		An_StandbyStep3:=210;
	END_IF;								
     210:
               IF DP_Step1=6666 THEN
                  	An_StandbyStep1:=1000;		
			An_StandbyStep3:=6666;
               END_IF

300:
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		DT_SingeMode();//单步选择			
		DP_Step1:=100;
		An_StandbyStep3:=320;
	END_IF	
320:		
          IF DP_Step1=6666 	 THEN	
			     An_StandbyStep1:=1000;	
			      An_StandbyStep3:=6666;
	     END_IF;			


400:
      	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
					   DT_SingeMode();//单步选择			
                     	DP_Step1:=100;
						An_StandbyStep3:=420;
		END_IF		
								
420:		
                IF DP_Step1=6666 THEN	
						An_StandbyStep1:=1000;	
						An_StandbyStep3:=6666;
				END_IF;		

				
600:
      	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
				DT_SingeMode();//单步选择			
                DP_Step1:=100;
				An_StandbyStep3:=620; 
		END_IF		
								
620:		
                  IF DP_Step1=6666 THEN	
						//Ca_StandbyStep0:=1000;	
						An_StandbyStep3:=6666;
				END_IF;			
				
END_CASE
]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_StandbySub1" Id="{3a9c0cf5-1edb-4c13-9eec-0da7772de3f6}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[An_TON[9].IN:=Mach_Control.An_b.bAn_PoleHave;
IF An_TON[9].Q THEN
	Mach_Control.An_b.bAn_PoleHave:=FALSE;//正极取流水线极片完成，
END_IF

//取料中信号复位
An_TON[10].IN:= NOT  arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND Mach_Control.An_b.JumpPiceReady AND Mach_Control.An_b.An_MainBelting;
IF An_TON[10].Q THEN
	IF NOT  arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN		
		arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;//正极送片搬运升降上升至初始高度	
	ELSE
		arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;//正极送片搬运升降上升至初始高度	
	END_IF
END_IF
An_TON[11].IN:=arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND Mach_Control.An_b.JumpPiceReady AND Mach_Control.An_b.An_MainBelting;
IF An_TON[11].Q  THEN
	An_Step0:=0;
	Mach_Control.An_b.AN_BeltDone:=TRUE;//取流水线取极片完成
	Mach_Control.An_b.An_MainBelting:=FALSE;//正极搬运升降取极片中
END_IF



IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下	
CASE An_Step0 OF

	10:
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Enabled
			AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Enabled THEN
		
			IF An_JumpRules[1] THEN//空叠隔膜 //OR An_JumpRules[3]  OR An_JumpRules[6] OR An_JumpRules[8] OR An_JumpRules[10]  
				An_Step0:=400;
			ELSE
				An_Step0:=50;
			END_IF
		END_IF
	50:

		//正极搬运升降上升至等待位  20240505 CF
		IF ABS(arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.fSetPos-arrAxisPar[AxiseNo.AxisName.AnCarryingLine].arrTargetPoint[1])<0.5
			//AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] 					
			AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1]  THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF	
		An_Step0:=100;
		END_IF
	
	END_CASE
END_IF
arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos;
CASE An_Step0 OF
	100://判断正极流水线是否允许取料
		IF NOT DP_SinStepe THEN
			IF (Mach_Control.An_b.An_MainBeltOK AND NOT Mach_Control.An_b.An_CarryingFalg)  OR  Mach_Control.U.EmptyRunMode THEN
				Mach_Control.An_b.An_MainBelting:=TRUE;//正极搬运升降取极片中
				IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
					DP_SinStepe:=TRUE;
				ELSE
					DP_SinStepe:=FALSE;	
				END_IF	
				An_TON[5].IN:=FALSE;			
				An_Step0:=150;
			ELSIF Mach_Control.An_b.An_CarryingFalg  THEN
				An_Step0:=6666;
			ELSIF NOT Mach_Control.U.EmptyRunMode AND  An_JumpRules[8] THEN
				An_Step0:=500;	
			ELSIF Mach_Control.An_b.JumpPiceReady AND NOT Mach_Control.An_b.An_MainBeltOK AND  DP_Step4=110 THEN
	            An_Step0:=0;
			END_IF
		END_IF
	150:
			IF NOT 	DP_SinStepe THEN				
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=TRUE;//正极搬运升降取料真空打开
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=FALSE;//正极搬运升降取料真空打开
				IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed(* AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving*) AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[2] THEN	
							IF NOT An_TON[5].Q THEN
								An_TON[5].IN:=TRUE;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;
								IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
									DP_SinStepe:=TRUE;
								ELSE
									DP_SinStepe:=FALSE;	
								END_IF		
								An_TON[5].IN:=FALSE;				
								An_Step0:=200;										
							END_IF									
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=2;//正极送片搬运升降下降至流水线取极片高度
					END_IF
				END_IF
			END_IF
	200:
	//20240414 wcz
	     IF   arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[2]-3)  AND 
			   arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Moving THEN
					Mach_Control.An_b.An_MainBelting:=FALSE;// 复位正极搬运升降取极片中
					Mach_Control.An_b.AN_BeltDone:=TRUE;//取流水线取极片完成
					Mach_Control.An_b.bAn_PoleHave:=TRUE;//正极取流水线极片完成，用来发给模切来清取料位极片有无信号
		 END_IF
	
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed (*AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving*) AND 
			NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
						arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;
						Mach_Control.An_b.An_MainBelting:=FALSE;// 复位正极搬运升降取极片中
						Mach_Control.An_b.AN_BeltDone:=TRUE;//取流水线取极片完成
						Mach_Control.An_b.An_CarryingFalg:=TRUE;//置位正极搬运升降真空吸盘上有极片
						Mach_Control.An_b.bAn_PoleHave:=TRUE;//正极取流水线极片完成，用来发给模切来清取料位极片有无信号
						Par.stDT_date.An_MQ_Slice[0]:=Par.stDT_date.AnMQ_MES;//转移皮带上的数据	
						An_Step0:=6666;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;//正极送片搬运升降上升至初始高度
					END_IF
		END_IF	
	
		
	400:
		Mach_Control.An_b.An_MainBelting:=FALSE;// 复位正极搬运升降取极片中
		Mach_Control.An_b.AN_BeltDone:=TRUE;//取流水线取极片完成
		Mach_Control.An_b.An_CarryingFalg:=TRUE;//置位正极搬运升降真空吸盘上有极片
		//Par.stDT_date.An_MQ_Slice[0]:=Par.stDT_date.AnMQ_MES;//转移皮带上的数据	
		An_Step0:=6666;
		
	500:
		Mach_Control.An_b.An_MainBelting:=FALSE;// 复位正极搬运升降取极片中
		Mach_Control.An_b.AN_BeltDone:=TRUE;//取流水线取极片完成
		//Mach_Control.An_b.An_CarryingFalg:=TRUE;//置位正极搬运升降真空吸盘上有极片
		//Par.stDT_date.An_MQ_Slice[0]:=Par.stDT_date.AnMQ_MES;//转移皮带上的数据	
		An_Step0:=6666;
END_CASE

(*

//An_Step0--正极取流水线极片子程序
IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下	
CASE An_Step0 OF
	10://正极搬运升降上升至等待位
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] 
		AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] 					
		AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1]  THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF	
		An_Step0:=30;
		END_IF
	30://判断正极流水线是否允许取料
		IF NOT DP_SinStepe THEN
				IF (Mach_Control.An_b.An_MainBeltOK AND NOT Mach_Control.An_b.An_CarryingFalg)  OR  Mach_Control.U.EmptyRunMode THEN
					Mach_Control.An_b.An_MainBelting:=TRUE;//正极搬运升降取极片中
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF	
					An_TON[5].IN:=FALSE;			
					An_Step0:=40;
				ELSIF Mach_Control.An_b.An_CarryingFalg  THEN
					An_Step0:=6666;
				(*
				ELSE
					An_Step0:=10;
					Mach_Control.An_b.An_MainBelting:=FALSE;//正极搬运升降取极片中
				*)
				END_IF
		END_IF
	(*
			IF NOT DP_SinStepe THEN
				IF  arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed THEN
					An_Step0:=20;
				ELSE
						IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving AND 
							NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error THEN
									IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
											arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;
											IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
												DP_SinStepe:=TRUE;
											ELSE
												DP_SinStepe:=FALSE;	
											END_IF						
											An_Step0:=20;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;//正极送片搬运升降至等待高度
									END_IF
						END_IF
				END_IF
		END_IF;
	20://正极搬运平移至初始位，正极搬运旋转至初始位	
			IF NOT DP_SinStepe THEN	
					IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND
						 arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Error THEN
								IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] THEN
									An_CarryingTorMark:=FALSE;//正极搬运1移位力矩判断标志位
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.iGoSetPos:=1;//正极搬运平移到初始位
									An_CarryingTorMark:=TRUE;//正极搬运1移位力矩判断标志位
								END_IF
					END_IF
					IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Homed AND
						 arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Error THEN
								IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.iGoSetPos:=1;//正极搬运旋转至初始位
								END_IF
					END_IF
					IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] 
					AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] 					
					AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1]  THEN
							IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
								DP_SinStepe:=TRUE;
							ELSE
								DP_SinStepe:=FALSE;	
							END_IF	
							An_Step0:=30;
					END_IF
			END_IF
	
		*)
	END_CASE
END_IF
arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos;
CASE An_Step0 OF

	40:
			IF NOT 	DP_SinStepe THEN				
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=TRUE;//正极搬运升降取料真空打开
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=FALSE;//正极搬运升降取料真空打开
				IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed(* AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving*) AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[2] THEN
							IF NOT An_TON[5].Q THEN
									An_TON[5].IN:=TRUE;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;
								IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
									DP_SinStepe:=TRUE;
								ELSE
									DP_SinStepe:=FALSE;	
								END_IF		
								An_TON[5].IN:=FALSE;				
								An_Step0:=50;										
							END_IF									
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=2;//正极送片搬运升降下降至流水线取极片高度
					END_IF
				END_IF
			END_IF
50:
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed (*AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving*) AND 
			NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
						arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;
						Mach_Control.An_b.An_MainBelting:=FALSE;// 复位正极搬运升降取极片中
						Mach_Control.An_b.AN_BeltDone:=TRUE;//取流水线取极片完成
						Mach_Control.An_b.An_CarryingFalg:=TRUE;//置位正极搬运升降真空吸盘上有极片
						Par.stDT_date.An_MQ_Slice[0]:=Par.stDT_date.AnMQ_MES;//转移皮带上的数据	
						An_Step0:=6666;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;//正极送片搬运升降上升至初始高度
					END_IF
		END_IF	

END_CASE

*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_StandbySub2" Id="{82b5ceb2-fee7-4222-b0c9-b479c529cf27}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下	
//An_Step1---正极送片搬运放片到纠偏台
	CASE An_Step1 OF

10:// 
	IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Enabled AND  arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Enabled  THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[2]  AND  arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[2]   THEN
			An_Step1:=30;
		END_IF
	END_IF	
30://判断纠偏平台是否允许取极片
	IF NOT DP_SinStepe THEN
		DT_SingeMode();//单步选择			
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[3] THEN
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;
			/// 吸盘破真空    纠偏台开真空
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;	//正极叠台搬运升降真空	真空
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;	//正极叠台搬运升降真空破真空		
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;	//正极叠台搬运升降真空	真空
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;	//正极叠台搬运升降真空破真空											
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;	//正极纠偏台真空			
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;	//正极纠偏台真空	           
			An_Step1:=40;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=3;//负极搬运升降2上升至凸轮耦合初始高度
		END_IF	
	END_IF
					
40:		
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;
			/// 吸盘破真空    纠偏台开真空
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;	//正极叠台搬运升降真空
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;	//正极叠台搬运升降真空
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=FALSE;	//正极叠台搬运升降破真空	
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;	//正极叠台搬运升降破真空	
			//IF Mach_Control.An_b.An_CarryingFalg THEN
			Mach_Control.An_b.An_deviationFalg:=TRUE;//复位纠偏平台有料标记
			Mach_Control.An_b.An_CarryingFalg:=FALSE;//负极搬运真空吸盘有料标记复位
			//END_IF
			Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[0];
			An_Step1:=6666;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;//负极搬运升降2上升至凸轮耦合初始高度
		END_IF			
	END_IF

	END_CASE
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_StandbySub3" Id="{b3f8ce61-0e1f-4e32-8684-f61bceb3309d}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[ An_StandbySub3_ton[1](PT:=T#300MS);
An_StandbySub3_ton[2](PT:=T#250MS);
An_StandbySub3_ton[3](PT:=T#300MS);
An_NG_TON(IN:= , PT:=T#0.3S , Q=> , ET=> );
An_NG_TON2(IN:= , PT:=T#0.3S , Q=> , ET=> );
YS(IN:= , PT:=T#2S , Q=> , ET=> );
YS1(IN:= , PT:=T#0.3S , Q=> , ET=> );

//An_Step2------正极纠偏平台踢NG片子程序

IF Mach_Control.U.DT_iMode=1 OR avg1 THEN//在自动状态下	
//正极纠偏平台踢NG片子程序
CASE An_Step2 OF
	10:
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Enabled AND  arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Enabled THEN
			IF   arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch  THEN
				An_Step2:=12;
			ELSE
				//Mach_Control.An_b.Error[4] :=TRUE;//正极叠台搬运升降有极片，无真空信号报警
				An_StandbySub3_ton[3].IN:=FALSE;
				An_Step2:=11; 
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运升降真空关
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运升降真空关
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运破真空开
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极叠片搬运破真空关			  
			END_IF
	 	END_IF
    11:	 
	    An_StandbySub3_ton[3].IN:=TRUE;
		IF  An_StandbySub3_ton[3].Q THEN
			   An_Step2:=12; 
			   An_StandbySub3_ton[3].IN:=FALSE;
		END_IF
				
	12://正极NG收料气缸伸出	
			arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;//正极纠偏气缸伸出
			IF  arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState THEN
				An_Step2:=20;
				//An_Step4:=1000;
			END_IF
	20://正极搬运升降上升至初始位,正极叠片搬运升降至初始位
				IF NOT DP_SinStepe THEN	
					IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
						NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[5] THEN
							arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=5;//正极叠片平台升降上升避让高度
						END_IF
					END_IF
					IF 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF				
						An_Step2:=40;
					END_IF	
				END_IF
	30://正极搬运平移回初始位
			IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState  AND
						 arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Error THEN
								IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.iGoSetPos:=0;
									IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
										DP_SinStepe:=TRUE;
									ELSE
										DP_SinStepe:=FALSE;	
									END_IF							
									An_Step2:=40;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.iGoSetPos:=1;//正极搬运平移到初始位
								END_IF
					END_IF
			END_IF
	40://正极叠台搬运平移至取片位
			IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND
						 arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Error THEN
								IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.iGoSetPos:=0;
									IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
										DP_SinStepe:=TRUE;
									ELSE
										DP_SinStepe:=FALSE;	
									END_IF	
									An_Step2:=45;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.iGoSetPos:=1;//正极叠台搬运平移至取片位
								END_IF
					END_IF	
			END_IF
			
	45:
		//IF  CCD.AnRec.Finish.RectifyResult<>1 THEN
		
			An_Step2:=50;
		//END_IF
		(*
			IF Mach_Control.An_b.An_Rectifydev_CS>=1 OR CCD.AnRec.Finish.RectifyResult=3 OR CCD.AnRec.Finish.RectifyResult=4  OR NOT Mach_Control.An_b.An_Rectifydev_PB THEN
				An_Step2:=50;
			ELSE
				An_Step2:=150;
			END_IF
		*)



	

		
	50://正极纠偏位NG料盒气缸伸出，正极叠片搬运升降轴下降至踢NG料高度     arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.OFFState
			IF NOT DP_SinStepe THEN		
				      	IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[5] THEN
						    arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bOFF:=TRUE;//正极NG收纳盒气缸收回
						END_IF
						
						IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.OFFState AND An_NG_TON2.Q  THEN
								IF NOT An_NG_TON.Q THEN
											An_NG_TON.IN:=TRUE;
											Mach_Control.An_b.An_DPCarryingFalg:=FALSE;// 复位正极叠片搬运真空吸盘标记有料
											arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运升降真空关闭
											arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运升降真空关闭
											//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运升降破真空打开		
											//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极叠片搬运升降破真空打开		
								ELSE					
											IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
												DP_SinStepe:=TRUE;
											ELSE
												DP_SinStepe:=FALSE;	
											END_IF	
											An_NG_TON.IN:=FALSE;
											An_Step2:=60;
											An_CCDNG:=An_CCDNG+1;
								END_IF
						ELSE
							An_NG_TON2.IN:=TRUE;
						END_IF
			END_IF	
	60://NG气缸伸出
				IF NOT DP_SinStepe THEN	
						An_NG_TON2.IN:=FALSE;
						IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[5] THEN
					    	arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;//正极纠偏气缸伸出
						END_IF
						
						IF  arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState THEN
							IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
								DP_SinStepe:=TRUE;
							ELSE
								DP_SinStepe:=FALSE;	
							END_IF	
							An_Step2:=70;
						END_IF	
				END_IF	
	70://正极叠片搬运升降至初始位
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
			NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
						arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
						An_Step2:=80;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极叠片平台升降至等待位
					END_IF
		END_IF

	80:
	   IF HMI_Hour>=8 AND HMI_Hour<20 THEN
		  Par.stDT_date.An_Rectifydev_DayNG:=Par.stDT_date.An_Rectifydev_DayNG+1; 
	   END_IF
	
	   IF (HMI_Hour>=0 AND HMI_Hour<8) OR  (HMI_Hour>=20 AND HMI_Hour<=23) THEN
		 Par.stDT_date.An_Rectifydev_NightNG:=Par.stDT_date.An_Rectifydev_NightNG+1;
	   END_IF
	
		Par.stDT_date.An_Rectifydev_JS:=Par.stDT_date.An_Rectifydev_JS+1;
		Mach_Control.An_b.An_CCD_amount:=Mach_Control.An_b.An_CCD_amount+1;
		An_StandbySub3_ton[2].IN:=FALSE;
		Mach_Control.An_b.An_Rectifydev_CS:=0;
		An_Step2:=90;

	90:
		IF NOT Mach_Control.U.CCD_ChosesHMI  AND NOT  Mach_Control.U.EmptyRunMode AND An_OverNGStep=0 THEN												
					CCD.AnRec.Finish.RectifyResult:=0;
					CCD.AnRec.Finish.RectifyX1:=0;
					CCD.AnRec.Finish.RectifyX2:=0;
					CCD.AnRec.Finish.RectifyY:=0;												
					Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
					CCD.AnRec.Start.iPhotoDo:=1;//第二次拍照
					Mach_Control.An_b.An_VacuumErrorNG:=FALSE;
					An_Step2:=100;
		ELSE
					An_Step2:=6666;
		END_IF	
	100:
		IF NOT An_StandbySub3_ton[2].Q THEN
			An_StandbySub3_ton[2].IN:=TRUE;
		ELSE
			IF CCD.AnRec.Finish.RectifyResult<> 3 AND NOT Mach_Control.U.CCD_ChosesHMI THEN
				Mach_Control.An_b.Error[24]:=TRUE;//正极纠偏平台NG片未排掉报警，请拿掉
				An_StandbySub3_ton[2].IN:=FALSE;
				An_Step2:=6666;
			ELSE
				An_StandbySub3_ton[2].IN:=FALSE;
				An_Step2:=6666;
			END_IF
		END_IF
	



	
	//////////////////////////////////二次纠偏流程/////////////////////////////////////////////
	150:
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1]  
			AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1]  THEN
			An_Step2:=160;
		END_IF
	
	160:
		IF NOT DP_SinStepe THEN	
				IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] THEN
							IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
								arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=2;//正极叠片平台升降去取片位 放片
							END_IF
				END_IF
				IF 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
								IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
									DP_SinStepe:=TRUE;
								ELSE
									DP_SinStepe:=FALSE;	
								END_IF				
								An_Step2:=170;
				END_IF	
		END_IF
	
	170:

			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运真空关
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运真空关
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运破真空开
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极叠片搬运破真空开
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//正极纠偏平台真空开		
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//正极纠偏平台真空开	
			//IF Mach_Control.An_b.An_DPCarryingFalg THEN	
				Mach_Control.An_b.An_DPCarryingFalg :=FALSE;//复位正极叠片搬运吸盘上有料标记
				Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台上有料标记
			//END_IF
			An_Step2:=180;

			
	180:
		IF NOT DP_SinStepe THEN	
				IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] THEN
							IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
								arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极叠片平台升降去等待位
							END_IF
				END_IF
				IF 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
								IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
									DP_SinStepe:=TRUE;
								ELSE
									DP_SinStepe:=FALSE;	
								END_IF				
								An_Step2:=190;
				END_IF	
		END_IF	
	190:
			YS.IN:=TRUE;
			
		IF 	 (Mach_Control.An_b.RectifydevDone OR CCD.AnRec.Finish.RectifyResult=2 OR CCD.AnRec.Finish.RectifyResult=3 OR CCD.AnRec.Finish.RectifyResult=4) AND YS.Q  THEN
			Mach_Control.An_b.An_Rectifydev_CS:=Mach_Control.An_b.An_Rectifydev_CS+1;
			An_Step2:=200;
			YS.IN:=FALSE;
		END_IF
		
	200:
		IF NOT DP_SinStepe THEN	
				IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] THEN
							IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
								arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=2;//正极叠片平台升降去取片位 放片
							END_IF
				END_IF
				IF 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
								IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
									DP_SinStepe:=TRUE;
								ELSE
									DP_SinStepe:=FALSE;	
								END_IF				
								An_Step2:=220;
								IF Mach_Control.DT_b.DT_CCD_TwoModel THEN												
										CCD.AnRec.Finish.RectifyResult:=0;
										CCD.AnRec.Finish.RectifyX1:=0;
										CCD.AnRec.Finish.RectifyX2:=0;
										CCD.AnRec.Finish.RectifyY:=0;												
										Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
										CCD.AnRec.Start.iPhotoDo:=2;//第二次拍照		
								END_IF	
				END_IF	
		END_IF	
		
			
	220:
	
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//正极叠片搬运真空开
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极叠片搬运真空开
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=TRUE;//正极叠片搬运破真空关
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=FALSE;//正极叠片搬运破真空关
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=TRUE;//正极纠偏平台真空关	
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=FALSE;//正极纠偏平台真空关	
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bON:=TRUE;//正极纠偏平台破真空开	
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bOFF:=FALSE;//正极纠偏平台破真空开	
			//IF Mach_Control.An_b.An_deviationFalg THEN
				Mach_Control.An_b.An_DPCarryingFalg :=TRUE;//叠片搬运吸盘上有料标记
				Mach_Control.An_b.An_deviationFalg:=FALSE;//纠偏平台上有料标记
			//END_IF
			YS1.IN:=TRUE;
			IF YS1.Q THEN
			An_Step2:=230;
			YS1.IN:=FALSE;
			END_IF
	
	
	230:
		IF NOT DP_SinStepe THEN	
				IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] THEN
							IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
								arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极叠片平台升降去等待位
							END_IF
				END_IF
				IF 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
								IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
									DP_SinStepe:=TRUE;
								ELSE
									DP_SinStepe:=FALSE;	
								END_IF				
								An_Step2:=6666;
				END_IF	
		END_IF	
	
	
		
			
		
		
END_CASE
END_IF














]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_StandbySub4" Id="{66721a2e-ac78-4b60-9608-31aead3b2059}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下	
//An_Step3----正极叠片搬运取纠偏极片
CASE An_Step3 OF
	10://正极NG料盒气缸伸出	
		IF  arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Enabled AND  arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Enabled THEN	
			arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;//正极纠偏气缸伸出
			IF  arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState THEN
				An_Step3:=11;
			END_IF
		END_IF
	11://正极叠片搬运升降至等待位		
					IF NOT DP_SinStepe THEN	
						(*
						IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving AND 
							NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error THEN
									IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;//正极送片搬运升降等待高度
									END_IF
						END_IF
						*)
						IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
							NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error THEN
									IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极叠片平台升降至等待高度
									END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed THEN
										IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
											DP_SinStepe:=TRUE;
										ELSE
											DP_SinStepe:=FALSE;	
										END_IF				
										An_Step3:=30;
						END_IF	
				END_IF								
	20://正极搬运平移回初始位
		IF NOT DP_SinStepe THEN
				IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND
					 arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Error THEN
							IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] THEN
									An_CarryingTorMark:=FALSE;//正极搬运1移位力矩判断标志位
									arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.iGoSetPos:=0;
									IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
										DP_SinStepe:=TRUE;
									ELSE
										DP_SinStepe:=FALSE;	
									END_IF	
									An_Step3:=30;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.iGoSetPos:=1;//正极搬运平移到初始位
								An_CarryingTorMark:=TRUE;//正极搬运1移位力矩判断标志位
							END_IF
				END_IF	
		END_IF
	30://正极叠片搬运平移至初始位，
			//IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.fActPos < (arrAxisPar[AxiseNo.AxisName.AnDTCarryingLine].arrTargetPoint[2]-180) THEN
	          //arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Cmd.bON:=TRUE;//正极纠偏平台除尘
			   //arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Cmd.bOff:=FALSE;//正极纠偏平台除尘
	      // END_IF
			IF NOT DP_SinStepe THEN
						arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;//正极纠偏气缸伸出
						IF   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND
							 arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Error  AND 
							 NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Error 
                             AND LREAL_TO_REAL(arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.fActPos) < (arrAxisPar[AxiseNo.AxisName.AnCarryingLine].arrTargetPoint[2]-50) AND
							 arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState THEN
									IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] THEN
										An_DTCarryingTorMark:=FALSE;//正极叠台搬运力矩判断标志位
										arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.iGoSetPos:=0;
										IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
											DP_SinStepe:=TRUE;
										ELSE
											DP_SinStepe:=FALSE;	
										END_IF								
										An_Step3:=40;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.iGoSetPos:=1;//正极叠片平移移动至初始位
										An_DTCarryingTorMark:=TRUE;//正极叠台搬运力矩判断标志位
									END_IF
						END_IF
			END_IF
	40://判断纠偏平台是否允许取极片
			IF NOT DP_SinStepe THEN
					IF Mach_Control.An_b.An_deviationDPOK OR Mach_Control.U.EmptyRunMode THEN
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF			
					//	CCD正极纠偏平台二次拍照-------------复检拍照
						IF Mach_Control.DT_b.DT_CCD_TwoModel THEN												
							CCD.AnRec.Finish.RectifyResult:=0;
							CCD.AnRec.Finish.RectifyX1:=0;
							CCD.AnRec.Finish.RectifyX2:=0;
							CCD.AnRec.Finish.RectifyY:=0;												
							Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
							CCD.AnRec.Start.iPhotoDo:=2;//第二次拍照		
						END_IF	
						An_TON[6].IN:=FALSE;
						An_Step3:=50;
					END_IF
			END_IF
END_CASE
END_IF


CASE An_Step3 OF
	50://AND arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Io.DIOnSwitch
		IF NOT DP_SinStepe THEN
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//正极叠片搬运升降真空开
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极叠片搬运真空开
			IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
			NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error  THEN
				IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
					arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=TRUE;//正极纠偏真空关
					arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=FALSE;//正极纠偏真空关
					arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bON:=TRUE;//正极纠偏破真空开
					arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bOFF:=FALSE;//正极纠偏破真空开
					arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
					//IF Mach_Control.An_b.An_deviationFalg THEN
						Mach_Control.An_b.An_DPCarryingFalg:=TRUE;// 复位正极叠片搬运真空吸盘标记有料
						Mach_Control.An_b.An_deviationFalg:=FALSE;//复位正极纠偏平台有料标记	
					//END_IF
					Par.stDT_date.An_MQ_Slice[2]:=Par.stDT_date.An_MQ_Slice[1];												
																
					IF NOT An_TON[6].Q THEN
						An_TON[6].IN:=TRUE;
					ELSE
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF		
						An_TON[6].IN:=FALSE;				
						An_Step3:=60;											
					END_IF									
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=2;//正极叠片平台升降下降至取料高度
				END_IF
			
			END_IF	
		END_IF
	60://正极叠片搬运升降上升至初始位
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
		NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
				arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
				An_Step3:=6666;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极叠片平台升降上升至初始位
			END_IF
		END_IF		
END_CASE				]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_Alarm" Id="{04590461-8061-4fa9-903e-71d3ac1b6242}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[//报警延时时间
Ca_AlarmTON[1](IN:= , PT:=T#80MS , Q=> , ET=> );//负极取流水线搬运升降机械手吸盘误吸极片报警延时
Ca_AlarmTON[2](IN:= , PT:=T#80MS , Q=> , ET=> );//负极取流水线搬运升降机械手吸盘掉片报警延时
Ca_AlarmTON[3](IN:= , PT:=T#80MS , Q=> , ET=> );///负极送片搬运升降机械手误吸极片报警延时
Ca_AlarmTON[4](IN:= , PT:=T#80MS , Q=> , ET=> );////负极取流水线搬运升降机械手吸盘掉片	报警延时
Ca_AlarmTON[5](IN:= , PT:=T#80MS , Q=> , ET=> );///负极叠台搬运升降机械手误吸极片报警延时
Ca_AlarmTON[6](IN:= , PT:=T#80MS , Q=> , ET=> );////负极叠台搬运升降机械手吸盘掉片报警延时
Ca_AlarmTON[7](IN:= , PT:=T#80MS , Q=> , ET=> );///负极纠偏平台误吸极片报警延时
Ca_AlarmTON[8](IN:= , PT:=T#150MS , Q=> , ET=> );////负极纠偏平台吸盘掉片报警延时
Ca_AlarmTON[9](IN:= , PT:=T#300MS , Q=> , ET=> );
Ca_AlarmTON[10](IN:= , PT:=T#300MS , Q=> , ET=> );
Ca_AlarmTON[11](IN:= , PT:=T#300MS , Q=> , ET=> );//负极极片对齐度检测返回结果超时
Ca_AlarmTon[12](IN:= , PT:=T#400MS , Q=> , ET=> );//负极CCD纠偏平台检测返回结果超时
Ca_AlarmTon[13](IN:=CaCCDMark , PT:=T#50MS , Q=> , ET=> );//负极CCD纠偏平台检测返回结果超时
Ca_AlarmTon[15](IN:= , PT:=T#50MS , Q=> , ET=> );//负极取片搬运叠片过程中的真空处理
Ca_AlarmTon[16](IN:= , PT:=T#50MS , Q=> , ET=> );//负极取片搬运叠片过程中的真空处理
Ca_AlarmTon[17](IN:=NOT Mach_Control.se.CaNGboxsensor , PT:=T#5S , Q=> , ET=> );//负极NG料盒料满	

rCaUse[1](CLK:=Ca_Step0=40, Q=> );
rCaUse[2](CLK:=Mach_Control.Ca_b.Ca_CCDStart AND NOT   Mach_Control.Ca_b.Demarcateing , Q=> );
rCaUse[3](CLK:=Par.stDT_date.Ca_Rectifydev_Btn , Q=> );
rCaUse[4](CLK:= NOT arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Io.DOStatus1 , Q=> ); 
rCaUse[5](CLK:= NOT arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DOStatus1 , Q=> );
rCaUse[6](CLK:=arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DOStatus1 , Q=> ); 

//Mach_Control.Ca_b.Error[1]:=TRUE;//负极取流水线搬运升降有真空信号，无极片报警
//Mach_Control.Ca_b.Error[2]:=TRUE;//负极取流水线搬运升降有极片，无真空信号报警
//Mach_Control.Ca_b.Error[3]:=TRUE;//负极送片搬运升降有真空信号，无极片报警
//Mach_Control.Ca_b.Error[4]:=TRUE;//负极送片搬运升降取片过程中真空报警,有极片，无真空信号
//Mach_Control.Ca_b.Error[5]:=TRUE;//负极叠台搬运升降有真空信号，无极片报警
//Mach_Control.Ca_b.Error[6]:=TRUE;//负极叠台搬运升降有极片，无真空信号报警
//Mach_Control.Ca_b.Error[7]:=TRUE;//纠偏平台无片极，有真空信号报警
//Mach_Control.Ca_b.Error[8]:=TRUE;//纠偏平台有极片，无真空报警
//Mach_Control.Ca_b.Error[9]:=TRUE;//纠偏CCD拍照完成IO信号未给出
//Mach_Control.Ca_b.Error[10] //CCD标定NG报警
//Mach_Control.Ca_b.Error[11]:=TRUE;//负极藕合凸轮报警
//Mach_Control.Ca_b.Error[12]:=TRUE;//负极NG收纳盒满料报警
//Mach_Control.Ca_b.Error[13];
//Mach_Control.Ca_b.Error[14];
//Mach_Control.Ca_b.Error[15];
//Mach_Control.Ca_b.Error[16];
//Mach_Control.Ca_b.Error[17]:=TRUE;//负极防撞感应信报警
//Mach_Control.Ca_b.Error[18] :=TRUE;//负极CCD纠偏平台检测返回结果超时
//Mach_Control.Ca_b.Error[19]:=TRUE;//负极取放料回原点超时报警
//Mach_Control.Ca_b.Error[20]:=TRUE;//负极皮带回原点超时报警	
//Mach_Control.Ca_b.Error[21]:=TRUE;//负极纠偏平台连续NG报警
//Mach_Control.Ca_b.Error[22]:=TRUE;//负极叠台搬运升降真空报警，电芯上有片，请拿掉
//Mach_Control.Ca_b.Error[23]:=TRUE;//负极叠台搬运升降真空报警，电芯上无掉片
//Mach_Control.Ca_b.Error[24] //负极纠偏平台NG片未排掉报警，请拿掉
//Mach_Control.Ca_b.Error[25] //负极极片对齐度检测返回结果超时
//Mach_Control.Ca_b.Error[26]:=TRUE;//负极搬运平移防撞软限位报警
//Mach_Control.Ca_b.Error[27] ////负极极片对齐度检测返回结果无片报警
//Mach_Control.Ca_b.Error[28] //负极极片NG料盒料满
//Mach_Control.Ca_b.Error[29]:=TRUE;	  //负极初始化时负极叠片搬运升降吸盘有真空报警
//Mach_Control.Ca_b.Error[30]:=TRUE;	  //负极初始化时负极送片搬运升降2吸盘有真空报警
//Mach_Control.Ca_b.Error[31]:=TRUE;	   //负极皮带初始化时负极送片搬运升降1吸盘有真空报警


//Mach_Control.Ca_b.Error[32]:=TRUE;//负极取片叠片过程中真空报警
//Mach_Control.Ca_b.Error[33]:=TRUE;//纠偏平台有片，请拿走
//Mach_Control.Ca_b.Error[34]:=TRUE;//负极叠台搬运平移取片时真空报警
//Mach_Control.Ca_b.Error[35]:=TRUE;//负极纠偏台NG料盒料满报警
//Mach_Control.Ca_b.Error[36]:=TRUE;//负极纠偏纠偏CCD返回结果超时
//Mach_Control.Ca_b.Error[38] :=TRUE;//负极叠台搬运升降有极耳无真空报警
//Mach_Control.Ca_b.Error[39] :=TRUE;//负极叠台搬运升降有极耳无真空报警
//Mach_Control.Ca_b.Error[40] S=AnOverNGcount>=3;//负极单张踢废连续NG
//Mach_Control.Ca_b.Error[41] :=TRUE;//负极缓存皮带准备运动时，负极升降1不在安全位报警
//Mach_Control.Ca_b.Error[42] :=TRUE;//负极机械手初始化时，叠台搬运升降不在避让位
Mach_Control.Ca_b.Error[40] S=CaOverNGcount>=3;//负极单张踢废连续NG

//NG料盒料满报警
	IF (*Par.stDT_date.Ca_Rectifydev_JS>=Par.stDT_date.Ca_Rectifydev_NGSet OR*) Ca_AlarmTon[17].Q THEN
		Mach_Control.Ca_b.Error[35]:=TRUE;//负极纠偏台NG料盒料满报警
	ELSE
		Mach_Control.Ca_b.Error[35]:=FALSE;//负极纠偏台NG料盒料满报警
	END_IF
	IF rCaUse[3].Q THEN
		Par.stDT_date.Ca_Rectifydev_JS:=0;
	END_IF
	
	
	
//负极初始化时有真空报警	
	IF Mach_Control.Ca_b.Ca_GohomeHMI  THEN
			IF  arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Status.ONState  THEN
				Mach_Control.Ca_b.Error[29]:=TRUE;	  //负极初始化时负极叠片搬运升降吸盘有真空报警
			END_IF
			IF arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Status.ONState THEN
				Mach_Control.Ca_b.Error[30]:=TRUE;	  //负极初始化时负极送片搬运升降2吸盘有真空报警
			END_IF
	END_IF	
//负极皮带初始化时有真空报警	
	IF Mach_Control.Ca_b.Ca_BeltGohomeHMI  AND arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Status.ONState THEN
		Mach_Control.Ca_b.Error[31]:=TRUE;	   //负极皮带初始化时负极送片搬运升降1吸盘有真空报警
	END_IF	
	
//负极取流水线搬运机械手升降吸盘真空信号与搬运升降极片有无料标记不一致报警
Ca_AlarmTON[1].IN:=NOT arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DOStatus1 AND  arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DIOnSwitch 
	AND NOT Mach_Control.Ca_b.Ca_SegbeltFalg AND NOT Mach_Control.U.EmptyRunMode AND  Mach_Control.U.DT_iMode=1 AND NOT Mach_Control.Ca_b.Error[2] ;
rtVacALM[1](CLK:=Ca_AlarmTON[1].Q, Q=> );		
		IF  rtVacALM[1].Q THEN
			//Mach_Control.Ca_b.Ca_SegbeltFalg:=FALSE;
			Mach_Control.Ca_b.Error[1]:=TRUE;//负极取流水线搬运升降有真空信号，无极片报警
		END_IF

//
Ca_AlarmTON[2].IN:=NOT arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DIOnSwitch AND  Mach_Control.Ca_b.Ca_SegbeltFalg AND NOT Mach_Control.U.EmptyRunMode AND
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[2]-5) AND arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DOStatus1 ;		
rtVacALM[2](CLK:=Ca_AlarmTON[2].Q, Q=> );	
		IF  rtVacALM[2].Q THEN
			Mach_Control.Ca_b.Error[2]:=TRUE;//负极取流水线搬运升降有极片，无真空信号报警
		END_IF	
	
(*
//负极取流水线搬运机械手升降吸盘真空信号与搬运升降极片有无料标记不一致报警
Ca_AlarmTON[1].IN:=NOT arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DOStatus1 AND  arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DIOnSwitch 
	AND NOT Mach_Control.Ca_b.Ca_SegbeltFalg AND NOT Mach_Control.U.EmptyRunMode AND  Mach_Control.U.DT_iMode=1 AND NOT Mach_Control.Ca_b.Error[2] ;
		IF  Ca_AlarmTON[1].Q THEN
			//Mach_Control.Ca_b.Ca_SegbeltFalg:=FALSE;
			Mach_Control.Ca_b.Error[1]:=TRUE;//负极取流水线搬运升降有真空信号，无极片报警
		END_IF

//
Ca_AlarmTON[2].IN:=NOT arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DIOnSwitch AND  Mach_Control.Ca_b.Ca_SegbeltFalg AND NOT Mach_Control.U.EmptyRunMode AND
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[2]-5) AND arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DOStatus1 ;		
		IF  Ca_AlarmTON[2].Q THEN
			(*
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1]	.Cmd.bOFF:=TRUE;//负极搬运1真空关
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1]	.Cmd.bON:=FALSE;//负极搬运1真空开
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark1]	.Cmd.bOFF:=FALSE;//负极搬运1真空关
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark1]	.Cmd.bON:=TRUE;//负极搬运1真空开
			Mach_Control.Ca_b.Ca_SegbeltFalg:=FALSE;
			*)
			Mach_Control.Ca_b.Error[2]:=TRUE;//负极取流水线搬运升降有极片，无真空信号报警
		END_IF
IF Mach_Control.Ca_b.Error[2] AND arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DIOnSwitch AND rCa_AlarmReset.Q  THEN
	Mach_Control.Ca_b.Error[2]:=FALSE;//负极取流水线搬运升降有极片，无真空信号报警
ELSIF Mach_Control.Ca_b.Error[2] AND NOT arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Io.DIOnSwitch AND rCa_AlarmReset.Q  THEN
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1]	.Cmd.bOFF:=TRUE;//负极搬运1真空关
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1]	.Cmd.bON:=FALSE;//负极搬运1真空开
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark1]	.Cmd.bOFF:=FALSE;//负极搬运1真空关
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark1]	.Cmd.bON:=TRUE;//负极搬运1真空开
	Ca_StandbyStep2:=0;
	Mach_Control.Ca_b.Ca_SegbeltFalg:=FALSE;
	Mach_Control.Ca_b.Error[2]:=FALSE;//负极取流水线搬运升降有极片，无真空信号报警
END_IF
*)		

//负极取片搬运取片过程中的真空报警处理
Ca_AlarmTON[4].IN:=NOT arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Io.DIOnSwitch AND Mach_Control.Ca_b.Ca_CarryingFalg 
	AND NOT Mach_Control.U.EmptyRunMode AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed 
	AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown2].arrTargetPoint[2]-5)//AND NOT Blueflaging
	AND NOT  arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Io.DOStatus1 AND NOT Bnt_Blueflaging  AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving ;
		IF  Ca_AlarmTON[4].Q THEN  
				Mach_Control.Ca_b.Error[4]:=TRUE;//负极送片搬运升降机械有极片，无真空信号报警
				(*
				Mach_Control.Ca_b.Ca_CarryingFalg :=FALSE;
				arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bON:=TRUE;//负极搬运2真空破
				arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bOFF:=FALSE;//负极搬运2真空破
				*)
		END_IF
IF Mach_Control.Ca_b.Error[4] AND arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Io.DIOnSwitch AND rCa_AlarmReset.Q  THEN
	Mach_Control.Ca_b.Error[4]:=FALSE;//负极送片搬运升降机械有极片，无真空信号报警
ELSIF Mach_Control.Ca_b.Error[4] AND NOT arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Io.DIOnSwitch AND rCa_AlarmReset.Q  THEN
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bON:=TRUE;//负极搬运2真空破
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bOFF:=FALSE;//负极搬运2真空破
	Ca_StandbyStep0:=0;
	Ca_Step0:=0;
	Ca_Step1:=0;
	Ca_Step2:=0;
	Ca_Step3:=0;
	Mach_Control.Ca_b.Error[4]:=FALSE;//负极送片搬运升降机械有极片，无真空信号报警
	Mach_Control.Ca_b.Ca_CarryingFalg :=FALSE;
END_IF
		
		
		
		

//负极取片搬运在叠片过程中的真空报警处理
Ca_AlarmTON[15].IN:=NOT arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Io.DIOnSwitch AND Mach_Control.Ca_b.Ca_CarryingFalg 
	 AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Moving AND NOT Mach_Control.U.EmptyRunMode
	AND NOT  arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Io.DOStatus1 AND NOT Bnt_Blueflaging
	AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>1  AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<232 ;
	
	IF  Ca_AlarmTON[15].Q THEN  
		CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零
		Mach_Control.Ca_b.Error[32]:=TRUE;	   //负极取片升降真空叠片过程中真空报警
		Mach_Control.Ca_b.Ca_CarryingFalg :=FALSE;
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bON:=TRUE;//负极搬运2真空破
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bOFF:=FALSE;//负极搬运2真空破
	END_IF
	//搬运平移在叠片过程中报警时，纠偏平台拍照有无片来确定是否掉片到纠偏平台
	IF Mach_Control.Ca_b.Error[32] AND rCa_AlarmReset.Q  THEN
		//CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零
		Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
		CCD.CaRec.Start.iPhotoDo:=1;//启动CCD第二次拍照
	END_IF
	IF Mach_Control.Ca_b.Error[32] AND (CCD.CaRec.Finish.RectifyResult=3  OR  Mach_Control.U.CCD_ChosesHMI) AND rCa_AlarmReset.Q  THEN
		Mach_Control.Ca_b.Error[32]:=FALSE;
		Mach_Control.Ca_b.Error[33]:=FALSE;//纠偏平台有片，请拿走
	ELSIF Mach_Control.Ca_b.Error[32] AND (CCD.CaRec.Finish.RectifyResult<>3  AND NOT   Mach_Control.U.CCD_ChosesHMI)THEN
		Mach_Control.Ca_b.Error[33]:=TRUE;//纠偏平台有片，请拿走
	END_IF
	
	

	
//负极叠片搬运升降真空信号与有无极片标记信号不一致
Ca_AlarmTON[5].IN:=(arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch OR Mach_Control.se.CaDTCarryingJROnSwitch) 
    AND NOT Mach_Control.Ca_b.Ca_DPCarryingFalg 
	AND NOT Mach_Control.U.EmptyRunMode AND Mach_Control.U.DT_iMode=1 AND iEmptyFoldStep[1]=0 AND DP_Step0<1000 AND DP_Step0>3100
	AND NOT  arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DOStatus1  AND NOT DP_CheseCam  AND NOT Bnt_Blueflaging;//AND NOT Blueflaging
	IF  Ca_AlarmTON[5].Q THEN
		IF  arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch THEN
		   Mach_Control.Ca_b.Error[5]:=TRUE;//负极叠台搬运升降有真空信号，无极片报警
		END_IF   
		IF Mach_Control.se.CaDTCarryingJROnSwitch THEN
		   Mach_Control.Ca_b.Error[37]:=TRUE;//负极叠台搬运升降有真空信号，无极耳报警
		END_IF
	END_IF
	
//负极叠台搬运在取片过程中的真空报警处理
Ca_AlarmTON[16].IN:=(NOT arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch OR NOT Mach_Control.se.CaDTCarryingJROnSwitch) 
    AND Mach_Control.Ca_b.Ca_DPCarryingFalg AND NOT Mach_Control.U.EmptyRunMode  AND
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[2]-5)AND  (Ca_Step2=6666 OR Ca_Step2=0) 
	AND NOT  arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DOStatus1 AND  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving  AND iEmptyFoldStep[1]=0
	AND (DP_Step0<1000 OR DP_Step0>3100)  ;
	
	IF  Ca_AlarmTON[16].Q THEN
		//CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零
		IF   NOT arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch THEN
	    	Mach_Control.Ca_b.Error[34]:=TRUE;//负极叠台搬运升降有极片，无真空信号反馈
		END_IF		
		IF NOT Mach_Control.se.CaDTCarryingJROnSwitch THEN
		   Mach_Control.Ca_b.Error[39]:=TRUE;//负极叠台搬运升降有极耳无真空报警
		END_IF				
		Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运升降真空破
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运升降真空破
	END_IF	
	//叠台搬运平移在取片过程中报警时，纠偏平台拍照有无片来确定是否掉片到纠偏平台
	IF (Mach_Control.Ca_b.Error[34] OR Mach_Control.Ca_b.Error[39]) AND rCa_AlarmReset.Q  THEN
		//CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零
		Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
		CCD.CaRec.Start.iPhotoDo:=1;//启动CCD第二次拍照
	END_IF
	IF (Mach_Control.Ca_b.Error[34]OR Mach_Control.Ca_b.Error[39]) AND (CCD.CaRec.Finish.RectifyResult=3  OR  Mach_Control.U.CCD_ChosesHMI) AND rCa_AlarmReset.Q  THEN
		Mach_Control.Ca_b.Error[34]:=FALSE;//叠台升降取片过程中真空报警，
		Mach_Control.Ca_b.Error[39]:=FALSE;//负极叠台搬运升降有极耳无真空报警
		Mach_Control.Ca_b.Error[33]:=FALSE;//纠偏平台有片，请拿走
	ELSIF (Mach_Control.Ca_b.Error[34] OR Mach_Control.Ca_b.Error[39]) AND (CCD.CaRec.Finish.RectifyResult<>3  AND NOT   Mach_Control.U.CCD_ChosesHMI)THEN
		Mach_Control.Ca_b.Error[33]:=TRUE;//纠偏平台有片，请拿走
	END_IF
	
	
	
//负极叠台搬运在叠片过程中的真空报警处理
Ca_AlarmTON[6].IN:=(NOT arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch OR NOT Mach_Control.se.CaDTCarryingJROnSwitch) 
    AND Mach_Control.Ca_b.Ca_DPCarryingFalg 
	AND NOT Mach_Control.U.EmptyRunMode  AND   (Ca_Step2=6666 OR Ca_Step2=0) 
	AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<232 AND NOT Bnt_Blueflaging  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>1 
	AND NOT  arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DOStatus1 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.Moving
	AND  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Moving  ;
	
	IF  Ca_AlarmTON[6].Q THEN
		//Mach_Control.DT_b.OverhandResult:=0;
		IF   NOT arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch THEN
		   Mach_Control.Ca_b.Error[6]:=TRUE;//负极叠台搬运升降有极片，无真空信号反馈
		END_IF	
		IF NOT Mach_Control.se.CaDTCarryingJROnSwitch THEN
		   Mach_Control.Ca_b.Error[38]:=TRUE;//负极叠台搬运升降有极耳无真空报警
		END_IF			
		
		Ca_Number:=TRUE;
		Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运升降真空破
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运升降真空破
	END_IF	
	//负极叠台搬运升降真空报警，电芯上有片，请拿掉
	Ca_AlarmTON[9].IN:=(Mach_Control.Ca_b.Error[6] OR Mach_Control.Ca_b.Error[38] )  AND Mach_Control.DT_b.OverhandResult<>3 AND NOT Mach_Control.U.CCD_ChosesHMI  ;	
	IF  Ca_AlarmTON[9].Q THEN
		Mach_Control.Ca_b.Error[22]:=TRUE;//负极叠台搬运升降真空报警，电芯上有片，请拿掉
	END_IF
	IF fCa_AlarmRest.Q AND  Mach_Control.Ca_b.Error[22] AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<1 THEN
		CCD.Over.Start.iPhotoDo:=2;
		Mach_Control.DT_b.CDD_OverStart:=TRUE;
	END_IF 
	IF Mach_Control.Ca_b.Error[22] AND Mach_Control.DT_b.OverhandResult=3   AND rCa_AlarmReset.Q  THEN
		Mach_Control.Ca_b.Error[22]:=FALSE;//复位电芯有片报警
		Mach_Control.DT_b.OverhandResult:=0;
	END_IF	
	
	//负极叠台搬运升降真空报警，电芯上无掉片
	Ca_AlarmTON[10].IN:=(Mach_Control.Ca_b.Error[6] OR Mach_Control.Ca_b.Error[38]) AND Mach_Control.DT_b.OverhandResult=3 AND NOT Mach_Control.U.CCD_ChosesHMI    ;	
	IF  Ca_AlarmTON[10].Q THEN
			Mach_Control.Ca_b.Error[23]:=TRUE;//负极叠台搬运升降真空报警，电芯上无掉片
	END_IF	

	


	

		

//负极纠偏平台真空信号与有无料标记不一致报警
Ca_AlarmTON[7].IN:=arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Io.DIOnSwitch AND NOT Mach_Control.Ca_b.Ca_deviationFalg 
	AND NOT Mach_Control.U.EmptyRunMode AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed  
	AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[4]+5) 
	AND iEmptyFoldStep[1]=0 AND (DP_Step0<1000 OR DP_Step0>3100)   ;
		IF  Ca_AlarmTON[7].Q THEN
			Mach_Control.Ca_b.Error[7]:=TRUE;//纠偏平台无片极，有真空信号报警
		END_IF

Ca_AlarmTON[8].IN:=NOT arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Io.DIOnSwitch AND Mach_Control.Ca_b.Ca_deviationFalg 
	AND NOT Mach_Control.U.EmptyRunMode AND	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed  
	AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown2].arrTargetPoint[4]+5) 
	AND iEmptyFoldStep[1]=0 AND (DP_Step0<1000 OR DP_Step0>3100) AND NOT Mach_Control.Ca_b.Ca_VacuumErrorNG ;	
		IF  Ca_AlarmTON[8].Q THEN
			Mach_Control.Ca_b.Error[8]:=TRUE;//纠偏平台有极片，无真空报警
			Mach_Control.Ca_b.Ca_VacuumErrorNG:=TRUE;//负极抛真空NG料标志			
		END_IF



IF fCa_AlarmRest.Q AND  Mach_Control.Ca_b.Error[24] AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<1 THEN		
	Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
	CCD.CaRec.Start.iPhotoDo:=1;//启动CCD第二次拍照
END_IF
//负极纠偏平台片未排掉报警
IF Mach_Control.Ca_b.Error[24] AND CCD.CaRec.Finish.RectifyResult=3  AND rCa_AlarmReset.Q  THEN
	Mach_Control.Ca_b.Error[24]:=FALSE;
END_IF
//负极纠偏平台连续NG报警
IF Mach_Control.Ca_b.Ca_CCD_amount>=3 AND NOT Mach_Control.Ca_b.Error[21] THEN	
		Mach_Control.Ca_b.Error[21]:=TRUE;//负极纠偏平台连续NG报警
END_IF



//负极取料报警复位
rCa_AlarmReset(CLK:=Sys_Control.btn.System_Rrestbtn , Q=> );//负极报警复位上升沿
fCa_AlarmRest(CLK:=Sys_Control.btn.System_Rrestbtn  , Q=> );//负极报警复位下降沿
IF Mach_Control.U.DT_iMode=3 THEN//在手动状态下，复位报警
	
		IF Mach_Control.Ca_b.Error[2] AND NOT Mach_Control.Ca_b.Ca_SegbeltFalg AND rCa_AlarmReset.Q THEN
				//Mach_Control.Ca_b.Ca_SegbeltFalg:=FALSE;
				//Ca_StandbyStep2:=0;
		END_IF
		
		//IF Mach_Control.Ca_b.Error[4] AND rCa_AlarmReset.Q THEN
			//	Mach_Control.Ca_b.Ca_CarryingFalg:=FALSE;
		//END_IF
		
		IF (Mach_Control.Ca_b.Error[6] OR Mach_Control.Ca_b.Error[38]) AND rCa_AlarmReset.Q THEN
				Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;
		END_IF
//20240105临时屏蔽
	(*		
		IF Mach_Control.Ca_b.Error[8] AND rCa_AlarmReset.Q THEN
				 Mach_Control.Ca_b.Ca_deviationFalg:=FALSE;
		END_IF
	*)	
		IF Mach_Control.Ca_b.Error[21] AND rCa_AlarmReset.Q THEN
				 Mach_Control.Ca_b.Ca_CCD_amount:=0	;	 
		END_IF
		
		
		
																	//20240105临时屏蔽	
		IF ((Mach_Control.Ca_b.Error[4]AND NOT Mach_Control.Ca_b.Ca_CarryingFalg) OR Mach_Control.Ca_b.Error[6] OR Mach_Control.Ca_b.Error[38] ) AND rCa_AlarmReset.Q   THEN
			Ca_StandbyStep0:=0;
			Ca_Step0:=0;
			Ca_Step1:=0;
			Ca_Step2:=0;
			Ca_Step3:=0;
		END_IF
		
		//报警状态复位
		IF fCa_AlarmRest.Q AND NOT Mach_Control.Ca_b.Error[22] AND NOT Mach_Control.Ca_b.Error[4]  AND  NOT Mach_Control.Ca_b.Error[6]   
		AND NOT Mach_Control.Ca_b.Error[32] AND NOT  Mach_Control.Ca_b.Error[24] AND NOT Mach_Control.Ca_b.Error[34] 
        AND NOT  Mach_Control.Ca_b.Error[38] AND NOT  Mach_Control.Ca_b.Error[39]  THEN
			MEMSET(ADR(Mach_Control.Ca_b.Error),0,SIZEOF(Mach_Control.Ca_b.Error)); // 负极取片报警复位	
			//CaOverNGcount:=0;
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bStop:=FALSE;
		END_IF
		
		IF CaOverNGcount>=3 AND fCa_AlarmRest.Q  THEN
		   CaOverNGcount:=0;
		END_IF
		
		IF Mach_Control.Ca_b.Ca_DTqr AND Mach_Control.Ca_b.Error[4]   THEN
				Mach_Control.Ca_b.Error[4]:=FALSE;
				Mach_Control.Ca_b.Ca_CarryingFalg:=FALSE;
		END_IF
		
		IF Mach_Control.Ca_b.Ca_DTqr AND  (Mach_Control.Ca_b.Error[6] OR  Mach_Control.Ca_b.Error[38]) THEN
				Mach_Control.Ca_b.Error[6]:=FALSE;
				Mach_Control.Ca_b.Error[38]:=FALSE;
				Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;
		END_IF
		
		IF (Mach_Control.Ca_b.Error[9] OR Ca_RectifydevStep=9999) AND fCa_AlarmRest.Q THEN
				Mach_Control.Ca_b.Error[9]:=FALSE;
				Ca_RectifydevStep:=0;
				CCD.CaRec.Finish.RectifyX1:=0;
				CCD.CaRec.Finish.RectifyX2:=0;
				CCD.CaRec.Finish.RectifyY:=0;		
				CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零		
		END_IF
		
		IF fCa_AlarmRest.Q THEN		
			IF 9991<=Ca_StandbyStep0 AND  Ca_StandbyStep0<=10000 THEN
				Ca_StandbyStep0:=1000;
				Ca_Step0:=0;
				Ca_Step1:=0;
				Ca_Step2:=0;
				Ca_Step3:=0;
			END_IF
		END_IF
		
END_IF

     Ca_dppy_Xzb:=arrAxisPar[AxiseNo.AxisName.CaCarryingLine2].arrTargetPoint[2]+arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.fActPos;
    IF Ca_Step3=20 AND NOT arrAxis[AxiseNo.AxisName.CaDTCarryingLine].Status.Coupled AND NOT  arrAxis[AxiseNo.AxisName.CaCarryingLine2].Status.Coupled AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  
		  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1]
          AND ABS( (arrAxisPar[AxiseNo.AxisName.CaCarryingLine2].arrTargetPoint[2]+arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.fActPos)-arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.fActPos)
            <(ABS(arrAxisPar[AxiseNo.AxisName.CaCarryingLine2].arrTargetPoint[2]-arrAxisPar[AxiseNo.AxisName.CaCarryingLine2].arrTargetPoint[1])+arrAxisPar[AxiseNo.AxisName.CaDTCarryingLine].arrTargetPoint[1]-20) THEN
			Mach_Control.Ca_b.Error[26]:=TRUE;//负极搬运平移防撞软限位报警
	END_IF
	
	CaError_r(CLK:=  Mach_Control.Ca_b.Error[26] , Q=> );
	IF CaError_r.Q THEN 
		   arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bStop:=TRUE;
		   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bStop :=TRUE;	
	END_IF
	
    IF  P2M2_sysControl.btn.System_Rrestbtn  THEN
      	 arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bStop:=FALSE;
     	  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bStop :=FALSE;
	END_IF

IF Mach_Control.U.DT_iMode=3 THEN//在手动状态下，复位报警	
		IF Mach_Control.Ca_b.Error[28] AND DP_Step0=3070 AND rCa_AlarmReset.Q THEN
				Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;
		END_IF
END_IF

//ccdJ拍照检测返回结果超时报警
rCaCCDStart(CLK:=Mach_Control.Ca_b.Ca_CCDStart, Q=> );
IF rAnCCDStart.Q THEN
	 CaCCDMark:=TRUE;
END_IF
 
IF CaCCDMark AND CCD. CaRec.Finish.RectifyResult=0 AND NOT Mach_Control.U.CCD_ChosesHMI THEN
		IF NOT  Ca_AlarmTon[12].Q THEN
			 	Ca_AlarmTon[12].IN:=TRUE;
		ELSE	
				Mach_Control.Ca_b.Error[18] :=TRUE;//负极CCD纠偏平台检测返回结果超时
				CaCCDMark :=FALSE;
		END_IF
ELSE
		 Ca_AlarmTon[12].IN:=FALSE;
END_IF

IF (Mach_Control.Ca_b.Error[18] AND Sys_Control.btn.System_Rrestbtn) OR
    (CCD. CaRec.Finish.RectifyResult<>0 AND  CaCCDMark AND  Ca_AlarmTon[13].Q ) THEN
	   CaCCDMark :=FALSE;
	   Ca_AlarmTon[12].IN:=FALSE;
END_IF	

IF Mach_Control.U.DT_iMode=1 AND  rCaUse[4].Q THEN
 Par.stDT_date.Ca_sucker1_JS :=Par.stDT_date.Ca_sucker1_JS+1;
END_IF

IF( HMI_Hour>=7  AND HMI_Hour<9) OR (HMI_Hour>=19  AND HMI_Hour<21) THEN
      IF Par.stDT_date.Ca_sucker1_JS>=Par.stDT_date.Ca_sucker1Set THEN
	      Mach_Control.Ca_b.Error[43]:=TRUE;//负极送片搬运吸盘计数到达设定值
      END_IF
END_IF
IF Mach_Control.DT_b.Ca_sucker1_JSclear THEN
   Par.stDT_date.Ca_sucker1_JS:=0;
END_IF  

IF Mach_Control.U.DT_iMode=1 AND  rCaUse[5].Q THEN
 Par.stDT_date.Ca_sucker2_JS :=Par.stDT_date.Ca_sucker2_JS+1;
END_IF

IF( HMI_Hour>=7  AND HMI_Hour<9) OR (HMI_Hour>=19  AND HMI_Hour<21) THEN
      IF Par.stDT_date.Ca_sucker2_JS>=Par.stDT_date.Ca_sucker2Set THEN
	      Mach_Control.Ca_b.Error[44]:=TRUE;//负极叠台搬运吸盘计数到达设定值
      END_IF
END_IF
IF Mach_Control.DT_b.Ca_sucker2_JSclear THEN
   Par.stDT_date.Ca_sucker2_JS:=0;
END_IF  
IF Mach_Control.U.DT_iMode=1 AND  rCaUse[6].Q THEN
 Par.stDT_date.Ca_sucker3_JS :=Par.stDT_date.Ca_sucker3_JS+1;
END_IF

IF( HMI_Hour>=7  AND HMI_Hour<9) OR (HMI_Hour>=19  AND HMI_Hour<21) THEN
      IF Par.stDT_date.Ca_sucker3_JS>=Par.stDT_date.Ca_sucker3Set THEN
	      Mach_Control.Ca_b.Error[45]:=TRUE;//负极流水线搬运吸盘计数到达设定值
      END_IF
END_IF
IF Mach_Control.DT_b.Ca_sucker3_JSclear THEN
   Par.stDT_date.Ca_sucker3_JS:=0;
END_IF  
(*
IF Ca_CCDNG>=10 THEN
		Mach_Control.Ca_b.Error[12]:=TRUE;//负极NG收纳盒满料报警
END_IF

IF Mach_Control.Ca_b.Error[12] AND P2M2_sysControl.btn.System_Rrestbtn THEN
		 Mach_Control.Ca_b.Error[12]:=FALSE;
		 Ca_CCDNG:=0;
END_IF

*)








]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_Cahebelt" Id="{10878c62-be07-4780-92c9-96427d74dd80}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[Ca_TON[9].IN:=Mach_Control.Ca_b.bCa_PoleHave;
IF Ca_TON[9].Q THEN
	Mach_Control.Ca_b.bCa_PoleHave:=FALSE;//负极取流水线极片完成，
END_IF


//取料中信号复位
Ca_TON[10].IN:= NOT  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND Mach_Control.Ca_b.JumpPiceReady AND Mach_Control.Ca_b.Ca_MainBelting;
IF Ca_TON[10].Q THEN
	IF NOT  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] THEN		
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=1;//负极送片搬运升降上升至初始高度	
	ELSE
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=0;//负极送片搬运升降上升至初始高度	
	END_IF
END_IF
Ca_TON[11].IN:=arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND Mach_Control.Ca_b.JumpPiceReady AND Mach_Control.Ca_b.Ca_MainBelting;
IF Ca_TON[11].Q  THEN
	Ca_StandbyStep2:=0;
	Mach_Control.Ca_b.Ca_BeltDone:=TRUE;//取流水线取极片完成
	Mach_Control.Ca_b.Ca_MainBelting:=FALSE;//正极搬运升降取极片中
END_IF




IF Mach_Control.U.DT_iMode=1 OR AG  THEN//在自动状态下
//负极模切分段皮带极片自动
CASE Ca_StandbyStep2  OF
0://判断取模切分板皮带机械手有无料标记
	IF NOT DP_SinStepe THEN
		IF   arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Enabled  AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Enabled 
		AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Enabled  THEN
			IF Mach_Control.Ca_b.Ca_SegbeltFalg  THEN//负极取模切分段机械手有极片标记
				DT_SingeMode();//单步选择
				Ca_StandbyStep2:=100;
			ELSE//负极取模切分段机械手无料
				
				DT_SingeMode();//单步选择
				Ca_StandbyStep2:=10;
			END_IF
		END_IF
	END_IF
10://负极送片搬运升降轴上升至安全位，真空关闭
	IF NOT DP_SinStepe THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1]	.Cmd.bOFF:=TRUE;//负极搬运1真空关
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1]	.Cmd.bON:=FALSE;//负极搬运1真空开
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving AND 
			NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] THEN
					arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=0;
					DT_SingeMode();//单步选择
					Ca_StandbyStep2:=20;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=1;//负极搬运升降1移动至初始高度
				END_IF
		END_IF
	END_IF
20://负极送片搬运平移至模切分段皮带取料位,负极搬运旋转1旋转至初始位
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed AND 
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.iGoSetPos:=1;//负极搬运升降1移动至初始高度
			END_IF
		END_IF
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Homed AND
			 arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.iGoSetPos:=1;//负极搬运旋转至初始位
			END_IF
		END_IF
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[1] THEN
			DT_SingeMode();//单步选择
			Ca_StandbyStep2:=30;
		END_IF
	END_IF

	

100://负极送片搬运升降轴上升至安全位，真空关闭
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving AND 
			NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] THEN
						arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=0;
						DT_SingeMode();//单步选择
						Ca_StandbyStep2:=110;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=1;//负极搬运升降1移动至初始高度
			END_IF
		END_IF
	END_IF
110://负极送片搬运平移至模切分段皮带放极片位, 负极搬运旋转1旋转至放位
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed AND 
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[2] THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.iGoSetPos:=2;//负极搬运升降1移动至放极片位
			END_IF
		END_IF
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Homed AND
			 arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[2] THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.iGoSetPos:=2;//负极搬运旋转至放极片位
			END_IF
		END_IF
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[2]  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[2] THEN
			DT_SingeMode();//叠片单步选择
			Ca_StandbyStep2:=120;
		END_IF
	END_IF
120://判断负极流水线是否允许放极片  OR Mach_Control.U.EmptyRunMode
	IF NOT DP_SinStepe THEN
		IF Mach_Control.Ca_b.Ca_CacheBeltFLOK AND  Mach_Control.Ca_b.Ca_SegbeltFalg THEN
			DT_SingeMode();//单步选择
			Ca_StandbyStep2:=130;
		ELSIF NOT Mach_Control.Ca_b.Ca_SegbeltFalg THEN
			Ca_StandbyStep2:=0;
		END_IF
	END_IF
130://负极搬运升降1下降至放极片位
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[2]  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[2] AND 
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving AND 
			NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[3] THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=0;
				arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Cmd.bOFF:=TRUE;//负极搬运1升降真空关
				arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1].Cmd.bON:=FALSE;//负极搬运1升降真空关
				arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark1].Cmd.bON:=TRUE;//负极搬运1升降破真空开
				arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark1].Cmd.bOFF:=FALSE;//负极搬运1升降破真空开
				Mach_Control.Ca_b.Ca_SegbeltFalg:=FALSE;//置位负极取模切分段机械手有极片标记
				Par.stDT_date.Ca_betlCount.0:=TRUE;//置位负极片流水线放片位有片
				Par.stDT_date.Ca_MQ_Slice[1]:=Par.stDT_date.Ca_MQ_Slice[0];
				DT_SingeMode();//单步选择
				Ca_StandbyStep2:=140;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=3;//负极搬运升降1移动至放极片高度
			END_IF
		ELSE
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[2] THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.iGoSetPos:=2;//负极搬运升降1移动至放极片位
			END_IF	
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[2] THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.iGoSetPos:=2;//负极搬运旋转至放极片位
			END_IF			
		END_IF
	END_IF
140://负极送片搬运升降轴上升至安全位，真空关闭
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving AND 
			NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=0;
				DT_SingeMode();//单步选择
				Ca_StandbyStep2:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=1;//负极搬运升降1移动至初始高度
			END_IF
		END_IF
	END_IF				
END_CASE	
END_IF


//负极缓存流水线缓存极片自动	
CASE Ca_StandbyStep4 OF
0://判断是否可以补极片,负极搬运升降1轴在安全位，负极搬运各项降2轴在安全位，负极流水线放极片端有极片，负极片流水线取级片端没极片 
	IF NOT Par.stDT_date.Ca_betlCount.5 AND Par.stDT_date.Ca_betlCount.0 AND  Mach_Control.Ca_b.Ca_betlMoveOK  THEN
		IF NOT Mach_Control.se.Offloadingsensor THEN
				Par.stDT_date.Ca_betlCount.4:=FALSE;
		END_IF
		Ca_StandbyStep4:=10;
	ELSIF	Ca_StandbyStep2=120 AND NOT Par.stDT_date.Ca_betlCount.5 AND Par.stDT_date.Ca_betlCount.0  AND  NOT  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] THEN
               // ( arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fSetPos > arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[1]+0.5 OR
                //  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fSetPos < arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[1]-0.5)THEN
		         Mach_Control.Ca_b.Error[41]:=TRUE;//负极缓存皮带准备运动时，负极升降1不在安全位报警	
	END_IF
10://负极流水线皮带向前移动固定距离
	arrAxisCtrl[AxiseNo.AxisName.CaBelt].Cmd.bDynamitcsParSel:=1;	
	arrAxisPar[AxiseNo.AxisName.CaBelt].fTagatTime:=Par.stDT_date.BeltPoistTime;
	arrAxisCtrl[AxiseNo.AxisName.CaBelt].Cmd.fPosition_of_Rel:=Par.stDT_date.BeltPoistSet;
	arrAxisCtrl[AxiseNo.AxisName.CaBelt].Cmd.bMoveRel:=TRUE;	
	Ca_StandbyStep4:=20;
20:
	IF NOT arrAxisCtrl[AxiseNo.AxisName.CaBelt].Cmd.bMoveRel THEN
		Par.stDT_date.Ca_betlCount:=SHL(Par.stDT_date.Ca_betlCount,1);//极片向前移一位
		Ca_StandbyStep4:=31;
	END_IF

31:	
	Par.stDT_date.Ca_MQ_Slice[6]:=Par.stDT_date.Ca_MQ_Slice[5];
	Ca_StandbyStep4:=32;

32:
	Par.stDT_date.Ca_MQ_Slice[5]:=Par.stDT_date.Ca_MQ_Slice[4];
	Ca_StandbyStep4:=33;

33:
	Par.stDT_date.Ca_MQ_Slice[4]:=Par.stDT_date.Ca_MQ_Slice[3];
	Ca_StandbyStep4:=34;

34:	
	Par.stDT_date.Ca_MQ_Slice[3]:=Par.stDT_date.Ca_MQ_Slice[2];
	Ca_StandbyStep4:=35;

35:
	Par.stDT_date.Ca_MQ_Slice[2]:=Par.stDT_date.Ca_MQ_Slice[1];
	Ca_StandbyStep4:=36;

36://复位负极片流水线放片位有片
	MEMSET(ADR(Par.stDT_date.Ca_MQ_Slice[1]),0,SIZEOF(Par.stDT_date.Ca_MQ_Slice[1]));
	Par.stDT_date.Ca_betlCount.0:=FALSE;
	Ca_StandbyStep4:=0;
END_CASE


CASE Ca_StandbyStep2  OF
30://判断模切分段皮带是否允许取极片 OR Mach_Control.U.EmptyRunMode 
	IF NOT DP_SinStepe THEN
		IF Mach_Control.Ca_b.Ca_MainBeltOK THEN
			Mach_Control.Ca_b.Ca_MainBelting:=TRUE;//负极模切分段皮带取极片中
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1]	.Cmd.bON:=TRUE;//负极搬运1真空打开
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1]	.Cmd.bOFF:=FALSE;//负极搬运1真空关闭
			DT_SingeMode();//单步选择
			Ca_StandbyStep2:=35;
		//ELSE
		//	Ca_StandbyStep2:=0;
		END_IF
	END_IF
35://负极搬动升降1下降取极片
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[1] AND 
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND  NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[2] OR arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Moving THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=0;
				DT_SingeMode();//单步选择
				Ca_TON[6].IN:=FALSE;
				Ca_StandbyStep2:=40;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=2;//负极搬运升降1移动至初始高度
			END_IF					
		END_IF
	END_IF
40://负极搬动升降1下降取极片
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[1] AND 
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving AND 
	NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Error THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[2] THEN			
			IF NOT Ca_TON[6].Q THEN
				Ca_TON[6].IN:=TRUE;
			ELSE
				//Mach_Control.Ca_b.bCa_PoleHave:=TRUE;//负极取流水线极片完成，复位取片位置极片有无信号
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=0;
				//arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuum].Cmd.bOFF:=TRUE;//负极模切分段皮带真空关闭
				//arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuum].Cmd.bON:=FALSE;//负极模切分段皮带真空关闭
				//arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bON:=TRUE;//负极模切分段皮带破真空打开
				Mach_Control.Ca_b.Ca_SegbeltFalg:=TRUE;//置位负极取模切分段机械手有极片标记
				Par.stDT_date.Ca_MQ_Slice[0]:=Par.stDT_date.CaMQ_MES;//转移皮带上的数据
				DT_SingeMode();//单步选择
				Ca_TON[6].IN:=FALSE;
				Ca_StandbyStep2:=50;								
			END_IF								
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=2;//负极搬运升降1移动至初始高度
		END_IF					
	END_IF

50://
	//20240414 wcz
    IF   arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[2]-3) AND
		 arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Moving THEN
			Mach_Control.Ca_b.Ca_MainBelting:=FALSE;//负极模切分段皮带取极片中
			Mach_Control.Ca_b.Ca_BeltDone:=TRUE;//负极取主流水线极片完成		 
			Mach_Control.Ca_b.bCa_PoleHave:=TRUE;//负极取流水线极片完成，复位取片位置极片有无信号
	END_IF

	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving AND 
	NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Error THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=0;
			Mach_Control.Ca_b.Ca_MainBelting:=FALSE;//负极模切分段皮带取极片中
			Mach_Control.Ca_b.Ca_BeltDone:=TRUE;//负极取主流水线极片完成
			DT_SingeMode();//单步选择
			Ca_StandbyStep2:=0;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=1;//负极搬运升降1移动至初始高度
		END_IF
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_Cam" Id="{12873e1c-2dca-427e-9070-380ac47dfd41}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[Ca_Cam_ton[1](PT:=T#100MS);
Ca_Cam_ton[2](PT:=T#100MS);
Ca_Cam_ton[3](PT:=T#100MS);
Ca_Cam_ton[4](PT:=T#100MS);
Ca_Cam_ton[5](PT:=T#100MS);
