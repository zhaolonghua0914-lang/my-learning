 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.Home_Condition:=FALSE;	
END_IF

