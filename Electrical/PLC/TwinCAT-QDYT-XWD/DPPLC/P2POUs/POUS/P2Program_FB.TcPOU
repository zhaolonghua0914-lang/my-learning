	fMoveLength:=              , 
	fMasterKeyPos:=          250 , //
	
	axisMaster:=                 arrAxis[AxiseNo.VirAxisName.VirMain] ,  
    axisSlave:=                    arrAxis[AxiseNo.AxisName.AnCarryingLine] ,  
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );

fbAnCrectCamCarryingLine.bCreatTableDone;
fbAnCrectCamCarryingLine.bCreatTableError;
fbAnCrectCamCarryingLine.bError;
