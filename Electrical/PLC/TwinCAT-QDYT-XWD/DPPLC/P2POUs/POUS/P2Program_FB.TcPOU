AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[4]
 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.GoPoint_Condition[5]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.GoPoint_Condition[5]:=FALSE;	
END_IF


