	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed AND
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND
