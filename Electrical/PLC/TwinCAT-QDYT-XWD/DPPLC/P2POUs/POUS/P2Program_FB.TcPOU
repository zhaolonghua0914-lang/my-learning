	arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.WJ_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[1]  
 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
