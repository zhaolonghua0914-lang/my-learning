END_IF

IF  Mach_Control.U.WJ_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.arrbRealPoint[9]
AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[1] AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState
