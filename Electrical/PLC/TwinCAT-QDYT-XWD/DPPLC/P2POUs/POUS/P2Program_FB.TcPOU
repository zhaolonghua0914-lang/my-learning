ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1] AND  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.GoPoint_Condition[2]:=TRUE;
