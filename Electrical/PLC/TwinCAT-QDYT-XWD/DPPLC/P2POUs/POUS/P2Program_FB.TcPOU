	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.GoPoint_Condition[2]:=FALSE;	
