	fMoveLength:=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[1] , //安全高度
	fSaveLength:=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[4],//升降轴耦合初始位
	fMasterKeyPos1:=90 , 
	fMasterKeyPos2:=180 , 
