 arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Io.DIOFFSwitch  AND	 arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Io.DIOnSwitch  THEN
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.Home_Condition:=TRUE;
ELSE
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.Home_Condition:=FALSE;	
