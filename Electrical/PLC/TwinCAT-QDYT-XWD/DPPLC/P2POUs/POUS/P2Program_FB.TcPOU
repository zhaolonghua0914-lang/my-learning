	ErrorID=> );		
	
	
	
	
tailCurl2_GearIn(
	Master:=arrAxis[AxiseNo.VirAxisName.VirTailCurl]  , 
	Slave:=arrAxis[AxiseNo.AxisName.LCurlingneedleWhirling], 
	Execute:=tailCurl2_GearIn.Execute , 
