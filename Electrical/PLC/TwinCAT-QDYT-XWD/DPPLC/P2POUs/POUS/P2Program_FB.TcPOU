//fbCrectCamRightYDUpDown.fSaveLength1:=-ABS(arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[3]);
fbCrectCamRightYDUpDown.fMoveLength:=-ABS(arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[11]+arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[13]);
fbCrectCamRightYDUpDown.fSaveLength1:=-ABS(arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[12]+arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[13]);	
fbCrectCamRightYDUpDown.fSaveLength2:=-3;
fbCrectCamRightYDUpDown(
	bCreatTable:=                       fbCrectCamRightYDUpDown.bCreatTable , 
	Reset:=                                 stSysState.bReset  ,  
	iTable:=                                TableNo.M_RightYDUpDown  , 
	fMoveLength:= , 
	fSaveLength1:= , 
	fSaveLength2:= ,
	fMasterKeyPos1:=240 , //220 240
	fMasterKeyPos2:=250 , //234 250
	fMasterKeyPos3:=270 , //252 255
	fMasterKeyPos4:=315 , //300
	fMasterKeyPos5:=330 , //330
	fMasterKeyPos6:=342 , //342
    axisMaster:=                          arrAxis[AxiseNo.VirAxisName.VirMain] ,   
	axisSlave:=                             arrAxis[AxiseNo.AxisName.RightYDUpDown] ,  
	
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
fbCrectCamRightYDUpDown.bCreatTableDone;
fbCrectCamRightYDUpDown.bCreatTableError;
fbCrectCamRightYDUpDown.bError;

tYDCreateCamTON(IN:= , PT:=T#0.5S , Q=> , ET=> );
IF Mach_Control.U.DT_iMode=3 OR Mach_Control.U.DT_iMode=0 THEN//在手动状态下
			//从触摸屏创建叠台压刀凸轮
			rYDCreateCam_TRIG(CLK:=Mach_Control.DT_b.CreateCamStart1 , Q=> );		
			IF rYDCreateCam_TRIG.Q THEN
				tYDCreateCamTON.IN:=FALSE;
				YDCrectCamStep0:=10;
				Mach_Control.DT_b.Error[0]:=FALSE;
			END_IF
END_IF			
			//叠台压刀凸轮自动创建
			CASE YDCrectCamStep0 OF
					10:
							IF NOT 	tYDCreateCamTON.Q THEN
									fbCrectCamLeftYDUpDown.bCreatTable:=FALSE;;//左压刀升降凸轮创建
									fbCrectCamLeftYDLine.bCreatTable:=FALSE;//左压刀开合凸轮创建
									fbCrectCamRightYDLine.bCreatTable :=FALSE;//右压刀开合凸轮创建
									 fbCrectCamRightYDUpDown.bCreatTable:=FALSE;//右压刀升降凸轮创建
									 Mach_Control.DT_b.CreateCamDone1:=FALSE;	
									 tYDCreateCamTON.IN:=TRUE;				
							ELSE
										tYDCreateCamTON.IN:=FALSE;
										YDCrectCamStep0:=11;
							END_IF
							
					11:
							IF  NOT DT_Cam_ton[1].Q THEN
								arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bStop:=TRUE;
								arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bStop:=TRUE;
								arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bStop:=TRUE;
								arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bStop:=TRUE;
								DT_Cam_ton[1].IN:=TRUE;
							ELSE
								DT_Cam_ton[1].IN:=FALSE;
								YDCrectCamStep0:=12;
								arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bStop:=FALSE;
								arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bStop:=FALSE;
								arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bStop:=FALSE;
								arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bStop:=FALSE;
							END_IF
					
					12:
						IF  NOT DT_Cam_ton[2].Q THEN
							arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bReset:=TRUE;	
							arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bReset:=TRUE;
							arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bReset:=TRUE;
							arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bReset:=TRUE;		
							DT_Cam_ton[2].IN:=TRUE;
						 ELSE
							 DT_Cam_ton[2].IN:=FALSE;
							 YDCrectCamStep0:=13;
							arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bReset:=FALSE;	
							arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bReset:=FALSE;
							arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bReset:=FALSE;
							arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bReset:=FALSE;	
						 END_IF
							
					13:
						arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bEnable:=TRUE;
						arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bEnable:=TRUE;
						arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bEnable:=TRUE;
						arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bEnable:=TRUE;
						
						IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Enabled AND
							arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Enabled THEN
							 YDCrectCamStep0:=20;
						END_IF		
				
							
					20://创建凸轮
						fbCrectCamLeftYDUpDown.bCreatTable:=TRUE;;//左压刀升降凸轮创建
						fbCrectCamLeftYDLine.bCreatTable:=TRUE;//左压刀开合凸轮创建
						fbCrectCamRightYDLine.bCreatTable :=TRUE;//右压刀开合凸轮创建
						 fbCrectCamRightYDUpDown.bCreatTable:=TRUE;//右压刀升降凸轮创建
						 Mach_Control.DT_b.CreateCamDone1:=FALSE;
						 YDCrectCamStep0:=30;
					30://等待凸轮创建完成
						IF fbCrectCamLeftYDUpDown.bCreatTableDone AND fbCrectCamLeftYDLine.bCreatTableDone AND fbCrectCamRightYDLine.bCreatTableDone AND fbCrectCamRightYDUpDown.bCreatTableDone THEN
								Mach_Control.DT_b.CreateCamDone1:=TRUE;//叠台压凸轮创建完成
								YDCrectCamStep0:=6666;
						ELSE
								IF fbCrectCamLeftYDUpDown.bCreatTableError OR fbCrectCamLeftYDLine.bCreatTableError OR fbCrectCamRightYDLine.bCreatTableError OR fbCrectCamRightYDUpDown.bCreatTableError THEN
									Mach_Control.DT_b.Error[0]:=TRUE;//叠台压刀凸轮创建失败报警
									YDCrectCamStep0:=9999;
								END_IF
						END_IF
			END_CASE


(***********************************压刀凸轮耦合***********************************************)
(*
      fbCamInLeftYDLine                       :FB_CamIn ;    
      fbCamInLeftYDUpDown                :FB_CamIn ;    
      fbCamInRightYDLine                    :FB_CamIn ;    
      fbCamInRightYDUpDown             :FB_CamIn ;    

*)
//左压刀开合凸轮耦合
fbCamInLeftYDLine.ParCamIn.SlaveScaling;
fbCamInLeftYDLine(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInLeftYDLine.bCamInExecute, 
	iTable1:=                   TableNo.M_LeftYDLine  , 
	iTable2:=                   , 
	iTableSel:=                 , 
	ParCamIn:= , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.LeftYDLine] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

Mach_Control.DT_b.Error[12]:=fbCamInLeftYDLine.bError;
fbCamInLeftYDLine.bReady;
fbCamInLeftYDLine.bInSync;

//左压刀升降凸轮耦合
fbCamInLeftYDUpDown.ParCamIn.SlaveScaling;
fbCamInLeftYDUpDown(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInLeftYDUpDown.bCamInExecute, 
	iTable1:=                   TableNo.M_LeftYDUpDown  , 
	iTable2:=                   , 
	iTableSel:=                 , 
	ParCamIn:= , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.LeftYDUpDown] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

Mach_Control.DT_b.Error[13]:=fbCamInLeftYDUpDown.bError;
fbCamInLeftYDUpDown.bReady;
fbCamInLeftYDUpDown.bInSync;



//右压刀开合凸轮耦合
fbCamInRightYDLine.ParCamIn.SlaveScaling;
fbCamInRightYDLine(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInRightYDLine.bCamInExecute, 
	iTable1:=                   TableNo.M_RightYDLine  , 
	iTable2:=                   , 
	iTableSel:=                 , 
	ParCamIn:= , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.RightYDLine] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

Mach_Control.DT_b.Error[14]:=fbCamInRightYDLine.bError;
fbCamInRightYDLine.bReady;
fbCamInRightYDLine.bInSync;


//右压刀升降凸轮耦合
fbCamInRightYDUpDown.ParCamIn.SlaveScaling;
fbCamInRightYDUpDown(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInRightYDUpDown.bCamInExecute, 
	iTable1:=                   TableNo.M_RightYDUpDown  , 
	iTable2:=                   , 
	iTableSel:=                 , 
	ParCamIn:=                , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.RightYDUpDown] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

Mach_Control.DT_b.Error[15]:=fbCamInRightYDUpDown.bError;
fbCamInRightYDUpDown.bReady;
fbCamInRightYDUpDown.bInSync;

*)














]]></ST>
      </Implementation>
    </Action>
    <Action Name="Dietai_Gohome" Id="{94171a4a-14f3-4f26-89fb-f24af38266ad}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[DT_Home_TON[1](PT:=T#0.5S);
DT_Home_TON[2](PT:=T#0.5S);
DT_Home_TON[3](PT:=T#0.5S);


Dietai_GohomeOverTon(IN:= , PT:=T#90S , Q=> , ET=> );//叠台回原点超时报警延时

r_DTinitiStart(CLK:= Mach_Control.DT_b.ALLIniti_Hbtn AND  (TailCurlStep3<>105) AND TailCurlSEPTA_SafePos , Q=> );//叠台部分初始化上升沿
f_DTinitiStart(CLK:= Mach_Control.DT_b.ALLIniti_Hbtn AND  (TailCurlStep3<>105) AND TailCurlSEPTA_SafePos  , Q=> );//叠台部分初始化下降沿

rDT_GohmeTRGI(CLK:=Mach_Control.DT_b.DTIniti_Hbtn , Q=> );//叠台部分初始化上升沿
fDT_GohmeTRGI(CLK:=Mach_Control.DT_b.DTIniti_Hbtn , Q=> );//叠台部分初始化下降沿	
tDT_GohomeTON(IN:= , PT:=T#0.3S , Q=> , ET=> );
Mach_Control.DT_b.ALLIniti_Done:=Mach_Control.Ca_b.Ca_GohomeDone 
AND Mach_Control.An_b.An_GohomeDone  
AND Mach_Control.DT_b.DTIniti_Done 
AND Mach_Control.Ca_b.Ca_BeltGohomeDone ;
////叠片凸轮报警，请初始化叠台后再启动
IF Mach_Control.U.DT_iMode=3 THEN//在手动状态下
		IF r_DTinitiStart.Q THEN
			Mach_Control.DT_b.Step[0]:=0;
			Mach_Control.Ca_b.Ca_GohomeDone:=FALSE;
			Mach_Control.An_b.An_GohomeDone :=FALSE;
			Mach_Control.DT_b.DTIniti_Done:=FALSE;
			Dietai_GohomeDone:=FALSE;//叠台回原点完成
			Dietai_Gohoming:=FALSE;//叠台回原点中
            		Mach_Control.DT_b.DT_camError:=FALSE;//叠片凸轮报警，请初始化叠台后再启动
			//Mach_Control.DT_b.Step[0]:=10;
		END_IF	
END_IF		


IF rDT_GohmeTRGI.Q THEN
	Step_InitDT:=0;
	Dietai_GohomeDone:=FALSE;//叠台回原点完成
	Dietai_Gohoming:=FALSE;//叠台回原点中
	DTIniti_Done:=FALSE;//叠台回原点完成
END_IF	


IF Mach_Control.Ca_b.Ca_GohomeDone AND Mach_Control.An_b.An_GohomeDone AND Mach_Control.DT_b.DTIniti_Done (*AND Mach_Control.Ca_b.Ca_BeltGohomeDone*) THEN
	Mach_Control.DT_b.DT_init_OK:=TRUE;
ELSE
	Mach_Control.DT_b.DT_init_OK:=FALSE;
END_IF
				

(*********************************************************************************叠片轴回原点********************************************************************************************)
IF Mach_Control.U.DT_iMode=3 THEN//在手动状态下
	//回原点超时报警	
	IF  Dietai_Gohoming THEN
		IF  NOT Dietai_GohomeOverTon.Q THEN
			    Dietai_GohomeOverTon.IN:=TRUE;
		ELSE
			IF Dietai_GohomeOverTon.Q THEN
				   Mach_Control. DT_b.Error[23]:=TRUE;//叠台回原点超时报警
				   Dietai_GohomeOverTon.IN:=FALSE;
			END_IF	 			 
		END_IF
	
	ELSE
		Dietai_GohomeOverTon.IN:=FALSE;
	END_IF			

CASE Mach_Control.DT_b.Step[0] OF 
0://在手动模式下触发回原点
	IF f_DTinitiStart.Q THEN
		KD_Mark:=FALSE;//空叠隔膜中	
		DP_CheseCam:=FALSE;
		Step_InitDT:=0;
		Step_InitAnDT:=0;
		Step_InitCaDT:=0;
		Mach_Control.Ca_b.Ca_GohomeDone:=FALSE;
		Mach_Control.An_b.An_GohomeDone :=FALSE;
		Dietai_GohomeDone:=FALSE;//叠台回原点完成
		Mach_Control.An_b.An_GohomeHMI:=FALSE;
		Mach_Control.Ca_b.Ca_GohomeHMI:=FALSE;
		Mach_Control.DT_b.DTIniti_Hbtn:=FALSE;
		Mach_Control.DT_b.DTIniti_Done:=FALSE;
		Blueflaging:=FALSE;	
		Mach_Control.DT_b.Step[0]:=10;
	END_IF
10://正、负极取料初始化
		Mach_Control.An_b.An_GohomeHMI:=TRUE;
		Mach_Control.Ca_b.Ca_GohomeHMI:=TRUE;
		//Mach_Control.DT_b.DT_QLqr:=TRUE;
		Mach_Control.DT_b.Step[0]:=20;	
20://判断正负极取料初始化是否完成
		Mach_Control.An_b.An_GohomeHMI:=FALSE;
		Mach_Control.Ca_b.Ca_GohomeHMI:=FALSE;
		IF Mach_Control.Ca_b.Ca_GohomeDone AND Mach_Control.An_b.An_GohomeDone AND 
		 arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] THEN
				Mach_Control.DT_b.Step[0]:=30;
		END_IF
30://叠台部分初始化
		Mach_Control.DT_b.DTIniti_Hbtn:=TRUE;
		Mach_Control.DT_b.Step[0]:=40;
40://判断叠台初始化是否完成
	Mach_Control.DT_b.DTIniti_Hbtn:=FALSE;
	IF Mach_Control.DT_b.DTIniti_Done THEN							
		Mach_Control.DT_b.Step[0]:=0;
	END_IF	
END_CASE
IF Step_InitCaDT=9999 OR Step_InitAnDT=9999 OR Step_InitDT=9999 THEN
	Mach_Control.DT_b.Step[0]:=0;
END_IF
			
			
(*********************************************************************************叠台部分轴回原点********************************************************************************************)		
//判断叠台是否回原点完成
IF arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Homed AND
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Homed AND DTIniti_Done THEN
	Mach_Control.DT_b.DTIniti_Done:=TRUE;//叠台回原点完成
ELSE
	Mach_Control.DT_b.DTIniti_Done:=FALSE;//叠台回原点完成
END_IF


	
	CASE Step_InitDT OF 		
			0://等待叠台初始化启动
				IF fDT_GohmeTRGI.Q AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1]  THEN
					Dietai_GohomeDone:=FALSE;//叠台回原点完成
		           		Dietai_Gohoming:=TRUE;//叠台回原点中
					Mach_Control.DT_b.DTIniti_Hbtn:=FALSE;
					Step_InitDT:=1;
				END_IF
			1://复位回原点完成
					DTIniti_Done:=FALSE;//叠台回原点完成
					tDT_GohomeTON.IN:=FALSE;
					IF NOT DTIniti_Done THEN
							Step_InitDT:=10;
					END_IF
			10://
				
				DP_Step0:=0;
				DP_Step1:=0;	
				DP_Step3:=0;
				DP_Step4:=0;
				DP_Step11:=0;
				DP_Step12:=0;
				iTensionAutoStep:=0;
				bFirstFoldFinish[1] R=Mach_Control.An_b.An_FirstFoldCnt=0 AND Mach_Control.Ca_b.Ca_FirstFoldCnt=0;//首层隔膜空叠
				bFirstFoldFinish[2]:=FALSE;//正常电芯空叠隔膜
				bFirstFoldFinish[3]:=FALSE;//接带、黄标空叠隔膜
				bEmptyFoldMark[1] R=Mach_Control.An_b.An_FirstFoldCnt=0 AND Mach_Control.Ca_b.Ca_FirstFoldCnt=0;//进入空叠流程
				bEmptyFoldMark[2]:=FALSE;//进入空叠流程
				bEmptyFoldMark[3]:=FALSE;//进入空叠流程	
				//Mach_Control.An_b.An_FirstFoldCnt:=0;
				//Mach_Control.Ca_b.Ca_FirstFoldCnt:=0;
				iEmptyFoldStep[1]:=0;
				iEmptyFoldStep[2]:=0;
				iEmptyFoldStep[3]:=0;
				Mach_Control.An_b.An_KDQuantited :=0;
				Mach_Control.Ca_b.Ca_KDQuantited:=0;
				Mach_Control.DT_b.OverhandFirstPice:=0;
				Ca_OverNGStep:=0;	
				An_OverNGStep:=0;								
	        	An_OverNGMark:=FALSE;	
	        	Ca_OverNGMark:=FALSE;
				OversequelNG:=FALSE;	
	
				DT_Readydown:=FALSE;
				DP_CheseCam:=FALSE;	
				CellMemory[Mach_Control.DT_b.DT_Memory].Cell:=FALSE;	
				Mach_Control.DT_b.OffloadRequest:=FALSE;//叠电芯完成，请求下电芯
				CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_TF:=FALSE;	//叠电芯对齐度NG踢废信号
				Mach_Control.DT_b.Overhang_TF:=FALSE;
				
				arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Cmd.bON:=TRUE;
				fbCamInLeftYDLine.bCamInExecute:=FALSE;//左压刀开合
				fbCamInLeftYDUpDown.bCamInExecute:=FALSE;//左压刀升降
				fbCamInRightYDLine.bCamInExecute:=FALSE;//右压刀开合
				fbCamInRightYDUpDown.bCamInExecute:=FALSE;//左压刀升降
				
				fbCamInGMBuffer.bCamInExecute:=FALSE;//隔膜缓存
				fbCamInGMDanserMove.bCamInExecute:=FALSE;//隔膜平移
				fbCamInVirGMDriver.bCamInExecute:=FALSE;//隔膜放卷虚轴
				
               	 		arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;//叠台压隔膜气缸缩回	
				VirMain_TON.IN:=FALSE;
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
				IF arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Io.DIOFFSwitch AND NOT fbCamInLeftYDLine.bCamInExecute AND 
					NOT fbCamInLeftYDUpDown.bCamInExecute AND NOT fbCamInRightYDLine.bCamInExecute AND 
					NOT  fbCamInRightYDUpDown.bCamInExecute AND NOT fbCamInGMBuffer.bCamInExecute AND 
					NOT fbCamInGMDanserMove.bCamInExecute AND NOT fbCamInVirGMDriver.bCamInExecute  THEN
					 
						Step_InitDT:=20;
				END_IF	
			20://轴停止 
				arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bHalt:=TRUE;//隔膜缓存解耦
				arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.bHalt:=TRUE;//隔膜放卷纠偏解耦
				arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.bHalt:=TRUE;//隔膜尾部纠偏解耦
				arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bHalt:=TRUE;//左压刀升降轴解耦
				arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bHalt:=TRUE;//左压刀开合轴解耦
				arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bHalt:=TRUE;//右压刀升降轴解耦
				arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bHalt:=TRUE;//右压刀开合轴解耦
				arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bHalt:=TRUE;//隔膜平移轴解耦			
				 IF  	NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.NoMoving AND
					   NOT arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.NoMoving AND
					   NOT arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.NoMoving AND 
					   NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving AND
					   NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.NoMoving AND
					   NOT arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving AND
					   NOT arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.NoMoving AND
					   NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Coupled AND	arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.NoMoving THEN
							arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bHalt:=FALSE;//隔膜缓存解耦
							arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.bHalt:=FALSE;//隔膜放卷纠偏解耦
							arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.bHalt:=FALSE;//隔膜尾部纠偏解耦
							arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bHalt:=FALSE;//左压刀升降轴解耦
							arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bHalt:=FALSE;//左压刀开合轴解耦
							arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bHalt:=FALSE;//右压刀升降轴解耦
							arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bHalt:=FALSE;//右压刀开合轴解耦
							arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bHalt:=FALSE;//隔膜平移轴解耦										   							   
							Step_InitDT:=30;
				   END_IF				   
				30://轴上使能
						arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bEnable:=TRUE;//隔膜缓存
						arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.bEnable:=TRUE;//隔膜放卷纠偏
						arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.bEnable:=TRUE;//隔膜尾部纠偏
						arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bEnable:=TRUE;//左压刀升降轴
						arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bEnable:=TRUE;//左压刀开合轴
						arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bEnable:=TRUE;//右压刀升降轴
						arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bEnable:=TRUE;//右压刀开合轴
						arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bEnable:=TRUE;//隔膜平移轴		
						 IF  arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Enabled AND 
							   arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Enabled AND 
							   arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Enabled AND 
							   arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Enabled AND 
							   arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Enabled AND 
							   arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Enabled AND 
							   arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Enabled AND 
							   arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Enabled THEN
							Step_InitDT:=40;
						ELSIF    arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Error OR 
								   arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Error OR 
								   arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Error OR 
								   arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Error OR 
								   arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Error OR 
								   arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Error OR 
								   arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Error OR 
								   arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Error THEN
							Dietai_Gohoming:=FALSE;//叠台回原点中	   
							Step_InitDT:=9999;								
						END_IF	   
			40://隔膜缓存回原点、隔膜纠偏上回原点、隔膜纠偏下回原点
				
				arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bHome:=TRUE;//隔膜缓存回原点
				arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.bHome:=TRUE;//隔膜放卷纠偏回原点
				arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.bHome:=TRUE;//隔膜尾部纠偏回原点
				Step_InitDT:=50;
			50://判断轴回原点是否完成
				  IF NOT tDT_GohomeTON.Q THEN
							  tDT_GohomeTON.IN:=TRUE;
				  ELSE
					  IF arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.NoMoving AND
						  arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.NoMoving AND 
						  arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.NoMoving THEN
						  tDT_GohomeTON.IN:=FALSE;
						  arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bHome:=FALSE;//隔膜缓存回原点
						  arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.bHome:=FALSE;//隔膜放卷纠偏回原点
						  arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.bHome:=FALSE;//隔膜尾部纠偏回原点
						  Step_InitDT:=51;
						ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Error OR  arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Error OR 
							arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Error THEN
							tDT_GohomeTON.IN:=FALSE;
							arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bHome:=FALSE;//隔膜缓存回原点
							arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.bHome:=FALSE;//隔膜放卷纠偏回原点
							arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.bHome:=FALSE;//隔膜尾部纠偏回原点
							Dietai_Gohoming:=FALSE;//叠台回原点中
							Step_InitDT:=9999;											 
					  END_IF
				  END_IF
			51://缓存、放卷纠偏、底部纠偏
				  IF NOT tDT_GohomeTON.Q THEN
				  	tDT_GohomeTON.IN:=TRUE;		
				  ELSE	
								IF NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.NoMoving THEN
								   arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.iGoSetPos:=1;
								END_IF					
								IF NOT arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.NoMoving THEN
								   arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.iGoSetPos:=1;
								END_IF	
								IF NOT arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.NoMoving THEN
								   arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.iGoSetPos:=1;
								END_IF			
								IF   arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.arrbRealPoint[1] AND 
									  arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.arrbRealPoint[1] THEN
									  	tDT_GohomeTON.IN:=FALSE;	
										Step_InitDT:=55;
								ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Error THEN
										tDT_GohomeTON.IN:=FALSE;	
										Dietai_Gohoming:=FALSE;//叠台回原点中
										Step_InitDT:=9999;
								END_IF
					END_IF
					
			55://判断左右压刀开合、升降是否在初始位,与其都已经回原完成
				IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed AND 
					arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND
					arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed AND
					arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed THEN
					Step_InitDT:=180;
					ELSE
					Step_InitDT:=60;	
				END_IF
				
					
		
			60://左压刀升降轴回原点
				arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bHome:=TRUE;//左压刀升降轴回原点
				Step_InitDT:=70;
			70://判断左压刀升降轴回原是否完成
				  IF NOT tDT_GohomeTON.Q THEN
							  tDT_GohomeTON.IN:=TRUE;
				  ELSE
							  IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
									arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bHome:=FALSE;//左压刀升降轴回原点
									tDT_GohomeTON.IN:=FALSE;
								  	Step_InitDT:=80;
							  ELSIF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Error THEN
								  	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bHome:=FALSE;//左压刀升降轴回原点
									tDT_GohomeTON.IN:=FALSE;
									Dietai_Gohoming:=FALSE;//叠台回原点中
								  	Step_InitDT:=9999;							  
							  END_IF
					END_IF		
					
			80://左压刀开合轴回原点
				arrCyCtrl[arrCyNo.ElectValveName.DTVacuum].Cmd.bON:=FALSE;
				arrCyCtrl[arrCyNo.ElectValveName.DTVacuum].Cmd.bOFF:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bHome:=TRUE;//左压刀开合轴回原点
				Step_InitDT:=90;
			90://判断左压刀开合轴回原点是否完成
				  IF NOT tDT_GohomeTON.Q THEN
							  tDT_GohomeTON.IN:=TRUE;
				  ELSE
						IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.NoMoving  THEN
							tDT_GohomeTON.IN:=FALSE;
							arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bHome:=FALSE;//左压刀开合轴回原点
							Step_InitDT:=100;
						ELSIF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Error THEN
							tDT_GohomeTON.IN:=FALSE;
							arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bHome:=FALSE;//左压刀开合轴回原点
							Dietai_Gohoming:=FALSE;//叠台回原点中
							Step_InitDT:=9999;
						END_IF
				END_IF
			100://左压刀开合轴移动至初始位
				IF NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.NoMoving THEN//左压刀开合轴移动至初始位
				   arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=1;
				END_IF
				IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Error THEN
					Dietai_Gohoming:=FALSE;//叠台回原点中
					Step_InitDT:=9999;
				ELSIF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.NoMoving THEN
					Step_InitDT:=110;
				END_IF
			110://左压刀升降轴移动至初始位
				IF NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving  THEN//左压刀开合轴移动至初始位
				   arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=1;
				END_IF
				IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Error THEN
					Dietai_Gohoming:=FALSE;//叠台回原点中
					Step_InitDT:=9999;
				ELSIF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
					Step_InitDT:=120;
				END_IF
			120://右压刀升降轴回原点
				arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bHome:=TRUE;//右压刀升降轴回原点
				Step_InitDT:=130;
			130://判断轴回原点是否完成
				  IF NOT tDT_GohomeTON.Q THEN
							  tDT_GohomeTON.IN:=TRUE;
				  ELSE
							IF  arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
								tDT_GohomeTON.IN:=FALSE;
								arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bHome:=FALSE;//右压刀升降轴回原点
								Step_InitDT:=140;
							ELSIF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Error THEN
									tDT_GohomeTON.IN:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bHome:=FALSE;//右压刀升降轴回原点
									Dietai_Gohoming:=FALSE;//叠台回原点中
									Step_InitDT:=9999;
							END_IF	
				END_IF
			140://右压刀开合轴回原点
				arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bHome:=TRUE;//右压刀开合轴回原点
				Step_InitDT:=150;
			150://判断开合轴回原点是否完成
				  IF NOT tDT_GohomeTON.Q THEN
							  tDT_GohomeTON.IN:=TRUE;
				  ELSE
							  IF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.NoMoving THEN
									 tDT_GohomeTON.IN:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bHome:=FALSE;//右压刀开合轴回原点
									Step_InitDT:=160;
							   ELSIF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Error THEN
								   		 tDT_GohomeTON.IN:=FALSE;
										arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bHome:=FALSE;//右压刀开合轴回原点
										Dietai_Gohoming:=FALSE;//叠台回原点中
										Step_InitDT:=9999;				   
							  END_IF	
					END_IF
			160://右压刀开合轴移动至初始位
				IF NOT arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.NoMoving THEN//右压刀开合轴移动至初始位
				   arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=1;
				END_IF
				IF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Error THEN
					Dietai_Gohoming:=FALSE;//叠台回原点中
					Step_InitDT:=9999;
				ELSIF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.NoMoving THEN
					Step_InitDT:=170;
				END_IF	
			170://右压刀升降轴移动至初始位	
				IF NOT arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN//右压刀升降轴移动至初 始位
				   arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=1;
				END_IF
				IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Error THEN
					Dietai_Gohoming:=FALSE;//叠台回原点中
					Step_InitDT:=9999;
				ELSIF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving  THEN
					Step_InitDT:=180;
				END_IF	
			180://隔膜平移轴回原点
				IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] 
					AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed AND 
					arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND
					arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed AND
					arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed  THEN
						arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bHome:=TRUE;//隔膜平移轴回原点
						Step_InitDT:=190;
				END_IF	
			190://判断回原点是否完成
				  IF NOT tDT_GohomeTON.Q THEN
							  tDT_GohomeTON.IN:=TRUE;
				  ELSE
						IF 	arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Homed THEN
							 tDT_GohomeTON.IN:=FALSE;
							arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bHome:=FALSE;//隔膜平移轴回原点
							Step_InitDT:=200;
						ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Error THEN
							tDT_GohomeTON.IN:=FALSE;
							arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bHome:=FALSE;//隔膜平移轴回原点
							Dietai_Gohoming:=FALSE;//叠台回原点中
							Step_InitDT:=9999;
						END_IF	
					END_IF
			200://隔膜平移轴移动至初始位
				IF NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.NoMoving THEN//左压刀开合轴移动至初始位
				   arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.iGoSetPos:=1;
				END_IF
				IF NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.NoMoving THEN//左压刀开合轴移动至初始位
				   arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.iGoSetPos:=1;
				END_IF
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.NoMoving AND 
					 arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.NoMoving THEN
							DTIniti_Done:=TRUE;//叠台回原点完成
							Dietai_Gohoming:=FALSE;//叠台回原点中
							Dietai_GohomeDone:=TRUE;//叠台回原点完成
							Step_InitDT:=0;
				ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Error THEN
					        Dietai_Gohoming:=FALSE;//叠台回原点中
							Step_InitDT:=9999;
				END_IF				
	END_CASE
END_IF	












]]></ST>
      </Implementation>
    </Action>
    <Action Name="DT_Alarm" Id="{37a313e5-b6b4-4159-a665-4e41adca7fa3}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[DT_AlarmTon[0](PT:=T#2S);
DT_AlarmTon[1](PT:=T#10MS);
DT_AlarmTon[2](PT:=T#100MS);
DT_AlarmTon[3](PT:=T#2S);
DT_AlarmTon[4](IN:=   NOT Mach_Control.DT_b.bTensionOK AND Mach_Control.U.DT_iMode=1  AND DP_Step0=0, PT:=T#60S , Q=> , ET=> );
//Mach_Control.DT_b.Error[1]:=TRUE;//隔膜缓存凸轮创建失败
//Mach_Control.DT_b.Error[2] :=TRUE;//叠台储气罐真空不足报警
//Mach_Control.DT_b.Error[3]:=TRUE;////凸轮耦合时，左压刀升降不在低位
//Mach_Control.DT_b.Error[4]:=TRUE;//凸轮耦合时，右压刀升降不在低位
//Mach_Control.DT_b.Error[5]:=TRUE;//叠负极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
//Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
//Mach_Control.DT_b.Error[7]:=TRUE;//叠正极片凸轮耦合时，负极取片即不在取片位，也不在叠片位
//Mach_Control.DT_b.Error[8]:=TRUE;//叠正极片凸轮耦合时，正极片不在取片位
//Mach_Control.DT_b.Error[9];//纠偏凸轮耦合失败报警
//Mach_Control.DT_b.Error[10];//纠偏左限位报警
//Mach_Control.DT_b.Error[11];//纠偏右限位报警
//Mach_Control.DT_b.Error[12]=左压刀开合凸轮耦合报警
//Mach_Control.DT_b.Error[13]=左压刀升降凸轮耦合报警
//Mach_Control.DT_b.Error[14]=右压刀开合凸轮耦合报警
//Mach_Control.DT_b.Error[15]=右压刀升降凸轮耦合报警
//Mach_Control.DT_b.Error[16]=隔膜放卷凸轮报警
//Mach_Control.DT_b.Error[17]=隔膜平移凸轮报警
//Mach_Control.DT_b.Error[18]=隔膜缓存凸轮报警
//Mach_Control.DT_b.Error[19]=凸轮耦合报警
//Mach_Control.DT_b.Error[20]:=TRUE;//CCD通讯异常
//Mach_Control.DT_b.Error[21];//隔膜纠偏报警
//Mach_Control.DT_b.Error[22]=主轴启动超时报警
//Mach_Control.DT_b.Error[23]=叠台回原点超时报警  
//Mach_Control.DT_b.Error[24] :=TRUE;//放卷卷径报警
//Mach_Control.DT_b.Error[25] :=TRUE;//正极已叠片数大于负极已叠片数报警
//Mach_Control.DT_b.Error[26] :=TRUE;//连续对齐度NG报警
//Mach_Control.DT_b.Error[27]:=TRUE;//检测到叠台重片，请查看是否重片
//Mach_Control.DT_b.Error[28] :=TRUE;//叠台左压刀使用已经超出寿命报警
//Mach_Control.DT_b.Error[29] :=TRUE;//叠台右压刀使用已经超出寿命报警
//Mach_Control.DT_b.Error[30];//凸轮耦合时，正极送片搬运平移不在取片位
//Mach_Control.DT_b.Error[31];凸轮耦合时，正极送片搬运平移不在放片位
//Mach_Control.DT_b.Error[32];凸轮耦合时，正极叠片搬运平移不在取片位
//Mach_Control.DT_b.Error[33];凸轮耦合时，正极叠片搬运平移不在放片位
//Mach_Control.DT_b.Error[34];凸轮耦合时，正极送片搬运旋转不在取片位
//Mach_Control.DT_b.Error[35];凸轮耦合时，正极送片搬运旋转不在放片位
//Mach_Control.DT_b.Error[36];凸轮耦合时，正极送片搬运升降不在等待高度
//Mach_Control.DT_b.Error[37];凸轮耦合时，正极叠片搬运升降不在等待高度  
//Mach_Control.DT_b.Error[38];//凸轮耦合时，负极送片搬运平移2不在取片位
//Mach_Control.DT_b.Error[39];//凸轮耦合时，负极送片搬运平移2不在放片位
//Mach_Control.DT_b.Error[40];//凸轮耦合时，负极叠片搬运平移不在取片位
//Mach_Control.DT_b.Error[41];//凸轮耦合时，负极叠片搬运平移不在放片位
//Mach_Control.DT_b.Error[42];//凸轮耦合时，负极送片搬运升降不在等待高度
//Mach_Control.DT_b.Error[43];//凸轮耦合时，负极叠片搬运升降不在等待高度  
//Mach_Control.DT_b.Error[44]:=TRUE;//自动时，隔膜气胀轴未涨紧报警		
//Mach_Control.DT_b.Error[45]////隔膜张力报警
//Mach_Control.DT_b.Error[46]=对齐度NG料盒料满
//Mach_Control.DT_b.Error[47]=对齐度NG剔废一次
//Mach_Control.DT_b.Error[48]=CCD工控机磁盘容量报警
//Mach_Control.DT_b.Error[49]=叠片平台当前极片折角报警
//Mach_Control.DT_b.Error[50]=触发对其度拍照时压刀在极片上面报警
//Mach_Control.DT_b.Error[51]=检测负极纠偏平台空片结果返回超时
//Mach_Control.DT_b.Error[52]=检测正极纠偏平台空片结果返回超时
//Mach_Control.DT_b.Error[53]=隔膜长度小于多少米
//Mach_Control.DT_b.Error[54]=陶瓷面感应器报警，请检查隔膜是否正确安装陶瓷面
//Mach_Control.DT_b.Error[55]叠首层隔膜过程中，隔膜平移轴未动作
//Mach_Control.DT_b.Error[56]叠台已到达清洁时间
//Mach_Control.DT_b.Error[57]空叠隔膜时正负极都不在取片位
//Mach_Control.DT_b.Error[58]---备用
//Mach_Control.DT_b.Error[59]叠台对齐度检测NG报警
//Mach_Control.DT_b.Error[60];//主轴启动前轴有故障
//Mach_Control.DT_b.Error[61];//主剩余隔膜不能叠一个电芯，请更换隔膜
//Mach_Control.DT_b.Error[62];//自动时隔膜张力未OK
//Mach_Control.DT_b.Error[63];//功能开关状态报警
//Mach_Control.DT_b.Error[64];//叠台有功能屏蔽报警
//Mach_Control.DT_b.Error[65];//压刀间距报警
//Mach_Control.DT_b.Error[66];//压刀铁氟龙计数到达设定值
//Mach_Control.DT_b.Error[67];//上电后叠台参数读取失败，请手动点读取参数
//Mach_Control.DT_b.Error[68];//正极对齐度拍照发送层数错误
//Mach_Control.DT_b.Error[69];//负极对齐度拍照发送层数错误
//Mach_Control.DT_b.Error[70];//正极对齐度接收结果为0
//Mach_Control.DT_b.Error[71];//负极对齐度接收结果为0
//叠台对齐度检测报警
IF Mach_Control.DT_b.iOverError=2 AND NOT Mach_Control.DT_b.DT_Overhang THEN
	//Mach_Control.DT_b.Error[59]:=TRUE;//对齐度检测
	Mach_Control.DT_b.Error_tips[6]:=TRUE;//叠台对齐度检测均值超限警告
END_IF
IF Mach_Control.DT_b.Error_tips[6]  AND fDT_AlarmRest.Q THEN
	Mach_Control.DT_b.iOverError:=0;
	Mach_Control.DT_b.Error_tips[6]:=FALSE;
END_IF
//对齐度连续超限检测预警
IF CCD.Over.Finish.OverhangXY_Warm=1 THEN
	Mach_Control.DT_b.Overhang_Warm:=TRUE;
(*ELSE
	CCD.Over.Start.OverhangXY_Warm_Reset:=1;*)
END_IF
IF Mach_Control.DT_b.Overhang_Warm AND Mach_Control.DT_b.Overhang_Warm_Reset THEN
	//CCD.Over.Start.OverhangXY_Warm_Reset:=0;
	CCD.Over.Finish.OverhangXY_Warm:=0;
	Mach_Control.DT_b.Overhang_Warm:=FALSE;
END_IF



IF    Mach_Control.se.Ceramics THEN//Mach_Control.U.DT_iMode=1 AND
	Mach_Control.DT_b.Error[54]:=TRUE;//陶瓷面感应器报警，请检查隔膜是否正确安装陶瓷面
//ELSE
//	Mach_Control.DT_b.Error[54]:=FALSE;//陶瓷面感应器报警，请检查隔膜是否正确安装陶瓷面
END_IF
IF  Par.stDT_date.CleanTimeHMIHour = System.StTime.wHour AND Par.stDT_date.CleanTimeHMIMin =System.stTime.wMinute THEN
	Mach_Control.DT_b.Error[56]:=TRUE;//请清洁机台叠台部分
END_IF

//清记录的标志位
IF rDT_AlarmRest.Q THEN
	FOR i:=1 TO 10 DO
		AnPosError[i] :=FALSE;
		CaPosError[i] :=FALSE;
		DTPosError[i] :=FALSE;
	END_FOR
END_IF
(********************************************************叠片时正负极搬运不在耦合位报警*****************************************************)
IF DP_Step0=9993 OR An_StandbyStep1=9993 OR Ca_StandbyStep0=9993 OR  DTPosError[11] THEN
 //正极取片轴不在耦合位报警	
 		PosErrorMark:=TRUE;//凸轮耦合时，有轴不在耦合位报警
   		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] THEN
			   IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1]  THEN              
						Mach_Control.DT_b.Error[30]:=TRUE;//凸轮耦合时，正极送片搬运平移不在取片位
			   END_IF       		
		ELSIF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[2] THEN
			   IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[2] THEN             
				 	 Mach_Control.DT_b.Error[31]:=TRUE;//凸轮耦合时，正极送片搬运平移不在放片位
			   END_IF		   	   
        END_IF
		
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] THEN
			   IF NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1]  THEN              
				  	Mach_Control.DT_b.Error[32]:=TRUE;//凸轮耦合时，正极叠片搬运平移不在取片位
			   END_IF       		
		ELSIF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[2] THEN
			   IF NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[2] THEN             
				 	Mach_Control.DT_b.Error[33]:=TRUE;//凸轮耦合时，正极叠片搬运平移不在放片位
			   END_IF		   	   		   		   
        END_IF
		
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] THEN
			   IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1]  THEN             
						Mach_Control.DT_b.Error[34]:=TRUE;//凸轮耦合时，正极送片搬运旋转不在取片位
			   END_IF		
		ELSIF arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[2] THEN
			   IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[2] THEN             
				 		Mach_Control.DT_b.Error[35]:=TRUE;//凸轮耦合时，正极送片搬运旋转不在放片位
			   END_IF
        END_IF

		IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN           
		 		Mach_Control.DT_b.Error[36]:=TRUE;//凸轮耦合时，正极送片搬运升降不在等待高度
	    END_IF  		   	
   
		IF NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN           
				Mach_Control.DT_b.Error[37]:=TRUE;//凸轮耦合时，正极叠片搬运升降不在等待高度  
	    END_IF 

		IF NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] THEN
				Mach_Control.DT_b.Error[3]:=TRUE;//凸轮耦合时，左压刀升降不在低位
		END_IF
		
		IF NOT arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
				Mach_Control.DT_b.Error[4]:=TRUE;//凸轮耦合时，右压刀升降不在低位
		END_IF
END_IF

IF DP_Step0=9994 OR An_StandbyStep1=9994 OR Ca_StandbyStep0=9994 OR  DTPosError[12]  THEN
//负极取片轴不在耦合位报警	
		PosErrorMark:=TRUE;//凸轮耦合时，有轴不在耦合位报警
   		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] THEN
			   IF NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1]  THEN             
						  Mach_Control.DT_b.Error[38]:=TRUE;//凸轮耦合时，负极送片搬运平移2不在取片位
			   END_IF		
		ELSIF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[2] THEN
			   IF NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[2] THEN               
					  Mach_Control.DT_b.Error[39]:=TRUE;//凸轮耦合时，负极送片搬运平移2不在放片位
			   END_IF
        END_IF
		
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] THEN
			   IF NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1]  THEN              
						Mach_Control.DT_b.Error[40]:=TRUE;//凸轮耦合时，负极叠片搬运平移不在取片位
			   END_IF		
		ELSIF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[2] THEN
			   IF NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[2] THEN              
				 		Mach_Control.DT_b.Error[41]:=TRUE;//凸轮耦合时，负极叠片搬运平移不在放片位
			   END_IF
        END_IF
	
		IF NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN            
		   		Mach_Control.DT_b.Error[42]:=TRUE;//凸轮耦合时，负极送片搬运升降不在等待高度
	    END_IF  		   	
   
		IF NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN          
		   		Mach_Control.DT_b.Error[43]:=TRUE;//凸轮耦合时，负极叠片搬运升降不在等待高度  
	    END_IF
	
		
		IF NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] THEN
				Mach_Control.DT_b.Error[3]:=TRUE;//凸轮耦合时，左压刀升降不在低位
		END_IF
		
		IF NOT arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
				Mach_Control.DT_b.Error[4]:=TRUE;//凸轮耦合时，右压刀升降不在低位
		END_IF  
END_IF


rDtUse[1](CLK:=PosErrorMark);

IF rDtUse[1].Q THEN
	PosErrorMark:=FALSE;//凸轮耦合时，有轴不在耦合位报警
	fActPos[1]:=arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.fActPos;//正极送片搬运平移
	fSetPos[1]:=arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.fSetPos;

	fActPos[2]:=arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fActPos;//正极送片搬运升降
	fSetPos[2]:=arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fSetPos;

	fActPos[3]:=arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.fActPos;//正极送片搬运旋转
	fSetPos[3]:=arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.fSetPos;

	fActPos[4]:=arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.fActPos;//正极叠台搬运平移
	fSetPos[4]:=arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.fSetPos;
	
	fActPos[5]:=arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.fActPos;//正极叠台搬运升降
	fSetPos[5]:=arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.fSetPos;
	
	fActPos[6]:=arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.fActPos;//负极送片搬运平移2
	fSetPos[6]:=arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.fSetPos;

	fActPos[7]:=arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fActPos;//负极送片搬运升降2
	fSetPos[7]:=arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fSetPos;
	
	fActPos[8]:=arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.fActPos;//负极叠台搬运平移
	fSetPos[8]:=arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.fSetPos;

	fActPos[9]:=arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.fActPos;//负极叠台搬运升降
	fSetPos[9]:=arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.fSetPos;

	fActPos[11]:=arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.fActPos;//左压刀升降
	fSetPos[11]:=arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.fSetPos;

	fActPos[12]:=arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.fActPos;//左压刀开合
	fSetPos[12]:=arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.fSetPos;
	
	fActPos[13]:=arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.fActPos;//右压刀升降
	fSetPos[13]:=arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.fSetPos;

	fActPos[14]:=arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.fActPos;//右压刀开合
	fSetPos[14]:=arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.fSetPos;	
END_IF

//判断叠台耦合中的轴是否有报警
IF 	(arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Coupled) OR 
		(arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Coupled)OR 
		(arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Coupled) OR 
		(arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Coupled)OR 
		(arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Coupled)OR
		(arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.Error AND arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.Coupled) THEN
		    //  (arrAxisCtrl[AxiseNo.VirAxisName.VirGM].Status.Error AND arrAxisCtrl[AxiseNo.VirAxisName.VirGM].Status.Coupled)
			arrAxisCamError:=TRUE;
ELSE
			arrAxisCamError:=FALSE;
END_IF



IF 	(NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Enabled) AND  
	(NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Enabled)   THEN
	     //(NOT arrAxisCtrl[AxiseNo.VirAxisName.VirGM].Status.Error AND arrAxisCtrl[AxiseNo.VirAxisName.VirGM].Status.Enabled)
		DTPosError[10]:=TRUE;
ELSE
		DTPosError[10]:=FALSE;
END_IF


rArrAxisCamError(CLK:=arrAxisCamError , Q=> );
IF rArrAxisCamError.Q THEN
	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bStop:=TRUE;//主轴停止运行
	Mach_Control.DT_b.Error_tips[7]:=TRUE;//叠台有轴故障触发主虚轴停止警告
END_IF
//CCD心跳异常报警
CDD_HeartTON1(IN:=ccd.bHeartbeat  , PT:=T#2S , Q=> , ET=> );
CDD_HeartTON2(IN:= NOT  ccd.bHeartbeat  , PT:=T#2S , Q=> , ET=> );
IF (CDD_HeartTON1.Q OR CDD_HeartTON2.Q) AND NOT Mach_Control.U.CCD_ChosesHMI THEN
	Mach_Control.DT_b.Error[20]:=TRUE;//CCD通讯异常
END_IF


DT_AlarmTon[0].IN:=Mach_Control.DT_b.fWindDiameter<=Par.stDT_date.fDiameterAlarm ;
	IF  DT_AlarmTon[0].Q THEN
			//Mach_Control.DT_b.Error[24] :=TRUE;//放卷卷径报警
	END_IF

DT_AlarmTon[1].IN:=Mach_Control.An_b.An_Quantited>Mach_Control.Ca_b.Ca_Quantited ;
	IF  DT_AlarmTon[1].Q THEN
			Mach_Control.DT_b.Error[25] :=TRUE;//正极已叠片数大于负极已叠片数报警
	END_IF


DT_AlarmTon[2].IN:=NN>=2 AND NOT Mach_Control.DT_b.Error[26] ;
	IF  DT_AlarmTon[2].Q THEN
			Mach_Control.DT_b.Error[26] :=TRUE;//连续对齐度NG报警
	END_IF


IF Par.stDT_date.YD_JS_L>=Par.stDT_date.YD_SM_L THEN
	Mach_Control.DT_b.Error[28] :=TRUE;//叠台左压刀使用已经超出寿命报警
END_IF


IF Par.stDT_date.YD_JS_R>=Par.stDT_date.YD_SM_R THEN
	Mach_Control.DT_b.Error[29] :=TRUE;//叠台右压刀使用已经超出寿命报警
END_IF

IF Mach_Control.DT_b.YD_JS_L_clear THEN
	Par.stDT_date.YD_JS_L:=0;
END_IF

IF Mach_Control.DT_b.YD_JS_R_clear THEN
	Par.stDT_date.YD_JS_R:=0;
END_IF

//叠台人工确认无片，，
IF Mach_Control.DT_b.CCD_Overhang_button THEN
	Mach_Control.DT_b.OverhandResult:=3;
END_IF

(*
//检测到叠台重片，请查看是否重片
IF Mach_Control.DT_b.Error[27] AND Mach_Control.DT_b.OverhandResult=3 AND fDT_AlarmRest.Q  THEN
	Mach_Control.DT_b.Error[27]:=FALSE;
	Mach_Control.DT_b.OverhandResult:=0;
END_IF
*)




//安全门
//IF Mach_Control.U.DT_iMode=1 THEN
	Mach_Control.DT_b.Door_error[1]:=(NOT Mach_Control.se.Securitydoorswitch1 AND NOT Mach_Control.DT_b.Door_Forbidden);
	Mach_Control.DT_b.Door_error[2]:=(NOT Mach_Control.se.Securitydoorswitch2 AND NOT Mach_Control.DT_b.Door_Forbidden);
	Mach_Control.DT_b.Door_error[3]:=(NOT Mach_Control.se.Securitydoorswitch3 AND NOT Mach_Control.DT_b.Door_Forbidden);
	Mach_Control.DT_b.Door_error[4]:=(NOT Mach_Control.se.Securitydoorswitch4 AND NOT Mach_Control.DT_b.Door_Forbidden);
//END_IF

//叠片报警复位处理
rDT_AlarmRest(CLK:=Sys_Control.btn.System_Rrestbtn , Q=> );
fDT_AlarmRest(CLK:=Sys_Control.btn.System_Rrestbtn , Q=> );
IF Mach_Control.U.DT_iMode=3 THEN//在手动状态下，复位报警
		IF fDT_AlarmRest.Q AND Mach_Control.DT_b.Error[26] THEN		
					Mach_Control.DT_b.Error[26]:=FALSE;
					NN:=0;
		END_IF
		IF fDT_AlarmRest.Q AND  Mach_Control.DT_b.Error[27] AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<1  THEN
				CCD.Over.Start.iPhotoDo:=2;
				Mach_Control.DT_b.CDD_OverStart:=TRUE;
		END_IF
		IF fDT_AlarmRest.Q AND NOT Mach_Control.DT_b.Error[27] THEN
				MEMSET(ADR(Mach_Control.DT_b.Error),0,SIZEOF(Mach_Control.DT_b.Error)); // 叠台报警复位
				MEMSET(ADR(Mach_Control.DT_b.Door_error),0,SIZEOF(Mach_Control.DT_b.Door_error)); // 叠台报警复位
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bStop:=FALSE;//主轴停止运行	
		END_IF
		IF fDT_AlarmRest.Q THEN
				IF 9991<=DP_Step0 AND DP_Step0<=10006 THEN
						arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
						DP_Step0:=0;
				END_IF
		END_IF				
END_IF

IF Mach_Control.DT_b.Error[12] OR Mach_Control.DT_b.Error[13] OR Mach_Control.DT_b.Error[14] OR Mach_Control.DT_b.Error[15] OR
	   Mach_Control.DT_b.Error[16] OR Mach_Control.DT_b.Error[17] OR Mach_Control.DT_b.Error[18] OR Mach_Control.DT_b.Error[19]	OR
	   Mach_Control.An_b.Error[11] OR Mach_Control.Ca_b.Error[11] THEN
	   Mach_Control.DT_b.DT_camError:=TRUE;//叠片凸轮报警，请初始化叠台后再启动
END_IF

DT_AlarmTon[3].IN:=NOT Mach_Control.se.QYcode ;
	IF  DT_AlarmTon[3].Q THEN
			Mach_Control.DT_b.Error[2] :=TRUE;//叠台储气罐真空不足报警
	END_IF

IF Mach_Control.U.DT_iMode=1 THEN
		IF NOT arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.ONState OR  DT_AlarmTon[4].Q	THEN
				Mach_Control.DT_b.Error[44]:=TRUE;//自动时，张力未OK报警		
		ELSE
				;//Mach_Control.DT_b.Error[44]:=FALSE;//自动时，张力未OK报警	
		END_IF
END_IF

//计算剩余隔膜长度
rGMmanual(CLK:=Par.stDT_date.GMlength_buttonl , Q=> );
IF rGMmanual.Q THEN
   Par.stDT_date.GMlength_manual2:=Par.stDT_date.GMlength_manual2+Par.stDT_date.GMlength_manual;	
END_IF

Par.stDT_date.GMlength_act:=Par.stDT_date.GMlength_set-(DPcount*par.stDT_date.Width)/1000-(LMcount*ABS(arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[2]-arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[3]))/1000-
(NGcount*ABS(arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[2]-arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[9]))/1000-Par.stDT_date.GMlength_manual2 ;
DPGMlength:=((214*par.stDT_date.Width)+ABS(arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[2]-arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[3]))/1000;

// (*Par.stDT_date.GMlength_actMach_Control.DT_b.fWindLength_M  < DPGMlength+5 AND Mach_Control.Ca_b.Ca_Quantited <= 0*) 
//rDtUse[6](CLK:=GMlappos[4]<=Par.stDT_date.GMAngleALM);

IF  ((Mach_Control.DT_b.fWindDiameter < Par.stDT_date.fDiameterAlarm  AND NOT Mach_Control.DT_b.GMAngleALMsel ) OR
     (GMlappos[3]<=Par.stDT_date.GMAngleALM AND GMlappos[3]>0 AND Mach_Control.DT_b.fWindDiameter<100  AND  Mach_Control.DT_b.GMAngleALMsel))  AND Mach_Control.Ca_b.Ca_Quantited <= 0 AND  Mach_Control.DT_b.bTensionOK  THEN
	Mach_Control.DT_b.Error[61]:=TRUE;//剩余隔膜不能叠一个电芯，请更换隔膜	
END_IF


IF arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.OFFState AND Mach_Control.DT_b.Error[61] THEN
	Par.stDT_date.GMlength_manual:=0;
	Par.stDT_date.GMlength_manual2:=0;
	DPcount:=0;
	LMcount:=0;
	NGcount:=0;
END_IF

IF DT_AlarmTon[4].Q THEN
   Mach_Control.DT_b.Error[62]:=TRUE;//自动时隔膜张力未OK
END_IF


//压刀铁氟龙计数到达设定值
IF Par.stDT_date.YD_ferrJS>=Par.stDT_date.YD_ferrset THEN
	Mach_Control.DT_b.Error[66]:=TRUE;//压刀铁氟龙计数到达设定值
END_IF
IF Mach_Control.DT_b.YD_ferrJSclear THEN
   Par.stDT_date.YD_ferrJS:=0;
 END_IF  
 
IF NOT arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.Homed   THEN
   Mach_Control.DT_b.Error_tips[8]:=TRUE;////叠台升降未回原点提示 
ELSE
   Mach_Control.DT_b.Error_tips[8]:=FALSE;////叠台升降未回原点提示
END_IF

//压刀限位报警
IF  NOT Dietai_Gohoming  AND  (arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Io .biPosLimit OR arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Io .biNegLimit) THEN 
           Mach_Control.DT_b.Error[72]:=TRUE;//左压刀升降限位报警
END_IF		   

IF  NOT Dietai_Gohoming  AND  (arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Io .biPosLimit OR arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Io .biNegLimit) THEN 
           Mach_Control.DT_b.Error[73]:=TRUE;//右压刀升降限位报警
END_IF		]]></ST>
      </Implementation>
    </Action>
    <Action Name="DT_Condition" Id="{ea9f997b-c961-4676-911f-d81dd86084f6}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[
//隔膜缓存初始位置限定
arrAxisPar[AxiseNo.AxisName.SEPTATCache].arrTargetPoint[1]:=arrAxisPar[AxiseNo.AxisName.SEPTATCache].arrTargetPoint[2]+130;


Mach_Control.DT_b.iDTRunStatus;//叠台状态

IF NOT An_JumpRules[3]AND NOT An_JumpRules[4]AND NOT An_JumpRules[5]AND NOT An_JumpRules[6]AND NOT An_JumpRules[8]
	AND NOT An_JumpRules[9]AND NOT An_JumpRules[10] AND Mach_Control.U.DT_iMode=1 AND Mach_Control.An_b.JumpPiceReady THEN
	Mach_Control.DT_b.iDTRunStatus:=1;//叠台状态--自动不跳取
ELSIF An_JumpRules[1] AND Mach_Control.U.DT_iMode=1 AND Mach_Control.An_b.JumpPiceReady THEN//OR An_JumpRules[7]
	Mach_Control.DT_b.iDTRunStatus:=2;//叠台状态--自动中其他原因跳取
ELSIF An_JumpRules[2] THEN
	Mach_Control.DT_b.iDTRunStatus:=3;//叠台状态--跳取原因--手动
END_IF

(*
IF NOT Mach_Control.An_b.JumpPiceReady AND Mach_Control.U.DT_iMode=1 THEN//--------自动不跳片
	Mach_Control.DT_b.iDTRunStatus:=1;//叠台状态--自动不跳取
ELSIF Mach_Control.An_b.JumpPiceReady AND Mach_Control.U.DT_iMode=1 THEN
	Mach_Control.DT_b.iDTRunStatus:=2;//叠台状态--自动中其他原因跳取
ELSIF  Mach_Control.An_b.JumpPiceReady  AND Mach_Control.U.DT_iMode<>1 THEN//--------跳片
	Mach_Control.DT_b.iDTRunStatus:=3;//叠台状态--跳取原因--手动
END_IF
*)
//判断负极取料机械手的各轴是否在上料侧的初始位
IF 	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] AND
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] AND
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] AND
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] 
	AND NOT CA_CarryingPos2 THEN	
	CA_CarryingPos1:=TRUE;//负极搬运各轴在取料方向的初始位，允许凸轮耦合
ELSE
	CA_CarryingPos1:=FALSE;
END_IF
//负极搬运各轴在放料方向的初始位，允许凸轮耦合
IF 	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[2] AND
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] AND
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[2] AND
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] 
	AND NOT CA_CarryingPos1 THEN		
	CA_CarryingPos2:=TRUE;//负极搬运各轴在放料方向的初始位，允许凸轮耦合
ELSE
	CA_CarryingPos2:=FALSE;
END_IF

//判断正取料 机械手的各轴是否在上料侧的初始位
IF 	arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1] AND
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[1] AND
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] AND
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] 
	AND NOT AN_CarryingPos2 THEN	
	AN_CarryingPos1:=TRUE;//正极搬运各轴在取料方向的初始位，允许凸轮耦合
ELSE
	AN_CarryingPos1:=FALSE;
END_IF
//判断正极取料 机械手的各轴是否在叠片侧的初始位
IF 	arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[2] AND
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND
	arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.arrbRealPoint[2] AND
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[2] AND
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] 
	AND NOT AN_CarryingPos1 THEN	
	AN_CarryingPos2:=TRUE;//正极搬运各轴在放片方向的初始位，允许凸轮耦合
ELSE
	AN_CarryingPos2:=FALSE;
END_IF

//尾卷夹隔膜平移轴在安全位，允许负极取片移动至叠片位
IF arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed  AND arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND
	 arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.fSetPos <= (arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[1]+0.5)   THEN
	TailCurlSEPTA_SafePos:=TRUE;
ELSE
	TailCurlSEPTA_SafePos:=FALSE;
END_IF



//隔膜平移定位允许
IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] THEN
arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.GoPoint_Condition[1]:=TRUE;
arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE 	
arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.GoPoint_Condition[1]:=FALSE;
arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.GoPoint_Condition[2]:=FALSE;
END_IF

//
arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.GoPoint_Condition[1]:=TRUE;


IF Mach_Control.U.DT_iMode=1 THEN
	arrDustMotor[Mach_Control.DT_b.Dust_name].bRun_FW:=TRUE;
	ELSE
	arrDustMotor[Mach_Control.DT_b.Dust_name].bRun_FW:=FALSE;		
END_IF


IF Mach_Control.U.DT_iMode=3 THEN
	Mach_Control.DT_b.Manual:=TRUE;
	ELSE
	Mach_Control.DT_b.Manual:=FALSE;	
END_IF



/////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////
////////////////////////////////////////////电机条件
//叠台升降
IF  Mach_Control.U.DT_iMode=3 OR (Mach_Control.U.WJ_iMode=1  AND TailCurlStep3=120 ) THEN
	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.Homed AND  Mach_Control.Ca_b.Ca_Quantited =0 THEN
	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

//叠台左压刀开合
IF  Mach_Control.U.DT_iMode=3 THEN// AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[2]
	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND //AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[2]
	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3 AND
	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed THEN//AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[2
	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

//叠台左压刀升降
IF  Mach_Control.U.DT_iMode=3  THEN
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.GoPoint_Condition[14]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.GoPoint_Condition[14]:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.GoPoint_Condition[15]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.GoPoint_Condition[15]:=FALSE;	
END_IF
//叠台右压刀开合
IF  Mach_Control.U.DT_iMode=3  THEN//AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[2]
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND 
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed THEN//AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[2]
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3 AND 
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed THEN//AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[2] 
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

//叠台右压刀升降
IF  Mach_Control.U.DT_iMode=3  THEN
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.GoPoint_Condition[14]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.GoPoint_Condition[14]:=FALSE;	
END_IF
IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.GoPoint_Condition[15]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.GoPoint_Condition[15]:=FALSE;	
END_IF
//叠台隔膜放卷纠偏
IF  Mach_Control.U.DT_iMode=3  THEN
	arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

//叠台隔膜放卷尾部纠偏
IF  Mach_Control.U.DT_iMode=3  THEN
	arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF


//叠台隔膜缓存
IF  Mach_Control.U.DT_iMode=3  THEN
	arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

//arrAxisCtrl[AxiseNo.AxisName.SEPTATension]//张力摆杆

//叠台隔膜平移
IF  Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] 
    AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1]
	AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] 
	AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]    THEN
	arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.Home_Condition:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3 
AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] 
AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3 
AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] 
AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Homed  THEN
	arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

//叠台隔膜放卷
IF  Mach_Control.U.DT_iMode=3 THEN
	arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Cmd.JogN_Condition:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Cmd.JogP_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Cmd.JogN_Condition:=FALSE;	
		arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Cmd.JogP_Condition:=FALSE;
END_IF


Mach_Control.DTRunStatus.bJumpSync S=An_JumpRules[1] OR An_JumpRules[2] OR bDiffVel[ Par.iStationNO];//20240504 CF 前几片降速叠片不考虑同步



]]></ST>
      </Implementation>
    </Action>
    <Action Name="DT_SingeMode" Id="{e528eccb-76c4-42d3-a6f5-669d9e75e929}" FolderPath="09Manual\">
      <Implementation>
        <ST><![CDATA[		
		IF Mach_Control.DT_b.SinStepMode THEN
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;
		END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="GMBufferCam" Id="{4d8395d1-5ab8-4eee-b360-1d16eb499a9c}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[
(***********************************************************************************隔膜凸轮创建V2******************************************************************************************)
(*******极片缓存电机*********)
fbCreatCamGMBuffer_L.iKeyPosTemp:=0;
fbCreatCamGMBuffer_L(
	Reset:=                              stSysState.bReset  , 
	bCreatTable:=                   fbCreatCamGMBuffer_L.bCreatTable, 
	iTable:=                            TableNo.M_GMBuffer_L , //10
	iTableGMVirDriver:=          TableNo.M_GMWind_L  , //1
	iTableGMStackCalculate:=  TableNo.M_GMLengthCalculate_L , //2
	iTableGMStackMove:=       TableNo.M_GMDanserMove_L , //3
	fMaxPos:=                           fMaxPos, 
	fMinPos:=                            fMinPos , 
    iCcwSel :=                          1 , 
	arrGMCalculateTableData:= arrDeltaGMLength_L , 

	axisSlave:=                     arrAxis[AxiseNo.VirAxisName.VirMain], 
	axisMaster:=                  arrAxis[AxiseNo.AxisName.SEPTATCache] , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=>  );
fbCreatCamGMBuffer_L.bCreatTableDone;
fbCreatCamGMBuffer_L.bCreatTableError;
fbCreatCamGMBuffer_L.bError;



(*******极片缓存电机*********)
fbCreatCamGMBuffer_R.iKeyPosTemp:=0;
fbCreatCamGMBuffer_R(
	Reset:=                              stSysState.bReset  , 
	bCreatTable:=                    fbCreatCamGMBuffer_R.bCreatTable, 
	iTable:=                             TableNo.M_GMBuffer_R , //20
	iTableGMVirDriver:=           TableNo.M_GMWind_R  , //4
	iTableGMStackCalculate:=   TableNo.M_GMLengthCalculate_R , //5
	iTableGMStackMove:=         TableNo.M_GMDanserMove_R , //6
    iCcwSel :=                           2 , //2
   	fMaxPos:=                           fMaxPos, 
	fMinPos:=                            fMinPos , 
	arrGMCalculateTableData:= arrDeltaGMLength_R , 

	axisSlave:=                     arrAxis[AxiseNo.VirAxisName.VirMain], 
	axisMaster:=                  arrAxis[AxiseNo.AxisName.SEPTATCache] , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=>  );
fbCreatCamGMBuffer_R.bCreatTableDone;
fbCreatCamGMBuffer_R.bCreatTableError;
fbCreatCamGMBuffer_R.bError;


(***********隔膜放卷虚轴*凸轮表**************)
fbCreatCamVirGMDriver(
	bCreatTable:=         fbCreatCamVirGMDriver.bCreatTable , 
	Reset:=                  stSysState.bReset, 
	iTable_L:=               TableNo.M_GMWind_L , //1
	iTable_R:=               TableNo.M_GMWind_R , //4

	fGMLength_L:=       arrDeltaGMLength_L[3600,1] , // (arrDeltaGMLength_L[3600,1]+arrDeltaGMLength_R[3600,1])*0.5 
	fGMLength_R:=       arrDeltaGMLength_R[3600,1] , 

	axisSlave:=             arrAxis[AxiseNo.VirAxisName.VirMain], 
	axisMaster:=          arrAxis[AxiseNo.VirAxisName.VirDriver]    , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=>  );

fbCreatCamVirGMDriver.bCreatTableDone;
fbCreatCamVirGMDriver.bCreatTableError;
fbCreatCamVirGMDriver.bError;

(***********隔膜摆臂凸轮表**************)
fbCreatCamGMDanserMove(
	bCreatTable:=                     fbCreatCamGMDanserMove.bCreatTable, 
	Reset:=                                stSysState.bReset  , 
	iTable_L:=                            TableNo.M_GMDanserMove_L , //3
	iTable_R:=                           TableNo.M_GMDanserMove_R, //6
    fMoveLength:=                     fMaxPos-fMinPos , 
    fMasterKeyPos:=                   250  , //180
	axisSlave:=                           arrAxis[AxiseNo.VirAxisName.VirMain]  , 
	axisMaster:=                        arrAxis[AxiseNo.AxisName.SEPTATLine] , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=>  );

fbCreatCamGMDanserMove.bCreatTableDone;
fbCreatCamGMDanserMove.bCreatTableError;
fbCreatCamGMDanserMove.bError;


(***********************************************************隔膜缓存凸轮表创建V2***20240229**************************************************************************)
(*******极片缓存电机*********)
fbCreatCamGMBuffer2_L(
	Reset:=                              stSysState.bReset  , 
	bCreatTable:=                   fbCreatCamGMBuffer2_L.bCreatTable, 
	iTable:=                            TableNo.M_GMBuffer2_L , 
	iTableGMVirDriver:=          TableNo.M_GMWind2_L  , 
	iTableGMStackCalculate:=  TableNo.M_GMLengthCalculate2_L , 
	iTableGMStackMove:=       TableNo.M_GMDanserMove_L , 
	fMaxPos:=                           fMaxPos, 
	fMinPos:=                            fMinPos , 
    iCcwSel :=                          1 , 
	arrGMCalculateTableData:= arrDeltaGMLength2_L , 

	axisSlave:=                     arrAxis[AxiseNo.AxisName.SEPTATCache], 
	axisMaster:=                  arrAxis[AxiseNo.VirAxisName.VirMain] , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=>  );
fbCreatCamGMBuffer2_L.bCreatTableDone;
fbCreatCamGMBuffer2_L.bCreatTableError;
fbCreatCamGMBuffer2_L.bError;


(*******极片缓存电机*********)
fbCreatCamGMBuffer2_R(
	Reset:=                              stSysState.bReset  , 
	bCreatTable:=                    fbCreatCamGMBuffer2_R.bCreatTable, 
	iTable:=                             TableNo.M_GMBuffer2_R , 
	iTableGMVirDriver:=           TableNo.M_GMWind2_R  , 
	iTableGMStackCalculate:=   TableNo.M_GMLengthCalculate2_R , 
	iTableGMStackMove:=         TableNo.M_GMDanserMove_R , 
    iCcwSel :=                           2 , 
   	fMaxPos:=                           fMaxPos, 
	fMinPos:=                            fMinPos , 
	arrGMCalculateTableData:= arrDeltaGMLength2_R , 

	axisSlave:=                     arrAxis[AxiseNo.AxisName.SEPTATCache], 
	axisMaster:=                  arrAxis[AxiseNo.VirAxisName.VirMain] , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=>  );
fbCreatCamGMBuffer2_R.bCreatTableDone;
fbCreatCamGMBuffer2_R.bCreatTableError;
fbCreatCamGMBuffer2_R.bError;


(***********隔膜放卷虚轴*凸轮表**************)
fbCreatCamVirGMDriver2(
	bCreatTable:=         fbCreatCamVirGMDriver2.bCreatTable , 
	Reset:=                  stSysState.bReset, 
	iTable_L:=               TableNo.M_GMWind2_L , 
	iTable_R:=               TableNo.M_GMWind2_R , 

	fGMLength_L:=		arrDeltaGMLength2_L[3600,1], 
	fGMLength_R:=	arrDeltaGMLength2_R[3600,1],  

	axisSlave:=            arrAxis[AxiseNo.VirAxisName.VirDriver], 
	axisMaster:=        arrAxis[AxiseNo.VirAxisName.VirMain]       , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=>  );

fbCreatCamVirGMDriver2.bCreatTableDone;
fbCreatCamVirGMDriver2.bCreatTableError;
fbCreatCamVirGMDriver2.bError;


tGMCreateCamTON(IN:= , PT:=T#0.5S , Q=> , ET=> );
IF Mach_Control.U.DT_iMode=3 OR Mach_Control.U.DT_iMode=0 THEN//在手动状态下
			//从触据屏创建隔膜缓存凸轮
			rGMCreateCam_TRIG(CLK:=Mach_Control.DT_b.CreateCamStart2 , Q=> );
			IF rGMCreateCam_TRIG.Q THEN
				tGMCreateCamTON.IN:=FALSE;
				GMCreatCamStep0:=10;
				Mach_Control.DT_b.Error[1]:=FALSE;
			END_IF
END_IF			
			//隔膜缓存凸轮创建 
			CASE GMCreatCamStep0 OF
						10:
								IF NOT 	tGMCreateCamTON.Q THEN
										fbCreatCamVirGMDriver.bCreatTable:=FALSE;//放卷凸轮创建
										fbCreatCamGMDanserMove.bCreatTable:=FALSE;//	隔膜平移凸轮创建
										fbCreatCamGMBuffer_L.bCreatTable:=FALSE;//缓存左凸轮生成
										fbCreatCamGMBuffer_R.bCreatTable:=FALSE;//缓存右轮生成
										Mach_Control.DT_b.CreateCamDone2:=FALSE;
										tGMCreateCamTON.IN:=TRUE;
								ELSE
										tGMCreateCamTON.IN:=FALSE;
										GMCreatCamStep0:=11;
								END_IF
			
						11:
							IF  NOT DT_Cam_ton[3].Q THEN
								arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Cmd.bStop:=TRUE;
								arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bStop:=TRUE;
								arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bStop:=TRUE;
								DT_Cam_ton[3].IN:=TRUE;
							ELSE
								DT_Cam_ton[3].IN:=FALSE;
								GMCreatCamStep0:=12;
								arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Cmd.bStop:=FALSE;
								arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bStop:=FALSE;
								arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bStop:=FALSE;
							END_IF
					
						12:
							IF  NOT DT_Cam_ton[4].Q THEN
								arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Cmd.bReset:=TRUE;	
								arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bReset:=TRUE;
								arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bReset:=TRUE;		
								DT_Cam_ton[4].IN:=TRUE;
							 ELSE
								 DT_Cam_ton[4].IN:=FALSE;
								 GMCreatCamStep0:=13;
								arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Cmd.bReset:=FALSE;	
								arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bReset:=FALSE;
								arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bReset:=FALSE;		
							 END_IF
								
						13:
							arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Cmd.bEnable:=TRUE;
							arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bEnable:=TRUE;
							arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bEnable:=TRUE;
							IF arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Enabled AND
								arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Enabled THEN
								 GMCreatCamStep0:=20;
							END_IF				
								
							
						20://隔膜变化长度度算
								iSetp1:=10;
								iSetp2:=10;
								Mach_Control.DT_b.CreateCamDone2:=FALSE;
								GMCreatCamStep0:=30;
						30://等待隔膜变化长度计算完成
								IF iSetp1=666 AND iSetp2=666 THEN
									GMCreatCamStep0:=40;
								END_IF
						40://创建放卷凸轮、隔膜平移凸轮
								fbCreatCamVirGMDriver.bCreatTable:=TRUE;//放卷凸轮创建
								 fbCreatCamGMDanserMove.bCreatTable:=TRUE;//	隔膜平移凸轮创建
								 fbCreatCamVirGMDriver2.bCreatTable:=TRUE;//放卷凸轮创建
								 
								GMCreatCamStep0:=50;	
						50://等待凸轮创建完成
								IF fbCreatCamVirGMDriver.bCreatTableDone AND fbCreatCamGMDanserMove.bCreatTableDone AND  fbCreatCamVirGMDriver2.bCreatTableDone  THEN
									GMCreatCamStep0:=60;	
								ELSE
										IF fbCreatCamVirGMDriver.bCreatTableError OR fbCreatCamGMDanserMove.bCreatTableError OR   fbCreatCamVirGMDriver2.bCreatTableError  THEN
												Mach_Control.DT_b.Error[1]:=TRUE;//隔膜缓存凸轮创建失败
												GMCreatCamStep0:=9999;		
										END_IF					
								END_IF
						60://创建隔膜缓存凸轮
							fbCreatCamGMBuffer_L.bCreatTable:=TRUE;//缓存左凸轮生成
							fbCreatCamGMBuffer_R.bCreatTable:=TRUE;//缓存右轮生成
							fbCreatCamGMBuffer2_L.bCreatTable:=TRUE;//缓存左凸轮生成
							fbCreatCamGMBuffer2_R.bCreatTable:=TRUE;//缓存右轮生成		
							
							 //fbCamInVirGM.bCreatTable:=TRUE;//隔膜虚轴凸轮生成
							GMCreatCamStep0:=70;	
						70://等待凸轮创建完成
							IF fbCreatCamGMBuffer_L.bCreatTableDone AND fbCreatCamGMBuffer_R.bCreatTableDone (*  AND fbCamInVirGM.bCreatTableDone *)    AND 
                                fbCreatCamGMBuffer2_L.bCreatTableDone AND  fbCreatCamGMBuffer2_R.bCreatTableDone THEN
								Mach_Control.DT_b.CreateCamDone2:=TRUE;//隔膜缓存凸轮创建完成
								GMCreatCamStep0:=6666;	
							ELSE
									IF fbCreatCamGMBuffer_L.bCreatTableError OR fbCreatCamGMBuffer_R.bCreatTableError  OR 
                                         fbCreatCamGMBuffer2_L.bCreatTableError AND  fbCreatCamGMBuffer2_R.bCreatTableError THEN
										Mach_Control.DT_b.Error[1]:=TRUE;//隔膜缓存凸轮创建失败
										GMCreatCamStep0:=9999;	
									END_IF
							END_IF
			END_CASE
(************************************************************凸轮耦合*****************************************************************************)
//隔膜放卷凸轮
fbCamInVirGMDriver(  
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInVirGMDriver.bCamInExecute, 
	iTable1:=                   TableNo.M_GMWind_L  , //从左到右，正极到负极
	iTable2:=                  TableNo.M_GMWind_R  , //从右到左，负极到正极
	iTableSel:=                fbCamInVirGMDriver.iTableSel , //凸轮表号选择
	ParCamIn:= , 
 	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain], 
	axisSlave:=               arrAxis[AxiseNo.VirAxisName.VirDriver]    , 
	bError=> , 
	bReady=> , 
	bInSync=> );

Mach_Control.DT_b.Error[16]:=fbCamInVirGMDriver.bError;
fbCamInVirGMDriver.bReady;
fbCamInVirGMDriver.bInSync;


//隔膜平移凸轮
IF  fbCamInGMDanserMove.iTableSel=2 THEN
     fbCamInGMDanserMove.ParCamIn.SlaveOffset:=-(fMaxPos-fMinPos);
ELSE
    fbCamInGMDanserMove.ParCamIn.SlaveOffset:=0;
END_IF

fbCamInGMDanserMove(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInGMDanserMove.bCamInExecute, 
	iTable1:=                   TableNo.M_GMDanserMove_L  , 
	iTable2:=                   TableNo.M_GMDanserMove_R  , 
	iTableSel:=                fbCamInGMDanserMove.iTableSel , 
	ParCamIn:= , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] , //VirMain
	axisSlave:=               arrAxis[AxiseNo.AxisName.SEPTATLine] , 
	bError=> , 
	bReady=> , 
	bInSync=> );

Mach_Control.DT_b.Error[17]:=fbCamInGMDanserMove.bError;
fbCamInGMDanserMove.bReady;
fbCamInGMDanserMove.bInSync;

//隔膜缓存凸轮
fbCamInGMBuffer.ParCamIn.MasterScaling:=0.1;
fbCamInGMBuffer(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInGMBuffer.bCamInExecute, 
	iTable1:=                   TableNo.M_GMBuffer_L  , 
	iTable2:=                   TableNo.M_GMBuffer_R  , 
	iTableSel:=                fbCamInGMBuffer.iTableSel , 
	ParCamIn:= , 
  	axisMaster:=           arrAxis[AxiseNo.VirAxisName.VirMain] , 
	axisSlave:=               arrAxis[AxiseNo.AxisName.SEPTATCache] , 
	bError=> , 
	bReady=> , 
	bInSync=> );

Mach_Control.DT_b.Error[18]:=fbCamInGMBuffer.bError;
fbCamInGMBuffer.bReady;
fbCamInGMBuffer.bInSync;



(************************************************************凸轮耦合V2*****************************************************************************)
//隔膜放卷凸轮
fbCamInVirGMDriver2(  
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInVirGMDriver2.bCamInExecute, 
	iTable1:=                   TableNo.M_GMWind2_L  , //从左到右，正极到负极
	iTable2:=                  TableNo.M_GMWind2_R  , //从右到左，负极到正极
	iTableSel:=                fbCamInVirGMDriver2.iTableSel , //凸轮表号选择
	ParCamIn:= , 
 	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain], 
	axisSlave:=               arrAxis[AxiseNo.VirAxisName.VirDriver]    , 
	bError=> , 
	bReady=> , 
	bInSync=> );

fbCamInVirGMDriver2.bError;
fbCamInVirGMDriver2.bReady;
fbCamInVirGMDriver2.bInSync;


//隔膜缓存凸轮
fbCamInGMBuffer2.ParCamIn.MasterScaling:=0.1;
fbCamInGMBuffer2(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInGMBuffer2.bCamInExecute, 
	iTable1:=                   TableNo.M_GMBuffer2_L  , 
	iTable2:=                   TableNo.M_GMBuffer2_R  , 
	iTableSel:=                fbCamInGMBuffer2.iTableSel , 
	ParCamIn:= , 
  	axisMaster:=           arrAxis[AxiseNo.VirAxisName.VirMain] , 
	axisSlave:=               arrAxis[AxiseNo.AxisName.SEPTATCache] , 
	bError=> , 
	bReady=> , 
	bInSync=> );

fbCamInGMBuffer2.bError;
fbCamInGMBuffer2.bReady;
fbCamInGMBuffer2.bInSync;












(*

(***********************************************************隔膜缓存凸轮表创建*****************************************************************************)
(*******极片缓存电机*********)
fbCreatCamGMBuffer_L.iKeyPosTemp:=20;
fbCreatCamGMBuffer_L(
	Reset:=                              stSysState.bReset  , 
	bCreatTable:=                   fbCreatCamGMBuffer_L.bCreatTable, 
	iTable:=                            TableNo.M_GMBuffer_L , //10
	iTableGMVirDriver:=          TableNo.M_GMWind_L  , //1
	iTableGMStackCalculate:=  TableNo.M_GMLengthCalculate_L , //2
	iTableGMStackMove:=       TableNo.M_GMDanserMove_L , //3
	fMaxPos:=                           fMaxPos, 
	fMinPos:=                            fMinPos , 
    iCcwSel :=                          1 , 
	arrGMCalculateTableData:= arrDeltaGMLength_L , 

	axisSlave:=                     arrAxis[AxiseNo.VirAxisName.VirMain], 
	axisMaster:=                  arrAxis[AxiseNo.AxisName.SEPTATCache] , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=>  );
fbCreatCamGMBuffer_L.bCreatTableDone;
fbCreatCamGMBuffer_L.bCreatTableError;
fbCreatCamGMBuffer_L.bError;


(*******极片缓存电机*********)
fbCreatCamGMBuffer_R.iKeyPosTemp:=20;
fbCreatCamGMBuffer_R(
	Reset:=                              stSysState.bReset  , 
	bCreatTable:=                    fbCreatCamGMBuffer_R.bCreatTable, 
	iTable:=                             TableNo.M_GMBuffer_R , //20
	iTableGMVirDriver:=           TableNo.M_GMWind_R  , //4
	iTableGMStackCalculate:=   TableNo.M_GMLengthCalculate_R , //5
	iTableGMStackMove:=         TableNo.M_GMDanserMove_R , //6
    iCcwSel :=                           2 , //2
   	fMaxPos:=                           fMaxPos, 
	fMinPos:=                            fMinPos , 
	arrGMCalculateTableData:= arrDeltaGMLength_R , 

	axisSlave:=                     arrAxis[AxiseNo.VirAxisName.VirMain], 
	axisMaster:=                  arrAxis[AxiseNo.AxisName.SEPTATCache] , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=>  );
fbCreatCamGMBuffer_R.bCreatTableDone;
fbCreatCamGMBuffer_R.bCreatTableError;
fbCreatCamGMBuffer_R.bError;


(***********隔膜放卷虚轴*凸轮表**************)
fbCreatCamVirGMDriver(
	bCreatTable:=         fbCreatCamVirGMDriver.bCreatTable , 
	Reset:=                  stSysState.bReset, 
	iTable_L:=               TableNo.M_GMWind_L , //1
	iTable_R:=               TableNo.M_GMWind_R , //4

	fGMLength_L:=       arrDeltaGMLength_L[3600,1]+1.2 , 
	fGMLength_R:=       arrDeltaGMLength_R[3600,1]+1.2 , 

	axisSlave:=             arrAxis[AxiseNo.VirAxisName.VirMain], 
	axisMaster:=          arrAxis[AxiseNo.VirAxisName.VirDriver]    , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=>  );

fbCreatCamVirGMDriver.bCreatTableDone;
fbCreatCamVirGMDriver.bCreatTableError;
fbCreatCamVirGMDriver.bError;
*)




]]></ST>
      </Implementation>
    </Action>
    <Action Name="GMBufferLengthCalculate" Id="{1a6344b7-4c43-444d-bc2f-f0f8bcd6547a}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[(**************************************************************************隔膜计算V2******************************************)


(**************************************************************************隔膜变化长度计算********************************************)
//隔膜垂直向下为隔膜摆臂的机械零点
//C1点坐标=当前坐标+隔膜辊半径
//fMaxPos=隔膜摆臂右目标位置+隔膜辊半径

(*
//C1活动范围   -188.05------164.05        从右到左 
(**********坐标自动计算**********)
Par.Mechaical.fGMRollDiameter:=24;
IF Par.Mechaical.fGM_X>0 AND Par.Mechaical.fGM_Y>0 THEN
	Par.Mechaical.y_B1:=Par.Mechaical.fGM_Y-Par.Mechaical.fGMRollDiameter/2;
	Par.Mechaical.y_C1:=Par.Mechaical.y_B1-72;
	//Par.Mechaical.y_A5:=Par.Mechaical.y_B1+333;
	Par.Mechaical.x_D2:=Par.Mechaical.fGM_X+52.5;
	Par.Mechaical.x_D1:=Par.Mechaical.x_D2-par.stDT_date.Width;
END_IF
IF Par.Mechaical.fGM_Z>0 THEN
	Par.Mechaical.y_A5:=Par.Mechaical.fGM_Z+Par.Mechaical.fGMRollDiameter/2;
END_IF
*)
       
arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1];//左
arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2];//右
Par.Mechaical.fGMRollDiameter;
CASE  iSetp1  OF   
10://计算相间距
    I10:=0;
	//fMaxPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[3] -Par.Mechaical.fGMRollDiameter/2;
	//fMinPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]-arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[3] -Par.Mechaical.fGMRollDiameter/2;	
	fMaxPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-Par.Mechaical.fGMRollDiameter/2;
	fMinPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]-Par.Mechaical.fGMRollDiameter/2;
  // fMaxPos:=164.05;         //  =隔膜摆臂当前位置-r              隔膜摆臂中间为0位置
   //fMinPos:=-200;          //  =隔膜摆臂当前位置-r              隔膜摆臂中间为0位置          -188.55
    iNumberOfPoint:=3600;
    fInterval:=(fMaxPos-fMinPos)/ iNumberOfPoint ;


    fradii:= Par.Mechaical.fGMRollDiameter/2 ;
    fJumpPos:=-fradii;
    k_Comp:=fcompensationPos/(fMaxPos-fJumpPos) ;
	bMoveFowerdR:=FALSE;
    iSetp1:=20;

20:
   fTagatPos:=fMaxPos-I10*fInterval;
   bExecute:=TRUE;
   bExecute2:=TRUE;
    iSetp1:=30;
30:
   IF NOT  bExecute   AND  NOT bExecute2   THEN
        arrfTagatPos_R[I10]:=fTagatPos;
        arrDeltaGMLength_R[I10,0]:=I10;
 
       arrGMLengthDown_R[I10] :=fbGMLengthV1_R.fTotalLenght;
       arrGMLengthUp_R[I10] :=fbGMLengthV2_R.fTotalLenght   ;
		
       arrDeltaGMLength_R[0,1]:=0;
       IF I10>=1 THEN
         arrDeltaGMLength_R[I10,1]:=arrGMLengthDown_R[I10]+arrGMLengthUp_R[I10]-(arrGMLengthDown_R[0]+arrGMLengthUp_R[0] )        ;
      END_IF
          I10:=I10+1;
		IF I10>iNumberOfPoint THEN
			iSetp1:=100;  
		ELSE
			iSetp1:=20;  
		 END_IF
   END_IF

100:
       I10:=0;
	//fMaxPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[3] -Par.Mechaical.fGMRollDiameter/2;
	//fMinPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]-arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[3] -Par.Mechaical.fGMRollDiameter/2;	
	fMaxPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-Par.Mechaical.fGMRollDiameter/2;
	fMinPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]-Par.Mechaical.fGMRollDiameter/2;
  // fMaxPos:=164.05;         //  =隔膜摆臂当前位置-r              隔膜摆臂中间为0位置
   //fMinPos:=-200;          //  =隔膜摆臂当前位置-r              隔膜摆臂中间为0位置          -188.55
    iNumberOfPoint:=3600;
    fInterval:=(fMaxPos-fMinPos)/ iNumberOfPoint ;


    fradii:= Par.Mechaical.fGMRollDiameter/2 ;
    fJumpPos:=-fradii;
    k_Comp:=fcompensationPos/(fMaxPos-fJumpPos) ;
   bMoveFowerdR:=TRUE;
    iSetp1:=120;

120:
     fTagatPos:=fMaxPos-I10*fInterval;
     bExecute:=TRUE;
     bExecute2:=TRUE;
      iSetp1:=130;

130:
	IF NOT  bExecute   AND  NOT bExecute2   THEN
			arrfTagatPos2_R[I10]:=fTagatPos;
			arrDeltaGMLength2_R[I10,0]:=I10;
			
			arrGMLengthDown2_R[I10] :=fbGMLengthV1_R.fTotalLenght;
			arrDeltaGMLength2_R[0,1]:=0;
			IF I10>=1 THEN
				arrDeltaGMLength2_R[I10,1]:=arrGMLengthDown2_R[I10]+arrGMLengthUp_R[I10]-(arrGMLengthDown2_R[0]+arrGMLengthUp_R[0] )        ;
			END_IF
			I10:=I10+1;
			IF I10>iNumberOfPoint THEN
				iSetp1:=666;  
			ELSE
				iSetp1:=120;  
			END_IF
		END_IF 
END_CASE



//C1活动范围   -188.05------164.05        从左到右   
CASE  iSetp2  OF   
10://计算相间距
    I12:=0;
	fMaxPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-Par.Mechaical.fGMRollDiameter/2;
	fMinPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]-Par.Mechaical.fGMRollDiameter/2;
  // fMaxPos:=164.05;       
   // fMinPos:=-200;  
    iNumberOfPoint:=3600;
    fInterval2:=(fMaxPos-fMinPos)/ iNumberOfPoint ;
 
    fradii:= Par.Mechaical.fGMRollDiameter/2 ;
    fJumpPos:=-fradii;
    k_Comp:=fcompensationPos/(fMaxPos-fJumpPos) ;

     arrDeltaGMLengthAbs_L[0,0]:=0 ;
	 bMoveFowerdL:=FALSE;
    iSetp2:=20;

20:
   fTagatPos2:=fMinPos+I12*fInterval2;
   bExecute3:=TRUE;
   bExecute4:=TRUE;
    iSetp2:=30;

30:
   IF NOT  bExecute3   AND  NOT bExecute4   THEN
        arrfTagatPos_L[I12]:=fTagatPos2;
        arrDeltaGMLength_L[I12,0]:=I12;
        arrDeltaGMLengthAbs_L[I12,0]:=fTagatPos2-fMinPos ;

        arrGMLengthDown_L[I12] :=  fbGMLengthV1_L.fTotalLenght;  //下
         arrGMLengthUp_L[I12] :=fbGMLengthV2_L.fTotalLenght   ;  //上	
		
      arrDeltaGMLength_L[0,1]:=0;
       IF I12>=1 THEN
         arrDeltaGMLength_L[I12,1]:=arrDeltaGMLengthAbs_L[I12,1]:= arrGMLengthDown_L[I12]+arrGMLengthUp_L[I12]-(arrGMLengthDown_L[0]+arrGMLengthUp_L[0] )   ;
      END_IF
          I12:=I12+1;
		IF I12>iNumberOfPoint THEN
			iSetp2:=100;  
		ELSE
			iSetp2:=20;  
		 END_IF
   END_IF

100:
    I12:=0;
	fMaxPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-Par.Mechaical.fGMRollDiameter/2;
	fMinPos:=arrAxisPar [AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]-Par.Mechaical.fGMRollDiameter/2;
  // fMaxPos:=164.05;       
   // fMinPos:=-200;  
    iNumberOfPoint:=3600;
    fInterval2:=(fMaxPos-fMinPos)/ iNumberOfPoint ;
 
    fradii:= Par.Mechaical.fGMRollDiameter/2 ;
    fJumpPos:=-fradii;
    k_Comp:=fcompensationPos/(fMaxPos-fJumpPos) ;

     arrDeltaGMLength2Abs_L[0,0]:=0 ;
	 bMoveFowerdL:=TRUE;
    iSetp2:=120;
	 
120:	 
	   fTagatPos2:=fMinPos+I12*fInterval2;
	   bExecute3:=TRUE;
	   bExecute4:=TRUE;
		iSetp2:=130;	 
130:	 
  IF NOT  bExecute3   AND  NOT bExecute4   THEN
        arrfTagatPos2_L[I12]:=fTagatPos2;
        arrDeltaGMLength2_L[I12,0]:=I12;
        arrDeltaGMLength2Abs_L[I12,0]:=fTagatPos2-fMinPos ;
		
        arrGMLengthDown2_L[I12] :=  fbGMLengthV1_L.fTotalLenght;  //下
       // arrGMLengthUp_L[I12] :=fbGMLengthV2_L.fTotalLenght   ;  //上	
      arrDeltaGMLength2_L[0,1]:=0;
       IF I12>=1 THEN
         arrDeltaGMLength2_L[I12,1]:=arrDeltaGMLength2Abs_L[I12,1]:= arrGMLengthDown2_L[I12]+arrGMLengthUp_L[I12]-(arrGMLengthDown2_L[0]+arrGMLengthUp_L[0] )  ;
      END_IF
          I12:=I12+1;
		IF I12>iNumberOfPoint THEN
			iSetp2:=666;  
		ELSE
			iSetp2:=120;  
		 END_IF

   END_IF	 
	
END_CASE


(***从右往左运动*)
fbGMLengthV1_R(
	bExecute:=           bExecute , 
     x_C1:=                  fTagatPos, 

    fradii:=                       Par.Mechaical.fGMRollDiameter/2 , 
    y_C1:=                       Par.Mechaical.y_C1    , 
    x_D1:=                      SEL(bMoveFowerdR,Par.Mechaical.x_D1,Par.Mechaical.x_D1)    , //
    x_D2:=                      SEL(bMoveFowerdR,Par.Mechaical.x_D2,Par.Mechaical.x_D1)  , //20221028  SJ
	fDegree=> , 
	fArcLength=> , 
	fLineLength=> , 
	fTotalLenght=> );
fbGMLengthV1_R.fArcLength;
fbGMLengthV1_R.fDegree;
fbGMLengthV1_R.fLineLength;
fbGMLengthV1_R.fTotalLenght;


(*
fbGMLengthV2_R(
	x_C1:=                           fTagatPos , 

   fradii:=                       Par.Mechaical.fGMRollDiameter/2 , 
    y_C1:=                       Par.Mechaical.y_C1    , 
    x_D1:=                       Par.Mechaical.x_D1   , 
    x_D2:=                       Par.Mechaical.x_D2  , 
    y_B1:=                       Par.Mechaical.y_B1   , 
    y_A5:=                       Par.Mechaical.y_A5   , 

	fDegree=> , 
	fArcLength=> , 
	fLineLength=> , 
	fTotalLenght=> , 
	bExecute:=                    bExecute2 );

fbGMLengthV2_R.fArcLength;
fbGMLengthV2_R.fDegree;
fbGMLengthV2_R.fLineLength;
fbGMLengthV2_R.fTotalLenght;
*)

fbGMLengthV2_R(
	x_C1:=                           fTagatPos , 

   fradii:=                       Par.Mechaical.fGMRollDiameter/2 , 
    y_C1:=                       Par.Mechaical.y_C1    , 
    x_D1:=                       Par.Mechaical.x_D1   , 
    x_D2:=                       Par.Mechaical.x_D2  , 
    y_B1:=                       Par.Mechaical.y_B1   , 
    y_A5:=                       Par.Mechaical.y_A5   , 

	fDegree=> , 
	fArcLength=> , 
	fLineLength=> , 
	fTotalLenght=> , 
	bExecute:=                    bExecute2 );

fbGMLengthV2_R.fArcLength;
fbGMLengthV2_R.fDegree;
fbGMLengthV2_R.fLineLength;
fbGMLengthV2_R.fTotalLenght;


(***从左往右运动*)
fbGMLengthV1_L(  //下
	bExecute:=             bExecute3 , 
     x_C1:=                  fTagatPos2, 

    fradii:=                       Par.Mechaical.fGMRollDiameter/2 , 
    y_C1:=                       Par.Mechaical.y_C1    , 
    x_D1:=                         SEL(bMoveFowerdL,Par.Mechaical.x_D1,Par.Mechaical.x_D2)  , // x_D1:=x_D2;//20221028SJ
    x_D2:=                       SEL(bMoveFowerdL,Par.Mechaical.x_D2,Par.Mechaical.x_D2)  , // x_D1:=x_D2;//20221028SJ

	fDegree=> , 
	fArcLength=> , 
	fLineLength=> , 
	fTotalLenght=> );
fbGMLengthV1_L.fArcLength;
fbGMLengthV1_L.fDegree;
fbGMLengthV1_L.fLineLength;
fbGMLengthV1_L.fTotalLenght;


(*
fbGMLengthV2_L( //上
	x_C1:=                        fTagatPos2 , 
    
    fradii:=                       Par.Mechaical.fGMRollDiameter/2 , 
    y_C1:=                       Par.Mechaical.y_C1    , 
    x_D1:=                       Par.Mechaical.x_D1   , 
    x_D2:=                       Par.Mechaical.x_D2  , 
    y_B1:=                       Par.Mechaical.y_B1   , 
    y_A5:=                       Par.Mechaical.y_A5   , 

	fDegree=> , 
	fArcLength=> , 
	fLineLength=> , 
	fTotalLenght=> , 
	bExecute:=                    bExecute4 );

fbGMLengthV2_L.fArcLength;
fbGMLengthV2_L.fDegree;
fbGMLengthV2_L.fLineLength;
fbGMLengthV2_L.fTotalLenght;
*)
fbGMLengthV2_L( //上
	x_C1:=                        fTagatPos2 , 
    
    fradii:=                       Par.Mechaical.fGMRollDiameter/2 , 
    y_C1:=                       Par.Mechaical.y_C1    , 
    x_D1:=                       Par.Mechaical.x_D1   , 
    x_D2:=                       Par.Mechaical.x_D2  , 
    y_B1:=                       Par.Mechaical.y_B1   , 
    y_A5:=                       Par.Mechaical.y_A5   , 

	fDegree=> , 
	fArcLength=> , 
	fLineLength=> , 
	fTotalLenght=> , 
	bExecute:=                    bExecute4 );

fbGMLengthV2_L.fArcLength;
fbGMLengthV2_L.fDegree;
fbGMLengthV2_L.fLineLength;
fbGMLengthV2_L.fTotalLenght;




fbReadCamSlavePos(
	Execute:=              fbReadCamSlavePos.Execute , 
	CamTableID:=        1, 
	MasterPosition:=    fbReadCamSlavePos.MasterPosition, 
	Done=> , 
	Busy=> , 
	Error=> , 
	ErrorID=> , 
	SlavePosition=> , 
	SlaveVelocity=> , 
	SlaveAcceleration=> );

fbReadCamSlavePos.Done;
fbReadCamSlavePos.Error;
fbReadCamSlavePos.SlavePosition;




]]></ST>
      </Implementation>
    </Action>
    <Action Name="GMEmptyFold1" Id="{6fc85fdc-c8d4-4ec7-8331-671ccb947980}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[//首层隔膜空叠自动步	iEmptyFoldStep[1]
DT_AlarmTon[5](IN:=  , PT:=T#300MS , Q=> , ET=> );
	
IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下
CASE iEmptyFoldStep[1] OF
100:
   DT_AlarmTon[5].IN:=FALSE;
   IF NOT DP_SinStepe THEN
		IF NOT  Mach_Control.DT_b.DT_YDOpenwindow THEN
			CCD.Over.Start.iPliesNo:=UINT_TO_INT(Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited);
			CCD.Over.Finish.OverhandResult:=0;
			Mach_Control.DT_b.OverhandResult:=0;
			CCD.Over.Start.iPhotoDo:=3;
			Mach_Control.DT_b.CDD_OverStart:=TRUE;
			iEmptyFoldStep[1]:=200;
		ELSE
			iEmptyFoldStep[1]:=900;
		END_IF
    END_IF
200:
DT_AlarmTon[5].IN:=TRUE;
IF Mach_Control.DT_b.OverhandResult=1 THEN
	CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_Result[CCD.Over.Start.iPliesNo]:=Mach_Control.DT_b.OverhandResult;
	iEmptyFoldStep[1]:=900;
ELSIF Mach_Control.DT_b.OverhandResult=5 THEN
	Mach_Control.DT_b.Error[63]:=TRUE;//首次对齐度拍照NG，请调节压刀间距
	iEmptyFoldStep[1]:=100;
ELSIF DT_AlarmTon[5].Q THEN
	Mach_Control.DT_b.Error[65]:=TRUE;//压刀间距测量结果返馈超时
	iEmptyFoldStep[1]:=100;
	DT_AlarmTon[5].IN :=FALSE;
END_IF



900://判断主轴是否停止、是否在初始位、是否有轴在耦合中
	bEmptyFoldMark[1]:=TRUE;//进入空叠流程
	IF NOT DP_SinStepe THEN
		bFirstFoldFinish[1]:=FALSE;//首层隔膜空叠完成
		IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fSetPos=0 AND NOT DT_AxiseCoupling THEN
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=1020;
		ELSE
			DT_SingeMode();//单步选择	
			DP_Step1:=100;//解除耦合，主轴回零
			iEmptyFoldStep[1]:=1010;
		END_IF
	END_IF
1010://判断主轴当前的当前位置是否为0
	IF DP_Step1=6666 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fSetPos=0 AND NOT DT_AxiseCoupling THEN
		DT_SingeMode();//单步选择
		iEmptyFoldStep[1]:=1020;						
	END_IF	

1020://判断NG气缸是否在安全位
	IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState THEN
		iEmptyFoldStep[1]:=1050;		
	ELSE
		iEmptyFoldStep[1]:=1030;	
	END_IF
1030:
	IF NOT DP_SinStepe THEN
		arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Cmd.bOFF:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Cmd.bON:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Cmd.bON:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;
		IF   arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND  arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState
		AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON THEN
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=1040;									
		END_IF
	END_IF	
1040:
	IF NOT DP_SinStepe THEN
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;
		IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState THEN
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=1050;	
		END_IF		
	END_IF				
1050://	首层空叠隔膜
	IF Mach_Control.An_b.An_FirstFoldCnt<=Mach_Control.Ca_b.Ca_FirstFoldCnt THEN//先叠正极
		iEmptyFoldStep[1]:=1100;
	ELSIF Mach_Control.An_b.An_FirstFoldCnt>Mach_Control.Ca_b.Ca_FirstFoldCnt  THEN//先叠负极
		iEmptyFoldStep[1]:=1500;
	END_IF	
1100://判断叠台搬运机械手是否有片
	IF AN_CarryingPos1  THEN//正极搬运、叠片各轴在初始位	
		IF arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch AND  Mach_Control.An_b.An_DPCarryingFalg THEN//正极再取片位且叠台搬运有片,把当前片放到纠偏台
			iEmptyFoldStep[1]:=1150;
		ELSE
			iEmptyFoldStep[1]:=2000;	
		END_IF
	ELSE
		Mach_Control.DT_b.Error[8]:=TRUE;//叠正极片凸轮耦合时，正极片不在取片位
		//DP_Step0:=10001;
	END_IF	
	
1150://纠偏台回初始位
	//纠偏平台X1移动至初始位
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		//纠偏平台X2移动至初始位
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		//纠偏平台X2移动至初始位
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=1200;	
		END_IF	
	END_IF
1200:
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
			/// 吸盘破真空    纠偏台开真空
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;	//正极叠台搬运升降真空	真空
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;	//正极叠台搬运升降真空破真空		
			//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;	//正极叠台搬运升降真空	真空
			//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;	//正极叠台搬运升降真空破真空											
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;	//正极纠偏台真空			
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;	//正极纠偏台真空	
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=1250;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=2;//负极搬运升降2上升至凸轮耦合初始高度
		END_IF	
	END_IF	
1250://叠台搬运极片放回纠偏台
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
			/// 吸盘破真空    纠偏台开真空
			Mach_Control.An_b.An_deviationFalg:=TRUE;//复位纠偏平台有料标记
			Mach_Control.An_b.An_DPCarryingFalg:=FALSE;//负极搬运真空吸盘有料标记复位
			Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[2];
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=1300;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极搬运升降2上升至凸轮耦合初始高度
		END_IF	
	END_IF			
1300:
	IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState AND
        arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]  THEN
	     iEmptyFoldStep[1]:=2000;	
	END_IF	

	
	
	
1500://判断负极叠台搬运是否有片，有片的话放到纠偏台
	IF NOT DP_SinStepe THEN
		IF CA_CarryingPos1  THEN//负极搬运、叠片各轴在初始位
			IF arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch AND  Mach_Control.Ca_b.Ca_DPCarryingFalg THEN//正极再取片位且叠台搬运有片,把当前片放到纠偏台
				iEmptyFoldStep[1]:=1550;
			ELSE
				iEmptyFoldStep[1]:=3000;	
			END_IF
		ELSE
			IF (Ca_Step0=0 OR Ca_Step0=6666) AND (Ca_Step3=0 OR Ca_Step3=6666) AND Scan_TON[2].Q THEN
				Scan_TON[2].IN:=FALSE;		
				//DP_Step0:=9994;
				DTPosError[2]:=TRUE;
			END_IF
		END_IF
	END_IF	
1550://纠偏台回初始位
	//纠偏平台X1移动至初始位
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		//纠偏平台X2移动至初始位
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		//纠偏平台X2移动至初始位
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=1600;	
		END_IF	
	END_IF
1600:
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[3] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
			/// 吸盘破真空    纠偏台开真空
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;	//负极叠台搬运升降真空	真空
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;	//负极叠台搬运升降真空破真空								
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;	//负极纠偏台真空			
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;	//负极纠偏台真空	   
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=1650;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=3;//负极搬运升降2上升至凸轮耦合初始高度
		END_IF	
	END_IF
1650://叠台搬运极片放回纠偏台
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
			/// 吸盘破真空    纠偏台开真空
			Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//复位纠偏平台有料标记
			Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;//负极搬运真空吸盘有料标记复位
			Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[9];
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=1700;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极搬运升降2上升至凸轮耦合初始高度
		END_IF			
	END_IF	
1700:
	IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState AND
        arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]  THEN
	     iEmptyFoldStep[1]:=3000;	
	END_IF	
	
	
		
2000:		
	IF NOT DP_SinStepe THEN
		IF AN_CarryingPos1  THEN//正极搬运、叠片各轴在初始位										
			IF CA_CarryingPos2 THEN//负极在叠片位
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
					DT_SingeMode();//单步选择	
					iEmptyFoldStep[1]:=2010;//
				ELSE
					Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					//DP_Step0:=9998;
				END_IF;
			ELSIF  CA_CarryingPos1  THEN //负极取片位
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
					DT_SingeMode();//单步选择	
					iEmptyFoldStep[1]:=2030;//
				ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]  THEN
					DT_SingeMode();//单步选择	
					iEmptyFoldStep[1]:=2050;//
				ELSE
					Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					//DP_Step0:=9999;
				END_IF;							
			ELSE
				Mach_Control.DT_b.Error[7]:=TRUE;//叠正极片凸轮耦合时，负极取片即不在取片位，也不在叠片位
				//DP_Step0:=10000;
			END_IF
		ELSE
			Mach_Control.DT_b.Error[8]:=TRUE;//叠正极片凸轮耦合时，正极片不在取片位
			//DP_Step0:=10001;
		END_IF
	END_IF		


2010://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在放极片初始位
	IF NOT DP_SinStepe THEN
		An_CanIn5:=TRUE;
		DT_SingeMode();//单步选择	
		iEmptyFoldStep[1]:=2020;	
	END_IF	
	
2020:
	IF NOT DP_SinStepe THEN
		IF NOT An_CanIn5 THEN
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=2070;
		ELSIF fbAnCamInCarryingLine.bError  OR fbAnCamInDTCarryingLine.bError OR fbAnCamInDTCarryingUpDown.bError OR 
			fbAnCamInCarryingWhirling.bError OR fbCaCamInCarryingLine2.bError OR 
			fbCaCamInDTCarryingUpDown.bError OR fbCamInGMBuffer.bError OR fbCamInGMDanserMove.bError OR fbCamInVirGMDriver.bError   OR
			fbCamInRightYDUpDown.bError OR fbCamInRightYDLine.bError THEN
			An_CanIn5:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			//DP_Step0:=10004;		
		END_IF
	END_IF		
2030://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在取极片位
	IF NOT DP_SinStepe THEN
		DT_SingeMode();//单步选择	
		An_CanIn6:=TRUE;
		iEmptyFoldStep[1]:=2040;
	END_IF
2040:
	IF NOT DP_SinStepe THEN
		IF NOT An_CanIn6 THEN
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=2070;
		ELSIF fbAnCamInCarryingLine.bError OR fbAnCamInDTCarryingLine.bError OR
			fbAnCamInDTCarryingUpDown.bError OR fbAnCamInCarryingWhirling.bError OR fbCamInGMBuffer.bError OR
			fbCamInGMDanserMove.bError OR fbCamInVirGMDriver.bError  OR fbCamInRightYDUpDown.bError OR
			fbCamInRightYDLine.bError THEN
			An_CanIn6:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			//DP_Step0:=10002;									
		END_IF
	END_IF
2050://负极搬运、叠片各轴在初始位，隔膜平移轴正极叠片位、正极叠片在取极片位
	IF NOT DP_SinStepe THEN
		An_CanIn7:=TRUE;
		DT_SingeMode();//单步选择	
		iEmptyFoldStep[1]:=2060;
	END_IF
2060:
	IF NOT DP_SinStepe THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
		IF NOT An_CanIn7 THEN
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=2070;
		ELSIF fbAnCamInCarryingLine.bError OR fbAnCamInCarryingUpDown.bError OR fbAnCamInDTCarryingLine.bError OR fbAnCamInDTCarryingUpDown.bError OR 
			fbAnCamInCarryingWhirling.bError OR fbCamInRightYDUpDown.bError OR fbCamInRightYDLine.bError THEN
			An_CanIn7:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			//DP_Step0:=10003;												
		END_IF
	END_IF	
	
2070://判断正极叠片搬运机械手上是否有极片
	VirMain_TON.IN:=FALSE;
	IF AN_CarryingPos1 THEN
		IF CA_CarryingPos1 THEN
			IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
				IF fbAnCamInCarryingLine.bInSync AND  fbAnCamInDTCarryingLine.bInSync AND
					fbAnCamInDTCarryingUpDown.bInSync AND fbAnCamInCarryingWhirling.bInSync AND fbCamInGMBuffer.bInSync AND
					fbCamInGMDanserMove.bInSync AND fbCamInVirGMDriver.bInSync  AND fbCamInRightYDUpDown.bInSync AND 
					fbCamInRightYDLine.bInSync  THEN
					iEmptyFoldStep[1]:=2071;
				
				END_IF
			ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]  THEN
				IF fbAnCamInCarryingLine.bInSync AND  fbAnCamInDTCarryingLine.bInSync AND fbAnCamInDTCarryingUpDown.bInSync  AND 
					fbAnCamInCarryingWhirling.bInSync AND fbCamInRightYDUpDown.bInSync AND fbCamInRightYDLine.bInSync THEN
					iEmptyFoldStep[1]:=2071;
				
				END_IF
			ELSE	
				Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
				//DP_Step0:=9999;
			END_IF	
		ELSIF CA_CarryingPos2 THEN
			IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
				IF fbAnCamInCarryingLine.bInSync AND fbAnCamInDTCarryingLine.bInSync AND fbAnCamInDTCarryingUpDown.bInSync AND 
					fbAnCamInCarryingWhirling.bInSync AND fbCaCamInCarryingLine2.bInSync AND fbCaCamInDTCarryingLine.bInSync AND
					fbCamInGMBuffer.bInSync AND fbCamInGMDanserMove.bInSync AND fbCamInVirGMDriver.bInSync   AND
					fbCamInRightYDUpDown.bInSync AND fbCamInRightYDLine.bInSync  THEN
					iEmptyFoldStep[1]:=2071;
				END_IF
			ELSE
				Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
				//DP_Step0:=9998;
			END_IF
		END_IF
	ELSE
		Mach_Control.DT_b.Error[8]:=TRUE;//叠正极片凸轮耦合时，正极片不在取片位
		//DP_Step0:=10001;
	END_IF
(*
	IF NOT DP_SinStepe THEN
		IF (NOT arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch AND NOT Mach_Control.An_b.An_DPCarryingFalg) THEN	
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=2071;
		ELSE	
		  	Mach_Control.An_b.Error[28]:=TRUE; //正极叠片完空叠隔膜时，正极叠片搬运机械手真空有信号、标记有极片报警,请拿掉极片
		END_IF  
	END_IF
*)



3000:
	IF NOT DP_SinStepe THEN		
		Scan_TON[2].IN:=TRUE;	
		IF CA_CarryingPos1  THEN//负极搬运、叠片各轴在初始位
			Scan_TON[1].IN:=TRUE;	
			IF AN_CarryingPos2  THEN//正极在叠片位	
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]   THEN													
					DT_SingeMode();//单步选择											
					iEmptyFoldStep[1]:=3010;//													
				ELSE
					Mach_Control.DT_b.Error[5]:=TRUE;//叠负极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					//DP_Step0:=9991;	
				END_IF;
			ELSIF AN_CarryingPos1  THEN//在取片位																		
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
					DT_SingeMode();//单步选择										
					iEmptyFoldStep[1]:=3030;//
				ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] THEN
					DT_SingeMode();//单步选择										
					iEmptyFoldStep[1]:=3050;//
				ELSE
					Mach_Control.DT_b.Error[5]:=TRUE;//叠负极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					//DP_Step0:=9992;	
				END_IF;							
			ELSIF Scan_TON[1].Q THEN
				Scan_TON[1].IN:=FALSE;	
				//DP_Step0:=9993;
				DTPosError[4]:=TRUE;
			END_IF
		ELSE
			IF (Ca_Step0=0 OR Ca_Step0=6666) AND (Ca_Step3=0 OR Ca_Step3=6666) AND Scan_TON[2].Q THEN
				Scan_TON[2].IN:=FALSE;		
				//DP_Step0:=9994;
				DTPosError[2]:=TRUE;
			END_IF
		END_IF
END_IF		

3010://负极搬运、叠片各轴在初始位，隔膜平移轴正极叠片位、正极叠片在放极片初始位
	IF NOT DP_SinStepe THEN
		Ca_CanIn5:=TRUE;
		DT_SingeMode();//单步选择	
		iEmptyFoldStep[1]:=3020;	
	END_IF
3020:
	IF NOT DP_SinStepe THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
		IF NOT Ca_CanIn5 THEN
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=3070;	
		ELSIF fbCaCamInCarryingLine2.bError OR  fbCaCamInDTCarryingLine.bError OR fbCaCamInDTCarryingUpDown.bError OR 
			fbCamInGMBuffer.bError OR fbCamInGMDanserMove.bError OR fbCamInVirGMDriver.bError OR fbAnCamInCarryingLine.bError OR 
			fbAnCamInDTCarryingLine.bError OR fbAnCamInCarryingWhirling.bError OR fbCamInLeftYDUpDown.bError OR fbCamInLeftYDLine.bError THEN
			Ca_CanIn5:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			//DP_Step0:=9998;										
		END_IF
	END_IF
3030://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在取极片位
	IF NOT DP_SinStepe THEN
		Ca_CanIn6:=TRUE;
		DT_SingeMode();//单步选择	
		iEmptyFoldStep[1]:=3040;
	END_IF
3040://判断凸轮耦合是否完成
	IF NOT DP_SinStepe THEN
		IF NOT Ca_CanIn6 THEN
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=3070;
		ELSIF  fbCaCamInCarryingLine2.bError OR fbCaCamInDTCarryingLine.bError OR 
			fbCaCamInDTCarryingUpDown.bError OR fbCamInLeftYDUpDown.bError OR 	fbCamInLeftYDLine.bError THEN										
			Ca_CanIn6:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			//DP_Step0:=9995;		
		END_IF
	END_IF
3050://负极搬运、叠片各轴在初始位，隔膜平移轴正极叠片位、正极叠片在取极片位
	IF NOT DP_SinStepe THEN
		Ca_CanIn7:=TRUE;
		DT_SingeMode();//单步选择	
		iEmptyFoldStep[1]:=3060;
	END_IF
3060:
	IF NOT DP_SinStepe THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
		IF NOT Ca_CanIn7 THEN
			DT_SingeMode();//单步选择																			
			iEmptyFoldStep[1]:=3070;
		ELSIF fbCaCamInCarryingLine2.bError OR fbCaCamInDTCarryingLine.bError OR 
			fbCaCamInDTCarryingUpDown.bError OR fbCamInGMBuffer.bError OR fbCamInGMDanserMove.bError OR
			fbCamInVirGMDriver.bError OR fbCamInLeftYDUpDown.bError OR fbCamInLeftYDLine.bError  THEN
			Ca_CanIn7:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			//DP_Step0:=9996;	
		END_IF
	END_IF

3070://判断负极叠片搬运机械手上是否有极片
	IF NOT DP_SinStepe THEN
		IF NOT arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch AND NOT Mach_Control.Ca_b.Ca_DPCarryingFalg  THEN	
			DT_SingeMode();//单步选择	
			iEmptyFoldStep[1]:=3071;
		ELSE	
		  	Mach_Control.Ca_b.Error[28]:=TRUE; //负极叠片完空叠隔膜时，负极叠片搬运机械手真空检测有信号报警,请拿掉极片
		END_IF  
	END_IF	 
3071://主轴启动
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;
		arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;									
		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
			VirMain_TON.IN:=FALSE;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			iEmptyFoldStep[1]:=3080;	
		ELSE
			IF NOT VirMain_TON.Q THEN
				VirMain_TON.IN:=TRUE;
			ELSE
				VirMain_TON.IN:=FALSE;
				Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
				DP_Step0:=11006;	
			END_IF	
		END_IF	

		

END_CASE
END_IF

CASE iEmptyFoldStep[1] OF
2071://主轴启动
	
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
		arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;	
		//fbCaCamInCarryingUpDown2OutCamFlge:=FALSE;//负极升降2凸轮解耦标记										
		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
			VirMain_TON.IN:=FALSE;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			iEmptyFoldStep[1]:=2080;	
		ELSE
			IF NOT VirMain_TON.Q THEN
				VirMain_TON.IN:=TRUE;
			ELSE
				VirMain_TON.IN:=FALSE;
				Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
				DP_Step0:=11006;	
			END_IF	
		END_IF	
2080:
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		Mach_Control.An_b.An_FirstFoldCnt:=Mach_Control.An_b.An_FirstFoldCnt+1;
		DPcount:=DPcount+1;		
		DP_Step1:=100;//解除耦合，主轴回零子程序
		//arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-Par.stDT_date.SEPTA_Thickness;
		//arrAxisPar[AxiseNo.AxisName.DTUpDown].fVelocity_of_Rel:=100;
		//arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bMoveRel:=TRUE;
		iEmptyFoldStep[1]:=2100;
	END_IF
2100://判断首层隔膜是否完成
	IF  Mach_Control.An_b.An_FirstFoldCnt=Mach_Control.An_b.An_FirstFoldSet  AND Mach_Control.An_b.An_FirstFoldSet<>0
	(*AND Mach_Control.Ca_b.Ca_FirstFoldCnt=Mach_Control.Ca_b.Ca_FirstFoldSet AND Mach_Control.Ca_b.Ca_FirstFoldSet<>0 *)THEN 
		bFirstFoldFinish[1]:=TRUE;//首层隔膜空叠完成
		iEmptyFoldStep[1]:=0;
		DP_Step0:=0;
		 CCD.Over.Finish.OverhandResult:=0;	
	ELSE
		bFirstFoldFinish[1]:=FALSE;//首层隔膜空叠完成
		iEmptyFoldStep[1]:=100;
	END_IF
	
	
	
	
	
3080:
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		Mach_Control.Ca_b.Ca_FirstFoldCnt:=Mach_Control.Ca_b.Ca_FirstFoldCnt+1;
		DPcount:=DPcount+1;		
		DP_Step1:=100;//解除耦合，主轴回零子程序
		//arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-Par.stDT_date.SEPTA_Thickness;
		//arrAxisPar[AxiseNo.AxisName.DTUpDown].fVelocity_of_Rel:=100;
		//arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bMoveRel:=TRUE;							
		iEmptyFoldStep[1]:=3100;
	END_IF	
3100:
	IF  Mach_Control.An_b.An_FirstFoldCnt=Mach_Control.An_b.An_FirstFoldSet  AND Mach_Control.An_b.An_FirstFoldSet<>0
	AND Mach_Control.Ca_b.Ca_FirstFoldCnt=Mach_Control.Ca_b.Ca_FirstFoldSet AND Mach_Control.Ca_b.Ca_FirstFoldSet<>0 THEN 
		bFirstFoldFinish[1]:=TRUE;//首层隔膜空叠完成
		iEmptyFoldStep[1]:=0;
		DP_Step0:=0;
		 CCD.Over.Finish.OverhandResult:=0;	
	ELSE
		bFirstFoldFinish[1]:=FALSE;//首层隔膜空叠完成
		iEmptyFoldStep[1]:=100;
	END_IF		
END_CASE	


//判断运动过程中的耦合状态,若核膜平移轴未动作则停止主轴
IF iEmptyFoldStep[1]=2080 THEN
	IF arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=20 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=245  THEN
		IF (NOT fbCamInGMDanserMove.bInSync OR NOT arrAxis[AxiseNo.AxisName.SEPTATLine].Status.Moving ) AND NOT  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] THEN  
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd. bStop:=TRUE;	
			Mach_Control.DT_b.Error[55]:=TRUE;//叠首层隔膜过程中，隔膜平移轴未动作
		ELSE
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd. bStop:=FALSE;	
		END_IF
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="GMEmptyFold2" Id="{79a4b93e-a6bd-4eda-a045-c1487782eacb}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[;//叠完电芯的空叠自动步	iEmptyFoldStep[2]]]></ST>
      </Implementation>
    </Action>
    <Action Name="GMEmptyFold3" Id="{827ab5c4-c978-4632-9777-4039b3ab0de5}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[;//蓝胶、黄标空叠自动步		iEmptyFoldStep[3]]]></ST>
      </Implementation>
    </Action>
    <Action Name="Manual" Id="{e6f679c5-7ea1-4f72-9997-1be99a2c6c9f}" FolderPath="09Manual\">
      <Implementation>
        <ST><![CDATA[pt_Time:=T#0.5S;
//负极缓存皮带末端破真空打开后延时0.5S复位
(*
arTON[0](IN:=arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Status.ONState , PT:=pt_Time , Q=> , ET=> );
IF arTON[0].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bOFF:=TRUE;
END_IF
*)
//负极搬运2破真空真打开后，延时0.5S关闭
arTON[1](IN:=arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark2].Status.ONState , PT:=pt_Time , Q=> , ET=> );
IF arTON[1].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark2].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark2].Cmd.bON:=FALSE;
END_IF
//负极叠片搬运升降破真空打开后延时0.5S关闭
arTON[2](IN:=arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuumBark].Status.ONState , PT:=pt_Time , Q=> , ET=> );
IF arTON[2].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuumBark].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuumBark].Cmd.bOn:=FALSE;
END_IF



//负极纠偏平台破真空打开后延时0.5S复位
arTON[3](IN:=arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Status.ONState , PT:=pt_Time , Q=> , ET=> );
IF arTON[3].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bON:=FALSE;
END_IF




(*
//正极模切送料分段皮带破真空打开后延时0.5S关闭
arTON[4](IN:=arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Status.ONState , PT:=pt_Time , Q=> , ET=> );
IF arTON[4].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.AnBeltVacuumBark].Cmd.bOFF:=TRUE;
END_IF
*)
//正极叠片搬运升降破真空打开后延时0.5S关闭
arTON[5](IN:=arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Status.ONState , PT:=pt_Time , Q=> , ET=> );
IF arTON[5].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=FALSE;
END_IF
//正极纠偏平台破真空打开后延时0.5S关闭
arTON[6](IN:=arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Status.ONState , PT:=pt_Time , Q=> , ET=> );
IF arTON[6].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bON:=FALSE;
END_IF
//正极送片搬运破真空打开后延时关闭
arTON[7](IN:=arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Status.ONState , PT:=pt_time , Q=> , ET=> );
IF arTON[7].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=FALSE;
END_IF
(*
//负极送片皮带破真空打开后延时关闭
arTON[8](IN:=arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Status.ONState , PT:=pt_time , Q=> , ET=> );
IF arTON[8].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bOFF:=TRUE;
END_IF
*)
(*
//负极模切皮带破真空打开后延时关闭
arTON[9](IN:=arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Status.ONState , PT:=pt_time , Q=> , ET=> );
IF arTON[9].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.CaMQBeltVacuumBark].Cmd.bOFF:=TRUE;
END_IF
*)

//负极送片皮带破真空打开后延时关闭
arTON[10](IN:=arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark1].Status.ONState , PT:=pt_time , Q=> , ET=> );
IF arTON[10].Q THEN
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark1].Cmd.bOFF:=TRUE;
END_IF

//气胀轴手动
rPoleIn_btn(CLK:=Mach_Control.btn.PoleInflationbtn , Q=> );
IF NOT arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.OFFState AND rPoleIn_btn.Q  THEN
	arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Cmd.bOFF:=TRUE;
ELSIF NOT arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.ONState AND rPoleIn_btn.Q  THEN 
	arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Cmd.bON:=TRUE;
END_IF
//气胀轴按钮灯
Mach_Control.btn.PoleInflationLights:=arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.ONState;
//左压隔膜手动
rPoleTapeL_btn(CLK:=Mach_Control.btn.PoleTapeSplicerLbtn , Q=> );
IF NOT arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.OFFState AND rPoleTapeL_btn.Q  THEN
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Cmd.bOFF:=TRUE;
ELSIF NOT arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState AND rPoleTapeL_btn.Q  THEN 
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Cmd.bON:=TRUE;
END_IF
//左压隔膜按钮灯
Mach_Control.btn.PoleInflationLights:=arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState;
//右压隔膜手动
rPoleTapeR_btn(CLK:=Mach_Control.btn.PoleTapeSplicerRbtn , Q=> );
IF NOT arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.OFFState AND rPoleTapeR_btn.Q  THEN
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Cmd.bOFF:=TRUE;
ELSIF NOT arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND rPoleTapeR_btn.Q  THEN 
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Cmd.bON:=TRUE;
END_IF
//右压隔膜灯
Mach_Control.btn.PoleTapeSplicerLLights:=arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState;
//压二维码胶气缸手动
rCodeGluePressCy_btn(CLK:=Mach_Control.btn.codeGluePressbtn , Q=> );
IF NOT arrCyCtrl[arrCyNo.CylinderName.CodeGluePressCy].Status.OFFState AND rCodeGluePressCy_btn.Q THEN
	arrCyCtrl[arrCyNo.CylinderName.CodeGluePressCy].Cmd.bOFF:=TRUE;
ELSIF NOT arrCyCtrl[arrCyNo.CylinderName.CodeGluePressCy].Status.ONState AND rCodeGluePressCy_btn.Q THEN 
	arrCyCtrl[arrCyNo.CylinderName.CodeGluePressCy].Cmd.bON:=TRUE;
END_IF
//压二维码胶灯
Mach_Control.btn.codeGlueLights:=arrCyCtrl[arrCyNo.CylinderName.CodeGluePressCy].Cmd.bON;
//压蓝胶气缸手动
rGluePressCy_btn(CLK:=Mach_Control.btn.BlueGluePressbtn , Q=> );
IF NOT arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Status.OFFState AND rGluePressCy_btn.Q THEN
	arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Cmd.bOFF:=TRUE;
ELSIF NOT arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Status.ONState AND rGluePressCy_btn.Q THEN
	arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Cmd.bON:=TRUE;
END_IF
//压蓝胶灯
Mach_Control.btn.BlueGlueLights:=arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Status.ONState;


//正极防撞感应信号，停止叠片搬运平移
AnAxisbstop_R(CLK:= arrAxisbstop[AxiseNo.AxisName.AnDTCarryingLine] , Q=> );//HMI轴停止上升沿
AnAxisbstop_F(CLK:= arrAxisbstop[AxiseNo.AxisName.AnDTCarryingLine] , Q=> );//HMI轴停止下降沿

IF AnAxisbstop_R.Q AND Mach_Control.U.DT_iMode=3 THEN 
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bStop:=TRUE;
END_IF
 
IF AnAxisbstop_F.Q AND Mach_Control.U.DT_iMode=3 THEN 
   arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bStop:=FALSE;
END_IF

AnAxisbstop1_R(CLK:= arrAxisbstop[AxiseNo.AxisName.AnCarryingLine] , Q=> );//HMI轴停止上升沿
AnAxisbstop1_F(CLK:= arrAxisbstop[AxiseNo.AxisName.AnCarryingLine] , Q=> );//HMI轴停止下降沿

IF AnAxisbstop1_R.Q AND Mach_Control.U.DT_iMode=3 THEN 
   arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bStop:=TRUE;
END_IF
 
IF AnAxisbstop1_F.Q AND Mach_Control.U.DT_iMode=3 THEN 
   arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bStop:=FALSE;
END_IF

IF NOT Mach_Control.se.AnLimitSwitch AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND 
NOT arrAxis[AxiseNo.AxisName.AnDTCarryingLine].Status.Coupled AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving THEN
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bStop:=TRUE;
	Mach_Control.An_b.Error[14]:=TRUE;//正极防撞感应信号报警
END_IF
//负极防撞感应信号，停止负极搬运平移
CaAxisbstop_R(CLK:= arrAxisbstop[AxiseNo.AxisName.CaDTCarryingLine] , Q=> );//HMI轴停止上升沿
CaAxisbstop_F(CLK:= arrAxisbstop[AxiseNo.AxisName.CaDTCarryingLine] , Q=> );//HMI轴停止下降沿

IF CaAxisbstop_R.Q AND Mach_Control.U.DT_iMode=3 THEN 
   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bStop:=TRUE;
END_IF
 
IF CaAxisbstop_F.Q AND Mach_Control.U.DT_iMode=3 THEN 
   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bStop:=FALSE;
END_IF

CaAxisbstop1_R(CLK:= arrAxisbstop[AxiseNo.AxisName.CaCarryingLine2] , Q=> );//HMI轴停止上升沿
CaAxisbstop1_F(CLK:= arrAxisbstop[AxiseNo.AxisName.CaCarryingLine2] , Q=> );//HMI轴停止下降沿

IF CaAxisbstop1_R.Q AND Mach_Control.U.DT_iMode=3 THEN 
   arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bStop:=TRUE;
END_IF
 
IF CaAxisbstop1_F.Q AND Mach_Control.U.DT_iMode=3 THEN 
   arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bStop:=FALSE;
END_IF

IF NOT Mach_Control.se.CaLimitSwitch AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND
   NOT arrAxis[AxiseNo.AxisName.CaDTCarryingLine].Status.Coupled AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bStop:=TRUE;
	Mach_Control.Ca_b.Error[17]:=TRUE;//负极防撞感应信报警
END_IF
//急停
IF NOT Mach_Control.btn.EmStopbtn1 THEN
								
								Ca_Step0:=0;//负极搬运子程序1
								Ca_Step1:=0;//负极搬运子程序2
								Ca_Step2:=0;//负极搬运子程序3
								Ca_Step3:=0;//负极搬运子程序4
								Ca_RectifydevStep :=0;//纠偏自动程序
								Ca_Demarcate_Step0:=0;//纠偏标定程序步
								Ca_RecdevPla_Step0:=0;//纠偏自动程序步
								Ca_StandbyStep0:=0;//负极自动备料自动步清零
								Ca_StandbyStep1:=0;//叠负极片，判断真空阀的开关
								Ca_StandbyStep2:=0;
								Ca_StandbyStep4:=0;
								Ca_StandbyStep5:=0;//叠负极片，判断主轴是否完成
								Step_InitCaDT:=0;//取负极片回原点
								Step_InitCaDT0:=0;//负极皮带流水线
								Ca_GohomeDone:=FALSE;
								Ca_BeltGohomeDone:=FALSE;
								
								An_StandbyStep0:=0;//正极纠偏平台自动步
								An_StandbyStep1:=0;//正极取片备料步清零
								An_StandbyStep2:=0;//叠正极片，判断真空、破真空
								An_StandbyStep3:=0;//叠正极片，判断主轴是否完成
								An_Step0:=0;//正极取片子程序1
								An_Step1:=0;//正极取片子程序2
								An_Step2:=0;//正极取片子程序3
								An_Step3:=0;//正极取片子程序4
								An_Demarcate_Step0:=0;//正极标定自动程序
								An_RecdevPla_Step0:=0;	
								An_GohomeDone:=FALSE;

								
		                     	Ca_OverNGStep:=0;	
	                			An_OverNGStep:=0;									
								DP_Step0:=0;
								DP_Step1:=0;	
								DP_Step3:=0;
								DP_Step4:=0;
								Mach_Control.DT_b.OffloadRequest:=FALSE;//叠电芯完成，请求下电芯
								Step_InitDT:=0;
								DTIniti_Done:=FALSE;
								Dietai_GohomeDone:=FALSE;
								arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bStop:=TRUE;//主轴停止
								
								
								WZIniti_Done:=FALSE;//初始化完成	
								TailCurlStep3 :=0;
								TailCurlStep4:=0;
								TailCurlStep5:=0;
								TailCurlStart:=FALSE;//复位尾卷启动
								Mach_Control.WJ_b.TailCurlDone	:=FALSE;	//尾卷完成
								arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bStop:=TRUE;//主轴停止
								tTailCurlTON.IN:=FALSE;
								TailCurlStep1:=0;		
								WZIniti_Done:=FALSE;
								Tailcurl_GohomeDone:=FALSE;
								
								StickerStep0:=0;
								Sticker_Step0:=0;
								Sticker_Step1:=0;
								TJIniti_Done:=FALSE;
								Sticker_GohomeDone:=FALSE;
END_IF


IF Mach_Control.U.DT_iMode=3 AND arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.OFFState AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Homed 
	AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Homed AND NOT Pole_BJ THEN
	IF 	arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.arrbRealPoint[1] THEN
			arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.iGoSetPos:=0;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.iGoSetPos:=1;
		END_IF
	END_IF	
	IF 	arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.arrbRealPoint[1] THEN
			arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.iGoSetPos:=0;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.iGoSetPos:=1;
		END_IF
	END_IF
	IF arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Status.Homed 
	AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SEPTAdeviation2].Cmd.arrbRealPoint[1] THEN
		Pole_BJ:=TRUE;
	END_IF
END_IF

IF arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.ONState OR NOT arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.OFFState THEN
	Pole_BJ:=FALSE;
END_IF


//压刀高度计算
arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[14]:=arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[11]-arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[13];
arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[15]:=arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[12]-arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[13];
arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[14]:=arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[11]-arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[13];
arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[15]:=arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[12]-arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[13];

//夹膜夹板气缸条件
IF  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] 
OR  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[5]
OR Mach_Control.U.WJ_iMode=1 THEN
	arrCyCtrl[arrCyNo.CylinderName.	PoleSplintCy_U].Cmd.OnCondition:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.	PoleSplintCy_D].Cmd.OnCondition:=TRUE;
ELSE
	arrCyCtrl[arrCyNo.CylinderName.	PoleSplintCy_U].Cmd.OnCondition:=FALSE;
	arrCyCtrl[arrCyNo.CylinderName.	PoleSplintCy_D].Cmd.OnCondition:=FALSE;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="ModeENLimk" Id="{30bb4e16-9413-42fb-94da-048eb158acbb}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[//屏蔽链接
Mach_Control.DT_b.FirstEmpFold:=par.iModeEN.FirstEmpFoldEN;				//首层空叠隔膜屏蔽
Mach_Control.DT_b.DP_Mode:=NOT par.iModeEN.DP_ModeEN;				//尾层空叠隔膜屏蔽
Mach_Control.DT_b.RectifydevModel:=par.iModeEN.RectifydevModelEN;			//隔膜纠偏屏蔽
Mach_Control.U.EmptyRunMode:=par.iModeEN.EmptyRunModeEN;				//空叠隔膜屏蔽
Mach_Control.U.CCD_ChosesHMI:=par.iModeEN.CCD_ChosesHMIEN;			//CCD屏蔽
Mach_Control.DT_b.DT_CCD_TwoModel:=NOT par.iModeEN.DT_CCD_TwoModelEN;		//CCD复检屏蔽
Mach_Control.DT_b.DT_Overhang:=par.iModeEN.DT_OverhangEN;				//对齐度屏蔽
Mach_Control.DT_b.DT_CellNG_TF:=NOT par.iModeEN.DT_CellNG_TFEN;				//对齐度踢废屏蔽 
Mach_Control.DT_b.DT_OHclosure:= par.iModeEN.DT_OHclosureEN;				//对齐度闭环屏蔽		ON是屏蔽
Mach_Control.DT_b.GMAngleALMsel:= par.iModeEN.GMAngleALMsel; //隔膜卷径报警屏蔽		ON是屏蔽]]></ST>
      </Implementation>
    </Action>
