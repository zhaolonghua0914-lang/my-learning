AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.TailCurlRetracting].arrTargetPoint[1]+1) OR arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1]) 
