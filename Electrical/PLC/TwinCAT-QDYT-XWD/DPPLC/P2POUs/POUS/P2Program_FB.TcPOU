	Active=> , 
	CommandAborted=> , 
	Error=> , 
	ErrorID=> );
tailCurl1_GearIn.Error;
tailCurl1_GearIn.InGear;
	
	
fTailCurl2_TRIG(CLK:=tailCurl1_GearIn.Execute  , Q=> );
tailCurl2_CamOut(
	Slave:=arrAxis[AxiseNo.AxisName.SCurlingneedleWhirling], 
	Execute:=fTailCurl2_TRIG.Q , 
	Options:= , 
	Done=> , 
