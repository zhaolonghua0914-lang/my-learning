fbAnCrectCamUpDown_4.bError;


(**********20240528SJ***************)
arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[10]:=8; //等待高度  参数可调
arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[11]:=18; //安全高度  参数可调
arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[4]:=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[3]-arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[10];  //等待位置
//arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[1]:=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[3]-arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[11];  //安全位置

