	fbAnCamInCarryingLine.bCamInExecute:=TRUE;						
//正到负_正极送片搬运升降轴放片凸轮耦合
	fbAnCamInCarryingUpDown.iTableSel:=3;  //20240528SJ
	fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;
//正到负_正极叠片平移轴凸轮耦合
	fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
	fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;					
//正到负_正极叠片升降轴放片凸轮耦合
	
		fbAnCamInDTCarryingUpDown.iTableSel:=2;
		fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;
	
//正到负_正极搬运旋转轴凸轮耦合		
	fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=1;
	fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;			
//正到负_右压刀升降凸轮耦合
	//fbCamInRightYDUpDown.bCamInExecute:=TRUE;
//正极负_右压刀开合凸轮耦合
	//fbCamInRightYDLine.bCamInExecute:=TRUE;	
IF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[1] THEN	
	fbCamInRightYDUpDown.iTableSel:=1;
	fbCamInRightYDLine.iTableSel:=1;
	fbCamInRightYDUpDown.bCamInExecute:=TRUE;
    fbCamInRightYDLine.bCamInExecute:=TRUE;
ELSIF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[2] THEN		
	fbCamInRightYDUpDown.iTableSel:=2;
	fbCamInRightYDLine.iTableSel:=2;
	fbCamInRightYDUpDown.bCamInExecute:=TRUE;
    fbCamInRightYDLine.bCamInExecute:=TRUE;	
END_IF						 
//判断凸轮耦合是否完成
	IF fbAnCamInCarryingLine.bInSync AND  fbAnCamInDTCarryingLine.bInSync AND fbAnCamInDTCarryingUpDown.bInSync  AND    fbAnCamInCarryingUpDown.bInSync AND 
		fbAnCamInCarryingWhirling.bInSync AND fbCamInRightYDUpDown.bInSync AND fbCamInRightYDLine.bInSync THEN
		An_CanIn7:=FALSE;
		//DP_Step0:=541;						
	END_IF			
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="_01DT_AutoSub1_CamOut" Id="{bc0824c9-4f45-4ea6-91d1-e8394d1e08d2}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[CamOut_TON(IN:= , PT:=T#10MS , Q=> , ET=> );



//判断是否有叠台部分轴在耦合中
				IF 	NOT arrAxis[AxiseNo.AxisName.AnCarryingLine].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.AnCarryingUpDown].Status.Coupled AND 
					NOT arrAxis[AxiseNo.AxisName.AnDTCarryingLine].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Coupled AND 
					NOT arrAxis[AxiseNo.AxisName.AnCarryingWhirling].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.CaCarryingLine2].Status.Coupled AND 
					NOT arrAxis[AxiseNo.AxisName.CaCarryingUpDown2].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.CaDTCarryingLine].Status.Coupled AND 
					NOT arrAxis[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.LeftYDLine].Status.Coupled AND 
					NOT arrAxis[AxiseNo.AxisName.LeftYDUpDown].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.RightYDLine].Status.Coupled AND 
					NOT arrAxis[AxiseNo.AxisName.RightYDUpDown].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.SEPTATCache].Status.Coupled AND 
					NOT arrAxis[AxiseNo.AxisName.SEPTATLine].Status.Coupled AND NOT arrAxis[AxiseNo.VirAxisName.VirTailCurl].Status.Coupled 
					  THEN  //NOT arrAxis[AxiseNo.VirAxisName.VirGM].Status.Coupled
					DT_AxiseCoupling:=FALSE;//叠片部分轴在耦合中
				ELSE
					DT_AxiseCoupling:=TRUE;
				END_IF
//叠台自动子程序_凸轮耦合解除_主轴清零
rDTCamOut_TRIG(CLK:=Mach_Control.DT_b.DT_AllCamOut OR arrAxisCamError , Q=> );
IF   rDTCamOut_TRIG.Q    THEN
	DP_Step1:=100;
END_IF


IF DP_Step1=100 THEN
	            DPtime1:=1;
				CamOut_TON.IN:=FALSE;
				IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving  THEN
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bStop:=FALSE;
					fbAnCamInCarryingLine.bCamInExecute:=FALSE;//正极送片搬运平移
					fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极送片搬运升降
					fbAnCamInCarryingWhirling.bCamInExecute:=FALSE;//正极送片搬运旋转
					fbAnCamInDTCarryingLine.bCamInExecute:=FALSE;//正极叠片搬运平移
					fbAnCamInDTCarryingUpDown.bCamInExecute:=FALSE;//正极叠片搬运升降
					
					//fbCaCamInCarryingLine1.bCamInExecute,:=TURE;//负极取流水线平移
					//fbCaCamInCarryingUpDown1.bCamInExecute:=TRUE;//负极取流水线升降
					fbCaCamInCarryingLine2.bCamInExecute:=FALSE;//负极送片搬运平移
					fbCaCamInCarryingUpDown2.bCamInExecute:=FALSE;//负极送片搬运升降
					fbCaCamInDTCarryingLine.bCamInExecute:=FALSE;//负极叠片搬运平移
					fbCaCamInDTCarryingUpDown.bCamInExecute:=FALSE;//负极叠片搬运升降
					
					fbCamInLeftYDLine.bCamInExecute:=FALSE;//左压刀开合
					fbCamInLeftYDUpDown.bCamInExecute:=FALSE;//左压刀升降
					fbCamInRightYDLine.bCamInExecute:=FALSE;//右压刀开合
					fbCamInRightYDUpDown.bCamInExecute:=FALSE;//左压刀升降
					
					fbCamInGMBuffer.bCamInExecute:=FALSE;//隔膜缓存
					fbCamInGMDanserMove.bCamInExecute:=FALSE;//隔膜平移
					fbCamInVirGMDriver.bCamInExecute:=FALSE;//隔膜放卷虚轴
					
					
					fbCamInGMBuffer2.bCamInExecute:=FALSE;	//隔膜缓存2	
					fbCamInVirGMDriver2.bCamInExecute:=FALSE;	//隔膜放卷虚轴2
					
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
					DP_Step1:=140;
					
				ELSE
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bStop:=TRUE;
				END_IF
	END_IF			
	
	
IF DP_Step1=140 THEN
			IF 	NOT arrAxis[AxiseNo.AxisName.AnCarryingLine].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.AnCarryingUpDown].Status.Coupled AND 
				NOT arrAxis[AxiseNo.AxisName.AnDTCarryingLine].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Coupled AND 
				NOT arrAxis[AxiseNo.AxisName.AnCarryingWhirling].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.CaCarryingLine2].Status.Coupled AND 
				NOT arrAxis[AxiseNo.AxisName.CaCarryingUpDown2].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.CaDTCarryingLine].Status.Coupled AND 
				NOT arrAxis[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.LeftYDLine].Status.Coupled AND 
				NOT arrAxis[AxiseNo.AxisName.LeftYDUpDown].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.RightYDLine].Status.Coupled AND 
				NOT arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Coupled AND NOT arrAxis[AxiseNo.AxisName.SEPTATCache].Status.Coupled AND 
				NOT arrAxis[AxiseNo.AxisName.SEPTATLine].Status.Coupled   AND NOT DT_AxiseCoupling    THEN  //AND NOT arrAxis[AxiseNo.VirAxisName.VirGM].Status.Coupled
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fSetPos:=0;
					
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bSetPos:=TRUE;	
					DP_Step1:=160;
					DPtime1:=2;
			END_IF	
   END_IF
			
	IF DP_Step1=160 THEN  //判断主轴是否停止以及在模长初始位
				IF  NOT arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bSetPos AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0   THEN
					DP_Step1:=6666;
					DPtime1:=3;
				END_IF
     END_IF






(*

CASE DP_Step1 OF
		100://先判断主轴是否在停止中
				CamOut_TON.IN:=FALSE;
				IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving  THEN
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bStop:=FALSE;
					fbAnCamInCarryingLine.bCamInExecute:=FALSE;//正极送片搬运平移
					fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极送片搬运升降
					fbAnCamInCarryingWhirling.bCamInExecute:=FALSE;//正极送片搬运旋转
					fbAnCamInDTCarryingLine.bCamInExecute:=FALSE;//正极叠片搬运平移
					fbAnCamInDTCarryingUpDown.bCamInExecute:=FALSE;//正极叠片搬运升降
					
					//fbCaCamInCarryingLine1.bCamInExecute,:=TURE;//负极取流水线平移
					//fbCaCamInCarryingUpDown1.bCamInExecute:=TRUE;//负极取流水线升降
					fbCaCamInCarryingLine2.bCamInExecute:=FALSE;//负极送片搬运平移
					fbCaCamInCarryingUpDown2.bCamInExecute:=FALSE;//负极送片搬运升降
					fbCaCamInDTCarryingLine.bCamInExecute:=FALSE;//负极叠片搬运平移
					fbCaCamInDTCarryingUpDown.bCamInExecute:=FALSE;//负极叠片搬运升降
					
					fbCamInLeftYDLine.bCamInExecute:=FALSE;//左压刀开合
					fbCamInLeftYDUpDown.bCamInExecute:=FALSE;//左压刀升降
					fbCamInRightYDLine.bCamInExecute:=FALSE;//右压刀开合
					fbCamInRightYDUpDown.bCamInExecute:=FALSE;//左压刀升降
					
					fbCamInGMBuffer.bCamInExecute:=FALSE;//隔膜缓存
					fbCamInGMDanserMove.bCamInExecute:=FALSE;//隔膜平移
					fbCamInVirGMDriver.bCamInExecute:=FALSE;//隔膜放卷虚轴
					fbCamInVirGM.bCamInExecute:=FALSE;//隔膜纠偏
					
					fbCamInGMBuffer2.bCamInExecute:=FALSE;	//隔膜缓存2	
					fbCamInVirGMDriver2.bCamInExecute:=FALSE;	//隔膜放卷虚轴2
					
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
					DP_Step1:=140;
				ELSE
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bStop:=TRUE;
				END_IF
				
		140:
			IF 	NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Coupled AND 
				NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Coupled AND 
				NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Coupled AND 
				NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Coupled AND 
				NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Coupled AND 
				NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Coupled AND 
				NOT arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Coupled AND 
				NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.VirAxisName.VirGM].Status.Coupled AND NOT DT_AxiseCoupling THEN
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fSetPos:=0;
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bSetPos:=TRUE;	
					DP_Step1:=160;
			END_IF	

		160://判断主轴是否停止以及在模长初始位
				IF  NOT arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bSetPos AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0   THEN
					DP_Step1:=6666;
				END_IF
END_CASE

(*
CamOut_TON(IN:= , PT:=T#5MS , Q=> , ET=> );



//判断是否有叠台部分轴在耦合中
				IF 	NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Coupled AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Coupled AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Coupled AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Coupled AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Coupled AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Coupled AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Status.Coupled AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.Coupled AND
					NOT arrAxisCtrl[AxiseNo.VirAxisName.VirGM].Status.Coupled  THEN
					DT_AxiseCoupling:=FALSE;//叠片部分轴在耦合中
				ELSE
					DT_AxiseCoupling:=TRUE;
				END_IF
//叠台自动子程序_凸轮耦合解除_主轴清零
rDTCamOut_TRIG(CLK:=Mach_Control.DT_b.DT_AllCamOut OR arrAxisCamError , Q=> );
IF   rDTCamOut_TRIG.Q    THEN
	DP_Step1:=100;
END_IF
CASE DP_Step1 OF
		100://先判断主轴是否在停止中
				CamOut_TON.IN:=FALSE;
				IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving  THEN
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bStop:=FALSE;
					DP_Step1:=120;
				ELSE
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bStop:=TRUE;
				END_IF
		110://判断轴是否在耦合中
				(*
						IF DT_AxiseCoupling THEN
							DP_Step1:=120;
						ELSE
							DP_Step1:=130;
						END_IF
				*)
				DP_Step1:=120;
		120://叠台部轴解除耦合
				fbAnCamInCarryingLine.bCamInExecute:=FALSE;//正极送片搬运平移
				fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极送片搬运升降
				fbAnCamInCarryingWhirling.bCamInExecute:=FALSE;//正极送片搬运旋转
				 fbAnCamInDTCarryingLine.bCamInExecute:=FALSE;//正极叠片搬运平移
				fbAnCamInDTCarryingUpDown.bCamInExecute:=FALSE;//正极叠片搬运升降
				
				//fbCaCamInCarryingLine1.bCamInExecute,:=TURE;//负极取流水线平移
				//fbCaCamInCarryingUpDown1.bCamInExecute:=TRUE;//负极取流水线升降
				fbCaCamInCarryingLine2.bCamInExecute:=FALSE;//负极送片搬运平移
				fbCaCamInCarryingUpDown2.bCamInExecute:=FALSE;//负极送片搬运升降
				fbCaCamInDTCarryingLine.bCamInExecute:=FALSE;//负极叠片搬运平移
				fbCaCamInDTCarryingUpDown.bCamInExecute:=FALSE;//负极叠片搬运升降
				
				fbCamInLeftYDLine.bCamInExecute:=FALSE;//左压刀开合
				fbCamInLeftYDUpDown.bCamInExecute:=FALSE;//左压刀升降
				fbCamInRightYDLine.bCamInExecute:=FALSE;//右压刀开合
				fbCamInRightYDUpDown.bCamInExecute:=FALSE;//左压刀升降
				
				fbCamInGMBuffer.bCamInExecute:=FALSE;//隔膜缓存
				fbCamInGMDanserMove.bCamInExecute:=FALSE;//隔膜平移
				fbCamInVirGMDriver.bCamInExecute:=FALSE;//隔膜放卷虚轴
				fbCamInVirGM.bCamInExecute:=FALSE;//隔膜纠偏
				IF NOT fbAnCamInCarryingLine.bCamInExecute AND NOT fbAnCamInCarryingUpDown.bCamInExecute AND 
					NOT  fbAnCamInCarryingWhirling.bCamInExecute AND NOT fbAnCamInDTCarryingLine.bCamInExecute AND 
					NOT  fbAnCamInDTCarryingUpDown.bCamInExecute AND NOT fbCaCamInCarryingLine2.bCamInExecute AND 
					NOT  fbCaCamInCarryingUpDown2.bCamInExecute AND NOT fbCaCamInDTCarryingLine.bCamInExecute AND 
					NOT  fbCaCamInDTCarryingUpDown.bCamInExecute AND NOT fbCamInLeftYDLine.bCamInExecute AND 
					NOT fbCamInLeftYDUpDown.bCamInExecute AND NOT fbCamInRightYDLine.bCamInExecute AND 
					NOT  fbCamInRightYDUpDown.bCamInExecute AND NOT fbCamInGMBuffer.bCamInExecute AND 
					NOT fbCamInGMDanserMove.bCamInExecute AND NOT fbCamInVirGMDriver.bCamInExecute AND 
					NOT fbCamInVirGM.bCamInExecute THEN
						DP_Step1:=150;
				END_IF
(*
		130:	
				arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.VirAxisName.VirGM].Cmd.bGearOut:=TRUE;
				IF NOT DT_AxiseCoupling THEN
					arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.AnCarryingWhirling].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.SEPTATCache].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.VirAxisName.VirGM].Cmd.bGearOut:=FALSE;					
					DP_Step1:=140;
				END_IF
				
		140:
				IF NOT CamOut_TON.Q THEN
					CamOut_TON.IN:=TRUE;
				ELSE
					CamOut_TON.IN:=FALSE;
					DP_Step1:=150;
				END_IF*)
		150://主轴当前位置清零				
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fSetPos:=0;
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bSetPos:=TRUE;			
				DP_Step1:=160;

		160://判断主轴是否停止以及在模长初始位
				IF  NOT arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bSetPos AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0   THEN
					DP_Step1:=6666;
				END_IF
END_CASE
*)



*)





]]></ST>
      </Implementation>
    </Action>
    <Action Name="_01Sticker_Auto" Id="{1ec92b01-9bc5-461c-8275-c5e7ee907ba1}" FolderPath="05StickGlue \">
      <Implementation>
        <ST><![CDATA[TON_Sticker[4](PT:=T#200MS);//贴胶头夹紧气缸到位延时
rStickerStart_HMI(CLK:=Mach_Control.TJ_b.StickerStart_HMI , Q=> );
IF rStickerStart_HMI.Q THEN
	Sticker_SinStepMode:=FALSE;
END_IF
//贴胶自动程序
IF Mach_Control.U.TJ_iMode=1 OR AV THEN//在自动状态下
CASE Sticker_Step0 OF
		0://判断贴胶夹爪上是否有电芯，没电芯则移动至上电芯位，等待上电芯，有电芯则判断贴胶是否完成
				IF Mach_Control.TJ_b.StickerFlag THEN//判断贴胶夹爪上是否有电芯
						IF Mach_Control.TJ_b.StickerDone THEN//判断贴胶夹爪上的电芯是否贴胶完成
								Sticker_Step0:=1000;
						ELSIF NOT CellMemory[Mach_Control.TJ_b.TJ_Memory].Overhang_TF THEN//贴胶流程
								Sticker_Step0:=2000;
						ELSIF CellMemory[Mach_Control.TJ_b.TJ_Memory].Overhang_TF THEN//若是对齐度NG的料跳过贴胶流程										
								Mach_Control.TJ_b.StickerDone:=TRUE;//电芯贴胶完成
								Sticker_Step0:=0;							
						END_IF	
				ELSE
						Mach_Control.TJ_b.StickPermit:=FALSE;//贴胶允许
						Mach_Control.TJ_b.StickFinish:=FALSE;//贴胶完成	
						Mach_Control.TJ_b.StickMark_L1 :=FALSE;//左短边1贴胶完成
						Mach_Control.TJ_b.StickMark_L2 :=FALSE;//左短边2贴胶完成
 						Mach_Control.TJ_b.StickMark_R1 :=FALSE;//右短边1贴胶完成
						Mach_Control.TJ_b.StickMark_R2 :=FALSE;//右短边2贴胶完成		
						Mach_Control.TJ_b.StickMark1_L :=FALSE;//极耳侧贴胶完成		
						Mach_Control.TJ_b.StickMark1_L2 :=FALSE;//非极耳侧贴胶完成		
						Sticker_Step0:=100;
				END_IF	
		100:
			IF Mach_Control.WJ_b.TailCultOffloading AND NOT CellMemory[Mach_Control.TJ_b.TJ_Memory].Cell THEN
				Sticker_Step0:=150;
			ELSE
				Sticker_Step0:=0;
			END_IF
			
	
		150://允许侧贴胶平移、侧贴胶旋转动作 贴胶夹爪气缸张开，判断是否允许贴胶轴移动及旋转
				IF NOT Sticker_SinStepMode THEN			
						arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Cmd.bON:=TRUE;//贴胶冶具气缸打开
						
						IF 	 arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving 
							AND arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Io.DIOnSwitch  AND Mach_Control.TJ_b.WhirlingSafe THEN
							IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[5] THEN
								arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=5;//侧贴胶夹旋转至上电芯位
							END_IF
						END_IF
						IF 	 arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[5] AND arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.ONState THEN
							IF   Mach_Control.TJ_b.SinStepMode THEN//贴胶单步模式
								Sticker_SinStepMode:=TRUE;
							ELSE
								Sticker_SinStepMode:=FALSE;
							END_IF
							Sticker_Step0:=200;
						END_IF	
				END_IF			
		200:
			IF NOT Sticker_SinStepMode THEN			
					
					IF 	 arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving AND
                       GluingLineagree  THEN
						IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[8] THEN
							arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=8;//侧贴胶夹平移至上电芯位
						END_IF
					END_IF	
					
					IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[8]  THEN
						IF   Mach_Control.TJ_b.SinStepMode THEN//贴胶单步模式
							Sticker_SinStepMode:=TRUE;
						ELSE
							Sticker_SinStepMode:=FALSE;
						END_IF
						Sticker_Step0:=250;
					END_IF	
			END_IF			
		250:
				IF Mach_Control.TJ_b.StickerFlag AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[10]
					AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] 
					AND (arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.OFFState OR CellMemory[Mach_Control.TJ_b.TJ_Memory].Overhang_TF) THEN
						IF   Mach_Control.TJ_b.SinStepMode THEN//贴胶单步模式
								Sticker_SinStepMode:=TRUE;
						ELSE
								Sticker_SinStepMode:=FALSE;
						END_IF
							Sticker_Step0:=300;
				END_IF		
		300:
				IF NOT Sticker_SinStepMode THEN									
						IF 	 arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving 
						AND Mach_Control.TJ_b.StickerFlag AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[10]
					   AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] AND GluingLineagree THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=1;//侧贴胶夹平移至上极耳侧贴胶位
								END_IF
						END_IF	
						
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[1]  THEN
								IF   Mach_Control.TJ_b.SinStepMode THEN//贴胶单步模式
										Sticker_SinStepMode:=TRUE;
								ELSE
										Sticker_SinStepMode:=FALSE;
								END_IF
							Sticker_Step0:=350;
						END_IF	
				END_IF			

		350:		
				IF NOT Sticker_SinStepMode THEN			
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed 
							AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving AND Mach_Control.TJ_b.WhirlingSafe THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[1] AND Mach_Control.TJ_b.StickerFlag AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[10]
									AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1]   THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=1;//侧贴胶夹旋转至极耳侧贴胶位
								END_IF
						END_IF
						IF 	 arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[1]  THEN
								IF   Mach_Control.TJ_b.SinStepMode THEN//贴胶单步模式
										Sticker_SinStepMode:=TRUE;
								ELSE
										Sticker_SinStepMode:=FALSE;
								END_IF
								Sticker_Step0:=400;
						END_IF	
				END_IF				
		400:
				IF NOT Sticker_SinStepMode THEN				
							Mach_Control.WJ_b.TailCultOffloading:=FALSE;//下电芯请求	
							//Mach_Control.TJ_b.StickerDone:=FALSE;//复位贴胶完成
							//Mach_Control.WJ_b.TailCultOffloadingDone:=FALSE;	
							IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单步模式
									Sticker_SinStepMode:=TRUE;
							ELSE
									Sticker_SinStepMode:=FALSE;
							END_IF					
							Sticker_Step0:=0;		
				END_IF
				
				
		1000://贴胶完成，侧贴胶平移、侧贴胶旋转移动至下电芯位
				IF NOT Sticker_SinStepMode THEN		
						IF GluingLineagree AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving   THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[9] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=0;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=9;//侧贴胶夹平移至下电芯位
								END_IF
						END_IF	
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed 
							AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving AND Mach_Control.TJ_b.WhirlingSafe  THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[6] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=6;//侧贴胶夹旋转至下电芯位
								END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[9] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[6] THEN
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单步模式
										Sticker_SinStepMode:=TRUE;
								ELSE
										Sticker_SinStepMode:=FALSE;
								END_IF						
								Sticker_Step0:=1100;
						END_IF	
				END_IF				
		//1100 信号交互挪到最下面
		
			1200://t贴胶旋转回原	
				Sticker_Step0:=1300;		
			1300:
				//arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bOFF:=TRUE;//贴胶夹爪气缸张开
				//IF 	arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Io.DIOFFSwitch THEN
				IF Mach_Control.TJ_b.WhirlingSafe THEN
			     	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.bHome:=TRUE;//侧贴胶旋转轴回原点
			    	Sticker_Step0:=1400;
				END_IF			
				//END_IF		
			1400://判断侧贴胶旋转回原是否完成
					StickerGohome_TON[4].IN:=TRUE;
					IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving  AND StickerGohome_TON[4].Q THEN
						Sticker_Step0:=1500;
						arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.bHome:=FALSE;//侧贴胶旋转轴回原点
						StickerGohome_TON[4].IN:=FALSE;
					END_IF
			1500:	
				IF 	 arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving AND Mach_Control.TJ_b.WhirlingSafe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[5] THEN
						arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
						Sticker_Step0:=1600;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=5;//侧贴胶夹旋转至上电芯位
					END_IF
				END_IF
					
			1600:
				Sticker_Step0:=0;
				
		
				
				
				
		2000://判断贴胶状态
				IF  Mach_Control.TJ_b.StickMark_L1 AND   Mach_Control.TJ_b.StickMark_L2 AND   Mach_Control.TJ_b.StickMark_R1 AND   Mach_Control.TJ_b.StickMark_R2 AND  Mach_Control.TJ_b.StickMark1_L  AND (Mach_Control.TJ_b.StickMark1_L2 OR (NOT P3User2_Par.Shield[14] AND Sticker_Step2=0)) THEN
						Sticker_Step0:=5000;//贴胶完成
				ELSE
						IF NOT Mach_Control.TJ_b.StickMark_L1 THEN//左短边1贴胶完成
								Mach_Control.TJ_b.Sticking_L:=TRUE;//左短边贴胶
								Sticker_Step0:=2100;
						ELSIF NOT Mach_Control.TJ_b.StickMark_L2 THEN//左短边2贴胶完成
								Mach_Control.TJ_b.Sticking_L:=TRUE;//左短边贴胶
 								Sticker_Step0:=2600;
						ELSIF NOT Mach_Control.TJ_b.StickMark_R1 THEN//右短边1贴胶完成
								Mach_Control.TJ_b.Sticking_R:=TRUE;//右短边贴胶
								Sticker_Step0:=3100;
						ELSIF NOT Mach_Control.TJ_b.StickMark_R2 THEN//右短边2贴胶完成		
								Mach_Control.TJ_b.Sticking_R:=TRUE;//右短边贴胶
								Sticker_Step0:=3600;
						ELSIF NOT Mach_Control.TJ_b.StickMark1_L THEN//非极耳侧贴胶完成		
								Mach_Control.TJ_b.Sticking_Lg:=TRUE;//非极耳侧长边贴胶
								Sticker_Step0:=4100;
						ELSIF NOT Mach_Control.TJ_b.StickMark1_L2 AND  P3User2_Par.Shield[14] THEN//极耳侧贴胶完成		
								Mach_Control.TJ_b.Sticking_Lg2:=TRUE;//极耳侧长边贴胶
								Sticker_Step0:=4600;					
						END_IF
				END_IF
	
	
		2100://	左短边1贴胶
				IF NOT Sticker_SinStepMode THEN				
						arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bOFF:=TRUE;//贴胶夹爪气缸打开
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving AND 
                           GluingLineagree THEN
							IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=1;//侧贴胶夹平移至贴胶位
							END_IF
						END_IF	
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving AND Mach_Control.TJ_b.WhirlingSafe 
							AND 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[1] THEN
							IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=1;//侧贴胶夹旋转至贴胶位
							END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[1] 
							AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
							IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
								Sticker_SinStepMode:=TRUE;
							ELSE
								Sticker_SinStepMode:=FALSE;
							END_IF										
							Sticker_Step0:=2200;
						END_IF
				END_IF		
		2200:
				Mach_Control.TJ_b.StickPermit:=TRUE;//贴胶允许
				Mach_Control.TJ_b.StickFinish:=FALSE;//贴胶完成			
				Sticker_Step0:=2300;
		2300:
				IF Mach_Control.TJ_b.StickFinish THEN//贴胶完成		
						Mach_Control.TJ_b.StickPermit:=FALSE;//贴胶允许	
						Sticker_Step0:=2400;
				END_IF 
		2400:
				Mach_Control.TJ_b.StickMark_L1:=TRUE;//左短边1贴胶完成
				Sticker_Step0:=2000;
				
		2600://	左短边2贴胶
				IF NOT Sticker_SinStepMode THEN				
						arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bOFF:=TRUE;//贴胶夹爪气缸打开
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving AND GluingLineagree THEN
							IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[2] THEN
								arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=2;//侧贴胶夹平移至贴胶位
							END_IF
						END_IF	
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving AND Mach_Control.TJ_b.WhirlingSafe  THEN
							IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=1;//侧贴胶夹旋转至贴胶位
							END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[1] 
							AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
							IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
								Sticker_SinStepMode:=TRUE;
							ELSE
								Sticker_SinStepMode:=FALSE;
							END_IF										
							Sticker_Step0:=2700;
						END_IF
				END_IF		
		2700:
				Mach_Control.TJ_b.StickPermit:=TRUE;//贴胶允许
				Mach_Control.TJ_b.StickFinish:=FALSE;//贴胶完成			
				Sticker_Step0:=2800;
		2800:
				IF Mach_Control.TJ_b.StickFinish THEN//贴胶完成		
						Mach_Control.TJ_b.StickPermit:=FALSE;//贴胶允许		
						Sticker_Step0:=2900;
				END_IF 
		2900:
				Mach_Control.TJ_b.StickMark_L2:=TRUE;//左短边2贴胶完成
				Sticker_Step0:=2000;
				
		3100://	右短边1贴胶
				IF NOT Sticker_SinStepMode THEN				
						arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bOFF:=TRUE;//贴胶夹爪气缸打开
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving AND GluingLineagree THEN
							IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[3] THEN
								arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=3;//侧贴胶夹平移至贴胶位
							END_IF
						END_IF	
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving AND Mach_Control.TJ_b.WhirlingSafe  THEN
							IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[2] THEN
								arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=2;//侧贴胶夹旋转至贴胶位2
							END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[3] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[2] 
							AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
							IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
								Sticker_SinStepMode:=TRUE;
							ELSE
								Sticker_SinStepMode:=FALSE;
							END_IF										
							Sticker_Step0:=3200;
						END_IF
				END_IF		
		3200:
				Mach_Control.TJ_b.StickPermit:=TRUE;//贴胶允许
				Mach_Control.TJ_b.StickFinish:=FALSE;//贴胶完成			
				Sticker_Step0:=3300;
		3300:
				IF Mach_Control.TJ_b.StickFinish THEN//贴胶完成			
						Mach_Control.TJ_b.StickPermit:=FALSE;//贴胶允许	
						Sticker_Step0:=3400;
				END_IF 
		3400:
				Mach_Control.TJ_b.StickMark_R1:=TRUE;//右短边1贴胶完成
				Sticker_Step0:=2000;
		
		
				
		3600://	右短边2贴胶
				IF NOT Sticker_SinStepMode THEN				
						arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bOFF:=TRUE;//贴胶夹爪气缸打开
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving AND GluingLineagree THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=0;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=4;//侧贴胶夹平移至贴胶位
								END_IF
						END_IF	
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving AND Mach_Control.TJ_b.WhirlingSafe  THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=2;//侧贴胶夹旋转至贴胶位2
								END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[2] 
							AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
										Sticker_SinStepMode:=TRUE;
								ELSE
										Sticker_SinStepMode:=FALSE;
								END_IF										
								Sticker_Step0:=3700;
						END_IF
				END_IF		
		3700:
				Mach_Control.TJ_b.StickPermit:=TRUE;//贴胶允许
				Mach_Control.TJ_b.StickFinish:=FALSE;//贴胶完成			
				Sticker_Step0:=3800;
		3800:
				IF Mach_Control.TJ_b.StickFinish THEN//贴胶完成			
						Mach_Control.TJ_b.StickPermit:=FALSE;//贴胶允许	
						Sticker_Step0:=3900;
				END_IF 
		3900:
				Mach_Control.TJ_b.StickMark_R2:=TRUE;//右短边1贴胶完成
				Sticker_Step0:=2000;
		

		4100://非极耳侧长边贴胶
			IF NOT Sticker_SinStepMode THEN				
						arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bOFF:=TRUE;//贴胶夹爪气缸打开
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving AND GluingLineagree THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[5] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=0;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=5;//侧贴胶夹平移至贴胶位
								END_IF
						END_IF	
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving AND Mach_Control.TJ_b.WhirlingSafe  THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[3] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=3;//侧贴胶夹旋转至贴胶位2
								END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[3] 
							AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
										Sticker_SinStepMode:=TRUE;
								ELSE
										Sticker_SinStepMode:=FALSE;
								END_IF										
								Sticker_Step0:=4200;
						END_IF
				END_IF		
		4200:
				Mach_Control.TJ_b.StickPermit:=TRUE;//贴胶允许
				Mach_Control.TJ_b.StickFinish:=FALSE;//贴胶完成			
				Sticker_Step0:=4300;
		4300:
				IF Mach_Control.TJ_b.StickFinish THEN//贴胶完成			
						Mach_Control.TJ_b.StickPermit:=FALSE;//贴胶允许	
						Sticker_Step0:=4400;
				END_IF 
		4400:
				Mach_Control.TJ_b.StickMark1_L:=TRUE;//非极耳侧长边贴胶完成
				Sticker_Step0:=2000;


		4600://极耳侧长边贴胶
			IF NOT Sticker_SinStepMode THEN				
						arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bOFF:=TRUE;//贴胶夹爪气缸打开
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving AND GluingLineagree THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[6] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=0;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=6;//侧贴胶夹平移至贴胶位
								END_IF
						END_IF	
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving AND Mach_Control.TJ_b.WhirlingSafe  THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=4;//侧贴胶夹旋转至贴胶位2
								END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[6] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[4] 
							AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
										Sticker_SinStepMode:=TRUE;
								ELSE
										Sticker_SinStepMode:=FALSE;
								END_IF										
								Sticker_Step0:=4700;
						END_IF
				END_IF		
		4700:
				Mach_Control.TJ_b.StickPermit:=TRUE;//贴胶允许
				Mach_Control.TJ_b.StickFinish:=FALSE;//贴胶完成			
				Sticker_Step0:=4800;
		4800:
				IF Mach_Control.TJ_b.StickFinish THEN//贴胶完成			
						Mach_Control.TJ_b.StickPermit:=FALSE;//贴胶允许	
						Sticker_Step0:=4900;
				END_IF 
		4900:
				Mach_Control.TJ_b.StickMark1_L2:=TRUE;//极耳侧长边贴胶完成
				Sticker_Step0:=2000;





	

	
		5000://等待贴胶完成信号						
				Mach_Control.TJ_b.StickerDone:=TRUE;//电芯贴胶完成
				CellMemory[Mach_Control.TJ_b.TJ_Memory].QR_code_No:=Par.stDT_date.QR_code_No;
				CellMemory[Mach_Control.TJ_b.TJ_Memory].Glue_No:=Par.stDT_date.Glue_No;		
				IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
					Sticker_SinStepMode:=TRUE;
				ELSE
					Sticker_SinStepMode:=FALSE;
				END_IF	
				Sticker_Step0:=5100;		
		5100:
				Mach_Control.TJ_b.StickPermit:=FALSE;//贴胶允许
				Mach_Control.TJ_b.StickFinish:=FALSE;//贴胶完成	
				Mach_Control.TJ_b.StickMark_L1 :=FALSE;//左短边1贴胶完成
				Mach_Control.TJ_b.StickMark_L2 :=FALSE;//左短边2贴胶完成
				Mach_Control.TJ_b.StickMark_R1 :=FALSE;//右短边1贴胶完成
				Mach_Control.TJ_b.StickMark_R2 :=FALSE;//右短边2贴胶完成	
				Mach_Control.TJ_b.StickMark1_L :=FALSE;//非极耳侧长边贴胶完成		
				Mach_Control.TJ_b.StickMark1_L2 :=FALSE;//极耳侧长边贴胶完成		
				Mach_Control.TJ_b.Sticking_L:=FALSE;//左短边贴胶
				Mach_Control.TJ_b.Sticking_R:=FALSE;//右短边贴胶
				Mach_Control.TJ_b.Sticking_Lg:=FALSE;//非极耳侧长边贴胶
				Mach_Control.TJ_b.Sticking_Lg2:=FALSE;//极耳侧长边贴胶
				Sticker_Step0:=0;		
				
				
END_CASE	
END_IF


IF Mach_Control.U.TJ_iMode=1 OR AV THEN//在自动状态下
CASE 	Sticker_Step2 OF
		0://判断备胶是否完成，贴胶冶具夹爪张开
				IF Mach_Control.TJ_b.StickPermit THEN//贴胶允许
						Sticker_Step2:=100;
				END_IF
		100:
				Mach_Control.TJ_b.StickPermit:=FALSE;//贴胶允许
				Mach_Control.TJ_b.StickFinish:=FALSE;//贴胶完成			
				Sticker_Step2:=200;
		200:
				IF NOT Sticker_SinStepMode THEN		
						IF 	Mach_Control.TJ_b.StickerStandbyDone  THEN//备胶完成,	
								Sticker_Step2:=250;						
						END_IF
				END_IF
		250: 
			IF arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Io.DOStatus1  
			AND arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Io.DIOnSwitch THEN
				Sticker_Step2:=300;
			ELSE
				Mach_Control.TJ_b.StickerStandbyDone:=FALSE;
				Mach_Control.TJ_b.Error[11]:=TRUE;//叠台贴胶头贴胶时无贴胶报警
				Sticker_Step2:=200;	
			END_IF
		
		300:
		arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.fOverride:=100;
				IF Mach_Control.TJ_b.Sticking_L THEN//左短边贴胶
					Sticker_Step2:=400;		
				ELSIF  Mach_Control.TJ_b.Sticking_R THEN//右短边贴胶
					Sticker_Step2:=450;		
				ELSIF Mach_Control.TJ_b.Sticking_Lg THEN//非极耳侧长边贴胶
					Sticker_Step2:=500;	
				ELSIF Mach_Control.TJ_b.Sticking_Lg2  THEN//极耳侧长边贴胶
					Sticker_Step2:=550;				
				END_IF	
		400://贴胶头移动左短边贴胶位
				IF NOT Sticker_SinStepMode THEN		
							IF GluingRetractingagree 
									AND  arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed 
									AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving 
									AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
									IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[2] THEN
											Mach_Control.TJ_b.Sticking_L:=FALSE;//左短边贴胶
											arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=0;
											arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Cmd.bOFF:=TRUE;//备胶贴胶头真空关
											IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
													Sticker_SinStepMode:=TRUE;
											ELSE
													Sticker_SinStepMode:=FALSE;
											END_IF																						
											Sticker_Step2:=600;
									ELSE
											arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=2;//贴胶头前进到贴胶位
									END_IF
										
							END_IF
							IF LREAL_TO_REAL(arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.fActPos) >= (arrAxisPar[AxiseNo.AxisName.GluingRetracting].arrTargetPoint[2]-30) THEN
									arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.fOverride:=5;
							END_IF
				END_IF
		450://贴胶头移动右短边贴胶位
				IF NOT Sticker_SinStepMode THEN		
						IF GluingRetractingagree 
						AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed 
						AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving 
						AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[3] THEN
										Mach_Control.TJ_b.Sticking_R:=FALSE;//左短边贴胶
										arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=0;							
										arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Cmd.bOFF:=TRUE;//备胶贴胶头真空关
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
												Sticker_SinStepMode:=TRUE;
										ELSE
												Sticker_SinStepMode:=FALSE;
										END_IF																						
										Sticker_Step2:=600;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=3;//贴胶头前进到贴胶位
								END_IF	
						END_IF	
							IF LREAL_TO_REAL(arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.fActPos) >= (arrAxisPar[AxiseNo.AxisName.GluingRetracting].arrTargetPoint[3]-30) THEN
									arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.fOverride:=5;
							END_IF							
				END_IF
		500://非极耳侧长边贴胶
				IF NOT Sticker_SinStepMode THEN		
					IF GluingRetractingagree 
					AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed 
					AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving 
					AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
						IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[4] THEN
								Mach_Control.TJ_b.Sticking_Lg:=FALSE;//非极耳侧长边贴胶
								arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=0;							
								arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Cmd.bOFF:=TRUE;//备胶贴胶头真空关
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
										Sticker_SinStepMode:=TRUE;
								ELSE
										Sticker_SinStepMode:=FALSE;
								END_IF																						
								Sticker_Step2:=600;
						ELSE
								arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=4;//贴胶头前进到贴长边位
						END_IF		
					END_IF	
							IF LREAL_TO_REAL(arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.fActPos) >= (arrAxisPar[AxiseNo.AxisName.GluingRetracting].arrTargetPoint[4]-30) THEN
									arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.fOverride:=5;
							END_IF
				END_IF
	
			550://极耳侧长边贴胶
				IF NOT Sticker_SinStepMode THEN		
					IF GluingRetractingagree 
					AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed 
					AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving 
					AND arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState THEN
						IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[5] THEN
								Mach_Control.TJ_b.Sticking_Lg2:=FALSE;//极耳侧长边贴胶
								arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=0;							
								arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Cmd.bOFF:=TRUE;//备胶贴胶头真空关
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
										Sticker_SinStepMode:=TRUE;
								ELSE
										Sticker_SinStepMode:=FALSE;
								END_IF																						
								Sticker_Step2:=600;
						ELSE
								arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=5;//贴胶头前进到贴长边位
						END_IF		
					END_IF	
							IF LREAL_TO_REAL(arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.fActPos) >= (arrAxisPar[AxiseNo.AxisName.GluingRetracting].arrTargetPoint[5]-30) THEN
									arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.fOverride:=5;
							END_IF
				END_IF
			
		600:	
				IF NOT Sticker_SinStepMode THEN	
						TON_Sticker[4].IN:=FALSE;
						arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bON:=TRUE;//贴胶夹爪气缸夹紧
						IF arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.ONState AND NOT arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.Error1 THEN
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
									Sticker_SinStepMode:=TRUE;
								ELSE
									Sticker_SinStepMode:=FALSE;
								END_IF		
						TON_Sticker[4].IN:=TRUE;
							IF TON_Sticker[4].Q THEN
								Sticker_Step2:=700;	
								TON_Sticker[4].IN:=FALSE;
							END_IF		
						END_IF
				END_IF
		700:				
				IF NOT Sticker_SinStepMode THEN	
						arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bOFF:=TRUE;//贴胶夹爪气缸松开
						IF arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.OFFState AND NOT arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Status.Error2 THEN
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
										Sticker_SinStepMode:=TRUE;
								ELSE
										Sticker_SinStepMode:=FALSE;
								END_IF	
								arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.fOverride:=100;		
								Sticker_Step2:=800;
						END_IF
				END_IF
		800:
					IF NOT Sticker_SinStepMode THEN		
							IF GluingRetractingagree AND  arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=0;
											Mach_Control.TJ_b.StickerStandbyDone:=FALSE;//复位备胶完成
											Mach_Control.TJ_b.StickFinish :=TRUE;//贴胶完成	
											Mach_Control.TJ_b.StickPermit:=false;//贴胶允许复位	
											IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
													Sticker_SinStepMode:=TRUE;
											ELSE
													Sticker_SinStepMode:=FALSE;
											END_IF																						
											Sticker_Step2:=900;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=1;//贴胶头前进到初始位
									END_IF
							END_IF	
					END_IF
			900:
					Sticker_Step2:=0;	
END_CASE
END_IF


CASE Sticker_Step0 OF
			1100://贴胶完成，允许下电芯，等待下电芯夹紧完成				
				IF Mach_Control.TJ_b.StickerOffloadingDone THEN
					Mach_Control.TJ_b.StickerFlag:=FALSE;
					Mach_Control.TJ_b.StickerOffloadingDone:=FALSE;						
					Sticker_Step0:=1200;
				END_IF
END_CASE


IF Sticker_Step0=4600 THEN
	Mach_Control.TJ_b.Stick_Judge:=TRUE;
ELSIF Sticker_Step0=2100 AND Sticker_Step0=2600 AND Sticker_Step0=3100 AND Sticker_Step0=3600 THEN
	Mach_Control.TJ_b.Stick_Judge:=FALSE;
END_IF



]]></ST>
      </Implementation>
    </Action>
    <Action Name="_02BlueGlue_Auto" Id="{24411b71-95cd-49ad-8532-2509bc4aeaf2}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[
(*
//蓝胶检测自动
DT_BlueGlue(
	Enable:=Mach_Control.U.DT_iMode=1 , //启动条件
	BlueSenser:=Mach_Control.se.BlueGluetsensor , //蓝胶检测信号
	An_Quantited:=Mach_Control.An_b.An_Quantited, //正极已叠极片数
	An_QuantitSet:=Par.stDT_date.An_Quantity , //正极设置极片数
	Ca_Quantited:=Mach_Control.Ca_b.Ca_Quantited, //负极已叠极片数
	Ca_QuantitSet:=Par.stDT_date.Ca_Quantity ,//负极设定极片数 
	Distance:=Par.stDT_date.Distance , //蓝胶检测到压刀的距离
	BluWidth:=Par.stDT_date.BluWidth , //蓝胶宽度
	Width:=Par.stDT_date.Width , //压刀外边宽
	BluGlueNG:=Mach_Control.DT_b.BluGlueNG );//电当蓝胶NG输出
	
	

//蓝胶标记
P2M_BlueFlag(
	Bnt_Blueflag:=Mach_Control.DT_b.stBnt_Blueflag , //蓝胶标记启动信号
	FlagDone:=P2M_BlueFlag.FlagDone , //蓝胶标记完成
	AixsoActPos:=arrAxis[AxiseNo.AxisName.SEPTAunwinding].NcToPlc.ActPos , //放卷轴当前位置
	Diameter:=Mach_Control.DT_b.fWindDiameter , //放卷轴当前卷径
	SetLenght:=Par.stDT_date.stSetLenght,//接带点到叠台的距离 3800
	fYDLength :=par.stDT_date.Width,
	rBnt_BlueflagCaNum :=Mach_Control.Ca_b.Ca_Quantited   , //叠台压刀外边宽
	FlagPoisn=> , //蓝胶NG标记
	NumberPos:=stNumberPos,//前一片数据
	NumberPos1:=stNumberPos1,//当前片数据
	NumberPos2:=stNumberPos2,
	rBnt_BlueflagNum :=DT_Ca_Quantited ,
	rBnt_Blueflaging:=Bnt_Blueflaging );//
	P2M_BlueFlag.FlagPoisn;	
	//
BulebntR_TRIG(CLK:=Mach_Control.DT_b.stBnt_Blueflag AND Mach_Control.DT_b.DT_Blue_TF   (*OR Mach_Control.btn.PoleInflationbtn*) , Q=> );
IF BulebntR_TRIG.Q THEN
	Bnt_Blueflaging:=TRUE;
	IF  (Par.stDT_date.An_Quantity+Par.stDT_date.Ca_Quantity-Mach_Control.An_b.An_Quantited-Mach_Control.Ca_b.Ca_Quantited)>=40 THEN
		Blueflaging:=TRUE;
	END_IF
END_IF	
*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="_02Sticker_Auto" Id="{4faef247-1ede-4f1e-bc0b-3d8232f00e6f}" FolderPath="05StickGlue \">
      <Implementation>
        <ST><![CDATA[
TON_Sticker[0](PT:=T#0.2S);//拉胶气缸取胶延时
TON_Sticker[1](PT:=T#10S);//扫码超时报警延时
TON_Sticker[2](PT:=T#0.2S);//扫码超时报警延时
TON_Sticker[3](PT:=T#300MS);//扫码超时报警延时

IF Mach_Control.U.TJ_iMode<>1  THEN
				//一键备二维码胶
				rStickerStandbyCode_btn(CLK:=Mach_Control.btn.codeGluebtn , Q=> );
				fStickerStandbyCode_btn(CLK:=Mach_Control.btn.codeGluebtn , Q=> );
				IF rStickerStandbyCode_btn.Q THEN
					Mach_Control.TJ_b.StickerStandbyDone :=FALSE;
				END_IF
				IF fStickerStandbyCode_btn.Q THEN
					StandbyBule_Start:=FALSE;
					StandbyCode_Start:=TRUE;
				END_IF
				//一键备蓝胶
				rStickerStandbyBule_btn(CLK:=Mach_Control.btn.BlueGluebtn , Q=> );
				fStickerStandbyBule_btn(CLK:=Mach_Control.btn.BlueGluebtn , Q=> );
				IF rStickerStandbyBule_btn.Q THEN
					Mach_Control.TJ_b.StickerStandbyDone :=FALSE;
				END_IF
				IF fStickerStandbyBule_btn.Q THEN
					StandbyCode_Start:=FALSE;
					StandbyBule_Start:=TRUE;
				END_IF
END_IF

IF  StandbyBule_Start  THEN		
		Mach_Control.TJ_b.StickerStandbyBule:=FALSE;
END_IF

(*
//判断需要备什么胶,当设置的贴胶屏蔽时，置位已贴胶标记
IF Mach_Control.U.TJ_iMode=1 OR AV   THEN
			IF  NOT Mach_Control.TJ_b.StickerDoneNo[1]  AND NOT Mach_Control.TJ_b.Stickersetting[0]  THEN
				Mach_Control.TJ_b.StickerStandbyBule:=FALSE;//蓝胶备胶
				Mach_Control.TJ_b.StickerStandbyCode:=TRUE;//二维码备胶
				StandbyCode_Start:=FALSE;
				StandbyBule_Start:=FALSE;
			ELSIF (NOT Mach_Control.TJ_b.StickerDoneNo[2]  AND NOT Mach_Control.TJ_b.Stickersetting[1]) OR 
					(NOT Mach_Control.TJ_b.StickerDoneNo[3]  AND NOT Mach_Control.TJ_b.Stickersetting[2]) OR 
					(NOT Mach_Control.TJ_b.StickerDoneNo[4]  AND NOT Mach_Control.TJ_b.Stickersetting[3]) OR 
					(NOT Mach_Control.TJ_b.StickerDoneNo[5]  AND NOT Mach_Control.TJ_b.Stickersetting[4]) OR 
					(NOT Mach_Control.TJ_b.StickerDoneNo[6]  AND NOT Mach_Control.TJ_b.Stickersetting[5]) OR 
					(NOT Mach_Control.TJ_b.StickerDoneNo[7]  AND NOT Mach_Control.TJ_b.Stickersetting[6]) THEN
				Mach_Control.TJ_b.StickerStandbyBule:=TRUE;//蓝胶备胶
				Mach_Control.TJ_b.StickerStandbyCode:=FALSE;//二维码备胶	
				StandbyCode_Start:=FALSE;
				StandbyBule_Start:=FALSE;		
			END_IF
END_IF
*)


GluingUpDownPoint1:=ABS(arrAxisPar[AxiseNo.AxisName.GluingUpDown].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.GluingUpDown].arrTargetPoint[2]);
GluingUpDownPoint3:=ABS(GluingUpDownPoint2-arrAxisPar[AxiseNo.AxisName.GluingUpDown].arrTargetPoint[1]);
IF GluingUpDownPoint3-GluingUpDownPoint1>=2 THEN
	GluingUpDownPoint4:=2;
ELSIF GluingUpDownPoint3-GluingUpDownPoint1<=-2 THEN
	GluingUpDownPoint4:=-2;
ELSE
	GluingUpDownPoint4:=GluingUpDownPoint3-GluingUpDownPoint1;
END_IF

rMarkesensorR_TRIG(CLK:=Mach_Control.se.Markesensor , Q=> );

IF (Mach_Control.U.TJ_iMode=1 OR StandbyCode_Start OR StandbyBule_Start OR AV) AND NOT TJ_Error THEN//在自动状态下
	
//贴胶备胶自动
	
CASE Sticker_Step1 OF
		0://判断贴胶备胶是否完成
				IF NOT Sticker_SinStepMode THEN
						IF NOT Mach_Control.TJ_b.StickerStandbyDone THEN//备胶没有完成，贴胶头前进后退轴在安全位
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
									Sticker_SinStepMode:=TRUE;
								ELSE
									Sticker_SinStepMode:=FALSE;
								END_IF
								Sticker_Step1:=10;					
						END_IF
				END_IF
		10://备二维码胶真空1、备蓝胶真空1	
				//arrCyCtrl[arrCyNo.ElectValveName.codeGlueVacuum1].Cmd.bON:=TRUE;//备二维码胶真空1						
				arrCyCtrl[arrCyNo.ElectValveName.BlueGlueVacuum1].Cmd.bON:=TRUE;//备蓝胶真空1					
				Sticker_Step1:=20;			
		20://贴胶台具气缸张开、贴胶头前进轴回初始位
				IF NOT Sticker_SinStepMode THEN
						IF(GluingRetractingagree OR  arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[1])AND
							arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[1] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=0;						
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
												Sticker_SinStepMode:=TRUE;
										ELSE
												Sticker_SinStepMode:=FALSE;
										END_IF
										Sticker_Step1:=30;
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=1;//贴胶头前进到贴胶位
								END_IF
						END_IF
				END_IF					
	   30://贴胶压胶气缸伸出，备胶气缸伸出
				IF NOT Sticker_SinStepMode THEN  
						arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Cmd.bON:=TRUE;//贴胶压胶气缸伸出
						arrCyCtrl[arrCyNo.CylinderName.CodeGluePressCy].Cmd.bON:=TRUE;//贴胶压二维码胶气缸伸出
						IF arrCyCtrl[arrCyNo.CylinderName.CodeGluePressCy].Io.DIOnSwitch THEN
								arrCyCtrl[arrCyNo.CylinderName.CodeStandbyGlueCy].Cmd.bON:=TRUE;//贴胶备二维码胶气缸伸出
						END_IF
						IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
								Sticker_SinStepMode:=TRUE;
						ELSE
								Sticker_SinStepMode:=FALSE;
						END_IF
						IF arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CodeGluePressCy].Status.ONState THEN
								Sticker_Step1:=40;	
						END_IF
				END_IF
		40://判断贴蓝胶、二维码胶
				IF NOT Sticker_SinStepMode THEN
					//IF Mach_Control.TJ_b.StickerStandbyBule OR StandbyBule_Start THEN//备蓝胶请求
					IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
							Sticker_SinStepMode:=TRUE;
					ELSE
							Sticker_SinStepMode:=FALSE;
					END_IF								
					arrCyCtrl[arrCyNo.CylinderName.StandbyGlueCy].Cmd.bON:=TRUE;//备蓝胶气缸伸出
					IF 	arrCyCtrl[arrCyNo.CylinderName.StandbyGlueCy].Io.DIOnSwitch THEN
							Sticker_Step1:=200;
					END_IF
					//END_IF	
				END_IF			
		200:// 二维码胶、蓝胶切胶气缸伸出，拉胶气缸伸出，拉胶升降轴移至拉蓝胶起始位
				IF NOT Sticker_SinStepMode THEN			
						arrCyCtrl[arrCyNo.CylinderName.codeGlueCutCy].Cmd.bON:=TRUE;//贴胶切二维码胶气缸伸出
						arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Cmd.bON:=TRUE;//贴胶切胶气缸伸出
						arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Cmd.bON:=TRUE;//拉胶气缸伸出
						arrCyCtrl[arrCyNo.CylinderName.StandbyGlueCy].Cmd.bOFF:=TRUE;//备蓝胶气缸伸出
						IF  GluingUpDownagree AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.arrbRealPoint[9] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=0;
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
												Sticker_SinStepMode:=TRUE;
										ELSE
												Sticker_SinStepMode:=FALSE;
										END_IF
										Sticker_Step1:=205;	
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=9;//拉胶升降轴至拉蓝胶起始位
								END_IF
						END_IF		
				END_IF
		205:
				IF NOT Sticker_SinStepMode THEN
						IF  GluingUpDownagree AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.arrbRealPoint[3] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=0;
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
												Sticker_SinStepMode:=TRUE;
										ELSE
												Sticker_SinStepMode:=FALSE;
										END_IF
										Sticker_Step1:=210;	
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=3;//拉胶升降轴至拉蓝胶起始位
								END_IF
						END_IF		
				END_IF
			210://拉胶升降气缸收回,取胶
				IF NOT Sticker_SinStepMode THEN			
						arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Cmd.bOFF:=TRUE;//拉胶气缸收回	
						arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Cmd.bOFF:=TRUE;//贴胶压胶气缸伸出
						arrCyCtrl[arrCyNo.CylinderName.PullGluePoleCy].Cmd.bOFF:=TRUE;//拉胶抱紧气缸松开
						IF arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Io.DIOFFSwitch THEN
								IF NOT TON_Sticker[0].Q THEN
										TON_Sticker[0].IN:=TRUE;
								ELSE
										TON_Sticker[0].IN:=FALSE;
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
												Sticker_SinStepMode:=TRUE;
										ELSE
												Sticker_SinStepMode:=FALSE;
										END_IF
								Sticker_Step1:=220;
								END_IF
						END_IF	
				END_IF
		220://取胶滚胶位
				IF NOT Sticker_SinStepMode THEN			
						arrCyCtrl[arrCyNo.CylinderName.PullGluePoleCy].Cmd.bOFF:=TRUE;//拉胶抱紧气缸松开
						IF   arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.arrbRealPoint[7] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=0;
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
												Sticker_SinStepMode:=TRUE;
										ELSE
												Sticker_SinStepMode:=FALSE;
										END_IF
										Sticker_Step1:=221;	
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=7;//拉胶升降轴取胶滚胶位
								END_IF
						END_IF
				END_IF	
		221://
				IF NOT Sticker_SinStepMode THEN
						IF NOT TON_Sticker[0].Q THEN
								arrCyCtrl[arrCyNo.ElectValveName.BlueGlueVacuum1].Cmd.bOFF:=TRUE;//备蓝胶真空1关
								arrCyCtrl[arrCyNo.ElectValveName.codeGlueVacuum2].Cmd.bOFF:=TRUE;//备二维码胶真空2关
								arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Cmd.bOFF:=TRUE;//备胶贴胶头真空关
								arrCyCtrl[arrCyNo.CylinderName.PullGluePoleCy].Cmd.bON:=TRUE;//拉胶抱紧气缸抱紧
								TON_Sticker[0].IN:=TRUE;
						ELSE
								TON_Sticker[0].IN:=FALSE;
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
										Sticker_SinStepMode:=TRUE;
								ELSE
										Sticker_SinStepMode:=FALSE;
								END_IF								
								Sticker_Step1:=230;	;	
						END_IF
				END_IF
		230://拉胶升降气缸伸出，拉胶升降气缸移动至拉蓝胶终点位
				IF NOT Sticker_SinStepMode THEN			
						arrCyCtrl[arrCyNo.CylinderName.codeGlueCutCy].Cmd.bON:=TRUE;//贴胶切二维码胶气缸伸出
						arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Cmd.bON:=TRUE;//贴胶切胶气缸伸出
						arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Cmd.bON:=TRUE;//拉胶气缸伸出
						arrCyCtrl[arrCyNo.CylinderName.PullGluePoleCy].Cmd.bON:=TRUE;//拉胶抱紧气缸抱紧
						IF  GluingUpDownagree AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=0;
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
												Sticker_SinStepMode:=TRUE;
										ELSE
												Sticker_SinStepMode:=FALSE;
										END_IF
										Sticker_Step1:=240;	
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=4;//拉胶升降轴至拉蓝胶终点位
								END_IF
						END_IF
				END_IF					
		240://拉胶气缸收回
				IF NOT Sticker_SinStepMode THEN			
						arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Cmd.bOFF:=TRUE;//拉胶气缸收回		
						arrCyCtrl[arrCyNo.CylinderName.PullGluePoleCy].Cmd.bOFF:=TRUE;//拉胶抱紧气缸松开	
						arrCyCtrl[arrCyNo.ElectValveName.BlueGlueVacuum1].Cmd.bON:=TRUE;//备蓝胶真空1
						arrCyCtrl[arrCyNo.ElectValveName.BlueGlueVacuum2].Cmd.bON:=TRUE;//备蓝胶真空2	
						arrCyCtrl[arrCyNo.ElectValveName.codeGlueVacuum1].Cmd.bON:=TRUE;//备二维码胶真空1
						arrCyCtrl[arrCyNo.ElectValveName.codeGlueVacuum2].Cmd.bON:=TRUE;//备二维码胶真空2																			
						IF arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Status.OFFState THEN
								IF NOT TON_Sticker[0].Q THEN
										TON_Sticker[0].IN:=TRUE;
								ELSE
										TON_Sticker[0].IN:=FALSE;
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
												Sticker_SinStepMode:=TRUE;
										ELSE
												Sticker_SinStepMode:=FALSE;
										END_IF					
								Sticker_Step1:=250;
								END_IF
						END_IF	
				END_IF
		250:	//拉胶升降轴至切胶滚胶位	
				IF NOT Sticker_SinStepMode THEN			
						IF   arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.arrbRealPoint[8] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=0;
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
												Sticker_SinStepMode:=TRUE;
										ELSE
												Sticker_SinStepMode:=FALSE;
										END_IF
										Sticker_Step1:=255;	
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=8;//拉胶升降轴至切胶滚胶位
								END_IF
						END_IF
				END_IF	
	
		255://20230205修改切胶动作
				arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Cmd.bON:=TRUE;//贴胶压胶气缸伸出
				IF arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Status.ONState THEN//贴胶压胶气缸伸出
						Sticker_Step1:=260;		
				END_IF
		
		260://切二维码胶气缸收回，切胶
				IF NOT Sticker_SinStepMode THEN	
						arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Cmd.bON:=TRUE;//备胶贴胶头真空		
						arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Cmd.bOFF:=TRUE;//切蓝胶气缸收回
						IF arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Status.OFFState THEN													
									IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
											Sticker_SinStepMode:=TRUE;
									ELSE
											Sticker_SinStepMode:=FALSE;
									END_IF															
									Sticker_Step1:=270;	
						END_IF	
				END_IF
		270://拉胶气缸伸出、切胶气缸伸出、拉胶升降轴回初始位
				IF NOT Sticker_SinStepMode THEN			
						arrCyCtrl[arrCyNo.CylinderName.codeGlueCutCy].Cmd.bON:=TRUE;//贴胶切二维码胶气缸伸出
						arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Cmd.bON:=TRUE;//贴胶切胶气缸伸出
						arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Cmd.bON:=TRUE;//拉胶气缸伸出
						arrCyCtrl[arrCyNo.ElectValveName.BlueGlueVacuum2].Cmd.bON:=FALSE;//备蓝胶真空2	
						arrCyCtrl[arrCyNo.ElectValveName.codeGlueVacuum2].Cmd.bON:=FALSE;//备二维码胶真空2
						arrCyCtrl[arrCyNo.ElectValveName.BlueGlueVacuum2].Cmd.bOFF:=TRUE;//备蓝胶真空2	
						arrCyCtrl[arrCyNo.ElectValveName.codeGlueVacuum2].Cmd.bOFF:=TRUE;//备二维码胶真空2								
						IF  GluingUpDownagree AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.arrbRealPoint[9] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=0;
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
												Sticker_SinStepMode:=TRUE;
										ELSE
												Sticker_SinStepMode:=FALSE;
										END_IF
										Mach_Control.TJ_b.StickerStandbyDone:=TRUE;
										StandbyBule_Start:=FALSE;
										arrCyCtrl[arrCyNo.CylinderName.StandbyGlueCy].Cmd.bON:=TRUE;//备蓝胶气缸伸出		
										Sticker_Step1:=0;	
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=9;//拉胶升降轴至拉蓝胶起始位
								END_IF
						END_IF		
				END_IF						
END_CASE
END_IF


IF Mach_Control.TJ_b.Error[5] AND Sticker_Step1>=260 AND Sticker_Step1<=270 THEN
	Sticker_Step1:=0;
	Mach_Control.TJ_b.StickerStandbyDone:=FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="_02Sticker_AutoSbu1_Scan" Id="{43735cac-e08f-4ec2-906b-4d2820d7ead7}" FolderPath="05StickGlue \">
      <Implementation>
        <ST><![CDATA[(*
Scan_TON[1](PT:=T#3MS);
Scan_TON[2](PT:=T#3MS);
Scan_TON[3](PT:=T#3MS);
Scan_TON[4](PT:=T#100MS);


//二维码胶扫码		
	CASE Stick_Step0 OF
		10:
			Scan_TON[1].IN:=FALSE;
			Scan_TON[2].IN:=FALSE;
			Scan_TON[3].IN:=FALSE;
			Stick_Step0:=20;
			
		20:
			fbinit_tcp:=TRUE;
			Scan_TON[1].IN:=TRUE;
			IF Scan_TON[1].Q THEN
				fbinit_tcp:=FALSE;
				Scan_TON[1].IN:=FALSE;
				Stick_Step0:=30;
			END_IF

		30:
			fbComOpen:=TRUE;
			Scan_TON[2].IN:=TRUE;
			IF Scan_TON[2].Q THEN
				fbComOpen:=FALSE;
				Scan_TON[2].IN:=FALSE;
				Stick_Step0:=40;
			END_IF

		40:
			IF bCS_CodeTcp.bComOpenDone THEN
				Stick_Step0:=50;
			END_IF
		
		50:
			bCS_CodeTcp.bLON:=TRUE;
			Scan_TON[3].IN:=TRUE;
			IF Scan_TON[3].Q THEN
				bCS_CodeTcp.bLON:=FALSE;
				Scan_TON[3].IN:=FALSE;
				Stick_Step0:=60;
			END_IF
		60:
			Scan_TON[4].IN:=TRUE;
			IF 	Scan_TON[4].Q THEN
				Stick_Step0:=70;
				Scan_TON[4].IN:=FALSE;
			END_IF

		70:
			IF  bCS_CodeTcp.Code_State=1  THEN
				Mach_Control.TJ_b.strCode:=bCS_CodeTcp.strCode;
				Mach_Control.TJ_b.Scan_gross:=bCS_CodeTcp.Code_State;
				Stick_Step0:=80;
				Mach_Control.TJ_b.ScanStarte:=FALSE;
				
			 ELSIF bCS_CodeTcp.Code_State=2 THEN
				 Mach_Control.TJ_b.Scan_gross:=bCS_CodeTcp.Code_State;
				 Stick_Step0:=80;
				 Mach_Control.TJ_b.ScanStarte:=FALSE;
			 ELSIF bCS_CodeTcp.bCodeConError OR Mach_Control.TJ_b.Error[0] THEN
				Stick_Step0:=6666;
				Mach_Control.TJ_b.ScanStarte:=FALSE;
			END_IF

	END_CASE

(*IF Mach_Control.TJ_b.ScanOK AND NOT   Mach_Control.TJ_b.ScanNG THEN
					Mach_Control.TJ_b.ScanStatus[0]:=TRUE;//扫码位的胶琮扫码OK
					Mach_Control.TJ_b.ScanStarte:=FALSE;//二维码扫码启动	
					TON_Sticker[1].IN:=FALSE;
					Stick_Step0:=6666;
				ELSIF NOT Mach_Control.TJ_b.ScanOK AND Mach_Control.TJ_b.ScanNG  THEN
					Mach_Control.TJ_b.ScanStatus[0]:=FALSE;//扫码位的胶琮扫码NG
					Mach_Control.TJ_b.ScanStarte:=FALSE;//二维码扫码启动	
					TON_Sticker[1].IN:=FALSE;	
					Stick_Step0:=6666;	
				ELSE
						IF NOT TON_Sticker[1].Q THEN
							TON_Sticker[1].IN:=TRUE;
						ELSE
							TON_Sticker[1].IN:=FALSE;
							Mach_Control.TJ_b.Error[0]:=TRUE;//扫码超时报警
							Mach_Control.TJ_b.ScanStarte:=FALSE;//二维码扫码启动	
							Stick_Step0:=9999;	
						END_IF
				END_IF*)

	
	
		
			
					
(*
上升沿触发 fbComOpen,  bComOpenDone连接完成；
触发fbLON拍照；
*)
bCS_CodeTcp(
	bLON:=bCS_CodeTcp.bLON,                           	// 扫码触发
	sRemoteHost:=Par.Code.sRemoteHost	,					//后段扫码枪；sRemoteHost:='192.168.10.25'
	bComOpen:=fbComOpen,           //扫码Tcp 连接，上升沿；
	binit_tcp:=fbinit_tcp,					//初始化功能块，上升沿；
	bComOpenDone=>, 			 //扫码Tcp 打开OK
    bCodeConError =>Mach_Control.TJ_b.Error[0],            	//扫码通讯故障
	bDone=>,                        	 //扫码完成
    bCodeError=>Mach_Control.TJ_b.Error[0],                  //扫码故障	
    strCode =>,                      //条码结果
	Code_State=>,					//扫码结果 1：OK  2：NG
);

bCS_CodeTcp.bDone;//这个需外部复位；
bCS_CodeTcp.strCode;
bCS_CodeTcp.Code_State;
bCS_CodeTcp.bComOpenDone;

*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="_02Sticker_AutoSbu2_NG" Id="{7fed9eb8-a6d2-4b8a-9fad-31d2e76ab425}" FolderPath="05StickGlue \">
      <Implementation>
        <ST><![CDATA[
//贴胶踢废胶程序
		CASE 	Stick_Step2  OF 
		100://踢废胶
					arrCyCtrl[arrCyNo.CylinderName.GlueNGCy].Cmd.bON:=TRUE;//踢废胶升降气缸伸出
					IF 	 arrCyCtrl[arrCyNo.CylinderName.GlueNGCy].Io.DIOnSwitch THEN
						IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving THEN
							IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[6] THEN
								arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=0;
								Mach_Control.TJ_b.StickerStandbyDone:=FALSE;//复位备胶完成
								IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
									Sticker_SinStepMode:=TRUE;
								ELSE
									Sticker_SinStepMode:=FALSE;
								END_IF																						
								Stick_Step2:=200;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=6;//踢废胶位
							END_IF
						END_IF	
					END_IF	
		120://贴胶冶具夹爪夹紧
					IF NOT Sticker_SinStepMode THEN		
						arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Cmd.bON:=TRUE;//贴胶冶具夹爪夹紧
						IF arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Io.DIOnSwitch THEN
							IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
								Sticker_SinStepMode:=TRUE;
							ELSE
								Sticker_SinStepMode:=FALSE;
							END_IF								
							Stick_Step2:=130;
						END_IF
					END_IF	
		130://贴胶夹爪张开，贴胶尖退回到初始位
					IF NOT Sticker_SinStepMode THEN		
							arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Cmd.bOFF:=TRUE;//贴胶冶具夹爪张开
							IF 	Mach_Control.TJ_b.StickerStandbyDone THEN
								IF arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Io.DIOFFSwitch AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[1] THEN
										arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=0;
										IF Mach_Control.TJ_b.SinStepMode THEN//贴胶单眇模式
											Sticker_SinStepMode:=TRUE;
										ELSE
											Sticker_SinStepMode:=FALSE;
										END_IF																						
										Stick_Step2:=140;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=1;//贴胶头前进到备胶位
									END_IF
								END_IF						
						END_IF
					END_IF	
		140://踢废胶升降气缸纠回	
					arrCyCtrl[arrCyNo.CylinderName.GlueNGCy].Cmd.bOFF:=TRUE;//踢废胶升降气缸纠回
					IF 	arrCyCtrl[arrCyNo.CylinderName.GlueNGCy].Io	.DIOFFSwitch	THEN
						Stick_Step2:=6666;
					END_IF
		END_CASE		]]></ST>
      </Implementation>
    </Action>
    <Action Name="_03Rectifydev_Auto" Id="{25a0f6c2-d2b9-4426-bf43-1e9d04cb0311}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[
//隔膜纠偏自动
IF Mach_Control.DT_b.RectifydevStarte OR Mach_Control.U.DT_iMode=1 OR (TailCurlStep3>=150 AND TailCurlStep3<=160  AND  Mach_Control.U.WJ_iMode=1 ) THEN
	 fbRectifyGM.Execute:=TRUE;
ELSE
	fbRectifyGM.Execute:=FALSE;
END_IF
//隔膜纠偏条件
(*
//fbRectifyGM.bRecEn:= arrAxis[AxiseNo.VirAxisName.VirGM].NcToPlc.SetVelo>=0.5 AND  ABS( arrAxis[AxiseNo.AxisName.SEPTATLine].NcToPlc.ActPos  )>=24 ;    //隔膜正向运动且隔膜包角OK位置 
fbRectifyGM.bRecEn:=((( 
                                    (LREAL_TO_REAL(arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.fActPos)>arrAxisPar[AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]+1    AND   
                                     LREAL_TO_REAL(arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.fActPos)<arrAxisPar[AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]+120) OR
                                    (LREAL_TO_REAL(arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.fActPos)<arrAxisPar[AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-1    AND   
                                     LREAL_TO_REAL(arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.fActPos)>arrAxisPar[AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-110) OR
									(TailCurlStep3>=1070 AND TailCurlStep3<=1080 AND  Mach_Control.U.WJ_iMode=1)                                                           OR 
                                    (TailCurlStep3>=150 AND TailCurlStep3<=160 AND  Mach_Control.U.WJ_iMode=1) AND Par.stDT_date.iRectifyMode=2))(* OR
									 (arrAxis[AxiseNo.VirAxisName.VirGM].NcToPlc.SetVelo>=5 AND  ABS( arrAxis[AxiseNo.AxisName.SEPTATLine].NcToPlc.ActPos  )>=24)  AND Par.stDT_date.iRectifyMode=1) *) OR Mach_Control.DT_b.RectifydevStarte) AND 
									 NOT Mach_Control.DT_b.RectifydevModel   ; //隔膜正向运动且隔膜包角OK位置 
*)

//纠偏条件		
(*							 
bRectifyRule[1]:=arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.fActPos>(arrAxisPar[AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]+5)    AND   
                                     arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.fSetPos<(arrAxisPar[AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]+Par.stDT_date.iRectifyAnPos);	//隔膜纠偏条件										 
									 
bRectifyRule[2]:=arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.fActPos<(arrAxisPar[AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-5 )   AND   
                                     arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.fSetPos>(arrAxisPar[AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-Par.stDT_date.iRectifyCaPos);
*)
								 
bRectifyRule[1]:=fbCamInGMDanserMove.iTableSel=2  AND   arrAxis[AxiseNo.AxisName.SEPTATLine].Status.Moving AND
                             arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.fSetPos<(arrAxisPar[AxiseNo.AxisName.SEPTATLine].arrTargetPoint[1]+Par.stDT_date.iRectifyAnPos);	//隔膜纠偏条件										 
									 
bRectifyRule[2]:=fbCamInGMDanserMove.iTableSel=1  AND   arrAxis[AxiseNo.AxisName.SEPTATLine].Status.Moving AND
                             arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.fSetPos>(arrAxisPar[AxiseNo.AxisName.SEPTATLine].arrTargetPoint[2]-Par.stDT_date.iRectifyCaPos);	
								 
bRectifyRule[3]:=TailCurlStep3>=1070 AND TailCurlStep3<=1080 AND  Mach_Control.U.WJ_iMode=1;		
bRectifyRule[4]:=TailCurlStep3>=150 AND TailCurlStep3<=160 AND  Mach_Control.U.WJ_iMode=1 AND Par.stDT_date.iRectifyMode=2;			
				 
fbRectifyGM.bRecEn:=NOT Mach_Control.DT_b.RectifydevModel AND( bRectifyRule[1] OR bRectifyRule[2] OR bRectifyRule[3] OR bRectifyRule[4] OR An_OverNGStep=1840 OR Ca_OverNGStep=1840)
                (*AND (Mach_Control.Ca_b.Ca_Quantited<5 OR Mach_Control.Ca_b.Ca_Quantited>9*) ; 


(*				 
IF (TailCurlStep3>=150 AND TailCurlStep3<=160) OR (TailCurlStep3>=1070 AND TailCurlStep3<=1080) THEN				  				 
		fRectifyTimeAdjust1:= Par.stDT_date.fRectifyTimeAdjust ;							 							 
ELSE								 
		fRectifyTimeAdjust1:= SEL( Mach_Control.An_b.An_Quantited>=1 AND Mach_Control.Ca_b.Ca_Quantited <Par.stDT_date.Ca_Quantity AND NOT  An_OverNGMark AND NOT Ca_OverNGMark  ,5   ,Par.stDT_date.DP_fRectifyTimeAdjust )               ;								 
END_IF 								 
*)
(*
IF  Mach_Control.An_b.An_Quantited<3 OR 
	 ((An_OverNGStep>1000 OR Ca_OverNGStep>1000 )(*AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving	*)) OR 
	 (Mach_Control.Ca_b.Ca_Quantited= Par.stDT_date.Ca_Quantity  AND Mach_Control.An_b.An_Quantited= Par.stDT_date.An_Quantity)  THEN
	fRectifyTimeAdjust1:=3 ;	
ELSIF  Mach_Control.An_b.An_Quantited<4 THEN
	fRectifyTimeAdjust1:=Par.stDT_date.DP_fRectifyTimeAdjust+0.5 ;
ELSIF	(TailCurlStep3>=150 AND TailCurlStep3<=160) OR (TailCurlStep3>=1070 AND TailCurlStep3<=1080) THEN
	fRectifyTimeAdjust1:= Par.stDT_date.fRectifyTimeAdjust ;	
ELSE
	fRectifyTimeAdjust1:= Par.stDT_date.DP_fRectifyTimeAdjust ;	
END_IF									 
*)

IF (TailCurlStep3>=150 AND TailCurlStep3<=160) OR (TailCurlStep3>=1070 AND TailCurlStep3<=1080) THEN
   fRectifyTimeAdjust1:= Par.stDT_date.fRectifyTimeAdjust ;	
ELSE
	fRectifyTimeAdjust1:= Par.stDT_date.DP_fRectifyTimeAdjust ;	
END_IF										 
(*
IF Mach_Control.An_b.An_Quantited=4 AND Mach_Control.Ca_b.Ca_Quantited<>9 THEN
  fbRectifyGM.fSensorBalanceValue:=Par.stDT_date.fRectifyBalanceValue+0.7;
ELSE
  fbRectifyGM.fSensorBalanceValue:=Par.stDT_date.fRectifyBalanceValue;	
END_IF
*)									 
fbRectifyGM(
	bReset:=                      stSysState.bReset  ,  
	Execute:=                    fbRectifyGM.Execute  , 
	bCcw:=                       TRUE,//Mach_Control.DT_b.CWW , //纠偏方向选择
	iRectifyMode:=            Par.stDT_date.iRectifyMode , 
	bRecEn:=                   ,                         //纠偏容许条件
	fSensorActValue:=        Mach_Control.DT_b.RecDevPV , 
	fSensorActValue1:=       Mach_Control.DT_b.RecDevPV1 , 
	fSensorMaxValue:=       Par.stDT_date.fRectifyMaxValue , //从轴纠偏行程上限
	fSensorMinValue:=       Par.stDT_date.fRectifyMinValue , //从轴纠偏行程下限
	fSensorBalanceValue:=  Par.stDT_date.fRectifyBalanceValue,//纠偏平衡位置
	fTolerance:=                 Par.stDT_date.fRectifyfTolerance ,  //纠偏死区                        , 
	fGMLengthSet:=            Par.stDT_date.fRectifyGMLengthSet, //纠偏距离标定
	fTimeAdjust:=                fRectifyTimeAdjust1 , //纠偏时间标定
	bReady=> , 
	bAutoRunning=> , 
	Error=> , 
	Axis_Rectify1:=         arrAxis[AxiseNo.AxisName.SEPTAdeviation2] ,    
    Axis_Rectify2:=         arrAxis[AxiseNo.AxisName.SEPTAdeviation1] ,     
	//Axis_VirGM:=        arrAxis[AxiseNo.VirAxisName.VirGM] ,    
	Axis_Time:=          arrAxis[AxiseNo.VirAxisName.VirGM] ,     );   //arrAxis[AxiseNo.VirAxisName.VirTimeWind]

fbRectifyGM.bReady;
fbRectifyGM.bAutoRunning;//纠偏运行中
Mach_Control.DT_b.Error[21]:=fbRectifyGM.Error;//隔膜纠偏报警


//左右方向运动用同一个凸轮  
(*
IF  fbCamInVirGM.iTableSel=1 THEN
  fbCamInVirGM.ParCamIn.MasterScaling:=ABS(arrAxisPar[AxiseNo.AxisName.SEPTATLine] .arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.SEPTATLine] .arrTargetPoint[2])/3600;
ELSIF  fbCamInVirGM.iTableSel=2 THEN
 fbCamInVirGM.ParCamIn.MasterScaling:=-ABS(arrAxisPar[AxiseNo.AxisName.SEPTATLine] .arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.SEPTATLine] .arrTargetPoint[2])/3600;
END_IF
*)

(*
IF  fbCamInVirGM.iTableSel=1 THEN
  fbCamInVirGM.ParCamIn.MasterScaling:= (fMaxPos-fMinPos)/3600;
ELSIF  fbCamInVirGM.iTableSel=2 THEN
 fbCamInVirGM.ParCamIn.MasterScaling:=- (fMaxPos-fMinPos)/3600;
END_IF


fbCamInVirGM(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCamInVirGM.bCamInExecute, 
	iTable1:=                   TableNo.M_GMLengthCalculate_L, 
	iTable2:=                    TableNo.M_GMLengthCalculate_L, 
	iTableSel:=               fbCamInVirGM.iTableSel , 
	ParCamIn:=                , 
  	axisMaster:=            arrAxis[AxiseNo.AxisName.SEPTATLine] ,  //AxiseNo.VirAxisName.VirMain   
	axisSlave:=               arrAxis[AxiseNo.VirAxisName.VirGM] ,  // arrAxis[AxiseNo.VirAxisName.VirGM]
	bError=> , 
	bReady=> , 
	bInSync=> );

fbCamInVirGM.bError;
fbCamInVirGM.bReady;
fbCamInVirGM.bInSync;
*)


rDtUse[5](CLK:=Mach_Control.DT_b.bRecDevBtn);//隔膜检测传感器标定按钮

//隔膜打皱报警------通过判断两个传感器偏差量大小分辨
IF rDtUse[5].Q THEN
	Par.stDT_date.rRecDev:=ABS(Mach_Control.DT_b.RecDevPV-Mach_Control.DT_b.RecDevPV1);//作为基准
END_IF

IF  Mach_Control.DT_b.bTensionOK AND Mach_Control.Ca_b.Ca_Quantited>=10  AND fbRectifyGM.bRecEn THEN//张力OK	&	 已叠层数超过N层	&	纠偏允许，开始判断
	IF ABS(ABS(Mach_Control.DT_b.RecDevPV-Mach_Control.DT_b.RecDevPV1)-Par.stDT_date.rRecDev)>=Par.stDT_date.rRecDevScope THEN
		Mach_Control.DT_b.Error_tips[3]:=TRUE;//隔膜打皱
	END_IF
END_IF

Rectifydev1:=Mach_Control.DT_b.RecDevPV-Par.stDT_date.fRectifyBalanceValue;//传感器1相当于基准值的变化
Rectifydev2:=Mach_Control.DT_b.RecDevPV1-Par.stDT_date.fRectifyBalanceValue;//传感器2相当于基准值的变化
//隔膜虚轴凸轮表
(*
fbCamInVirGM(
	Reset:=                     stSysState.bReset  , 
	bCamInExecute:=      fbCamInVirGM.bCamInExecute, 
	iTableSel:=                fbCamInVirGM.iTableSel, 
	bCreatTable:=          fbCamInVirGM.bCreatTable  ,           
	iTable:=                 TableNo.M_GMVir_L , 
    arrGMVirTableData:=     arrDeltaGMLengthAbs_L   , 
	axisSlave:=            arrAxis[AxiseNo.VirAxisName.VirGM] ,  
	axisMaster:=         arrAxis[AxiseNo.AxisName.SEPTATLine] ,  
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> , 
	bReady=> , 
	bInSync=> );
fbCamInVirGM.bCreatTableDone;
fbCamInVirGM.bCreatTableError;
fbCamInVirGM.bReady;
fbCamInVirGM.bError;
fbCamInVirGM.bInSync;



//尾卷平移与隔膜虚轴齿轮耦合
fbGearInGMvir(
	Reset:=            stSysState.bReset  , 
	fratio1:=           1, 
	bError=> , 
	bReady=> , 
	InGear=> , 
	bEnable:=  fbGearInGMvirbEnable , 
	master:=  arrAxis[AxiseNo.AxisName.TailCurlLine], 
	slave1:=    arrAxis[AxiseNo.VirAxisName.VirGM] );

fbGearInGMvir.bError;
fbGearInGMvir.bReady;
fbGearInGMvir.InGear;

*)

















(*
//隔膜纠偏自动
Rectifydev_V1(
	Enable:=Rectifydev_V1.Enable, //自动启动
	RestHMI:= Sys_Control.btn.System_Rrestbtn, //报警复位
	MasterNo:=AxiseNo.VirAxisName.VirTailCurl , //主轴号,时间主轴
	SlaveNo1:=AxiseNo.AxisName.SEPTAdeviation1 , //从轴1轴号,隔膜放卷纠偏 
	SlaveNo2:=AxiseNo.AxisName.SEPTAdeviation2 , //从轴2轴号，隔膜低部纠偏
	MasterValue:=100 ,//主轴速度 
	RecDevagree:=TRUE , //纠偏允许
	RecDevEqupos:=Mach_Control.DT_b.RecDevEqupos , //纠偏传感器平衡位置
	RecDevValueSet:=Par.stDT_date.RecDevValueSet , //纠偏偏差值设置
	RecDevPV:=Mach_Control.DT_b.RecDevPV , //纠偏传感器当前值
	RecDevSpeedCoe:=Par.stDT_date.RecDevSpeedCoe , //纠偏速度系数
	CWW:=Mach_Control.DT_b.CWW , //纠偏方向选择
	AxisPos_H:=Par.stDT_date.fRectifyMaxValue , //从轴纠偏行程上限
	AxisPos_L:=Par.stDT_date.fRectifyMinValue , //从轴纠偏行程下降
	RecDevSpeed=> , //从轴的速度
	Error=> );//错误报警
	
Rectifydev_V1.RecDevSpeed;



Mach_Control.DT_b.Error[9]:= Rectifydev_V1.Error[0];//纠偏凸轮耦合失败报警
Mach_Control.DT_b.Error[10]:=Rectifydev_V1.Error[1];//纠偏左限位报警
Mach_Control.DT_b.Error[11]:=Rectifydev_V1.Error[2];//纠偏右限位报警

*)










]]></ST>
      </Implementation>
    </Action>
    <Action Name="_04Tension_Auto" Id="{b03793d8-984a-4a31-8e3a-dac90b02c90b}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[
(******************************************************隔膜张力V2**SJ*****************************************************************************************)
Mach_Control.DT_b.fWindDiameter ;//放卷轴当前卷径
//par.stDT_date.Width:=102.7;
fbTensionGM(
		bReset:=                       stSysState.bReset   , 
		bCcw:=                         fbTensionGM.bCcw , //放卷方向选择
		fDanserDegree:=          Mach_Control.DT_b.TenAnglePos, //摆杆当前角度
		PidSwitch:=                   Mach_Control.DT_b.PidSwitch , //被动放卷选择   默认为TRUE，当为FALSE时摆杆偏离平衡位置时，不进行被动放卷
		bTenExecute:=              Mach_Control.DT_b.bTenExecute , //张力启动  AND arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Io.DOStatus1
	    bStudyExecute:=           Mach_Control.DT_b.bStudyExecute , //张力学习
		
		fYDLength:=                 par.stDT_date.Width , //压力外边宽
		Ca_Quantited:=             Mach_Control.Ca_b.Ca_Quantited , 
		An_Quantited:=             Mach_Control.An_b.An_Quantited ,    
		fDancerMinPos:=           par.stDT_date.fDancerMinPos , //摆杆最小角度
		fDancerMaxPos:=          par.stDT_date.fDancerMaxPos ,  //摆杆最大角度
		fDanceBlancePos:=         par.stDT_date.fDanceBlancePos , //摆杆平衡位置
		FJ_Gemo:= 0.01, 
		fDiaMax:=220 , 
		fDiaMin:=80 , 
	    iGMMoveCount:=          Mach_Control.DT_b.TeniGMMoveCount ,//隔膜同步拉伸次数 
		
		bReady=>                        Mach_Control.DT_b.bTenReady , //张力准备好
		bTensionOK=>                 Mach_Control.DT_b.bTensionOK  , //张力OK 
		fWindDiameterTemp=>      Mach_Control.DT_b.fWindDiameter,//实时卷径
		bError=>                         Mach_Control.DT_b.Error[45],//张力报警 ???????????????
	
		Master:=                          arrAxis[AxiseNo.VirAxisName.VirDriver] , //放卷虚轴
		SlaveU:=                           arrAxis[AxiseNo.AxisName.SEPTAunwinding] , //放卷轴
		TimerAxis:=                       arrAxis[AxiseNo.VirAxisName.VirTimeWind],  //时间轴 
		Table:=                            Par.stDT_date.TensionTable , 
		Cache:=                              AxiseNo.AxisName.SEPTATCache );
	

IF NOT Mach_Control.DT_b.bTenReady AND NOT Mach_Control.DT_b.bTensionOK AND NOT Mach_Control.DT_b.bTenExecute THEN
	Mach_Control.DT_b.Error_tips[5]:=TRUE;////张力未准备好
ELSIF  Mach_Control.DT_b.bTenReady THEN
	Mach_Control.DT_b.Error_tips[5]:=FALSE ;////张力未准备好
END_IF		
		
//隔膜同步拉膜计数
rtGMMoveCount(CLK:= Mach_Control.DT_b.bTensionOK AND  NOT An_OverNGMark AND NOT Ca_OverNGMark AND
                                   arrAxis[AxiseNo.AxisName.SEPTATCache].Status.Coupled  AND
								   arrAxis[AxiseNo.AxisName.SEPTATLine].Status.Coupled AND 
                                   arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving  AND
								 (arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.ModuloSetPos>=354 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.ModuloSetPos<=359));
IF rtGMMoveCount.Q THEN
    Mach_Control.DT_b.TeniGMMoveCount:=Mach_Control.DT_b.TeniGMMoveCount+1;
	fbTensionGM.fUsedLen:=fbTensionGM.fUsedLen+par.stDT_date.Width;
		//IF NOT Blueflaging THEN
		//		Par.stDT_date.HMI_Count[1]:=Par.stDT_date.HMI_Count[1]+0.1026;//拉膜长度
		//END_IF
END_IF

(*
IF 6016<=DP_Step0 AND DP_Step0<6050 THEN
	iTargetTorqueTest:=REAL_TO_INT(Par.stDT_date.iTargetTorqueHMI*LIMIT(0.3,Par.stDT_date.HMI_CountSet[2],1)); 
ELSE
	iTargetTorqueTest:=Par.stDT_date.iTargetTorqueHMI;
END_IF
*)

rtFlgGMEndIng(CLK:=bFlgGMEndIng , Q=> );//拉膜中
ftFlgGMEndIng(CLK:=bFlgGMEndIng , Q=> );//拉膜中

IF  rtFlgGMEndIng.Q  THEN
	fGMEndSatrtPos:=arrAxis[AxiseNo.AxisName.TailCurlLine].NcToPlc.ActPos;
END_IF

IF  ftFlgGMEndIng.Q  THEN
	fGMEndLength:=arrAxis[AxiseNo.AxisName.TailCurlLine].NcToPlc.ActPos-fGMEndSatrtPos;
END_IF


Mach_Control.Ca_b.Ca_Quantited;

//一键启动张力
rTension_Start(CLK:=Mach_Control.DT_b	.rTension_Start , Q=> );


//检测隔膜换卷
rtGMBtn(CLK:=arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Io.DOStatus1 , Q=> );//涨紧
rtGMBtn2(CLK:=arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Io.DOStatus2 , Q=> );//松开

IF rtGMBtn.Q THEN  
  
	iGMCheckSetp:=10;
END_IF

IF rtGMBtn2.Q THEN    
   	bFlgGMPulling:=FALSE;
	Mach_Control.DT_b.DT_QLqr:=FALSE;
   	iWindDiameterRecord2:=Mach_Control.DT_b.fWindDiameter;
	iGMCheckSetp:=0;
END_IF



CASE iGMCheckSetp OF
	
10:
   iWindDiameterRecord1:=Mach_Control.DT_b.fWindDiameter;
   //fGMLengthRecord:=ABS( FC_AngleToLength(arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Status.fActPos,sFB_TensionGMV2_1.fWindDiameterTemp) ) ;
   iGMCheckSetp:=20; 
20:
   IF ABS(iWindDiameterRecord1-iWindDiameterRecord2) >=50 AND   Mach_Control.U.DT_iMode=3   THEN
      iGMCheckSetp:=100;
   ELSE
	  iGMCheckSetp:=666;
   END_IF
 100: 
    bFlgGMPulling:=TRUE;
	Mach_Control.DT_b.DT_QLqr:=TRUE;
    iGMCheckSetp:=110; 
110:
	IF Mach_Control.DT_b.ClearCount THEN   // OR (Mach_Control.An_b.An_Quantited=0 AND Mach_Control.Ca_b.Ca_Quantited=0 )
		    	bFlgGMPulling:=FALSE;
			Mach_Control.DT_b.DT_QLqr:=FALSE;
			iGMCheckSetp:=667;	
	END_IF
END_CASE



rDtUse[2](CLK:=Mach_Control.U.DT_iMode=1 );//AND NOT  Mach_Control.DT_b.bTensionOK 
IF rDtUse[2].Q THEN
	iTensionAutoStep:=10;
END_IF
fDtUse[2](CLK:=Mach_Control.U.DT_iMode=1 );//叠台下降沿
IF fDtUse[2].Q THEN
	iTensionAutoStep:=0;
END_IF
//自动启动时叠台自动上张力
CASE iTensionAutoStep OF//叠台自动启动时张力自动步
10:
	IF Mach_Control.DT_b.bTensionOK THEN
		iTensionAutoStep:=6666;
	ELSE
		iTensionAutoStep:=50;
	END_IF
50:
	IF NOT arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Io.DOStatus1 THEN
		 arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Io.DOStatus1:=TRUE;
	ELSE
		iTensionAutoStep:=100;
	END_IF
100:
	tDtUse[1](IN:=arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Io.DOStatus1 , PT:=T#0.5S , Q=> , ET=> );
	IF NOT arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Io.DOStatus1 THEN
		arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Cmd.bON:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Cmd.bOFF:=FALSE;
	END_IF
	IF tDtUse[1].Q THEN
		iTensionAutoStep:=200;	
	END_IF
200://开张力
	IF Mach_Control.DT_b.bTenReady THEN
		Mach_Control.DT_b.bTenExecute:=TRUE;
		iTensionAutoStep:=300;
	ELSE
		Mach_Control.DT_b.Error_tips[5]:=TRUE;////张力未准备好
	END_IF	
300:
	IF Mach_Control.DT_b.bTensionOK THEN   //张力OK 
		iTensionAutoStep:=6666;	
	END_IF
END_CASE




//卷径转换长度，单位米
 fDiameterORLength(	D1:=Mach_Control.DT_b.fWindDiameter ,
					R1:=Par.stDT_date.fInsideDiameter , 
					T1:=Par.stDT_date.SEPTA_Thickness ,
					OUT1=>Mach_Control.DT_b.fWindLength_M );



//Par.stDT_date.iTargetTorqueHMI:=REAL_TO_INT((par.stDT_date.fTenset-par.stDT_date.fTen_B)/par.stDT_date.fTen_K);


(*

//隔膜张力
sFB_TensionGMV2_1(
	bReset:=stSysState.bReset  , //复位
	bCcw:=sFB_TensionGMV2_1.bCcw , //放卷方向选择
	fDanserDegree:= Mach_Control.DT_b.TenAnglePos, //摆杆当前角度
	fWindDiameter:=Mach_Control.DT_b.fWindDiameter , //放卷轴当前卷径
	PidSwitch:=Mach_Control.DT_b.PidSwitch , //被动放卷选择   默认为TRUE，当为FALSE时摆杆偏离平衡位置时，不进行被动放卷
	bTenExecute:=Mach_Control.DT_b.bTenExecute AND arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.ONState, //张力启动
	bStudyExecute:=Mach_Control.DT_b.bStudyExecute , //张力学习
	fStudyDiameter:=par.stDT_date.fStudyDiameter  , //学习时隔膜的卷径
	fYDLength:=par.stDT_date.Width , //压力外边宽
	Ca_Quantited:=Mach_Control.Ca_b.Ca_Quantited , //压力外边宽
	fDancerMinPos:=par.stDT_date.fDancerMinPos , //摆杆最小角度
	fDancerMaxPos:=par.stDT_date.fDancerMaxPos ,  //摆杆最大角度
	fDanceBlancePos:=par.stDT_date.fDanceBlancePos , //摆杆平衡位置
	bReady=>Mach_Control.DT_b.bTenReady , //张力准备好
	bTensionOK=>Mach_Control.DT_b.bTensionOK  , //张力OK
	bError=> , 
	iGMMoveCount:=Mach_Control.DT_b.TeniGMMoveCount ,//隔膜同步拉伸次数
	fGMEndLength:=fGMEndLength,
	Master:=arrAxis[AxiseNo.VirAxisName.VirDriver] , //放卷虚轴
	Slave:=arrAxis[AxiseNo.AxisName.SEPTAunwinding] , //放卷轴
	TimerAxis:= arrAxis[AxiseNo.VirAxisName.VirTimeWind],  //时间轴
	Table:=Par.stDT_date.TensionTable  );	
	
     sFB_TensionGMV2_1.fDiameterCalculate;
	  sFB_TensionGMV2_1.fWindDiameterTemp;
	
	//隔膜同步拉膜计数
rtGMMoveCount(CLK:=        Mach_Control.DT_b.bTensionOK     AND 
      arrAxis[AxiseNo.AxisName.SEPTATCache] .Status.Coupled    AND 
          arrAxis[AxiseNo.AxisName.SEPTATLine].Status.Coupled    AND 
             arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving   AND   ( arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.ModuloSetPos>=354 AND   arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.ModuloSetPos<=359  )
 , Q=> );
IF rtGMMoveCount.Q THEN
    Mach_Control.DT_b.TeniGMMoveCount:=Mach_Control.DT_b.TeniGMMoveCount+1;
END_IF


rtFlgGMEndIng(CLK:=bFlgGMEndIng , Q=> );//拉膜中
ftFlgGMEndIng(CLK:=bFlgGMEndIng , Q=> );//拉膜中

IF  rtFlgGMEndIng.Q  THEN
	fGMEndSatrtPos:=arrAxis[AxiseNo.AxisName.TailCurlLine].NcToPlc.ActPos;
END_IF

IF  ftFlgGMEndIng.Q  THEN
	fGMEndLength:=arrAxis[AxiseNo.AxisName.TailCurlLine].NcToPlc.ActPos-fGMEndSatrtPos;
END_IF


Mach_Control.Ca_b.Ca_Quantited;

//一键启动张力
rTension_Start(CLK:=Mach_Control.DT_b	.rTension_Start , Q=> );


//检测隔膜换卷
rtGMBtn(CLK:=arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Io.DOStatus1 , Q=> );//涨紧
rtGMBtn2(CLK:=arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Io.DOStatus2 , Q=> );//松开

IF rtGMBtn.Q THEN  
  
	iGMCheckSetp:=10;
END_IF

IF rtGMBtn2.Q THEN    
   	bFlgGMPulling:=FALSE;
	Mach_Control.DT_b.DT_QLqr:=FALSE;
   	iWindDiameterRecord2:=Mach_Control.DT_b.fWindDiameter;
	iGMCheckSetp:=0;
END_IF



CASE iGMCheckSetp OF
	
10:
   iWindDiameterRecord1:=Mach_Control.DT_b.fWindDiameter;
   //fGMLengthRecord:=ABS( FC_AngleToLength(arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Status.fActPos,sFB_TensionGMV2_1.fWindDiameterTemp) ) ;
   iGMCheckSetp:=20; 
20:
   IF ABS(iWindDiameterRecord1-iWindDiameterRecord2) >=50 AND   Mach_Control.U.DT_iMode=3   THEN
      iGMCheckSetp:=100;
   ELSE
	  iGMCheckSetp:=666;
   END_IF
 100: 
    bFlgGMPulling:=TRUE;
	Mach_Control.DT_b.DT_QLqr:=TRUE;
    iGMCheckSetp:=110; 
110:
	IF Mach_Control.DT_b.ClearCount THEN   // OR (Mach_Control.An_b.An_Quantited=0 AND Mach_Control.Ca_b.Ca_Quantited=0 )
		    bFlgGMPulling:=FALSE;
			Mach_Control.DT_b.DT_QLqr:=FALSE;
			iGMCheckSetp:=667;	
	END_IF
END_CASE


(*
CASE iGMCheckSetp OF
	
10:
   iCa_QuantitedRecord:=Mach_Control.Ca_b.Ca_Quantited;
   fGMLengthRecord:=ABS( FC_AngleToLength(arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Status.fActPos,sFB_TensionGMV2_1.fWindDiameterTemp) ) ;
   iGMCheckSetp:=20; 
20:
  IF  Mach_Control.DT_b.bTensionOK  AND 
	  iCa_QuantitedRecord=Mach_Control.Ca_b.Ca_Quantited AND   
      ABS( FC_AngleToLength(arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Status.fActPos,sFB_TensionGMV2_1.fWindDiameterTemp) ) - fGMLengthRecord >=500 AND 
	  Mach_Control.U.DT_iMode=3  THEN    //处于拉膜中
        iGMCheckSetp:=100; 
  END_IF

  IF  Mach_Control.DT_b.bTensionOK  AND 
	  iCa_QuantitedRecord<>Mach_Control.Ca_b.Ca_Quantited  THEN  //只是气涨轴动作无换卷
        iGMCheckSetp:=666; 
  END_IF
  
 
 100: 
    bFlgGMPulling:=TRUE;
    iGMCheckSetp:=667; 
 
 
 

END_CASE

*)






*)













]]></ST>
      </Implementation>
    </Action>
    <Action Name="All_GoHome" Id="{e8889d8d-c288-44f7-9a22-8dfc81392818}" FolderPath="09Manual\">
      <Implementation>
        <ST><![CDATA[	f_AllGohome(CLK:=AllGohome_Hbtn ,Q=> );
	r_AllGohome(CLK:=AllGohome_Hbtn ,Q=> );	
	IF r_AllGohome.Q THEN
	AllGohomeTon[1].IN:=FALSE;
	AllGohomeTon[2].IN:=FALSE;
	AllGohomeTon[3].IN:=FALSE;
	TJIniti_Done:=FALSE;
	WZIniti_Done:=FALSE;
	Mach_Control.DT_b.DTIniti_Done:=FALSE;
	An_GohomeDone:=FALSE;
	Ca_GohomeDone:=FALSE;
	Ca_BeltGohomeDone:=FALSE;
	Step_InitCaDT0:=0;
	Step_InitAnDT:=0;
	Step_InitDT:=0;
	Step_InitCaDT:=0;
	TailCurlStep1:=0;
	StickerStep0:=0;
	AllGohomeStep:=10;
	Mach_Control.DT_b.ClearCount:=TRUE;
	END_IF	
	AllGohomeTon[1](PT:=T#10S);
	AllGohomeTon[2](PT:=T#10S);
	AllGohomeTon[3](PT:=T#5S);
	
IF Mach_Control.Ca_b.Error[19]//负极回原点超时报警
OR Mach_Control.Ca_b.Error[20]//负极皮带回原点超时报警
OR Mach_Control.An_b.Error[19]//负极回原点超时报警
OR Mach_Control. DT_b.Error[23]//叠台回原点超时报警
OR Mach_Control.WJ_b.Error[19]//尾卷回原点超时报警
OR Mach_Control.TJ_b.Error[8]  //贴胶回原超时报警
OR Step_InitCaDT0=9999 
OR Step_InitAnDT=9999 
OR Step_InitDT=9999
OR Step_InitCaDT=9999
OR TailCurlStep1=9999
OR StickerStep0=9999
THEN
	AllGohomeStep:=999;
END_IF
AllGohome_Done:=Mach_Control.WJ_b.WZIniti_Done AND Mach_Control.DT_b.DT_init_OK AND Mach_Control.Ca_b.Ca_BeltGohomeDone AND Mach_Control.TJ_b.TJIniti_Done;
CASE AllGohomeStep OF
10:
	IF f_AllGohome.Q THEN
	Mach_Control.DT_b.ClearCount:=FALSE;
	Mach_Control.WJ_b.WZIniti_Hbtn:=TRUE;
	AllGohomeStep:=20;
	END_IF
	
20:
	Mach_Control.WJ_b.WZIniti_Hbtn:=FALSE;
	AllGohomeStep:=30;

30:
	AllGohomeTon[1].IN:=TRUE;
	IF AllGohomeTon[1].Q AND Mach_Control.WJ_b.WZIniti_Done THEN
	Mach_Control.DT_b.ALLIniti_Hbtn:=TRUE;
	AllGohomeStep:=40;	
	END_IF
	
40:
	AllGohomeTon[1].IN:=FALSE;
	Mach_Control.DT_b.ALLIniti_Hbtn:=FALSE;
	AllGohomeStep:=50;	

50:
	AllGohomeTon[2].IN:=TRUE;
	IF AllGohomeTon[2].Q AND Mach_Control.DT_b.DT_init_OK THEN
	Mach_Control.Ca_b.Ca_BeltGohomeHMI:=TRUE;
	Mach_Control.TJ_b.TJIniti_Hbtn:=TRUE;
	AllGohomeStep:=60;	
	END_IF
	
60:
	AllGohomeTon[2].IN:=FALSE;
	Mach_Control.Ca_b.Ca_BeltGohomeHMI:=FALSE;
	Mach_Control.TJ_b.TJIniti_Hbtn:=FALSE;
	AllGohomeStep:=70;

70:
	AllGohomeTon[3].IN:=TRUE;
	IF AllGohomeTon[3].Q AND Mach_Control.Ca_b.Ca_BeltGohomeDone AND Mach_Control.TJ_b.TJIniti_Done THEN
	AllGohomeStep:=80;	
	END_IF	
80:
AllGohomeTon[3].IN:=FALSE;
AllGohomeStep:=888;	
END_CASE
]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_Alarm" Id="{7380cd5c-211c-453c-808e-b4cbf6b83b43}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[

//报警时间
An_AlarmTon[1](IN:= , PT:=T#80MS , Q=> , ET=> );//正极送片搬运升降有真空信号，无极片报警延时
An_AlarmTon[2](IN:= , PT:=T#80MS , Q=> , ET=> );//正极送片搬运升降有极片，无真空信号报警延时
An_AlarmTon[3](IN:= , PT:=T#150MS , Q=> , ET=> );//正极叠台搬运升降有真空信号，无极片报警延时
An_AlarmTon[4](IN:= , PT:=T#80MS , Q=> , ET=> );//正极叠台搬运升降有极片，无真空信号报警延时
An_AlarmTon[5](IN:= , PT:=T#80MS , Q=> , ET=> );//正极纠偏平台有真空信号，无极片报警延时
An_AlarmTon[6](IN:= , PT:=T#150MS , Q=> , ET=> );//正极纠偏平台有极片，无真空信号报警延时
An_AlarmTon[7](IN:= , PT:=T#80MS , Q=> , ET=> );//正极纠偏平台连续NG
An_AlarmTon[8](IN:= , PT:=T#80MS , Q=> , ET=> );
An_AlarmTon[9](IN:= , PT:=T#300MS , Q=> , ET=> );
An_AlarmTon[10](IN:= , PT:=T#400MS , Q=> , ET=> );//
An_AlarmTon[11](IN:= , PT:=T#300MS , Q=> , ET=> );//正极极片对齐度检测返回结果超时
An_AlarmTon[12](IN:= , PT:=T#400MS , Q=> , ET=> );//正极CCD纠偏平台检测返回结果超时
An_AlarmTon[13](IN:=AnCCDMark , PT:=T#50MS , Q=> , ET=> );//正极CCD纠偏平台检测返回结果超时

An_AlarmTon[15](IN:= , PT:=T#50MS , Q=> , ET=> );//正极CCD纠偏平台检测返回结果超时
An_AlarmTon[16](IN:= , PT:=T#50MS , Q=> , ET=> );//正极CCD纠偏平台检测返回结果超时
An_AlarmTon[17](IN:=NOT Mach_Control.se.AnNGboxsensor , PT:=T#5S , Q=> , ET=> );//正极NG料盒料满

rAnUse[2](CLK:=Mach_Control.An_b.An_CCDStart AND NOT   Mach_Control.An_b.Demarcateing , Q=> );
rAnUse[3](CLK:=Par.stDT_date.An_Rectifydev_Btn , Q=> );
rAnUse[4](CLK:=arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Io.DOStatus1 , Q=> );  
rAnUse[5](CLK:= NOT arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DOStatus1 , Q=> );

//Mach_Control.An_b.Error[1] :=TRUE;//正极送片搬运升降有真空信号，无极片报警
//Mach_Control.An_b.Error[2] :=TRUE;//正极送片搬运升降有极片，无真空信号报警
//Mach_Control.An_b.Error[3]:=TRUE;//正极叠台搬运升降在叠片过程中真空报警，请检查叠台是否掉片
//Mach_Control.An_b.Error[4] :=TRUE;//正极叠台搬运升降有极片，无真空信号报警
//Mach_Control.An_b.Error[5]:=TRUE;//正极纠偏平台有真空信号，无极片报警
//Mach_Control.An_b.Error[6]:=TRUE;//正极纠偏平台有极片，无真空信号报警
//Mach_Control.An_b.Error[7]:=TRUE;//纠偏CCD拍照完成IO信号未给出
//Mach_Control.An_b.Error[8]  ;//CCD标定NG
//Mach_Control.An_b.Error[9]  ;
//Mach_Control.An_b.Error[10]  ;
//Mach_Control.An_b.Error[11]:=TRUE;//正极有凸轮耦合报警
//Mach_Control.An_b.Error[12]:=TRUE;//正极NG收纳盒满料报警
//Mach_Control.An_b.Error[13];
//Mach_Control.An_b.Error[14]:=TRUE;//正极防撞感应信号报警
//Mach_Control.An_b.Error[15]
//Mach_Control.An_b.Error[16]
//Mach_Control.An_b.Error[17]
//Mach_Control.An_b.Error[18] :=TRUE;//正极CCD纠偏平台检测返回结果超时
// Mach_Control.An_b.Error[19]:=TRUE;//正极回原点超时报警
// Mach_Control.An_b.Error[20];
//Mach_Control.An_b.Error[21]:=TRUE;//正极纠偏平台连续NG
//Mach_Control.An_b.Error[22]:=TRUE;//正极叠台搬运升降真空报警，电芯上有片，请拿掉
//Mach_Control.An_b.Error[23]:=TRUE;//正极叠台搬运升降真空报警，电芯上无掉片
//Mach_Control.An_b.Error[24] ////正极纠偏平台NG片未排掉报警，请拿掉
//Mach_Control.An_b.Error[25] ////正极极片对齐度检测返回结果超时
//Mach_Control.An_b.Error[26] ////正极搬运防撞软限位报警
//Mach_Control.An_b.Error[27]//    //正极极片对齐度检测返回结果无片报警
//Mach_Control.An_b.Error[28]//正极叠片完空叠隔膜时，正极叠片搬运机械手真空有信号、标记有极片报警,请拿掉极片
//Mach_Control.An_b.Error[29]:=TRUE;		//正极初始化时正极叠片搬运升降吸盘有真空报警
//Mach_Control.An_b.Error[30]:=TRUE;		//正极初始化时正极送片搬运升降吸盘有真空报警	

//Mach_Control.An_b.Error[32]:=TRUE;//正极送片搬运在叠片过程中真空报警
//Mach_Control.An_b.Error[33]:=FALSE;//纠偏平台有片，请拿走
//Mach_Control.An_b.Error[34]:=FALSE;//正极叠台搬运平移取片时真空报警,请确认纠偏台是否掉片
//Mach_Control.An_b.Error[35]:=TRUE;//正极纠偏台NG料盒料满报警
//Mach_Control.An_b.Error[36]:=TRUE;//正极纠偏纠偏CCD返回结果超时
//Mach_Control.An_b.Error[37]:=TRUE;//正极叠台搬运升降有真空信号，无极片报警
//Mach_Control.An_b.Error[38] :=TRUE;//正极叠台搬运升降有极耳无真空报警
//Mach_Control.An_b.Error[39] :=TRUE;//正极叠台搬运升降有极耳无真空报警
//Mach_Control.An_b.Error[40] S=AnOverNGcount>=3;//正极单张踢废连续NG
//Mach_Control.An_b.Error[41] :=TRUE;//正极机械手初始化时，叠台搬运升降不在避让位
Mach_Control.An_b.Error[40] S=AnOverNGcount>=3;//正极单张踢废连续NG

//NG料盒料满报警
	IF (*Par.stDT_date.An_Rectifydev_JS>=Par.stDT_date.An_Rectifydev_NGSet OR*) An_AlarmTon[17].Q THEN
		Mach_Control.An_b.Error[35]:=TRUE;//负极纠偏台NG料盒料满报警
	ELSE
		Mach_Control.An_b.Error[35]:=FALSE;//负极纠偏台NG料盒料满报警
	END_IF
	IF rAnUse[3].Q THEN
		Par.stDT_date.An_Rectifydev_JS:=0;
	END_IF



//正极初始化时有真空报警	
	IF Mach_Control.An_b.An_GohomeHMI THEN
		IF arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Status.ONState  THEN    
			Mach_Control.An_b.Error[29]:=TRUE;		//正极初始化时正极叠片搬运升降吸盘有真空报警
		END_IF
		IF arrCyCtrl[arrCyNo.ElectValveName.	AnCarryingVacuum	].Status.ONState THEN	
			Mach_Control.An_b.Error[30]:=TRUE;		//正极初始化时正极送片搬运升降吸盘有真空报警	
		END_IF		 
	END_IF	
(*
//正极送片搬运升降真空信号与有无极片标记不一致报警
An_AlarmTon[1].IN:=arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Io.DIOnSwitch AND NOT Mach_Control.An_b.An_CarryingFalg 
	AND NOT Mach_Control.U.EmptyRunMode AND NOT Mach_Control.An_b.Error[2]  AND NOT Blueflaging AND Mach_Control.U.DT_iMode=1;
		IF  An_AlarmTon[1].Q THEN
				Mach_Control.An_b.Error[1] :=TRUE;//正极送片搬运升降有真空信号，无极片报警
		END_IF
*)
//正极送片搬运升降有极片，无真空信号报警------取片过程中真空报警判断
An_AlarmTon[2].IN:=NOT arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Io.DIOnSwitch AND  Mach_Control.An_b.An_CarryingFalg  AND
	 arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[2]-5) 
	AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.NoMoving AND NOT Mach_Control.U.EmptyRunMode ;
	IF  An_AlarmTon[2].Q THEN
			Mach_Control.An_b.Error[2] :=TRUE;//正极送片搬运升降有极片，无真空信号报警
			(*
			Mach_Control.An_b.An_CarryingFalg:=FALSE;
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;//正极搬运升降取料真空关
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;//正极搬运升降取料真空关
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极搬运升降取料破真空开
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极搬运升降取料破真空开
			*)
	END_IF
IF 	Mach_Control.An_b.Error[2]AND arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Io.DIOnSwitch AND  rAn_AlarmRest.Q  THEN
	Mach_Control.An_b.Error[2] :=FALSE;//正极送片搬运升降有极片，无真空信号报警
ELSIF Mach_Control.An_b.Error[2]AND NOT arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Io.DIOnSwitch AND  rAn_AlarmRest.Q  THEN
	arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;//正极搬运升降取料真空关
	arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;//正极搬运升降取料真空关
	arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极搬运升降取料破真空开
	arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极搬运升降取料破真空开
	An_StandbyStep1:=0;
	An_Step0:=0;
	An_Step1:=0;
	An_Step2:=0;
	An_Step3:=0;
	Mach_Control.An_b.Error[2] :=FALSE;//正极送片搬运升降有极片，无真空信号报警
	Mach_Control.An_b.An_CarryingFalg:=FALSE;
END_IF
	
	
	
	
	
//正极送片搬运在叠片过程中的真空信号判断
	An_AlarmTon[15].IN:=NOT arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Io.DIOnSwitch AND  Mach_Control.An_b.An_CarryingFalg 
	AND NOT Mach_Control.U.EmptyRunMode AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Moving	  
	 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<232 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>1   ;
	IF  An_AlarmTon[15].Q THEN
		CCD.AnRec.Finish.RectifyResult:=0;
		Mach_Control.An_b.Error[32] :=TRUE;//正极送片搬运升降有极片，无真空信号报警
		Mach_Control.An_b.An_CarryingFalg:=FALSE;
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;//正极搬运升降取料真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;//正极搬运升降取料真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极搬运升降取料破真空开
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极搬运升降取料破真空开
	END_IF
	IF Mach_Control.An_b.Error[32] AND rAn_AlarmRest.Q   THEN
		//CCD.AnRec.Finish.RectifyResult:=0;
		CCD.AnRec.Start.iPhotoDo:=1;//第二次拍照
		Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
	END_IF
	IF Mach_Control.An_b.Error[32] AND (CCD.AnRec.Finish.RectifyResult=3  OR  Mach_Control.U.CCD_ChosesHMI) AND rAn_AlarmRest.Q  THEN
		Mach_Control.An_b.Error[32]:=FALSE;
		Mach_Control.An_b.Error[33]:=FALSE;//纠偏平台有片，请拿走
	END_IF
	IF Mach_Control.An_b.Error[32] AND (CCD.AnRec.Finish.RectifyResult<>3  AND NOT   Mach_Control.U.CCD_ChosesHMI)THEN
		Mach_Control.An_b.Error[33]:=TRUE;//纠偏平台有片，请拿走
	END_IF
	
	
	
	
	
//正极叠片搬运升降真空信号与有无极片标记不一致报警
An_AlarmTon[3].IN:=(arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch OR Mach_Control.se.AnDTCarryingJROnSwitch)
    AND NOT Mach_Control.An_b.An_DPCarryingFalg AND Mach_Control.U.DT_iMode=1 
	AND NOT Mach_Control.U.EmptyRunMode AND (An_Step2=0 OR An_Step2=6666) AND NOT Mach_Control.An_b.Error[4] AND iEmptyFoldStep[1]=0 
	AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[2]-5)  
	AND DP_Step0<1000 AND DP_Step0>3100;
	IF  An_AlarmTon[3].Q THEN
		IF arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch THEN
			Mach_Control.An_b.Error[3]:=TRUE;//正极叠台搬运升降有真空信号，无极片报警
		END_IF
        IF 	Mach_Control.se.AnDTCarryingJROnSwitch THEN
			Mach_Control.An_b.Error[37]:=TRUE;//正极叠台搬运升降有真空信号，无极片报警
		END_IF
	END_IF

	
//正极叠台搬运升降有极片，无真空信号报警-------叠片搬运平移取片过程真空检测
An_AlarmTon[16].IN:=(NOT arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch OR NOT Mach_Control.se.AnDTCarryingJROnSwitch)
     AND  Mach_Control.An_b.An_DPCarryingFalg  AND (An_Step2=0 OR An_Step2=6666) AND
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[2]-5)  
	AND  arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.NoMoving AND NOT Mach_Control.U.EmptyRunMode AND iEmptyFoldStep[1]=0 
	AND (DP_Step0<1000 OR DP_Step0>3100)  ;//
	IF  An_AlarmTon[16].Q THEN
		//CCD.AnRec.Finish.RectifyResult:=0;//拍照结果清零
		IF NOT arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch THEN
		   Mach_Control.An_b.Error[34] :=TRUE;//正极叠台搬运升降有极片，无真空信号报警
		END_IF  
		IF NOT Mach_Control.se.AnDTCarryingJROnSwitch THEN
           Mach_Control.An_b.Error[39] :=TRUE;//正极叠台搬运升降有极耳无真空报警
        END_IF   
		Mach_Control.An_b.An_DPCarryingFalg:=FALSE;
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运升降真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运升降真空关
		//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运破真空开
		//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极叠片搬运破真空关
	END_IF
//叠台搬运平移在取片过程中报警时，纠偏平台拍照有无片来确定是否掉片到纠偏平台
	IF (Mach_Control.An_b.Error[34] OR Mach_Control.An_b.Error[39]) AND rAn_AlarmRest.Q  THEN
		//CCD.AnRec.Finish.RectifyResult:=0;//拍照结果清零
		Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
		CCD.AnRec.Start.iPhotoDo:=1;//启动CCD第二次拍照
	END_IF
	IF (Mach_Control.An_b.Error[34] OR Mach_Control.An_b.Error[39]) AND (CCD.AnRec.Finish.RectifyResult=3  OR  Mach_Control.U.CCD_ChosesHMI) AND rAn_AlarmRest.Q  THEN
		Mach_Control.An_b.Error[34]:=FALSE;//叠台升降取片过程中真空报警，
		Mach_Control.An_b.Error[39]:=FALSE;//叠台升降取片过程中真空报警，
		Mach_Control.An_b.Error[33]:=FALSE;//纠偏平台有片，请拿走
	ELSIF( Mach_Control.An_b.Error[34] OR Mach_Control.An_b.Error[39]) AND (CCD.AnRec.Finish.RectifyResult<>3  AND NOT   Mach_Control.U.CCD_ChosesHMI)THEN
		Mach_Control.An_b.Error[33]:=TRUE;//纠偏平台有片，请拿走
	END_IF
	






	
	
//正极叠台搬运升降有极片，无真空信号报警-------叠片搬运平移叠片过程真空检测
An_AlarmTon[4].IN:=(NOT arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch OR NOT Mach_Control.se.AnDTCarryingJROnSwitch)
     AND  Mach_Control.An_b.An_DPCarryingFalg  AND (An_Step2=0 OR An_Step2=6666) AND
	 arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<232 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>1  AND NOT Mach_Control.U.EmptyRunMode
	AND  arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Moving	 ;//
	IF  An_AlarmTon[4].Q THEN
		//Mach_Control.DT_b.OverhandResult:=0;
		IF NOT arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch THEN
		  Mach_Control.An_b.Error[4] :=TRUE;//正极叠台搬运升降有极片，无真空信号报警
	    END_IF
		IF  NOT Mach_Control.se.AnDTCarryingJROnSwitch THEN
		  Mach_Control.An_b.Error[38] :=TRUE;//正极叠台搬运升降有极耳无真空报警
		END_IF
		An_Number:=TRUE;
		Mach_Control.An_b.An_DPCarryingFalg:=FALSE;
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运升降真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运升降真空关
		//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运破真空开
		//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极叠片搬运破真空关
	END_IF
	
	//正极叠台搬运升降真空报警，电芯上有片，请拿掉
	An_AlarmTon[8].IN:=(Mach_Control.An_b.Error[4] OR Mach_Control.An_b.Error[38]) AND Mach_Control.DT_b.OverhandResult<>3 AND NOT Mach_Control.U.CCD_ChosesHMI ;
	IF  An_AlarmTon[8].Q THEN
		Mach_Control.An_b.Error[22]:=TRUE;//正极叠台搬运升降真空报警，电芯上有片，请拿掉
	END_IF
	IF fAn_AlarmRest.Q AND  Mach_Control.An_b.Error[22] AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<1  THEN
		Mach_Control.DT_b.OverhandResult:=0;
		CCD.Over.Start.iPhotoDo:=2;
		Mach_Control.DT_b.CDD_OverStart:=TRUE;
	END_IF

	IF Mach_Control.An_b.Error[22] AND Mach_Control.DT_b.OverhandResult=3  AND rAn_AlarmRest.Q THEN
		Mach_Control.An_b.Error[22]:=FALSE;//复位电芯有片报警
		Mach_Control.DT_b.OverhandResult:=0;
	END_IF
	
	//正极叠台搬运升降真空报警，电芯上无掉片
	An_AlarmTon[9].IN:=(Mach_Control.An_b.Error[4] OR Mach_Control.An_b.Error[38] )AND Mach_Control.DT_b.OverhandResult=3 AND NOT Mach_Control.U.CCD_ChosesHMI ;
	IF  An_AlarmTon[9].Q THEN
		Mach_Control.An_b.Error[23]:=TRUE;//正极叠台搬运升降真空报警，电芯上无掉片
	END_IF

	
	

//正极纠偏平台真空信号与有无极片标记不一致报警
An_AlarmTon[5].IN:=arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Io.DIOnSwitch AND NOT Mach_Control.An_b.An_deviationFalg 
	AND NOT Mach_Control.U.EmptyRunMode AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed 
	AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[4]+5) 
	AND iEmptyFoldStep[1]=0 AND (DP_Step0<1000 OR DP_Step0>3100) ;
	IF  An_AlarmTon[5].Q THEN
		Mach_Control.An_b.Error[5]:=TRUE;//正极纠偏平台有真空信号，无极片报警
	END_IF

//正极纠偏平台有极片，无真空信号报警
An_AlarmTon[6].IN:=NOT arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Io.DIOnSwitch AND Mach_Control.An_b.An_deviationFalg 
	AND NOT Mach_Control.U.EmptyRunMode AND	arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed  
	AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[4]+5) 
	AND iEmptyFoldStep[1]=0 AND (DP_Step0<1000 OR DP_Step0>3100) AND NOT Mach_Control.An_b.An_VacuumErrorNG ;
	IF An_AlarmTon[6].Q  THEN
		Mach_Control.An_b.Error[6]:=TRUE;//正极纠偏平台有极片，无真空信号报警
		Mach_Control.An_b.An_VacuumErrorNG:=TRUE;//正极抛真空NG料标志
	END_IF

//正极纠偏平台连续NG
An_AlarmTon[7].IN:=Mach_Control.An_b.An_CCD_amount>=3 AND NOT Mach_Control.An_b.Error[21] AND NOT Mach_Control.U.CCD_ChosesHMI ;
	IF  An_AlarmTon[7].Q THEN
			Mach_Control.An_b.Error[21]:=TRUE;//正极纠偏平台连续NG
	END_IF	
//
IF Mach_Control.An_b.Error[24] AND CCD.AnRec.Finish.RectifyResult=3  AND rAn_AlarmRest.Q THEN
	Mach_Control.An_b.Error[24]:=FALSE;
END_IF
IF fAn_AlarmRest.Q AND Mach_Control.An_b.Error[24] AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<1  THEN	
	CCD.AnRec.Start.iPhotoDo:=1;//第二次拍照
	Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
END_IF

//正极取片报警复位
rAn_AlarmRest(CLK:=Sys_Control.btn.System_Rrestbtn , Q=> );//正极报警复位上升沿
fAn_AlarmRest(CLK:=Sys_Control.btn.System_Rrestbtn , Q=> );//正极报警复位下降沿
IF Mach_Control.U.DT_iMode=3 THEN//在手动状态下，复位报警
	
		//IF Mach_Control.An_b.Error[2] AND rAn_AlarmRest.Q THEN
				//Mach_Control.An_b.An_CarryingFalg :=FALSE;
		//END_IF
		
		IF (Mach_Control.An_b.Error[4] OR Mach_Control.An_b.Error[38]) AND rAn_AlarmRest.Q THEN
				Mach_Control.An_b.An_DPCarryingFalg:=FALSE;
		END_IF
//20240105临时屏蔽	
(*		IF Mach_Control.An_b.Error[6] AND rAn_AlarmRest.Q  THEN
				Mach_Control.An_b.An_deviationFalg :=FALSE;
		END_IF
*)		
		IF Mach_Control.An_b.Error[21] AND rAn_AlarmRest.Q  THEN
				Mach_Control.An_b.An_CCD_amount:=0;
		END_IF
																		//20240105临时屏蔽	
		IF ((Mach_Control.An_b.Error[2] AND NOT Mach_Control.An_b.An_CarryingFalg)OR Mach_Control.An_b.Error[4] OR Mach_Control.An_b.Error[38] (*OR Mach_Control.An_b.Error[6]*)) AND rAn_AlarmRest.Q  THEN
				An_StandbyStep1:=0;
				An_Step0:=0;
				An_Step1:=0;
				An_Step2:=0;
				An_Step3:=0;
		END_IF
		
		IF fAn_AlarmRest.Q AND NOT Mach_Control.An_b.Error[22]  AND NOT Mach_Control.An_b.Error[2] 
			AND NOT Mach_Control.An_b.Error[4] AND NOT Mach_Control.An_b.Error[24] 
			AND NOT Mach_Control.An_b.Error[32]  AND NOT Mach_Control.An_b.Error[34]
            AND NOT Mach_Control.An_b.Error[38] AND NOT Mach_Control.An_b.Error[39] THEN
				MEMSET(ADR(Mach_Control.An_b.Error),0,SIZEOF(Mach_Control.An_b.Error)); // 正极取片报警复位	
				//AnOverNGcount:=0;
				arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bStop:=FALSE;
		END_IF		
	
			IF AnOverNGcount>= 3 AND fAn_AlarmRest.Q THEN
		    	AnOverNGcount:=0;
		   END_IF	
		
		IF Mach_Control.An_b.An_DTqr AND Mach_Control.An_b.Error[2] THEN
			 	Mach_Control.An_b.Error[2] :=FALSE;
				Mach_Control.An_b.An_CarryingFalg :=FALSE;
		END_IF
		
		IF Mach_Control.An_b.An_DTqr AND  (Mach_Control.An_b.Error[4] OR Mach_Control.An_b.Error[38]) THEN
			 	Mach_Control.An_b.Error[4] :=FALSE;
				Mach_Control.An_b.Error[38] :=FALSE;
				Mach_Control.An_b.An_DPCarryingFalg:=FALSE;
		END_IF
		
		IF (Mach_Control.An_b.Error[7] OR An_StandbyStep0=9999) AND fAn_AlarmRest.Q THEN
				Mach_Control.An_b.Error[7] :=FALSE;
				An_StandbyStep0:=0;
		END_IF
		
		IF fAn_AlarmRest.Q THEN
				IF 9991<=An_StandbyStep1 AND An_StandbyStep1<=10000 THEN
						An_StandbyStep1:=1000;
						An_Step0:=0;
						An_Step1:=0;
						An_Step2:=0;
						An_Step3:=0;
				END_IF
		END_IF
END_IF

     An_dppy_Xzb:=arrAxisPar[AxiseNo.AxisName.AnCarryingLine].arrTargetPoint[2]+arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.fActPos;

    IF An_Step3=30 AND NOT arrAxis[AxiseNo.AxisName.AnDTCarryingLine].Status.Coupled AND  NOT arrAxis[AxiseNo.AxisName.AnCarryingLine].Status.Coupled   AND   arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving 
		  AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.Homed AND NOT  arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.arrbRealPoint[1]
          AND ABS((arrAxisPar[AxiseNo.AxisName.AnCarryingLine].arrTargetPoint[2]+arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Status.fActPos)-arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Status.fActPos)
            <(ABS(arrAxisPar[AxiseNo.AxisName.AnCarryingLine].arrTargetPoint[2]-arrAxisPar[AxiseNo.AxisName.AnCarryingLine].arrTargetPoint[1])+arrAxisPar[AxiseNo.AxisName.AnDTCarryingLine].arrTargetPoint[1]-20) THEN
	   Mach_Control.An_b.Error[26]:=TRUE;//正极搬运防撞软限位报警
	END_IF
	
	AnError_r(CLK:= Mach_Control.An_b.Error[26] , Q=> );
	IF AnError_r.Q THEN 
	   arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bStop:=TRUE;
       arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bStop :=TRUE;
	 END_IF
	 
	IF  P2M2_sysControl.btn.System_Rrestbtn THEN
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingLine].Cmd.bStop:=FALSE;
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.bStop :=FALSE;
	END_IF

	
//空叠隔膜时检查叠台升降有没有片
IF Mach_Control.U.DT_iMode=3 THEN//在手动状态下，复位报警	
		IF  Mach_Control.An_b.Error[28] AND DP_Step0=2070 AND rAn_AlarmRest.Q  THEN
				Mach_Control.An_b.An_DPCarryingFalg:=FALSE;
		END_IF
END_IF

//ccdJ拍照检测返回结果超时报警
rAnCCDStart(CLK:=Mach_Control.An_b.An_CCDStart , Q=> );
IF rAnCCDStart.Q THEN
  	 AnCCDMark:=TRUE;
END_IF
 
IF AnCCDMark AND CCD.AnRec.Finish.RectifyResult=0  AND NOT Mach_Control.U.CCD_ChosesHMI THEN
		IF NOT An_AlarmTon[12].Q THEN
			An_AlarmTon[12].IN:=TRUE;
		ELSE
			Mach_Control.An_b.Error[18] :=TRUE;//正极CCD纠偏平台检测返回结果超时
			AnCCDMark :=FALSE;
		END_IF
ELSE
		An_AlarmTon[12].IN:=FALSE;
END_IF

IF (Mach_Control.An_b.Error[18] AND Sys_Control.btn.System_Rrestbtn) OR
	   (CCD.AnRec.Finish.RectifyResult<>0 AND  AnCCDMark  AND An_AlarmTon[13].Q  ) THEN
	   AnCCDMark :=FALSE;
	   An_AlarmTon[12].IN:=FALSE;
END_IF

IF Mach_Control.U.DT_iMode=1 AND  rAnUse[4].Q THEN
 Par.stDT_date.An_sucker1_JS :=Par.stDT_date.An_sucker1_JS+1;
END_IF

IF( HMI_Hour>=7  AND HMI_Hour<9) OR (HMI_Hour>=19  AND HMI_Hour<21) THEN
      IF Par.stDT_date.An_sucker1_JS>=Par.stDT_date.An_sucker1Set THEN
	      Mach_Control.An_b.Error[42]:=TRUE;//正极送片搬运吸盘计数到达设定值
      END_IF
END_IF
IF Mach_Control.DT_b.An_sucker1_JSclear THEN
   Par.stDT_date.An_sucker1_JS:=0;
END_IF  

IF Mach_Control.U.DT_iMode=1 AND  rAnUse[5].Q THEN
 Par.stDT_date.An_sucker2_JS  :=Par.stDT_date.An_sucker2_JS +1;
END_IF

IF( HMI_Hour>=7  AND HMI_Hour<9) OR (HMI_Hour>=19  AND HMI_Hour<21) THEN
      IF Par.stDT_date.An_sucker2_JS >=Par.stDT_date.An_sucker2Set  THEN
	      Mach_Control.An_b.Error[43]:=TRUE;//正极叠台搬运吸盘计数到达设定值
      END_IF
END_IF
IF Mach_Control.DT_b.An_sucker2_JSclear THEN
   Par.stDT_date.An_sucker2_JS:=0;
END_IF  
(*
IF An_CCDNG>=10 THEN
		Mach_Control.An_b.Error[12]:=TRUE;//正极NG收纳盒满料报警
END_IF

IF Mach_Control.An_b.Error[12] AND P2M2_sysControl.btn.System_Rrestbtn THEN
		 Mach_Control.An_b.Error[12]:=FALSE;
		 An_CCDNG:=0;
END_IF

*)


]]></ST>
      </Implementation>
    </Action>
    <Action Name="An_Cam" Id="{4718e708-5694-4d78-8b37-071e13301154}" FolderPath="02An_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[An_Cam_ton[1](PT:=T#100MS);
An_Cam_ton[2](PT:=T#100MS);
An_Cam_ton[3](PT:=T#100MS);
An_Cam_ton[4](PT:=T#100MS);
An_Cam_ton[5](PT:=T#100MS);

