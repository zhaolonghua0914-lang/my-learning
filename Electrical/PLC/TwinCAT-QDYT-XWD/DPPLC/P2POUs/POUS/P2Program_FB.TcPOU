AND NOT  arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[2]) 
AND  arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.fActPos<=arrAxisPar[AxiseNo.AxisName.LCurlingneedleLine].arrTargetPoint[1]+1 AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed  
AND  arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.fActPos <=arrAxisPar[AxiseNo.AxisName.SCurlingneedleLine] .arrTargetPoint[1]+1 AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed 
