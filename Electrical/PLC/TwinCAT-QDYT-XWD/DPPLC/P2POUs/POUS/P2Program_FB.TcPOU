    fbCrectCamLeftYDUpDown2             :FB_CrectCamYaDaoUpDown2 ;	 
	fbCrectCamRightYDLine2              :FB_CrectCamYaDaoLine2_V2;
	fbCrectCamRightYDUpDown2            :FB_CrectCamYaDaoUpDown2 ;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//负极备极片自动程序
Ca_Alarm();//负极报警
Ca_Conditions();//负极安全条件
Ca_Cam();//负极凸轮
Ca_Gohome();//负极回原点
Ca_StandbyMain();//负极备极片主程序
Ca_StandbyMain2();//负极备极片主程序
Ca_StandbySub1();//负极取流水线极片子程序
Ca_StandbySub2();//负极放纠偏极片子程序
Ca_StandbySub3();//负极踢NG料子程序
Ca_StandbySub4();//负极取纠偏极片子程序
Ca_Cahebelt();//负极皮带缓存自动
Ca_Rectifydev();//负极纠偏自动
//Par.iModeEN.DT_CCD_TwoModelEN;
//正椎备极片自动程序
An_Alarm();//正极报警
An_Conditions();//正极安全条件
An_Cam();//正极凸轮
An_Gohome();//正极取片回原点
An_StandbyMain();//正极备极片主程序
An_StandbyMain2();//正极备极片主程序
An_StandbySub1();//正极取流水线极片子程序
An_StandbySub2();//正极放纠偏极片子程序
An_StandbySub3();//正极踢NG料子程序
An_StandbySub4();//正极取纠偏极片子程序
An_Rectifydev();//正极纠偏自动

//叠台自动程序
_01_DT_Product();
DT_Condition();
DT_Alarm();//报警
GMBufferLengthCalculate();//隔膜级存计算
GMBufferCam();//隔膜缓存凸轮生成
Dietai_Cam();//压刀凸轮
Dietai_Gohome();//叠台轴回原点
_01DT_Auto();
_01DT_Auto2();
_01DT_Auto3();
_01DT_Auto4();
_01DT_Auto5();
_01DT_AutoSub1_CamOut();
_02BlueGlue_Auto();
_03Rectifydev_Auto();
_04Tension_Auto();
An_OverNG();
Ca_OverNG();
GMEmptyFold1();
GMEmptyFold2();
GMEmptyFold3();
ModeENLimk();
MotionCoe_Write();
//尾卷自动程序
TailCurl_Alarm();//报警
TailCurl_Condition();//尾卷安全条件
TailCurl_Gohome();//尾卷回原点
TailCurlCam();//尾卷凸轮
TailCurl_Auto1();//尾卷上、下电芯自动
TailCurl_Auto2();//尾卷卷电芯自动
Tailcurl_Auto_CamOut();//尾卷凸轮解耦



//贴胶程序
Sticker_Alarm();//报警
Stick_Condition();//贴胶安全条件
Sticker_Gohome();//贴胶回原点


_01Sticker_Auto();//贴胶自动程序
_02Sticker_Auto();//备胶自动程序
_02Sticker_AutoSbu1_Scan();//二维码胶扫码自动子程序
_02Sticker_AutoSbu2_NG();//二维码胶扫码NG胶踢胶子程序
Code();//二维码Tcp通讯





Manual();
P2_Init();
Vacuum_Signal();

All_GoHome();
TorqueCheckAlarm();
AA1;

]]></ST>
    </Implementation>
    <Folder Name="01Ca_StandbyAuto" Id="{23b83efb-7dfd-4a78-b883-6e66a920a366}" />
    <Folder Name="02An_StandbyAuto" Id="{cd5ab33c-33e7-4b5c-8ae6-7029009be8e4}" />
    <Folder Name="03DietaiAuto" Id="{d691fe72-5e60-4a5b-b59f-986c068f3230}" />
    <Folder Name="04TailCurl" Id="{2d9db1f1-19fa-4c26-89dd-b20d2ed7b54c}" />
    <Folder Name="05StickGlue " Id="{29a0655a-3855-4f98-9d33-b2ed047c9bf4}" />
    <Folder Name="08Init" Id="{6fa67d42-18b3-4851-a9c4-3c5268a1855f}" />
    <Folder Name="09Manual" Id="{4145ec0d-cf08-4bcc-9adf-a26451aaf092}" />
    <Action Name="_01_DT_Product" Id="{6d643b7b-5b40-48fa-8a21-a59030b56bac}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[
//电芯数清零
IF Mach_Control.DT_b.DT_amount_clear THEN
	Mach_Control.DT_b.DT_amount:=0;
	Mach_Control.DT_b.DT_amount_clear:=FALSE;
END_IF


//对齐度NG统计
         rOverhangNG(CLK:=Mach_Control.DT_b.Overhang_TF , Q=> );
//白班 踢对齐度NG数/总叠片数		 
(*         IF HMI_Hour>=8 AND HMI_Hour<20 THEN
			 IF rOverhangNG.Q AND NOT  Mach_Control.U.EmptyRunMode AND Mach_Control.DT_b.DT_Oerhang_Z=2 THEN
				Mach_Control.DT_b.DT_DayHough :=Mach_Control.DT_b.DT_DayHough+(UINT_TO_REAL(Par.stDT_date.DT_Overhang_SUM)*2/(UINT_TO_REAL(Par.stDT_date.An_Quantity)+UINT_TO_REAL(Par.stDT_date.Ca_Quantity))); 
				Mach_Control.DT_b.DT_DayHough_U :=Mach_Control.DT_b.DT_DayHough_U+1;
			 END_IF
		 END_IF
		 *)
        IF HMI_Hour>=8 AND HMI_Hour<20 THEN
			 IF rOverhangNG.Q AND NOT  Mach_Control.U.EmptyRunMode AND NOT Blueflaging  THEN
				Mach_Control.DT_b.DT_DayHough :=Mach_Control.DT_b.DT_DayHough+UINT_TO_REAL(Mach_Control.An_b.An_Quantited(*+Mach_Control.Ca_b.Ca_Quantited*))/(UINT_TO_REAL(Par.stDT_date.An_Quantity)(*+UINT_TO_REAL(Par.stDT_date.Ca_Quantity)*)); //JR
				Mach_Control.DT_b.DT_DayHoughAn:=Mach_Control.DT_b.DT_DayHoughAn+UINT_TO_REAL(Mach_Control.An_b.An_Quantited); 
				Mach_Control.DT_b.DT_DayHoughCa:=Mach_Control.DT_b.DT_DayHoughCa+UINT_TO_REAL(Mach_Control.Ca_b.Ca_Quantited); 
				Mach_Control.DT_b.DT_DayHough_U :=Mach_Control.DT_b.DT_DayHough_U+1;
			 END_IF
		 END_IF
        IF HMI_Hour>=8 AND HMI_Hour<20 THEN
			 IF rOverhangNG.Q AND NOT  Mach_Control.U.EmptyRunMode AND Blueflaging  THEN
				Mach_Control.DT_b.DTJD_DayHough :=Mach_Control.DT_b.DTJD_DayHough+UINT_TO_REAL(Mach_Control.An_b.An_Quantited(*+Mach_Control.Ca_b.Ca_Quantited*))/(UINT_TO_REAL(Par.stDT_date.An_Quantity)(*+UINT_TO_REAL(Par.stDT_date.Ca_Quantity)*)); //JR
				Mach_Control.DT_b.DTJD_DayHoughAn:=Mach_Control.DT_b.DTJD_DayHoughAn+UINT_TO_REAL(Mach_Control.An_b.An_Quantited); 
				Mach_Control.DT_b.DTJD_DayHoughCa:=Mach_Control.DT_b.DTJD_DayHoughCa+UINT_TO_REAL(Mach_Control.Ca_b.Ca_Quantited); 
				Mach_Control.DT_b.DTJD_DayHough_U :=Mach_Control.DT_b.DTJD_DayHough_U+1;
			 END_IF
		 END_IF
//晚班 踢对齐度NG数/总叠片数		  
(*		IF ((HMI_Hour>=0 AND HMI_Hour<8) OR  (HMI_Hour>=20 AND HMI_Hour<=23))AND NOT  Mach_Control.U.EmptyRunMode THEN
			 IF rOverhangNG.Q THEN
			   Mach_Control.DT_b.DT_NightHough:=Mach_Control.DT_b.DT_NightHough+(UINT_TO_REAL(Par.stDT_date.DT_Overhang_SUM)*2/(UINT_TO_REAL(Par.stDT_date.An_Quantity)+UINT_TO_REAL(Par.stDT_date.Ca_Quantity)));
               Mach_Control.DT_b.DT_NightHough_U :=Mach_Control.DT_b.DT_NightHough_U+1; 
			 END_IF
		 END_IF 
		 *)
        IF ((HMI_Hour>=0 AND HMI_Hour<8) OR  (HMI_Hour>=20 AND HMI_Hour<=23)) THEN
			 IF rOverhangNG.Q AND NOT  Mach_Control.U.EmptyRunMode AND NOT Blueflaging THEN
				Mach_Control.DT_b.DT_NightHough :=Mach_Control.DT_b.DT_NightHough+UINT_TO_REAL(Mach_Control.An_b.An_Quantited(*+Mach_Control.Ca_b.Ca_Quantited*))/(UINT_TO_REAL(Par.stDT_date.An_Quantity)(*+UINT_TO_REAL(Par.stDT_date.Ca_Quantity)*)); 
				Mach_Control.DT_b.DT_NightHoughAn:=Mach_Control.DT_b.DT_NightHoughAn+UINT_TO_REAL(Mach_Control.An_b.An_Quantited); 
				Mach_Control.DT_b.DT_NightHoughCa:=Mach_Control.DT_b.DT_NightHoughCa+UINT_TO_REAL(Mach_Control.Ca_b.Ca_Quantited); 
				Mach_Control.DT_b.DT_NightHough_U :=Mach_Control.DT_b.DT_NightHough_U+1;
			 END_IF
		 END_IF		
        IF ((HMI_Hour>=0 AND HMI_Hour<8) OR  (HMI_Hour>=20 AND HMI_Hour<=23)) THEN
			 IF rOverhangNG.Q AND NOT  Mach_Control.U.EmptyRunMode AND Blueflaging THEN
				Mach_Control.DT_b.DTJD_NightHough :=Mach_Control.DT_b.DTJD_NightHough+UINT_TO_REAL(Mach_Control.An_b.An_Quantited(*+Mach_Control.Ca_b.Ca_Quantited*))/(UINT_TO_REAL(Par.stDT_date.An_Quantity)(*+UINT_TO_REAL(Par.stDT_date.Ca_Quantity)*)); 
				Mach_Control.DT_b.DTJD_NightHoughAn:=Mach_Control.DT_b.DTJD_NightHoughAn+UINT_TO_REAL(Mach_Control.An_b.An_Quantited); 
				Mach_Control.DT_b.DTJD_NightHoughCa:=Mach_Control.DT_b.DTJD_NightHoughCa+UINT_TO_REAL(Mach_Control.Ca_b.Ca_Quantited); 
				Mach_Control.DT_b.DTJD_NightHough_U :=Mach_Control.DT_b.DTJD_NightHough_U+1;
			 END_IF
		 END_IF 
//白班对齐度NG数清零	
        IF DayClear1.Q THEN
			Mach_Control.DT_b.DT_DayHough :=0;
			Mach_Control.DT_b.DT_DayHoughAn:=0;
			Mach_Control.DT_b.DT_DayHoughCa:=0;
			Mach_Control.DT_b.DT_DayHough_U :=0;
			Mach_Control.DT_b.DTJD_DayHough :=0;
			Mach_Control.DT_b.DTJD_DayHoughAn:=0;
			Mach_Control.DT_b.DTJD_DayHoughCa:=0;
			Mach_Control.DT_b.DTJD_DayHough_U :=0;
		END_IF
//晚班对齐度NG数清零	
        IF  NightClear1.Q THEN
			Mach_Control.DT_b.DT_NightHough :=0;
			Mach_Control.DT_b.DT_NightHoughAn:=0;
			Mach_Control.DT_b.DT_NightHoughCa:=0;
			Mach_Control.DT_b.DT_NightHough_U :=0;
			Mach_Control.DT_b.DTJD_NightHough :=0;
			Mach_Control.DT_b.DTJD_NightHoughAn:=0;
			Mach_Control.DT_b.DTJD_NightHoughCa:=0;
			Mach_Control.DT_b.DTJD_NightHough_U :=0;
		END_IF		
		
//对齐度NG下料时间		
        Mach_Control.DT_b.DT_OverhangNG:= DP_Step0=6040 AND   Mach_Control.U.DT_iMode=1 AND  TailCurlStep3>=1000 AND TailCurlStep3<=1180  ;
	
//更换隔膜时间	
		IF Mach_Control.DT_b.Error[24] OR Mach_Control.DT_b.Error[61]	OR Bnt_Blueflaging THEN
			Mach_Control.DT_b.DT_GMchange:=TRUE;
 		END_IF		
		
		IF  Mach_Control.DT_b.DT_GMchange  AND NOT Bnt_Blueflaging (*AND   Mach_Control.U.DT_iMode=1*) AND 
             Mach_Control.DT_b.fWindDiameter>Par.stDT_date.fDiameterWarn     AND   Mach_Control.DT_b.bTensionOK    THEN
			Mach_Control.DT_b.DT_GMchange:=FALSE;
		END_IF		]]></ST>
      </Implementation>
    </Action>
    <Action Name="_01DT_Auto" Id="{b75b5f78-ab29-4878-8c44-46bdb967f856}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[Scan_TON	[1](IN:= , PT:=T#200MS , Q=> , ET=> );//取放料时位置判断正极用
Scan_TON	[2](IN:= , PT:=T#200MS , Q=> , ET=> );//取放料时位置判断负极用
DT_Ton[6](IN:= , PT:=T#0.3S , Q=> , ET=> );
tDtUse[2](IN:=, PT:=T#5S , Q=> , ET=> );
//DP_Step0----叠片主流程
/////////////////////////

An_RectifydevGohomeTon(IN:= , PT:=T#1S , Q=> , ET=> );//正极纠偏平台回原点延时
Ca_RectifydevGohomeTon(IN:= , PT:=T#1S , Q=> , ET=> );//负极纠偏平台回原点延时
Ca_TON[1](PT:=T#0.5S);//负极拍照结果超时


IF Mach_Control.DT_b.CDD_OverStart_First THEN
	CCD.Over.Start.iPhotoDo:=3;
	Mach_Control.DT_b.CDD_OverStart:=TRUE;
END_IF

//对齐度结果汇总
D:=D+1;
IF D<1 OR D>(Par.stDT_date.An_Quantity+Par.stDT_date.Ca_Quantity) THEN
	D:=1;
END_IF
IF CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_Result[D]=2 OR CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_Result[D]=3 OR  
    CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_Result[D]=4 OR OversequelNG THEN
	Mach_Control.DT_b.DT_Oerhang_Z:=2;
END_IF


//单步启动
rDT_SinStepd(CLK:=Mach_Control.DT_b.DT_Start , Q=> );
IF rDT_SinStepd.Q THEN
	DP_SinStepe:=FALSE;
END_IF

//叠台真空关闭层数
rDtUse[3](CLK:=(Mach_Control.An_b.An_Quantited+Mach_Control.Ca_b.Ca_Quantited)>=Par.stDT_date.DtCountSet[1]);
rDtUse[4](CLK:=Mach_Control.Ca_b.Ca_Quantited=0);
IF rDtUse[4].Q THEN//叠台真空开
	arrCyCtrl[arrCyNo.ElectValveName.DTVacuum].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.ElectValveName.DTVacuum].Cmd.bOFF:=FALSE;
END_IF
IF rDtUse[3].Q THEN//叠台真空关
	arrCyCtrl[arrCyNo.ElectValveName.DTVacuum].Cmd.bON:=FALSE;
	arrCyCtrl[arrCyNo.ElectValveName.DTVacuum].Cmd.bOFF:=TRUE;
END_IF
	

//正、负已叠极片清零
rClearcountR_TRIG(CLK:=Mach_Control.DT_b.ClearCount , Q=> );
IF Mach_Control.U.DT_iMode=3 THEN
	IF rClearcountR_TRIG.Q THEN
		Mach_Control.An_b.An_Quantited :=0;
		Mach_Control.Ca_b.Ca_Quantited :=0;
		Mach_Control.An_b.An_KDQuantited :=0;
		Mach_Control.Ca_b.Ca_KDQuantited:=0;
		Mach_Control.An_b.An_FirstFoldCnt:=0;
		Mach_Control.Ca_b.Ca_FirstFoldCnt:=0;
		bFirstFoldFinish[1]:=FALSE;//首层隔膜空叠
		bEmptyFoldMark[1]:=FALSE;//进入空叠流程
		Mach_Control.DT_b.OffloadDone:=FALSE;
		Mach_Control.DT_b.OffloadRequest:=FALSE;//叠电芯完成，请求下电芯
		MEMSET(ADR(CellMemory[Mach_Control.DT_b.DT_Memory]),0,SIZEOF(CellMemory[Mach_Control.DT_b.DT_Memory]));
		Mach_Control.DT_b.DT_Oerhang_Z:=0;
		DP_Step0:=0;
////////////////////////////////////////////////////////////////////////////////////////////////////////////				
		Ca_GohomeDone:=FALSE;
		An_GohomeDone:=FALSE; 
		DTIniti_Done :=FALSE;
		//Ca_BeltGohomeDone :=FALSE;	
////////////////////////////////////////////////////////////////////////////////////////////////////////////
	END_IF
END_IF
IF Mach_Control.Ca_b.Ca_Quantited =0 AND Mach_Control.An_b.An_Quantited =0 AND Mach_Control.An_b.An_KDQuantited =0 AND Mach_Control.Ca_b.Ca_KDQuantited =0 THEN
	Mach_Control.DT_b.OffloadDone:=FALSE;
	Mach_Control.DT_b.OffloadRequest:=FALSE;//叠电芯完成，请求下电芯
END_IF

//对齐度检测复位
tMach_Control_TON(IN:=Mach_Control.DT_b.CDD_OverStart , PT:=T#0.05S , Q=> , ET=> );
IF tMach_Control_TON.Q THEN
	Mach_Control.DT_b.CDD_OverStart:=FALSE;
END_IF
//主轴启动超时报警延时
VirMain_TON(IN:= , PT:=T#5S , Q=> , ET=> );

//接带检测或隔膜色标、、空叠隔膜踢废
BulebntR_TRIG(CLK:=(Mach_Control.DT_b.stBnt_Blueflag OR arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.OFFState)  AND NOT  Mach_Control.DT_b.DT_Blue_TF, Q=> );//OR Mach_Control.se.Yellowmark    OR Mach_Control.btn.PoleInflationbtn
YellowmarkR_TRIG(CLK:=(Mach_Control.se.Yellowmark)  AND NOT  Mach_Control.DT_b.DT_Blue_TF AND NOT  Mach_Control.DT_b.Yellowmark_TF, Q=> );

IF BulebntR_TRIG.Q AND NOT Bnt_Blueflaging THEN//正常接带空叠隔膜层数
	Bnt_Blueflaging:=TRUE;
	//Mach_Control.An_b.An_Blueflaging_TF:=Mach_Control.An_b.An_BlueflagingKDSet;
	Mach_Control.An_b.An_Blueflaging_TF:=Mach_Control.Ca_b.Ca_Blueflaging_TF:=Par.stDT_date.Ca_BlueflagingKDSet;	
ELSIF YellowmarkR_TRIG.Q AND NOT Bnt_Blueflaging THEN//色标感应器空叠隔膜层数
	Bnt_Blueflaging:=TRUE;
	Mach_Control.DT_b.Error_tips[4]:=TRUE;//检测到蓝标，叠台空叠
	//Mach_Control.An_b.An_Blueflaging_TF:=Mach_Control.An_b.An_YellowmarkKDSet;
	Mach_Control.An_b.An_Blueflaging_TF:=Mach_Control.Ca_b.Ca_Blueflaging_TF:=Par.stDT_date.Ca_YellowmarkKDSet;	
END_IF
IF NOT Bnt_Blueflaging THEN
	Mach_Control.DT_b.Error_tips[4]:=FALSE;//检测到蓝标，叠台空叠
END_IF

IF arrCyCtrl[arrCyNo.CylinderName.PoleInflationCy].Status.OFFState THEN
	Mach_Control.DT_b.BlueflagBnt_Warm:=TRUE;//隔膜气胀轴松开提示是否换卷，需要开启接带踢废
ELSIF stSysState.hmiReset OR Bnt_Blueflaging THEN
	Mach_Control.DT_b.BlueflagBnt_Warm:=FALSE;//隔膜气胀轴松开提示是否换卷，需要开启接带踢废
END_IF


//梯度起步
VirMain_TagatTime:=Par.stDT_date.SinglePosTime-0.025;
IF Mach_Control.Ca_b.Ca_Quantited<1 THEN
	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fOverride:=30;
ELSIF  Mach_Control.An_b.An_Quantited<3 OR 
         ((An_OverNGStep>1000 OR Ca_OverNGStep>1000 )(*AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving	*)) OR 
         (Mach_Control.Ca_b.Ca_Quantited= Par.stDT_date.Ca_Quantity  AND Mach_Control.An_b.An_Quantited= Par.stDT_date.An_Quantity)  THEN
	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fOverride:=50;	
ELSIF  Mach_Control.An_b.An_Quantited<4 AND NOT An_OverNGMark AND NOT Ca_OverNGMark  THEN
	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fOverride:=80;
ELSE
	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fOverride:=100;	
END_IF

//Mach_Control.DT_b.DP_Mode:=TRUE;
IF Mach_Control.DT_b.DP_Mode THEN
		IF Mach_Control.Ca_b.Ca_Quantited>= Par.stDT_date.Ca_Quantity-1 AND Mach_Control.An_b.An_Quantited= Par.stDT_date.An_Quantity AND
			Mach_Control.Ca_b.Ca_Quantited < Par.stDT_date.Ca_Quantity AND Par.stDT_date.An_Quantity<>0  AND Par.stDT_date.Ca_Quantity <>0 AND NOT  Mach_Control.U.EmptyRunMode  THEN
			DP_CheseCam:=TRUE;
		//ELSE
			//DP_CheseCam:=FALSE;
		END_IF
END_IF	


//空叠隔膜时关闭负极叠片搬运真空，防止吸极耳
IF DP_CheseCam THEN
	IF Mach_Control.Ca_b.Ca_Quantited>=Par.stDT_date.Ca_Quantity THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运升降真空破
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运升降真空破
	END_IF
END_IF

//接带或黄标空叠隔膜时,负极搬运破真空，防止吸极耳
IF (Bnt_Blueflaging OR Mach_Control.DT_b.DT_Oerhang_Z=2) AND KD_Mark THEN
	arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运升降真空破
	arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运升降真空破
END_IF

IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下
//叠片自动程序
//CASE DP_Step0 OF
//0://根据已叠正、负极片数来判断当前是需要正极片还是负极片
IF  DP_Step0=0 THEN    	
	IF NOT DP_SinStepe THEN		
		PosErrorMark:=FALSE;
		IF iTensionAutoStep=6666 AND DTPosError[10] THEN//上张力完成
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bMoveAbs:=FALSE;
			fAnScaling:=1;//20240508 CF
			fCaScaling:=1;//20240508 CF			
			IF NOT Mach_Control.DT_b.FirstEmpFold AND Mach_Control.An_b.An_Quantited=0 AND Mach_Control.Ca_b.Ca_Quantited=0  
				AND Mach_Control.An_b.An_FirstFoldCnt<Mach_Control.An_b.An_FirstFoldSet  AND Mach_Control.An_b.An_FirstFoldSet<>0
				AND Mach_Control.Ca_b.Ca_FirstFoldCnt<Mach_Control.Ca_b.Ca_FirstFoldSet AND Mach_Control.Ca_b.Ca_FirstFoldSet<>0 
				AND NOT bFirstFoldFinish[1] AND NOT bEmptyFoldMark[1]AND An_OverNGStep=0 AND Ca_OverNGStep=0 THEN   //新增，首层隔膜
				Mach_Control.DTRunStatus.bJumpSync:=TRUE;//20240504 CF
				iEmptyFoldStep[1]:=100;//进入首层空叠隔膜流程
				GMlappos[1]:=arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Status.fActPos;
				DP_Step0:=1;
				
			ELSIF NOT Bnt_Blueflaging 
				AND  Mach_Control.An_b.An_Quantited >= Par.stDT_date.An_Quantity  
				AND  Mach_Control.Ca_b.Ca_Quantited >= Par.stDT_date.Ca_Quantity 
				AND Par.stDT_date.An_Quantity<>0  
				AND Par.stDT_date.Ca_Quantity <>0 
				AND iEmptyFoldStep[1]=0 AND An_OverNGStep=0 AND Ca_OverNGStep=0
				(*AND((NOT Mach_Control.DT_b.FirstEmpFold AND bFirstFoldFinish[1])OR(Mach_Control.DT_b.FirstEmpFold))*) THEN//判断当前已叠正、负极片数量是否小于设定的极片数
				//DP_CheseCam:=FALSE;		
				//DP_AnNumber:=0;
				//DP_CaNumber:=0;
				Mach_Control.DTRunStatus.bJumpSync:=TRUE;//20240504 CF
				
				IF NOT  Mach_Control.U.EmptyRunMode THEN
					IF  ( (Mach_Control.An_b.An_KDQuantited >= Par.stDT_date.An_KDQuantity AND  Mach_Control.Ca_b.Ca_KDQuantited  >= Par.stDT_date.Ca_KDQuantity AND Par.stDT_date.An_KDQuantity<>0  AND Par.stDT_date.Ca_KDQuantity<>0 AND Mach_Control.DT_b.DP_Mode ) OR 
						NOT Mach_Control.DT_b.DP_Mode)  THEN
						KD_Mark:=FALSE;//复位空叠隔膜信号
						DP_CheseCam:=FALSE;										
						DP_Step0:=6000;//跳入电芯下料
						GMlappos[2]:=arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Status.fActPos;
						 GMlappos[4]:=GMlappos[2]-GMlappos[1];
						IF ABS(GMlappos[2]-GMlappos[1]) <> 0 THEN
						   GMlappos[3]:=((Mach_Control.An_b.An_Quantited+Mach_Control.Ca_b.Ca_Quantited+3)*par.stDT_date.Width)/ABS(GMlappos[2]-GMlappos[1]);					
						END_IF							
						
					ELSE//电芯空叠尾层隔膜	
						An_Step0:=0;
						An_Step1:=0;
						An_Step2:=0;
						An_Step3:=0;
						An_StandbyStep1:=0;													
						DP_Step0:=1000;//跳入空叠隔膜
					END_IF	
				ELSE//空跑模式	
					Blueflaging:=TRUE;
					Mach_Control.DT_b.Overhang_TF:=TRUE;		
					DP_Step0:=6000;//跳入电芯下料
				END_IF
				
		
			//接带空叠隔膜	
			ELSIF Bnt_Blueflaging AND ((Mach_Control.An_b.An_Quantited=0 AND Mach_Control.Ca_b.Ca_Quantited=0) OR Mach_Control.Ca_b.Ca_Quantited>Mach_Control.An_b.An_Quantited) AND  Par.stDT_date.An_Quantity<>0  
				AND Par.stDT_date.Ca_Quantity <>0 AND Mach_Control.Ca_b.Ca_Quantited>=Par.stDT_date.DT_Overhang_SUM AND Par.stDT_date.DT_Overhang_SUM>0 
                AND iEmptyFoldStep[1]=0 AND An_OverNGStep=0 AND Ca_OverNGStep=0 THEN	
					Mach_Control.DTRunStatus.bJumpSync:=TRUE;//20240504 CF	
					IF Mach_Control.An_b.An_KDQuantited >=Mach_Control.An_b.An_Blueflaging_TF  AND Mach_Control.Ca_b.Ca_KDQuantited >Mach_Control.Ca_b.Ca_Blueflaging_TF  AND Mach_Control.An_b.An_KDQuantited<=Mach_Control.Ca_b.Ca_KDQuantited 
					(*AND((NOT Mach_Control.DT_b.FirstEmpFold AND   bFirstFoldFinish[1]) OR (Mach_Control.DT_b.FirstEmpFold)  )*)  THEN
						Mach_Control.DT_b.Overhang_TF:=TRUE;													
						DT_Ca_Quantited:=0;
						Blueflaging:=TRUE;
						Bnt_Blueflaging:=FALSE;
						KD_Mark:=FALSE;//复位空叠隔膜信号		
						DP_CheseCam:=FALSE;				
						DP_Step0:=6000;//跳入电芯下料
					ELSE//电芯空叠尾层隔膜
						An_Step0:=0;
						An_Step1:=0;
						An_Step2:=0;
						An_Step3:=0;
						An_StandbyStep1:=0;															
						DP_Step0:=1000;//跳入空叠隔膜
					END_IF	
			//对齐度踢废																										
			ELSIF   Mach_Control.An_b.An_Quantited<Mach_Control.Ca_b.Ca_Quantited AND Par.stDT_date.An_Quantity<>0  
				AND Par.stDT_date.Ca_Quantity <>0 AND  Mach_Control.DT_b.DT_CellNG_TF 
				AND (arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] OR (arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] AND Mach_Control.An_b.An_KDQuantited >= 1))
				AND	Mach_Control.Ca_b.Ca_Quantited>=Par.stDT_date.DT_Overhang_SUM AND Par.stDT_date.DT_Overhang_SUM>0
				AND Mach_Control.DT_b.DT_Oerhang_Z=2 AND  NOT Mach_Control.U.EmptyRunMode AND NOT Mach_Control.DT_b.DT_Overhang
				AND iEmptyFoldStep[1]=0 AND An_OverNGStep=0 AND Ca_OverNGStep=0
				(*AND((NOT Mach_Control.DT_b.FirstEmpFold AND   bFirstFoldFinish[1]) OR (Mach_Control.DT_b.FirstEmpFold)  )*)  THEN
				Mach_Control.DTRunStatus.bJumpSync:=TRUE;//20240504 CF
				IF  ( (Mach_Control.An_b.An_KDQuantited >= 1 AND  Mach_Control.Ca_b.Ca_KDQuantited  >= 1
					AND Par.stDT_date.An_KDQuantity<>0  AND Par.stDT_date.Ca_KDQuantity<>0 AND Mach_Control.DT_b.DP_Mode ) OR NOT Mach_Control.DT_b.DP_Mode)  THEN
						KD_Mark:=FALSE;//空叠隔膜中	
						DP_CheseCam:=FALSE;				
						OversequelNG:=FALSE;	
						DP_Step0:=6000;//跳入电芯下料
						Mach_Control.DT_b.Overhang_TF:=TRUE;//
						 GMlappos[2]:=arrAxisCtrl[AxiseNo.AxisName.SEPTAunwinding].Status.fActPos;
						 GMlappos[4]:=GMlappos[2]-GMlappos[1];
						IF ABS(GMlappos[2]-GMlappos[1]) <> 0 THEN
						    GMlappos[3]:=((Mach_Control.An_b.An_Quantited+Mach_Control.Ca_b.Ca_Quantited+3)*par.stDT_date.Width)/ABS(GMlappos[2]-GMlappos[1]);	
						END_IF						
						
				ELSE
					An_Step0:=0;
					An_Step1:=0;
					An_Step2:=0;
					An_Step3:=0;
					An_StandbyStep1:=0;													
					DP_Step0:=1000;//跳入空叠隔膜
				END_IF		
				
			ELSE//判断叠负极片还是正极片
				Mach_Control.DTRunStatus.bJumpSync:=FALSE;//20240504 CF
				DT_Ton[6].IN:=FALSE;
				IF Mach_Control.Ca_b.Ca_Quantited = Mach_Control.An_b.An_Quantited AND iEmptyFoldStep[1]=0 AND An_OverNGStep=0 AND Ca_OverNGStep=0 (*AND((NOT Mach_Control.DT_b.FirstEmpFold AND   bFirstFoldFinish[1]) OR Mach_Control.DT_b.FirstEmpFold )*) THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF		
						Ca_Number:=FALSE;
					IF 	 Mach_Control.Ca_b.Ca_Quantited=0 THEN
						Mach_Control.DT_b.DT_Oerhang_Z:=0;
						MEMSET(ADR(CellMemory[Mach_Control.DT_b.DT_Memory]),0,SIZEOF(CellMemory[Mach_Control.DT_b.DT_Memory]));
					END_IF	
					//DP_CaNumber:=DP_CaNumber+1;	
				
	////////////////////////////////////////////////////////////////////////////////////////////////////////////											
						An_Step0:=0;
						An_Step1:=0;
						An_Step2:=0;
						An_Step3:=0;
						An_StandbyStep1:=0;
						An_OverNGStep:=0;
				    	Ca_OverNGStep:=0;
	////////////////////////////////////////////////////////////////////////////////////////////////////////////											
					
					//DP_AnNumber:=0;								
					DP_Step0:=100;//叠负极片
					DPtime:=12;
				ELSIF Mach_Control.Ca_b.Ca_Quantited > Mach_Control.An_b.An_Quantited AND iEmptyFoldStep[1]=0 AND An_OverNGStep=0 AND Ca_OverNGStep=0 (*AND((NOT Mach_Control.DT_b.FirstEmpFold AND   bFirstFoldFinish[1]) OR (Mach_Control.DT_b.FirstEmpFold)  )*) THEN
					IF Mach_Control.DT_b.SinStepMode THEN
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;
					END_IF
					An_Number:=FALSE;
					//DP_AnNumber:=DP_AnNumber+1;
					
	////////////////////////////////////////////////////////////////////////////////////////////////////////////													
					Ca_Step0:=0;//负极搬运子程序1
					Ca_Step1:=0;//负极搬运子程序2
					Ca_Step2:=0;//负极搬运子程序3
					Ca_Step3:=0;//负极搬运子程序4		
					Ca_StandbyStep0:=0;
					An_OverNGStep:=0;
					Ca_OverNGStep:=0;
	////////////////////////////////////////////////////////////////////////////////////////////////////////////																	
					//DP_CaNumber:=0;
					DP_Step0:=500;//叠正极片
					DPtime:=22;
				END_IF
			END_IF
		
		ELSIF NOT DTPosError[10] THEN
			Mach_Control.DT_b.Error[60]:=TRUE;//主轴启动前轴有故障
		END_IF
	END_IF
END_IF	
//100://判断负极取料是否完成
IF  DP_Step0=100 THEN 
	IF NOT DP_SinStepe THEN
		IF (Mach_Control.Ca_b.Ca_CarryingFalg AND  Mach_Control.Ca_b.Ca_DPCarryingFalg  
		 AND (CCD.CaRec.Finish.RectifyResult=1 OR  Mach_Control.U.CCD_ChosesHMI OR Mach_Control.U.EmptyRunMode))   THEN//负极取极片OK
			Mach_Control.Ca_b.Ca_DPRequest:=FALSE;//负极极片备料请求
			IF (*Mach_Control.Ca_b.Ca_deviationFPOK AND *) TailCurlSEPTA_SafePos   THEN//
				IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
					DP_SinStepe:=TRUE;
				ELSE
					DP_SinStepe:=FALSE;	
				END_IF												
				DP_Step0:=101;
				DPtime:=13;
			END_IF
		ELSE
			Mach_Control.DTRunStatus.bJumpSync:=TRUE;//20240509 CF
			IF Ca_StandbyStep0=6666 OR Ca_StandbyStep0=0 THEN
				Ca_StandbyStep0:=1000;//调用负极取片子程序
			END_IF
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF										
			DP_Step0:=103;
		END_IF
	END_IF
END_IF	
//101://判断主轴是否停止、是否在初始位、是否有轴在耦合中
IF  DP_Step0=101 THEN 
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fSetPos=0 AND NOT DT_AxiseCoupling THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF								
			DP_Step0:=104;
			DPtime:=14;
		ELSIF DP_Step1=0 OR DP_Step1=6666 THEN
			DP_Step1:=100;//调用主轴回初始位子程序
			DP_Step0:=102;
		END_IF
	END_IF
END_IF
//102://判断主轴的模长的当前位置是否为0
IF  DP_Step0=102 THEN 
	IF DP_Step1=6666 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fSetPos=0 AND NOT DT_AxiseCoupling  THEN
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF								
		DP_Step0:=104;
	END_IF
END_IF
//103://等待负极取片完成
IF  DP_Step0=103 THEN 
	IF Ca_StandbyStep0 =6666 THEN//正常取料完成
		DP_Step0:=0;
	ELSIF Ca_StandbyStep0 =0 THEN//取料报警返回
		DP_Step0:=0;
	END_IF
END_IF
	

//104://判断NG气缸是否在安全位
IF  DP_Step0=104 THEN 
	IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState AND
        (arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] OR (Ca_OverNGMark AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[15]))
         AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]   THEN
		DP_Step0:=110;		
	ELSE
		DP_Step0:=105;	
	END_IF
END_IF	
//105:
IF  DP_Step0=105 THEN 
		arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Cmd.bOFF:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Cmd.bON:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Cmd.bON:=TRUE;
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;
		IF   arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND  arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
			arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
			arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState
		AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON THEN
			DP_Step0:=106;									
		END_IF
END_IF
//106:
IF  DP_Step0=106 THEN 
	arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;
	IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND 
        ( arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1]OR (Ca_OverNGMark AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[15])) 
       AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]  THEN
		DP_Step0:=110;	
	END_IF	
END_IF						
//110:
IF  DP_Step0=110 THEN 
    An_OverhangNG:=FALSE;
	IF NOT DP_SinStepe THEN
		Scan_TON[2].IN:=TRUE;		
		IF CA_CarryingPos1  THEN//负极搬运、叠片各轴在初始位
			Scan_TON[1].IN:=TRUE;	
			IF AN_CarryingPos2  THEN//正极在叠片位
				fAnScaling:=0.8;//20240508 CF	
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]   THEN
					//IF Mach_Control.An_b.An_deviationDPOK  THEN//正极纠偏平台,拍照完成
						IF  NOT Mach_Control.An_b.An_DPCarryingFalg AND  Mach_Control.An_b.An_deviationFalg AND NOT DP_CheseCam 
						AND ((NOT Mach_Control.DT_b.FirstEmpFold AND Mach_Control.An_b.An_FirstFoldCnt=Mach_Control.An_b.An_FirstFoldSet  ) OR Mach_Control.DT_b.FirstEmpFold  )
						AND Mach_Control.An_b.An_Quantited< Par.stDT_date.An_Quantity  THEN  //叠片搬运需要取片  AND Mach_Control.An_b.An_deviationDPOK
							iAnCamInSel2:=1;
						ELSE
							iAnCamInSel2:=2;
						END_IF    
  
						Ca_CanIn4:=TRUE;
					
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF	
						DP_Step0:=160;//
						DPtime:=32;	
					//END_IF
				ELSE
					Mach_Control.DT_b.Error[5]:=TRUE;//叠负极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					DP_Step0:=9991;	
				END_IF;
			ELSIF AN_CarryingPos1  THEN//在取片位	
				Mach_Control.DTRunStatus.bJumpSync:=TRUE;//20240504 CF																			
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF											
					DP_Step0:=130;//
				ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF											
					DP_Step0:=140;//
				ELSE
					Mach_Control.DT_b.Error[5]:=TRUE;//叠负极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					DP_Step0:=9992;	
				END_IF;							
			ELSIF Scan_TON[1].Q THEN
				Scan_TON[1].IN:=FALSE;	
				DP_Step0:=9993;
				DTPosError[3]:=TRUE;
			END_IF
	
		ELSE
			IF (Ca_Step0=0 OR Ca_Step0=6666) AND (Ca_Step3=0 OR Ca_Step3=6666) AND Scan_TON[2].Q   THEN//-------------------------20231910改测	
				Scan_TON[2].IN:=FALSE;		
				DP_Step0:=9994;
				DTPosError[1]:=TRUE;		
			END_IF
		END_IF
	END_IF
END_IF
//500://需要叠正极片
IF  DP_Step0=500 THEN 
	IF NOT DP_SinStepe THEN
		IF Mach_Control.An_b.An_CarryingFalg AND  Mach_Control.An_b.An_DPCarryingFalg AND NOT Mach_Control.An_b.An_deviationFalg  
		AND  (CCD.AnRec.Finish.RectifyResult=1 OR  Mach_Control.U.CCD_ChosesHMI OR Mach_Control.U.EmptyRunMode) THEN//负极取极片OK
			Mach_Control.An_b.An_DPRequest:=FALSE;//正极极片备料请求
			IF TailCurlSEPTA_SafePos(*  Mach_Control.An_b.An_deviationFPOK*)  THEN 
				IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
					DP_SinStepe:=TRUE;
				ELSE
					DP_SinStepe:=FALSE;	
				END_IF
				DP_Step0:=501;
				DPtime:=23;
			END_IF
		ELSE
			Mach_Control.DTRunStatus.bJumpSync:=TRUE;//20240504 CF		
			IF An_StandbyStep1=6666 OR An_StandbyStep1=0 THEN
				An_StandbyStep1:=1000;//调用正极取片子程序取极片	
			END_IF	
			DP_Step0:=503;									
		END_IF
	END_IF
END_IF
//501://判断主轴是否停止、是否在初始位、是否有轴在耦合中
IF  DP_Step0=501 THEN 
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fSetPos=0 AND NOT DT_AxiseCoupling THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			DP_Step0:=504;
			DPtime:=24;
		ELSIF DP_Step1=0 OR DP_Step1=6666 THEN
			DP_Step1:=100;//解除耦合，主轴回零
			DP_Step0:=502;
		END_IF
	END_IF
END_IF
//502://判断主轴当前的当前位置是否为0
IF  DP_Step0=502 THEN 
		IF DP_Step1=6666 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fSetPos=0 AND NOT DT_AxiseCoupling THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF									
			DP_Step0:=504;
		END_IF
END_IF	
//503:
IF  DP_Step0=503 THEN 
		IF An_StandbyStep1=6666 THEN
			DP_Step0:=0;
		ELSIF An_StandbyStep1=0 THEN	
			DP_Step0:=0;
		ELSIF Bnt_Blueflaging AND An_Step0<=30 AND (An_Step2=0 OR An_Step2=6666) AND (An_Step3=0 OR An_Step3=6666) AND Mach_Control.Ca_b.Ca_Quantited>=Par.stDT_date.DT_Overhang_SUM AND Par.stDT_date.DT_Overhang_SUM>0 AND
			NOT Mach_Control.An_b.An_MainBeltOK AND NOT Mach_Control.An_b.GetPiceReady AND  NOT Mach_Control.An_b.An_MainBelting THEN		
			DP_Step0:=0;
			An_Step0:=0;
			An_Step1:=0;
			An_Step2:=0;
			An_Step3:=0;
			An_StandbyStep1:=0;									
		END_IF	
END_IF
//504://判断NG气缸是否在安全位
IF  DP_Step0=504 THEN 
	IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState AND
        arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND
        ( arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] OR (An_OverNGMark AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[15] ))  THEN
		DP_Step0:=510;		
	ELSE
		DP_Step0:=505;	
	END_IF
END_IF
//505:
IF  DP_Step0=505 THEN 
	arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;
	IF   arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND  arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
	arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState
	AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON THEN
		DP_Step0:=506;									
	END_IF
END_IF
//506:
IF  DP_Step0=506 THEN 
	arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;
	IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
       arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND
       ( arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] OR (An_OverNGMark AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[15] ))  THEN
		DP_Step0:=510;	
	END_IF
END_IF
//510:
IF  DP_Step0=510 THEN 	
     Ca_OverhangNG:=FALSE;	
	IF NOT DP_SinStepe THEN
		IF AN_CarryingPos1  THEN//负极搬运、叠片各轴在初始位										
			IF CA_CarryingPos2 THEN//负极在叠片位
				fCaScaling:=0.8;//20240508 CF
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
					IF  NOT Mach_Control.Ca_b.Ca_DPCarryingFalg AND  Mach_Control.Ca_b.Ca_deviationFalg   AND TailCurlSEPTA_SafePos
					AND Mach_Control.Ca_b.Ca_Quantited< Par.stDT_date.Ca_Quantity THEN//AND Mach_Control.Ca_b.Ca_deviationDPOK
						iCaCamInSel2:=1;
					ELSE
						iCaCamInSel2:=2;
					END_IF     
			
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF
					DP_Step0:=550;//
								
				ELSE
					Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					DP_Step0:=9998;
				END_IF;
			ELSIF  CA_CarryingPos1  THEN //负极取片位
				Mach_Control.DTRunStatus.bJumpSync:=TRUE;//20240504 CF		
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF
					DP_Step0:=530;//
				ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]  THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF
					DP_Step0:=540;//
				ELSE
					Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					DP_Step0:=9999;
				END_IF;							
			ELSE
				Mach_Control.DT_b.Error[7]:=TRUE;//叠正极片凸轮耦合时，负极取片即不在取片位，也不在叠片位
				DP_Step0:=9994;
			END_IF
		ELSE
			Mach_Control.DT_b.Error[8]:=TRUE;//叠正极片凸轮耦合时，正极片不在取片位
			DP_Step0:=9993;
		END_IF
	END_IF
  END_IF




//END_CASE
END_IF

(**************************************************************************************主轴启动**************************************************************************************************************)
//CASE DP_Step0 OF

//130://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在取极片位
IF  DP_Step0=130 THEN 
	IF NOT DP_SinStepe THEN
		Ca_CanIn1:=TRUE;
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF
		DP_Step0:=131;
	END_IF
END_IF
//131://判断凸轮耦合是否完成
IF  DP_Step0=131 THEN 
	IF NOT DP_SinStepe THEN
		VirMain_TON.IN:=FALSE;
		IF NOT Ca_CanIn1 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			//DP_CaNumber:=DP_CaNumber+1;
			DP_Step0:=142;
		ELSIF 	fbCaCamInCarryingLine2.bError OR fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingLine.bError OR 
			fbCaCamInDTCarryingUpDown.bError OR fbCamInLeftYDUpDown.bError OR 	fbCamInLeftYDLine.bError THEN										
			Ca_CanIn1:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			DP_Step0:=9995;		
		END_IF
	END_IF	
END_IF				
//142://主轴启动
IF  DP_Step0=142 THEN 
	IF NOT DP_SinStepe THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
		arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fPositon_of_Abs:=360;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;
		fbAnCamInCarryingUpDownOutCamFlge:=FALSE;//正极解耦标记		
	(*	
		IF  DP_CaNumber>=2 THEN
			DP_Step9:=100;
		END_IF
	*)
		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
			IF CCD.Over.Finish.OverhandResult=2 OR CCD.Over.Finish.OverhandResult=4 THEN
				An_OverhangNG:=TRUE;
			END_IF
			VirMain_TON.IN:=FALSE;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			DP_Step3:=100;//根据主轴在不同在位置，真空、破真空、标志位
			DP_Step4:=100;//判断主轴是否完成
			DP_Step5:=100;//判断主轴在运行过程中，负极叠片真空是否有报警
			DP_Step8:=100;//纠偏平台有无极片复检
			DP_Step0:=143;	
		ELSE
			IF NOT VirMain_TON.Q THEN
				VirMain_TON.IN:=TRUE;
			ELSE
				VirMain_TON.IN:=FALSE;
				Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
				DP_Step0:=10006;	
			END_IF	
		END_IF
	END_IF	
END_IF	
////////////////////////////////////////////////////////							
//140://负极搬运、叠片各轴在初始位，隔膜平移轴正极叠片位、正极叠片在取极片位
IF  DP_Step0=140 THEN 
	IF NOT DP_SinStepe THEN
		Ca_CanIn2:=TRUE;
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF
		DP_Step0:=141;
	END_IF
END_IF
//141:
IF  DP_Step0=141 THEN 
	IF NOT DP_SinStepe THEN
		VirMain_TON.IN:=FALSE;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
		IF NOT Ca_CanIn2 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF	
			//DP_CaNumber:=DP_CaNumber+1;																				
			DP_Step0:=144;
		ELSIF fbCaCamInCarryingLine2.bError OR fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingLine.bError OR 
			  fbCaCamInDTCarryingUpDown.bError OR fbCamInGMBuffer.bError OR fbCamInGMDanserMove.bError OR
			  fbCamInVirGMDriver.bError OR fbCamInLeftYDUpDown.bError OR fbCamInLeftYDLine.bError  THEN
			   Ca_CanIn2:=FALSE;
			   Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			   DP_Step0:=9996;	
		END_IF
	END_IF
END_IF		
//144://主轴启动
IF  DP_Step0=144 THEN 
	IF NOT DP_SinStepe THEN
		//Ca_CanIn2					
		IF fbCaCamInCarryingLine2.bInSync AND fbCaCamInCarryingUpDown2.bInSync AND 
			fbCaCamInDTCarryingLine.bInSync AND	fbCaCamInDTCarryingUpDown.bInSync AND 
			fbCamInGMBuffer.bInSync AND fbCamInGMDanserMove.bInSync AND fbCamInVirGMDriver.bInSync  AND 
			fbCamInLeftYDUpDown.bInSync AND fbCamInLeftYDLine.bInSync   AND	
			CA_CarryingPos1 AND  AN_CarryingPos1 AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]  THEN																											
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
			arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fPositon_of_Abs:=360;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;				
		END_IF

		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
			IF CCD.Over.Finish.OverhandResult=2 OR CCD.Over.Finish.OverhandResult=4 THEN
				An_OverhangNG:=TRUE;
			END_IF
			VirMain_TON.IN:=FALSE;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			DP_Step3:=100;//根据主轴在不同在位置，真空、破真空、标志位
			DP_Step4:=100;//判断主轴是否完成
			DP_Step5:=100;//判断主轴在运行过程中，负极叠片真空是否有报警
			DP_Step8:=100;//纠偏平台有无极片复检
			DP_Step0:=145;	
		ELSE
			IF NOT VirMain_TON.Q THEN
				VirMain_TON.IN:=TRUE;
			ELSE
				VirMain_TON.IN:=FALSE;
				Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
				DP_Step0:=10006;	
			END_IF	
		END_IF									
	END_IF				
END_IF	
	
/////////////////////////////////////////////////////////					
//160://负极搬运、叠片各轴在初始位，隔膜平移轴正极叠片位、正极叠片在放极片初始位
IF  DP_Step0=160 THEN 
	IF NOT DP_SinStepe THEN
		Ca_CanIn4:=TRUE;
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF
		DP_Step0:=161;	
		DPtime:=33;	
	END_IF
END_IF
//161:
IF  DP_Step0=161 THEN 
	IF NOT DP_SinStepe THEN
		VirMain_TON.IN:=FALSE;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
		IF NOT Ca_CanIn4 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			//DP_CaNumber:=DP_CaNumber+1;
			DP_Step0:=162;
            DPtime:=34;		
		ELSIF fbCaCamInCarryingLine2.bError OR fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingLine.bError OR fbCaCamInDTCarryingUpDown.bError OR 
			fbCamInGMBuffer.bError OR fbCamInGMDanserMove.bError OR fbCamInVirGMDriver.bError OR fbAnCamInCarryingLine.bError OR fbAnCamInCarryingUpDown.bError OR 
			fbAnCamInDTCarryingLine.bError OR fbAnCamInDTCarryingUpDown.bError OR fbAnCamInCarryingWhirling.bError OR fbCamInLeftYDUpDown.bError OR fbCamInLeftYDLine.bError  THEN
			Ca_CanIn4:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			DP_Step0:=9998;										
		END_IF
	END_IF	
END_IF						
//162://主轴启动
IF  DP_Step0=162 THEN 
	IF NOT DP_SinStepe THEN
		IF fbCaCamInCarryingLine2.bInSync  AND fbCaCamInDTCarryingLine.bInSync AND  fbCaCamInDTCarryingUpDown.bInSync AND
		fbCamInGMBuffer.bInSync AND fbCamInGMDanserMove.bInSync AND  fbCamInVirGMDriver.bInSync AND  
		fbAnCamInCarryingLine.bInSync   AND fbAnCamInDTCarryingLine.bInSync AND 								
		( ( fbAnCamInDTCarryingUpDown.bInSync  AND iAnCamInSel2=1  AND NOT DP_CheseCam  )  OR  iAnCamInSel2=2  )  AND 
		fbAnCamInCarryingWhirling.bInSync AND fbCamInLeftYDUpDown.bInSync AND fbCamInLeftYDLine.bInSync  AND 								 
		CA_CarryingPos1 AND  AN_CarryingPos2 AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]  THEN
			Mach_Control.DTRunStatus.bSyncReady:=NOT bDiffVel[ Par.iStationNO];//20240504 CF
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bDynamitcsParSel:=2;	
			arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fPositon_of_Abs:=360;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=Mach_Control.DTRunStatus.bSyncStart OR bDiffVel[ Par.iStationNO];//TRUE; 20240504 CF
			DT_Ton[6].IN:=arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bMoveAbs;
				IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs THEN
				   DPtime:=35;	
				END_IF	   
		ELSE
			Mach_Control.DTRunStatus.bSyncReady:=FALSE;//20240504 CF
			Mach_Control.DTRunStatus.bJumpSync:=TRUE;//20240504 CF
		END_IF	

		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
			VirMain_TON.IN:=FALSE;
			Mach_Control.DTRunStatus.bSyncReady:=FALSE;//20240504 CF
			Mach_Control.DTRunStatus.bSyncStart:=FALSE;// 20240504 CF
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			DP_Step3:=200;//根据主轴在不同在位置，真空、破真空、标志位
			DP_Step4:=100;//判断主轴是否完成
			DP_Step5:=100;//判断主轴在运行过程中，负极叠片真空是否有报警
			DP_Step8:=100;//纠偏平台有无极片复检
			DP_Step0:=163;	
		ELSIF DT_Ton[6].Q THEN
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bMoveAbs:=FALSE;	
			Mach_Control.DTRunStatus.bSyncReady:=FALSE;//20240504 CF
			Mach_Control.DTRunStatus.bSyncStart:=FALSE;// 20240504 CF
			Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
			DP_Step0:=10006;
		ELSIF NOT arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bMoveAbs AND Mach_Control.U.DT_iMode<>1 THEN//切换到手动模式，如果主轴没启动直接j解耦 20240508 CF
			Mach_Control.DTRunStatus.bSyncReady:=FALSE;//20240504 CF
			Mach_Control.DTRunStatus.bSyncStart:=FALSE;// 20240504 CF	
			DP_Step1:=100;//解除耦合，主轴回零
			DP_Step0:=0;									
		END_IF	
	END_IF
END_IF
	
	

///////////////////////////////////////////////////////////////					
//530://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在取极片位
IF  DP_Step0=530 THEN 
	IF NOT DP_SinStepe THEN
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF
		An_CanIn1:=TRUE;
		DP_Step0:=531;
	END_IF
END_IF
//531:
IF  DP_Step0=531 THEN 
	IF NOT DP_SinStepe THEN
		VirMain_TON.IN:=FALSE;
		IF NOT An_CanIn1 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			//DP_AnNumber:=DP_AnNumber+1;
			DP_Step0:=542;
		ELSIF fbAnCamInCarryingLine.bError OR fbAnCamInCarryingUpDown.bError OR fbAnCamInDTCarryingLine.bError OR
			fbAnCamInDTCarryingUpDown.bError OR fbAnCamInCarryingWhirling.bError OR fbCamInGMBuffer.bError OR
			fbCamInGMDanserMove.bError OR fbCamInVirGMDriver.bError  OR fbCamInRightYDUpDown.bError OR
			fbCamInRightYDLine.bError  THEN
			An_CanIn1:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			DP_Step0:=10002;									
		END_IF
	END_IF	
END_IF

//542://主轴启动
IF  DP_Step0=542 THEN 
	IF NOT DP_SinStepe THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
		arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;	
		//fbCaCamInCarryingUpDown2OutCamFlge:=FALSE;//负极升降2凸轮解耦标记	
(*
		IF  DP_AnNumber>=2 THEN
			DP_Step9:=100;
		END_IF		
*)	
		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
			IF CCD.Over.Finish.OverhandResult=2 OR CCD.Over.Finish.OverhandResult=4 THEN
				Ca_OverhangNG:=TRUE;
			END_IF
		
			VirMain_TON.IN:=FALSE;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			DP_Step3:=300;//根据主轴在不同在位置，真空、破真空、标志位
			DP_Step4:=200;//判断主轴是否完成
			DP_Step5:=200;//判断主轴在运行过程中，正极叠片真空是否有报警
			DP_Step8:=200;//纠偏平台有无极片复检
			DP_Step0:=543;
		ELSE
			IF NOT VirMain_TON.Q THEN
				VirMain_TON.IN:=TRUE;
			ELSE
				VirMain_TON.IN:=FALSE;
				Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
				DP_Step0:=10006;	
			END_IF	
		END_IF	
	END_IF	
END_IF							
//////////////////////////////////////////////							
//540://负极搬运、叠片各轴在初始位，隔膜平移轴正极叠片位、正极叠片在取极片位
IF  DP_Step0=540 THEN 
	IF NOT DP_SinStepe THEN
		An_CanIn2:=TRUE;
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
		DP_Step0:=541;
	END_IF
END_IF

//541:
IF  DP_Step0=541 THEN 
	IF NOT DP_SinStepe THEN
		VirMain_TON.IN:=FALSE;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
		IF NOT An_CanIn2 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			//DP_AnNumber:=DP_AnNumber+1;
			DP_Step0:=544;
		ELSIF fbAnCamInCarryingLine.bError OR fbAnCamInCarryingUpDown.bError OR fbAnCamInDTCarryingLine.bError OR fbAnCamInDTCarryingUpDown.bError OR 
			fbAnCamInCarryingWhirling.bError OR fbCamInRightYDUpDown.bError OR fbCamInRightYDLine.bError THEN
			An_CanIn2:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			DP_Step0:=10003;												
		END_IF
	END_IF
END_IF

//544://主轴启动
IF  DP_Step0=544 THEN 
	IF NOT DP_SinStepe THEN
		IF fbAnCamInCarryingLine.bInSync AND fbAnCamInCarryingUpDown.bInSync AND fbAnCamInDTCarryingLine.bInSync AND 
			fbAnCamInDTCarryingUpDown.bInSync AND fbAnCamInCarryingWhirling.bInSync AND fbCamInRightYDUpDown.bInSync AND 
			fbCamInRightYDLine.bInSync  AND											
			CA_CarryingPos1 AND  AN_CarryingPos1 AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]  THEN	
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
			arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;	
		END_IF		
	(*	
		IF  DP_AnNumber>=2 AND NOT Mach_Control.U.CCD_ChosesHMI AND NOT Mach_Control.U.EmptyRunMode THEN   //连续叠2片正极防呆
			DP_Step9:=100;
		END_IF	
	*)
		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
			IF CCD.Over.Finish.OverhandResult=2 OR CCD.Over.Finish.OverhandResult=4 THEN
				Ca_OverhangNG:=TRUE;
			END_IF
			VirMain_TON.IN:=FALSE;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			DP_Step3:=300;//根据主轴在不同在位置，真空、破真空、标志位
			DP_Step4:=200;//判断主轴是否完成
			DP_Step5:=200;//判断主轴在运行过程中，正极叠片真空是否有报警
			DP_Step8:=200;//纠偏平台有无极片复检
			DP_Step0:=545;
		ELSE
			IF NOT VirMain_TON.Q THEN
				VirMain_TON.IN:=TRUE;
			ELSE
				VirMain_TON.IN:=FALSE;
				Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
				DP_Step0:=10006;	
			END_IF	
		END_IF											
	END_IF					
END_IF
////////////////////////////////////////////////					
//550://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在放极片初始位
IF  DP_Step0=550 THEN 
	IF NOT DP_SinStepe THEN
		An_CanIn3:=TRUE;
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
		DP_Step0:=551;
	    DPtime:=42;	
	END_IF	
END_IF
//551:
IF  DP_Step0=551 THEN 
	IF NOT DP_SinStepe THEN
		VirMain_TON.IN:=FALSE;
		IF NOT An_CanIn3 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF	
			//DP_AnNumber:=DP_AnNumber+1;
			DP_Step0:=562;
            DPtime:=43;	 	
		ELSIF fbAnCamInCarryingLine.bError OR fbAnCamInCarryingUpDown.bError OR fbAnCamInDTCarryingLine.bError OR fbAnCamInDTCarryingUpDown.bError OR 
			fbAnCamInCarryingWhirling.bError OR fbCaCamInCarryingLine2.bError OR fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingLine.bError OR 
			fbCaCamInDTCarryingUpDown.bError OR fbCamInGMBuffer.bError OR fbCamInGMDanserMove.bError OR fbCamInVirGMDriver.bError   OR
			fbCamInRightYDUpDown.bError OR fbCamInRightYDLine.bError  THEN
			An_CanIn3:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			DP_Step0:=10004;		
		END_IF
	END_IF	
END_IF			
//562://主轴启动
IF  DP_Step0=562 THEN 
	IF NOT DP_SinStepe THEN
		IF fbAnCamInCarryingLine.bInSync AND fbAnCamInCarryingUpDown.bInSync  AND  fbAnCamInCarryingWhirling.bInSync AND
			fbAnCamInDTCarryingLine.bInSync AND   fbAnCamInDTCarryingUpDown.bInSync AND 
			fbCaCamInCarryingLine2.bInSync  AND fbCaCamInDTCarryingLine.bInSync AND //AND fbCaCamInCarryingUpDown2.bInSync
			( ( fbCaCamInDTCarryingUpDown.bInSync AND iCaCamInSel2=1 ) OR   iCaCamInSel2=2 )      AND
			fbCamInGMBuffer.bInSync AND fbCamInGMDanserMove.bInSync  AND   fbCamInVirGMDriver.bInSync  AND 
			fbCamInRightYDUpDown.bInSync AND fbCamInRightYDLine.bInSync  AND
			CA_CarryingPos2 AND  AN_CarryingPos1 AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN						   
			Mach_Control.DTRunStatus.bSyncReady:=NOT bDiffVel[ Par.iStationNO];//20240504 CF
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
			arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=Mach_Control.DTRunStatus.bSyncStart OR bDiffVel[ Par.iStationNO];//TRUE; 20240504 CF
			DT_Ton[6].IN:=arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bMoveAbs;	
				IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs THEN
				  DPtime:=44;	
				END_IF	 
		ELSE
			Mach_Control.DTRunStatus.bSyncReady:=FALSE;//20240504 CF
			Mach_Control.DTRunStatus.bJumpSync:=TRUE;//20240504 CF		
		END_IF	
		
		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
			VirMain_TON.IN:=FALSE;
			Mach_Control.DTRunStatus.bSyncReady:=FALSE;//20240504 CF
			Mach_Control.DTRunStatus.bSyncStart:=FALSE;// 20240504 CF
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			DP_Step3:=400;//根据主轴在不同在位置，真空、破真空、标志位
			DP_Step4:=200;//判断主轴是否完成
			DP_Step5:=200;//判断主轴在运行过程中，正极叠片真空是否有报警
			DP_Step8:=200;//纠偏平台有无极片复检
			DP_Step0:=563;				
		ELSIF DT_Ton[6].Q THEN
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			Mach_Control.DTRunStatus.bSyncReady:=FALSE;//20240504 CF
			Mach_Control.DTRunStatus.bSyncStart:=FALSE;// 20240504 CF			
			Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
			DP_Step0:=10006;	
		ELSIF NOT arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bMoveAbs AND Mach_Control.U.DT_iMode<>1 THEN//切换到手动模式，如果主轴没启动直接j解耦 20240508 CF
			Mach_Control.DTRunStatus.bSyncReady:=FALSE;//20240504 CF
			Mach_Control.DTRunStatus.bSyncStart:=FALSE;// 20240504 CF	
			DP_Step1:=100;//解除耦合，主轴回零
			DP_Step0:=0;			
		END_IF											
	END_IF
END_IF
//END_CASE




////////////////////////////////////////////////////纠偏平台回原//////////////////////////////////////////////////////////////////
IF DP_Step0>6010THEN
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.fOverride:=50;
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.fOverride:=50;
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.fOverride:=50;
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.fOverride:=50;
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.fOverride:=50;
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.fOverride:=50;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.fOverride:=100;
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.fOverride:=100;
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.fOverride:=100;
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.fOverride:=100;
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.fOverride:=100;
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.fOverride:=100;
END_IF
	
	
IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下
CASE DP_Step11 OF	

 100://z正极纠偏平台回原
	 //正极纠偏X1负软限位
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[5]  THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=5;
			END_IF
	END_IF
	//正极纠偏X2负软限位
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[5]  THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=5;
			END_IF
	END_IF	
	//正极纠偏Y负软限位
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[5]  THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=5;
			END_IF
	END_IF					

		
	IF	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[5]  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[5]	 AND	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
					DP_Step11:=101; 
	END_IF	
						
 101://z正极纠偏平台回原
	 //正极纠偏X1正软限位
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[4]  THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=4;
			END_IF
	END_IF
	//正极纠偏X2正软限位
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[4]  THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=4;
			END_IF
	END_IF	
	//正极纠偏Y正软限位
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[4]  THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=4;
			END_IF
	END_IF					
				
			
	IF	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[4]  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[4]	 AND	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
					DP_Step11:=102; 
					  An_RectifydevGohomeTon.IN:=FALSE;
	END_IF				
	
102://z正极纠偏平台回原

	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.bHome:=TRUE;//正极纠偏X1回原
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.bHome:=TRUE;//正极纠偏X2回原				
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.bHome:=TRUE;//正极纠偏Y回原	
	DP_Step11:=110;	
110:
     IF NOT An_RectifydevGohomeTon.Q THEN				 
		    An_RectifydevGohomeTon.IN:=TRUE;
	 ELSE
			 IF  arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving  AND 
				 arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving  AND
				 arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving    THEN
				   arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.bHome:=FALSE;//正极纠偏X1		
				   arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.bHome:=FALSE;//正极纠偏X2
				   arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.bHome:=FALSE;//正极纠偏Y
				   An_RectifydevGohomeTon.IN:=FALSE;
				   DP_Step11:=120;	
			  ELSIF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Error OR 
					arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Error   THEN
					arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.bHome:=FALSE;//正极纠偏X1		
					arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.bHome:=FALSE;//正极纠偏X2
					arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.bHome:=FALSE;//正极纠偏Y
					Mach_Control.An_b.Error[29]:=TRUE;//正极CCD纠偏平台回原点超时报警
				//	An_RectifydevGohomeTon.IN:=FALSE;
				//	DP_Step11:=9999;
		 END_IF 
	 END_IF 		 
120:	
	tDtUse[2].IN:=FALSE;
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.bMoveAbs:=FALSE;
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.bMoveAbs:=FALSE;
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.bMoveAbs:=FALSE;  
	IF  Mach_Control.An_b.An_deviationFalg THEN
		DP_Step11:=130;
	ELSE
		DP_Step11:=140; 
	END_IF
	  
130:  
  	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.fPositon_of_Abs:=arrAxisPar[AxiseNo.AxisName.AndeviationX1].arrTargetPoint[2];
  	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.fPositon_of_Abs:=arrAxisPar[AxiseNo.AxisName.AndeviationX2].arrTargetPoint[2];
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.fPositon_of_Abs:=arrAxisPar[AxiseNo.AxisName.AndeviationY].arrTargetPoint[2];
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.bMoveAbs:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.bMoveAbs:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.bMoveAbs:=TRUE;
  	DP_Step11:=135;
135:
	tDtUse[2].IN:=TRUE;
	IF	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[2]  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[2]	 AND	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.bMoveAbs:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.bMoveAbs:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.bMoveAbs:=FALSE;
		DP_Step11:=6666; 
	ELSIF tDtUse[2].Q THEN
		tDtUse[2].IN:=FALSE;
		DP_Step11:=120; 
	END_IF
		
(*	   
	  //正极纠偏X1纠偏位
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving THEN
				IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[2]  THEN
					arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=0;
				ELSE
				   arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=2;
				END_IF
		END_IF
		//正极纠偏X2纠偏位
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving THEN
				IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[2]  THEN
					arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=0;
				ELSE
				   arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=2;
				END_IF
		END_IF	
		//正极纠偏Y纠偏位
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
				IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[2]  THEN
					arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=0;
				ELSE
				   arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=2;
				END_IF
		END_IF					

			
		IF	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[2]  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND
			arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND
			arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[2]	 AND	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
						DP_Step11:=6666; 
		END_IF	
*)
140:	
	//正极纠偏X1初始位
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1]  THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=1;
			END_IF
	END_IF
	//正极纠偏X2初始位
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1]  THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=1;
			END_IF
	END_IF	
	//正极纠偏Y初始位
	IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1]  THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=1;
			END_IF
	END_IF								
	
	IF 	arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1]	 AND	arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving THEN
					DP_Step11:=6666; 
	
	END_IF					     
		
END_CASE
	
	
	
CASE DP_Step12 OF	

100:	   
  	//负极纠偏X1负软限位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[5]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=5;
			END_IF	
	END_IF	
	//负极纠偏X2负软限位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[5]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=5;
			END_IF	
	END_IF	
	//负极纠偏Y负软限位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[5]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=5;
			END_IF	
	END_IF		
	  
	IF	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[5]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[5]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving  THEN	
		 DP_Step12:=101; 
	END_IF		
	
101:	   
  //负极纠偏X1正软限位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[4]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=4;
			END_IF	
	END_IF	
	//负极纠偏X2正软限位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[4]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=4;
			END_IF	
	END_IF	
	//负极纠偏Y正软限位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[4]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=4;
			END_IF	
	END_IF		
	  
	IF	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[4]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[4]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving  THEN	
		 DP_Step12:=102; 
		 Ca_RectifydevGohomeTon.IN:=FALSE;
	END_IF						

102://负极纠偏平台回原
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.bHome:=TRUE;//负极纠偏X1回原
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.bHome:=TRUE;//负极纠偏X2回原
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.bHome:=TRUE;//负极纠偏Y回原
	DP_Step12:=110;	
110:
 
	IF NOT Ca_RectifydevGohomeTon.Q THEN				 
		Ca_RectifydevGohomeTon.IN:=TRUE;
	ELSE
		 IF	 arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving  AND
			arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving    THEN
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.bHome:=FALSE;//负极纠偏X1	
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.bHome:=FALSE;//负极纠偏X2
			arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.bHome:=FALSE;//负极纠偏Y
			Ca_RectifydevGohomeTon.IN:=FALSE;
			DP_Step12:=120;	
		ELSIF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Error OR 
			arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Error THEN
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.bHome:=FALSE;//负极纠偏X1	
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.bHome:=FALSE;//负极纠偏X2
			arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.bHome:=FALSE;//负极纠偏Y
			Mach_Control.Ca_b.Error[29]:=TRUE;//负极CCD纠偏平台回原点超时报警
			//Ca_RectifydevGohomeTon.IN:=FALSE;
			//	DP_Step12:=9999;
		  END_IF 
 	END_IF  
120:	
	tDtUse[3].IN:=FALSE;  
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.bMoveAbs:=FALSE;
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.bMoveAbs:=FALSE;
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.bMoveAbs:=FALSE;
	IF  Mach_Control.Ca_b.Ca_deviationFalg THEN
		DP_Step12:=130;
	ELSE
		DP_Step12:=140; 
	END_IF
 
130:	
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.fPositon_of_Abs:=arrAxisPar[AxiseNo.AxisName.CadeviationX1].arrTargetPoint[2];
  	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.fPositon_of_Abs:=arrAxisPar[AxiseNo.AxisName.CadeviationX2].arrTargetPoint[2];
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.fPositon_of_Abs:=arrAxisPar[AxiseNo.AxisName.CadeviationY].arrTargetPoint[2];
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.bMoveAbs:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.bMoveAbs:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.bMoveAbs:=TRUE;
  	DP_Step12:=135;
135:
	tDtUse[3](IN:=DP_Step12<>6666, PT:=T#1S , Q=> , ET=> );
	IF	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[2]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[2]	 AND	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving THEN
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.bMoveAbs:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.bMoveAbs:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.bMoveAbs:=FALSE;
		DP_Step12:=6666; 
	ELSIF 	tDtUse[3].Q THEN
		DP_Step12:=120; 
	END_IF	
(*   
  //负极纠偏X1纠偏位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[2]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=2;
			END_IF	
	END_IF	
	//负极纠偏X2纠偏位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[2]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=2;
			END_IF	
	END_IF	
	//负极纠偏Y纠偏位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[2]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=2;
			END_IF	
	END_IF		
	  
	IF	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[2]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[2]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving  THEN	
		 DP_Step12:=6666; 
	END_IF
*)
140:	
	//负极纠偏X1初始位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=1;
			END_IF	
	END_IF	
	//负极纠偏X2初始位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=1;
			END_IF	
	END_IF	
	//负极纠偏Y初始位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1]   THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=0;
			ELSE
			   arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=1;
			END_IF	
	END_IF		
	
	IF	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving  THEN	
		 DP_Step12:=6666; 
	END_IF
	
END_CASE
END_IF

				
]]></ST>
      </Implementation>
    </Action>
    <Action Name="_01DT_Auto2" Id="{04f8d55f-4617-4a90-a831-30461344beb0}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[////////////////////////////////////////////////////////////////////////////////////运行中处理 流程//////////////////////////////////////////////////////////////////////////////////////////////
//主轴在运行时，真空、破真空，以及是否能取片、有无料标记
(*
IF VirMain_TagatTime<1 THEN
		CamOutArgel:=0.47*VirMain_TagatTime*360;
ELSE
		CamOutArgel:=160;
END_IF
*)

CamOutArgel:=170;

CASE DP_Step3 OF 
100://负极叠片，正极在取片位
	bStandbyStep1_1:=FALSE;
	bStandbyStep1_2:=FALSE;
	DP_Step3:=110; 
110:   //叠负极片同时 判断证据能否取片  提高效率
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=245    THEN
	//正送片搬运极取片处理
		IF   arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND 
			  NOT Mach_Control.An_b.An_CarryingFalg    AND  ( Mach_Control.An_b.An_MainBeltOK OR  Mach_Control.U.EmptyRunMode )  AND 
			  NOT  Mach_Control.An_b.An_MainBelting   AND NOT  bStandbyStep1_1 AND (NOT An_JumpRules[3]  AND NOT  An_JumpRules[6] AND NOT An_JumpRules[8] AND NOT An_JumpRules[10])(*AND NOT Mach_Control.An_b.JumpPiceReady *) THEN
			   An_Step0:=10;//正极取流水线子程序
			   bStandbyStep1_1:=TRUE;
		END_IF
		
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND 
		 Mach_Control.An_b.An_deviationDPOK AND NOT Mach_Control.An_b.An_DPCarryingFalg AND  
			Mach_Control.An_b.An_deviationFalg  AND  NOT  bStandbyStep1_2  AND NOT DP_CheseCam   AND
            NOT An_OverNGMark	THEN
			An_Step3:=10;//正极取纠偏平台子程序
			bStandbyStep1_2:=TRUE;
		END_IF
	
	ELSIF  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>245  THEN
			  IF NOT An_OverNGMark THEN
				  DP_Step3:=120;
			  ELSE	 
				  DP_Step3:=6666;
			 END_IF  
	END_IF		   
	
	
120:
   IF NOT An_OverNGMark THEN
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;//负极纠偏平台真空开			
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;//负极纠偏平台真空开			
  END_IF	
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260   THEN//198
		    IF   NOT An_OverNGMark THEN
					CCD.Over.Start.iPliesNo:=UINT_TO_INT(Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited+1);	
				    IF (CCD.Over.Start.iPliesNo MOD 2) <>1 OR CCD.Over.Start.iPliesNo=0 THEN
					   Mach_Control.DT_b.Error[69]:=TRUE;//负极对齐度拍照发送层数错误
				    END_IF
					
					Mach_Control.Ca_b.Ca_Rectifydev_CS:=0;
					CCD.Over.Start.stPoleNo:=Par.stDT_date.Ca_MQ_Slice[8].stPoleNo;
				
						arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运真空破
						arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运真空破
						arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=TRUE;//负极送片搬运真空破
						arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=FALSE;//负极送片搬运真空破
						arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;//负极纠偏平台真空开
						arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;//负极纠偏平台真空开			
				
						  Mach_Control.Ca_b.Ca_DPCarryingFalg :=FALSE;//复位负极叠片搬运吸盘上有料标记
						//IF Mach_Control.Ca_b.Ca_CarryingFalg THEN
							Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位纠偏平台上有料标记
							Mach_Control.Ca_b.Ca_CarryingFalg:=FALSE;//复位负极送片搬运吸盘上有料标记
						//END_IF
						Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[7];
			  END_IF
					
	END_IF	

		
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=339   THEN//198
		    IF   NOT An_OverNGMark THEN	
					IF NOT Ca_Number    THEN
						CCD.Over.Start.iPhotoDo:=1;
					ELSE
						CCD.Over.Start.iPhotoDo:=2;
					END_IF
					CCD.Over.Finish.OverhandResult:=0;
					Mach_Control.DT_b.CDD_OverStart:=TRUE;
			  END_IF
					DP_Step3:=121;
					
	END_IF	
121:
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=360 THEN//198
		 IF NOT An_OverNGMark THEN	
				arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极送片搬运真空开
				arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=TRUE;//负极送片搬运真空开
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空破
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运真空破
		   END_IF	
		DP_Step3:=6666;
	END_IF	
	
	
200://负极叠片，正极在取片位
		IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=20 THEN//20240508 CF
			An_Step0:=10;//调用正极取片程序
			DP_Step3:=202;		
		END_IF
	
202:
	IF iAnCamInSel2=1 AND NOT An_OverNGMark  THEN
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//正极送片搬运真空开
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极送片搬运真空开
	END_IF
	
	//fbAnDTCarryingVacuum.Vacuumsel:=SEL(iAnCamInSel2=1,0,1)     ;//	正极叠片搬运真空开	
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=235 THEN//复检提前
		IF Mach_Control.DT_b.DT_CCD_TwoModel THEN												
			CCD.AnRec.Finish.RectifyResult:=0;
			CCD.AnRec.Finish.RectifyX1:=0;
			CCD.AnRec.Finish.RectifyX2:=0;
			CCD.AnRec.Finish.RectifyY:=0;												
			Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
			CCD.AnRec.Start.iPhotoDo:=2;//第二次拍照	
		END_IF
		DP_Step3:=205;
	END_IF
205:			
	IF NOT DP_CheseCam  AND NOT  An_JumpRules[3]  AND NOT  An_JumpRules[6] AND NOT An_JumpRules[8] AND NOT An_JumpRules[10]    THEN
	
				IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=250  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=255 THEN	
					        IF NOT An_OverNGMark THEN
										//fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极升解除耦合															
										//fbAnCamInCarryingWhirling.bCamInExecute:=FALSE;//正极旋转解除耦合			
										//Mach_Control.An_b.An_MainBelting:=FALSE;//正极搬运升降取极片中																					
										IF  NOT  Mach_Control.Ca_b.Ca_deviationFPOK  THEN    //负极放片纠偏太未在初始位置报警  
												Mach_Control.Ca_b.Error_tips[1]:=TRUE ;
										END_IF											
										IF  NOT  Mach_Control.An_b.An_deviationDPOK  THEN    //正极取片纠偏未完成报警
												Mach_Control.An_b.Error_tips[1]:=TRUE;
										END_IF			
										IF Mach_Control.An_b.An_deviationDPOK OR Mach_Control.U.EmptyRunMode OR	TRUE  THEN // 
											arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//正极叠片搬运真空开	
											arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极叠片搬运真空开		
											An_deviationDPOKFalg:=TRUE;	
										ELSE		
											arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运真空关					
											arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运真空关												
											fbAnCamInDTCarryingUpDown.bCamInExecute:=FALSE;	//正极叠片搬运升降凸轮解耦				
											IF NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4]    THEN
													arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;   //到等待位
											END_IF			
										END_IF	
										//IF NOT Mach_Control.An_b.JumpPiceReady THEN
											//An_Step0:=10;//调用正极取片程序	  20240509 CF
										//END_IF
										DP_Step3:=210;				
							 ELSE
							        DP_Step3:=210;	
				             END_IF
				 END_IF			 
	ELSE
									DP_Step3:=210;									
    END_IF

210:
	//打开或关闭真空，标记对应位置有料
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260 THEN//198
		  IF  NOT An_OverNGMark THEN
					CCD.Over.Start.iPliesNo:=UINT_TO_INT(Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited+1);
				    IF (CCD.Over.Start.iPliesNo MOD 2) <>1 OR CCD.Over.Start.iPliesNo=0 THEN
					   Mach_Control.DT_b.Error[69]:=TRUE;//负极对齐度拍照发送层数错误
				    END_IF					
					
					CCD.Over.Start.stPoleNo:=Par.stDT_date.Ca_MQ_Slice[8].stPoleNo;
							Mach_Control.Ca_b.Ca_Rectifydev_CS:=0;
					
							arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=TRUE;//负极送片搬运真空关
							arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=FALSE;//负极送片搬运真空关
							arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运直空关
							arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运直空关
							arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;//负极纠偏平台真空开	
							arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;//负极纠偏平台真空开		
							
							Mach_Control.Ca_b.Ca_DPCarryingFalg :=FALSE;//复位负极叠片搬运吸盘上有料标记
							//IF Mach_Control.Ca_b.Ca_CarryingFalg THEN
								Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位纠偏平台上有料标记
								Mach_Control.Ca_b.Ca_CarryingFalg:=FALSE;//复位负极送片搬运吸盘上有料标记
							//END_IF
							Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[7];
							IF An_deviationDPOKFalg AND  iAnCamInSel2=1   THEN
									Par.stDT_date.An_MQ_Slice[2]:=Par.stDT_date.An_MQ_Slice[1];
									//IF Mach_Control.An_b.An_deviationFalg THEN
										Mach_Control.An_b.An_DPCarryingFalg :=TRUE;//复位正极叠片搬运吸盘上有料标记										
										Mach_Control.An_b.An_deviationFalg:=FALSE;//置位纠偏平台上有料标记	
									//END_IF										
									arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=TRUE;//正极纠偏平台真空关
									arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=FALSE;//正极纠偏平台真空关
									arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bON:=TRUE;//正极纠偏平台破真空开	
									arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bOFF:=FALSE;//正极纠偏平台破真空开	
							 END_IF			
							(*	
								ELSIF NOT   DP_CheseCam THEN								
									An_Step3:=10;//正极叠片搬运取纠偏台极片	
							*)																					
	        END_IF
				 
				 
	END_IF
	
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=339 THEN//198
		  IF  NOT An_OverNGMark THEN
				IF NOT Ca_Number  THEN
					CCD.Over.Start.iPhotoDo:=1;
				ELSE
					CCD.Over.Start.iPhotoDo:=2;
				END_IF
				CCD.Over.Finish.OverhandResult:=0;
				Mach_Control.DT_b.CDD_OverStart:=TRUE;			
	       END_IF
				 
			IF NOT Ca_Number THEN
				DP_Step3:=211;					
			END_IF
	END_IF
	

211:
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=360 THEN//198	
		 IF NOT An_OverNGMark THEN	
				arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极送片搬运真空开
				arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=TRUE;//负极送片搬运真空开
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运直空开
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运直空开
		END_IF		
		DP_Step3:=6666;					
	END_IF
			



		
300://正极叠片，负极在取片位			
	bStandbyStep1_3:=FALSE;
	bStandbyStep1_4:=FALSE;
	DP_Step3:=310; 		
310:	
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=245    THEN
		//正送片搬运极取片处理
		IF   arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] AND 
			NOT Mach_Control.Ca_b.Ca_CarryingFalg    AND  ( Mach_Control.Ca_b.Ca_CacheBeltDLOK OR  Mach_Control.U.EmptyRunMode )  AND 
			NOT  Mach_Control.Ca_b.Ca_CacheBelting   AND NOT  bStandbyStep1_3 	 THEN
			Ca_Step0:=10;   //负极取流水线子程序
			bStandbyStep1_3:=TRUE;
		END_IF
	
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] AND 
			Mach_Control.Ca_b.Ca_deviationDPOK AND NOT Mach_Control.Ca_b.Ca_DPCarryingFalg AND  
			Mach_Control.Ca_b.Ca_deviationFalg AND  NOT  bStandbyStep1_4   
           AND   NOT Ca_OverNGMark THEN
			Ca_Step3:=10;     //负极取纠偏平台子程序
			bStandbyStep1_4:=TRUE;
		END_IF					
	ELSIF  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>245  THEN
		    IF  NOT Ca_OverNGMark THEN
			      DP_Step3:=320; 
			ELSE	  
				  DP_Step3:=6666;	
			END_IF		  
	END_IF	
	
320://正极叠片，负极在取片位
   IF NOT Ca_OverNGMark THEN
		arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//正极纠偏平台真空开			
		arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//正极纠偏平台真空开		
	END_IF					
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260 THEN//198

		IF NOT Ca_OverNGMark THEN
				CCD.Over.Start.iPliesNo:=UINT_TO_INT(Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited+1);
				    IF (CCD.Over.Start.iPliesNo MOD 2) <>0 OR CCD.Over.Start.iPliesNo=0 THEN
					   Mach_Control.DT_b.Error[68]:=TRUE;//正极对齐度拍照发送层数错误
				    END_IF				
				
				CCD.Over.Start.stPoleNo:=Par.stDT_date.An_MQ_Slice[2].stPoleNo;
				Mach_Control.An_b.An_Rectifydev_CS:=0;				
		
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;//正极送片搬运真空关
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;//正极送片搬运真空关
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运破真空开
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极送片搬运破真空开
				
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极送片搬运真空关
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极送片搬运真空关
				//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运破真空开
				//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极送片搬运破真空开
				
				arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//正极纠偏平台真空开		
				arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//正极纠偏平台真空开		
				
				
				Mach_Control.An_b.An_DPCarryingFalg :=FALSE;//复位正极叠片搬运吸盘上有料标记
				//IF Mach_Control.An_b.An_CarryingFalg THEN
					Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台上有料标记
					Mach_Control.An_b.An_CarryingFalg:=FALSE;//复位正极送片搬运吸盘上有料标记
				//END_IF
				Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[0];
	      END_IF				
	 END_IF

	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=339 THEN//198
		   IF NOT Ca_OverNGMark THEN
				IF NOT An_Number  THEN
					CCD.Over.Start.iPhotoDo:=1;
				ELSE
					CCD.Over.Start.iPhotoDo:=2;
				END_IF
				CCD.Over.Finish.OverhandResult:=0;
				Mach_Control.DT_b.CDD_OverStart:=TRUE;	
	       END_IF      
		  DP_Step3:=6666;	
	END_IF	
			

400:	//复检提前------//正极叠片，负极在叠片位
		IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=20 THEN//20240508 CF																			
			Ca_Step0:=10;//调用负极取片程序       取片允许条件在子程序里
			DP_Step3:=402;
		END_IF

402:	
	//fbCaDTCarryingVacuum.Vacuumsel:= SEL(iCaCamInSel2=1 ,0,1)   ;//	负极叠片搬运真空开
	IF iCaCamInSel2=1 AND NOT Ca_OverNGMark THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠台搬运真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠台搬运真空开		
	END_IF

	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=235 THEN//198
		IF Mach_Control.DT_b.DT_CCD_TwoModel THEN
				CCD.CaRec.Finish.RectifyX1:=0;
				CCD.CaRec.Finish.RectifyX2:=0;
				CCD.CaRec.Finish.RectifyY:=0;		
				CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零									
				Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
				CCD.CaRec.Start.iPhotoDo:=2;//启动CCD第二次拍照									
		END_IF
		DP_Step3:=405;
	END_IF
405:		
 
				IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=250  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=255 THEN		
						  IF  NOT Ca_OverNGMark	  THEN															
										IF  NOT  Mach_Control.An_b.An_deviationFPOK  THEN    //正极放片纠偏太未在初始位置报警  
											  Mach_Control.An_b.Error_tips[2]:=TRUE ;
										END_IF
										
										IF  NOT  Mach_Control.Ca_b.Ca_deviationDPOK  THEN    //负极取片纠偏未完成报警
											  Mach_Control.Ca_b.Error_tips[2]:=TRUE ;
										END_IF		
								
										//正极叠片时平移到位后判断正极纠偏台是否允许放片
										IF Mach_Control.An_b.An_deviationFPOK OR Mach_Control.U.EmptyRunMode  THEN 
												An_deviationFPOKFalg:=TRUE;//正极纠偏平台允许放片标记
										ELSE									
											fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;	//正极送片搬运升降凸轮解耦				
											IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4]    THEN
												arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;
											END_IF;				
										END_IF					
										IF Mach_Control.Ca_b.Ca_deviationDPOK OR Mach_Control.U.EmptyRunMode OR TRUE  THEN //  
											Ca_deviationDPOKFalg:=TRUE;	
											arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空开	
											arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运真空开		
										ELSE	
											//arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空开									
											fbCaCamInDTCarryingUpDown.bCamInExecute:=FALSE;	//负极叠片搬运升降凸轮解耦				
											IF NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4]    THEN
												arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;   //到等待位
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;   //到等待位
											END_IF;				
										END_IF			
											//Ca_Step0:=10;//调用负极取片程序       取片允许条件在子程序里 20240509 CF
											DP_Step3:=410;	
							ELSE
										   DP_Step3:=6666;			
							END_IF									
									
	           END_IF
	
(*	
	//判断是否允许负极送片搬运取料
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=CamOutArgel  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=(CamOutArgel+5) THEN
		IF (Mach_Control.Ca_b.Ca_CacheBeltDLOK AND NOT fbCaCamInCarryingUpDown2OutCamFlge) OR Mach_Control.U.EmptyRunMode  THEN
			Mach_Control.Ca_b.Ca_CacheBelting:=TRUE;//f负极搬运升降取极片中	
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极送片搬运真空开
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=TRUE;//负极送片搬运真空开
		ELSE
			//arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极送片搬运真空开
			fbCaCamInCarryingUpDown2.bCamInExecute:=FALSE;//负极升解除耦合
			Mach_Control.Ca_b.Ca_CacheBelting:=FALSE;
		END_IF								
	END_IF
	//解除负极搬运升降凸轮耦合标记
	fbCaCamInCarryingUpDown2OutCam_F_TRIG(CLK:=fbCaCamInCarryingUpDown2.bCamInExecute , Q=> );
	IF fbCaCamInCarryingUpDown2OutCam_F_TRIG.Q THEN
		fbCaCamInCarryingUpDown2OutCamFlge:=TRUE;//负极升降2凸轮解耦标记
	END_IF	
*)			
410:							
	//打开或关闭真空，标记对应位置有料
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260 THEN//198
		CCD.Over.Start.iPliesNo:=UINT_TO_INT(Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited+1);	
		IF (CCD.Over.Start.iPliesNo MOD 2) <>0 OR CCD.Over.Start.iPliesNo=0 THEN
		   Mach_Control.DT_b.Error[68]:=TRUE;//正极对齐度拍照发送层数错误
		END_IF	
	
		Mach_Control.An_b.An_Rectifydev_CS:=0;
			
					CCD.Over.Start.stPoleNo:=Par.stDT_date.An_MQ_Slice[2].stPoleNo;
				(*	
					arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;//正极送片搬运真空关
					arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运破真空开
					arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极叠片搬运真空关
					arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运破真空开
				*)	
					arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;//正极送片搬运真空关
					arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;//正极送片搬运真空关
					arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运破真空开
					arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极送片搬运破真空开
					
					arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极送片搬运真空关
					arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极送片搬运真空关
					//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运破真空开
				//	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极送片搬运破真空开	
					
					arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//正极纠偏平台真空开	
					arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//正极纠偏平台真空开	
			
					Mach_Control.An_b.An_DPCarryingFalg :=FALSE;//复位正极叠片搬运吸盘上有料标记
					//IF Mach_Control.An_b.An_CarryingFalg THEN
						Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台上有料标记
						Mach_Control.An_b.An_CarryingFalg:=FALSE;//复位正极送片搬运吸盘上有料标记
					//END_IF
					
					Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[0];
					
					(*
					IF (Mach_Control.Ca_b.Ca_CacheBelting AND NOT fbCaCamInCarryingUpDown2OutCamFlge) OR Mach_Control.U.EmptyRunMode  THEN
						Mach_Control.Ca_b.Ca_CarryingFalg:=TRUE;//复位负极送片搬运吸盘上有料标记
						Par.stDT_date.Ca_MQ_Slice[7]:=Par.stDT_date.Ca_MQ_Slice[6];
					END_IF*)
					
					
					arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bStop:=FALSE;
				


		//判断负极纠偏台是否允许取料
		IF Ca_deviationDPOKFalg AND NOT DP_CheseCam AND iCaCamInSel2=1 AND   NOT Ca_OverNGMark	 THEN		
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠台搬运真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠台搬运真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=TRUE;//负极纠偏平台真空关
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=FALSE;//负极纠偏平台真空关
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bON:=TRUE;//负极纠偏平台破真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bOFF:=FALSE;//负极纠偏平台破真空开		
			//IF 	Mach_Control.Ca_b.Ca_deviationFalg THEN				
				Mach_Control.Ca_b.Ca_DPCarryingFalg :=TRUE;//置位负极叠片搬运吸盘上有料标记			
				Mach_Control.Ca_b.Ca_deviationFalg:=FALSE;//复位负极纠偏平台上有料标记	
			//END_IF			
			Par.stDT_date.Ca_MQ_Slice[9]:=Par.stDT_date.Ca_MQ_Slice[8];
		(*	
		ELSE   
			Ca_Step3:=10;//负极叠片搬运取纠偏台极片	
		*)	   
		END_IF									

		//判断正极纠偏台是否允许放料
		IF  NOT Ca_OverNGMark	 THEN		
				IF An_deviationFPOKFalg THEN			
					arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运真空关
					arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极送片搬运破真空开
					arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//正极纠偏平台真空开		
					arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//正极纠偏平台真空开	
					//IF Mach_Control.An_b.An_CarryingFalg THEN	
						Mach_Control.An_b.An_deviationFalg:=TRUE;//置位正极纠偏平台上有料标记
						Mach_Control.An_b.An_CarryingFalg:=FALSE;//复位正极送片搬运吸盘上有料标记						
					//END_IF			
					Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[0];//送片机械手传送至纠偏平台
					ELSE   
						An_Step1:=10;//正极送片搬运放片到纠偏台			   
					END_IF
			END_IF 
	END_IF

	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=339 THEN//198
		 IF NOT Ca_OverNGMark THEN
				IF NOT An_Number THEN
					CCD.Over.Start.iPhotoDo:=1;
				ELSE
					CCD.Over.Start.iPhotoDo:=2;
				END_IF
				CCD.Over.Finish.OverhandResult:=0;
				Mach_Control.DT_b.CDD_OverStart:=TRUE;	
	    END_IF
			
		IF NOT An_Number THEN
			DP_Step3:=6666;					
		END_IF

	
	END_IF
	

END_CASE



//判断主轴是否完成
CASE  DP_Step4 OF
100://叠负极主轴定位完成判断	
		//叠负极主轴在当前周期220度之前对齐度NG为上一片结果
      IF (((arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>10 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<230) AND 
           (CCD.Over.Finish.OverhandResult=2 OR  CCD.Over.Finish.OverhandResult=3 OR CCD.Over.Finish.OverhandResult=4 ) ) OR
		  (arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=230 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<235 AND 
           CCD.Over.Finish.OverhandResult=0  ))  AND
           NOT Mach_Control.DT_b.DT_Overhang AND  NOT  Mach_Control.U.EmptyRunMode AND NOT Mach_Control.DT_b.DT_Sheetkick AND  
           Mach_Control.Ca_b.Ca_Quantited>0  AND NOT Ca_OverNGMark AND NOT OversequelNG AND NOT Bnt_Blueflaging THEN
		  An_OverNGMark:=TRUE;//上一片正极对齐度NG标记
	  END_IF

	  
	 IF  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>240  THEN 
	      Ca_OverNGMark:=FALSE;
	  END_IF
	   
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		//如果，叠片搬运掉片报警就不计数		
		IF NOT Ca_Number AND NOT An_OverNGMark THEN
						Mach_Control.Ca_b.Ca_Quantited:=Mach_Control.Ca_b.Ca_Quantited+1;
						DPcount:=DPcount+1;
						IF Mach_Control.U.EmptyRunMode THEN
							Mach_Control.Ca_b.Ca_EmptyRunKDQuantited:=Mach_Control.Ca_b.Ca_EmptyRunKDQuantited +1;
						//			ELSE
						//				Mach_Control.Ca_b.Ca_EmptyRunKDQuantited:=0;
						END_IF
						Par.stDT_date.YD_JS_L:=Par.stDT_date.YD_JS_L+1;
						Par.stDT_date.YD_ferrJS:=Par.stDT_date.YD_ferrJS+1;
						Mach_Control.Ca_b.Ca_CCD_amount:=0;
							//叠台升降轴下降
							IF NOT Mach_Control.U.EmptyRunMode  THEN
								arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness+Par.stDT_date.Pole_ThicknessCom);
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-Par.stDT_date.SEPTA_Thickness;
							END_IF
							IF Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited>3 THEN
								arrAxisPar[AxiseNo.AxisName.DTUpDown].fVelocity_of_Rel:=100;
								arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bMoveRel:=TRUE;
							END_IF
		END_IF
		Mach_Control.An_b.An_CCDStart :=FALSE;//启动CCD拍照						
		DP_Step1:=100;//解除耦合，主轴回零子程序
	    

		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF
		
		//DP_Step0:=0;
		Ca_AlarmTON[11].IN:=FALSE;
		IF Ca_Number  OR An_OverNGMark THEN
			DP_Step6:=6666;
		ELSIF Mach_Control.DT_b.DT_Overhang THEN
			DP_Step6:=102;
		ELSE
			DP_Step6:=101;
		END_IF	
		DP_Step4:=110;
        DPtime:=10;	
	END_IF;	
110:
	IF ((*Ca_deviationFPOKFalg OR*) Ca_Step1=6666 OR Ca_Step1=0) AND ((*An_deviationDPOKFalg OR *)An_Step3=6666 OR An_Step3=0)  
		AND ((An_Step0=6666 OR An_Step0=0) OR Mach_Control.An_b.An_Quantited=Par.stDT_date.An_Quantity )  THEN         
		DP_Step4:=6666;
			IF   NOT An_OverNGMark THEN
	        	DP_Step0:=0;
				DPtime:=11;	
		       Ca_deviationFPOKFalg:=FALSE;
		       An_deviationDPOKFalg:=FALSE;  
			ELSE   
			    DP_Step0:=10;
		     	An_OverNGStep:=1000;	//踢正极对齐度NG片
				 CCD.Over.Finish.OverhandResult:=0;	
	       END_IF;				
	END_IF



		
200:	//叠正极主轴定位完成判断
	  //叠正极主轴在当前周期220度之前对齐度NG为上一片结果
	   IF (((arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>10 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<230) AND 
           (CCD.Over.Finish.OverhandResult=2 OR  CCD.Over.Finish.OverhandResult=3 OR CCD.Over.Finish.OverhandResult=4 )) OR
           (arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=230 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<235 AND 
            CCD.Over.Finish.OverhandResult=0))  AND     
           NOT Mach_Control.DT_b.DT_Overhang AND NOT  Mach_Control.U.EmptyRunMode  AND NOT Mach_Control.DT_b.DT_Sheetkick AND
           Mach_Control.Ca_b.Ca_Quantited>0  AND NOT An_OverNGMark AND NOT OversequelNG AND NOT Bnt_Blueflaging THEN
		  Ca_OverNGMark:=TRUE;//上一片负极对齐度NG标记
	  END_IF
	
	 	 IF  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>240 THEN 
	      An_OverNGMark:=FALSE;
	  END_IF 
	  
	
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		//如果，叠片搬运掉片报警就不计数				
		IF NOT An_Number AND NOT Ca_OverNGMark THEN
						Mach_Control.An_b.An_Quantited:=Mach_Control.An_b.An_Quantited+1;
						DPcount:=DPcount+1;			
						IF Mach_Control.U.EmptyRunMode THEN
							Mach_Control.An_b.An_EmptyRunKDQuantited:=Mach_Control.An_b.An_EmptyRunKDQuantited +1;
						//			ELSE
						//				Mach_Control.An_b.An_EmptyRunKDQuantited:=0;
						END_IF
						Par.stDT_date.YD_JS_R:=Par.stDT_date.YD_JS_R+1;
						Mach_Control.An_b.An_CCD_amount:=0;
						//叠台升降轴下降
						IF NOT Mach_Control.U.EmptyRunMode  THEN
								arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-(Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness+Par.stDT_date.Pole_ThicknessCom);
						ELSE
								arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-Par.stDT_date.SEPTA_Thickness;
						END_IF
						IF Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited>3 THEN
								arrAxisPar[AxiseNo.AxisName.DTUpDown].fVelocity_of_Rel:=100;
								arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bMoveRel:=TRUE;
						END_IF	
		END_IF
		Mach_Control.Ca_b.Ca_CCDStart :=FALSE;//启动CCD拍照			
		DP_Step1:=100;//解除耦合，主轴回零	
        
		(*
		IF  (Mach_Control.Ca_b.Ca_CacheBelting AND NOT fbCaCamInCarryingUpDown2OutCamFlge) OR Mach_Control.U.EmptyRunMode  THEN
			Par.stDT_date.Ca_betlCount.5:=FALSE;//复位负极流水线极片标记
			Mach_Control.Ca_b.Ca_CacheBelting:=FALSE;
		END_IF	*)
	
						
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bOFF:=TRUE;//负极纠偏平台破真空关	
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF							
		//DP_Step0:=0;
		An_AlarmTON[11].IN:=FALSE;
		IF An_Number OR Ca_OverNGMark THEN
			  DP_Step7:=6666;
		ELSIF  Mach_Control.DT_b.DT_Overhang THEN
			  DP_Step7:=202;
		ELSE
			  DP_Step7:=201;
		END_IF
		DP_Step4:=210;	
		DPtime:=20;	
		(*	
			IF  Mach_Control.DT_b.DT_Overhang AND NOT An_Number THEN
				  DP_Step7:=202;
			ELSIF An_Number THEN
				  DP_Step7:=6666;
			ELSE
				  DP_Step7:=201;
			END_IF
			DP_Step4:=6666;	
		*)
	END_IF;	
210:
	IF ((*An_deviationFPOKFalg OR *)An_Step1=6666 OR An_Step1=0) AND ((*Ca_deviationDPOKFalg OR *)Ca_Step3=6666 OR Ca_Step3=0) 
	AND (Ca_Step0=6666 OR Ca_Step0=0) THEN       
          	DP_Step4:=6666;
          IF NOT Ca_OverNGMark THEN
				DP_Step0:=0;
				DPtime:=21;	
				An_deviationFPOKFalg:=FALSE;
				Ca_deviationDPOKFalg:=FALSE; 
			ELSE	
			    DP_Step0:=20;
		     	Ca_OverNGStep:=1000;	//踢负极对齐度NG片
                CCD.Over.Finish.OverhandResult:=0;	
          END_IF
			
	END_IF

			
END_CASE



//观察NG片用，发现问题后删除
IF Ca_NGTest1.Q THEN
	Ca_NG:=Ca_NG+1;
END_IF


CASE  DP_Step5 OF
100://判断主轴运行时负极叠片搬运升降真空报警
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>0 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<235 THEN
		IF Ca_Number OR An_OverNGMark  THEN	
			IF Ca_Number THEN
				AnOverNGcount:=0; 
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运破真空开	
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运破真空开	
			END_IF	
				DP_Step5:=110;
		END_IF
		Ca_NGTest1(CLK:=(CCD.CaRec.Finish.RectifyResult=2) , Q=> );
	ELSE
		AnOverNGcount:=0; 
		DP_Step5:=6666;
	END_IF

110://叠负极主轴220度之前有对齐度NG, 负极送片搬运升降、负极叠台搬运升降、右压刀开合、右压刀升降、正极叠台搬运升降轴解耦  ,踢掉上一片正极
	fbCaCamInDTCarryingUpDown.bCamInExecute:=FALSE;//负极叠片搬运升降
	fbCamInLeftYDUpDown.bCamInExecute:=FALSE;//左压刀升降
	fbCamInLeftYDLine.bCamInExecute:=FALSE;//左压刀开合
	IF  An_OverNGMark THEN
		fbCaCamInCarryingUpDown2.bCamInExecute:=FALSE;//负极s送片搬运升降
		fbAnCamInDTCarryingUpDown.bCamInExecute:=FALSE;//正极叠片搬运升降
		IF NOT Mach_Control.An_b.An_DPCarryingFalg THEN
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运真空真空关
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运真空真空关
		END_IF	
	END_IF
	 
	IF NOT  fbCaCamInDTCarryingUpDown.bCamInExecute AND NOT fbCamInLeftYDUpDown.bCamInExecute AND NOT  fbCamInLeftYDLine.bCamInExecute AND 
        (( NOT  fbCaCamInCarryingUpDown2.bCamInExecute AND NOT  fbAnCamInDTCarryingUpDown.bCamInExecute ) OR NOT An_OverNGMark )   THEN
	       IF Ca_Number THEN
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空开
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运真空开
			END_IF	
			DP_Step5:=120;
	END_IF

120:
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bGearOut:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bGearOut:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bGearOut:=TRUE;
	IF  An_OverNGMark THEN
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bGearOut:=TRUE;
		arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bGearOut:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Coupled AND 
       NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Coupled  AND 
         (( NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Coupled  AND NOT  arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Coupled )  OR NOT An_OverNGMark ) THEN
		arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bGearOut:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bGearOut:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bGearOut:=FALSE;
		IF  An_OverNGMark THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bGearOut:=FALSE;
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bGearOut:=FALSE;
		END_IF
		DP_Step5:=130;
	END_IF

130:
	IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND 
		NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
			  IF Ca_Number THEN
					arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空开
					arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运真空开
			  END_IF		
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极叠片升降移动至等待高度
		END_IF
	
     IF An_OverNGMark THEN
					IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Error THEN
							IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
								arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=4;//负极送片升降移动至等待高度
							END_IF	
					 END_IF
					 
					IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error THEN
							IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
								arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极叠片升降移动至等待高度
							END_IF		
					END_IF
		END_IF			
		
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4]  AND
			( (arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4]  AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4]) OR NOT An_OverNGMark ) THEN
      		DP_Step5:=6666;
		END_IF
	END_IF







200://判断主轴运行时正极叠片搬运升降真空报警
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>0 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<235 THEN
		IF An_Number OR Ca_OverNGMark THEN	
			IF An_Number THEN
				CaOverNGcount:=0;
		    //	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运破真空开	
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运真空真空关
			    arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运真空真空关
			END_IF
			DP_Step5:=210;
		END_IF
	ELSE
		CaOverNGcount:=0; 
		DP_Step5:=6666;
	END_IF

210://叠正极主轴220度之前有对齐度NG, 正极送片搬运升降、正极叠台搬运升降、右压刀开合、右压刀升降、负极叠台搬运升降轴解耦  ,踢掉上一片负极
	fbAnCamInDTCarryingUpDown.bCamInExecute:=FALSE;//正极叠片搬运升降
	fbCamInRightYDUpDown.bCamInExecute:=FALSE;//右压刀升降
	fbCamInRightYDLine.bCamInExecute:=FALSE;//右压刀开会
	IF Ca_OverNGMark THEN
		fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极送片搬运升降
	    fbCaCamInDTCarryingUpDown.bCamInExecute:=FALSE;//负极叠片搬运升降
		IF NOT Mach_Control.Ca_b.Ca_DPCarryingFalg THEN
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠台搬运真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠台搬运真空开			
		END_IF	
	END_IF
	
	IF NOT fbAnCamInDTCarryingUpDown.bCamInExecute AND NOT fbCamInRightYDUpDown.bCamInExecute AND NOT fbCamInRightYDLine.bCamInExecute AND 
       (( NOT fbAnCamInCarryingUpDown.bCamInExecute AND NOT  fbCaCamInDTCarryingUpDown.bCamInExecute) OR NOT Ca_OverNGMark)  THEN
		IF An_Number THEN 
      		//arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=FALSE;//正极叠片搬运破真空关	
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运真空真空关
			    arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运真空真空关			
		END_IF
		DP_Step5:=220;
	END_IF
220:
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bGearOut:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bGearOut:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bGearOut:=TRUE;
	IF Ca_OverNGMark THEN
		arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bGearOut:=TRUE;
	   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bGearOut:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Coupled AND
		NOT arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Coupled  AND
      (( NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Coupled) OR NOT Ca_OverNGMark) THEN
		arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bGearOut:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bGearOut:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bGearOut:=FALSE;
		IF Ca_OverNGMark THEN
			arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.bGearOut:=FALSE;
		    arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bGearOut:=FALSE;			
		END_IF
		DP_Step5:=230;
	END_IF

230:
	IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
	NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极叠片升降移动至等待高度
		END_IF
	END_IF
	
	IF Ca_OverNGMark THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.NoMoving AND 
	        NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
					arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=0;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;//正极送片升降移动至等待高度
				END_IF
    	END_IF	
	
			IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND 
	            NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极叠片升降移动至等待高度
				END_IF
    	  END_IF	
	END_IF
	
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND
           (( arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] )OR NOT Ca_OverNGMark)  THEN
			  DP_Step5:=6666;	
		END_IF

END_CASE


(**********************负极OH闭环纠偏************************************)
	//负极对齐度闭环计算  20240415SJ
 IF  Mach_Control.Ca_b.Ca_Quantited =0 THEN
		   iCaOverhandCount1_Y:=1; 
		   fCaSUMMean_Y:=0;
		   iCaOverhandCount2_Y:=0;   
END_IF
 IF  Mach_Control.Ca_b.Ca_Quantited =0 THEN
		   iCaOverhandCount1_X:=1; 
		   fCaSUMMean_X:=0;
		   iCaOverhandCount2_X:=0;   
END_IF


CASE DP_Step6 OF
101:
    IF Ca_OverNGMark THEN
        DP_Step6:=6666;
	ELSIF (CCD.Over.Finish.OverhandResult=4 OR CCD.Over.Finish.OverhandResult=2 OR CCD.Over.Finish.OverhandResult=1 ) AND NOT Ca_Number 
		AND( (arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>10 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<235) (*OR (arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos=360)*)) THEN		
		DP_Step6:=102;
	ELSIF Ca_Number OR Mach_Control.U.EmptyRunMode OR Mach_Control.DT_b.DT_Overhang THEN//负极报警，空跑模式，Overhang屏蔽直接跳过
		DP_Step6:=6666;
	ELSIF NOT Ca_Number AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>235 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<360 
		AND  CCD.Over.Finish.OverhandResult=0   THEN
		Mach_Control.Ca_b.Error[25]:=TRUE;//负极极片对齐度检测返回结果超时
		Par.stDT_date.Overhang_CSJS:=Par.stDT_date.Overhang_CSJS+1;
		DP_Step6:=6666;
	ELSIF CCD.Over.Finish.OverhandResult=3   THEN		
		Mach_Control.Ca_b.Error[27]:=TRUE;  //负极极片对齐度检测返回结果无片报警
		DP_Step6:=102;
	END_IF
					
102:
	CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_Result[CCD.Over.Start.iPliesNo]:=CCD.Over.Finish.OverhandResult;	
	CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension2[CCD.Over.Start.iPliesNo]:=LIMIT(150, Mach_Control.DT_b.DiaphragmUnwindingTension,250);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_Overhang_A_C[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_Overhang_S_CIL[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_No_Overhang_A_C[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX4);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_No_Overhang_S_A[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_L_Overhang_A_C[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_L_Overhang_S_A[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_R_Overhang_A_C[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY4);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_R_Overhang_S_A[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Cell_Overhang:=ABS(CCD.Over.Finish.AddOverhangX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Cell_Overhang_No:=ABS(CCD.Over.Finish.AddOverhangX4);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Cell_Overhang_L:=ABS(CCD.Over.Finish.AddOverhangY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Cell_Overhang_R:=ABS(CCD.Over.Finish.AddOverhangY4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_PoleOverhandX2[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_PoleOverhandX3[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_PoleOverhandY2[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_PoleOverhandY3[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AnCaOverhandX2[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AnCaOverhandX3[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AnCaOverhandY2[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AnCaOverhandY3[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AddOverhangX2:=ABS(CCD.Over.Finish.AddOverhangX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AddOverhangX3:=ABS(CCD.Over.Finish.AddOverhangX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AddOverhangY2:=ABS(CCD.Over.Finish.AddOverhangY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AddOverhangY3:=ABS(CCD.Over.Finish.AddOverhangY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_MQ_Slice[Mach_Control.Ca_b.Ca_Quantited]:=Par.stDT_date.Ca_MQ_Slice[9];
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].Serialnumber:=CCD.Over.Start.iPliesNo;
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].Polarity:=1;
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].Platenumber:=Par.stDT_date.Ca_MQ_Slice[9].stPoleNo;
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].CalapTen:=Par.stDT_date.Ca_MQ_Slice[9].UnreelingTension;
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].GMlapTen:=LIMIT(150, Mach_Control.DT_b.DiaphragmUnwindingTension,250);
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].GMlapRectify:=LIMIT( Par.stDT_date.fRectifyBalanceValue-0.2,  Mach_Control.DT_b.RecDevPV,Par.stDT_date.fRectifyBalanceValue+0.2);
	
	Ca_AlarmTON[11].IN:=FALSE;
	
	IF  CCD.Over.Finish.OverhandResult=1 THEN
		//计算当前 Y1 Y2    Y3 Y4中值
       fCaMeanSingle_Y:= ( (CCD.Over.Finish.AnCaOverhandY1+CCD.Over.Finish.AnCaOverhandY2)*0.5 - (CCD.Over.Finish.AnCaOverhandY3+CCD.Over.Finish.AnCaOverhandY4)*0.5 )*0.5;  //当前片Y方向 
	   fCaSUMMean_Y:=fCaSUMMean_Y+fCaMeanSingle_Y;
	   iCaOverhandCount2_Y:=iCaOverhandCount2_Y+1;

		//计算当前 X2 X4   X1 X3中值
       fCaMeanSingle_X:= (   ( (CCD.Over.Finish.AnCaOverhandX2+CCD.Over.Finish.AnCaOverhandX4)*0.5-1)   -  ( (CCD.Over.Finish.AnCaOverhandX1+CCD.Over.Finish.AnCaOverhandX3)*0.5-1.5 )   )*0.5;  //当前片Y方向 
	   fCaSUMMean_X:=fCaSUMMean_X+fCaMeanSingle_X;
	   iCaOverhandCount2_X:=iCaOverhandCount2_X+1;	
	END_IF   
			  //到达20层后计算一次Y
		IF  NOT   Mach_Control.DT_b.DT_OHclosure THEN	  
				IF  Mach_Control.Ca_b.Ca_Quantited>=iCaOverhandCount1_Y*10     THEN
					
						 IF  iCaOverhandCount2_Y>=3 THEN   
							fCaArvMean_Y:=fCaSUMMean_Y/iCaOverhandCount2_Y;
						ELSE
							fCaArvMean_Y:=0;
						 END_IF
						 fCaOffsetMean_Y:=LIMIT( -0.5,  fCaArvMean_Y*0.5 ,0.5  )  ;                    //SEL(fCaArvMean>0.1,  0 , fCaArvMean*0.333 )   ;
						 
						 iCaOverhandCount1_Y:=iCaOverhandCount1_Y+1;
						 fCaSUMMean_Y:=0;
						 iCaOverhandCount2_Y:=0;
				END_IF
				   
						  //到达20层后计算一次X
				IF  Mach_Control.Ca_b.Ca_Quantited>=iCaOverhandCount1_X*10     THEN
					
						 IF  iCaOverhandCount2_X>=3 THEN   
							fCaArvMean_X:=fCaSUMMean_X/iCaOverhandCount2_X;
						ELSE
							fCaArvMean_X:=0;
						 END_IF
						 fCaOffsetMean_X:=LIMIT( -0.5,   fCaArvMean_X*0.5 ,0.5  )  ;                    //SEL(fCaArvMean>0.1,  0 , fCaArvMean*0.333 )   ;
						 
						 iCaOverhandCount1_X:=iCaOverhandCount1_X+1;
						 fCaSUMMean_X:=0;
						 iCaOverhandCount2_X:=0;
				END_IF
		ELSE		
				 fCaOffsetMean_Y:=0;
				 fCaOffsetMean_X:=0;
        END_IF 


	   
	DP_Step6:=103;	


103:
	//CCD.Over.Finish.OverhandResult:=0;
	DP_Step6:=6666;	


END_CASE







CASE DP_Step7 OF
201:
    IF An_OverNGMark THEN
       DP_Step7:=6666;	
	ELSIF (CCD.Over.Finish.OverhandResult=4 OR CCD.Over.Finish.OverhandResult=2 OR CCD.Over.Finish.OverhandResult=1 ) AND NOT An_Number 
		AND ((arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>10 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<235)(* OR
		 (arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos=360)*))THEN
		DP_Step7:=202;
	ELSIF An_Number OR Mach_Control.U.EmptyRunMode OR Mach_Control.DT_b.DT_Overhang THEN//负极报警，空跑模式，Overhang屏蔽直接跳过
		DP_Step7:=6666;	
	ELSIF   NOT An_Number AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>235 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<360 
		AND CCD.Over.Finish.OverhandResult=0 THEN
		Mach_Control.An_b.Error[25]:=TRUE;//正极极片对齐度检测返回结果超时
		Par.stDT_date.Overhang_CSJS:=Par.stDT_date.Overhang_CSJS+1;
		DP_Step7:=6666;	
	ELSIF CCD.Over.Finish.OverhandResult=3 THEN 		
		Mach_Control.An_b.Error[27]:=TRUE; //正极极片对齐度检测返回结果无片报警
		DP_Step7:=202;	
	END_IF
							
											
202:
	CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_Result[CCD.Over.Start.iPliesNo]:=CCD.Over.Finish.OverhandResult;	
	CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension2[CCD.Over.Start.iPliesNo]:=LIMIT(150, Mach_Control.DT_b.DiaphragmUnwindingTension,250);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_Overhang_A_C[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_Overhang_S_CIL[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_No_Overhang_A_C[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX4);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_No_Overhang_S_A[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_L_Overhang_A_C[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_L_Overhang_S_A[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_R_Overhang_A_C[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY4);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_R_Overhang_S_A[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Cell_Overhang:=ABS(CCD.Over.Finish.AddOverhangX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Cell_Overhang_No:=ABS(CCD.Over.Finish.AddOverhangX4);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Cell_Overhang_L:=ABS(CCD.Over.Finish.AddOverhangY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Cell_Overhang_R:=ABS(CCD.Over.Finish.AddOverhangY4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_PoleOverhandX2[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_PoleOverhandX3[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_PoleOverhandY2[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_PoleOverhandY3[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AnCaOverhandX2[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AnCaOverhandX3[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AnCaOverhandY2[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AnCaOverhandY3[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AddOverhangX2:=ABS(CCD.Over.Finish.AddOverhangX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AddOverhangX3:=ABS(CCD.Over.Finish.AddOverhangX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AddOverhangY2:=ABS(CCD.Over.Finish.AddOverhangY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AddOverhangY3:=ABS(CCD.Over.Finish.AddOverhangY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_MQ_Slice[Mach_Control.An_b.An_Quantited]:=Par.stDT_date.An_MQ_Slice[2];
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].Serialnumber:=CCD.Over.Start.iPliesNo;
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].Polarity:=2;
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].Platenumber:=Par.stDT_date.An_MQ_Slice[2].stPoleNo;
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].AnlapTen:=Par.stDT_date.An_MQ_Slice[2].UnreelingTension;
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].GMlapTen:=LIMIT(150, Mach_Control.DT_b.DiaphragmUnwindingTension,250);
	CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[CCD.Over.Start.iPliesNo].GMlapRectify:=LIMIT( Par.stDT_date.fRectifyBalanceValue-0.2,  Mach_Control.DT_b.RecDevPV,Par.stDT_date.fRectifyBalanceValue+0.2);

	
	DP_Step7:=203;	

203:
	//CCD.Over.Finish.OverhandResult:=0;
	DP_Step7:=6666;

END_CASE



CASE DP_Step8 OF	
100:
	Ca_StandbySub3_ton[2].IN:=FALSE;
	IF  NOT Mach_Control.U.CCD_ChosesHMI  AND NOT  Mach_Control.U.EmptyRunMode (*AND NOT An_OverhangNG*) THEN
		//IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>109 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos<=112   THEN
		IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>122.5 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos<=128   THEN
				CCD.CaRec.Finish.RectifyX1:=0;
				CCD.CaRec.Finish.RectifyX2:=0;
				CCD.CaRec.Finish.RectifyY:=0;		
				CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零									
				Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
				CCD.CaRec.Start.iPhotoDo:=1;//启动CCD第二次拍照
				//arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Cmd.bON:=TRUE;//负极纠偏平台除尘
				//arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Cmd.bON:=TRUE;//正极纠偏平台除尘
				DP_Step8:=110;
		END_IF
	ELSE
		DP_Step8:=6661;
	END_IF
110:
	Ca_StandbySub3_ton[2].IN:=CCD.CaRec.Finish.RectifyResult=0;
	IF Ca_StandbySub3_ton[2].Q THEN
		Mach_Control.DT_b.Error[51]:=TRUE;//检测负极纠偏平台空片结果返回超时
		DP_Step8:=9991;
	ELSIF CCD.CaRec.Finish.RectifyResult<>0 AND CCD.CaRec.Finish.RectifyResult<>3   THEN
		Mach_Control.Ca_b.Error[24]:=TRUE;//负极纠偏平台NG片未排掉报警，请拿掉
		Ca_StandbySub3_ton[2].IN:=FALSE;
		DP_Step8:=9992;
	ELSIF CCD.CaRec.Finish.RectifyResult=3  THEN
		DP_Step8:=6661;
	END_IF

200:
	An_StandbySub3_ton[2].IN:=FALSE;
	IF  NOT Mach_Control.U.CCD_ChosesHMI  AND NOT  Mach_Control.U.EmptyRunMode  (*AND NOT Ca_OverhangNG*) THEN
		//IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>118 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos<=123  THEN
		IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>122.5 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos<=128   THEN
			CCD.AnRec.Finish.RectifyResult:=0;
			CCD.AnRec.Finish.RectifyX1:=0;
			CCD.AnRec.Finish.RectifyX2:=0;
			CCD.AnRec.Finish.RectifyY:=0;												
			Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
			CCD.AnRec.Start.iPhotoDo:=1;//第二次拍照
			//arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Cmd.bON:=TRUE;//负极纠偏平台除尘
			//arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Cmd.bON:=TRUE;//正极纠偏平台除尘
			DP_Step8:=210;
		END_IF
	ELSE
		DP_Step8:=6662;
	END_IF	
210:
	An_StandbySub3_ton[2].IN:=CCD.AnRec.Finish.RectifyResult=0;
	IF An_StandbySub3_ton[2].Q THEN				
		Mach_Control.DT_b.Error[52]:=TRUE;//检测正极纠偏平台空片结果返回超时
		An_StandbySub3_ton[2].IN:=FALSE;
		DP_Step8:=9993;		
	ELSIF CCD.AnRec.Finish.RectifyResult<>0 AND CCD.AnRec.Finish.RectifyResult<>3 THEN
		Mach_Control.An_b.Error[24]:=TRUE;//正极纠偏平台NG片未排掉报警，请拿掉 
		An_StandbySub3_ton[2].IN:=FALSE;
		DP_Step8:=9994;
	ELSIF CCD.AnRec.Finish.RectifyResult=3 THEN
		An_StandbySub3_ton[2].IN:=FALSE;
		DP_Step8:=6662;
	END_IF
	
END_CASE





(*
////////////////////////////////////////////////////////////////////////////////////运行中处理 流程//////////////////////////////////////////////////////////////////////////////////////////////
//主轴在运行时，真空、破真空，以及是否能取片、有无料标记
(*
IF VirMain_TagatTime<1 THEN
		CamOutArgel:=0.47*VirMain_TagatTime*360;
ELSE
		CamOutArgel:=160;
END_IF
*)

CamOutArgel:=170;

CASE DP_Step3 OF 
100://负极叠片，正极在取片位
	bStandbyStep1_1:=FALSE;
	bStandbyStep1_2:=FALSE;
	DP_Step3:=110; 
110:   //叠负极片同时 判断证据能否取片  提高效率
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=220     THEN
	//正送片搬运极取片处理
		IF   arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND 
			  NOT Mach_Control.An_b.An_CarryingFalg    AND  ( Mach_Control.An_b.An_MainBeltOK OR  Mach_Control.U.EmptyRunMode )  AND 
			  NOT  Mach_Control.An_b.An_MainBelting   AND NOT  bStandbyStep1_1 AND (NOT An_JumpRules[3]  AND NOT  An_JumpRules[6] AND NOT An_JumpRules[8] AND NOT An_JumpRules[10])(*AND NOT Mach_Control.An_b.JumpPiceReady *) THEN
			   An_Step0:=10;//正极取流水线子程序
			   bStandbyStep1_1:=TRUE;
		END_IF
		
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND 
		 Mach_Control.An_b.An_deviationDPOK AND NOT Mach_Control.An_b.An_DPCarryingFalg AND  
			Mach_Control.An_b.An_deviationFalg  AND  NOT  bStandbyStep1_2  AND NOT DP_CheseCam  THEN
			An_Step3:=10;//正极取纠偏平台子程序
			bStandbyStep1_2:=TRUE;
		END_IF
	
	ELSIF  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>220  THEN
		DP_Step3:=120;
	END_IF		   
	
	
120:
	arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;//负极纠偏平台真空开			
	arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;//负极纠偏平台真空开					
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=234 THEN//198
		
		Mach_Control.Ca_b.Ca_Rectifydev_CS:=0;
		CCD.Over.Start.stPoleNo:=Par.stDT_date.Ca_MQ_Slice[8].stPoleNo;
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运真空破
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运真空破
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=TRUE;//负极送片搬运真空破
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=FALSE;//负极送片搬运真空破
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;//负极纠偏平台真空开
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;//负极纠偏平台真空开			
		
		Mach_Control.Ca_b.Ca_DPCarryingFalg :=FALSE;//复位负极叠片搬运吸盘上有料标记
		//IF Mach_Control.Ca_b.Ca_CarryingFalg THEN
			Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位纠偏平台上有料标记
			Mach_Control.Ca_b.Ca_CarryingFalg:=FALSE;//复位负极送片搬运吸盘上有料标记
		//END_IF
		Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[7];
		
	END_IF	
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=342 THEN//198
     	CCD.Over.Start.iPliesNo:=UINT_TO_INT(Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited+1);	
		IF NOT Ca_Number THEN
			CCD.Over.Start.iPhotoDo:=1;
		ELSE
			CCD.Over.Start.iPhotoDo:=2;
		END_IF
		Mach_Control.DT_b.CDD_OverStart:=TRUE;
		DP_Step3:=121;
	 END_IF		
		
121:
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=360 THEN//198
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极送片搬运真空开
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=TRUE;//负极送片搬运真空开
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空破
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运真空破
		DP_Step3:=6666;
	END_IF	
	
	
200://负极叠片，正极在取片位

	IF iAnCamInSel2=1 THEN
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极送片搬运真空关
	END_IF
	
	//fbAnDTCarryingVacuum.Vacuumsel:=SEL(iAnCamInSel2=1,0,1)     ;//	正极叠片搬运真空开	
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=210 THEN//复检提前
		IF Mach_Control.DT_b.DT_CCD_TwoModel THEN												
			CCD.AnRec.Finish.RectifyResult:=0;
			CCD.AnRec.Finish.RectifyX1:=0;
			CCD.AnRec.Finish.RectifyX2:=0;
			CCD.AnRec.Finish.RectifyY:=0;												
			Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
			CCD.AnRec.Start.iPhotoDo:=2;//第二次拍照	
		END_IF
		DP_Step3:=205;
	END_IF
205:			
	IF NOT DP_CheseCam  AND NOT  An_JumpRules[3]  AND NOT  An_JumpRules[6] AND NOT An_JumpRules[8] AND NOT An_JumpRules[10] THEN
	
		IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=225  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=230 THEN	
			//fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极升解除耦合															
			//fbAnCamInCarryingWhirling.bCamInExecute:=FALSE;//正极旋转解除耦合			
			//Mach_Control.An_b.An_MainBelting:=FALSE;//正极搬运升降取极片中																					
			IF  NOT  Mach_Control.Ca_b.Ca_deviationFPOK  THEN    //负极放片纠偏太未在初始位置报警  
					Mach_Control.Ca_b.Error_tips[1]:=TRUE ;
			END_IF											
			IF  NOT  Mach_Control.An_b.An_deviationDPOK  THEN    //正极取片纠偏未完成报警
					Mach_Control.An_b.Error_tips[1]:=TRUE;
			END_IF			
			IF Mach_Control.An_b.An_deviationDPOK OR Mach_Control.U.EmptyRunMode OR	TRUE  THEN // 
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运真空开	
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运真空开		
				An_deviationDPOKFalg:=TRUE;	
			ELSE		
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//正极叠片搬运真空开					
				arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极叠片搬运真空开												
				fbAnCamInDTCarryingUpDown.bCamInExecute:=FALSE;	//正极叠片搬运升降凸轮解耦				
				IF NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4]    THEN
						arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;   //到等待位
				END_IF			
			END_IF	
			//IF NOT Mach_Control.An_b.JumpPiceReady THEN
				An_Step0:=10;//调用正极取片程序	
			//END_IF
			DP_Step3:=210;														
		END_IF									
	ELSE
			DP_Step3:=210;	
	END_IF


210:
	//打开或关闭真空，标记对应位置有料
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=234 THEN//198
	
		Mach_Control.Ca_b.Ca_Rectifydev_CS:=0;
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=TRUE;//负极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=FALSE;//负极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运直空关
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运直空关
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;//负极纠偏平台真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;//负极纠偏平台真空开		
		
		Mach_Control.Ca_b.Ca_DPCarryingFalg :=FALSE;//复位负极叠片搬运吸盘上有料标记
		//IF Mach_Control.Ca_b.Ca_CarryingFalg THEN
			Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位纠偏平台上有料标记
			Mach_Control.Ca_b.Ca_CarryingFalg:=FALSE;//复位负极送片搬运吸盘上有料标记
		//END_IF
		Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[7];
		IF An_deviationDPOKFalg AND  iAnCamInSel2=1   THEN
			Par.stDT_date.An_MQ_Slice[2]:=Par.stDT_date.An_MQ_Slice[1];
			//IF Mach_Control.An_b.An_deviationFalg THEN
				Mach_Control.An_b.An_DPCarryingFalg :=TRUE;//复位正极叠片搬运吸盘上有料标记										
				Mach_Control.An_b.An_deviationFalg:=FALSE;//置位纠偏平台上有料标记	
			//END_IF										
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=TRUE;//正极纠偏平台真空关
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=FALSE;//正极纠偏平台真空关
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bON:=TRUE;//正极纠偏平台破真空开	
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bOFF:=FALSE;//正极纠偏平台破真空开	
	(*	
		ELSIF NOT   DP_CheseCam THEN								
			An_Step3:=10;//正极叠片搬运取纠偏台极片	
	*)																					
		END_IF
	
	END_IF

	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=342 THEN//198
		CCD.Over.Start.iPliesNo:=UINT_TO_INT(Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited+1);
		CCD.Over.Start.stPoleNo:=Par.stDT_date.Ca_MQ_Slice[8].stPoleNo;
		IF NOT Ca_Number THEN
			CCD.Over.Start.iPhotoDo:=1;
		ELSE
			CCD.Over.Start.iPhotoDo:=2;
		END_IF
		Mach_Control.DT_b.CDD_OverStart:=TRUE;	
		IF NOT Ca_Number THEN
			DP_Step3:=211;					
		END_IF	
    END_IF	
211:
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=360 THEN//198	
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极送片搬运真空开
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=TRUE;//负极送片搬运真空开
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运直空开
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运直空开
		DP_Step3:=6666;					
	END_IF
			



		
300://正极叠片，负极在取片位			
	bStandbyStep1_3:=FALSE;
	bStandbyStep1_4:=FALSE;
	DP_Step3:=310; 		
310:	
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=220     THEN
		//正送片搬运极取片处理
		IF   arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] AND 
			NOT Mach_Control.Ca_b.Ca_CarryingFalg    AND  ( Mach_Control.Ca_b.Ca_CacheBeltDLOK OR  Mach_Control.U.EmptyRunMode )  AND 
			NOT  Mach_Control.Ca_b.Ca_CacheBelting   AND NOT  bStandbyStep1_3 THEN
			Ca_Step0:=10;   //负极取流水线子程序
			bStandbyStep1_3:=TRUE;
		END_IF
	
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] AND 
			Mach_Control.Ca_b.Ca_deviationDPOK AND NOT Mach_Control.Ca_b.Ca_DPCarryingFalg AND  
			Mach_Control.Ca_b.Ca_deviationFalg AND  NOT  bStandbyStep1_4   THEN
			Ca_Step3:=10;     //负极取纠偏平台子程序
			bStandbyStep1_4:=TRUE;
		END_IF					
	ELSIF  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>220  THEN
			DP_Step3:=320; 
	END_IF	
	
320://正极叠片，负极在取片位
	arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//正极纠偏平台真空开			
	arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//正极纠偏平台真空开					
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=234 THEN//198
	
		Mach_Control.An_b.An_Rectifydev_CS:=0;	
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;//正极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;//正极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运破真空开
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极送片搬运破真空开
		
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//正极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运破真空开
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极送片搬运破真空开
		
		arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//正极纠偏平台真空开		
		arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//正极纠偏平台真空开		
		
		
		Mach_Control.An_b.An_DPCarryingFalg :=FALSE;//复位正极叠片搬运吸盘上有料标记
		//IF Mach_Control.An_b.An_CarryingFalg THEN
			Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台上有料标记
			Mach_Control.An_b.An_CarryingFalg:=FALSE;//复位正极送片搬运吸盘上有料标记
		//END_IF
		Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[0];
		
	END_IF
	
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=342 THEN//198
		CCD.Over.Start.iPliesNo:=UINT_TO_INT(Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited+1);
		CCD.Over.Start.stPoleNo:=Par.stDT_date.An_MQ_Slice[2].stPoleNo;
		IF NOT An_Number THEN
			CCD.Over.Start.iPhotoDo:=1;
		ELSE
			CCD.Over.Start.iPhotoDo:=2;
		END_IF
		Mach_Control.DT_b.CDD_OverStart:=TRUE;				
		DP_Step3:=6666;	
	END_IF
400:	//复检提前------//正极叠片，负极在叠片位

	//fbCaDTCarryingVacuum.Vacuumsel:= SEL(iCaCamInSel2=1 ,0,1)   ;//	负极叠片搬运真空开
	IF iCaCamInSel2=1 THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠台搬运真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠台搬运真空开		
	END_IF

	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=210 THEN//198
		IF Mach_Control.DT_b.DT_CCD_TwoModel THEN
				CCD.CaRec.Finish.RectifyX1:=0;
				CCD.CaRec.Finish.RectifyX2:=0;
				CCD.CaRec.Finish.RectifyY:=0;		
				CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零									
				Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
				CCD.CaRec.Start.iPhotoDo:=2;//启动CCD第二次拍照									
		END_IF
		DP_Step3:=405;
	END_IF
405:		
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=225  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=230 THEN																								
		IF  NOT  Mach_Control.An_b.An_deviationFPOK  THEN    //正极放片纠偏太未在初始位置报警  
			  Mach_Control.An_b.Error_tips[2]:=TRUE ;
		END_IF
		
		IF  NOT  Mach_Control.Ca_b.Ca_deviationDPOK  THEN    //负极取片纠偏未完成报警
			  Mach_Control.Ca_b.Error_tips[2]:=TRUE ;
		END_IF		

		//正极叠片时平移到位后判断正极纠偏台是否允许放片
		IF Mach_Control.An_b.An_deviationFPOK OR Mach_Control.U.EmptyRunMode  THEN 
				An_deviationFPOKFalg:=TRUE;//正极纠偏平台允许放片标记
		ELSE									
			fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;	//正极送片搬运升降凸轮解耦				
			IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4]    THEN
				arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;
			END_IF;				
		END_IF					
		IF Mach_Control.Ca_b.Ca_deviationDPOK OR Mach_Control.U.EmptyRunMode OR TRUE  THEN //  
			Ca_deviationDPOKFalg:=TRUE;	
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运真空开		
		ELSE	
			//arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空开									
			fbCaCamInDTCarryingUpDown.bCamInExecute:=FALSE;	//负极叠片搬运升降凸轮解耦				
			IF NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4]    THEN
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;   //到等待位
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;   //到等待位
			END_IF;				
		END_IF									
		Ca_Step0:=10;//调用负极取片程序       取片允许条件在子程序里
		DP_Step3:=410;		
	END_IF
(*	
	//判断是否允许负极送片搬运取料
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=CamOutArgel  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=(CamOutArgel+5) THEN
		IF (Mach_Control.Ca_b.Ca_CacheBeltDLOK AND NOT fbCaCamInCarryingUpDown2OutCamFlge) OR Mach_Control.U.EmptyRunMode  THEN
			Mach_Control.Ca_b.Ca_CacheBelting:=TRUE;//f负极搬运升降取极片中	
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极送片搬运真空开
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=TRUE;//负极送片搬运真空开
		ELSE
			//arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极送片搬运真空开
			fbCaCamInCarryingUpDown2.bCamInExecute:=FALSE;//负极升解除耦合
			Mach_Control.Ca_b.Ca_CacheBelting:=FALSE;
		END_IF								
	END_IF
	//解除负极搬运升降凸轮耦合标记
	fbCaCamInCarryingUpDown2OutCam_F_TRIG(CLK:=fbCaCamInCarryingUpDown2.bCamInExecute , Q=> );
	IF fbCaCamInCarryingUpDown2OutCam_F_TRIG.Q THEN
		fbCaCamInCarryingUpDown2OutCamFlge:=TRUE;//负极升降2凸轮解耦标记
	END_IF	
*)			
410:							
	//打开或关闭真空，标记对应位置有料
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=234 THEN//198

		Mach_Control.An_b.An_Rectifydev_CS:=0;
		CCD.Over.Start.stPoleNo:=Par.stDT_date.An_MQ_Slice[2].stPoleNo;
	(*	
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;//正极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运破真空开
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极叠片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运破真空开
	*)	
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;//正极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;//正极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运破真空开
		arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极送片搬运破真空开
		
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//正极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极送片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运破真空开
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极送片搬运破真空开	
		
		arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//正极纠偏平台真空开	
		arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//正极纠偏平台真空开	

		Mach_Control.An_b.An_DPCarryingFalg :=FALSE;//复位正极叠片搬运吸盘上有料标记
		//IF Mach_Control.An_b.An_CarryingFalg THEN
			Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台上有料标记
			Mach_Control.An_b.An_CarryingFalg:=FALSE;//复位正极送片搬运吸盘上有料标记
		//END_IF
		
		Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[0];
		
		(*
		IF (Mach_Control.Ca_b.Ca_CacheBelting AND NOT fbCaCamInCarryingUpDown2OutCamFlge) OR Mach_Control.U.EmptyRunMode  THEN
			Mach_Control.Ca_b.Ca_CarryingFalg:=TRUE;//复位负极送片搬运吸盘上有料标记
			Par.stDT_date.Ca_MQ_Slice[7]:=Par.stDT_date.Ca_MQ_Slice[6];
		END_IF*)
		
		
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bStop:=FALSE;
	

		//判断负极纠偏台是否允许取料
		IF Ca_deviationDPOKFalg AND NOT DP_CheseCam AND iCaCamInSel2=1 THEN		
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠台搬运真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠台搬运真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=TRUE;//负极纠偏平台真空关
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=FALSE;//负极纠偏平台真空关
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bON:=TRUE;//负极纠偏平台破真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bOFF:=FALSE;//负极纠偏平台破真空开		
			//IF 	Mach_Control.Ca_b.Ca_deviationFalg THEN				
				Mach_Control.Ca_b.Ca_DPCarryingFalg :=TRUE;//置位负极叠片搬运吸盘上有料标记			
				Mach_Control.Ca_b.Ca_deviationFalg:=FALSE;//复位负极纠偏平台上有料标记	
			//END_IF			
			Par.stDT_date.Ca_MQ_Slice[9]:=Par.stDT_date.Ca_MQ_Slice[8];
		(*	
		ELSE   
			Ca_Step3:=10;//负极叠片搬运取纠偏台极片	
		*)	   
		END_IF									

		//判断正极纠偏台是否允许放料
		IF An_deviationFPOKFalg THEN			
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=TRUE;//正极送片搬运真空关
			arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=FALSE;//正极送片搬运破真空开
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;//正极纠偏平台真空开		
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;//正极纠偏平台真空开	
			//IF Mach_Control.An_b.An_CarryingFalg THEN	
				Mach_Control.An_b.An_deviationFalg:=TRUE;//置位正极纠偏平台上有料标记
				Mach_Control.An_b.An_CarryingFalg:=FALSE;//复位正极送片搬运吸盘上有料标记						
			//END_IF			
			Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[0];//送片机械手传送至纠偏平台
		ELSE   
			An_Step1:=10;//正极送片搬运放片到纠偏台			   
		END_IF
	END_IF

		IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=342 THEN//198
			CCD.Over.Start.iPliesNo:=UINT_TO_INT(Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited+1);	
			IF NOT An_Number THEN
				CCD.Over.Start.iPhotoDo:=1;
			ELSE
				CCD.Over.Start.iPhotoDo:=2;
			END_IF
			CCD.Over.Finish.OverhandResult:=0;
			Mach_Control.DT_b.CDD_OverStart:=TRUE;	
			IF NOT An_Number THEN
				DP_Step3:=6666;					
			END_IF
			
        END_IF
END_CASE



//判断主轴是否完成
CASE  DP_Step4 OF
100://叠负极主轴定位完成判断				
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		//如果，叠片搬运掉片报警就不计数		
		IF NOT Ca_Number THEN
			Mach_Control.Ca_b.Ca_Quantited:=Mach_Control.Ca_b.Ca_Quantited+1;
			DPcount:=DPcount+1;
			IF Mach_Control.U.EmptyRunMode THEN
				Mach_Control.Ca_b.Ca_EmptyRunKDQuantited:=Mach_Control.Ca_b.Ca_EmptyRunKDQuantited +1;
//			ELSE
//				Mach_Control.Ca_b.Ca_EmptyRunKDQuantited:=0;
			END_IF
			Par.stDT_date.YD_JS_L:=Par.stDT_date.YD_JS_L+1;
			Mach_Control.Ca_b.Ca_CCD_amount:=0;
				//叠台升降轴下降
				IF NOT Mach_Control.U.EmptyRunMode  THEN
					arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness+Par.stDT_date.Pole_ThicknessCom);
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-Par.stDT_date.SEPTA_Thickness;
				END_IF
				IF Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited>3 THEN
					arrAxisPar[AxiseNo.AxisName.DTUpDown].fVelocity_of_Rel:=100;
					arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bMoveRel:=TRUE;
				END_IF
		END_IF
		Mach_Control.An_b.An_CCDStart :=FALSE;//启动CCD拍照						
		DP_Step1:=100;//解除耦合，主轴回零子程序
		
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF
		
		DP_Step0:=0;
		Ca_AlarmTON[11].IN:=FALSE;
		IF Ca_Number  THEN
			DP_Step6:=6666;
		ELSIF Mach_Control.DT_b.DT_Overhang THEN
			DP_Step6:=102;
		ELSE
			DP_Step6:=101;
		END_IF	
		DP_Step4:=110;	
	END_IF;	
110:
	IF ((*Ca_deviationFPOKFalg OR*) Ca_Step1=6666 OR Ca_Step1=0) AND ((*An_deviationDPOKFalg OR *)An_Step3=6666 OR An_Step3=0)  
		AND ((An_Step0=6666 OR An_Step0=0) OR Mach_Control.An_b.An_Quantited=Par.stDT_date.An_Quantity )  THEN         
		DP_Step4:=6666;
		DP_Step0:=0;
		Ca_deviationFPOKFalg:=FALSE;
		An_deviationDPOKFalg:=FALSE;  
	END_IF



		
200:	//叠正极主轴定位完成判断
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>=200 AND  NOT fbCaCamInCarryingUpDown2.bCamInExecute  THEN
		(*
		IF NOT  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=4;//移动至流水线上方
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=0;//移动至流水线上方
		END_IF
		*)
		;
	END_IF
	
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		//如果，叠片搬运掉片报警就不计数				
		IF NOT An_Number THEN
			Mach_Control.An_b.An_Quantited:=Mach_Control.An_b.An_Quantited+1;
			DPcount:=DPcount+1;			
			IF Mach_Control.U.EmptyRunMode THEN
				Mach_Control.An_b.An_EmptyRunKDQuantited:=Mach_Control.An_b.An_EmptyRunKDQuantited +1;
//			ELSE
//				Mach_Control.An_b.An_EmptyRunKDQuantited:=0;
			END_IF
			Par.stDT_date.YD_JS_R:=Par.stDT_date.YD_JS_R+1;
			Mach_Control.An_b.An_CCD_amount:=0;
			//叠台升降轴下降
			IF NOT Mach_Control.U.EmptyRunMode  THEN
					arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-(Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness+Par.stDT_date.Pole_ThicknessCom);
			ELSE
					arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-Par.stDT_date.SEPTA_Thickness;
			END_IF
			IF Mach_Control.Ca_b.Ca_Quantited + Mach_Control.An_b.An_Quantited>3 THEN
					arrAxisPar[AxiseNo.AxisName.DTUpDown].fVelocity_of_Rel:=100;
					arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bMoveRel:=TRUE;
			END_IF	
		END_IF
		Mach_Control.Ca_b.Ca_CCDStart :=FALSE;//启动CCD拍照			
		DP_Step1:=100;//解除耦合，主轴回零	

		(*
		IF  (Mach_Control.Ca_b.Ca_CacheBelting AND NOT fbCaCamInCarryingUpDown2OutCamFlge) OR Mach_Control.U.EmptyRunMode  THEN
			Par.stDT_date.Ca_betlCount.5:=FALSE;//复位负极流水线极片标记
			Mach_Control.Ca_b.Ca_CacheBelting:=FALSE;
		END_IF	*)
	
						
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bOFF:=TRUE;//负极纠偏平台破真空关	
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF							
		DP_Step0:=0;
		An_AlarmTON[11].IN:=FALSE;
		IF An_Number THEN
			  DP_Step7:=6666;
		ELSIF  Mach_Control.DT_b.DT_Overhang THEN
			  DP_Step7:=202;
		ELSE
			  DP_Step7:=201;
		END_IF
		DP_Step4:=210;	
		(*	
			IF  Mach_Control.DT_b.DT_Overhang AND NOT An_Number THEN
				  DP_Step7:=202;
			ELSIF An_Number THEN
				  DP_Step7:=6666;
			ELSE
				  DP_Step7:=201;
			END_IF
			DP_Step4:=6666;	
		*)
	END_IF;	
210:
	IF ((*An_deviationFPOKFalg OR *)An_Step1=6666 OR An_Step1=0) AND ((*Ca_deviationDPOKFalg OR *)Ca_Step3=6666 OR Ca_Step3=0) 
	AND (Ca_Step0=6666 OR Ca_Step0=0) THEN          
		DP_Step4:=6666;
		DP_Step0:=0;
		An_deviationFPOKFalg:=FALSE;
		Ca_deviationDPOKFalg:=FALSE; 
	END_IF

			
END_CASE



//观察NG片用，发现问题后删除
IF Ca_NGTest1.Q THEN
	Ca_NG:=Ca_NG+1;
END_IF


CASE  DP_Step5 OF
100://判断主轴运行时负极叠片搬运升降真空报警
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>0 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<220 THEN
		IF Ca_Number THEN	
			DP_Step5:=110;
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运破真空开	
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运破真空开	
		END_IF
		Ca_NGTest1(CLK:=(CCD.CaRec.Finish.RectifyResult=2) , Q=> );
	ELSE 
		DP_Step5:=6666;
	END_IF

110:
	fbCaCamInDTCarryingUpDown.bCamInExecute:=FALSE;//负极叠片搬运升降
	fbCamInLeftYDUpDown.bCamInExecute:=FALSE;//左压刀升降
	fbCamInLeftYDLine.bCamInExecute:=FALSE;//左压刀开合
	IF NOT  fbCaCamInDTCarryingUpDown.bCamInExecute AND NOT fbCamInLeftYDUpDown.bCamInExecute AND NOT  fbCamInLeftYDLine.bCamInExecute THEN
		DP_Step5:=120;
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空开
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运真空开
	END_IF

120:
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bGearOut:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bGearOut:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bGearOut:=TRUE;
	IF NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Coupled
	AND NOT arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Coupled THEN
		arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bGearOut:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.bGearOut:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.bGearOut:=FALSE;
		DP_Step5:=130;
	END_IF

130:
	IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND 
		NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空开
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运真空开
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
			DP_Step5:=6666;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极叠片升降移动至等待高度
		END_IF
	END_IF







200://判断主轴运行时正极叠片搬运升降真空报警
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>0 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<220 THEN
		IF An_Number THEN	
			DP_Step5:=210;
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运破真空开	
		END_IF
	ELSE 
		DP_Step5:=6666;
	END_IF

210:
	fbAnCamInDTCarryingUpDown.bCamInExecute:=FALSE;//正极叠片搬运升降
	fbCamInRightYDUpDown.bCamInExecute:=FALSE;
	fbCamInRightYDLine.bCamInExecute:=FALSE;
	IF NOT fbAnCamInDTCarryingUpDown.bCamInExecute AND NOT fbCamInRightYDUpDown.bCamInExecute AND NOT fbCamInRightYDLine.bCamInExecute THEN
		DP_Step5:=220;
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=FALSE;//正极叠片搬运破真空关	
	END_IF
220:
	arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bGearOut:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bGearOut:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bGearOut:=TRUE;
	IF NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Coupled AND
		NOT arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Coupled  THEN
		arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.bGearOut:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.bGearOut:=FALSE;
		arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.bGearOut:=FALSE;
		DP_Step5:=230;
	END_IF

230:
	IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.NoMoving AND 
	NOT arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Status.Error THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
			DP_Step5:=6666;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极叠片升降移动至等待高度
		END_IF
	END_IF
		
END_CASE




CASE DP_Step6 OF
101:
	IF (CCD.Over.Finish.OverhandResult=4 OR CCD.Over.Finish.OverhandResult=2 OR CCD.Over.Finish.OverhandResult=1 ) AND NOT Ca_Number 
		AND( (arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>100 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<220) OR (arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos=360)) THEN		
		DP_Step6:=102;
	ELSIF Ca_Number OR Mach_Control.U.EmptyRunMode OR Mach_Control.DT_b.DT_Overhang THEN//负极报警，空跑模式，Overhang屏蔽直接跳过
		DP_Step6:=6666;
	ELSIF NOT Ca_Number AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>220 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<360 
		AND  CCD.Over.Finish.OverhandResult=0   THEN
		Mach_Control.Ca_b.Error[25]:=TRUE;//负极极片对齐度检测返回结果超时
		Par.stDT_date.Overhang_CSJS:=Par.stDT_date.Overhang_CSJS+1;
		DP_Step6:=6666;
	ELSIF CCD.Over.Finish.OverhandResult=3   THEN		
		Mach_Control.Ca_b.Error[27]:=TRUE;  //负极极片对齐度检测返回结果无片报警
		DP_Step6:=102;
	END_IF
					
102:
	CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_Result[CCD.Over.Start.iPliesNo]:=CCD.Over.Finish.OverhandResult;
	CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension2[CCD.Over.Start.iPliesNo]:=LIMIT(150,ABS(Mach_Control.DT_b.DiaphragmUnwindingTension),250);	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_Overhang_A_C[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_Overhang_S_CIL[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_No_Overhang_A_C[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX4);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_No_Overhang_S_A[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_L_Overhang_A_C[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_L_Overhang_S_A[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_R_Overhang_A_C[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY4);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Ear_R_Overhang_S_A[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Cell_Overhang:=ABS(CCD.Over.Finish.AddOverhangX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Cell_Overhang_No:=ABS(CCD.Over.Finish.AddOverhangX4);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Cell_Overhang_L:=ABS(CCD.Over.Finish.AddOverhangY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Cell_Overhang_R:=ABS(CCD.Over.Finish.AddOverhangY4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_PoleOverhandX2[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_PoleOverhandX3[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_PoleOverhandY2[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_PoleOverhandY3[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AnCaOverhandX2[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AnCaOverhandX3[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AnCaOverhandY2[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AnCaOverhandY3[Mach_Control.Ca_b.Ca_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AddOverhangX2:=ABS(CCD.Over.Finish.AddOverhangX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AddOverhangX3:=ABS(CCD.Over.Finish.AddOverhangX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AddOverhangY2:=ABS(CCD.Over.Finish.AddOverhangY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_AddOverhangY3:=ABS(CCD.Over.Finish.AddOverhangY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].Ca_MQ_Slice[Mach_Control.Ca_b.Ca_Quantited]:=Par.stDT_date.Ca_MQ_Slice[9];
	Ca_AlarmTON[11].IN:=FALSE;
	DP_Step6:=103;	


103:
	CCD.Over.Finish.OverhandResult:=0;
	DP_Step6:=6666;	


END_CASE







CASE DP_Step7 OF
201:
	IF (CCD.Over.Finish.OverhandResult=4 OR CCD.Over.Finish.OverhandResult=2 OR CCD.Over.Finish.OverhandResult=1 ) AND NOT An_Number 
		AND ((arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>100 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<220) OR
		 (arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos=360))THEN
		DP_Step7:=202;
	ELSIF An_Number OR Mach_Control.U.EmptyRunMode OR Mach_Control.DT_b.DT_Overhang THEN//负极报警，空跑模式，Overhang屏蔽直接跳过
		DP_Step7:=6666;	
	ELSIF   NOT An_Number AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>220 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<360 
		AND CCD.Over.Finish.OverhandResult=0 THEN
		Mach_Control.An_b.Error[25]:=TRUE;//正极极片对齐度检测返回结果超时
		Par.stDT_date.Overhang_CSJS:=Par.stDT_date.Overhang_CSJS+1;
		DP_Step7:=6666;	
	ELSIF CCD.Over.Finish.OverhandResult=3 THEN 		
		Mach_Control.An_b.Error[27]:=TRUE; //正极极片对齐度检测返回结果无片报警
		DP_Step7:=202;	
	END_IF
							
											
202:
	CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_Result[CCD.Over.Start.iPliesNo]:=CCD.Over.Finish.OverhandResult;	
	CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension2[CCD.Over.Start.iPliesNo]:=LIMIT(150,ABS(Mach_Control.DT_b.DiaphragmUnwindingTension),250);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_Overhang_A_C[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_Overhang_S_CIL[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_No_Overhang_A_C[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX4);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_No_Overhang_S_A[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_L_Overhang_A_C[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_L_Overhang_S_A[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_R_Overhang_A_C[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY4);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Ear_R_Overhang_S_A[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Cell_Overhang:=ABS(CCD.Over.Finish.AddOverhangX1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Cell_Overhang_No:=ABS(CCD.Over.Finish.AddOverhangX4);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Cell_Overhang_L:=ABS(CCD.Over.Finish.AddOverhangY1);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_Cell_Overhang_R:=ABS(CCD.Over.Finish.AddOverhangY4);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_PoleOverhandX2[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_PoleOverhandX3[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_PoleOverhandY2[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_PoleOverhandY3[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.PoleOverhandY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AnCaOverhandX2[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AnCaOverhandX3[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AnCaOverhandY2[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AnCaOverhandY3[Mach_Control.An_b.An_Quantited]:=ABS(CCD.Over.Finish.AnCaOverhandY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AddOverhangX2:=ABS(CCD.Over.Finish.AddOverhangX2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AddOverhangX3:=ABS(CCD.Over.Finish.AddOverhangX3);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AddOverhangY2:=ABS(CCD.Over.Finish.AddOverhangY2);
	CellMemory[Mach_Control.DT_b.DT_Memory].An_AddOverhangY3:=ABS(CCD.Over.Finish.AddOverhangY3);
	
	CellMemory[Mach_Control.DT_b.DT_Memory].An_MQ_Slice[Mach_Control.An_b.An_Quantited]:=Par.stDT_date.An_MQ_Slice[2];
	DP_Step7:=203;	

203:
	CCD.Over.Finish.OverhandResult:=0;
	DP_Step7:=6666;

END_CASE



CASE DP_Step8 OF	
100:
	Ca_StandbySub3_ton[2].IN:=FALSE;
	IF  NOT Mach_Control.U.CCD_ChosesHMI  AND NOT  Mach_Control.U.EmptyRunMode  THEN
		//IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>109 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos<=112   THEN
		IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>110 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos<=115   THEN
				CCD.CaRec.Finish.RectifyX1:=0;
				CCD.CaRec.Finish.RectifyX2:=0;
				CCD.CaRec.Finish.RectifyY:=0;		
				CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零									
				Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
				CCD.CaRec.Start.iPhotoDo:=1;//启动CCD第二次拍照
				//arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Cmd.bON:=TRUE;//负极纠偏平台除尘
				//arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Cmd.bON:=TRUE;//正极纠偏平台除尘
				DP_Step8:=110;
		END_IF
	ELSE
		DP_Step8:=6661;
	END_IF
110:
	Ca_StandbySub3_ton[2].IN:=CCD.CaRec.Finish.RectifyResult=0;
	IF Ca_StandbySub3_ton[2].Q THEN
		Mach_Control.DT_b.Error[51]:=TRUE;//检测负极纠偏平台空片结果返回超时
		DP_Step8:=9991;
	ELSIF CCD.CaRec.Finish.RectifyResult<>0 AND CCD.CaRec.Finish.RectifyResult<>3   THEN
		Mach_Control.Ca_b.Error[24]:=TRUE;//负极纠偏平台NG片未排掉报警，请拿掉
		Ca_StandbySub3_ton[2].IN:=FALSE;
		DP_Step8:=9992;
	ELSIF CCD.CaRec.Finish.RectifyResult=3  THEN
		DP_Step8:=6661;
	END_IF

200:
	An_StandbySub3_ton[2].IN:=FALSE;
	IF  NOT Mach_Control.U.CCD_ChosesHMI  AND NOT  Mach_Control.U.EmptyRunMode    THEN
		//IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>118 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos<=123  THEN
		IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>110 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos<=115   THEN
			CCD.AnRec.Finish.RectifyResult:=0;
			CCD.AnRec.Finish.RectifyX1:=0;
			CCD.AnRec.Finish.RectifyX2:=0;
			CCD.AnRec.Finish.RectifyY:=0;												
			Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
			CCD.AnRec.Start.iPhotoDo:=1;//第二次拍照
			//arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Cmd.bON:=TRUE;//负极纠偏平台除尘
			//arrCyCtrl[arrCyNo.ElectValveName.AndeviationIonizedWind].Cmd.bON:=TRUE;//正极纠偏平台除尘
			DP_Step8:=210;
		END_IF
	ELSE
		DP_Step8:=6662;
	END_IF	
210:
	An_StandbySub3_ton[2].IN:=CCD.AnRec.Finish.RectifyResult=0;
	IF An_StandbySub3_ton[2].Q THEN				
		Mach_Control.DT_b.Error[52]:=TRUE;//检测正极纠偏平台空片结果返回超时
		An_StandbySub3_ton[2].IN:=FALSE;
		DP_Step8:=9993;		
	ELSIF CCD.AnRec.Finish.RectifyResult<>0 AND CCD.AnRec.Finish.RectifyResult<>3 THEN
		Mach_Control.An_b.Error[24]:=TRUE;//正极纠偏平台NG片未排掉报警，请拿掉 
		An_StandbySub3_ton[2].IN:=FALSE;
		DP_Step8:=9994;
	ELSIF CCD.AnRec.Finish.RectifyResult=3 THEN
		An_StandbySub3_ton[2].IN:=FALSE;
		DP_Step8:=6662;
	END_IF
	
END_CASE

*)

]]></ST>
      </Implementation>
    </Action>
    <Action Name="_01DT_Auto3" Id="{761fff91-75cc-4d1e-985b-19f7e385a783}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[
(*******************************************************************************************************叠完片后，空叠片隔膜***************************************************************************************************************************)
DT_TON[5](IN:= , PT:=T#300MS , Q=> , ET=> );//

IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下
CASE DP_Step0 OF    //空叠隔膜流程
1000://判断主轴是否停止、是否在初始位、是否有轴在耦合中
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fSetPos=0 AND NOT DT_AxiseCoupling THEN
			KD_Mark:=TRUE;//空叠隔膜中
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			DP_Step0:=1020;
		ELSE
			DP_Step1:=100;//解除耦合，主轴回零
			DP_Step0:=1010;
		END_IF
	END_IF
1010://判断主轴当前的当前位置是否为0
	IF DP_Step1=6666 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fSetPos=0 AND NOT DT_AxiseCoupling THEN
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF									
		DP_Step0:=1020;
	END_IF	

1020://判断NG气缸是否在安全位
	IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState THEN
		DP_Step0:=1050;		
	ELSE
		DP_Step0:=1030;	
	END_IF
1030:
	arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;
	IF   arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND  arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
	arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState
	AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON THEN
		DP_Step0:=1040;									
	END_IF
1040:
	arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;
	IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState THEN
		DP_Step0:=1050;	
	END_IF						
1050://	最后一层为负极片，所以，最开始先叠正极的隔膜
	KD_Mark:=TRUE;//空叠隔膜中
	IF NOT Bnt_Blueflaging THEN
		IF Mach_Control.An_b.An_KDQuantited  = Mach_Control.Ca_b.Ca_KDQuantited   THEN//先叠正极
			DP_Step0:=1100;
		ELSIF Mach_Control.An_b.An_KDQuantited  > Mach_Control.Ca_b.Ca_KDQuantited   THEN//先叠负极
			DP_Step0:=1500;
		END_IF
	ELSE//判断隔膜平移轴位置
		IF AN_CarryingPos1 THEN	
			DP_Step0:=1100;			
		ELSIF Ca_CarryingPos1 THEN
			DP_Step0:=1500;	
		ELSE
			Mach_Control.DT_b.Error[57]:=TRUE;//空叠隔膜时正负极都不在取片位	
		END_IF	
	(*
		IF (Mach_Control.An_b.An_KDQuantited  <= Mach_Control.Ca_b.Ca_KDQuantited) AND AN_CarryingPos1   THEN//先叠正极
			DP_Step0:=1100;
		ELSE 
			IF Ca_CarryingPos1 THEN	
				DP_Step0:=1500;	
			ELSE
				;//空叠隔膜时正负极都不在取片位	
			END_IF
		END_IF
	*)
	END_IF		

1100://判断叠台搬运机械手是否有片
	IF AN_CarryingPos1  THEN//正极搬运、叠片各轴在初始位	
		IF arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch AND  Mach_Control.An_b.An_DPCarryingFalg THEN//正极再取片位且叠台搬运有片,把当前片放到纠偏台
			DP_Step0:=1150;
		ELSE
			DP_Step0:=2000;	
		END_IF
	ELSE
		Mach_Control.DT_b.Error[8]:=TRUE;//叠正极片凸轮耦合时，正极片不在取片位
		DP_Step0:=10001;
	END_IF	
	
1150://纠偏台回初始位
	//纠偏平台X1移动至初始位
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		//纠偏平台X2移动至初始位
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		//纠偏平台X2移动至初始位
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
			DT_SingeMode();//单步选择	
			DP_Step0:=1200;	
			DT_TON[5].IN:=FALSE;
		END_IF	
	END_IF
1200:
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[3] THEN
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
			/// 吸盘破真空    纠偏台开真空
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;	//正极叠台搬运升降真空	真空
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;	//正极叠台搬运升降真空破真空		
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;	//正极叠台搬运升降真空	真空
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bOFF:=FALSE;	//正极叠台搬运升降真空破真空											
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;	//正极纠偏台真空			
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;	//正极纠偏台真空	
			DT_SingeMode();//单步选择	
			DP_Step0:=1250;
			DT_TON[5].IN:=TRUE;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=3;//负极搬运升降2上升至凸轮耦合初始高度
		END_IF	
	END_IF	
1250://叠台搬运极片放回纠偏台
	IF NOT DP_SinStepe THEN
		  IF DT_TON[5].Q THEN
				IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
					arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
					/// 吸盘破真空    纠偏台开真空
					Mach_Control.An_b.An_deviationFalg:=TRUE;//复位纠偏平台有料标记
					Mach_Control.An_b.An_DPCarryingFalg:=FALSE;//负极搬运真空吸盘有料标记复位
					Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[2];
					DT_SingeMode();//单步选择	
					DP_Step0:=1300;
					DT_TON[5].IN:=FALSE;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极搬运升降2上升至凸轮耦合初始高度
				END_IF	
		 END_IF		
	END_IF			
1300:
	DP_Step0:=2000;	
	

	
	
	
1500://判断负极叠台搬运是否有片，有片的话放到纠偏台
	IF NOT DP_SinStepe THEN
		IF CA_CarryingPos1  THEN//负极搬运、叠片各轴在初始位
			IF arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch AND  Mach_Control.Ca_b.Ca_DPCarryingFalg THEN//正极再取片位且叠台搬运有片,把当前片放到纠偏台
				DP_Step0:=1550;
			ELSE
				DP_Step0:=3000;	
			END_IF
		ELSE
			IF (Ca_Step0=0 OR Ca_Step0=6666) AND (Ca_Step3=0 OR Ca_Step3=6666) AND Scan_TON[2].Q THEN
				Scan_TON[2].IN:=FALSE;		
				DP_Step0:=9994;
				DTPosError[2]:=TRUE;
			END_IF
		END_IF
	END_IF	
1550://纠偏台回初始位
	//纠偏平台X1移动至初始位
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		//纠偏平台X2移动至初始位
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		//纠偏平台X2移动至初始位
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Error THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
				arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=0;
			ELSE
				arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=1;
			END_IF					
		END_IF
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
			DT_SingeMode();//单步选择	
			DP_Step0:=1600;	
			DT_TON[5].IN:=FALSE;
		END_IF	
	END_IF
1600:
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[3] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
			/// 吸盘破真空    纠偏台开真空
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;	//负极叠台搬运升降真空	真空
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;	//负极叠台搬运升降真空破真空								
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;	//负极纠偏台真空			
			arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;	//负极纠偏台真空	   
			DT_SingeMode();//单步选择	
			DP_Step0:=1650;
			DT_TON[5].IN:=TRUE;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=3;//负极搬运升降2上升至凸轮耦合初始高度
		END_IF	
	END_IF
1650://叠台搬运极片放回纠偏台
	IF NOT DP_SinStepe THEN
		 IF DT_TON[5].Q THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
					/// 吸盘破真空    纠偏台开真空
					Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//复位纠偏平台有料标记
					Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;//负极搬运真空吸盘有料标记复位
					Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[9];
					DT_SingeMode();//单步选择	
					DP_Step0:=1700;
					DT_TON[5].IN:=FALSE;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极搬运升降2上升至凸轮耦合初始高度
				END_IF		
	    END_IF	
	END_IF	
1700:
	DP_Step0:=3000;	
	


	
2000:		
	IF NOT DP_SinStepe THEN
		IF AN_CarryingPos1  THEN//正极搬运、叠片各轴在初始位										
			IF CA_CarryingPos2 THEN//负极在叠片位
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF
					DP_Step0:=2010;//
				ELSE
					Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					DP_Step0:=9998;
				END_IF;
			ELSIF  CA_CarryingPos1  THEN //负极取片位
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF
					DP_Step0:=2030;//
				ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]  THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF
					DP_Step0:=2050;//
				ELSE
					Mach_Control.DT_b.Error[6]:=TRUE;//叠正极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					DP_Step0:=9999;
				END_IF;							
			ELSE
				Mach_Control.DT_b.Error[7]:=TRUE;//叠正极片凸轮耦合时，负极取片即不在取片位，也不在叠片位
				DP_Step0:=10000;
			END_IF
		ELSE
			Mach_Control.DT_b.Error[8]:=TRUE;//叠正极片凸轮耦合时，正极片不在取片位
			DP_Step0:=10001;
		END_IF
	END_IF		


2010://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在放极片初始位
	IF NOT DP_SinStepe THEN
		An_CanIn5:=TRUE;
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
		DP_Step0:=2020;	
	END_IF	
2020:
	IF NOT DP_SinStepe THEN
		IF NOT An_CanIn5 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF	
			DP_Step0:=2070;
		ELSIF fbAnCamInCarryingLine.bError  OR fbAnCamInDTCarryingLine.bError OR fbAnCamInDTCarryingUpDown.bError OR 
			fbAnCamInCarryingWhirling.bError OR fbCaCamInCarryingLine2.bError OR 
			fbCaCamInDTCarryingUpDown.bError OR fbCamInGMBuffer.bError OR fbCamInGMDanserMove.bError OR fbCamInVirGMDriver.bError   OR
			fbCamInRightYDUpDown.bError OR fbCamInRightYDLine.bError  THEN
			An_CanIn5:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			DP_Step0:=10004;		
		END_IF
	END_IF		
2030://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在取极片位
	IF NOT DP_SinStepe THEN
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF
		An_CanIn6:=TRUE;
		DP_Step0:=2040;
	END_IF
2040:
	IF NOT DP_SinStepe THEN
		IF NOT An_CanIn6 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			DP_Step0:=2070;
		ELSIF fbAnCamInCarryingLine.bError OR fbAnCamInDTCarryingLine.bError OR
			fbAnCamInDTCarryingUpDown.bError OR fbAnCamInCarryingWhirling.bError OR fbCamInGMBuffer.bError OR
			fbCamInGMDanserMove.bError OR fbCamInVirGMDriver.bError  OR fbCamInRightYDUpDown.bError OR
			fbCamInRightYDLine.bError  THEN
			An_CanIn6:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			DP_Step0:=10002;									
		END_IF
	END_IF
2050://负极搬运、叠片各轴在初始位，隔膜平移轴正极叠片位、正极叠片在取极片位
	IF NOT DP_SinStepe THEN
		An_CanIn7:=TRUE;
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
		DP_Step0:=2060;
	END_IF
2060:
	IF NOT DP_SinStepe THEN
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			IF NOT An_CanIn7 THEN
				IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
					DP_SinStepe:=TRUE;
				ELSE
					DP_SinStepe:=FALSE;	
				END_IF
				DP_Step0:=2070;
			ELSIF fbAnCamInCarryingLine.bError OR fbAnCamInCarryingUpDown.bError OR fbAnCamInDTCarryingLine.bError OR fbAnCamInDTCarryingUpDown.bError OR 
				fbAnCamInCarryingWhirling.bError OR fbCamInRightYDUpDown.bError OR fbCamInRightYDLine.bError THEN
				An_CanIn7:=FALSE;
				Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
				DP_Step0:=10003;												
			END_IF
	END_IF	
	
2070://判断正极叠片搬运机械手上是否有极片

	IF NOT DP_SinStepe THEN
		VirMain_TON.IN:=FALSE;
		IF (NOT arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch AND NOT Mach_Control.An_b.An_DPCarryingFalg) OR Bnt_Blueflaging THEN	
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			DP_Step0:=2071;
		ELSE	
		  	Mach_Control.An_b.Error[28]:=TRUE; //正极叠片完空叠隔膜时，正极叠片搬运机械手真空有信号、标记有极片报警,请拿掉极片
		END_IF  
	END_IF

2071://主轴启动
	IF NOT DP_SinStepe THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
		arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;	
		//fbCaCamInCarryingUpDown2OutCamFlge:=FALSE;//负极升降2凸轮解耦标记										
		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
			VirMain_TON.IN:=FALSE;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			DP_Step0:=2080;	
		ELSE
			IF NOT VirMain_TON.Q THEN
				VirMain_TON.IN:=TRUE;
			ELSE
				VirMain_TON.IN:=FALSE;
				Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
				DP_Step0:=10006;	
			END_IF	
		END_IF	
	END_IF				
			
(*2080:
IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>=234 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos<=240 THEN
	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极叠片搬运真空关
	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuumBark].Cmd.bON:=TRUE;//正极叠片搬运破真空开
	Mach_Control.An_b.An_DPCarryingFalg :=FALSE;//复位正极叠片搬运吸盘上有料标记																									
END_IF				
IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
			Mach_Control.An_b.An_KDQuantited:=Mach_Control.An_b.An_KDQuantited +1;
			DP_Step1:=100;//解除耦合，主轴回零子程序
			arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-Par.stDT_date.SEPTA_Thickness;
			arrAxisPar[AxiseNo.AxisName.DTUpDown].fVelocity_of_Rel:=100;
			arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bMoveRel:=TRUE;
			DP_Step0:=0;
END_IF*)

3000:
	IF NOT DP_SinStepe THEN		
		Scan_TON[2].IN:=TRUE;	
		IF CA_CarryingPos1  THEN//负极搬运、叠片各轴在初始位
			Scan_TON[1].IN:=TRUE;	
			IF AN_CarryingPos2  THEN//正极在叠片位	
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]   THEN													
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF												
					DP_Step0:=3010;//													
				ELSE
					Mach_Control.DT_b.Error[5]:=TRUE;//叠负极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					DP_Step0:=9991;	
				END_IF;
			ELSIF AN_CarryingPos1  THEN//在取片位																		
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF											
					DP_Step0:=3030;//
				ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF											
					DP_Step0:=3050;//
				ELSE
					Mach_Control.DT_b.Error[5]:=TRUE;//叠负极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					DP_Step0:=9992;	
				END_IF;							
			ELSIF Scan_TON[1].Q THEN
				Scan_TON[1].IN:=FALSE;	
				DP_Step0:=9993;
				DTPosError[4]:=TRUE;
			END_IF
		ELSE
			IF (Ca_Step0=0 OR Ca_Step0=6666) AND (Ca_Step3=0 OR Ca_Step3=6666) AND Scan_TON[2].Q THEN
				Scan_TON[2].IN:=FALSE;		
				DP_Step0:=9994;
				DTPosError[2]:=TRUE;
			END_IF
		END_IF
END_IF		

3010://负极搬运、叠片各轴在初始位，隔膜平移轴正极叠片位、正极叠片在放极片初始位
	IF NOT DP_SinStepe THEN
		Ca_CanIn5:=TRUE;
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF
		DP_Step0:=3020;	
	END_IF
3020:
	IF NOT DP_SinStepe THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
		IF NOT Ca_CanIn5 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			DP_Step0:=3070;	
		ELSIF fbCaCamInCarryingLine2.bError OR  fbCaCamInDTCarryingLine.bError OR fbCaCamInDTCarryingUpDown.bError OR 
			fbCamInGMBuffer.bError OR fbCamInGMDanserMove.bError OR fbCamInVirGMDriver.bError OR fbAnCamInCarryingLine.bError OR 
			fbAnCamInDTCarryingLine.bError OR fbAnCamInCarryingWhirling.bError OR fbCamInLeftYDUpDown.bError OR fbCamInLeftYDLine.bError THEN
			Ca_CanIn5:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			DP_Step0:=9998;										
		END_IF
	END_IF
3030://负极搬运、叠片各轴在初始位，隔膜平移轴负极叠片位、正极叠片在取极片位
	IF NOT DP_SinStepe THEN
		Ca_CanIn6:=TRUE;
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF
		DP_Step0:=3040;
	END_IF
3040://判断凸轮耦合是否完成
	IF NOT DP_SinStepe THEN
		IF NOT Ca_CanIn6 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			DP_Step0:=3070;
		ELSIF  fbCaCamInCarryingLine2.bError OR fbCaCamInDTCarryingLine.bError OR 
			fbCaCamInDTCarryingUpDown.bError OR fbCamInLeftYDUpDown.bError OR 	fbCamInLeftYDLine.bError THEN										
			Ca_CanIn6:=FALSE;
			Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			DP_Step0:=9995;		
		END_IF
	END_IF
3050://负极搬运、叠片各轴在初始位，隔膜平移轴正极叠片位、正极叠片在取极片位
	IF NOT DP_SinStepe THEN
		Ca_CanIn7:=TRUE;
		IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
			DP_SinStepe:=TRUE;
		ELSE
			DP_SinStepe:=FALSE;	
		END_IF
		DP_Step0:=3060;
	END_IF
3060:
	IF NOT DP_SinStepe THEN
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			IF NOT Ca_CanIn7 THEN
				IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
					DP_SinStepe:=TRUE;
				ELSE
					DP_SinStepe:=FALSE;	
				END_IF																			
				DP_Step0:=3070;
			ELSIF fbCaCamInCarryingLine2.bError OR fbCaCamInDTCarryingLine.bError OR 
				fbCaCamInDTCarryingUpDown.bError OR fbCamInGMBuffer.bError OR fbCamInGMDanserMove.bError OR
				fbCamInVirGMDriver.bError OR fbCamInLeftYDUpDown.bError OR fbCamInLeftYDLine.bError  THEN
				Ca_CanIn7:=FALSE;
				Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
				DP_Step0:=9996;	
			END_IF
	END_IF

3070://判断负极叠片搬运机械手上是否有极片
	VirMain_TON.IN:=FALSE;
	DP_Step0:=3071;
	(*
	IF NOT DP_SinStepe THEN
		IF NOT arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch AND NOT Mach_Control.Ca_b.Ca_DPCarryingFalg  THEN	
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			DP_Step0:=3071;
		ELSE	
		  	Mach_Control.Ca_b.Error[28]:=TRUE; //负极叠片完空叠隔膜时，负极叠片搬运机械手真空检测有信号报警,请拿掉极片
		END_IF  
	END_IF	 
	*)
3071://主轴启动
	IF NOT DP_SinStepe THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;
		arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;	
		//fbCaCamInCarryingUpDown2OutCamFlge:=FALSE;//负极升降2凸轮解耦标记										
		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
			VirMain_TON.IN:=FALSE;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			DP_Step0:=3080;	
		ELSE
			IF NOT VirMain_TON.Q THEN
				VirMain_TON.IN:=TRUE;
			ELSE
				VirMain_TON.IN:=FALSE;
				Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
				DP_Step0:=10006;	
			END_IF	
		END_IF	
	END_IF	

END_CASE
END_IF


(**************************************************************************************电芯下料**************************************************************************************************************)
CASE DP_Step0 OF
2080:
IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos>=234 AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos<=240 THEN
	arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运升降真空关
     arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运升降真空关
	Mach_Control.An_b.An_DPCarryingFalg :=FALSE;//复位正极叠片搬运吸盘上有料标记																									
END_IF				
IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
			Mach_Control.An_b.An_KDQuantited:=Mach_Control.An_b.An_KDQuantited +1;
			DP_Step1:=100;//解除耦合，主轴回零子程序
			arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-Par.stDT_date.SEPTA_Thickness;
			arrAxisPar[AxiseNo.AxisName.DTUpDown].fVelocity_of_Rel:=100;
			arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bMoveRel:=TRUE;
			DP_Step0:=0;
END_IF
	
(*2080:
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		Mach_Control.An_b.An_KDQuantited:=Mach_Control.An_b.An_KDQuantited +1;
		DPcount:=DPcount+1;	
		DP_Step1:=100;//解除耦合，主轴回零子程序
		arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-Par.stDT_date.SEPTA_Thickness;
		arrAxisPar[AxiseNo.AxisName.DTUpDown].fVelocity_of_Rel:=100;
		arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bMoveRel:=TRUE;
		DP_Step0:=0;
	END_IF*)


3080:

	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		Mach_Control.Ca_b.Ca_KDQuantited:=Mach_Control.Ca_b.Ca_KDQuantited +1;
		DPcount:=DPcount+1;	
		DP_Step1:=100;//解除耦合，主轴回零子程序
		arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.fPosition_of_Rel:=-Par.stDT_date.SEPTA_Thickness;
		arrAxisPar[AxiseNo.AxisName.DTUpDown].fVelocity_of_Rel:=100;
		arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bMoveRel:=TRUE;							
		DP_Step0:=0;
	END_IF		
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="_01DT_Auto4" Id="{dfc5d3f0-5e02-4ffe-aeff-76e924220091}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下
CASE DP_Step0 OF		
	6000://叠片完成，负极升降机械手回到安全位
			IF NOT DP_SinStepe THEN
						//负极取片2升降安全位
						IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving AND 
							NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Error THEN
								IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=4;//负极搬运升降2移动至初始高度
								END_IF
						END_IF				
						//负极叠片取片升降等待位
						IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND
							 NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
									IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
											arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;							
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极叠片升降移动至等待高度
									END_IF
						END_IF
						
						IF 	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4]  AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving AND 
								arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] 	AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving THEN
								IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
											DP_SinStepe:=TRUE;
								ELSE
											DP_SinStepe:=FALSE;	
								END_IF
								DP_Step0:=6010;
					END_IF
			END_IF
		6010://判断主轴是否停止、是否在初始位、是否有轴在耦合中
			IF NOT DP_SinStepe THEN
				IF CA_CarryingPos2 THEN
					IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.ActPos=0 AND NOT DT_AxiseCoupling THEN
						DT_SingeMode();//单步选择						
						DP_Step0:=6012;
					ELSE
						DP_Step1:=100;//调用主轴回初始位子程序
						DT_SingeMode();//单步选择							
						DP_Step0:=6011;
					END_IF
				ELSIF  CA_CarryingPos1 THEN
					DP_Step0:=6014;
				END_IF	
			END_IF
					
		6011://判断主轴的模长的当前位置是否为0
			IF NOT DP_SinStepe THEN
				IF DP_Step1=6666 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.ActPos=0 AND NOT DT_AxiseCoupling THEN
					DT_SingeMode();//单步选择						
					DP_Step0:=6012;
				END_IF
			END_IF		

		6012:
			//负极送片搬运平移
				fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=-1;
				fbCaCamInCarryingLine2.bCamInExecute:=TRUE;								
		        fbCaCamInCarryingUpDown2.iTableSel:=3;    //20240528SJ
	            fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;		
				
			//负极叠台搬运平移
				fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
				fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;	
			    fbCaCamInDTCarryingUpDown.iTableSel:=3;   //20240528SJ
	            fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
				
			//负极叠片升降轴放片凸轮耦合
				//fbCaCamInDTCarryingUpDown.iTableSel:=2;
				//fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;		
														  
			IF fbCaCamInCarryingLine2.bInSync AND fbCaCamInDTCarryingLine.bInSync AND  fbCaCamInCarryingUpDown2.bInSync AND fbCaCamInDTCarryingUpDown.bInSync   THEN   
				DT_SingeMode();//单步选择		
				DP_Step0:=6013;
			ELSIF fbCaCamInCarryingLine2.bError  OR  fbCaCamInDTCarryingLine.bError  OR 
                    fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingUpDown.bError   THEN   
				Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
			END_IF	
		6074:	
			IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving THEN 
				DP_Step1:=100;
				DP_Step0:=6075;	
			END_IF
		  
		6075:  
			IF DP_Step1=6666 THEN	
				DP_Step0:=6014;						
			END_IF		
		  
		6014:
			IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.ActPos=0 AND NOT DT_AxiseCoupling 
				AND CA_CarryingPos1 THEN
				DP_Step0:=6015;	
			ELSIF  DT_AxiseCoupling THEN
				DP_Step1:=100;
				DP_Step0:=6075;	
			END_IF  
	(*
				IF NOT DP_SinStepe THEN
					//负极取片2平移取片位
											IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND
												 arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Error THEN
													IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] THEN
															arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.iGoSetPos:=0;					
													ELSE
														arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.iGoSetPos:=1;//负极搬运平移2移动至初始位取流水线上的极片
													END_IF
											END_IF
					//负极叠片平移取片位
										IF TailCurlSEPTA_SafePos  AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND
											 arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Error THEN
												IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] THEN
														arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.iGoSetPos:=1;//负极叠片平移至初始位
												END_IF
										END_IF
										
										IF 	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] AND 	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving AND 
													arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] AND 	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving THEN
													IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
																DP_SinStepe:=TRUE;
													ELSE
																DP_SinStepe:=FALSE;	
													END_IF
													DP_Step0:=6015;	
										//ELSIF  THEN											
										END_IF
				END_IF
	*)			
		6015:
			IF NOT DP_SinStepe THEN
					//负极叠片升降避让位
					IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND
						 NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] THEN
								arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;							
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=5;//负极叠片升降移动至避让高度
						END_IF
					END_IF
					
					IF 	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] 	AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving THEN
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF
						DP_Step0:=6016;
				END_IF
			END_IF
END_CASE
END_IF


CASE DP_Step0 OF
	6013:
		IF NOT DP_SinStepe THEN
			 arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bDynamitcsParSel:=2;	
			 arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
			 arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.fPositon_of_Abs:=360;
			 arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bMoveAbs:=TRUE;			
			IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=5  THEN		
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd.bMoveAbs:=FALSE;
				Ca_TON[2].IN:=FALSE;                               	
				DP_Step0:=6074;	
				//Ca_StandbyStep1:=300;  //取消调用负极送片搬运取流水线极片
				//Ca_StandbyStep5:=400;
			ELSE
				IF NOT Ca_TON[2].Q THEN
					Ca_TON[2].IN:=TRUE;
				ELSE
				Ca_TON[2].IN:=FALSE;
					Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
					arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
				END_IF
			END_IF	
		END_IF	
					
	6016://纠偏平台回原
		 IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5]  THEN
			 DP_Step11:=100;//正极纠偏平台回原
			 DP_Step12:=100;//负极纠偏平台回原
			 DP_Step0:=6020;
		 END_IF


	6020:
				IF Mach_Control.DT_b.DT_Oerhang_Z<>2 OR   Mach_Control.DT_b.DT_Overhang THEN
					CellMemory[Mach_Control.DT_b.DT_Memory].Hough:=1;
					DP_Step0:=6025;
					NN:=0;
				ELSE 
					CellMemory[Mach_Control.DT_b.DT_Memory].Hough:=2;
					DP_Step0:=6024;
				END_IF
				
	6024:
				NN:=NN+1;
				DP_Step0:=6025;			
																
	6025:
			Mach_Control.DT_b.DT_amount:=Mach_Control.DT_b.DT_amount+1;
			CellMemory[Mach_Control.DT_b.DT_Memory].Cell:=TRUE;	
			CellMemory[Mach_Control.DT_b.DT_Memory].DT_station_No:=Mach_Control.DT_b.DT_No;
			CellMemory[Mach_Control.DT_b.DT_Memory].DT_speed:=Par.stDT_date.SinglePosTime;
			CellMemory[Mach_Control.DT_b.DT_Memory].An_Quantity:=Mach_Control.An_b.An_Quantited;
			CellMemory[Mach_Control.DT_b.DT_Memory].Ca_Quantity:=Mach_Control.Ca_b.Ca_Quantited;
			//CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension:=LIMIT(150,Mach_Control.DT_b.DiaphragmUnwindingTension,250);	
            // CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension:=CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[210].GMlapTen;				
			//CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension_max:=ABS(Mach_Control.DT_b.DiaphragmUnwindingTension+10);	
			//CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension_min:=ABS(Mach_Control.DT_b.DiaphragmUnwindingTension-4);	
			//CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension_ave:=ABS(Mach_Control.DT_b.DiaphragmUnwindingTension+5);	
			//[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension_set:=ABS(Mach_Control.DT_b.DiaphragmUnwindingTension);
	
            CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension:=LIMIT(150,CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[210].GMlapTen,250);				
			CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension_max:=LIMIT(150,CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[210].GMlapTen+10,250);	
			CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension_min:=LIMIT(150,CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[210].GMlapTen-4,250);	
			CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension_ave:=LIMIT(150,CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[210].GMlapTen+5,250);	
			CellMemory[Mach_Control.DT_b.DT_Memory].DiaphragmUnwindingTension_set:=LIMIT(150,CellMemory[Mach_Control.DT_b.DT_Memory].Chipdata[210].GMlapTen,250);	
			
			CellMemory[Mach_Control.DT_b.DT_Memory].Put_Time :=Mach_Control.DT_b.Put_time;
			CellMemory[Mach_Control.DT_b.DT_Memory].Machine_No:=Mach_Control.DT_b.Machine_No;
			CellMemory[Mach_Control.DT_b.DT_Memory].Cell_CCD_No:=CCD.Over.Finish.stCellNo;
			CellMemory[Mach_Control.DT_b.DT_Memory].BlueGlue:=1;
			
			CellMemory[Mach_Control.DT_b.DT_Memory].An_stuff_No:=Par.stDT_date.An_stuff_No;
			CellMemory[Mach_Control.DT_b.DT_Memory].Ca_stuff_No:=Par.stDT_date.Ca_stuff_No;
			CellMemory[Mach_Control.DT_b.DT_Memory].Diaphragm_No:=Par.stDT_date.Diaphragm_No;
			CellMemory[Mach_Control.DT_b.DT_Memory].PostiveCode:=CellMemory[Mach_Control.DT_b.DT_Memory].An_MQ_Slice[Mach_Control.An_b.An_Quantited].Code;//正极片条码
			CellMemory[Mach_Control.DT_b.DT_Memory].NegativeCode:=CellMemory[Mach_Control.DT_b.DT_Memory].Ca_MQ_Slice[Mach_Control.Ca_b.Ca_Quantited].Code;//负极片条码
		
		    CellMemory[Mach_Control.DT_b.DT_Memory].LYDLineinitPos:=arrAxisPar[AxiseNo.AxisName.LeftYDLine].arrTargetPoint[1];
			CellMemory[Mach_Control.DT_b.DT_Memory].LYDLineOpenPos :=arrAxisPar[AxiseNo.AxisName.LeftYDLine].arrTargetPoint[2];
			CellMemory[Mach_Control.DT_b.DT_Memory].LYDLinepressL :=arrAxisPar[AxiseNo.AxisName.LeftYDLine].arrTargetPoint[12];
			CellMemory[Mach_Control.DT_b.DT_Memory].RYDLineinitPos:=arrAxisPar[AxiseNo.AxisName.RightYDLine].arrTargetPoint[1];
			CellMemory[Mach_Control.DT_b.DT_Memory].RYDLineOpenPos :=arrAxisPar[AxiseNo.AxisName.RightYDLine].arrTargetPoint[2];
			CellMemory[Mach_Control.DT_b.DT_Memory].RYDLinepressL :=arrAxisPar[AxiseNo.AxisName.RightYDLine].arrTargetPoint[12];
			CellMemory[Mach_Control.DT_b.DT_Memory].LYDUpDowninitPos:=arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[1];
			CellMemory[Mach_Control.DT_b.DT_Memory].LYDUpDownOpenPos :=arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[2];
			CellMemory[Mach_Control.DT_b.DT_Memory].LYDUpDownOpenH:=arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[11];
			CellMemory[Mach_Control.DT_b.DT_Memory].LYDUpDownKnifeH:=arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[12];
			CellMemory[Mach_Control.DT_b.DT_Memory].RYDUpDowninitPos :=arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[1];
			CellMemory[Mach_Control.DT_b.DT_Memory].RYDUpDownOpenPos :=arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[2];
			CellMemory[Mach_Control.DT_b.DT_Memory].RYDUpDownOpenH:=arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[11];
			CellMemory[Mach_Control.DT_b.DT_Memory].RYDUpDownKnifeH:=arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[12];
			CellMemory[Mach_Control.DT_b.DT_Memory].DTandescendh:=Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness+Par.stDT_date.Pole_ThicknessCom;
			CellMemory[Mach_Control.DT_b.DT_Memory].DTcadescendh:=Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness+Par.stDT_date.Pole_ThicknessCom;
		
			
			IF Mach_Control.DT_b.DT_DebugMode THEN
			   CellMemory[Mach_Control.DT_b.DT_Memory].DTDebugMode:=TRUE;
			END_IF
			
			IF Mach_Control.DT_b.Overhang_TF THEN
			CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_TF:=TRUE;
			ELSE
			CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_TF:=FALSE;	
			END_IF
			DP_Step0:=6030;	

					
	6030:			
				Mach_Control.DT_b.Overhang_TF:=FALSE;	
				Mach_Control.DT_b.OffloadRequest:=TRUE;//叠电芯完成，请求下电芯
				DP_Step0:=6040;	
	6040://
		IF Mach_Control.DT_b.OffloadDone THEN
			bFirstFoldFinish[1]:=FALSE;//首层隔膜空叠
			bFirstFoldFinish[2]:=FALSE;//正常电芯空叠隔膜
			bFirstFoldFinish[3]:=FALSE;//接带、黄标空叠隔膜
			bEmptyFoldMark[1]:=FALSE;//进入空叠流程
			bEmptyFoldMark[2]:=FALSE;//进入空叠流程
			bEmptyFoldMark[3]:=FALSE;//进入空叠流程	
			Mach_Control.An_b.An_FirstFoldCnt:=0;
			Mach_Control.Ca_b.Ca_FirstFoldCnt:=0;
			Mach_Control.DT_b.OffloadRequest:=FALSE;//叠电芯完成，请求下电芯
			Mach_Control.An_b.An_Quantited:=0;
			Mach_Control.Ca_b.Ca_Quantited:=0;
			Mach_Control.An_b.An_KDQuantited :=0;
			Mach_Control.Ca_b.Ca_KDQuantited:=0;
			Mach_Control.DT_b.OffloadDone:=FALSE;
			OversequelNG:=FALSE;	
			DP_Step0:=6041;	
		END_IF

	6041://负极叠台升降、取片升降到等待高度等待耦合
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;				
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极叠片升降移动至取片位
		END_IF
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=0;				
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=4;//负极叠片升降移动至取片位
		END_IF
		IF  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
			DP_Step0:=6042;
		END_IF
	
	6042://	等待纠偏平台回原完成		
			IF DP_Step11=6666 AND DP_Step12=6666 THEN
			   DP_Step0:=0;
			END_IF															
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="_01DT_Auto5" Id="{6b265681-2012-48c5-a537-2aa08a847760}" FolderPath="03DietaiAuto\">
