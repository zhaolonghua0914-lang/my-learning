	fSaveLength:=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[1] , //安全高度
	fInitLength:=arrAxisPar[AxiseNo.AxisName.AnCarryingUpDown].arrTargetPoint[4],//升降轴耦合初始位
	fMasterKeyPos1:=90 , //72
	fMasterKeyPos2:=180 , //144
	fMasterKeyPos3:=229 , //198
	fMasterKeyPos4:=310 , //324
