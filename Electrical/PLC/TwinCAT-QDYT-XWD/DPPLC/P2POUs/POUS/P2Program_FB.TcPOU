	Deceleration:= , 
	Jerk:= , 
	BufferMode:= , 
	Options:= , 
	InGear=> , 
	Busy=> , 
	Active=> , 
	CommandAborted=> , 
	Error=> , 
	ErrorID=> );
tailCurl2_GearIn.Error;
tailCurl2_GearIn.InGear;
	
fTailCurl3_TRIG(CLK:=tailCurl2_GearIn.Execute , Q=> );
tailCurl3_CamOut(
	Slave:=arrAxis[AxiseNo.AxisName.LCurlingneedleWhirling], 
	Execute:=fTailCurl3_TRIG.Q , 
	Options:= , 
