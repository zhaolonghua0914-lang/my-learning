AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[2]
AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] 
