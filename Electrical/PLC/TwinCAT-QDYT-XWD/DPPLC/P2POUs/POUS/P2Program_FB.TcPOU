	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.GoPoint_Condition[5]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.GoPoint_Condition[5]:=FALSE;	
END_IF

//负极叠台搬运平移1
IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND 
	(*arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[1] AND*)
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[1] AND
	 arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.fSetPos<= arrAxisPar[AxiseNo.AxisName.CaCarryingLine2].arrTargetPoint[1]+1 AND
	//  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] AND 
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving  AND
         arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Io.DIOFFSwitch  AND	 arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Io.DIOnSwitch THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.WJ_iMode=3 
AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState 
AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState THEN
   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.JogP_Condition:=TRUE;
   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.JogN_Condition:=TRUE;
   ELSE 
   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.JogP_Condition:=FALSE;
   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.JogN_Condition:=FALSE;
 END_IF


IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND 
 	(*arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[1] AND *)
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[1] AND
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] 
   AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState 
   AND	 arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState  THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF


IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed
 (*arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.fActPos=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[1] *)
AND  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[1]
AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]
AND NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] 
AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState 
AND	 arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState  THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF


//负极叠台搬升降移1
IF Mach_Control.U.DT_iMode=3  THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.GoPoint_Condition[3]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.GoPoint_Condition[4]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.GoPoint_Condition[4]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.GoPoint_Condition[5]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.GoPoint_Condition[5]:=FALSE;	
END_IF

//负极NG料盒伸缩气缸条件CaCarryingUpDown1
IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] AND (arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[5] OR arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] )
   AND  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Io.DIOnSwitch THEN
	arrCyCtrl[arrCyNo.CylinderName.	CaScrapbinCy].Cmd.OnCondition:=TRUE;
    arrCyCtrl[arrCyNo.CylinderName.	CaScrapbinCy].Cmd.OffCondition:=TRUE;
ELSE	
	arrCyCtrl[arrCyNo.CylinderName.	CaScrapbinCy].Cmd.OnCondition:=FALSE;
    arrCyCtrl[arrCyNo.CylinderName.	CaScrapbinCy].Cmd.OffCondition:=FALSE;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_Gohome" Id="{ce09218f-7459-4fbc-8b28-af9b0758f130}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[	Ca_GohomeTon(IN:= , PT:=T#1S , Q=> , ET=> );//负极回原点延时
Ca_GohomeOverTon(IN:= , PT:=T#90S , Q=> , ET=> );//负极回原点超时报警延时
Ca_BeltGohomeOverTon(IN:= , PT:=T#90S , Q=> , ET=> );//负极皮带回原点超时报警延时
rCa_Gohome_TRIG(CLK:=Mach_Control.Ca_b.Ca_GohomeHMI , Q=> );//负极回原点启动
fCa_Gohome_TRIG(CLK:=Mach_Control.Ca_b.Ca_GohomeHMI , Q=> );//负极回原点启动


Ca_BeltGohomeTon(IN:= , PT:=T#1S , Q=> , ET=> );//负极回原点延时
Ca_BeltGohomeOverTon(IN:= , PT:=T#90S , Q=> , ET=> );//负极回原点超时报警延时
rCa_BeltGohome_TRIG(CLK:=Mach_Control.Ca_b.Ca_BeltGohomeHMI , Q=> );//
fCa_BeltGohome_TRIG(CLK:=Mach_Control.Ca_b.Ca_BeltGohomeHMI , Q=> );//

//判断回原点是否完成
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND 
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND 	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed AND
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed AND 	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed AND 
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND Ca_GohomeDone THEN
					Mach_Control.Ca_b.Ca_GohomeDone:=TRUE;//负极取片回原点完成
		ELSE
					Mach_Control.Ca_b.Ca_GohomeDone:=FALSE;//负极取片回原点完成
		END_IF	
//判断负极皮带初始化是否完成
IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Homed AND 
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed AND Ca_BeltGohomeDone THEN
		Mach_Control.Ca_b.Ca_BeltGohomeDone:=TRUE;
ELSE
		Mach_Control.Ca_b.Ca_BeltGohomeDone:=FALSE;
END_IF
 
		
		
		
		
IF Mach_Control.U.DT_iMode=3 THEN//在手动状态下
//回原点超时报警	
IF  Ca_Gohoming THEN
		IF 	NOT Ca_GohomeOverTon.Q THEN
			    Ca_GohomeOverTon.IN:=TRUE;
		ELSE
			IF 	 Ca_GohomeOverTon.Q THEN
				Ca_Gohoming:=FALSE;
			     Mach_Control.Ca_b.Error[19]:=TRUE;//负极回原点超时报警
			     Ca_GohomeOverTon.IN:=FALSE;
			END_IF	 
				 
		END_IF

ELSE
		Ca_GohomeOverTon.IN:=FALSE;
END_IF

//手动触发
IF rCa_Gohome_TRIG.Q THEN
Step_InitCaDT:=0;
Ca_GohomeDone:=FALSE;//负极取片回原点完成
Ca_Gohoming:=FALSE;//负极取片回原点中
END_IF	
//负极取料机构初始化
CASE Step_InitCaDT OF
0://等待负极回原点启动信号
	IF fCa_Gohome_TRIG.Q THEN
		Ca_GohomeDone:=FALSE;//负极取片回原点完成
		Ca_Gohoming:=TRUE;//负极取片回原点中
		Mach_Control.Ca_b.Ca_GohomeHMI:=FALSE;
		Step_InitCaDT:=1;
	END_IF	
1://复位回原点完成
	Ca_GohomeTon.IN:=FALSE;
	Mach_Control.Ca_b.Ca_MainBelting:=FALSE;
	IF NOT Ca_GohomeDone THEN
		Step_InitCaDT:=10;
	END_IF 				
10://
	Mach_Control.Ca_b.Ca_CarryingFalg:=FALSE;//负极搬运升降有料标记
	Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;//负极叠片搬运有料标记
	Mach_Control.Ca_b.Ca_deviationFalg:=FALSE;//负极纠偏平台有料标记
	Ca_Step0:=0;//负极搬运子程序1
	Ca_Step1:=0;//负极搬运子程序2
	Ca_Step2:=0;//负极搬运子程序3
	Ca_Step3:=0;//负极搬运子程序4
	Ca_RectifydevStep :=0;//纠偏自动程序
	Ca_Demarcate_Step0:=0;//纠偏标定程序步
	Ca_RecdevPla_Step0:=0;//纠偏自动程序步
	Ca_StandbyStep0:=0;//负极自动备料自动步清零
	Ca_StandbyStep1:=0;//叠负极片，判断真空阀的开关
	Ca_StandbyStep5:=0;//叠负极片，判断主轴是否完成
	Step_InitCaDT:=20;//取负极片回原点
20:
	//fbCaCamInCarryingLine1.bCamInExecute,:=TURE;//负极取流水线平移
	//fbCaCamInCarryingUpDown1.bCamInExecute:=TRUE;//负极取流水线升降
	fbCaCamInCarryingLine2.bCamInExecute:=FALSE;//负极送片搬运平移
	fbCaCamInCarryingUpDown2.bCamInExecute:=FALSE;//负极送片搬运升降
	fbCaCamInDTCarryingLine.bCamInExecute:=FALSE;//负极叠片搬运平移
	fbCaCamInDTCarryingUpDown.bCamInExecute:=FALSE;//负极叠片搬运升降		
	
	IF NOT fbCaCamInCarryingLine2.bCamInExecute AND NOT  fbCaCamInCarryingUpDown2.bCamInExecute AND
		 NOT fbCaCamInDTCarryingLine.bCamInExecute AND NOT  fbCaCamInDTCarryingUpDown.bCamInExecute THEN
			Step_InitCaDT:=25;
	END_IF						
25:
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.bHalt:=TRUE;//负极送片搬运1升降解耦
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bHalt:=TRUE;//负极送片搬运2升降解耦
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bHalt:=TRUE;//负极叠台搬运升降解耦
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.bHalt:=TRUE;//负极搬运平移1解耦
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bHalt:=TRUE;//负极搬运平移2解耦
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bHalt:=TRUE;//负极叠片搬运平移解耦	

	IF  NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving AND  
	NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving AND 
	NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND  
	NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.NoMoving AND
	NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving AND  
	NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving THEN
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.bHalt:=FALSE;//负极送片搬运1升降解耦
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bHalt:=FALSE;//负极送片搬运2升降解耦
		arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bHalt:=FALSE;//负极叠台搬运升降解耦
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.bHalt:=FALSE;//负极搬运平移1解耦
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bHalt:=FALSE;//负极搬运平移2解耦
		arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bHalt:=FALSE;//负极叠片搬运平移解耦							   
		Step_InitCaDT:=30;
	END_IF
30://
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bEnable:=TRUE;//负极送片搬运2升降
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bEnable:=TRUE;//负极叠台搬运升降
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bEnable:=TRUE;//负极搬运平移2
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bEnable:=TRUE;//负极叠片搬运平移
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.bEnable:=TRUE;//负极纠偏X1轴使能
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.bEnable:=TRUE;//负极纠偏X2轴使能	
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.bEnable:=TRUE;//负极纠偏Y轴使能		
	IF    	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Enabled AND 
		arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Enabled AND 								   
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Enabled AND 
		arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Enabled AND 
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Enabled AND 
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Enabled  AND 
		arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Enabled  THEN
				Step_InitCaDT:=35;
	ELSIF  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Error OR 
		arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error OR 								   
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Error OR 
		arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Error OR 
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Error OR 
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Error  OR 
		arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Error  THEN
		Step_InitCaDT:=9999;								
	END_IF		

35://负极取片1升降，负极送片1升降、负极叠片升降回原点
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bHome:=TRUE;//负极送片搬运2升降回原点	
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bHome:=TRUE;//负极叠台搬运升降回原点				
	Step_InitCaDT:=40;

40://判断回原点是否完成 arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND
	IF NOT Ca_GohomeTon.Q THEN	
		Ca_GohomeTon.IN:=TRUE;
	ELSE		
		IF  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving AND 
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bHome:=FALSE;//负极送片搬运2升降回原点	
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bHome:=FALSE;//负极叠台搬运升降回原点		
			Ca_GohomeTon.IN:=FALSE;					   
			Step_InitCaDT:=45;
		ELSIF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bHome:=FALSE;//负极送片搬运2升降回原点	
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bHome:=FALSE;//负极叠台搬运升降回原点	
			Ca_GohomeTon.IN:=FALSE;	
			Ca_Gohoming:=FALSE;//负极取片回原点中	
			Step_InitCaDT:=9999;
		END_IF
	END_IF

45:
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[5] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=0;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=5;
		END_IF	
	END_IF

	IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5]  THEN
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=5;
		END_IF	
	END_IF		
	
  IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5]  THEN
	Step_InitCaDT:=50;
  END_IF	
  
	IF  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Error THEN
		Ca_Gohoming:=FALSE;//负极取片回原点中	
		Step_InitCaDT:=9999;
	END_IF	

	
50:
IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] OR arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Io.DIOnSwitch THEN
	arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;//负极纠偏NG料盒气缸伸出
	IF arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState THEN
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;//负极纠偏NG料盒气缸升降气缸下降
		IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState THEN								
			Step_InitCaDT:=60;
		END_IF
	ELSIF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.Error1 OR arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.Error2 OR
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.Error1 OR arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.Error2 THEN
		Ca_Gohoming:=FALSE;//负极取片回原点中	
		Step_InitCaDT:=9999;
	END_IF
ELSE
	Mach_Control.Ca_b.Error[42] :=TRUE;//负极机械手初始化时，叠台搬运升降不在避让位
	Ca_Gohoming:=FALSE;//负极取片回原点中	
	Step_InitAnDT:=9999;
END_IF
	
60:
	IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[1]  THEN
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
			Step_InitCaDT:=65;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=1;
		END_IF	
	END_IF		
	IF  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
		Ca_Gohoming:=FALSE;//负极取片回原点中	
		Step_InitCaDT:=9999;
	END_IF	


65://负极搬运平移1、负极搬运平移2、负极叠片平移回原点、纠偏X1轴回原点、纠偏X2轴回原点、纠偏Y轴回原点
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bHome:=TRUE;//负极搬运平移2							
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.bHome:=TRUE;//负极纠偏X1
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.bHome:=TRUE;//负极纠偏X2
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.bHome:=TRUE;//负极纠偏Y
	Ca_Carrying2TorMark:=TRUE;//负极搬运2平移力矩判断标志位
	Step_InitCaDT:=70;
70://判断回原点是否完成  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed AND 
	IF NOT Ca_GohomeTon.Q THEN				 
		Ca_GohomeTon.IN:=TRUE;
	ELSE			
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving AND
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND
			arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving	 THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bHome:=FALSE;//负极搬运平移2
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bHome:=FALSE;//负极叠片搬运平移		
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.bHome:=FALSE;//负极纠偏X1	
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.bHome:=FALSE;//负极纠偏X2
			arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.bHome:=FALSE;//负极纠偏Y
			Ca_Carrying2TorMark:=FALSE;//负极搬运2平移力矩判断标志位
			Ca_GohomeTon.IN:=FALSE;
			Step_InitCaDT:=80;
		ELSIF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Error OR 
				 arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Error THEN
				 arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bHome:=FALSE;//负极搬运平移2
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bHome:=FALSE;//负极叠片搬运平移		
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.bHome:=FALSE;//负极纠偏X1	
				arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.bHome:=FALSE;//负极纠偏X2
				arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.bHome:=FALSE;//负极纠偏Y
				Ca_GohomeTon.IN:=FALSE;
				Ca_Gohoming:=FALSE;//负极取片回原点中	
				Step_InitCaDT:=9999;
		END_IF
	END_IF
80://
	//负极送片搬运平移2
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1]  THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.iGoSetPos:=1;
		END_IF
	END_IF		
	//负极纠偏X1初始位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1]   THEN
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=1;
		END_IF	
	END_IF	
	//负极纠偏X2初始位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1]   THEN
			arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=1;
		END_IF	
	END_IF	
	//负极纠偏Y初始位
	IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1]   THEN
			arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=1;
		END_IF	
	END_IF		
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving AND  
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND
		arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving  THEN	
		Step_InitCaDT:=90;
	ELSIF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Error OR
		arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Error THEN
		Ca_Gohoming:=FALSE;//负极取片回原点中	
		Step_InitCaDT:=9999;
	END_IF
		
90://叠片平移搬运轴回原点
		 IF NOT Ca_GohomeTon.Q THEN
			IF   arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1]  THEN
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bHome:=TRUE;//负极叠片搬运平移
					Ca_DTCarryingTorMark:=TRUE;//负极叠台搬运平移力矩判断标志位
			END_IF
			Ca_GohomeTon.IN:=TRUE;	
		 ELSE
			Ca_GohomeTon.IN:=FALSE;	
			Step_InitCaDT:=100;
		 END_IF
100://判断叠片平移回原点是否完成
		IF NOT Ca_GohomeTon.Q THEN
			Ca_GohomeTon.IN:=TRUE;
		ELSE	
			IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving THEN
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bHome:=FALSE;//负极叠片搬运平移
				Ca_DTCarryingTorMark:=FALSE;//负极叠台搬运平移力矩判断标志位
				Ca_GohomeTon.IN:=FALSE;
				Step_InitCaDT:=110;
			ELSIF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Error THEN
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bHome:=FALSE;//负极叠片搬运平移
				Ca_GohomeTon.IN:=FALSE;
				Ca_Gohoming:=FALSE;//负极取片回原点中	
				Step_InitCaDT:=9999;												
			END_IF
		END_IF
110://轴移动至初始位
	//负极叠台搬运平移
	IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1]   THEN
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.iGoSetPos:=0;
			Step_InitCaDT:=120;
		ELSIF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Error THEN
				Ca_Gohoming:=FALSE;//负极取片回原点中	
				Step_InitCaDT:=9999;
		ELSE
		   	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.iGoSetPos:=1;
		END_IF	
	END_IF	
120:
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1]	.Cmd.bOFF:=TRUE;//负极搬运1真空关
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum1]	.Cmd.bON:=FALSE;//负极搬运1真空关
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bOFF:=TRUE;//负极搬运2真空关
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark1]	.Cmd.bOFF:=TRUE;//负极搬运1破真空关
	arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuumBark2]	.Cmd.bOFF:=TRUE;//负极搬运2破真空关
	arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum]	.Cmd.bOFF:=TRUE;//负极纠偏平台真空关
	arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark]	.Cmd.bOFF:=TRUE;//负极纠偏平台破真空关
	arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum]	.Cmd.bOFF:=TRUE;//负极叠FALSE片真空关
	arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuumBark]	.Cmd.bOFF:=TRUE;//负极叠片搬运升降破真空关					
	//负极送片搬运升降2
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=0;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=4;
		END_IF	
	END_IF
	//负极叠片搬运升降
	IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4]  THEN
			arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;
		END_IF	
	END_IF		
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving  AND
		arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving THEN
		Ca_GohomeDone:=TRUE;//负极取片回原点完成
		Ca_Gohoming:=FALSE;//负极取片回原点中	
		Step_InitCaDT:=0;
	ELSIF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
		Ca_Gohoming:=FALSE;//负极取片回原点中	
		Step_InitCaDT:=9999;
	END_IF		
END_CASE
//负极皮带初始化
IF rCa_BeltGohome_TRIG.Q THEN
	Ca_BeltGohomeDone:=FALSE;
	Ca_BeltGohoming:=FALSE;
	Mach_Control.Ca_b.Ca_SegbeltFalg:=FALSE;
	Step_InitCaDT0:=0;
END_IF

//回原点超时报警	

	IF  Ca_BeltGohoming THEN
		IF NOT Ca_BeltGohomeOverTon.Q THEN
			    Ca_BeltGohomeOverTon.IN:=TRUE;
		ELSE
			IF Ca_BeltGohomeOverTon.Q THEN
			      Mach_Control.Ca_b.Error[20]:=TRUE;//负极皮带回原点超时报警	
			     Ca_BeltGohomeOverTon.IN:=FALSE;
			END_IF	 	 
		END_IF

	ELSE
		Ca_BeltGohomeOverTon.IN:=FALSE;
	END_IF



CASE Step_InitCaDT0 OF 
0://
	IF fCa_BeltGohome_TRIG.Q THEN
		Ca_StandbyStep2:=0;
		Ca_StandbyStep4:=0;
		//Par.stDT_date.Ca_betlCount.5 :=FALSE;
		//Par.stDT_date.Ca_betlCount.4 :=FALSE;
		//Par.stDT_date.Ca_betlCount.3 :=FALSE;
		//Par.stDT_date.Ca_betlCount.2 :=FALSE;
		//Par.stDT_date.Ca_betlCount.1 :=FALSE;
		//Par.stDT_date.Ca_betlCount.0:=FALSE;
		Ca_BeltGohoming:=TRUE;
		Step_InitCaDT0:=20;
	END_IF
20:
	Ca_BeltGohomeDone:=FALSE;
	Ca_BeltGohomeTon.IN:=FALSE;
	IF NOT Ca_BeltGohomeDone THEN
		Step_InitCaDT0:=30;
	END_IF
30:
	IF NOT Ca_BeltGohomeTon.Q THEN
		Ca_BeltGohomeTon.IN:=TRUE;
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.bHome:=TRUE;//
	ELSE
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving THEN
			Ca_BeltGohomeTon.IN:=FALSE;	
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.bHome:=FALSE;//
			Step_InitCaDT0:=40;
		ELSIF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Error THEN
			Ca_BeltGohomeTon.IN:=FALSE;	
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.bHome:=FALSE;//
			Ca_BeltGohoming:=FALSE;
			Step_InitCaDT0:=9999;											
		END_IF								
	END_IF
40://
		IF NOT Ca_BeltGohomeTon.Q THEN
			Ca_BeltGohomeTon.IN:=TRUE;
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.bHome:=TRUE;//
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.bHome:=TRUE;//
			Ca_Carrying1TorMark:=TRUE;//负极搬运1平移力矩判断标志位
		ELSE
			IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.NoMoving AND 
				 arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.NoMoving THEN
				Ca_BeltGohomeTon.IN:=FALSE;	
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.bHome:=FALSE;//
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.bHome:=FALSE;//
				Ca_Carrying1TorMark:=FALSE;//负极搬运1平移力矩判断标志位
				Step_InitCaDT0:=50;
			ELSIF arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Error THEN
				Ca_BeltGohomeTon.IN:=FALSE;	
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.bHome:=FALSE;//
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.bHome:=FALSE;//
				Ca_BeltGohoming:=FALSE;
				Step_InitCaDT0:=9999;
			END_IF								
		END_IF	
50:
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[1]   THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.iGoSetPos:=1;
		END_IF	
	END_IF		

	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1]   THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.iGoSetPos:=1;
		END_IF	
	END_IF		

	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.NoMoving THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1]   THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.iGoSetPos:=0;
		ELSE
		   arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.iGoSetPos:=1;
		END_IF	
	END_IF	

	IF 	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1] AND	arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[1]  AND 
		 arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Cmd.arrbRealPoint[1] THEN
		 Ca_BeltGohomeDone:=TRUE;
		 Ca_BeltGohoming:=FALSE;
		 Step_InitCaDT0:=0;
	ELSIF  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Error OR arrAxisCtrl[AxiseNo.AxisName.CaCarryingWhirling1].Status.Error THEN
		Ca_BeltGohoming:=FALSE;
		Step_InitCaDT0:=9999;
	END_IF
						
END_CASE

END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_OverNG" Id="{f84f98bb-a1b2-4ce1-97d6-8f0649da9df1}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[

(*******************************************************************************************************踢f负极对齐度NG片**************************************************************************************************************************)
 IF   Ca_OverNGStep=1630 THEN
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.fOverride:=50;
 ELSE
   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.fOverride:=100;
 END_IF


IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下
   CASE Ca_OverNGStep OF   
			1000://判断负极叠台搬运是否有片，有片的话放到纠偏台
						fAnScaling:=1;//20240508 CF
			            fCaScaling:=1;//20240508 CF		
						CaOverNGcount:=CaOverNGcount+1;
						IF arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch AND  Mach_Control.Ca_b.Ca_DPCarryingFalg  THEN//负极再取片位且叠台搬运有片,把当前片放到纠偏台
							Ca_OverNGStep:=1010;
						ELSE
							Ca_OverNGStep:=1050;	
						END_IF
	
			1010://纠偏台回初始位
				//纠偏平台X1移动至初始位
				IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					//纠偏平台X2移动至初始位
					IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					//纠偏平台X2移动至初始位
					IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
						DT_SingeMode();//单步选择	
						Ca_OverNGStep:=1020;
                        DT_TON[4].IN:=FALSE;	
					END_IF	
				END_IF
			1020://叠台搬运极片放回纠偏台
				IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1]  AND NOT Mach_Control.Ca_b.Ca_deviationFalg THEN 
						IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
							arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
					    ELSE
							arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=2;//负极d叠台搬运下降至取片位
					    END_IF
                   END_IF
				       IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
				           	/// 吸盘破真空    纠偏台开真空
							arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;	//负极叠台搬运升降真空	真空
							arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;	//负极叠台搬运升降真空破真空								
							arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;	//负极纠偏台真空			
							arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;	//负极纠偏台真空	   
							DT_SingeMode();//单步选择	
							Ca_OverNGStep:=1030;
							DT_TON[4].IN:=TRUE;
							Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位位纠偏平台有料标记
							Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;//负极搬运真空吸盘有料标记复位							
	                    END_IF
				END_IF
			1030://叠台搬运极片上升至凸轮耦合初始高度
				IF NOT DP_SinStepe AND DT_TON[4].Q THEN
					IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
						arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
						/// 吸盘破真空    纠偏台开真空
						Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位位纠偏平台有料标记
						Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;//负极搬运真空吸盘有料标记复位
						Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[9];
						DT_SingeMode();//单步选择	
						Ca_OverNGStep:=1050;
						DT_TON[4].IN:=FALSE;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极搬运升降2上升至凸轮耦合初始高度
					END_IF			
				END_IF		   
		
            1050://判断主轴是否停止、是否在初始位、是否有轴在耦合中
					IF NOT DP_SinStepe THEN
								IF arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling THEN
									DT_SingeMode();//单步选择
									Ca_OverNGStep:=1070;
								ELSE
									DP_Step1:=100;//调用主轴回初始位子程序
									DT_SingeMode();//单步选择
									Ca_OverNGStep:=1060;
								END_IF
			    	END_IF		
			1060://判断主轴的模长的当前位置是否为0
				IF NOT DP_SinStepe THEN
					IF DP_Step1=6666 AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling  THEN
						DT_SingeMode();//单步选择
						Ca_OverNGStep:=1070;
					END_IF	
				END_IF							

			1070://判断NG气缸是否在安全位
					IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
						arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
						arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
						arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState AND
                        arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]    THEN
						Ca_OverNGStep:=1100;		
					ELSE
						Ca_OverNGStep:=1080;	
					END_IF
			1080:
						arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Cmd.bOFF:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Cmd.bON:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Cmd.bON:=TRUE;
						arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;
						IF   arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND  arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
							arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
							arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState THEN
							Ca_OverNGStep:=1090;									
						END_IF
			1090:
					arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;
					IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND  arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] 
                        AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
						Ca_OverNGStep:=1100;	
					END_IF	

              1100:
						IF NOT DP_SinStepe AND TailCurlSEPTA_SafePos THEN		
									Scan_TON[2].IN:=TRUE;	
										IF CA_CarryingPos1  THEN//负极搬运、叠片各轴在初始位
											         Scan_TON[1].IN:=TRUE;	
													 DTPosError[12]:=FALSE;
													 IF AN_CarryingPos2  THEN//正极在叠片位	
														             DTPosError[11]:=FALSE;
																IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2]   THEN													
																	DT_SingeMode();//单步选择											
																	Ca_OverNGStep:=1200;//													
																ELSE
																	Mach_Control.DT_b.Error[5]:=TRUE;//叠负极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
																//	Ca_OverNGStep:=9991;	
																END_IF;
													ELSIF AN_CarryingPos1  THEN//在取片位	
                                                                  DTPosError[11]:=FALSE;																	
																IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1]  THEN
																	DT_SingeMode();//单步选择										
																	Ca_OverNGStep:=1300;//
																ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] THEN
																	DT_SingeMode();//单步选择										
																	Ca_OverNGStep:=1400;//
																ELSE
																	Mach_Control.DT_b.Error[5]:=TRUE;//叠负极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
																	//Ca_OverNGStep:=9992;	
																END_IF;							
													ELSIF Scan_TON[1].Q THEN
																Scan_TON[1].IN:=FALSE;	
																//Ca_OverNGStep:=9993;
															   DTPosError[11]:=TRUE;
													END_IF
							    	ELSE
											IF (Ca_Step0=0 OR Ca_Step0=6666) AND (Ca_Step3=0 OR Ca_Step3=6666) AND Scan_TON[2].Q THEN
												Scan_TON[2].IN:=FALSE;		
												//Ca_OverNGStep:=9994;
												DTPosError[12]:=TRUE;
											END_IF
								END_IF
					END_IF		

              1600:	 //负极叠片升降移动至放片高度 		  
	           			IF NOT DP_SinStepe THEN					
									 IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND 
										NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[2] AND
                                             arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]       THEN
											IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[3] THEN
												arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=3;//正极叠片升降移动至a放片高度
											END_IF
									END_IF   	
								IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[3] THEN
								    DT_SingeMode();//单步选择
									Ca_OverNGStep:=1610;
								END_IF		
                       END_IF	   
		1610://左压刀升降轴上升至抽刀高度
						     arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运升降真空关
	                    	arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运升降真空开
						IF NOT DP_SinStepe THEN								
								IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[15] THEN
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=15;//左压刀升降上升至抽刀高度
									END_IF
								END_IF				
								IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[15] THEN
							     	DT_SingeMode();//单步选择
									Ca_OverNGStep:=1620;
								END_IF
						END_IF	   
	
            1620://左压刀开合轴至张开位			   
					   IF NOT DP_SinStepe THEN
										IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.NoMoving THEN
												IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[2] THEN
													arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=2;//左压刀开合至张开位	
												END_IF		
										END_IF;	
											IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[2] THEN
													DT_SingeMode();//单步选择
													Ca_OverNGStep:=1630;											
											END_IF
							END_IF;
				   
	
         1630:	 //负极叠片升降移动至a等待高度 		  
	           			IF NOT DP_SinStepe THEN					
									 IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND 
										NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[2] AND
                                             arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]       THEN
											IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
												arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极叠片升降移动至等待高度
											END_IF
									END_IF   
                                (*
	                         	IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=1;//左压刀升降轴下降至初始高度
										END_IF
									END_IF			
	                            *)
								IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[15] AND 
                                   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
						         	DT_SingeMode();//单步选择
									Ca_OverNGStep:=1670;
								END_IF		
                       END_IF	   						
 (*
		1640://左左压刀升降轴上升至张开高度
						  
						IF NOT DP_SinStepe THEN								
								IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[14] THEN
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=14;//左压刀升降上升至张开高度
									END_IF
								END_IF				
								IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[14] THEN
							     	DT_SingeMode();//单步选择
									Ca_OverNGStep:=1641;
								END_IF
						END_IF	   					   
					   
		1641://	左压刀开合移至初始位		
			       IF NOT DP_SinStepe THEN
								IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=0;
											DT_SingeMode();//单步选择
											Ca_OverNGStep:=1650;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=1;//左压刀开合至初始位
										END_IF		
                                END_IF;	
					END_IF;
		   	1650://左压刀升降下降至初始位，压隔膜			
					  IF NOT DP_SinStepe THEN
	                         	IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=0;
									     	DT_SingeMode();//单步选择
									    	Ca_OverNGStep:=1670;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=1;//左压刀升降轴下降至初始高度
										END_IF
									END_IF							  
					  
					  END_IF				   
					   
		     //1660:	 //判断真空					   
			
*)
           1670://判断主轴是否停止、是否在初始位、是否有轴在耦合中
					IF NOT DP_SinStepe THEN
								IF arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling THEN
									DT_SingeMode();//单步选择
									Ca_OverNGStep:=1691;
								ELSE
									DP_Step1:=100;//调用主轴回初始位子程序
									DT_SingeMode();//单步选择
									Ca_OverNGStep:=1680;
								END_IF
			    	END_IF		
			1680://判断主轴的模长的当前位置是否为0
				IF NOT DP_SinStepe THEN
					IF DP_Step1=6666 AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling  THEN
						DT_SingeMode();//单步选择
						Ca_OverNGStep:=1691;
					END_IF	
				END_IF				
			1691:
			    IF (arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] OR arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[15] ) AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]  AND
					     arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState  and   arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND 
                         arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState THEN
					Ca_OverNGStep:=1695;
				END_IF
				
		    1695://				
					IF CA_CarryingPos2 THEN//负极在叠片位
							Ca_OverNGStep:=1700;//
					ELSIF CA_CarryingPos1  THEN//负极在取片位
							 Ca_OverNGStep:=1800;//
					ELSE
						  DTPosError[12]:=TRUE;//踢负极对齐度NG片 时，负极取片即不在取片位，也不在叠片位
					END_IF;
		
	

	        1800://	调用负极NG踢废	
                     DT_TON[1].IN:=FALSE;	
					CCD.Over.Start.iPhotoDo:=2;
					CCD.Over.Finish.OverhandResult:=0;
					Mach_Control.DT_b.OverhandResult:=0;
					Mach_Control.DT_b.CDD_OverStart:=TRUE;		
			
			       Mach_Control.Ca_b.Ca_Quantited:=Mach_Control.Ca_b.Ca_Quantited-1;//负极已叠片数减一
                    Ca_Step2:=10; 
                    Ca_OverNGStep:=1810;

			1810://判断正极叠台搬运是否有片，有片的话放到纠偏台
			        DT_TON[1].IN:=TRUE;	
						IF arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Io.DIOnSwitch AND  Mach_Control.An_b.An_DPCarryingFalg  THEN//正极再取片位且叠台搬运有片,把当前片放到纠偏台
							Ca_OverNGStep:=1820;
						ELSE
							Ca_OverNGStep:=1850;	
						END_IF
	
			1820://纠偏台回初始位
				//纠偏平台X1移动至初始位
				IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					//纠偏平台X2移动至初始位
					IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					//纠偏平台X2移动至初始位
					IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Status.Error THEN
						IF arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.iGoSetPos:=1;
						END_IF					
					END_IF
					IF arrAxisCtrl[AxiseNo.AxisName.AndeviationX1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationX2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.AndeviationY].Cmd.arrbRealPoint[1] THEN
						DT_SingeMode();//单步选择	
						Ca_OverNGStep:=1830;	
						DT_TON[3].IN:=FALSE;	
					END_IF	
				END_IF
			1830://叠台搬运极片放回纠偏台
				IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingLine].Cmd.arrbRealPoint[1]  AND NOT Mach_Control.An_b.An_deviationFalg THEN 
						IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
							arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
					    ELSE
							arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=2;//正极叠台搬运下降至取片位
					    END_IF
                   END_IF
				       IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[2]  THEN
				           	/// 吸盘破真空    纠偏台开真
							arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=FALSE;//正极叠片搬运升降真空关
							 arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=TRUE;//正极叠片搬运升降真空关						
							arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=TRUE;	//正极纠偏台真空			
							arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=FALSE;	//正极纠偏台真空	   
							DT_SingeMode();//单步选择	
							Ca_OverNGStep:=1840;
							DT_TON[3].IN:=TRUE;
							Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台有料标记
							Mach_Control.An_b.An_DPCarryingFalg:=FALSE;//正极搬运真空吸盘有料标记复位							
	                    END_IF
				END_IF
			1840://叠台搬运极片上升至凸轮耦合初始高度
				IF NOT DP_SinStepe THEN
					IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4]  AND DT_TON[3].Q THEN
						arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=0;
						/// 吸盘破真空    纠偏台开真空
						Mach_Control.An_b.An_deviationFalg:=TRUE;//置位纠偏平台有料标记
						Mach_Control.An_b.An_DPCarryingFalg:=FALSE;//正极搬运真空吸盘有料标记复位
						Par.stDT_date.An_MQ_Slice[1]:=Par.stDT_date.An_MQ_Slice[2];
						DT_SingeMode();//单步选择	
						Ca_OverNGStep:=1850;
						DT_TON[3].IN:=FALSE;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.iGoSetPos:=4;//正极搬运升降2上升至凸轮耦合初始高度
					END_IF			
	             END_IF
	        1860://等待负极NG踢废完成		
					IF Mach_Control.DT_b.OverhandResult<>3 AND  DT_TON[1].Q THEN
						Mach_Control.Ca_b.Error[22]:=TRUE;//负极叠台搬运升降真空报警，电芯上有片，请拿掉	
					 END_IF
					
			
					 IF 	Ca_Step2=6666  THEN
						    Ca_OverNGStep:=0;
							DP_Step0:=0;	
						//	Ca_OverNGMark:=FALSE;
					 END_IF
	  END_CASE
END_IF

 CASE Ca_OverNGStep OF  

	        1850://	
                     // DT_TON[1].IN:=TRUE;	
					  IF Mach_Control.DT_b.OverhandResult<>3 AND  DT_TON[1].Q THEN
						Mach_Control.Ca_b.Error[22]:=TRUE;//负极叠台搬运升降真空报警，电芯上有片，请拿掉	
					   END_IF
			
					 IF 	 Mach_Control.DT_b.OverhandResult=3  THEN
						    DT_TON[1].IN:=FALSE;
						    Ca_OverNGStep:=1860;
		
					 END_IF	
 
 
             1200: //负到正取负极NG对其度片,负极搬运与叠片各轴在初始位,正极在叠片位
	                 VirMain_TON.IN:=FALSE;
					//负到正_负极搬运平移2轴凸轮耦合
						fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=1;
						fbCaCamInCarryingLine2.bCamInExecute:=TRUE;							
                      	fbCaCamInCarryingUpDown2.iTableSel:=3; //20240528SJ
                        fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;
						
					//负到正_负极叠片平移轴凸轮耦合
						fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
						fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;							
                     	fbCaCamInDTCarryingUpDown.iTableSel:=3;  //20240528SJ
						fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
						
					//负到正_缓存轴凸轮耦合
						fbCamInGMBuffer2.iTableSel:=2;
						fbCamInGMBuffer2.bCamInExecute:=TRUE;					
					//负到正_隔膜平移轴凸轮耦合
						fbCamInGMDanserMove.iTableSel:=2;
						fbCamInGMDanserMove.bCamInExecute:=TRUE;

						
					
					//负到正_放卷虚轴凸轮耦合		
						fbCamInVirGMDriver2.iTableSel:=2;
						fbCamInVirGMDriver2.bCamInExecute:=TRUE;		
					//负到正_正极搬运平移轴凸轮耦合	
						fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=-1;
						fbAnCamInCarryingLine.bCamInExecute:=TRUE;															
	                 	fbAnCamInCarryingUpDown.iTableSel:=3;      //20240528SJ
                        fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;
					//负到正_正极叠片平移轴凸轮耦合
						fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
						fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;		
                        fbAnCamInDTCarryingUpDown.iTableSel:=3;   //  //20240528SJ
                        fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;
					//负到正_正极搬运旋转轴凸轮耦合
						fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=-1;
						fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;
					
					//判断凸轮是否耦合完成
						IF  fbCaCamInCarryingLine2.bInSync  AND  fbCaCamInDTCarryingLine.bInSync AND 
							 fbCamInGMBuffer2.bInSync AND fbCamInGMDanserMove.bInSync AND
							 fbCamInVirGMDriver2.bInSync AND fbAnCamInCarryingLine.bInSync AND 
							fbAnCamInDTCarryingLine.bInSync AND fbAnCamInCarryingWhirling.bInSync  AND
							 fbAnCamInCarryingUpDown.bInSync AND fbAnCamInDTCarryingUpDown.bInSync AND fbCaCamInCarryingUpDown2.bInSync AND fbCaCamInDTCarryingUpDown.bInSync AND  
						    Mach_Control.U.DT_iMode=1  THEN
							Ca_OverNGStep:=1210;//
						ELSIF fbCaCamInCarryingLine2.bError OR  fbCaCamInDTCarryingLine.bError OR 
									fbCamInGMBuffer2.bError OR fbCamInGMDanserMove.bError OR fbCamInVirGMDriver2.bError OR fbAnCamInCarryingLine.bError OR 
									 fbAnCamInCarryingUpDown.bError OR fbAnCamInDTCarryingUpDown.bError OR fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingUpDown.bError OR  
									fbAnCamInDTCarryingLine.bError OR fbAnCamInCarryingWhirling.bError  THEN
		
						Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
						Ca_OverNGStep:=9995;										
						END_IF		
				1210://主轴启动
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;
									arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;			
						
									IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
										VirMain_TON.IN:=FALSE;
										arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
										Ca_OverNGStep:=1500;	
									ELSE
										IF NOT VirMain_TON.Q THEN
											VirMain_TON.IN:=TRUE;
										ELSE
											VirMain_TON.IN:=FALSE;
											Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
											Ca_OverNGStep:=10005;	
									END_IF	
				 	    END_IF		

           1300: //负到正取负极NG对其度片,负极搬运与叠片各轴在初始位,, 正极在取片位,  隔膜平移在正极位
		                VirMain_TON.IN:=FALSE;
						//负到正_负极搬运平移2轴凸轮耦合
						fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=1;
						fbCaCamInCarryingLine2.bCamInExecute:=TRUE;							
						fbCaCamInCarryingUpDown2.iTableSel:=3; //20240528SJ
						fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;
					//负到正_负极叠片平移轴凸轮耦合
						fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
						fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;							
						fbCaCamInDTCarryingUpDown.iTableSel:=3;  //20240528SJ
						fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
					//判断凸轮是否耦合完成
						IF  fbCaCamInCarryingLine2.bInSync AND fbCaCamInDTCarryingLine.bInSync AND 
                           fbCaCamInCarryingUpDown2.bInSync AND fbCaCamInDTCarryingUpDown.bInSync AND 
                           Mach_Control.U.DT_iMode=1 THEN
							Ca_OverNGStep:=1310;//
						ELSIF fbCaCamInCarryingLine2.bError OR  fbCaCamInDTCarryingLine.bError   OR 
                            fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingUpDown.bError  THEN
						Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
						Ca_OverNGStep:=9996;										
						END_IF			   
		   
			1310://主轴启动
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;
									arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;			
						
									IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
										VirMain_TON.IN:=FALSE;
										arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
										Ca_OverNGStep:=1500;	
									ELSE
										IF NOT VirMain_TON.Q THEN
											VirMain_TON.IN:=TRUE;
										ELSE
											VirMain_TON.IN:=FALSE;
											Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
											Ca_OverNGStep:=10006;	
									END_IF	
				 	    END_IF							
						
						
						
	        1400: //负到正取负极NG对其度片,负极搬运与叠片各轴在初始位,, 正极在取片位,  隔膜平移在负极位	
			         VirMain_TON.IN:=FALSE;
					//负到正_负极搬运平移2轴凸轮耦合
						fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=1;
						fbCaCamInCarryingLine2.bCamInExecute:=TRUE;							
						fbCaCamInCarryingUpDown2.iTableSel:=3; //20240528SJ
					   fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;
					//负到正_负极叠片平移轴凸轮耦合
						fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
						fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;							
						fbCaCamInDTCarryingUpDown.iTableSel:=3;  //20240528SJ
						fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
					//负到正_缓存轴凸轮耦合
						fbCamInGMBuffer2.iTableSel:=2;
						fbCamInGMBuffer2.bCamInExecute:=TRUE;					
					//负到正_隔膜平移轴凸轮耦合
						fbCamInGMDanserMove.iTableSel:=2;
						fbCamInGMDanserMove.bCamInExecute:=TRUE;

					//负到正_放卷虚轴凸轮耦合		
						fbCamInVirGMDriver2.iTableSel:=2;
						fbCamInVirGMDriver2.bCamInExecute:=TRUE;			   
	
					//判断凸轮是否耦合完成
						IF  fbCaCamInCarryingLine2.bInSync AND fbCaCamInDTCarryingLine.bInSync AND 
							 fbCamInGMBuffer2.bInSync AND fbCamInGMDanserMove.bInSync AND
							 fbCaCamInCarryingUpDown2.bInSync AND fbCaCamInDTCarryingUpDown.bInSync  AND 
							 fbCamInVirGMDriver2.bInSync  AND
                             Mach_Control.U.DT_iMode=1 THEN
							Ca_OverNGStep:=1410;//
						ELSIF fbCaCamInCarryingLine2.bError OR  fbCaCamInDTCarryingLine.bError OR
								 fbCamInGMBuffer2.bError OR fbCamInGMDanserMove.bError OR 
								  fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingUpDown.bError OR
								 fbCamInVirGMDriver2.bError   THEN
		
						Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
						Ca_OverNGStep:=9997;										
						END_IF		
	
			1410://主轴启动
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;
									arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;					
									IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
										VirMain_TON.IN:=FALSE;
										arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
										Ca_OverNGStep:=1500;	
									ELSE
										IF NOT VirMain_TON.Q THEN
											VirMain_TON.IN:=TRUE;
										ELSE
											VirMain_TON.IN:=FALSE;
											Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
											Ca_OverNGStep:=10007;	
									END_IF	
				 	    END_IF							
   
			1500://
				(*IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>230 AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<240 AND Mach_Control.An_b.An_DPCarryingFalg THEN//复检
					IF Mach_Control.DT_b.DT_CCD_TwoModel THEN												
						CCD.AnRec.Finish.RectifyResult:=0;
						CCD.AnRec.Finish.RectifyX1:=0;
						CCD.AnRec.Finish.RectifyX2:=0;
						CCD.AnRec.Finish.RectifyY:=0;												
						Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
						CCD.AnRec.Start.iPhotoDo:=2;//第二次拍照	
					END_IF		
				END_IF*)		
			
				IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
					DP_Step1:=100;//解除耦合，主轴回零子程序			
					Ca_OverNGStep:=1510;	
				END_IF	
			1510://			
				IF NOT DP_SinStepe THEN
					IF DP_Step1=6666 AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling  THEN
						DT_SingeMode();//单步选择
						Ca_OverNGStep:=1600;
					END_IF	
				END_IF	

		    1700://	/踢负极NG对齐度片回负极取片位,(正极轴不动 ) ,负极搬运叠片各轴在叠片位		
			      VirMain_TON.IN:=FALSE;
				//负极送片搬运平移
				fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=-1;
				fbCaCamInCarryingLine2.bCamInExecute:=TRUE;							
				fbCaCamInCarryingUpDown2.iTableSel:=3; //20240528SJ
			    fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;
				//负极叠台搬运平移
				fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
				fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;			
                fbCaCamInDTCarryingUpDown.iTableSel:=3;  //20240528SJ
                fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
				
				IF fbCaCamInCarryingLine2.bInSync  AND 
					fbCaCamInDTCarryingLine.bInSync   AND
					fbCaCamInCarryingUpDown2.bInSync AND  fbCaCamInDTCarryingUpDown.bInSync  AND 
                      Mach_Control.U.DT_iMode=1 THEN   
					DT_SingeMode();//单步选择		
					Ca_OverNGStep:=1710;
				ELSIF fbCaCamInCarryingLine2.bError OR //  fbCaCamInCarryingUpDown2.bError or
					      fbCaCamInDTCarryingLine.bError OR  fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingUpDown.bError   THEN   
				          Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
					      Ca_OverNGStep:=9998;
				END_IF		

			1710://主轴启动
				    		
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;
									arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
									arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;			
						IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN
							VirMain_TON.IN:=FALSE;
							arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
							Ca_OverNGStep:=1720;	
						ELSE
								IF NOT VirMain_TON.Q THEN
									VirMain_TON.IN:=TRUE;
								ELSE
									VirMain_TON.IN:=FALSE;
									Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
									Ca_OverNGStep:=10008;	
							END_IF	
					   END_IF				

			1720://
				IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
					DP_Step1:=100;//解除耦合，主轴回零子程序			
					Ca_OverNGStep:=1730;	
				END_IF	
	
				
			1730://			
				IF NOT DP_SinStepe THEN
					IF DP_Step1=6666 AND arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=0 AND NOT DT_AxiseCoupling  THEN
						DT_SingeMode();//单步选择
						Ca_OverNGStep:=1800;
					END_IF	
				END_IF	
									
 END_CASE


		


]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_Rectifydev" Id="{9ee424f1-2624-4b52-8443-1d0421d47c66}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[CCD_Ton(IN:= , PT:=T#2S , Q=> , ET=> );//CCD拍照超时报警
IF (NOT  Mach_Control.Ca_b.Ca_deviationFalg AND Mach_Control.U.DT_iMode=1) AND NOT Mach_Control.Ca_b.Demarcateing THEN
//IF NOT  Mach_Control.Ca_b.Ca_deviationFalg THEN
	Mach_Control.Ca_b.RectifydevDone:=FALSE;
	CCD.CaRec.Finish.RectifyX1:=0;
	CCD.CaRec.Finish.RectifyX2:=0;
	CCD.CaRec.Finish.RectifyY:=0;
	Ca_CCD_Done:=FALSE;
END_IF
CCD_Ton1(IN:=Mach_Control.Ca_b.Ca_CCDStart , PT:=T#0.1S , Q=> , ET=> );//CCD拍照超时报警
IF  CCD_Ton1.Q THEN
	Mach_Control.Ca_b.Ca_CCDStart:=FALSE;
END_IF


IF rCaUse[2].Q THEN
    CCD.CaRec.Finish.RectifyResult:=0;
    CCD.CaRec.Finish.RectifyX1:=0;
    CCD.CaRec.Finish.RectifyX2:=0;
	CCD.CaRec.Finish.RectifyY:=0;												
	//CCD.CaRec.Start.iPhotoDo:= SEL(Mach_Control.DT_b.DT_CCD_CaOrder,1,2);               //第二次拍照
	//CCD.CaRec.Start.stPoleNo:=Par.stDT_date.Ca_MQ_Slice[8].stPoleNo;
END_IF

Ca_CQ_ton(IN:=arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Io.DOStatus1 , PT:=T#0.3S , Q=> , ET=>);
IF  Ca_CQ_ton.Q THEN
	Mach_Control.Ca_b.Ca_Rectifydev_CQ:=FALSE;
	arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Cmd.bON:=FALSE;//负极纠偏平台除尘
	arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Cmd.bOFF:=TRUE;//负极纠偏平台除尘
END_IF


IF Mach_Control.U.DT_iMode=1 OR avg THEN//在自动状态下
	//判断负极是否允许取纠偏
	IF (Mach_Control.Ca_b.Ca_deviationFalg AND (Ca_CCD_Done OR Mach_Control.Ca_b.RectifydevDone)) (*AND CCD.CaRec.Finish.RectifyResult=1 AND Mach_Control.Ca_b.RectifydevDone)*) OR
		 (Mach_Control.Ca_b.Ca_deviationFalg AND CCD.CaRec.Finish.RectifyResult<>1 AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1]) OR 
		(Mach_Control.U.CCD_ChosesHMI  OR Mach_Control.U.EmptyRunMode) THEN
		Mach_Control.Ca_b.Ca_deviationDPOK:=TRUE;//取负极纠偏平台极片允许
	ELSE
		Mach_Control.Ca_b.Ca_deviationDPOK:=FALSE;
	END_IF 
	//纠偏平台自动程序
	CASE 	Ca_RectifydevStep   OF
	0://判断负纠偏平台是否有极片
		IF Mach_Control.Ca_b.Ca_deviationFalg AND NOT Mach_Control.U.EmptyRunMode (*AND NOT Blueflaging*)  THEN//负极纠偏平台有极片
			IF NOT Ca_CCD_Done THEN
				CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零
				CCD.CaRec.Finish.RectifyX1:=0;
				CCD.CaRec.Finish.RectifyX2:=0;
				CCD.CaRec.Finish.RectifyY:=0;
				iMD10:=1;
				Ca_RectifydevStep:=10;
			END_IF
		ELSE
			iMD10:=2;
			Ca_RecdevPla_Step0:=0;//纠偏平台没有极片标记时，复位纠偏步
			Mach_Control.Ca_b.RectifydevStart:=FALSE;
			Ca_RectifydevStep:=10;
		END_IF
	10://纠偏平台移动至初始位
	IF  NOT Mach_Control.U.EmptyRunMode THEN
		Mach_Control.Ca_b.RectifydevStart :=FALSE;//复位纠偏平台启动
		Mach_Control.Ca_b.RectifydevDone:=FALSE; //复位负极纠偏完成
		IF Mach_Control.Ca_b.CarryingSafepos[5] THEN
			//纠偏平台X1移动至初始位
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] THEN
					arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=0;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.iGoSetPos:=1;
				END_IF					
			END_IF
			//纠偏平台X2移动至初始位
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND NOT  arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1] THEN
					arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=0;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.iGoSetPos:=1;
				END_IF					
			END_IF
			//纠偏平台Y移动至初始位
			IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
					arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=0;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.iGoSetPos:=1;
				END_IF					
			END_IF	
			IF 	 arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] AND 	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1]  AND 	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
				 IF  iMD10=1 THEN
					Ca_RectifydevStep:=101;
					CCD_Ton.IN:=FALSE;
				  ELSIF  iMD10=2 THEN
					Ca_RectifydevStep:=0;
				 END_IF  
			END_IF	
		END_IF
	END_IF
	101:			
		CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零					
		Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
		CCD.CaRec.Start.iPhotoDo:=1;//启动CCD第一次拍照
		CCD.CaRec.Start.stPoleNo:=Par.stDT_date.Ca_MQ_Slice[8].stPoleNo;
		Ca_RectifydevStep:=110;						
	110:
		IF NOT CCD_Ton.Q THEN
			CCD_Ton.IN:=TRUE;
			IF Mach_Control.Ca_b.Ca_deviationCCDDone OR Mach_Control.U.CCD_ChosesHMI THEN
				CCD_Ton.IN:=FALSE;
				Ca_CCD_Done:=TRUE;
				Ca_RectifydevStep:=111;
			END_IF
		ELSE
			CCD_Ton.IN:=FALSE;
			Ca_CCD_Done:=TRUE;
			Mach_Control.Ca_b.Error[9]:=TRUE;//CCD第一次拍照超时报警
			Mach_Control.Ca_b.Ca_CCDStart :=FALSE;//启动CCD拍照
			CCD.CaRec.Finish.RectifyResult:=2;//拍照结果清零
			Ca_RectifydevStep:=9999;
		(*
			CCD_Ton.IN:=FALSE;
			Mach_Control.Ca_b.Error[9]:=TRUE;//CCD第一次拍照超时报警
			Mach_Control.Ca_b.Ca_CCDStart :=FALSE;//启动CCD拍照
			CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零
			//CCD.CaRec.Start.iPhotoDo:=0;//启动CCD第一次拍照
			Ca_RectifydevStep:=9999;
			*)
		END_IF
	111://启动拍照，等待CCD拍照结果						
		Mach_Control.Ca_b.Ca_CCDStart :=FALSE;//启动CCD拍照
		CCD_Ton.IN:=FALSE;
		Ca_RectifydevStep:=0;
				
	END_CASE

ELSE
	//在手动状态下，负极纠偏平台CCD标定程序
	IF Mach_Control.Ca_b.DemarcateStart THEN
		CCD.CaRec.Start.iPhotoDo:=1;//启动CCD第一次拍照
	END_IF
	Ca_Demarcate(
		Step0:=Ca_Demarcate_Step0,//程序步
		AxisX1_NO:=AxiseNo.AxisName.CadeviationX1 , //纠偏平台X1轴号
		AxisX2_NO:=AxiseNo.AxisName.CadeviationX2 , //纠偏平台X2轴号
		AxisY_NO:=AxiseNo.AxisName.CadeviationY , //纠偏平台Y轴号
		DemarcateStart:=Mach_Control.Ca_b.DemarcateStart , //纠偏平台标定启动
		CCDStart:=Mach_Control.Ca_b.Ca_CCDStart , //CCD拍照启动
		CCDNo:=CCD.CaRec.iDemCount,//CCD拍照次数记数
		DemarcateResult:=CCD.CaRec.iDemarcatResult,
		DemarcateDone:=Mach_Control.Ca_b.DemarcateDone , //CCD标定完成
		Demarcateing:=Mach_Control.Ca_b.Demarcateing,//CCD标定中
		Error :=Mach_Control.Ca_b.Error[10] );//CCD标定NG报警
	END_IF

		x1:=(103.94*COS(DEG_TO_RAD(q1+225))-103.94*COS(DEG_TO_RAD(225))); 
		x2:=(103.94*COS(DEG_TO_RAD(q1+135))-103.94*COS(DEG_TO_RAD(135)));
		y:=(103.94*SIN(DEG_TO_RAD(q1+315))-103.94*SIN(DEG_TO_RAD(315)));	

//启动纠偏
rCa_RecdevPlaR_TRIG(CLK:= Mach_Control.Ca_b.Ca_deviationFalg AND (CCD.CaRec.Finish.RectifyResult=1 OR CCD.CaRec.Finish.RectifyResult=2) AND NOT Mach_Control.U.CCD_ChosesHMI AND NOT Mach_Control.Ca_b.RectifydevDone AND 
										(CCD.CaRec.Finish.RectifyX1<>0 OR  CCD.CaRec.Finish.RectifyX2<>0 OR CCD.CaRec.Finish.RectifyY<>0) AND CCD.CaRec.Start.iPhotoDo=1  , Q=> );//AND NOT Mach_Control.Ca_b.Ca_VacuumErrorNG

IF rCa_RecdevPlaR_TRIG.Q  THEN//AND NOT Blueflaging
		Mach_Control.Ca_b.RectifydevStart:=TRUE;
END_IF

//纠偏结果限定
IF (CCD.CaRec.Finish.RectifyX1>=15 OR CCD.CaRec.Finish.RectifyX2>=15 OR CCD.CaRec.Finish.RectifyY>=10	OR
	CCD.CaRec.Finish.RectifyX1<=-15 OR CCD.CaRec.Finish.RectifyX2<=-15 OR CCD.CaRec.Finish.RectifyY<=-10	)	AND	NOT	Mach_Control.Ca_b.Demarcateing THEN
	CCD.CaRec.Finish.RectifyX1:=0;
	CCD.CaRec.Finish.RectifyX2:=0;
	CCD.CaRec.Finish.RectifyY:=0;	
END_IF



//纠偏自动程序
Ca_RecdevPla(
	Step0:=Ca_RecdevPla_Step0,//程序步
	RecdevStart:=Mach_Control.Ca_b.RectifydevStart , //负极纠偏启动
	RecdevDone:=Mach_Control.Ca_b.RectifydevDone , //负极纠偏完成
	RecdevAgree:=Mach_Control.Ca_b.CarryingSafepos[5],//纠偏平台纠偏允许
	AxisX1_NO:=AxiseNo.AxisName.CadeviationX1 , //纠偏平台X1轴号
	AxisX2_NO:= AxiseNo.AxisName.CadeviationX2 , //纠偏平台X2轴号
	AxisY_NO:= AxiseNo.AxisName.CadeviationY , //纠偏平台Y轴号
	CCD_X1:=CCD.CaRec.Finish.RectifyX1 , //纠偏平台X1的纠偏量   +fCaOffsetMean_X
	CCD_X2:=CCD.CaRec.Finish.RectifyX2, //纠偏平台X2的纠偏量    +fCaOffsetMean_X
	CCD_Y:=CCD.CaRec.Finish.RectifyY );//纠偏平台Y的纠偏量   +fCaOffsetMean_Y

//纠偏平台重复精度测试
Ca_RectifyTry_fb(
	Execute:= Mach_Control.Ca_b.RectifyTryStart AND Mach_Control.U.DT_iMode=3 ,//纠偏平台重复精度测试启动 
	AxisNO_X:=AxiseNo.AxisName.CadeviationX1 , 
	AxisNO_Y:= AxiseNo.AxisName.CadeviationX2, 
	AxisNO_R:=AxiseNo.AxisName.CadeviationY, 
	Demarcate_X:=Par.stDT_date.Ca_Demarcate_X , //纠偏平台重复精度测试X纠偏量
	Demarcate_Y:=Par.stDT_date.Ca_Demarcate_Y , //纠偏平台重复精度测试Y纠偏量
	Demarcate_R:=Par.stDT_date.Ca_Demarcate_R , //纠偏平台重复精度测试R纠偏量
	CCDNo:=Par.stDT_date.Ca_CCDNo, //纠偏平台重复精度测试次数
	CCDStart:= Mach_Control.Ca_b.Ca_CCDStart );

//吸盘重复精度测试		
Ca_SuckerTest_fb(
	Execute:=Mach_Control.Ca_b.SuckerTestStart AND Mach_Control.U.DT_iMode=3 , //吸盘重复精度测试启动 , 
	AxisNO_1:= AxiseNo.AxisName.CaDTCarryingUpDown, 
	AxisNO_2:= AxiseNo.AxisName.CaDTCarryingLine , 
	AxisNO_X:= AxiseNo.AxisName.CadeviationX1 , 
	AxisNO_Y:= AxiseNo.AxisName.CadeviationX2, 
	AxisNO_R:=AxiseNo.AxisName.CadeviationY, 
	DTCarryingVacuum:=arrCyNo.ElectValveName.CaDTCarryingVacuum, 
	deviationVacuum:= arrCyNo.ElectValveName.CadeviationVacuum, 
	deviationVacuumBark:= arrCyNo.ElectValveName.CadeviationVacuumBark, 
	CCDCount:= Par.stDT_date .Ca_CCDCount, //吸盘重复精度测试次数
	CCDStart:= Mach_Control.Ca_b.Ca_CCDStart,
    CCD_X1:=CCD.CaRec.Finish.RectifyX1 ,//正极纠偏平台X1纠偏量
	CCD_X2:=CCD.CaRec.Finish.RectifyX2 , //正极纠偏平台X2纠偏量
	CCD_Y:=CCD.CaRec.Finish.RectifyY,//正极纠偏平台Y纠偏量
    DTiMode:= Mach_Control.U.DT_iMode  );

	
	//负极通讯监控
rtCa_CCDTest1(CLK:=Mach_Control.Ca_b.bCaCCD_TestDo , Q=> );
IF rtCa_CCDTest1.Q THEN
	bCa_CCDTest1:=FALSE;
	bCa_CCDTest2:=FALSE;
END_IF
IF Mach_Control.Ca_b.bCaCCD_TestDo THEN
	rtCa_CCDTest2(CLK:=Mach_Control.Ca_b.Ca_CCDStart , Q=> );
	rtCa_CCDTest3(CLK:=CCD.CaRec.Finish.RectifyResult<>0 , Q=> );
	rtCa_CCDTest4(CLK:=Mach_Control.Ca_b.Ca_deviationCCDDone , Q=> );
	IF rtCa_CCDTest2.Q THEN
		bCa_CCDTest1:=TRUE;
		bCa_CCDTest2:=TRUE;
		CCD.CaRec.Finish.RectifyResult:=0;
	END_IF
	IF rtCa_CCDTest3.Q THEN
		bCa_CCDTest1:=FALSE;
	END_IF	
	IF rtCa_CCDTest4.Q THEN
		bCa_CCDTest2:=FALSE;
	END_IF
	tonCa_CCDTest1(IN:=bCa_CCDTest1 , PT:=T#999MS , Q=> , ET=> );
	tonCa_CCDTest2(IN:=bCa_CCDTest2 , PT:=T#999MS , Q=> , ET=> );
	IF bCa_CCDTest1 THEN
		Mach_Control.Ca_b.iCaCCD_RectifyCT:= TIME_TO_INT(tonCa_CCDTest1.ET);
	END_IF
	IF bCa_CCDTest2 THEN
		Mach_Control.Ca_b.iCaCCD_PhotoCT:= TIME_TO_INT(tonCa_CCDTest2.ET);
	END_IF
	IF tonCa_CCDTest1.Q THEN
		Mach_Control.Ca_b.bCaCCD_TestDo:=FALSE;
	END_IF
END_IF

//负极白班NG计数
IF HMI_Hour>=8 AND HMI_Hour<20 AND  Ca_Step2>30 AND Ca_Step2<=70 THEN
  IF CCD.CaRec.Finish.NG_Code = 1 THEN
   CCD.CaRec.DayNgclassification.X1_NG :=CCD.CaRec.DayNgclassification.X1_NG+1 ;
   CCD.CaRec.Finish.NG_Code := 0 ;
  ELSIF CCD.CaRec.Finish.NG_Code = 2 THEN
   CCD.CaRec.DayNgclassification.X2_NG := CCD.CaRec.DayNgclassification.X2_NG+1 ;  
   CCD.CaRec.Finish.NG_Code := 0 ;
  ELSIF CCD.CaRec.Finish.NG_Code = 3 THEN
   CCD.CaRec.DayNgclassification.Y_NG := CCD.CaRec.DayNgclassification.Y_NG+1 ;  
   CCD.CaRec.Finish.NG_Code := 0 ;
  ELSIF CCD.AnRec.Finish.NG_Code = 4 THEN
   CCD.CaRec.DayNgclassification.R_NG := CCD.CaRec.DayNgclassification.R_NG+1 ;   
   CCD.CaRec.Finish.NG_Code := 0 ; 
  ELSIF CCD.CaRec.Finish.NG_Code = 5 THEN 
   CCD.CaRec.DayNgclassification.other_NG :=  CCD.CaRec.DayNgclassification.other_NG+1;
   CCD.CaRec.Finish.NG_Code := 0 ;
  END_IF	
END_IF  

//负极白班NG清零
IF DayClear1.Q  THEN
	Par.stDT_date.Ca_Rectifydev_DayNG:=0;
END_IF

IF CCD.CaRec.DayNgclassification.NgClear[1] OR DayClear1.Q  THEN
   CCD.CaRec.DayNgclassification.X1_NG :=0 ;
END_IF

IF CCD.CaRec.DayNgclassification.NgClear[2] OR DayClear1.Q  THEN
   CCD.CaRec.DayNgclassification.X2_NG :=0 ;
END_IF

IF CCD.CaRec.DayNgclassification.NgClear[3] OR DayClear1.Q  THEN
   CCD.CaRec.DayNgclassification.Y_NG :=0 ;
END_IF

IF CCD.CaRec.DayNgclassification.NgClear[4] OR DayClear1.Q  THEN
   CCD.CaRec.DayNgclassification.R_NG :=0 ;
END_IF	

IF CCD.CaRec.DayNgclassification.NgClear[5] OR DayClear1.Q  THEN
   CCD.CaRec.DayNgclassification.other_NG :=0 ;
END_IF	

//负极晚班NG计数
IF ((HMI_Hour>=0 AND HMI_Hour<8) OR  (HMI_Hour>=20 AND HMI_Hour<=23)) AND Ca_Step2>=30 AND Ca_Step2<=70  THEN
  IF CCD.CaRec.Finish.NG_Code = 1 THEN
   CCD.CaRec.NightNgclassification.X1_NG :=CCD.CaRec.NightNgclassification.X1_NG+1 ;
   CCD.CaRec.Finish.NG_Code := 0 ;
  ELSIF CCD.CaRec.Finish.NG_Code = 2 THEN
   CCD.CaRec.NightNgclassification.X2_NG := CCD.CaRec.NightNgclassification.X2_NG+1 ;  
   CCD.CaRec.Finish.NG_Code := 0 ;
  ELSIF CCD.CaRec.Finish.NG_Code = 3 THEN
   CCD.CaRec.NightNgclassification.Y_NG := CCD.CaRec.NightNgclassification.Y_NG+1 ;  
   CCD.CaRec.Finish.NG_Code := 0 ;
  ELSIF CCD.CaRec.Finish.NG_Code = 4 THEN
   CCD.CaRec.NightNgclassification.R_NG := CCD.CaRec.NightNgclassification.R_NG+1 ;   
   CCD.CaRec.Finish.NG_Code := 0 ; 
  ELSIF CCD.CaRec.Finish.NG_Code = 5 THEN 
   CCD.CaRec.NightNgclassification.other_NG :=  CCD.CaRec.NightNgclassification.other_NG+1;
   CCD.CaRec.Finish.NG_Code := 0 ;
  END_IF	
END_IF  

//负极晚班NG清零
IF NightClear1.Q  THEN
	Par.stDT_date.Ca_Rectifydev_NightNG:=0;
END_IF

IF CCD.CaRec.NightNgclassification.NgClear[1] OR NightClear1.Q  THEN
   CCD.CaRec.NightNgclassification.X1_NG :=0 ;
END_IF

IF CCD.CaRec.NightNgclassification.NgClear[2] OR NightClear1.Q  THEN
   CCD.CaRec.NightNgclassification.X2_NG :=0 ;
END_IF

IF CCD.CaRec.NightNgclassification.NgClear[3] OR NightClear1.Q  THEN
   CCD.CaRec.NightNgclassification.Y_NG :=0 ;
END_IF

IF CCD.CaRec.NightNgclassification.NgClear[4] OR NightClear1.Q  THEN
   CCD.CaRec.NightNgclassification.R_NG :=0 ;
END_IF	

IF CCD.CaRec.NightNgclassification.NgClear[5] OR NightClear1.Q  THEN
   CCD.CaRec.NightNgclassification.other_NG :=0 ;
END_IF	


]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_StandbyMain" Id="{678a98af-09e7-4da4-a39a-ab4aa4b42a4e}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[Ca_TON[1](PT:=T#0.5S);//负极拍照结果超时
Ca_TON[2](PT:=T#5S);//叠台主轴启动超时报警延时
Ca_TON[3](PT:=T#0.5S);
Ca_TON[4](PT:=T#0.5S);
Ca_TON[5](PT:=T#20MS);//取缓存皮带延时
Ca_TON[6](PT:=T#0.1S);//负极取分段皮带取片延时
Ca_TON[7](PT:=T#0.3S);//负极取纠偏平台延时
Ca_TON[8](PT:=T#0.3S);//负极取纠偏平台延时
Ca_TON[9](PT:=T#100MS);//负极取流水线极片完成信号复位延时
Ca_TON[10](PT:=T#2.5S);
Ca_TON[11](PT:=T#2.5S);

//Ca_StandbyStep0


(******************************************************************负极片理极片*	*****************************************)	
IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下
CASE Ca_StandbyStep0 OF
1000://处理负极片取
	IF NOT DP_SinStepe THEN
		Ca_TON[8].IN:=TRUE;
		IF Mach_Control.Ca_b.Ca_CarryingFalg AND  Mach_Control.Ca_b.Ca_DPCarryingFalg AND  
			(CCD.CaRec.Finish.RectifyResult=1 OR    Mach_Control.U.CCD_ChosesHMI  OR Mach_Control.U.EmptyRunMode)  THEN
			Ca_StandbyStep0:=6666;//负极取料完成				
		ELSIF NOT Mach_Control.Ca_b.Ca_CarryingFalg AND  NOT Mach_Control.Ca_b.Ca_DPCarryingFalg AND NOT Mach_Control.Ca_b.Ca_deviationFalg  THEN
			DT_SingeMode();//单步选择	
			IF  CA_CarryingPos1 THEN  	
					Ca_StandbyStep0:=2000;//取流水线的极片							
			ELSIF CA_CarryingPos2 THEN
				  IF  TailCurlSEPTA_SafePos  THEN
					iMD1:=3;	
					Ca_StandbyStep0:=6000;//通过凸轮耦合从负极流水线取极片到机械手
				  END_IF	
			ELSIF (Ca_Step0=0 OR Ca_Step0=6666) AND (Ca_Step3=6666 OR Ca_Step3=0) AND Ca_TON[8].Q THEN 
				Ca_StandbyStep0:=9994;
				CaPosError[2]:=TRUE;
			END_IF		
		ELSIF Mach_Control.Ca_b.Ca_CarryingFalg AND  NOT Mach_Control.Ca_b.Ca_DPCarryingFalg AND  NOT Mach_Control.Ca_b.Ca_deviationFalg  THEN        // 状态2         1         0       0
			  DT_SingeMode();//单步选择		
			IF  CA_CarryingPos1 THEN   
				IF Mach_Control.Ca_b.Ca_deviationFPOK AND TailCurlSEPTA_SafePos  THEN//需要判断热切横移轴在安全位
					   iMD1:=1;	
					Ca_StandbyStep0:=6000;//通过凸轮耦合放极片到纠偏平台
				END_IF	
			ELSIF CA_CarryingPos2  THEN			
					 Ca_StandbyStep0:=2500;//  负极送片搬运放片到纠偏台
			ELSIF (Ca_Step0=0 OR Ca_Step0=6666)  AND (Ca_Step3=6666 OR Ca_Step3=0) AND Ca_TON[8].Q THEN 
				Ca_StandbyStep0:=9994;	
				CaPosError[3]:=TRUE;								   
			END_IF						
			//Ca_StandbyStep0:=3000;//通过凸轮耦合放极片到纠偏平台				
		ELSIF NOT Mach_Control.Ca_b.Ca_CarryingFalg AND  NOT Mach_Control.Ca_b.Ca_DPCarryingFalg AND  Mach_Control.Ca_b.Ca_deviationFalg THEN      // 状态3         0      0         1  
			 DT_SingeMode();//单步选择		
			IF  CA_CarryingPos1 THEN              
				IF (CCD.CaRec.Finish.RectifyResult=1 OR Mach_Control.U.EmptyRunMode OR Mach_Control.U.CCD_ChosesHMI  (* OR  Blueflaging*) )   THEN
					Ca_TON[1].IN:=FALSE;					
					Ca_StandbyStep0:=2100;//取流水线的极片、同时取纠偏平台的极片				                 				
				ELSIF CCD.CaRec.Finish.RectifyResult=2  OR CCD.CaRec.Finish.RectifyResult=3 OR CCD.CaRec.Finish.RectifyResult=4 THEN
					 Ca_TON[1].IN:=FALSE;					
					 Ca_StandbyStep0:=2200;// 同时取流水线的片  取纠偏平台的极片，再踢纠偏平台的NG片，	     ???????????????????????????????????????????????    
				ELSE		 
					IF NOT Ca_TON[1].Q THEN
						Ca_TON[1].IN:=TRUE;
					ELSE
						Ca_TON[1].IN:=FALSE;
						Mach_Control.Ca_b.Error[36]:=TRUE;//CCD第一次拍照超时报警
						Ca_StandbyStep0:=9999;
					END_IF		
				END_IF	   
			ELSIF  CA_CarryingPos2 THEN
						IF Mach_Control.Ca_b.Ca_deviationDPOK AND TailCurlSEPTA_SafePos  THEN//   	
							  iMD1:=2;	
							Ca_StandbyStep0:=6000;//通过凸轮耦合从纠偏平台取极片同时取料
						END_IF
			ELSIF (Ca_Step0=0 OR Ca_Step0=6666) AND (Ca_Step3=6666 OR Ca_Step3=0) AND Ca_TON[8].Q THEN 
				Ca_TON[8].IN:=FALSE;
				 Ca_StandbyStep0:=9994;
				 CaPosError[4]:=TRUE;
			END_IF
		ELSIF Mach_Control.Ca_b.Ca_CarryingFalg AND  NOT Mach_Control.Ca_b.Ca_DPCarryingFalg AND   Mach_Control.Ca_b.Ca_deviationFalg  THEN //状态4
			IF Mach_Control.Ca_b.Ca_deviationDPOK AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1]AND 
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving
				AND (Ca_Step3=6666 OR Ca_Step3=0) THEN				
				Ca_StandbyStep0:=4000;//单独取纠偏平台
				Ca_Step3:=10;	
			END_IF
		ELSIF  ( Mach_Control.Ca_b.Ca_DPCarryingFalg AND ( CCD.CaRec.Finish.RectifyResult=1 OR  Mach_Control.U.EmptyRunMode OR	  Mach_Control.U.CCD_ChosesHMI	(*OR  Blueflaging	*))  ) AND  NOT  Mach_Control.Ca_b.Ca_deviationFalg AND (Ca_Step0=0 OR Ca_Step0=6666) THEN			// 状态5正常      1(0)   1     0                 
		 	DT_SingeMode();//单步选择		
			IF  CA_CarryingPos1 THEN   
				IF  NOT Mach_Control.Ca_b.Ca_CarryingFalg THEN
					Ca_StandbyStep0:=2000;//取流水线的极片		
				END_IF
			ELSIF   Ca_TON[8].Q THEN// -(Ca_Step0=0 OR Ca_Step0=6666) AND --------------------
				Ca_TON[8].IN:=FALSE;
				Ca_StandbyStep0:=9994;
				CaPosError[5]:=TRUE;
			END_IF
		ELSIF  ( Mach_Control.Ca_b.Ca_DPCarryingFalg AND  CCD.CaRec.Finish.RectifyResult<>1 ) AND  NOT  Mach_Control.Ca_b.Ca_deviationFalg  AND NOT    Mach_Control.U.CCD_ChosesHMI AND (Ca_Step0=0 OR Ca_Step0=6666) THEN			// 状态6踢废       1(0)   1     0    叠台当前片NG
					DT_SingeMode();//单步选择		
			IF  CA_CarryingPos1 THEN      		
				  IF  NOT Mach_Control.Ca_b.Ca_CarryingFalg THEN
						Ca_StandbyStep0:=2300;// 同时取流水线的片	   踢纠偏平台的NG片    ??????????????????????????     
				  ELSIF   Mach_Control.Ca_b.Ca_CarryingFalg THEN
						Ca_StandbyStep0:=2400;//踢纠偏平台的NG片	                            ???????????????????????????                       
				  END_IF
			ELSIF   Ca_TON[8].Q THEN // (Ca_Step0=0 OR Ca_Step0=6666) AND ----------------------
				Ca_TON[8].IN:=FALSE;
			 	Ca_StandbyStep0:=9994;
				CaPosError[6]:=TRUE;
			END_IF		
		END_IF					
	END_IF	
	
2000://调用取流水线子程序
	IF NOT DP_SinStepe THEN
		Ca_Step0:=10;//负极取流水线子程序
		DT_SingeMode();//单步选择						
		Ca_StandbyStep0:=2010;	
	END_IF	
2010://判断取料是否完成
	IF NOT DP_SinStepe THEN
		IF Ca_Step0=6666 THEN
			 DT_SingeMode();//单步选择						
			Ca_StandbyStep0:=1000;	
		END_IF
	END_IF

2100://调用取流水线子程序，取纠偏极片子程序
	IF NOT DP_SinStepe THEN
		Ca_Step0:=10;//负极取流水线子程序
		Ca_Step3:=10;//负极取纠偏平台子程序
		DT_SingeMode();//单步选择		
		Ca_StandbyStep0:=2110;	
	END_IF
	
2110://判断负极取片流水线的极片、取纠偏平台的极片是否完成
	IF NOT DP_SinStepe THEN
		IF 	Ca_Step0=6666 AND Ca_Step3=6666 THEN
			 DT_SingeMode();//单步选择						
			 Ca_StandbyStep0:=1000;	
		END_IF
	END_IF
			
2200://先取纠偏平台的极片，同时根据条件判断是否可以取流水线的极片
	IF NOT DP_SinStepe THEN
		Ca_Step0:=10;//负极取流水线子程序
		Ca_Step3:=10;//负极取纠偏平台子程序
		 DT_SingeMode();//单步选择								
		Ca_StandbyStep0:=2210;	
	END_IF
2210://判断取纠极片是否完成
	IF NOT DP_SinStepe THEN
		IF Ca_Step0=6666 AND Ca_Step3=6666 THEN
			Ca_Step2:=10;//调用踢NG料程序							
			DT_SingeMode();//单步选择								
			Ca_StandbyStep0:=2220;
		END_IF
	END_IF
			
			
2220://判断取流水线极片，踢NG极片是否完成
	IF NOT DP_SinStepe THEN
		IF   Ca_Step2=6666  THEN
			 DT_SingeMode();//单步选择							
			Ca_StandbyStep0:=1000;
		END_IF	
	END_IF
			
2300://调用取流水线极片，调用踢NG片子程序
	IF NOT DP_SinStepe THEN
		Ca_Step0:=10;//负极取流水线子程序
		Ca_Step2:=10;//调用踢NG料程序
		 DT_SingeMode();//单步选择								
		Ca_StandbyStep0:=2310;	
	END_IF

2310://判断取流水线极片、踢NG片是否完成
	IF NOT DP_SinStepe THEN
		IF Ca_Step0=6666 AND Ca_Step2=6666 THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF
			Ca_StandbyStep0:=1000;
		END_IF
	END_IF
	
2400://调用踢NG片子程序
	IF NOT DP_SinStepe THEN
		Ca_Step2:=10;//调用踢NG料程序
		DT_SingeMode();//单步选择								
		Ca_StandbyStep0:=2410;
	END_IF
2410://判断踢NG片是否完成
	IF NOT DP_SinStepe THEN
		IF Ca_Step2=6666 THEN
			 DT_SingeMode();//单步选择								
			Ca_StandbyStep0:=1000;
		END_IF
	END_IF

2500:
	IF NOT DP_SinStepe THEN
		Ca_Step1:=10;//负极搬运吸盘放纠偏平台
		 DT_SingeMode();//单步选择						
		Ca_StandbyStep0:=2510;	
	  END_IF
2510:
	IF NOT DP_SinStepe THEN
		IF Ca_Step1=6666 THEN
			 DT_SingeMode();//单步选择					
			Ca_StandbyStep0:=1000;
		END_IF
	END_IF				
		

3030:
	IF NOT DP_SinStepe THEN
		IF CA_CarryingPos1  THEN//负极搬运、叠片各轴在初始位
			IF AN_CarryingPos2  THEN//正极在叠片位
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] THEN					     
					 IF  NOT Mach_Control.An_b.An_DPCarryingFalg AND  Mach_Control.An_b.An_deviationFalg   THEN  //叠片搬运需要取片 AND Mach_Control.An_b.An_deviationDPOK
						  iAnCamInSel2:=1;
					  ELSE
						  iAnCamInSel2:=2;
					 END_IF      																		 
					 Ca_StandbyStep0:=3110;	 
				ELSE
					Mach_Control.DT_b.Error[5]:=TRUE;//隔膜平移不在负极片位报警
					Ca_StandbyStep0:=9992;
				END_IF;
			ELSIF AN_CarryingPos1 THEN//在取片位
				IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] THEN
					DT_SingeMode();//单步选择										
					Ca_StandbyStep0:=3040;        //OK
				ELSIF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] THEN
					DT_SingeMode();//单步选择										
					Ca_StandbyStep0:=3050;    //OK
				ELSE
					Mach_Control.DT_b.Error[5]:=TRUE;//叠负极片凸轮耦合时，隔膜平移轴即不在负极叠片位，也不在正极叠片位报警
					Ca_StandbyStep0:=9992;
				END_IF;							
			ELSE

				Ca_StandbyStep0:=9993;
				CaPosError[1]:=TRUE;
			END_IF
		ELSE
			Ca_StandbyStep0:=9994;
			CaPosError[7]:=TRUE;
		END_IF
	END_IF

4000:
	IF Ca_Step3=6666 THEN	
		Ca_StandbyStep0:=4100;
	 END_IF		 
4100:
	 Ca_StandbyStep0:=1000;



6000://判断主轴是否停止、是否在初始位、是否有轴在耦合中
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.ActPos=0 AND NOT DT_AxiseCoupling THEN
			 DT_SingeMode();//单步选择						
			Ca_StandbyStep0:=6024;
		ELSE
			DP_Step1:=100;//调用主轴回初始位子程序
			 DT_SingeMode();//单步选择							
			Ca_StandbyStep0:=6020;
		END_IF
	END_IF
6020://判断主轴的模长的当前位置是否为0
	IF NOT DP_SinStepe THEN
		IF DP_Step1=6666 AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.NoMoving AND arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.ActPos=0 AND NOT DT_AxiseCoupling THEN
			DT_SingeMode();//单步选择						
			Ca_StandbyStep0:=6024;
		END_IF
	END_IF		

6024://判断NG气缸是否在安全位        无NG踢废气缸
	IF arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
		arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
		arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState AND
        (arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] OR (Ca_OverNGMark AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[15])) AND
        arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]  THEN
		Ca_StandbyStep0:=6030;		
	ELSE
		Ca_StandbyStep0:=6025;	
	END_IF
	//Ca_StandbyStep0:=6025;
6025:

	arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Cmd.bOFF:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Cmd.bON:=TRUE;
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Cmd.bON:=TRUE;
	//arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;
	IF   arrCyCtrl[arrCyNo.CylinderName.AnScrapbinCy].Status.ONState AND  arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState AND 
	arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeCy].Status.OFFState AND
	arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerRCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.PoleTapeSplicerLCy].Status.ONState
	AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON THEN
		arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;		
		IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState 
            AND (arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] OR (Ca_OverNGMark AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[15])) 
            AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1]  THEN						
			Ca_StandbyStep0:=6024;				
		END_IF														
	END_IF
  //Ca_StandbyStep0:=6030;	
6030:										
	IF iMD1=1 THEN
		Ca_StandbyStep0:=3030;	
	ELSIF iMD1=2 THEN
		Ca_StandbyStep0:=3230;	
	ELSIF iMD1=3 THEN
		Ca_StandbyStep0:=3330;			
	END_IF





		
END_CASE
END_IF


CASE Ca_StandbyStep0 OF
3040://  OK
	//负到正_负极搬运平移2轴凸轮耦合
	fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=1;
	fbCaCamInCarryingLine2.bCamInExecute:=TRUE;
	//负到正_负极搬运升降2轴放片凸轮耦合
	fbCaCamInCarryingUpDown2.iTableSel:=2;
	fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;
	//负到正_负极叠片平移轴凸轮耦合
	fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
	fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;
	
	fbCaCamInDTCarryingUpDown.iTableSel:=3;  //20240528SJ
	fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
	
	//判断凸轮耦合是否完成
	IF 	fbCaCamInCarryingLine2.bInSync AND fbCaCamInCarryingUpDown2	.bInSync AND 	fbCaCamInDTCarryingLine.bInSync  AND  fbCaCamInDTCarryingUpDown.bInSync    THEN
		DT_SingeMode();//单步选择		
		Ca_StandbyStep0:=3060;
	ELSIF fbCaCamInCarryingLine2.bError OR fbCaCamInCarryingUpDown2	.bError OR 	fbCaCamInDTCarryingLine.bError  OR  fbCaCamInDTCarryingUpDown.bError     THEN	
		Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
		Ca_StandbyStep0:=9995;
	END_IF	

3060://主轴启动    OK
	IF 	fbCaCamInCarryingLine2.bInSync AND fbCaCamInCarryingUpDown2	.bInSync AND 	fbCaCamInDTCarryingLine.bInSync AND	
		AN_CarryingPos1 AND  CA_CarryingPos1 AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
		arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;
	END_IF

	//	fbAnCamInCarryingUpDownOutCamFlge:=FALSE;//正极升降解耦标记	
	IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10 THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;
		Ca_TON[2].IN:=FALSE;
		Ca_StandbyStep1:=100;
		Ca_StandbyStep0:=3070;
		Ca_StandbyStep5:=100;
		DP_Step8:=100;//纠偏平台有无极片复检
	ELSE
		IF NOT Ca_TON[2].Q THEN
			Ca_TON[2].IN:=TRUE;
		ELSE
			Ca_TON[2].IN:=FALSE;
			Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			Ca_StandbyStep0:=10000;	
		END_IF
	END_IF



3050://   OK
	//负到正_负极搬运平移2轴凸轮耦合
	fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=1;
	fbCaCamInCarryingLine2.bCamInExecute:=TRUE;						
	//负到正_负极搬运升降2轴放片凸轮耦合
	fbCaCamInCarryingUpDown2.iTableSel:=2;
	fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;
	//负到正_负极叠片平移轴凸轮耦合
	fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
	fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;			
	
	fbCaCamInDTCarryingUpDown.iTableSel:=3;  //20240528SJ
	fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
	
	//负到正_缓存轴凸轮耦合	
	fbCamInGMBuffer.iTableSel:=2;
	fbCamInGMBuffer.bCamInExecute:=TRUE;
	//负到正_隔膜平移轴凸轮耦合
	fbCamInGMDanserMove.iTableSel:=2;
	fbCamInGMDanserMove.bCamInExecute:=TRUE;
	//隔膜驱动
	fbCamInVirGMDriver.iTableSel:=2;
	fbCamInVirGMDriver.bCamInExecute:=TRUE;		
					
	//判断凸轮耦合是否完成
	IF fbCaCamInCarryingLine2.bInSync AND fbCaCamInCarryingUpDown2.bInSync AND fbCaCamInDTCarryingLine.bInSync AND fbCaCamInDTCarryingUpDown.bInSync AND  //20240528SJ
		fbCamInGMBuffer.bInSync AND fbCamInGMDanserMove.bInSync AND fbCamInVirGMDriver.bInSync     THEN
		DT_SingeMode();//单步选择		
		Ca_StandbyStep0:=3080;	
	ELSIF	fbCaCamInCarryingLine2.bError OR fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingLine.bError OR  fbCaCamInDTCarryingUpDown.bError OR 
		fbCamInGMBuffer.bError OR  fbCamInGMDanserMove.bError  OR fbCamInVirGMDriver.bError  THEN	
		Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
		Ca_StandbyStep0:=9996;	
	END_IF
	
3080://主轴启动    OK
	IF fbCaCamInCarryingLine2.bInSync AND fbCaCamInCarryingUpDown2.bInSync AND fbCaCamInDTCarryingLine.bInSync AND
		fbCamInGMBuffer.bInSync AND fbCamInGMDanserMove.bInSync AND fbCamInVirGMDriver.bInSync     AND	
		 AN_CarryingPos1 AND  CA_CarryingPos1 AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] THEN
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
			arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;
	END_IF
	
//	fbAnCamInCarryingUpDownOutCamFlge:=FALSE;//正极升降解耦标记	
	IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10 THEN
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;
		Ca_TON[2].IN:=FALSE;
		Ca_StandbyStep1:=100;
		Ca_StandbyStep0:=3090;
		Ca_StandbyStep5:=100;
		DP_Step8:=100;//纠偏平台有无极片复检
	ELSE
		IF NOT Ca_TON[2].Q THEN
			Ca_TON[2].IN:=TRUE;
		ELSE
			Ca_TON[2].IN:=FALSE;
			Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			Ca_StandbyStep0:=10000;	
		END_IF
	END_IF

	
3110://   OK
	//负到正_负极搬运平移2轴凸轮耦合
	fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=1;
	fbCaCamInCarryingLine2.bCamInExecute:=TRUE;							
	//负到正_负极搬运升降2轴放片凸轮耦合
	fbCaCamInCarryingUpDown2.iTableSel:=2;
	fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;					
	//负到正_负极叠片平移轴凸轮耦合
	fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=1;
	fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;		
	
	fbCaCamInDTCarryingUpDown.iTableSel:=3;  //20240528SJ
	fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
	
	//负到正_缓存轴凸轮耦合
	fbCamInGMBuffer.iTableSel:=2;
	fbCamInGMBuffer.bCamInExecute:=TRUE;					
	//负到正_隔膜平移轴凸轮耦合
	fbCamInGMDanserMove.iTableSel:=2;
	fbCamInGMDanserMove.bCamInExecute:=TRUE;
	//隔膜驱动
	fbCamInVirGMDriver.iTableSel:=2;
	fbCamInVirGMDriver.bCamInExecute:=TRUE;					
	
	//负到正_正极搬运平移轴凸轮耦合	
	fbAnCamInCarryingLine.ParCamIn.SlaveScaling:=-1;
	fbAnCamInCarryingLine.bCamInExecute:=TRUE;	
		
   fbAnCamInCarryingUpDown.iTableSel:=3;      //20240528SJ
   fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;
												
	//负到正_正极搬运升降轴取片凸轮耦合
	IF iAnCamInSel1=1 THEN   //正极取片   升降不用耦合
		;
		//fbAnCamInCarryingUpDown.iTableSel:=1;
		//fbAnCamInCarryingUpDown.bCamInExecute:=TRUE;
	END_IF
	//负到正_正极搬运旋转轴凸轮耦合	
	fbAnCamInCarryingWhirling.ParCamIn.SlaveScaling:=-1;
	fbAnCamInCarryingWhirling.bCamInExecute:=TRUE;				
	
	//负到正_正极叠片平移轴凸轮耦合
	fbAnCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
	fbAnCamInDTCarryingLine.bCamInExecute:=TRUE;	
					
	//负到正_正极叠片升降轴取片凸轮耦合
	IF iAnCamInSel2=1 THEN
		fbAnCamInDTCarryingUpDown.iTableSel:=1;
		fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;
	ELSE
		fbAnCamInDTCarryingUpDown.iTableSel:=3;   //  //20240528SJ
		fbAnCamInDTCarryingUpDown.bCamInExecute:=TRUE;
	END_IF
	
	//判断凸轮是否耦合完成
	IF fbCaCamInCarryingLine2.bInSync AND fbCaCamInCarryingUpDown2.bInSync AND fbCaCamInDTCarryingLine.bInSync AND  fbCaCamInDTCarryingUpDown.bInSync AND  //20240528SJ
		fbCamInGMBuffer.bInSync AND  fbCamInGMDanserMove.bInSync  AND  fbCamInVirGMDriver.bInSync  AND
		fbAnCamInCarryingLine.bInSync AND  fbAnCamInCarryingUpDown.bInSync  AND     fbAnCamInCarryingWhirling.bInSync  AND   // //20240528SJ    (*(  (fbAnCamInCarryingUpDown.bInSync  AND  iAnCamInSel1=1) OR  iAnCamInSel1=2    ) AND *) 
		fbAnCamInDTCarryingLine.bInSync AND (  (fbAnCamInDTCarryingUpDown.bInSync  AND  iAnCamInSel2=1 )  OR  (  iAnCamInSel2=2 AND    fbAnCamInDTCarryingUpDown.bInSync )   )     THEN   //20240528SJ
		DT_SingeMode();//单步选择					
		Ca_StandbyStep0:=3120;
	ELSIF fbCaCamInCarryingLine2.bError OR fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingLine.bError OR 
		fbCamInGMBuffer.bError OR  fbCamInGMDanserMove.bError  OR  fbCamInVirGMDriver.bError  OR
		fbAnCamInCarryingLine.bError OR fbAnCamInCarryingUpDown.bError  OR  fbAnCamInCarryingWhirling.bError OR
		fbAnCamInDTCarryingLine.bError OR fbAnCamInDTCarryingUpDown.bError   THEN
		Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
		Ca_StandbyStep0:=9998;
	END_IF
	3120://主轴启动   OK								
		IF fbCaCamInCarryingLine2.bInSync AND fbCaCamInCarryingUpDown2.bInSync AND fbCaCamInDTCarryingLine.bInSync AND 
			fbCamInGMBuffer.bInSync AND  fbCamInGMDanserMove.bInSync  AND  fbCamInVirGMDriver.bInSync  AND
			fbAnCamInCarryingLine.bInSync AND  fbAnCamInCarryingWhirling.bInSync  AND
			fbAnCamInDTCarryingLine.bInSync AND (  (fbAnCamInDTCarryingUpDown.bInSync  AND  iAnCamInSel2=1 )  OR  iAnCamInSel2=2   )     AND
			AN_CarryingPos2 AND  CA_CarryingPos1 AND  arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[2] THEN		
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
			arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;				
		END_IF		
		
		IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=10  THEN		
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;
			Ca_TON[2].IN:=FALSE;		
			Ca_StandbyStep0:=3130;	
			Ca_StandbyStep1:=200;
			Ca_StandbyStep5:=200;
			DP_Step8:=100;//纠偏平台有无极片复检
		ELSE
			IF NOT Ca_TON[2].Q THEN
				Ca_TON[2].IN:=TRUE;
			ELSE
				Ca_TON[2].IN:=FALSE;
				Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
				arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
				Ca_StandbyStep0:=10000;	
			END_IF
		END_IF	
							
	3230:		//OK			
	//负极搬运平移
	fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=-1;
	fbCaCamInCarryingLine2.bCamInExecute:=TRUE;			
	
	fbCaCamInCarryingUpDown2.iTableSel:=3;   //20240528SJ
	fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;		
	
	//负极叠台搬运平移
	fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
	fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;	
	//负极送片搬运升降
	fbCaCamInDTCarryingUpDown.iTableSel:=1;       //    
	fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;								
									  
	IF fbCaCamInCarryingLine2.bInSync     AND fbCaCamInCarryingUpDown2.bInSync  AND //20240528SJ
		fbCaCamInDTCarryingLine.bInSync   AND  fbCaCamInDTCarryingUpDown.bInSync THEN   
		DT_SingeMode();//单步选择		
		Ca_StandbyStep0:=3240;
	ELSIF fbCaCamInCarryingLine2.bError  OR    fbCaCamInCarryingUpDown2.bError OR
		fbCaCamInDTCarryingLine.bError   OR  fbCaCamInDTCarryingUpDown.bError THEN   
		Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
		Ca_StandbyStep0:=9998;
	END_IF	  
3240:	
	IF fbCaCamInCarryingLine2.bInSync  AND   //AND fbCaCamInCarryingUpDown2.bInSync
		fbCaCamInDTCarryingLine.bInSync   AND  fbCaCamInDTCarryingUpDown.bInSync  AND CA_CarryingPos2 THEN   		
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
		arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;	
	END_IF	  
		
	IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=5  THEN		
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;
		Ca_TON[2].IN:=FALSE;		
		Ca_StandbyStep0:=3250;	
		Ca_StandbyStep1:=300;//二次拍照，从纠偏平台取极片，从流水线取极片
		Ca_StandbyStep5:=300;
	ELSE
		IF NOT Ca_TON[2].Q THEN
			Ca_TON[2].IN:=TRUE;
		ELSE
			Ca_TON[2].IN:=FALSE;
			Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			Ca_StandbyStep0:=10000;	
		END_IF
	END_IF

	3330:			
	//负极送片搬运平移
	fbCaCamInCarryingLine2.ParCamIn.SlaveScaling:=-1;
	fbCaCamInCarryingLine2.bCamInExecute:=TRUE;							
	//负极送片搬运升降
	fbCaCamInCarryingUpDown2.iTableSel:=3;       //20240528SJ   
	fbCaCamInCarryingUpDown2.bCamInExecute:=TRUE;			
	
	//负极叠台搬运平移
	fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling:=-1;
	fbCaCamInDTCarryingLine.bCamInExecute:=TRUE;	
	
	fbCaCamInDTCarryingUpDown.iTableSel:=3;  //20240528SJ
    fbCaCamInDTCarryingUpDown.bCamInExecute:=TRUE;
	
	
	IF fbCaCamInCarryingLine2.bInSync  AND  fbCaCamInCarryingUpDown2.bInSync AND 
		fbCaCamInDTCarryingLine.bInSync    THEN   
		DT_SingeMode();//单步选择		
		Ca_StandbyStep0:=3340;
	ELSIF fbCaCamInCarryingLine2.bError OR  fbCaCamInCarryingUpDown2.bError OR
		fbCaCamInDTCarryingLine.bError    THEN   
		Mach_Control.DT_b.Error[19]:=TRUE;//凸轮耦合报警
		Ca_StandbyStep0:=9998;
	END_IF		
				
3340:	
	   IF fbCaCamInCarryingLine2.bInSync  AND //AND fbCaCamInCarryingUpDown2.bInSync
		fbCaCamInDTCarryingLine.bInSync  AND  CA_CarryingPos2 THEN   
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bDynamitcsParSel:=2;	
		arrAxisPar[AxiseNo.VirAxisName.VirMain].fTagatTime:=VirMain_TagatTime;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.fPositon_of_Abs:=360;
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=TRUE;		
	END_IF	
		
	IF  arrAxis[AxiseNo.VirAxisName.VirMain].Status.Moving OR arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=5  THEN		
		arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;
		Ca_TON[2].IN:=FALSE;		
		Ca_StandbyStep0:=3350;	
		Ca_StandbyStep1:=400;//从放料位到取片位取片
		Ca_StandbyStep5:=400;//
	ELSE
		IF NOT Ca_TON[2].Q THEN
			Ca_TON[2].IN:=TRUE;
		ELSE
		Ca_TON[2].IN:=FALSE;
			Mach_Control.DT_b.Error[22]:=TRUE;//主轴启动超时报警
			arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Cmd	.bMoveAbs:=FALSE;	
			Ca_StandbyStep0:=10000;	
		END_IF
	END_IF	
		
END_CASE



]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_StandbyMain2" Id="{dcff8189-b5ea-47d4-932a-15f79ac9922b}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[
//Ca_StandbyStep1------真空处理
//Ca_StandbyStep5------主轴位置状态判断
CASE Ca_StandbyStep1 OF 
	
100://负极开始叠片     正极在取片位
       bStandbyStep1_1:=FALSE;
       bStandbyStep1_2:=FALSE;
       Ca_StandbyStep1:=110; 
	   
110:
	  IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=20  AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=30     THEN
             //正送片搬运极取片处理
		IF   arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] AND 
		      NOT Mach_Control.An_b.An_CarryingFalg    AND  ( Mach_Control.An_b.An_MainBeltOK OR  Mach_Control.U.EmptyRunMode )  AND 
		      NOT  Mach_Control.An_b.An_MainBelting   AND NOT  bStandbyStep1_1 (*AND NOT Mach_Control.An_b.JumpPiceReady *) THEN
			   An_Step0:=10;//正极取流水线子程序
			   bStandbyStep1_1:=TRUE;
		END_IF				
		//正叠台搬运取极片处理			
		IF arrAxisCtrl[AxiseNo.AxisName.AnDTCarryingUpDown].Cmd.arrbRealPoint[4] AND 
			Mach_Control.An_b.An_deviationDPOK AND NOT Mach_Control.An_b.An_DPCarryingFalg AND  
			Mach_Control.An_b.An_deviationFalg  AND  NOT  bStandbyStep1_2  AND NOT DP_CheseCam   THEN
			An_Step3:=10;//正极取纠偏平台子程序
			bStandbyStep1_2:=TRUE;
		 END_IF
			 
   	ELSIF  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>245  THEN
	           Ca_StandbyStep1:=120;
	END_IF
	
120:	
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260  AND   arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=320   THEN//198		
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=TRUE;//负极送片搬运真空破 	
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=FALSE;//负极送片搬运真空破			
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;//负极纠偏平台真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;//负极纠偏平台真空开	
		//IF Mach_Control.Ca_b.Ca_CarryingFalg THEN
			Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位纠偏平台上有料标记
			Mach_Control.Ca_b.Ca_CarryingFalg :=FALSE;//负极送片搬运吸盘上有料标记
		//END_IF
		Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[7];
		Ca_StandbyStep1:=121;
	END_IF	
121:
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=330 THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=TRUE;//负极送片搬运真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极送片搬运真空开	
		Ca_StandbyStep1:=6666;
	END_IF
	
	

			
200:	     // 状态2         1         0       0     iMD1:=1;	  	Ca_StandbyStep0:=6000;//通过凸轮耦合放极片到纠偏平台
	 IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=CamOutArgel+15 THEN   //整机叠片搬运
		 IF iAnCamInSel2=1  THEN	 
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;//正极叠片搬运真空开
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;//正极叠片搬运真空开
		 END_IF
		Ca_StandbyStep1:=205;
	 END_IF
205:
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=235 THEN
	 	//	正极送片搬运			在子流程中处理								
		IF Mach_Control.DT_b.DT_CCD_TwoModel  AND iAnCamInSel2=1    THEN												
			CCD.AnRec.Finish.RectifyResult:=0;
			CCD.AnRec.Finish.RectifyX1:=0;
			CCD.AnRec.Finish.RectifyX2:=0;
			CCD.AnRec.Finish.RectifyY:=0;												
			Mach_Control.An_b.An_CCDStart :=TRUE;//启动CCD拍照
			CCD.AnRec.Start.iPhotoDo:=2;//第二次拍照
			CCD.CaRec.Start.stPoleNo:=Par.stDT_date.An_MQ_Slice[1].stPoleNo;  //???????????????????????????
		END_IF	
		Ca_StandbyStep1:=210;
	END_IF			 
 210:
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=250  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=(250+6) AND NOT Mach_Control.An_b.An_MainBelting THEN
			IF (Mach_Control.An_b.An_MainBeltOK  OR  Mach_Control.U.EmptyRunMode ) AND NOT  Mach_Control.An_b.An_CarryingFalg (*AND NOT Mach_Control.An_b.JumpPiceReady *)THEN
			//fbAnCarryingVacuum.Vacuumsel:=1;										
			//  Mach_Control.An_b.An_MainBelting:=TRUE;//正极搬运升降取极片中	 
			An_Step0:=10;  //调用升降取片流程 
		ELSE
			IF NOT  Mach_Control.An_b.An_CarryingFalg  THEN
				//fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极升解除耦合
				Mach_Control.An_b.An_MainBelting:=FALSE;//正极搬运升降取极片中	
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bON:=FALSE;	//正极送片搬运升降真空关	
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuum].Cmd.bOFF:=TRUE;	//正极送片搬运升降真空关	
								
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bON:=FALSE;	//正极送片搬运升降真空关		
				arrCyCtrl[arrCyNo.ElectValveName.AnCarryingVacuumBark].Cmd.bOFF:=TRUE;	//正极送片搬运升降真空关	
			END_IF															
			IF NOT arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.arrbRealPoint[4] THEN
				arrAxisCtrl[AxiseNo.AxisName.AnCarryingUpDown].Cmd.iGoSetPos:=4;//移动至流水线上方
			END_IF	
		END_IF				
		Ca_StandbyStep1:=220;
	END_IF
				
  220:			
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260    AND    	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=320  THEN//198
		//负极送片搬运				
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=TRUE;//负极送片搬运真空破
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=FALSE;//负极送片搬运真空破
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;//负极纠偏平台真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;//负极纠偏平台真空开	
		
		//IF Mach_Control.Ca_b.Ca_CarryingFalg THEN
			Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位纠偏平台上有料标记
			Mach_Control.Ca_b.Ca_CarryingFalg:=FALSE;//复位负极送片搬运吸盘上有料标记
		//END_IF
		Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[7];		
		IF iAnCamInSel2=1  THEN
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;////正极叠片搬运真空开					
			arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;////正极叠片搬运真空开
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bON:=FALSE;//正极纠偏平台破真空开
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuum].Cmd.bOFF:=TRUE;//正极纠偏平台破真空开									
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bON:=TRUE;//正极纠偏平台破真空开
			arrCyCtrl[arrCyNo.ElectValveName.AndeviationVacuumBark].Cmd.bOFF:=FALSE;//正极纠偏平台破真空开
			Mach_Control.An_b.An_DPCarryingFalg :=TRUE;//正极叠片搬运吸盘上有料标记
			Mach_Control.An_b.An_deviationFalg:=FALSE;//置位纠偏平台上有料标记
			Par.stDT_date.An_MQ_Slice[2]:=Par.stDT_date.An_MQ_Slice[1];	
		ELSE
			;
		END_IF	
		Ca_StandbyStep1:=221;
	END_IF		
221:
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=330 THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=TRUE;//负极送片搬运真空开
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极送片搬运真空开
		Ca_StandbyStep1:=222;
	END_IF
222:
	Ca_StandbyStep1:=666;

	
	
	
	

300:	     // 状态2         1         0       0     iMD1:=1;	  	Ca_StandbyStep0:=6000;//通过凸轮耦合放极片到纠偏平台
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=CamOutArgel+15 THEN   //整机叠片搬运
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bON:=FALSE;	//正极叠片搬运升降真空
		arrCyCtrl[arrCyNo.ElectValveName.AnDTCarryingVacuum].Cmd.bOFF:=TRUE;	//正极叠片搬运升降真空
		Ca_StandbyStep1:=305;
	END_IF
305:
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=235 THEN
		//	正极送片搬运在子流程中处理								
		IF Mach_Control.DT_b.DT_CCD_TwoModel     THEN												
			CCD.CaRec.Finish.RectifyResult:=0;
			CCD.CaRec.Finish.RectifyX1:=0;
			CCD.CaRec.Finish.RectifyX2:=0;
			CCD.CaRec.Finish.RectifyY:=0;												
			Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
			CCD.CaRec.Start.iPhotoDo:=2;//第二次拍照
			CCD.CaRec.Start.stPoleNo:=Par.stDT_date.Ca_MQ_Slice[8].stPoleNo;  //???????????????????????????
		END_IF
		Ca_StandbyStep1:=310;
	END_IF 
 310:
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=250  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=(250+6)   THEN
		IF (Mach_Control.Ca_b.Ca_CacheBeltDLOK  OR  Mach_Control.U.EmptyRunMode ) AND  NOT  Mach_Control.Ca_b.Ca_CarryingFalg AND NOT Mach_Control.Ca_b.Ca_CacheBelting  THEN
			//fbCaCarryingVacuum_2.Vacuumsel:=1;										
			//  Mach_Control.Ca_b.Ca_MainBelting:=TRUE;//正极搬运升降取极片中	 
			Ca_Step0:=10;  //调用升降取片流程 
		ELSE
			//fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极升解除耦合
			Mach_Control.Ca_b.Ca_CacheBelting:=FALSE;//负极搬运升降取极片中	
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=TRUE;//负极送片搬运真空关	
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=FALSE;//负极送片搬运真空关																						
			IF NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=4;//移动至流水线上方
			END_IF	
		END_IF	
			
		  Ca_StandbyStep1:=320;
	END_IF
				
320:			
	IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=260    AND    	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=320  THEN//198
		//负极送片搬运
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠台搬运真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠台搬运真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=FALSE;//负极纠偏平台真空关	
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=TRUE;//负极纠偏平台真空关
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bON:=TRUE;//负极纠偏平台破真空	开		
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bOFF:=FALSE;//负极纠偏平台破真空关
		//IF Mach_Control.Ca_b.Ca_deviationFalg THEN		
			Mach_Control.Ca_b.Ca_DPCarryingFalg :=TRUE;//负极叠片搬运吸盘上有料标记
			Mach_Control.Ca_b.Ca_deviationFalg:=FALSE;//纠偏平台上有料标记
		//END_IF
		Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[7];				
		Ca_StandbyStep1:=666;
	END_IF	
			
			       

				 		 
400:   ///   状态1       0     0      0     负极送片搬运放片位置到取片位置单独取片
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=250  AND arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=(250+6)  THEN   
		IF ( Mach_Control.Ca_b.Ca_CacheBeltDLOK  OR  Mach_Control.U.EmptyRunMode  ) AND  NOT  Mach_Control.Ca_b.Ca_CarryingFalg  AND NOT Mach_Control.Ca_b.Ca_CacheBelting  THEN
			//fbCaCarryingVacuum_2.Vacuumsel:=1;										
			//  Mach_Control.Ca_b.Ca_MainBelting:=TRUE;//正极搬运升降取极片中	 
			 Ca_Step0:=10;  //调用升降取片流程 
		ELSE
			//fbAnCamInCarryingUpDown.bCamInExecute:=FALSE;//正极升解除耦合
			Mach_Control.Ca_b.Ca_CacheBelting:=FALSE;//负极搬运升降取极片中	
			////负极送片搬运真空、破真空都关		
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=TRUE;//负极送片搬运真空关			
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=FALSE;//负极送片搬运真空关																	
			IF NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=4;//移动至流水线上方
			END_IF	
		END_IF	
		Ca_StandbyStep1:=666;
	END_IF

(*		
(************************************NG纠偏流程*********************************************)
600:		//负极搬运放片到纠偏平台
			IF 	arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos>=234  AND  arrAxisCtrl[AxiseNo.VirAxisName.VirMain].Status.fActPos<=270  THEN//198
					//负极送片搬运
                     	fbCaCarryingVacuum2.Vacuumsel:=2;//负极送片搬运破真空开
						fbCadeviationVacuum.Vacuumsel:=1;	//负极纠偏平台真空开						
						Mach_Control.Ca_b.Ca_CarryingFalg:=FALSE;//复位负极送片搬运吸盘上有料标记
						Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位纠偏平台上有料标记
					   	Par.stDT_date.Ca_MQ_Slice[P2Ca_M.Cadeviation_date]:=Par.stDT_date.Ca_MQ_Slice[P2Ca_M.CaCarrying_date];
			          Ca_StandbyStep1:=666;
		    END_IF	
*)
				
END_CASE


CASE Ca_StandbyStep5 OF 
	
100://		
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Cmd.bON:=TRUE;//负极纠偏平台除尘
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Cmd.bOFF:=FALSE;//负极纠偏平台除尘
		DT_SingeMode();//单步选择		
		DP_Step1:=100;//解耦
		Ca_StandbyStep5:=110;
	END_IF;			
 110:
	IF DP_Step1=6666 THEN
		Ca_StandbyStep0:=1000;	
		Ca_StandbyStep5:=6666;
	END_IF	
						

200:		  // 状态2         1         0       0     iMD1:=1;	  	Ca_StandbyStep0:=6000;//通过凸轮耦合放极片到纠偏平台	
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		// 正极取片中信号在  子流程中处理   
		DT_SingeMode();//单步选择			
		DP_Step1:=100;
		Ca_StandbyStep5:=220;
	END_IF		

220:		
	IF DP_Step1=6666 THEN	
		Ca_StandbyStep0:=1000;	
		Ca_StandbyStep5:=6666;
	END_IF;		

300:
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		DT_SingeMode();//单步选择			
		DP_Step1:=100;
		Ca_StandbyStep5:=320;
	END_IF	
320:		
	IF DP_Step1=6666 	 THEN	
		Ca_StandbyStep0:=1000;	
		Ca_StandbyStep5:=6666;
	END_IF;									

400:
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		DT_SingeMode();//单步选择			
		DP_Step1:=100;
		Ca_StandbyStep5:=420;
	END_IF		

420:		
	IF DP_Step1=6666 THEN	
		Ca_StandbyStep0:=1000;	
		Ca_StandbyStep5:=6666;
	END_IF;		

600:
	IF arrAxis[AxiseNo.VirAxisName.VirMain].NcToPlc.SetPos=360 AND  arrAxis[AxiseNo.VirAxisName.VirMain].Status.NotMoving  THEN
		DT_SingeMode();//单步选择			
		DP_Step1:=100;
		Ca_StandbyStep5:=620;
	END_IF		

620:		
	IF DP_Step1=6666 THEN	
		//Ca_StandbyStep0:=1000;	
		Ca_StandbyStep5:=6666;
	END_IF;		

END_CASE



]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_StandbySub1" Id="{4f4328f4-d662-4184-bb9d-e603c3e02d99}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[

IF rCaUse[1].Q THEN
	iTest1:=iTest1+1;
END_IF
//Ca_Step0: INT;//负极搬运取流水线极片子程序		

IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下	
//负极搬运取流水线极片子程序		
CASE Ca_Step0 OF
10://判断负极搬运平移2是否在流水线取料位，负极搬运升降2上升至初始高度、负极叠片升降上升至初始高度
//判断负极流水线是否允许取极片

		
	IF  ABS(arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.fSetPos-arrAxisPar[AxiseNo.AxisName.CaCarryingLine2].arrTargetPoint[1])<0.5 THEN//20240505 CF
		IF (Mach_Control.Ca_b.Ca_CacheBeltDLOK OR Mach_Control.U.EmptyRunMode ) AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Enabled
		AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Enabled AND NOT Mach_Control.U.EmptyRunMode THEN
			Mach_Control.Ca_b.Ca_CacheBelting:=TRUE;//负极缓存取极片中
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF	
			Ca_TON[5].IN:=FALSE;			
			Ca_Step0:=40;	
		ELSIF  Mach_Control.U.EmptyRunMode THEN
			Mach_Control.Ca_b.Ca_CarryingFalg:=TRUE;//负极搬运真空吸盘有料标记置位
			Ca_Step0:=6666;
			//Ca_Step0:=10;	
		END_IF
	END_IF
END_CASE
END_IF

CASE Ca_Step0 OF
40://
	IF NOT DP_SinStepe  THEN
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bON:=FALSE;//负极搬运2真空开
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bOFF:=TRUE;//负极搬运2真空开
		
		//arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuum].Cmd.bOFF:=TRUE;//负极缓存皮带末端真空关闭
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed (*AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving *) AND NOT
			 arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[2] THEN
					IF NOT Ca_TON[5].Q THEN
							Ca_TON[5].IN:=TRUE;
					ELSE
						//arrCyCtrl[arrCyNo.ElectValveName.CaLoadUpBeltVacuumBark].Cmd.bON:=TRUE;//负极缓存皮带末端破真空打开
						arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=0;
						Mach_Control.Ca_b.Ca_CarryingFalg:=TRUE;//负极搬运真空吸盘有料标记置位	
						Par.stDT_date.Ca_MQ_Slice[7]:=Par.stDT_date.Ca_MQ_Slice[6];						
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF		
						Ca_TON[5].IN:=FALSE;				
						Ca_Step0:=50;											
					END_IF								
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=2;//负极搬运升降2下降至取极片高度
				END_IF
		END_IF	
	END_IF	
50://负极搬运升降2上升至，凸轮耦合初始高度
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fActPos<= arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown2].arrTargetPoint[2]-5 THEN
		Mach_Control.Ca_b.Ca_CacheBelting:=FALSE;//负极缓存取极片中
	       Par.stDT_date.Ca_betlCount.5:=FALSE;//复位负极流水线极片标记   
	END_IF

	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving AND 
	NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Error THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=0;
			 
			Ca_Step0:=6666;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=4;//负极搬运升降2上升至凸轮耦合初始高度
		END_IF
	END_IF
		
	
		
		
END_CASE





]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_StandbySub2" Id="{561ff454-85f5-4b95-bf0f-029c8a638310}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[
//	Ca_Step1: INT;//负极极搬运放极片至纠偏平台
IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下	
//负极放片到纠偏台
	CASE Ca_Step1 OF

10://判断负极搬运平移2是否在初始位，负极搬运升降2上升至初始高度、负极叠片升降上升至初始高度
	IF  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Enabled  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Enabled THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[2]  THEN
			Ca_Step1:=30;
		END_IF
	END_IF
30://判断纠偏平台是否允许房极片
	IF NOT DP_SinStepe THEN
	DT_SingeMode();//单步选择			
	IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[3] THEN
		 arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=0;
		 /// 吸盘破真空    纠偏台开真空
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bON:=TRUE;//负极搬运2真空破
		arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2]	.Cmd.bOFF:=FALSE;//负极搬运2真空破
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;//负极纠偏平台真空打开
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;//负极纠偏平台真空打开
		Ca_Step1:=40;
	ELSE
		arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=3;//负极搬运升降2上升至凸轮耦合初始高度
	END_IF	
	END_IF
40:		
	IF NOT DP_SinStepe THEN
		IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] THEN
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=0;
			//搬运吸盘关真空和破真空
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bOFF:=TRUE;//负极搬运2真空开
			arrCyCtrl[arrCyNo.ElectValveName.CaCarryingVacuum2].Cmd.bON:=FALSE;//负极搬运2真空开
			//IF Mach_Control.Ca_b.Ca_CarryingFalg THEN
				Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//复位纠偏平台有料标记
				Mach_Control.Ca_b.Ca_CarryingFalg:=FALSE;//负极搬运真空吸盘有料标记复位
			//END_IF
			Par.stDT_date.Ca_MQ_Slice[8]:=Par.stDT_date.Ca_MQ_Slice[7];
			Ca_Step1:=6666;
		ELSE
			arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.iGoSetPos:=4;//负极搬运升降2上升至凸轮耦合初始高度
		END_IF			
	END_IF
		
END_CASE
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_StandbySub3" Id="{fd628cbd-ef68-436e-82fb-4dc680cae540}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[	Ca_StandbySub3_ton[1](PT:=T#300MS);
	Ca_StandbySub3_ton[2](PT:=T#250MS);
    Ca_StandbySub3_ton[3](PT:=T#300MS);
    Ca_NG_TON(IN:= , PT:=T#0.3S , Q=> , ET=> );
	Ca_NG_TON2(IN:= , PT:=T#0.3S , Q=> , ET=> );
    Ca_YS(IN:= , PT:=T#500MS , Q=> , ET=> );
    Ca_YS1(IN:= , PT:=T#200MS , Q=> , ET=> );

//	Ca_Step2: INT;//负极叠片搬运踢料子程序

IF Mach_Control.U.DT_iMode=1 OR avg1 THEN//在自动状态下	
//负极叠片搬运踢料子程序
CASE  Ca_Step2 OF
	10:
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Enabled THEN
			 IF  arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Io.DIOnSwitch  THEN
				  Ca_Step2:=12;
			 ELSE
				//Mach_Control.Ca_b.Error[6]:=TRUE;//负极叠台搬运升降有极片，无真空信号报警
				Ca_StandbySub3_ton[3].IN:=FALSE;
				Ca_Step2:=11; 
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运升降真空破
				arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运升降真空破		  
			 END_IF
	 	END_IF
    	11:	 
	  	Ca_StandbySub3_ton[3].IN:=TRUE;
		IF  Ca_StandbySub3_ton[3].Q THEN
			   Ca_Step2:=12; 
			   Ca_StandbySub3_ton[3].IN:=FALSE;
		END_IF
		
	12://负极搬运升降2上升至初始高度、负极叠片升降上升至避让高度
		IF NOT DP_SinStepe THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND
				 NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] THEN
						arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF							
						Ca_Step2:=20;
						//Ca_Step4:=1000;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=5;//负极叠片升降移动至避让高度
				END_IF
			END_IF
		END_IF
	20://负极叠片搬运平移在安全位、负极搬运平移2在安全位   Mach_Control.Ca_b.CarryingSafepos[0] 
		IF NOT DP_SinStepe THEN
			IF TailCurlSEPTA_SafePos  AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5]  AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND
				 arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] THEN
						arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.iGoSetPos:=0;
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF	
						Ca_Step2:=25;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.iGoSetPos:=1;//负极叠片平移至初始位
				END_IF
			END_IF
		END_IF
	

	25:
		//IF CCD.CaRec.Finish.RectifyResult<>1  THEN
		Ca_Step2:=30;
		//END_IF
		(*
		IF Mach_Control.Ca_b.Ca_Rectifydev_CS>=1 OR CCD.CaRec.Finish.RectifyResult=3 OR CCD.CaRec.Finish.RectifyResult=4  OR NOT Mach_Control.Ca_b.Ca_Rectifydev_PB  THEN
			Ca_Step2:=30;
		ELSE
			Ca_Step2:=150;	
		END_IF
		*)
	30:
		IF NOT DP_SinStepe THEN
			IF   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] THEN
					arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bON:=TRUE;//负极纠偏NG料盒气缸升降气缸上升
					arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;//负极纠偏NG料盒气缸伸出
			END_IF	
			IF 	arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState THEN
				IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
					DP_SinStepe:=TRUE;
				ELSE
					DP_SinStepe:=FALSE;	
				END_IF	
				Ca_Step2:=40;
			END_IF
		END_IF		
	40:
		IF NOT DP_SinStepe THEN
			IF   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] THEN
				arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bOFF:=TRUE;//负极纠偏NG料盒气缸收回
			END_IF		
					
			IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.OFFState AND Ca_NG_TON2.Q THEN
				IF NOT Ca_NG_TON.Q THEN
					Ca_NG_TON.IN:=TRUE;
					arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运升降真空破
					arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运升降真空破
					Mach_Control.Ca_b.Ca_DPCarryingFalg:=FALSE;//负极叠片真空吸盘有无料标记复位
				ELSE
					Ca_NG_TON.IN:=FALSE;
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF	
					Ca_Step2:=50;
					Ca_CCDNG:=Ca_CCDNG+1;
				END_IF
			ELSE
				Ca_NG_TON2.IN:=TRUE;
			END_IF
		END_IF
	50:
		IF NOT DP_SinStepe THEN
			IF   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] THEN
		       	arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;//负极纠偏NG料盒气缸伸出
			END_IF		
				
			Ca_NG_TON2.IN:=FALSE;
			IF arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState THEN
				arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;//负极纠偏NG料盒气缸升降气缸下降
				IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState THEN
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF	
					Ca_Step2:=60;
				END_IF
			END_IF	
		END_IF	
	60://负极纠偏NG料合伸出接料，负极叠片升降下降
		IF NOT DP_SinStepe THEN
			IF arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState AND  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState  AND   arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND 
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
						arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF						
						Ca_Step2:=70;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极叠片升降下降至等待位
				END_IF
			END_IF
		END_IF

	70:
	   IF HMI_Hour>=8 AND HMI_Hour<20 THEN
		  Par.stDT_date.Ca_Rectifydev_DayNG:=Par.stDT_date.Ca_Rectifydev_DayNG+1; 
	   END_IF
	
	   IF (HMI_Hour>=0 AND HMI_Hour<8) OR  (HMI_Hour>=20 AND HMI_Hour<=23) THEN
		 Par.stDT_date.Ca_Rectifydev_NightNG:=Par.stDT_date.Ca_Rectifydev_NightNG+1;
	   END_IF	
	
		Par.stDT_date.Ca_Rectifydev_JS:=Par.stDT_date.Ca_Rectifydev_JS+1;
		Mach_Control.Ca_b.Ca_CCD_amount:=Mach_Control.Ca_b.Ca_CCD_amount+1;
		Mach_Control.Ca_b.Ca_Rectifydev_CS:=0;
		Ca_StandbySub3_ton[1].IN:=FALSE;
		Ca_Step2:=80;

	80://触发拍照确认是否极片
		IF NOT Mach_Control.U.CCD_ChosesHMI  AND NOT  Mach_Control.U.EmptyRunMode AND
           Ca_OverNGStep=0	 THEN												
			CCD.CaRec.Finish.RectifyX1:=0;
			CCD.CaRec.Finish.RectifyX2:=0;
			CCD.CaRec.Finish.RectifyY:=0;		
			CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零									
			Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
			CCD.CaRec.Start.iPhotoDo:=1;//启动CCD第二次拍照
			Mach_Control.Ca_b.Ca_VacuumErrorNG:=FALSE;
			Ca_Step2:=90;
		ELSE
			Ca_Step2:=6666;
		END_IF
	90://判断拍照是否完成
		IF NOT Ca_StandbySub3_ton[1].Q THEN
			Ca_StandbySub3_ton[1].IN:=TRUE;
		ELSE
			IF CCD.CaRec.Finish.RectifyResult<>3 AND NOT Mach_Control.U.CCD_ChosesHMI   THEN
				Mach_Control.Ca_b.Error[24]:=TRUE;//负极纠偏平台NG片未排掉报警，请拿掉
				Ca_StandbySub3_ton[1].IN:=FALSE;
				Ca_Step2:=6666;
			ELSE
				Ca_StandbySub3_ton[1].IN:=FALSE;
				Ca_Step2:=6666;
			END_IF	
		END_IF	

	
	
	
	
/////////////////////////二次纠偏////////////////////////////
	150:
		IF arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1]  
		AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1]  THEN
			Ca_Step2:=160;
		END_IF
	
	160:
		IF NOT DP_SinStepe THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND
				NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF							
					Ca_Step2:=170;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=2;//负极叠片升降移动至取片位
				END_IF
			END_IF
		END_IF
	
	170:
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=TRUE;//负极叠片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=FALSE;//负极叠片搬运真空关
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=TRUE;//负极纠偏平台真空开		
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=FALSE;//负极纠偏平台真空开	
		//IF Mach_Control.Ca_b.Ca_deviationFalg THEN	
			Mach_Control.Ca_b.Ca_DPCarryingFalg :=FALSE;//复位负极叠片搬运吸盘上有料标记
			Mach_Control.Ca_b.Ca_deviationFalg:=TRUE;//置位纠偏平台上有料标记
		//END_IF
		Ca_Step2:=180;
			
			
	180:
		IF NOT DP_SinStepe THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND
				 NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF							
					Ca_Step2:=190;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极叠片升降移动至取片高度
				END_IF
			END_IF
		END_IF

	190:
		Ca_YS.IN:=TRUE;
		IF 	 (Mach_Control.Ca_b.RectifydevDone OR CCD.CaRec.Finish.RectifyResult=2 OR CCD.CaRec.Finish.RectifyResult=3 OR CCD.CaRec.Finish.RectifyResult=4 ) AND Ca_YS.Q  THEN
			Mach_Control.Ca_b.Ca_Rectifydev_CS:=Mach_Control.Ca_b.Ca_Rectifydev_CS+1;
			Ca_Step2:=200;
			Ca_YS.IN:=FALSE;
		END_IF
	
	200:
		IF NOT DP_SinStepe THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND
				 NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[2] THEN
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF							
					Ca_Step2:=210;
					IF Mach_Control.DT_b.DT_CCD_TwoModel THEN
						CCD.CaRec.Finish.RectifyX1:=0;
						CCD.CaRec.Finish.RectifyX2:=0;
						CCD.CaRec.Finish.RectifyY:=0;		
						CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零									
						Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
						CCD.CaRec.Start.iPhotoDo:=2;//启动CCD第二次拍照
					END_IF
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=2;//负极叠片升降移动至取片位
				END_IF
			END_IF
		END_IF
			
	210:
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运真空开
		arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运真空开
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=TRUE;//负极纠偏平台真空关	
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=FALSE;//负极纠偏平台真空关	
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bON:=TRUE;//负极纠偏平台破真空开	
		arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bOFF:=FALSE;//负极纠偏平台破真空开	
		//IF Mach_Control.Ca_b.Ca_deviationFalg THEN
			Mach_Control.Ca_b.Ca_DPCarryingFalg :=TRUE;//叠片搬运吸盘上有料标记
			Mach_Control.Ca_b.Ca_deviationFalg:=FALSE;//纠偏平台上有料标记
		//END_IF
		Ca_YS1.IN:=TRUE;
		IF Ca_YS1.Q THEN
			Ca_Step2:=220;
			Ca_YS1.IN:=FALSE;
		END_IF	
			
	220:
		IF NOT DP_SinStepe THEN
			IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND
				 NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
						arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF							
						Ca_Step2:=6666;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极叠片升降移动至取片位
				END_IF
			END_IF
		END_IF	
					
END_CASE
END_IF





]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_StandbySub4" Id="{79f10142-8ee5-4a97-ac00-b155c7866751}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[IF Mach_Control.U.DT_iMode=1 THEN//在自动状态下	
//Ca_Step3-----负极叠片搬运取纠偏位极片
CASE Ca_Step3 OF
	10:
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Enabled  THEN
			arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bON:=TRUE;//负极纠偏NG料盒气缸伸出
			IF arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState THEN
				arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Cmd.bOFF:=TRUE;//负极纠偏NG料盒气缸升降气缸下降
				IF  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Status.OFFState THEN
					Ca_Step3:=11;
				END_IF
			END_IF	
		END_IF
	11://判断负极搬运平移2是否在初始位，负极搬运升降2上升至初始高度、负极叠片升降上升至初始高度
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] THEN
			IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
				DP_SinStepe:=TRUE;
			ELSE
				DP_SinStepe:=FALSE;	
			END_IF			
			Ca_Step3:=30;
		ELSE
			IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND
				NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF								
					Ca_Step3:=20;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极叠片升降移动至等待高度
				END_IF
			END_IF
		END_IF
	20://负极叠片搬运平移至初始位，负极搬运在安全位
		//IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.fActPos < (arrAxisPar[AxiseNo.AxisName.CaDTCarryingLine].arrTargetPoint[2]-180) THEN
			//arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Cmd.bON:=TRUE;//负极纠偏平台除尘
			//arrCyCtrl[arrCyNo.ElectValveName.CadeviationIonizedWind].Cmd.bOFF:=FALSE;//负极纠偏平台除尘
		//END_IF	
		IF NOT DP_SinStepe THEN
			//arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bOFF:=TRUE;//负极纠偏NG料盒气缸收回   Mach_Control.Ca_b.CarryingSafepos[0] 
			IF TailCurlSEPTA_SafePos AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Error (*AND NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Error AND
				arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.fActPos < arrAxisPar[AxiseNo.AxisName.CaCarryingLine2].arrTargetPoint[2]*)    THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] THEN
					Ca_DTCarryingTorMark:=FALSE;//负极叠台搬运平移力矩判断标志位
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.iGoSetPos:=0;
					IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
						DP_SinStepe:=TRUE;
					ELSE
						DP_SinStepe:=FALSE;	
					END_IF					
					Ca_Step3:=30;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.iGoSetPos:=1;//负极叠片平移至初始位
					Ca_DTCarryingTorMark:=TRUE;//负极叠台搬运平移力矩判断标志位
				END_IF
			END_IF
		END_IF
	30://判断纠偏平台是否允许取极片
		IF NOT DP_SinStepe THEN
			IF 	Mach_Control.Ca_b.Ca_deviationDPOK OR Mach_Control.U.EmptyRunMode  THEN
				IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
					DP_SinStepe:=TRUE;
				ELSE
					DP_SinStepe:=FALSE;	
				END_IF			
				IF Mach_Control.DT_b.DT_CCD_TwoModel THEN
					CCD.CaRec.Finish.RectifyX1:=0;
					CCD.CaRec.Finish.RectifyX2:=0;
					CCD.CaRec.Finish.RectifyY:=0;		
					CCD.CaRec.Finish.RectifyResult:=0;//拍照结果清零									
					Mach_Control.Ca_b.Ca_CCDStart :=TRUE;//启动CCD拍照
					CCD.CaRec.Start.iPhotoDo:=2;//启动CCD第二次拍照
				END_IF		
				Ca_TON[7].IN:=FALSE;
				Ca_Step3:=40;
			END_IF
		END_IF
	
END_CASE
END_IF



CASE Ca_Step3 OF

	40://AND  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Io.DIOFFSwitch  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Io.DIOFFSwitch AND						
		IF NOT DP_SinStepe THEN
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bON:=FALSE;//负极叠片搬运升降真空开
			arrCyCtrl[arrCyNo.ElectValveName.CaDTCarryingVacuum].Cmd.bOFF:=TRUE;//负极叠片搬运升降真空开
	
			//arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Cmd.bOFF:=TRUE;//负极纠偏NG料盒气缸收回
			IF  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND 
				arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[2] AND arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Status.ONState THEN
					arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bOFF:=TRUE;//负极纠偏平台真空关闭
					arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuum].Cmd.bON:=FALSE;//负极纠偏平台真空关闭
					arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bON:=TRUE;//负极纠偏平台破真空打开	
					arrCyCtrl[arrCyNo.ElectValveName.CadeviationVacuumBark].Cmd.bOFF:=FALSE;//负极纠偏平台破真空打开		
					//IF Mach_Control.Ca_b.Ca_deviationFalg THEN
						Mach_Control.Ca_b.Ca_DPCarryingFalg:=TRUE;//置位叠片真空吸盘有料标记	
						Mach_Control.Ca_b.Ca_deviationFalg:=FALSE;//复位纠偏平台有料标记			
					//END_IF
					Par.stDT_date.Ca_MQ_Slice[9]:=Par.stDT_date.Ca_MQ_Slice[8];											
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;									
					IF NOT Ca_TON[7].Q THEN
						Ca_TON[7].IN:=TRUE;
					ELSE
						IF Mach_Control.DT_b.SinStepMode THEN//单步调试模式
							DP_SinStepe:=TRUE;
						ELSE
							DP_SinStepe:=FALSE;	
						END_IF			
						Ca_TON[7].IN:=FALSE;
						Ca_Step3:=50;												
					END_IF												
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=2;//负极叠片升降下降至取纠偏极片高度
				END_IF
			END_IF	
		END_IF
	50://负极叠片搬运升降上升至凸轮耦合初始位
		IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND 
			NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Error THEN
				IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[4] THEN
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=0;
					Ca_Step3:=6666;
				ELSE
					arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.iGoSetPos:=4;//负极叠片升降移动至初始高度
				END_IF
		END_IF		
END_CASE		]]></ST>
      </Implementation>
    </Action>
    <Action Name="Code" Id="{515ea84f-8fc1-434d-bd0b-83904bbd50b6}" FolderPath="05StickGlue \">
      <Implementation>
        <ST><![CDATA[(*
 TJ_Scan_M(CLK:=Mach_Control.TJ_b.Scan_CT , Q=> );
 CASE scan_Step OF
	0:
		IF TJ_Scan_M.Q THEN
			scan_Step:=5;
		END_IF
	5:
		 Mach_Control.TJ_b.Scan_Men[4]:=Mach_Control.TJ_b.Scan_Men[3];
		 scan_Step:=10;
	 
	10:
		Mach_Control.TJ_b.Scan_Men[3]:=Mach_Control.TJ_b.Scan_Men[2];
	 	scan_Step:=20;
	 
	 20:
	 	Mach_Control.TJ_b.Scan_Men[2]:=Mach_Control.TJ_b.Scan_Men[1];
	 	scan_Step:=30;
	 
	 30:
	 		Mach_Control.TJ_b.Scan_Men[1].Scan_gross:=Mach_Control.TJ_b.Scan_gross;
	 		Mach_Control.TJ_b.Scan_Men[1].TJ_Code:=Mach_Control.TJ_b.strCode;
	 		scan_Step:=0;
	 
	 
 END_CASE
 *)]]></ST>
      </Implementation>
    </Action>
    <Action Name="Dietai_Cam" Id="{3aebf957-211f-422b-b84f-4824064d2ed7}" FolderPath="03DietaiAuto\">
      <Implementation>
        <ST><![CDATA[DT_Cam_ton[1](PT:=T#100MS);
DT_Cam_ton[2](PT:=T#100MS);
DT_Cam_ton[3](PT:=T#100MS);
DT_Cam_ton[4](PT:=T#100MS);
DT_Cam_ton[5](PT:=T#100MS);
DT_Cam_ton[5](PT:=T#100MS);//
(***********************************压刀凸轮表创建************************************************)
(*
    fbCrectCamLeftYDLine                   :FB_CrectCamYaDaoLine ;
     fbCrectCamLeftYDUpDown             :FB_CrectCamYaDaoUpDown ;
     fbCrectCamRightYDLine                 :FB_CrectCamYaDaoLine ;
     fbCrectCamRightYDUpDown           :FB_CrectCamYaDaoUpDown ;
*)
//左压刀升降凸轮创建 
//fbCrectCamLeftYDUpDown.fMoveLength:=-ABS(arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[2]);
//fbCrectCamLeftYDUpDown.fSaveLength1:=-ABS(arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[3]);
fbCrectCamLeftYDUpDown.fMoveLength:=-ABS(arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[11]+arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[13]);
fbCrectCamLeftYDUpDown.fSaveLength1:=-ABS(arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[12]+arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[13]);
fbCrectCamLeftYDUpDown.fSaveLength2:=-3;

fbCrectCamLeftYDUpDown(
	bCreatTable:=                       fbCrectCamLeftYDUpDown.bCreatTable , 
	Reset:=                                 stSysState.bReset  ,  
	iTable:=                                TableNo.M_LeftYDUpDown  , 
	fMoveLength:=  , //压刀升降最大高度
	fSaveLength1:= , //压刀抽刀高度
	fSaveLength2:= , //压刀下压高度
	fMasterKeyPos1:=240 , //220 240
	fMasterKeyPos2:=258 , //234 250
	fMasterKeyPos3:=275 , //252 255
	fMasterKeyPos4:=307 , //300
	//fMasterKeyPos5:=313 , //330
	fMasterKeyPos6:=342 , //342
    axisMaster:=                          arrAxis[AxiseNo.VirAxisName.VirMain] ,   
	axisSlave:=                             arrAxis[AxiseNo.AxisName.LeftYDUpDown] ,  
	
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
fbCrectCamLeftYDUpDown.bCreatTableDone;
fbCrectCamLeftYDUpDown.bCreatTableError;
fbCrectCamLeftYDUpDown.bError;

//左压刀开合凸轮创建
//fbCrectCamLeftYDLine.fMoveLength:=-ABS(arrAxisPar[AxiseNo.AxisName.LeftYDLine].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.LeftYDLine].arrTargetPoint[2]);
fbCrectCamLeftYDLine.fMoveLength:=-ABS(arrAxisPar[AxiseNo.AxisName.LeftYDLine].arrTargetPoint[11]);
fbCrectCamLeftYDLine.fMoveLength2:=-ABS(arrAxisPar[AxiseNo.AxisName.LeftYDLine].arrTargetPoint[12]);	
fbCrectCamLeftYDLine(
	bCreatTable:=                         fbCrectCamLeftYDLine.bCreatTable , 
	Reset:=                                   stSysState.bReset  ,  
	iTable:=                                   TableNo.M_LeftYDLine  , 
	fMoveLength:= , 
	fMasterKeyPos1:=260 , //234  250
	fMasterKeyPos4:=40 , //234  250
	fMasterKeyPos2:=293 , //290
	fMasterKeyPos3:=328 , //324
	axisMaster:=                       arrAxis[AxiseNo.VirAxisName.VirMain] ,   
    axisSlave:=                          arrAxis[AxiseNo.AxisName.LeftYDLine] ,  
	bCreatTableDone=>  , 
	bCreatTableError=> , 
	bError=> );
fbCrectCamLeftYDLine.bCreatTableDone;
fbCrectCamLeftYDLine.bCreatTableError;
fbCrectCamLeftYDLine.bError;

//右压刀开合
//fbCrectCamRightYDLine.fMoveLength:=-ABS(arrAxisPar[AxiseNo.AxisName.RightYDLine].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.RightYDLine].arrTargetPoint[2]);
fbCrectCamRightYDLine.fMoveLength:=-ABS(arrAxisPar[AxiseNo.AxisName.RightYDLine].arrTargetPoint[11]);
fbCrectCamRightYDLine.fMoveLength2:=-ABS(arrAxisPar[AxiseNo.AxisName.RightYDLine].arrTargetPoint[12]);
fbCrectCamRightYDLine(
	bCreatTable:=                         fbCrectCamRightYDLine.bCreatTable , 
	Reset:=                                   stSysState.bReset  ,  
	iTable:=                                   TableNo.M_RightYDLine  , 
	fMoveLength:= , 

	fMasterKeyPos1:=260 , //234  250
	fMasterKeyPos4:=40 , //234  250
	fMasterKeyPos2:=293 ,//290
	fMasterKeyPos3:=328 , //324

	axisMaster:=                       arrAxis[AxiseNo.VirAxisName.VirMain] ,   
    axisSlave:=                          arrAxis[AxiseNo.AxisName.RightYDLine] ,  
	bCreatTableDone=>  , 
	bCreatTableError=> , 
	bError=> );
fbCrectCamRightYDLine.bCreatTableDone;
fbCrectCamRightYDLine.bCreatTableError;
fbCrectCamRightYDLine.bError;

//右压刀升降凸轮创建
//fbCrectCamRightYDUpDown.fMoveLength:=-ABS(arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[2]);
//fbCrectCamRightYDUpDown.fSaveLength1:=-ABS(arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[3]);
fbCrectCamRightYDUpDown.fMoveLength:=-ABS(arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[11]+arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[13]);
fbCrectCamRightYDUpDown.fSaveLength1:=-ABS(arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[12]+arrAxisPar[AxiseNo.AxisName.RightYDUpDown].arrTargetPoint[13]);	
fbCrectCamRightYDUpDown.fSaveLength2:=-3;
fbCrectCamRightYDUpDown(
	bCreatTable:=                       fbCrectCamRightYDUpDown.bCreatTable , 
	Reset:=                                 stSysState.bReset  ,  
	iTable:=                                TableNo.M_RightYDUpDown  , 
	fMoveLength:= , 
	fSaveLength1:= , 
	fSaveLength2:= ,
	fMasterKeyPos1:=240 , //220 240
	fMasterKeyPos2:=258 , //234 250
	fMasterKeyPos3:=275 , //252 255
	fMasterKeyPos4:=307 , //300
	//fMasterKeyPos5:=313 , //330
	fMasterKeyPos6:=342 , //342
    axisMaster:=                          arrAxis[AxiseNo.VirAxisName.VirMain] ,   
	axisSlave:=                             arrAxis[AxiseNo.AxisName.RightYDUpDown] ,  
	
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
fbCrectCamRightYDUpDown.bCreatTableDone;
fbCrectCamRightYDUpDown.bCreatTableError;
fbCrectCamRightYDUpDown.bError;


//左压刀升降凸轮创建 2
fbCrectCamLeftYDUpDown2.fMoveLength:=-ABS(arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[11]+arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[13]);
fbCrectCamLeftYDUpDown2.fSaveLength1:=-ABS(arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[11]+arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[13]);
fbCrectCamLeftYDUpDown2.fSaveLength2:=ABS(arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[12]+arrAxisPar[AxiseNo.AxisName.LeftYDUpDown].arrTargetPoint[13]);
fbCrectCamLeftYDUpDown2(
	bCreatTable:=                       fbCrectCamLeftYDUpDown2.bCreatTable , 
	Reset:=                                 stSysState.bReset  ,  
	iTable:=                                TableNo.M_LeftYDUpDown2  , 
	fMoveLength:=  , //压刀升降最大高度
	fSaveLength1:= , //压刀抽刀高度
	fSaveLength2:= , //
	fMasterKeyPos1:=260 , //240
	fMasterKeyPos2:=300 , //234 250
	fMasterKeyPos3:=301 , //252 255
	fMasterKeyPos4:=302 , //300
//	fMasterKeyPos5:=342 , //300
    fMasterKeyPos6:=342 , //342
    axisMaster:=                          arrAxis[AxiseNo.VirAxisName.VirMain] ,   
	axisSlave:=                             arrAxis[AxiseNo.AxisName.LeftYDUpDown] ,  
	
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
fbCrectCamLeftYDUpDown2.bCreatTableDone;
fbCrectCamLeftYDUpDown2.bCreatTableError;
fbCrectCamLeftYDUpDown.bError;

//左压刀开合凸轮创建2

fbCrectCamLeftYDLine2.fMoveLength:=ABS(arrAxisPar[AxiseNo.AxisName.LeftYDLine].arrTargetPoint[1]-arrAxisPar[AxiseNo.AxisName.LeftYDLine].arrTargetPoint[2]);
fbCrectCamLeftYDLine2(
	bCreatTable:=                         fbCrectCamLeftYDLine2.bCreatTable , 
