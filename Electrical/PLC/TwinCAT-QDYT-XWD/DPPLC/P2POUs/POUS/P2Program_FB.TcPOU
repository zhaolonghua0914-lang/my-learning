		 fbAnCamInDTCarryingLine.bInSync AND ((fbAnCamInDTCarryingUpDown.bInSync AND  iAnCamInSel2=1 ) OR  (iAnCamInSel2=2 AND fbAnCamInDTCarryingUpDown.bInSync ) )AND
