	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.GoPoint_Condition[3]:=FALSE;	
