    	  arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1]  ) 
 AND  ( (  arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[1] OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[5] OR arrAxisCtrl[P3AxisNo.P3M1_ColdpreWhirling].Cmd.arrbRealPoint[6] ) OR
                    arrAxisCtrl[P3AxisNo.P3M1_ColdpreRetracting].Cmd.arrbRealPoint[1] )
 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.GoPoint_Condition[6]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.GoPoint_Condition[6]:=FALSE;	
END_IF
*)









//侧贴胶进退
IF  Mach_Control.U.WJ_iMode=3   
 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.Home_Condition:=TRUE;
ELSE
