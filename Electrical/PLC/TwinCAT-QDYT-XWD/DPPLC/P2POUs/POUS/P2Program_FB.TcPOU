fbCaCrectCamDTCarryingLine.bError;



(**********20240528SJ***************)
arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[10]:=6; //等待高度  参数可调
arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[11]:=18; //抬升高度  参数可调
arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[4]:=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[3]-arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[10];  //等待位置    以放片位为基准
//arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[1]:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[3]-arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[11];  //安全位置

//负极叠片搬运升降取片凸轮创建
fbCaCrectCamDTCarryingUpDown(//取片
	bCreatTable:=                         fbCaCrectCamDTCarryingUpDown.bCreatTable , 
	Reset:=                                  stSysState.bReset  ,  
	iTable:=                                   TableNo.M_CaDTCarryingUpDown   , 
	fMoveLength:=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[10]-(arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[3]-arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[2])               ,//取片高度
	fSaveLength:=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[10]-arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[11]              , //安全位
	//fInitLength:=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[4],//升降轴耦合初始位
	fMasterKeyPos1:=125 , //
	fMasterKeyPos2:=250 , //
	fMasterKeyPos3:=260 , //
	fMasterKeyPos4:= 320, //
	fMasterKeyPos5:=359 , //
	fMasterKeyPos6:= , //
	fSlaveVelo:=0.25 , //
	
    axisMaster:=                        arrAxis[AxiseNo.VirAxisName.VirMain] ,   
	axisSlave:=                           arrAxis[AxiseNo.AxisName.CaDTCarryingUpDown] ,  

	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
fbCaCrectCamDTCarryingUpDown.bCreatTableDone;
fbCaCrectCamDTCarryingUpDown.bCreatTableError;
fbCaCrectCamDTCarryingUpDown.bError;


//负极叠片搬运升降放片凸轮创建
IF  DP_Step0>3000 AND DP_Step0<=3080 THEN
     fbCaCrectCamDTCarryingUpDown1.iTableSel:=2;
ELSE	 
	 fbCaCrectCamDTCarryingUpDown1.iTableSel:=1;
END_IF		 

fbCaCrectCamDTCarryingUpDown1(//放片
	bCreatTable:=                         fbCaCrectCamDTCarryingUpDown1.bCreatTable , 
	Reset:=                                   stSysState.bReset  ,  
	iTable:=                                   TableNo.M_CaDTCarryingUpDown1   , 
	bCamIn:=  fbCaCamInDTCarryingUpDown.bCamInExecute AND  fbCaCamInDTCarryingUpDown.iTableSel=2    , 
	fMoveLength:=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[10] , //取片高度
	fSaveLength:=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[10]-arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[11]  , //安全高度
	//fInitLength:=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[4] ,//升降轴耦合初始位
	fMasterKeyPos1:=120 , //208
	fMasterKeyPos2:=250 , //256
	fMasterKeyPos3:=260 , //256
	fMasterKeyPos4:=342 , //328
	fMasterKeyPos5:=359 , //328
	fSlaveVelo:=0.25 , //
    axisMaster:=                        arrAxis[AxiseNo.VirAxisName.VirMain] ,   
	axisSlave:=                           arrAxis[AxiseNo.AxisName.CaDTCarryingUpDown] ,  

	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
fbCaCrectCamDTCarryingUpDown1.bCreatTableDone;
fbCaCrectCamDTCarryingUpDown1.bCreatTableError;
fbCaCrectCamDTCarryingUpDown1.bError;


//正极叠片搬运升降避让凸轮创建
fbCaCrectCamDTCarryingUpDown3(//放片
	bCreatTable:=fbCaCrectCamDTCarryingUpDown3.bCreatTable, 
	Reset:=stSysState.bReset  , 
	iTable:=TableNo.M_CaDTCarryingUpDown3 , 
	//fMoveLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[10] ,//放片高度 
	fSaveLength:=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[10]-arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[11]  , //安全高度
	//fInitLength:=arrAxisPar[AxiseNo.AxisName.AnDTCarryingUpDown].arrTargetPoint[4],//升降轴耦合初始位
	fMasterKeyPos1:=130 , //208
	fMasterKeyPos2:=260 , //256
	//fMasterKeyPos3:=260 , //256
	//fMasterKeyPos4:=342 , //328
//	fMasterKeyPos5:=359 , //328
//	fSlaveVelo:=0.25 , //
	axisSlave:=arrAxis[AxiseNo.AxisName.CaDTCarryingUpDown]  , 
	axisMaster:=arrAxis[AxiseNo.VirAxisName.VirMain]  , 
	bCreatTableDone=> , 
	bCreatTableError=> , 
	bError=> );
	
fbCaCrectCamDTCarryingUpDown3.bCreatTableDone;
fbCaCrectCamDTCarryingUpDown3.bCreatTableError;
fbCaCrectCamDTCarryingUpDown3.bError;











tCaCreate_TON(IN:= , PT:=T#0.5S , Q=> , ET=> );
IF Mach_Control.U.DT_iMode=3 OR Mach_Control.U.DT_iMode=0 THEN//在手动状态下
				//在触摸屏上生成凸轮
				//rCaCreate_TRIG(CLK:=Mach_Control.Ca_b.CreateCamStart , Q=> );	
				rCaCreate_TRIG(CLK:=(Mach_Control.Ca_b.CreateCamStart 
                                    AND	NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Coupled
									AND	NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Coupled
									AND	NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Coupled
									AND	NOT arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Coupled), Q=> );				
				IF rCaCreate_TRIG.Q THEN
					tCaCreate_TON.IN:=FALSE;
					CaCrectCamStep0:=10;
					Mach_Control.Ca_b.Error[0]:=FALSE;
				END_IF
END_IF
				//负极取料凸轮自动创建
				CASE CaCrectCamStep0 OF
						10:
								IF NOT tCaCreate_TON.Q THEN
										//fbCaCrectCamCarryingLine1.bCreatTable :=TRUE;//负极取流水线平移凸轮创建
										//fbCaCrectCamCarryingUpDown1.bCreatTable:=TRUE;//负极取流水线放片升降凸轮创建
										//fbCaCrectCamCarryingUpDown1_1.bCreatTable:=TRUE;//负极取流水线取片升降凸轮创建
										//fbCaCrectCamCarryingWhirling.bCreatTable:=TRUE;//负极取流水线旋转凸轮创建
										 fbCaCrectCamCarryingLine2.bCreatTable :=FALSE;//负极送片搬运平移凸轮创建
										 fbCaCrectCamCarryingUpDown2.bCreatTable:=FALSE;//负极送片搬运升降取片凸轮创建
										 fbCaCrectCamCarryingUpDown2_1.bCreatTable:=FALSE;//负极送片搬运升降放片凸轮创建
										 fbCaCrectCamCarryingUpDown2_3.bCreatTable:=FALSE;//负极送片搬运升降放片凸轮创建
										 fbCaCrectCamDTCarryingLine.bCreatTable :=FALSE;//负极叠片搬运平移凸轮创建
										 fbCaCrectCamDTCarryingUpDown.bCreatTable:=FALSE;//负极叠片搬运升降取片凸轮创建
										 fbCaCrectCamDTCarryingUpDown1.bCreatTable:=FALSE;//负极叠片搬运升降放片凸轮创建
										  fbCaCrectCamDTCarryingUpDown3.bCreatTable:=FALSE;//负极叠片搬运升降放片凸轮创建
										 Mach_Control.Ca_b.CreateCamDone:=FALSE;
										 tCaCreate_TON.IN:=TRUE;					
								ELSE
											tCaCreate_TON.IN:=FALSE;	
											CaCrectCamStep0:=11;
								END_IF
								
						11:	
								IF  NOT Ca_Cam_ton[1].Q THEN
									arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bStop:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bStop:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bStop:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bStop:=TRUE;
									Ca_Cam_ton[1].IN:=TRUE;
								ELSE
									Ca_Cam_ton[1].IN:=FALSE;
									CaCrectCamStep0:=12;
									arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bStop:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bStop:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bStop:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bStop:=FALSE;
								END_IF
								
						12:
								IF  NOT Ca_Cam_ton[2].Q THEN
									arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bReset:=TRUE;	
									arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bReset:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bReset:=TRUE;
									arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bReset:=TRUE;
									Ca_Cam_ton[2].IN:=TRUE;
								 ELSE
									 Ca_Cam_ton[2].IN:=FALSE;
									 CaCrectCamStep0:=13;
									arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bReset:=FALSE;	
									arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bReset:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bReset:=FALSE;
									arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bReset:=FALSE;
								 END_IF
							

						13:
							arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.bEnable:=TRUE;
							arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.bEnable:=TRUE;
							arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.bEnable:=TRUE;
							arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.bEnable:=TRUE;
							IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Enabled AND
								arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Enabled AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Enabled THEN
								 CaCrectCamStep0:=20;
							END_IF
								
								
						20://凸轮创建
									//fbCaCrectCamCarryingLine1.bCreatTable :=TRUE;//负极取流水线平移凸轮创建
									//fbCaCrectCamCarryingUpDown1.bCreatTable:=TRUE;//负极取流水线放片升降凸轮创建
									//fbCaCrectCamCarryingUpDown1_1.bCreatTable:=TRUE;//负极取流水线取片升降凸轮创建
									//fbCaCrectCamCarryingWhirling.bCreatTable:=TRUE;//负极取流水线旋转凸轮创建
									 fbCaCrectCamCarryingLine2.bCreatTable :=TRUE;//负极送片搬运平移凸轮创建
									 fbCaCrectCamCarryingUpDown2.bCreatTable:=TRUE;//负极送片搬运升降取片凸轮创建
									 fbCaCrectCamCarryingUpDown2_1.bCreatTable:=TRUE;//负极送片搬运升降放片凸轮创建
									 fbCaCrectCamCarryingUpDown2_3.bCreatTable:=TRUE;//负极送片搬运升降放片凸轮创建
									 fbCaCrectCamDTCarryingLine.bCreatTable :=TRUE;//负极叠片搬运平移凸轮创建
									 fbCaCrectCamDTCarryingUpDown.bCreatTable:=TRUE;//负极叠片搬运升降取片凸轮创建
									 fbCaCrectCamDTCarryingUpDown1.bCreatTable:=TRUE;//负极叠片搬运升降放片凸轮创建
									  fbCaCrectCamDTCarryingUpDown3.bCreatTable:=TRUE;//负极叠片搬运升降放片凸轮创建
									 Mach_Control.Ca_b.CreateCamDone:=FALSE;
									 CaCrectCamStep0:=30;
						30://判断凸轮是否创建完成
									IF fbCaCrectCamCarryingLine2.bCreatTableDone AND  fbCaCrectCamCarryingUpDown2.bCreatTableDone AND  fbCaCrectCamCarryingUpDown2_1.bCreatTableDone  AND
										 fbCaCrectCamDTCarryingLine.bCreatTableDone AND fbCaCrectCamDTCarryingUpDown.bCreatTableDone AND fbCaCrectCamDTCarryingUpDown1.bCreatTableDone  AND
                                        fbCaCrectCamCarryingUpDown2_3.bCreatTableDone AND  fbCaCrectCamDTCarryingUpDown3.bCreatTableDone  THEN
											Mach_Control.Ca_b.CreateCamDone:=TRUE;
											CaCrectCamStep0:=6666;
									ELSE
											IF fbCaCrectCamCarryingLine2.bCreatTableError OR fbCaCrectCamCarryingUpDown2.bCreatTableError OR fbCaCrectCamCarryingUpDown2_1.bCreatTableError  OR 
												fbCaCrectCamDTCarryingLine.bCreatTableError OR fbCaCrectCamDTCarryingUpDown.bCreatTableError OR  fbCaCrectCamDTCarryingUpDown1.bCreatTableError OR 
                                          fbCaCrectCamCarryingUpDown2_3.bCreatTableError OR  fbCaCrectCamDTCarryingUpDown3.bCreatTableError    THEN								
												Mach_Control.Ca_b.Error[0]:=TRUE;//负极取片创建凸轮报警
												CaCrectCamStep0:=9999;
											END_IF
									END_IF
				END_CASE




(***********************************负极凸轮耦合***********************************************)
(*
      fbCaCamInCarryingLine1                      :FB_CamIn ;    
      fbCaCamInCarryingUpDown1               :FB_CamIn ;    
      fbCaCamInCarryingLine2                     :FB_CamIn ;    
      fbCaCamInCarryingUpDown2              :FB_CamIn ;    
      fbCaCamInDTCarryingLine                   :FB_CamIn ;    
      fbCaCamInDTCarryingUpDown            :FB_CamIn ;    
*)

//负极取流水线搬运平移凸轮耦合
fbCaCamInCarryingLine1.ParCamIn.SlaveScaling;
fbCaCamInCarryingLine1(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCaCamInCarryingLine1.bCamInExecute, 
	iTable1:=                   TableNo.M_CaCarryingLine1  , 
	iTable2:=                   , 
	iTableSel:=                 , 
	ParCamIn:= , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.CaCarryingVirGM] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.CaCarryingLine1] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

(*Mach_Control.Ca_b.Error[11]:=*)fbCaCamInCarryingLine1.bError;
fbCaCamInCarryingLine1.bReady;
fbCaCamInCarryingLine1.bInSync;

//负极取流水线搬运升降凸轮耦合
fbCaCamInCarryingUpDown1.iTableSel;
fbCaCamInCarryingUpDown1(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCaCamInCarryingUpDown1.bCamInExecute, 
	iTable1:=                   TableNo.M_CaCarryingUpDown1  , 
	iTable2:=                   TableNo.M_CaCarryingUpDown1_1 , 
	iTableSel:=                  , 
	ParCamIn:=                  , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.CaCarryingVirGM] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.CaCarryingUpDown1] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

(*Mach_Control.Ca_b.Error[12]:=*)fbCaCamInCarryingUpDown1.bError;
fbCaCamInCarryingUpDown1.bReady;
fbCaCamInCarryingUpDown1.bInSync;
//负极取流水线旋转
fbCaCamInCarryingWhirling.ParCamIn.SlaveScaling;
fbCaCamInCarryingWhirling(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCaCamInCarryingWhirling.bCamInExecute, 
	iTable1:=                   TableNo.M_CaCarryingWhirling1  , 
	iTable2:=                   , 
	iTableSel:=                 , 
	ParCamIn:= , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.CaCarryingVirGM] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.CaCarryingWhirling1] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

fbCaCamInCarryingWhirling.bError;
fbCaCamInCarryingWhirling.bReady;
fbCaCamInCarryingWhirling.bInSync;




//负极送片搬运平移凸轮耦合
fbCaCamInCarryingLine2.ParCamIn.SlaveScaling;
fbCaCamInCarryingLine2.ParCamIn.MasterScaling:=fCaScaling;//20240508 CF
fbCaCamInCarryingLine2(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCaCamInCarryingLine2.bCamInExecute, 
	iTable1:=                   TableNo.M_CaCarryingLine2  , 
	iTable2:=                   , 
	iTableSel:=                 , 
	ParCamIn:= , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.CaCarryingLine2] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );
(*Mach_Control.Ca_b.Error[13]:=*)fbCaCamInCarryingLine2.bError;
fbCaCamInCarryingLine2.bReady;
fbCaCamInCarryingLine2.bInSync;


//负极送纠偏搬动升降凸轮耦合
fbCaCamInCarryingUpDown2.ParCamIn.MasterScaling:=fCaScaling;//20240508 CF
fbCaCamInCarryingUpDown2(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCaCamInCarryingUpDown2.bCamInExecute, 
	iTable1:=                   TableNo.M_CaCarryingUpDown2  , 
	iTable2:=                   TableNo.M_CaCarryingUpDown2_1  , 
	iTable3:=                   TableNo.M_CaCarryingUpDown2_3  , 
	iTableSel:=                  , //耦合凸轮选择
	ParCamIn:=                  , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.CaCarryingUpDown2] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

(*Mach_Control.Ca_b.Error[14]:=*)fbCaCamInCarryingUpDown2.bError;
fbCaCamInCarryingUpDown2.bReady;
fbCaCamInCarryingUpDown2.bInSync;


//负极叠台搬运平移凸轮耦合
fbCaCamInDTCarryingLine.ParCamIn.SlaveScaling;
fbCaCamInDTCarryingLine(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCaCamInDTCarryingLine.bCamInExecute, 
	iTable1:=                   TableNo.M_CaDTCarryingLine  , 
	iTable2:=                   , 
	iTableSel:=                 , 
	ParCamIn:=                , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.CaDTCarryingLine] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );
(*Mach_Control.Ca_b.Error[15]:=*)fbCaCamInDTCarryingLine.bError;
fbCaCamInDTCarryingLine.bReady;
fbCaCamInDTCarryingLine.bInSync;


//负极叠台搬运升降凸轮耦合
fbCaCamInDTCarryingUpDown(
	Reset:=                      stSysState.bReset  , 
	bCamInExecute:=       fbCaCamInDTCarryingUpDown.bCamInExecute, 
	iTable1:=                   TableNo.M_CaDTCarryingUpDown  , 
	iTable2:=                    TableNo.M_CaDTCarryingUpDown1, 
	iTable3:=                    TableNo.M_CaDTCarryingUpDown3, 
	iTableSel:=                  , 
	ParCamIn:=                  , 
  	axisMaster:=            arrAxis[AxiseNo.VirAxisName.VirMain] ,  
	axisSlave:=               arrAxis[AxiseNo.AxisName.CaDTCarryingUpDown] ,  
	bError=> , 
	bReady=> , 
	bInSync=> );

(*Mach_Control.Ca_b.Error[16]:=*)fbCaCamInDTCarryingUpDown.bError;
fbCaCamInDTCarryingUpDown.bReady;
fbCaCamInDTCarryingUpDown.bInSync;


IF fbCaCamInCarryingLine1.bError OR fbCaCamInCarryingUpDown1.bError OR fbCaCamInCarryingLine2.bError OR fbCaCamInCarryingUpDown2.bError OR fbCaCamInDTCarryingLine.bError OR fbCaCamInDTCarryingUpDown.bError THEN
		Mach_Control.Ca_b.Error[11]:=TRUE;//负极藕合凸轮报警
	ELSE	
		Mach_Control.Ca_b.Error[11]:=FALSE;
END_IF
















]]></ST>
      </Implementation>
    </Action>
    <Action Name="Ca_Conditions" Id="{214fb6d6-8b05-4f82-b976-7070d6207382}" FolderPath="01Ca_StandbyAuto\">
      <Implementation>
        <ST><![CDATA[(********************负极放弃取片********************)
Mach_Control.Ca_b.JumpPiceReady:=Mach_Control.U.DT_iMode<>1 OR Mach_Control.Ca_b.Ca_SegbeltFalg OR Mach_Control.U.EmptyRunMode OR   (Mach_Control.DT_b.SinStepMode AND Ca_StandbyStep2<>35 AND Ca_StandbyStep2<>40);

(********************负极取片准备好********************)
Mach_Control.Ca_b.GetPiceReady:=NOT Mach_Control.Ca_b.JumpPiceReady AND
														arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND
														arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1];
(*
IF Mach_Control.U.DT_iMode=1 AND NOT Mach_Control.Ca_b.Ca_SegbeltFalg AND (DP_Step0<>6030 AND DP_Step0<>6040 AND 
Mach_Control.An_b.An_Quantited <= Par.stDT_date.An_Quantity  AND  Mach_Control.Ca_b.Ca_Quantited < Par.stDT_date.Ca_Quantity) AND
   arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND
   arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1] THEN
 		Mach_Control.Ca_b.GetPiceReady:=TRUE;
ELSE
 		Mach_Control.Ca_b.GetPiceReady:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode<>1 OR Mach_Control.Ca_b.Ca_SegbeltFalg OR JumpPiceReady_temp1 OR JumpPiceReady_temp2 OR JumpPiceReady_temp3 THEN
	Mach_Control.Ca_b.JumpPiceReady:=TRUE;
ELSE
	Mach_Control.Ca_b.JumpPiceReady:=FALSE;
END_IF
*)



//负极纠偏平台放极片允许
IF  NOT Mach_Control.Ca_b.Ca_deviationFalg AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed AND NOT arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Error AND 
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.arrbRealPoint[1] AND 
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Homed AND NOT arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.Error AND 
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.arrbRealPoint[1] AND 
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed AND NOT arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Error AND 
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.arrbRealPoint[1] THEN
	Mach_Control.Ca_b.Ca_deviationFPOK:=TRUE;
ELSE
	Mach_Control.Ca_b.Ca_deviationFPOK:=FALSE;	
END_IF

//负极搬运皮带取极片允许
IF  Par.stDT_date.Ca_betlCount.5 AND arrAxisCtrl[AxiseNo.AxisName.CaBelt].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaBelt].Status.Error THEN
	Mach_Control.Ca_b.Ca_CacheBeltDLOK:=TRUE;
ELSE
	Mach_Control.Ca_b.Ca_CacheBeltDLOK:=FALSE;	
END_IF



//负极搬运皮带放极片允许
IF NOT  Par.stDT_date.Ca_betlCount.0 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Error  THEN
	Mach_Control.Ca_b.Ca_CacheBeltFLOK:=TRUE;
ELSE
	Mach_Control.Ca_b.Ca_CacheBeltFLOK:=FALSE;
END_IF
//负极搬运升降1、负极搬运升降2允许负极流水线电机转动   根据实际情况修改 20240509 CF
IF ((arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fSetPos <= arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[3]-4
	  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed ) OR
	 (arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.fActPos < arrAxisPar[AxiseNo.AxisName.CaCarryingLine1].arrTargetPoint[2]-100  
	  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed ) ) AND
	 
	 ((arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fSetPos <= arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown2].arrTargetPoint[2]-4
	   AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed ) OR 
	   (arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.fActPos > arrAxisPar[AxiseNo.AxisName.CaCarryingLine2].arrTargetPoint[1]+225  
	     AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed ) ) THEN
	Mach_Control.Ca_b.Ca_betlMoveOK:=TRUE;
ELSE
	Mach_Control.Ca_b.Ca_betlMoveOK:=FALSE;	
END_IF


(*  南昌备份
IF ((arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fSetPos <= arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[1]+0.5)
	 OR arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1]) AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND
	 
	 ((arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fSetPos <= arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown2].arrTargetPoint[4]+0.5) 
	OR arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[2]) AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed  THEN
	Mach_Control.Ca_b.Ca_betlMoveOK:=TRUE;
ELSE
	Mach_Control.Ca_b.Ca_betlMoveOK:=FALSE;	
END_IF
*)


//负极搬运平移2在安全位,、负极叠片升降在安全位、尾卷夹隔膜平移在安全位、允许负极叠片搬运平移移动纠偏平台位
//arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.fActPos <= arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[1] 
IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1] AND
    arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND  TailCurlSEPTA_SafePos AND
 	 arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.fSetPos   <=arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[4]+0.1 THEN
	Mach_Control.Ca_b.CarryingSafepos[0]:=TRUE;
ELSE
	Mach_Control.Ca_b.CarryingSafepos[0]:=FALSE;	
END_IF
//隔膜平移在正极片位、负极叠片搬运升降在安全位，允许负极叠片搬运平移至叠片位
IF arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] AND 
    arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[1] AND
	arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.fSetPos <= arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[1]   THEN
	Mach_Control.Ca_b.CarryingSafepos[1]:=TRUE;
ELSE
	Mach_Control.Ca_b.CarryingSafepos[1]:=FALSE;
END_IF
//负极送片搬运升降2在安全位，允许负极送片搬运2平移至取流水线极片位
IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.NoMoving THEN
	Mach_Control.Ca_b.CarryingSafepos[2]:=TRUE;
ELSE
	Mach_Control.Ca_b.CarryingSafepos[2]:=FALSE;
END_IF
//负极送片搬运升降2在安全位、负极叠片搬运在安全位，允许负极送片搬运2平移至纠偏位
IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed  AND 
	arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[2]  THEN
	Mach_Control.Ca_b.CarryingSafepos[3]:=TRUE;
ELSE
	Mach_Control.Ca_b.CarryingSafepos[3]:=FALSE;
END_IF	
//负极送片搬运升降1在安全位，允许负极搬运平移1移动
IF  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.NoMoving THEN
	Mach_Control.Ca_b.CarryingSafepos[4]:=TRUE;
ELSE
	Mach_Control.Ca_b.CarryingSafepos[4]:=FALSE;
END_IF		 
//负极送片搬运安全位，负极叠片搬运安全位，尾卷夹隔膜平移，允许纠偏平台移动
IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed  AND 
	(arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fSetPos<=(arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown2].arrTargetPoint[4]+2) OR arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.arrbRealPoint[1]) AND 
    arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed  AND 
	(arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Status.fSetPos<=(arrAxisPar[AxiseNo.AxisName.CaDTCarryingUpDown].arrTargetPoint[4]+2) OR arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[2]) (*AND 
	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.fActPos<=arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[1]  *) THEN
	Mach_Control.Ca_b.CarryingSafepos[5]:=TRUE;
ELSE
	Mach_Control.Ca_b.CarryingSafepos[5]:=FALSE;
END_IF		
//负极取流水线机械手在安全位，允许模切流水线移动
(*
IF arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND NOT Mach_Control.Ca_b.Ca_MainBelting AND 
 	(arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[1]+0.2 OR 
	  arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.arrbRealPoint[1]	) THEN
	Mach_Control.Ca_b.Ca_BeltSafe:=TRUE;
ELSE
	Mach_Control.Ca_b.Ca_BeltSafe:=FALSE;
END_IF
*)
(*
IF  Mach_Control.Ca_b.Ca_MainBelting THEN
	Mach_Control.Ca_b.Ca_BeltSafe:=TRUE;
ELSIF NOT Mach_Control.Ca_b.Ca_MainBelting AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Cmd.arrbRealPoint[4] THEN
	Mach_Control.Ca_b.Ca_BeltSafe:=FALSE;
END_IF
*)
IF  Mach_Control.Ca_b.Ca_MainBelting THEN
	Mach_Control.Ca_b.Ca_BeltSafe:=TRUE;
ELSE
	Mach_Control.Ca_b.Ca_BeltSafe:=FALSE;
END_IF
//负极主流水线取片完成延时复位
Ca_BeltTon(IN:=Mach_Control.Ca_b.Ca_BeltDone , PT:=T#20MS , Q=> , ET=> );
IF Ca_BeltTon.Q THEN
	Mach_Control.Ca_b.Ca_BeltDone:=FALSE;//复位主流水线取片完成
END_IF




