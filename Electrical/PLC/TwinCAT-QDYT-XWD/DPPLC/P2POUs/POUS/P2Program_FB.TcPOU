IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.GoPoint_Condition[3]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.GoPoint_Condition[4]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.GoPoint_Condition[4]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.GoPoint_Condition[5]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.GoPoint_Condition[5]:=FALSE;	
END_IF

//负极纠偏平台X2
IF Mach_Control.U.DT_iMode=3  OR  (DP_Step0>=6015 AND   DP_Step0<=6041)    THEN
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX2].Cmd.Home_Condition:=FALSE;	
