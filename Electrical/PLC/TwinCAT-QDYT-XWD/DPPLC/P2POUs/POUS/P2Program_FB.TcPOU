IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND
arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown2].arrTargetPoint[1]+1 AND
 arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND
  arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Io.DIOFFSwitch AND	 arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Io.DIOnSwitch   THEN
arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF  Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.Homed AND
	 arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fSetPos<=arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown2].arrTargetPoint[1]+1 AND
 	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Status.Homed AND  arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[2] AND
    arrCyCtrl[arrCyNo.CylinderName.CaScrapbinUDCy].Io.DIOFFSwitch AND	 arrCyCtrl[arrCyNo.CylinderName.CaScrapbinCy].Io.DIOnSwitch   THEN

	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine2].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF

