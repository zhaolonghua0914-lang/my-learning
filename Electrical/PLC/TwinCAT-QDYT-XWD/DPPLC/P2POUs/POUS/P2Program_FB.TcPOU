//负极送片皮带
IF Mach_Control.U.DT_iMode=3  AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fActPos<= arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[1] +0.5
AND  arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown2].Status.fActPos<=arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown2].arrTargetPoint[4]+0.5  THEN
	arrAxisCtrl[AxiseNo.AxisName.CaBelt].Cmd.Home_Condition:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.CaBelt].Cmd.JogN_Condition:=TRUE;
	arrAxisCtrl[AxiseNo.AxisName.CaBelt].Cmd.JogP_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CaBelt].Cmd.Home_Condition:=FALSE;	
	arrAxisCtrl[AxiseNo.AxisName.CaBelt].Cmd.JogN_Condition:=FALSE;
	arrAxisCtrl[AxiseNo.AxisName.CaBelt].Cmd.JogP_Condition:=FALSE;
END_IF



//负极送片搬运1平移
IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND
 	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fSetPos<= arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[1]+1 THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.Home_Condition:=TRUE;
ELSE
arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Status.Homed AND 
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.Homed AND
 	arrAxisCtrl[AxiseNo.AxisName.CaCarryingUpDown1].Status.fSetPos<= arrAxisPar[AxiseNo.AxisName.CaCarryingUpDown1].arrTargetPoint[1]+1 THEN
	arrAxisCtrl[AxiseNo.AxisName.CaCarryingLine1].Cmd.GoPoint_Condition[1]:=TRUE;
