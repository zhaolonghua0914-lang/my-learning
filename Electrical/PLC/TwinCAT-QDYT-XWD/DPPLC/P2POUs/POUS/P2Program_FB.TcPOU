IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.GoPoint_Condition[1]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationX1].Cmd.GoPoint_Condition[2]:=FALSE;	
