IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.GoPoint_Condition[3]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.GoPoint_Condition[3]:=FALSE;	
END_IF

IF Mach_Control.U.DT_iMode=3 AND arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Status.Homed THEN
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.GoPoint_Condition[4]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.CadeviationY].Cmd.GoPoint_Condition[4]:=FALSE;	
