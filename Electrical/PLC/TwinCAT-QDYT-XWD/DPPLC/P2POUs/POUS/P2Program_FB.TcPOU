    <Action Name="Sticker_Alarm" Id="{d9790525-113d-4832-8d40-858be52163ca}" FolderPath="05StickGlue \">
      <Implementation>
        <ST><![CDATA[
TJ_AlarmTon[1](IN:= , PT:=T#300MS , Q=> , ET=> );//
//TJ_AlarmTon[2](IN:= , PT:=T#300MS , Q=> , ET=> );//
TJ_AlarmTon[3](IN:= , PT:=T#300MS , Q=> , ET=> );//
//TJ_AlarmTon[4](IN:= , PT:=T#300MS , Q=> , ET=> );//
TJ_AlarmTon[5](IN:= , PT:=T#100MS , Q=> , ET=> );//
TJ_AlarmTon[6](IN:= , PT:=T#50MS , Q=> , ET=> );//
TJ_AlarmTon[7](IN:= , PT:=T#1000MS , Q=> , ET=> );//

IF  arrCyCtrl[arrCyNo.ElectValveName.BlueGlueVacuum1].Io.DOStatus1 AND NOT arrCyCtrl[arrCyNo.ElectValveName.BlueGlueVacuum1].Io.DIOnSwitch THEN
	IF NOT TJ_AlarmTon[1].Q  THEN
		TJ_AlarmTon[1].IN:=TRUE;
	ELSE
			Mach_Control.TJ_b.Error[1] :=TRUE;//备胶组件蓝胶真空1报警
	END_IF
ELSE
		TJ_AlarmTon[1].IN:=FALSE;
END_IF
(*
IF  arrCyCtrl[arrCyNo.ElectValveName.BlueGlueVacuum2].Cmd.bON AND NOT arrCyCtrl[arrCyNo.ElectValveName.BlueGlueVacuum2].Io.DIOnSwitch THEN
	IF NOT TJ_AlarmTon[2].Q THEN
		TJ_AlarmTon[2].IN:=TRUE;
	ELSE
			;//Mach_Control.TJ_b.Error[2] :=TRUE;//备胶组件蓝胶真空2报警
	END_IF
ELSE
		TJ_AlarmTon[2].IN:=FALSE;
END_IF*)

IF  arrCyCtrl[arrCyNo.ElectValveName.codeGlueVacuum1].Io.DOStatus1  AND NOT arrCyCtrl[arrCyNo.ElectValveName.codeGlueVacuum1].Io.DIOnSwitch THEN
	IF NOT TJ_AlarmTon[3].Q THEN
		TJ_AlarmTon[3].IN:=TRUE;
	ELSE
			Mach_Control.TJ_b.Error[3] :=TRUE;//备胶组件二维码真空1报警
			Mach_Control.TJ_b.Scan_Men[1].Scan_gross:=0;
			Mach_Control.TJ_b.Scan_Men[2].Scan_gross:=0;
			Mach_Control.TJ_b.Scan_Men[3].Scan_gross:=0;
	END_IF
ELSE
		TJ_AlarmTon[3].IN:=FALSE;
END_IF

(*
IF  arrCyCtrl[arrCyNo.ElectValveName.codeGlueVacuum2].Cmd.bON  AND NOT arrCyCtrl[arrCyNo.ElectValveName.codeGlueVacuum2].Io.DIOnSwitch THEN
	IF NOT TJ_AlarmTon[4].Q THEN
		TJ_AlarmTon[4].IN:=TRUE;
	ELSE
			;//Mach_Control.TJ_b.Error[4] :=TRUE;//备胶组件二维码真空2报警
	END_IF
ELSE
		TJ_AlarmTon[4].IN:=FALSE;
END_IF
*)

IF  arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Io.DOStatus1  AND NOT arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Io.DIOnSwitch  
	AND NOT (Sticker_Step2>=400 )THEN
	IF NOT TJ_AlarmTon[5].Q THEN
		TJ_AlarmTon[5].IN:=TRUE;
	ELSE
			Mach_Control.TJ_b.Error[5] :=TRUE;//备胶组件贴胶胶头真空报警
			arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Cmd.bOFF:=TRUE;
	END_IF
ELSE
		TJ_AlarmTon[5].IN:=FALSE;
END_IF

IF NOT arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Io.DOStatus1 AND arrCyCtrl[arrCyNo.ElectValveName.PastesGlueVacuum].Io.DIOnSwitch 
	AND NOT (Sticker_Step2>=400 )THEN
	IF NOT TJ_AlarmTon[7].Q THEN
		TJ_AlarmTon[7].IN:=TRUE;
	ELSE
			Mach_Control.TJ_b.Error[7] :=TRUE;//备胶组件贴胶头没开真空有真空信号报警
			
	END_IF
ELSE
		TJ_AlarmTon[7].IN:=FALSE;
END_IF



IF  Sticker_Step1=9999  THEN
	IF NOT TJ_AlarmTon[6].Q THEN
		TJ_AlarmTon[6].IN:=TRUE;
	ELSE
			Mach_Control.TJ_b.Error[6] :=TRUE;//找不到Mark孔报警
			StandbyCode_Start:=FALSE;
			StandbyBule_Start:=FALSE;
	END_IF
ELSE
		TJ_AlarmTon[6].IN:=FALSE;
END_IF

IF  	Mach_Control.TJ_b.Error[1]//备胶组件蓝胶真空1报警
	OR Mach_Control.TJ_b.Error[2] //备胶组件蓝胶真空2报警
	OR Mach_Control.TJ_b.Error[3] //备胶组件二维码真空1报警
	OR Mach_Control.TJ_b.Error[4] //备胶组件二维码真空2报警
	OR Mach_Control.TJ_b.Error[5] //备胶组件贴胶胶头真空报警
	THEN
	TJ_Error:=TRUE;	
	StandbyCode_Start:=FALSE;
	StandbyBule_Start:=FALSE;
	END_IF

IF (Mach_Control.TJ_b.Error[5] OR Mach_Control.TJ_b.Error[6])  AND fTSticker_AlarmRest.Q THEN	
	Sticker_Step1:=0;
END_IF
(*
IF Mach_Control.TJ_b.Scan_Men[3].Scan_gross<>1 AND NOT Mach_Control.TJ_b.ScanMode THEN
	Mach_Control.TJ_b.Scan_TS:=TRUE;
	ELSE
	Mach_Control.TJ_b.Scan_TS:=FALSE;
END_IF

*)
//贴胶报警复位处理
rSticker_AlarmRest(CLK:=Sys_Control.btn.System_Rrestbtn , Q=> );
fTSticker_AlarmRest(CLK:=Sys_Control.btn.System_Rrestbtn , Q=> );
IF Mach_Control.U.TJ_iMode=3 THEN//在手动状态下，复位报警
		IF fTSticker_AlarmRest.Q THEN
				MEMSET(ADR(Mach_Control.TJ_b.Error),0,SIZEOF(Mach_Control.TJ_b.Error)); // 贴胶报警复位
				TJ_Error:=FALSE;
				
		END_IF
END_IF
Mach_Control.TJ_b.Error[9];//贴胶治具有信号无记忆报警
Mach_Control.TJ_b.Error[11];//叠台贴胶头贴胶时无贴胶报警]]></ST>
      </Implementation>
    </Action>
    <Action Name="Sticker_Gohome" Id="{110b91a9-d02b-4ebc-ad1f-d9522ade4615}" FolderPath="05StickGlue \">
      <Implementation>
        <ST><![CDATA[StickerGohome_TON[1](PT:=T#1S);
StickerGohome_TON[2](PT:=T#1S);
StickerGohome_TON[3](PT:=T#1S);
StickerGohome_TON[4](PT:=T#1S);
StickerGohome_TON[5](PT:=T#1S);
StickerGohome_TON[6](PT:=T#1S);
StickerGohome_TON[7](PT:=T#1S);
Sticker_GohomeOverTon(IN:= , PT:=T#120S , Q=> , ET=> );//贴胶回原点超时报警延时

//判断贴胶回原点是否完成
IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving  AND 
	arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving   AND
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving AND
	arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving  AND TJIniti_Done THEN	 
		Mach_Control.TJ_b.TJIniti_Done:=TRUE;//复位贴胶初始化完成	
ELSE
		Mach_Control.TJ_b.TJIniti_Done:=FALSE;//复位贴胶初始化完成		
END_IF


IF Mach_Control.U.WJ_iMode=3 THEN//在手动状态下
		IF r_Sticker_init.Q THEN
			StickerStep0:=0;
			TJIniti_Done:=FALSE;
		END_IF	
END_IF		
IF Sticker_GohomeOverTon.Q THEN
	Sticker_GohomeOverTon.IN:=FALSE;
	StickerStep0:=0;
	Mach_Control.TJ_b.Error[8]:=TRUE; //贴胶回原超时报警
END_IF


r_Sticker_init(CLK:=Mach_Control.TJ_b.TJIniti_Hbtn(* OR Mach_Control.DT_b.ALLIniti_Hbtn *), Q=> );
f_Sticker_init(CLK:=Mach_Control.TJ_b.TJIniti_Hbtn (*OR Mach_Control.DT_b.ALLIniti_Hbtn *), Q=> );
tStickerTON(IN:= , PT:= , Q=> , ET=> );
IF Mach_Control.U.WJ_iMode=3 THEN//在手动状态下
	CASE StickerStep0 OF
		0://
			IF f_Sticker_init.Q THEN		
				StickerStep0:=1;
				Sticker_Step0:=0;
				Sticker_Step1:=0;
				Sticker_Step2:=0;		
				CellMemory[Mach_Control.TJ_b.TJ_Memory].Cell:=FALSE;
				Sticker_GohomeOverTon.IN:=TRUE;
			END_IF
		1:
				Mach_Control.TJ_b.StickPermit:=FALSE;//贴胶允许
				Mach_Control.TJ_b.StickFinish:=FALSE;//贴胶完成	
				Mach_Control.TJ_b.StickMark_L1 :=FALSE;//左短边1贴胶完成
				Mach_Control.TJ_b.StickMark_L2 :=FALSE;//左短边2贴胶完成
				Mach_Control.TJ_b.StickMark_R1 :=FALSE;//右短边1贴胶完成
				Mach_Control.TJ_b.StickMark_R2 :=FALSE;//右短边2贴胶完成		
				Mach_Control.TJ_b.StickMark1_L :=FALSE;//右短边2贴胶完成		
				Mach_Control.TJ_b.StickMark1_L2 :=FALSE;//右短边2贴胶完成		
				Mach_Control.TJ_b.Sticking_L:=FALSE;//左短边贴胶
				Mach_Control.TJ_b.Sticking_R:=FALSE;//右短边贴胶
				Mach_Control.TJ_b.Sticking_Lg:=FALSE;//非极耳侧长边贴胶
				Mach_Control.TJ_b.Sticking_Lg2:=FALSE;//极耳侧长边贴胶				
				TJIniti_Done:=FALSE;//复位贴胶初始化完成	
				Mach_Control.TJ_b.StickerFlag:=FALSE;
				Mach_Control.TJ_b.StickerDone:=FALSE;
				Mach_Control.TJ_b.StickerOffloadingDone:=FALSE;	
				IF NOT TJIniti_Done THEN
					StickerStep0:=10;
				END_IF
		10://贴胶冶具气缸开， 贴胶NG气缸回
			arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Cmd.bON:=TRUE;//贴胶冶具夹爪张开
			arrCyCtrl[arrCyNo.CylinderName.GlueNGCy].Cmd.bOFF:=TRUE;//贴胶NG回
			IF arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Io.DIONSwitch AND arrCyCtrl[arrCyNo.CylinderName.GlueNGCy].Io.DIOFFSwitch THEN
				StickerStep0:=20;
			END_IF
		20://贴胶头进退回原
			arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.bHome:=TRUE;//贴胶头进退轴回原点
			StickerStep0:=25;					
		25://判断帖胶头进退轴回原点是否完成	
			StickerGohome_TON[1].IN:=TRUE;
		IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving  AND StickerGohome_TON[1].Q THEN
			arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.bHome:=FALSE;
			StickerGohome_TON[1].IN:=FALSE;
			StickerStep0:=30;
		END_IF				
		30://贴胶头平移轴移动至初始位
			IF  arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving THEN
					IF arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Status.NoMoving  THEN
						arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=0;
						StickerStep0:=40;	
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.GluingRetracting].Cmd.iGoSetPos:=1;//贴胶头进退去初始位
					END_IF
			END_IF			
		40://切胶气缸伸出，拉胶气缸伸出，拉胶升降轴回原点
				arrCyCtrl[arrCyNo.CylinderName.codeGlueCutCy].Cmd.bON:=TRUE;//贴胶切二维码胶气缸伸出
				arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Cmd.bON:=TRUE;//贴胶切胶气缸伸出
				arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Cmd.bON:=TRUE;//拉胶气缸伸出
				IF	arrCyCtrl[arrCyNo.CylinderName.codeGlueCutCy].Io.DIOnSwitch 
				AND arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Io.DIOnSwitch 
				AND arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Io.DIOnSwitch THEN
					StickerStep0:=50;	
				END_IF
		50:		
				arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.bHome:=TRUE;//拉胶升降轴回原点		
				StickerStep0:=53;
		53:	//判断拉胶升降轴回原点是否完成	
					StickerGohome_TON[2].IN:=TRUE;
				IF arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving  AND StickerGohome_TON[2].Q THEN
					arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.bHome:=FALSE;//拉胶升降轴回原点
					StickerGohome_TON[2].IN:=FALSE;
					StickerStep0:=55;
				END_IF			
		55://拉胶升降轴去踢废避让位
				IF  arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving THEN
						IF arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.arrbRealPoint[9]  AND  arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Status.NoMoving THEN
							arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=0;
							StickerStep0:=60;	
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.GluingUpDown].Cmd.iGoSetPos:=9;//拉胶升降轴至踢废胶避让位
						END_IF
				END_IF				
		60://贴胶夹电芯气缸张开，侧贴胶平移轴回原点
				arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bOFF:=TRUE;//贴胶夹爪气缸张开
				IF 	arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Io.DIOFFSwitch AND
                  GluingLineagree THEN		
					arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.bHome:=TRUE;//侧贴胶平移回原
					StickerStep0:=65;	
				ELSE	
					Mach_Control.TJ_b.Error[10]:=TRUE; //侧贴胶平移回原点时条件不满足报警
					StickerStep0:=0;	
				END_IF			
		65://判断侧贴胶平移是否回原完成
				StickerGohome_TON[3].IN:=TRUE;
				IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving  AND StickerGohome_TON[3].Q THEN
					arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.bHome:=FALSE;
					StickerGohome_TON[3].IN:=FALSE;
					StickerStep0:=70;
				END_IF
		70://侧贴胶平移移动至左短边侧贴胶位1
			IF  arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving THEN
					IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[1] THEN
						arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=0;
						StickerStep0:=80;	
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.iGoSetPos:=1;//
					END_IF
			END_IF			
		80://贴胶夹电芯气缸张开，侧贴胶旋转回原点
				arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bOFF:=TRUE;//贴胶夹爪气缸张开
				IF 	arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Io.DIOFFSwitch AND
                    Mach_Control.TJ_b.WhirlingSafe THEN
					arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.bHome:=TRUE;//侧贴胶旋转轴回原点
					StickerStep0:=85;
				END_IF		
		85://判断侧贴胶旋转回原是否完成
				StickerGohome_TON[4].IN:=TRUE;
				IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving  AND StickerGohome_TON[4].Q THEN
					StickerStep0:=90;
					arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.bHome:=FALSE;//侧贴胶旋转轴回原点
					StickerGohome_TON[4].IN:=FALSE;
				END_IF
		90://侧贴胶旋转去上电芯位
			IF  arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving THEN
					IF arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving THEN
						arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=0;
						StickerStep0:=110;	
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.iGoSetPos:=5;//旋转至上电芯位
					END_IF
			END_IF	
		110://判断侧贴胶平移轴回原点是否完成，侧贴胶旋转轴回原点是否完成
			IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving AND 
				arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving 
			THEN
				Sticker_GohomeOverTon.IN:=FALSE;
				TJIniti_Done:=TRUE;
				StickerStep0:=0;
			END_IF
	END_CASE			
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="StickGlue_Init" Id="{c93ce707-1068-46ca-8682-3307fd269806}" FolderPath="05StickGlue \">
      <Implementation>
        <ST><![CDATA[		arrCyCtrl[arrCyNo.CylinderName.codeGlueCutCy].Cmd.bON:=TRUE;//切二维胶伸出
		arrCyCtrl[arrCyNo.CylinderName.CodeGluePressCy].Cmd.bOFF:=TRUE;//压二维码胶收回
		arrCyCtrl[arrCyNo.CylinderName.CodeStandbyGlueCy].Cmd.bOFF:=TRUE;//备二维码胶收回		
		arrCyCtrl[arrCyNo.CylinderName.GlueCutCy].Cmd.bON:=TRUE;//切胶伸出
		arrCyCtrl[arrCyNo.CylinderName.GluePressCy].Cmd.bOFF:=TRUE;//压胶气缸收回
		arrCyCtrl[arrCyNo.CylinderName.StandbyGlueCy].Cmd.bOFF:=TRUE;//备胶气缸收回	
		arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Cmd.bON:=TRUE;//贴胶拉胶气缸伸出
		arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Cmd.bOFF:=TRUE;//贴胶冶具气缸收回
		arrCyCtrl[arrCyNo.CylinderName.PullGlueCy].Cmd.bOFF:=TRUE;//贴胶冶具气缸收回
		arrCyCtrl[arrCyNo.CylinderName.PullGluePoleCy].Cmd.bOFF:=TRUE;//拉胶锁紧气缸收回	
		arrCyCtrl[arrCyNo.CylinderName.GlueNGCy].Cmd.bOFF:=TRUE;//踢废胶收回		
		arrCyCtrl[arrCyNo.CylinderName.GlueClampsCy].Cmd.bON:=TRUE;//贴胶夹爪气缸张开]]></ST>
      </Implementation>
    </Action>
    <Action Name="TailCurl_Alarm" Id="{17be2edf-9978-4635-a1ab-e67f4d0b0c24}" FolderPath="04TailCurl\">
      <Implementation>
        <ST><![CDATA[//尾卷报警复位处理
rTailCurl_AlarmRest(CLK:=Sys_Control.btn.System_Rrestbtn , Q=> );
fTailCurl_AlarmRest(CLK:=Sys_Control.btn.System_Rrestbtn , Q=> );
IF Mach_Control.U.WJ_iMode=3 THEN//在手动状态下，复位报警
		IF fTailCurl_AlarmRest.Q THEN
				MEMSET(ADR(Mach_Control.WJ_b.Error),0,SIZEOF(Mach_Control.WJ_b.Error)); // 叠台报警复位
		END_IF
END_IF


   IF arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[3]=0 THEN 
	   arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[3]:=500 ;	
	END_IF
     
	TailCurlAxisbstop_R(CLK:= arrAxisbstop[AxiseNo.AxisName.TailCurlLine] , Q=> );//HMI轴停止上升沿
    TailCurlAxisbstop_F(CLK:= arrAxisbstop[AxiseNo.AxisName.TailCurlLine] , Q=> );//HMI轴停止下降沿

     IF TailCurlAxisbstop_R.Q AND Mach_Control.U.WJ_iMode=3 THEN 
        arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.bStop:=TRUE;
     END_IF
 
     IF TailCurlAxisbstop_F.Q  AND  Mach_Control.U.WJ_iMode=3  THEN 
         arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.bStop:=FALSE;
     END_IF
	
    TailCurl_WJJMPY_Xzb:=arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[3]+arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.fActPos;

    IF TailCurlStep3=105 AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Moving
		 AND (*arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed  AND*) arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND
         ABS( TailCurl_WJJMPY_Xzb-arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.fActPos) <100 THEN
	   Mach_Control.WJ_b.Error[26]:=TRUE;//尾卷夹平移防撞软限位报警
	END_IF
	
	WJError_r(CLK:= Mach_Control.WJ_b.Error[26] , Q=> );
	IF WJError_r.Q THEN 
	  // arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bStop:=TRUE;
       arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.bStop :=TRUE;	
	END_IF
	
    IF  P2M2_sysControl.btn.System_Rrestbtn  THEN
       arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bStop:=FALSE;
       arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.bStop :=FALSE;
	END_IF
	
		IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1] AND NOT   arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Io.biHomeSwitch AND 
            arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.NoMoving  THEN
			 Mach_Control.WJ_b.Error[4]:=TRUE;//短卷针旋转在初始位原点传感器不亮报警
		END_IF
		
		IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] AND NOT   arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Io.biHomeSwitch AND  
            arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.NoMoving THEN
			 Mach_Control.WJ_b.Error[6]:=TRUE;//长卷针旋转在初始位原点传感器不亮报警
		END_IF

GluebHaveTON(PT:=T#500MS);
GluebHaveTON.IN:=(TailCurlStep3=332 AND Mach_Control.se.GluebHave AND NOT CellMemory[Mach_Control.TJ_b.TJ_Memory].Cell );
IF GluebHaveTON.Q AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving THEN
	Mach_Control.TJ_b.Error[9]:=TRUE; //贴胶夹爪有信号无记忆报警
	;
END_IF

IF Par.stWJ_date.Hotcount>=Par.stWJ_date.Hotlifetime THEN
    Mach_Control.WJ_b.Error[12]:=TRUE;//热切丝使用寿命到达
END_IF	]]></ST>
      </Implementation>
    </Action>
    <Action Name="TailCurl_Auto_CamOut" Id="{72784fc1-8f25-447e-a06b-3872761fbeb6}" FolderPath="04TailCurl\">
      <Implementation>
        <ST><![CDATA[//判断是否有叠台部分轴在耦合中
				IF NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Coupled AND 
					NOT arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Coupled   THEN
					TailCurl_AxiseCoupling:=FALSE;//叠片部分轴在耦合中
				ELSE
					TailCurl_AxiseCoupling:=TRUE;
				END_IF
//叠台自动子程序_凸轮耦合解除_主轴清零
rWJCamOut_TRIG(CLK:=Mach_Control.WJ_b.WJ_AllCamOut , Q=> );
IF  rWJCamOut_TRIG.Q THEN
	TailCurl_Step1:=100;
END_IF
CASE TailCurl_Step1 OF
		100://先判断主轴是否在停止中
				IF arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.NoMoving  THEN
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bStop:=FALSE;
					TailCurl_Step1:=110;
				ELSE
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bStop:=TRUE;
				END_IF
		110://判断轴是否在耦合中
				//IF TailCurl_AxiseCoupling THEN
					TailCurl_Step1:=120;
				//ELSE
					//TailCurl_Step1:=130;
				//END_IF
		120://叠台部轴解除耦合
				fbCamInEndWindX.bCamInExecute:=FALSE;//夹膜平移
				fbCamInEndWindY.bCamInExecute:=FALSE;//夹膜升降
				tailCurl1_GearIn.Execute:=FALSE;//短卷针
				tailCurl2_GearIn.Execute:=FALSE;//长卷针
				tailCurlGearInEnable:=FALSE;//夹隔膜电子凸轮
				tailCurlGearInEnable1:=FALSE;//夹隔膜电子凸轮
				tailRetGearInEnable:=FALSE;//夹电芯平移与夹电芯伸缩电子齿轮
				IF NOT fbCamInEndWindX.bCamInExecute AND NOT fbCamInEndWindY.bCamInExecute AND 
					NOT  tailCurl1_GearIn.Execute AND NOT tailCurl2_GearIn.Execute AND NOT tailCurlGearInEnable AND NOT tailRetGearInEnable AND NOT tailCurlGearInEnable1  THEN
						TailCurl_Step1:=130;
				END_IF
		130:
				arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.bGearOut:=TRUE;
				arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.bGearOut:=TRUE;
			
				IF NOT DT_AxiseCoupling THEN
					arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.bGearOut:=FALSE;
					arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.bGearOut:=FALSE;
									
					TailCurl_Step1:=140;
				END_IF
		140://主轴当前位置清零				
				arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.fSetPos:=0;
				arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bSetPos:=TRUE;			
				TailCurl_Step1:=150;
		150://判断主轴是否停止以及在模长初始位
				IF  NOT arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bSetPos AND arrAxis[AxiseNo.VirAxisName.VirTailCurl].NcToPlc.SetPos=0   THEN
					TailCurl_Step1:=6666;
				END_IF
END_CASE
]]></ST>
      </Implementation>
    </Action>
    <Action Name="TailCurl_Auto1" Id="{9312de7f-505a-423f-981d-7087ffc6f00c}" FolderPath="04TailCurl\">
      <Implementation>
        <ST><![CDATA[//TON_TailCurl[0](PT:=T#0.5S);//热切加热延时时间
hot_time_ton(PT:=T#0.3S);
WJ_TON[1].PT:=REAL_TO_TIME(Par.stWJ_date.HotTime*1000);
SLCurlingneedleLine_TON(PT:=T#0.5S);
WJ_TON[6](IN:= , PT:=T#100MS , Q=> , ET=> );//
TON_TailCurl[1](IN:=Mach_Control.WJ_b.HotCut,PT:=T#0.4S);//热切丝加热时间
IF TON_TailCurl[1].Q THEN
	Mach_Control.WJ_b.HotCut:=FALSE;
	Par.stWJ_date.Hotcount:=Par.stWJ_date.Hotcount+1;
END_IF


IF WJ_TON[1].Q THEN//热切丝自动
	Mach_Control.WJ_b.HotCut:=FALSE;
	WJ_TON[1].IN:=FALSE;
END_IF

IF  Mach_Control.WJ_b.HotClear THEN
	Par.stWJ_date.Hotcount:=0;
END_IF

IF Mach_Control.U.WJ_iMode=3 THEN
	Mach_Control.WJ_b.Manual:=TRUE;
	ELSE
	Mach_Control.WJ_b.Manual:=FALSE;	
END_IF

/////////////////尾卷辅助时间计时////////////////////////
IF DP_Step0=6040  (*AND  NOT Mach_Control.DT_b.OffloadDone*) THEN
     Mach_Control.WJ_b.WJ_TIME:=(TIME_TO_REAL(WJ_ET))/1000;
END_IF	 
WJ_TON[2](IN:= (DP_Step0=6040 AND   Mach_Control.U.DT_iMode=1 AND  TailCurlStep3<=220 AND Mach_Control.U.WJ_iMode=1 ), PT:=T#500S, Q=> , ET=>WJ_ET );
/////////////////////////////////////////////////////////////

////////////////   
(*IF Blueflaging THEN
	Par.stDT_date.BH_Thickness :=0.5*(((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.An_Quantity+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.Ca_Quantity)-((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*(Mach_Control.An_b.An_Quantited-Mach_Control.An_b.An_EmptyRunKDQuantited)+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*(Mach_Control.Ca_b.Ca_Quantited-Mach_Control.Ca_b.Ca_EmptyRunKDQuantited))+(Mach_Control.An_b.An_EmptyRunKDQuantited +Mach_Control.Ca_b.Ca_EmptyRunKDQuantited )*Par.stDT_date.SEPTA_Thickness);
ELSE
	Par.stDT_date.BH_Thickness :=0.5*(((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.An_Quantity+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.Ca_Quantity)-((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*Mach_Control.An_b.An_Quantited+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*Mach_Control.Ca_b.Ca_Quantited));
END_IF
arrAxispar[AxiseNo.AxisName.TailCurlUpDown].arrTargetPoint[6]:=arrAxispar[AxiseNo.AxisName.TailCurlUpDown].arrTargetPoint[1]-Par.stDT_date.BH_Thickness;
arrAxispar[AxiseNo.AxisName.TailCurlSEPTAUpDown].arrTargetPoint[3]:=arrAxispar[AxiseNo.AxisName.TailCurlSEPTAUpDown].arrTargetPoint[1]+Par.stDT_date.BH_Thickness;	*)				
////////////////
IF Blueflaging AND NOT Mach_Control.U.EmptyRunMode THEN
	Par.stDT_date.BH_Thickness :=0.5*(((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.An_Quantity+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.Ca_Quantity)-((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*Mach_Control.An_b.An_Quantited+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*Mach_Control.Ca_b.Ca_Quantited)+40*Par.stDT_date.SEPTA_Thickness);
ELSIF NOT  Blueflaging AND NOT Mach_Control.U.EmptyRunMode THEN
	Par.stDT_date.BH_Thickness :=0.5*(((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.An_Quantity+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.Ca_Quantity)-((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*Mach_Control.An_b.An_Quantited+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*Mach_Control.Ca_b.Ca_Quantited));
ELSIF Mach_Control.U.EmptyRunMode THEN
	Par.stDT_date.BH_Thickness :=0.5*(((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.An_Quantity+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.Ca_Quantity))-(Par.stDT_date.SEPTA_Thickness*(Mach_Control.An_b.An_Quantited+Mach_Control.Ca_b.Ca_Quantited));
END_IF
arrAxispar[AxiseNo.AxisName.TailCurlUpDown].arrTargetPoint[6]:=arrAxispar[AxiseNo.AxisName.TailCurlUpDown].arrTargetPoint[1]-Par.stDT_date.BH_Thickness;
arrAxispar[AxiseNo.AxisName.TailCurlSEPTAUpDown].arrTargetPoint[3]:=arrAxispar[AxiseNo.AxisName.TailCurlSEPTAUpDown].arrTargetPoint[1]+Par.stDT_date.BH_Thickness;	


IF (TailCurlStep3>=150 AND TailCurlStep3<=210) OR (TailCurlStep3>=1050 AND TailCurlStep3<=1140) THEN
	iTargetTorqueTest:=Par.stDT_date.iTargetTorqueHMI*Par.stDT_date.iTargetTorqueBLXS/10;
ELSIF  	(* Mach_Control.An_b.An_Quantited<1*) NOT  bFirstFoldFinish[1] OR (Mach_Control.Ca_b.Ca_Quantited= Par.stDT_date.Ca_Quantity  AND Mach_Control.An_b.An_Quantited= Par.stDT_date.An_Quantity) THEN
	iTargetTorqueTest:=Par.stDT_date.iTargetTorqueHMI*6/10;
ELSE
	iTargetTorqueTest:=Par.stDT_date.iTargetTorqueHMI;
END_IF


TON_TailCurl[2](PT:=T#0.5S);//长卷针夹爪气缸延时
TON_TailCurl[3](PT:=T#1S);//长卷针泄压时间
TON_TailCurl[4](PT:=T#0.5S);//短卷针夹爪气缸延时
TON_TailCurl[5](PT:=T#1S);//短卷针泄压时间
TON_TailCurl[6](PT:=T#1S);//短卷针泄压时间
TON_TailCurl1[2](PT:=T#0.2S);
TON_TailCurl1[3](PT:=T#1S);
TON_TailCurl1[4](PT:=T#0.2S);
TON_TailCurl1[5](PT:=T#0.2S);
TON_TailCurl1[6](PT:=T#0.3S);
TailCurlSplintCy_TON(PT:=T#2S);//夹NG料延时
TailCurlSplintCy_ON(PT:=T#1.5S);//夹NG料延时
//判断始尾卷各轴是否在初始位置
IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[11] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] AND
	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND 
	 arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] AND 
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND 
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] THEN
	TailCurlIinitPos:=TRUE;//尾卷各轴都在初始位
ELSE
	TailCurlIinitPos:=FALSE;	
END_IF
rWJ_SinStepd(CLK:=Mach_Control.WJ_b.TailCurlStart , Q=> );
IF rWJ_SinStepd.Q THEN
	TailCurlSinStep:=FALSE;
END_IF
(*
IF TailCurlStep3>=150 AND TailCurlStep3 <151 THEN
	arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Abs:=arrAxisPar[AxiseNo.AxisName.TailCurlLine].fVelocity_of_Abs*0.85;
ELSE
	arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Abs:=arrAxisPar[AxiseNo.AxisName.TailCurlLine].fVelocity_of_Abs;
END_IF
*)

//尾卷夹电芯拉膜速度切换
(*
IF TailCurlStep3>260 AND TailCurlStep3<1000 THEN
	arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Abs:=arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Abs;
	arrAxisPar[AxiseNo.AxisName.TailCurlLine].fVelocity_of_Abs:=arrAxisPar[AxiseNo.AxisName.TailCurlLine].fVelocity_of_Abs ;	
ELSIF(TailCurlStep3<=105  AND TailCurlStep3>=100)
	OR  (TailCurlStep3<=1010   AND TailCurlStep3>=1000)
	OR  (TailCurlStep3<=215 AND TailCurlStep3>=213) THEN
	arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Abs:=Par.stDT_date.fVelocity_of_QDX ;
	arrAxisPar[AxiseNo.AxisName.TailCurlLine].fVelocity_of_Abs:=Par.stDT_date.fVelocity_of_QDX ;
ELSE	
	arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Abs:=Par.stDT_date.fVelocity_of_LM ;
	arrAxisPar[AxiseNo.AxisName.TailCurlLine].fVelocity_of_Abs:=Par.stDT_date.fVelocity_of_LM ;
END_IF
*)
IF (TailCurlStep3<=190  AND TailCurlStep3>=145) OR (TailCurlStep3<=1060  AND TailCurlStep3>=1140) OR  (TailCurlStep3<215 AND TailCurlStep3>=213) THEN
	arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Abs:=Par.stDT_date.fVelocity_of_LM ;
	arrAxisPar[AxiseNo.AxisName.TailCurlLine].fVelocity_of_Abs:=Par.stDT_date.fVelocity_of_LM ;
ELSIF (TailCurlStep3<=105  AND TailCurlStep3>=100)OR  (TailCurlStep3<=1010   AND TailCurlStep3>=1000)  THEN
	arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Abs:=Par.stDT_date.fVelocity_of_QDX ;
	arrAxisPar[AxiseNo.AxisName.TailCurlLine].fVelocity_of_Abs:=Par.stDT_date.fVelocity_of_QDX ;
ELSE
	arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Abs:=Par.stDT_date.fVelocity_of_QDX ;
	arrAxisPar[AxiseNo.AxisName.TailCurlLine].fVelocity_of_Abs:=Par.stDT_date.fVelocity_of_QDX ;
END_IF



IF Mach_Control.U.WJ_iMode=1 THEN//在自动状态下
//尾卷取叠台电芯自动
		CASE TailCurlStep3 OF 
				0://判断叠台是否叠电芯完成
					IF  TailCurlIinitPos THEN//尾卷夹电芯平移在初始位、尾卷夹电芯伸缩在初始位
						
						arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.fOverride:=100;
						arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.fOverride:=100;
						arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=100;
				
						IF NOT CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_TF AND NOT Mach_Control.WJ_b.b_WJqr AND Mach_Control.DT_b.OffloadRequest AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] 
							 AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]
								AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1]  AND   arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1]
								AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[11] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] 
								AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] THEN
								
								TailCurlStep3:=100;//正常尾卷流程
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
						ELSIF NOT CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_TF  AND  Mach_Control.WJ_b.b_WJqr AND Mach_Control.DT_b.OffloadRequest AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] 
							AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]
							AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1]  AND   arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] 
							AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[11] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] 
							AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] THEN
							
								TailCurlStep3:=900;//NG尾卷流程
							IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
							ELSE
								TailCurlSinStep:=FALSE;
							END_IF		
						ELSIF	CellMemory[Mach_Control.DT_b.DT_Memory].Overhang_TF AND Mach_Control.DT_b.OffloadRequest AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] 
							 AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]
								AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1]  AND   arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] 
								AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[11] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] 
								AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] THEN	
									
									TailCurlStep3:=1000;//对齐度NG不尾卷流程
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF								
							END_IF	
						ELSE
							IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
							ELSE
								TailCurlSinStep:=FALSE;
							END_IF						
							TailCurlStep3:=10;	
						END_IF
	
				10://尾卷夹电芯气缸张开
							IF NOT TailCurlSinStep  THEN
									//arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S_1].Cmd.bON:=TRUE;//尾卷短卷针泄压关闭
									arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Cmd.bOFF:=TRUE;//尾卷取料夹爪气缸张开	
									arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Cmd.bOFF:=TRUE;//尾卷长卷针张开
									arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Cmd.bOFF:=TRUE;//尾卷短卷针张开	
									arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;//隔膜热切升降气缸收回
									arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Cmd.bOFF:=TRUE;//隔膜隔膜下夹板气缸收回						
									arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Cmd.bOFF:=TRUE;//尾卷压轮升降气缸收回
									IF arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Io.DIOFFSwitch THEN
										arrCyCtrl[arrCyNo.CylinderName.TailCurlLineCy].Cmd.bOFF:=TRUE;//尾卷压轮平移气缸收回	
									END_IF						
									IF arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.OFFState AND
										 arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.TailCurlLineCy].Status.OFFState THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF
										TailCurlStep3:=20;	
									END_IF
							END_IF
				20://
					IF NOT TailCurlSinStep THEN
							//长卷针平移至初始位
							IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=1;
								END_IF
							END_IF
							//短卷针平移至初始位
							IF 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.iGoSetPos:=1;
								END_IF
							END_IF		
							IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF								
								TailCurlStep3:=30;	
							END_IF
					END_IF
				30://尾卷夹电芯平移、夹电芯伸缩移动至初始位
					IF NOT TailCurlSinStep THEN
							//尾卷夹电芯平移
							IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND 
                                    arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]      THEN
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=1;
								END_IF
							END_IF
							//尾卷夹电芯伸缩
							IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] THEN
									//TailCurlRetMark:=FALSE;//尾卷夹电芯伸缩力矩判断标志
									arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=1;
									//TailCurlRetMark:=TRUE;//尾卷夹电芯伸缩力矩判断标志
								END_IF
							END_IF	
							//尾卷夹电芯升降
							IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=1;
								END_IF
							END_IF
							//尾卷夹隔膜平移
							IF 	arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=1;
								END_IF
							END_IF	
							//	尾卷夹隔膜升降
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=1;
								END_IF
							END_IF							
							//尾卷长卷针旋转
							IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.iGoSetPos:=1;
								END_IF
							END_IF	
							//尾卷短卷针旋转
							IF 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.iGoSetPos:=1;
								END_IF
							END_IF							
							IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] AND
								arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND 
								 arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1] THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF							
								TailCurlStep3:=40;	
							END_IF
					END_IF
				40://尾卷夹旋转到取叠台电芯角度
					IF NOT TailCurlSinStep THEN
							IF 	arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.NoMoving AND 
								 arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] AND 
								 arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF	
											TailCurlStep3:=50;	
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=1;
										END_IF
							END_IF		
					END_IF
	            50://尾卷夹电芯平移去取电芯等待位
				     IF NOT TailCurlSinStep THEN
						   IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] AND
							  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] AND
							  arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND
							  arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Io.DIOFFSwitch AND arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Io.DIOFFSwitch AND
							  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving  THEN
								   IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[11]  THEN
									  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										   TailCurlSinStep:=TRUE;
										ELSE
										   TailCurlSinStep:=FALSE;
										END_IF									
										   TailCurlStep3:=0;
										   TailCurlTorMark:=FALSE;//尾卷夹电芯平移力矩判断标志位
								   ELSE
									   arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=11;//尾卷夹电芯平移去取电芯等待位
									   TailCurlTorMark:=TRUE;//尾卷夹电芯平移力矩判断标志位
								   END_IF   
							END_IF
	                  END_IF
	
	
			100://夹膜升降去取电芯位，夹电芯升降去取电芯位	///////////////////////////////////////////////
						//Mach_Control.DT_b.OffloadRequest:=FALSE;//复位电芯下料请求
					    IF NOT TailCurlSinStep THEN
							
							IF Mach_Control.DT_b.OffloadRequest AND DP_Step0=6040 THEN
									IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=1;
										END_IF
									END_IF	
									IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=1;
										END_IF
									END_IF	
									IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] 
										AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1]	THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF								
										TailCurlStep3:=105;	
										TON_TailCurl[6].IN:=FALSE;
									END_IF
							ELSE
									TailCurlStep3:=0;
							END_IF		
						END_IF
					
		
					
				105://负极叠片搬运平移轴在安全位置，尾卷夹电芯平移至取电芯位 、尾卷夹电芯伸缩至取电芯位 、尾卷夹膜平移至隔膜切断位///////////////////
						IF NOT TailCurlSinStep AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] AND
                             arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] AND
							 arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] AND
							  arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]   AND
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.OFFState  AND
                            arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState THEN  
                 
								IF  Mach_Control.DT_b.OffloadRequest THEN	
									TailCurlStep3:=106;
									(*
											arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.fOverride:=100;
											arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.fOverride:=100;
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=95;
			
											IF   arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
												IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[2] THEN
													TailCurlSEPTATorMark:=FALSE;//夹膜平移力矩判断标志
													arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=2;//尾卷夹隔膜平移取芯位
													TailCurlSEPTATorMark:=TRUE;//夹膜平移力矩判断标志
												END_IF
											END_IF
											IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
												IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[2] THEN
													arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=2;//尾卷夹电芯伸缩至取电芯位
													//TailCurlRetMark:=TRUE;//尾卷夹电芯伸缩力矩判断标志
												END_IF
											END_IF					
											IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
												IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[2] THEN
													TailCurlTorMark:=FALSE;//尾卷夹电芯平移力矩判断标志位
													arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=2;//尾卷夹电芯平移至取电芯位
													TailCurlTorMark:=TRUE;//尾卷夹电芯平移力矩判断标志位
												END_IF
											END_IF						
											IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[2] AND
												arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[2]  THEN
												//TailCurlRetMark:=FALSE;//尾卷夹电芯伸缩力矩判断标志
												IF  Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
													TailCurlSinStep:=TRUE;
												ELSE
													TailCurlSinStep:=FALSE;
												END_IF	
												TailCurlStep3:=110;
												TailCurlSplintCy_ON.IN:=FALSE;
											END_IF
										*)
								ELSE				
										TailCurlStep3:=0;
								END_IF	
						ELSE
										Mach_Control.WJ_b.Error[11]:=TRUE;	//尾卷夹电芯平移至取电芯位时条件不满足报警			
						END_IF	
				106:
					tailCurlGearInEnable1:=TRUE;//夹电芯平移与夹膜平移电子齿轮----取料
					tailRetGearInEnable:=TRUE;//夹电芯平移与夹电芯伸缩电子齿轮
					IF tailCurl_GearIn1.InGear AND tailRetGearIn.InGear THEN
						TailCurlStep3:=107;
					END_IF			
				107:
					IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND 
                           arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] AND
                             arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] AND
							 arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] AND
							  arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]   AND
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.OFFState  AND
                            arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState   THEN
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[2 ] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving   THEN
									TailCurlTorMark:=FALSE;//尾卷夹电芯平移力矩判断标志位
									arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
									TailCurlStep3:=108;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=2;//尾卷夹电芯平移至取电芯位
									TailCurlTorMark:=TRUE;//尾卷夹电芯平移力矩判断标志位
								END_IF
					ELSE
										Mach_Control.WJ_b.Error[11]:=TRUE;	//尾卷夹电芯平移至取电芯位时条件不满足报警								
					END_IF		
				108:
					IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[2] AND
						arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[2]   THEN
						tailCurlGearInEnable1:=FALSE;//夹电芯平移与夹膜平移电子齿轮----取料
						tailRetGearInEnable:=FALSE;//夹电芯平移与夹电芯伸缩电子齿轮
					END_IF
					IF NOT tailCurl_GearIn1.InGear AND NOT tailRetGearIn.InGear THEN
						TailCurlStep3:=110;
					END_IF			
	
				110://尾卷夹电芯气缸夹紧//////////////////////////////
				
						arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.fOverride:=100;
						arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.fOverride:=100;
						arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=100;
				     
						IF NOT TailCurlSinStep THEN					
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Cmd.bON:=TRUE;//尾卷取料夹爪气缸夹紧
							TailCurlSplintCy_ON.IN:=TRUE;				
							IF (*arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Io.DIOnSwitch OR*) TailCurlSplintCy_ON.Q THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF								
								TailCurlStep3:=120;
								TailCurlSplintCy_ON.IN:=FALSE;
								 Mach_Control.DT_b.OffloadRequest:=FALSE;//复位电芯下料请求
							END_IF
						END_IF
				120://叠台升降下降至下电芯位	
					IF NOT TailCurlSinStep THEN				
								IF 	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.Homed   THEN
										arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bHome:=FALSE;//叠台升降下降至下电芯位回原点
												IF arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.NoMoving THEN
															IF arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.arrbRealPoint[2] THEN
																arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.iGoSetPos:=0;
																IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
																	TailCurlSinStep:=TRUE;
																ELSE
																	TailCurlSinStep:=FALSE;
																END_IF									
																TailCurlStep3:=130;
															ELSE
																arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.iGoSetPos:=2;//叠台升降下降至下电芯位
															END_IF
											END_IF
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bHome:=TRUE;//叠台升降下降至下电芯位回原点
								END_IF	
					END_IF
				130://左、右压刀升降轴上升至抽刀高度
						IF NOT TailCurlSinStep THEN						
							IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=4;//左压刀升降轴上升至抽刀高度
									END_IF
								END_IF					
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=4;//右压好升降上升至抽刀高度
									END_IF
								END_IF				
								IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[4] THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF	
									TailCurlStep3:=140;
								END_IF
						END_IF
				140://左、右压刀开合轴至张开位
						IF NOT TailCurlSinStep THEN					
								IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=2;//左压刀开合至张开位
									END_IF
								END_IF					
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[3] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=3;//右压刀开合至张开位
									END_IF
								END_IF				
								IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[3] THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF										
									TailCurlStep3:=145;
								END_IF	
						END_IF
						
				145:
						IF NOT TailCurlSinStep THEN		
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[5] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=5;//右压好升降上升至下料张开位
									END_IF
								END_IF				
								IF  arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[5] THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF	
									TailCurlStep3:=150;
								END_IF

						END_IF
		
						
				146:
				
					(*IF NOT TailCurlSinStep THEN	
								arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bON:=TRUE;//叠台压隔膜气缸
								IF arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Io.DIOnSwitch THEN
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF							
											TailCurlStep3:=150;	
								END_IF	
					END_IF*)	
						
						
				150://尾卷夹电芯平移至拉膜位、尾卷夹电芯伸缩至初始位、
						IF NOT TailCurlSinStep THEN	
							tailCult_GearInMultiMaster.Enable:=TRUE;//启动尾卷拉膜凸轮耦合
							fbGearInGMvirbEnable:=TRUE;//尾卷拉膜纠偏
							//Par.stDT_date.iTargetTorqueBLXS:=6;
							IF  tailCult_GearInMultiMaster.InGear THEN
								
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.fActPos<LREAL_TO_REAL(arrAxispar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[3]+100) THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=60;
										END_IF
										IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving AND
                                                arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]  THEN
										
											IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] THEN
												arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
												//TailCurlRetMark:=FALSE;//尾卷夹电芯伸缩力矩判断标志
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=1;//尾卷夹电芯伸缩移至初始位
												//TailCurlRetMark:=TRUE;//尾卷夹电芯伸缩力矩判断标志
											END_IF
										END_IF				
										IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
											IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[3] THEN
												TailCurlTorMark:=FALSE;//尾卷夹电芯平移力矩判断标志位
												bFlgGMEndIng:=FALSE;//拉膜中
												arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=3;//尾卷夹电芯平移至拉膜位
												bFlgGMEndIng:=TRUE;//拉膜中
												TailCurlTorMark:=TRUE;//尾卷夹电芯平移力矩判断标志位
											END_IF
										END_IF	
										
				(*					
							//验证：夹膜位更改			
										
										IF 	arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed AND arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.NotMoving THEN
											IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[4] THEN
												arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=0;
												TailCurlSEPTATorMark:=FALSE;//夹膜平移力矩判断标志
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=4;//尾卷夹膜平移至夹膜
												
												TailCurlSEPTATorMark:=TRUE;//夹膜平移力矩判断标志
											END_IF
										END_IF		
		*)
									
										
										
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.fSetPos<=  arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[8] THEN
													IF arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.NoMoving THEN
																IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[3] THEN
																	arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
																ELSE
																	arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=3;
																END_IF						
												END_IF											
										END_IF
										
								END_IF																	
								IF 	(* arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[4] AND*) arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[3] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[3] THEN
											tailCult_GearInMultiMaster.Enable:=FALSE;//启动尾卷拉膜凸轮耦合
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF
											fbGearInGMvirbEnable:=FALSE;
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=100;									
											TailCurlStep3:=160;
											LMcount:=LMcount+1;
								END_IF	
						END_IF
		
				151:	
								
								IF NOT TailCurlSinStep THEN			
										IF arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.NoMoving THEN
													IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[3] THEN
														arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
														IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
															TailCurlSinStep:=TRUE;
														ELSE
															TailCurlSinStep:=FALSE;
														END_IF	
														TailCurlStep3:=160;
													ELSE
														arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=3;
													END_IF						
									END_IF
								END_IF
				160://左、右压刀开合至张开位
					IF NOT TailCurlSinStep THEN		
								arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=100;
								//Par.stDT_date.iTargetTorqueBLXS:=3;		
								IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=2;//左压刀升降轴上升至下料高度
									END_IF
								END_IF					
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=2;//右压好升降上升至下料高度
									END_IF
								END_IF		
								
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=2;//
									END_IF
								END_IF					
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=2;//
									END_IF
								END_IF			
								
								
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[2]  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[2] AND
									arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[2]  THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF		
									TailCurlStep3:=170;
								END_IF
						END_IF		
	
				170:
						IF NOT TailCurlSinStep THEN	
							arrCyCtrl[arrCyNo.ElectValveName.PoleSplintVacuum_D].Cmd.bON:=TRUE;//夹膜下夹板真空	
							arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Cmd.bON:=TRUE;//夹膜下夹板上升
								IF arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.ONState THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF									
									TailCurlStep3:=180;	
								END_IF	
						END_IF		
							
			180:
					
						IF NOT TailCurlSinStep THEN	
							arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bON:=TRUE;//叠台压隔膜气缸
							IF arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.ONState THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF							
										TailCurlStep3:=181;	
							END_IF	
						END_IF	
			181:						
						IF NOT TailCurlSinStep THEN	
									IF 	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.iGoSetPos:=0;
												IF Mach_Control.DT_b.DT_Chesoe THEN
													DT_Readydown:=TRUE;	
												ELSE
													DT_Readydown:=FALSE;	
												END_IF
	
												IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
													TailCurlSinStep:=TRUE;
												ELSE
													TailCurlSinStep:=FALSE;
												END_IF													
																								
												TailCurlStep3:=182;	
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.iGoSetPos:=1;//叠台升降上升至初始位
									END_IF
							END_IF
					END_IF
			182:
						IF NOT DT_Readydown THEN
							TailCurlStep3:=185;
						END_IF
			185://左、右压刀开合移至初始位，叠台上升至初始位
						IF NOT TailCurlSinStep THEN		
									IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=1;//左压刀开合至初始位
										END_IF
									END_IF					
									IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=1;//右压刀开合至初始位
										END_IF
									END_IF
									IF 	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.iGoSetPos:=1;//叠台升降上升至初始位
										END_IF
									END_IF
									IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[1] AND 
										arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.arrbRealPoint[1] THEN
												TailCurlStep3:=190;
												IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
													TailCurlSinStep:=TRUE;
												ELSE
													TailCurlSinStep:=FALSE;
												END_IF	
									END_IF	
						END_IF
				
					



				190://左、右压刀升降下降至初始位，压隔膜
						IF NOT TailCurlSinStep THEN			
									IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=1;//左压刀升降轴下降至初始高度
										END_IF
									END_IF					
									IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=1;//右压好升降下降至初始高度
										END_IF
									END_IF				
									IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF											
										TailCurlStep3:=200;
										hot_time_ton.IN:=FALSE;
									END_IF
						END_IF
						
					(*200:
						Mach_Control.WJ_b.HotCut:=TRUE;//启动热切
						WJ_TON[1].IN:=TRUE;
						TailCurlStep3:=201;		
					
						
				201://热切丝加热、热切升降气缸下降，切隔膜///////////////////////////////
					IF NOT TailCurlSinStep THEN	
					arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bON:=TRUE;//隔膜热切升降气缸伸出
								IF arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.ONState  THEN
										Mach_Control.WJ_b.HotCut:=FALSE;//启动热切
						                WJ_TON[1].IN:=FALSE;
							IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
							ELSE
								TailCurlSinStep:=FALSE;
							END_IF							
									TailCurlStep3:=205;	
								END_IF	
					END_IF	*)
				
				
			
					
				
				
				
				
				
				205://热切升降气缸下降/////////////////////////////////////////
					IF NOT TailCurlSinStep THEN	
						arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;//隔膜热切升降气缸缩回	
							IF arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF									
								TailCurlStep3:=206;	
							END_IF	
					END_IF		
				206://叠台真空打开
					arrCyCtrl[arrCyNo.ElectValveName.DTVacuum].Cmd.bON:=TRUE;
					arrCyCtrl[arrCyNo.ElectValveName.DTVacuum].Cmd.bOFF:=FALSE;
					TailCurlStep3:=207;	
				207:
					CellMemory[Mach_Control.WJ_b.WJ_Memory]:=CellMemory[Mach_Control.DT_b.DT_Memory];
					MEMSET(ADR(CellMemory[Mach_Control.DT_b.DT_Memory]),0,SIZEOF(CellMemory[Mach_Control.DT_b.DT_Memory]));
					TailCurlStep3:=210;
		
				210:
					
						IF NOT TailCurlSinStep THEN	
							arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;//
							IF arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF									
								TailCurlStep3:=211;	
							END_IF	
						END_IF	
				211:
					IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
						IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[5] THEN
							arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
							TailCurlStep3:=213;	
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=5;//尾卷夹膜升降轴尾卷高度
						END_IF
					END_IF		
				

				213:
						IF NOT TailCurlSinStep THEN				
						IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
							IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[7] THEN
								arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF									
								TailCurlStep3:=215;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=7;//尾卷夹电芯平移至回拉膜位
							END_IF
						END_IF	
						END_IF
  
			
						
						
                215://尾卷夹电芯平移至上尾卷电芯位，同时开始耦合
						IF NOT TailCurlSinStep THEN			
								tailCurlGearInEnable:=TRUE;//电子齿轮耦合
								IF 	tailCurl_GearIn.InGear AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND
                                        arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND
                                       arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1]   THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
										tailCurlGearInEnable:=FALSE;//电子齿轮耦合
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF												
										TailCurlStep3:=217;
										TailCurlStep6:=10;//启动判断夹膜平移是否已经在安全位置叠台下料完成	
										WJ_TON[6].IN:=FALSE;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=4;//尾卷夹电芯平移至上尾卷电芯位
									END_IF
								END_IF		
						END_IF	
               
				217:	
					 WJ_TON[6].IN:=TRUE;
					Mach_Control.WJ_b.TailCurlSEPTALineSavePos[1]:=arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].NcToPlc.ActPos;
					arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bMoveRel:=FALSE;
					IF WJ_TON[6].Q THEN
						TailCurlStep3:=218;
						 WJ_TON[6].IN:=FALSE;
					 END_IF	
				 
				218:
				IF NOT TailCurlSinStep THEN	
				IF Mach_Control.WJ_b.TailCurlSEPTALineSavePos[1] -arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].NcToPlc.ActPos>=4.9 
					AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
						IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
						ELSE
								TailCurlSinStep:=FALSE;
						END_IF
					TailCurlStep3:=220;
				ELSIF NOT (Mach_Control.WJ_b.TailCurlSEPTALineSavePos[1] -arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].NcToPlc.ActPos >=4.9 )
						AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
						IF NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Error 
							AND arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed 
							AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Enabled 
							AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
								arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Rel:=20;
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.fPosition_of_Rel:=-5;
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bMoveRel:=TRUE;
						END_IF
				END_IF
				END_IF
						
						
						
				220://长、短卷针旋转到初始位，长、短卷针气缸张开/////////
						IF NOT TailCurlSinStep THEN		
								arrCyCtrl[arrCyNo.ElectValveName.WJ_blow		].Cmd.bON:=	TRUE	;//	夹膜电芯吹气	
						
								arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Cmd.bOFF:=TRUE;//尾卷长卷针张开
								arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Cmd.bOFF:=TRUE;//尾卷短卷针张开
								arrCyCtrl[arrCyNo.ElectValveName.WJShortvacuum].Cmd.bON:=TRUE;//短卷针张开真空开
								IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] THEN
										arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.iGoSetPos:=1;//长卷针旋转至初始位
									END_IF
								END_IF										
								IF 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1] THEN
										arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.iGoSetPos:=1;//短卷针旋转至初始位
									END_IF
								END_IF
								
								
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[5] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=5;//尾卷夹膜升降轴尾卷高度
									END_IF
								END_IF	
								
								
								
								IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] AND 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1] AND
									arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[5]  AND 
                                    					arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Status.OFFState THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF	
									CurlingneedleLineEnable:=FALSE;//长、短卷针平移电子齿轮耦合启动																
									TailCurlStep3:=223;
								END_IF	
						END_IF	
                






			223://长卷针去夹电芯位
				IF NOT TailCurlSinStep THEN		
								
								IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed  
								AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1]
								AND arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Status.OFFState
                                AND  arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Io.biHomeSwitch  THEN
											IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving  THEN
												arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=2;
											END_IF
								ELSE
										Mach_Control.WJ_b.Error[9]:=TRUE;	//长卷针去夹电芯位时条件不满足报警													
								END_IF
										
								IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1]  THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF																	
									TailCurlStep3:=225;
									TON_TailCurl[2].IN:=FALSE;
								END_IF	
						END_IF			
			225:
			
			
						IF NOT TailCurlSinStep THEN	
								 
													IF NOT TON_TailCurl[2].Q THEN					
																arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Cmd.bON:=TRUE;//尾卷长卷针夹紧	
																TON_TailCurl[2].IN:=TRUE;			
													ELSE
														TON_TailCurl[2].IN:=FALSE;
														IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
															TailCurlSinStep:=TRUE;
														ELSE
															TailCurlSinStep:=FALSE;
														END_IF							
														TailCurlStep3:=227;	
												END_IF
									
						END_IF

			227://短卷针去夹电芯位
	
						
					IF NOT TailCurlSinStep THEN													
								IF 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed  
									AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1] AND  arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Status.OFFState 
									AND  arrCyCtrl[arrCyNo.ElectValveName.WJShortvacuum].Io.DOStatus1
                                    AND  arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Io.biHomeSwitch THEN
												IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.NoMoving  THEN
													arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.iGoSetPos:=2;
												END_IF
								ELSE
										Mach_Control.WJ_b.Error[10]:=TRUE;	//短卷针去夹电芯位时条件不满足报警										
												
								END_IF

								IF 		arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1] THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF																	
									TailCurlStep3:=230;
									TON_TailCurl[4].IN:=FALSE;
								END_IF	
						END_IF		
						
			
						
				230://短卷针夹爪气缸夹紧
						IF NOT TailCurlSinStep THEN	
							     
													IF NOT TON_TailCurl[4].Q THEN
														arrCyCtrl[arrCyNo.ElectValveName.WJShortvacuum].Cmd.bOFF:=TRUE;//短卷针张开真空关
														arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Cmd.bON:=TRUE;//尾卷短卷针夹紧	
														
														TON_TailCurl[4].IN:=TRUE;							
													ELSE
														TON_TailCurl[4].IN:=FALSE;
														IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
															TailCurlSinStep:=TRUE;
														ELSE
															TailCurlSinStep:=FALSE;
														END_IF							
														TailCurlStep3:=235;	
														TON_TailCurl[6].IN:=FALSE;
												END_IF
										
						END_IF
				               
				235:
				Mach_Control.WJ_b.TailCurlSEPTALineSavePos[2]:=arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].NcToPlc.ActPos;
				TailCurlStep3:=238;

				238:
				IF NOT TailCurlSinStep THEN	
				IF arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].NcToPlc.ActPos-Mach_Control.WJ_b.TailCurlSEPTALineSavePos[2] >=4.9 
					AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
						IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
						ELSE
								TailCurlSinStep:=FALSE;
						END_IF
					TailCurlStep3:=240;
				ELSIF NOT (arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].NcToPlc.ActPos-Mach_Control.WJ_b.TailCurlSEPTALineSavePos[2] >=4.9 )
					AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
						IF NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Error 
							AND arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed 
							AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Enabled 
							AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
								arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Rel:=20;
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.fPosition_of_Rel:=5;
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bMoveRel:=TRUE;
						END_IF
				END_IF
				END_IF
				
				240://尾卷夹电芯气缸开张
						IF NOT TailCurlSinStep THEN	
							arrCyCtrl[arrCyNo.ElectValveName.WJ_blow].Cmd.bOFF:=TRUE;//	夹膜电芯吹气关
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Cmd.bOFF:=TRUE;//尾卷取料夹爪气缸张开
							TON_TailCurl[6].IN:=TRUE;
							IF arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState AND TON_TailCurl[6].Q	THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF						
								TailCurlStep3:=250;
								TON_TailCurl[6].IN:=FALSE;
							END_IF
						END_IF
				250://尾卷夹电芯平移至初始位，启动尾卷
						IF NOT TailCurlSinStep THEN			
									IF 	arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
											IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[5] THEN
												TailCurlTorMark:=FALSE;//尾卷夹电芯平移力矩判断标志位
												//TailCurlStart:=TRUE;//启动尾卷
												arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=5;//尾卷夹电芯平移至初始位
												TailCurlTorMark:=TRUE;//尾卷夹电芯平移力矩判断标志位
											END_IF
									END_IF	
									
									IF arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState AND  	arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
											IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] THEN
												//TailCurlRetMark:=FALSE;//尾卷夹电芯伸缩力矩判断标志
												arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=1;//尾卷夹电芯伸缩移至初始位
												//TailCurlRetMark:=TRUE;//尾卷夹电芯伸缩力矩判断标志
											END_IF
									END_IF		
									
									IF 		arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND
											 arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
													IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
														TailCurlSinStep:=TRUE;
													ELSE
														TailCurlSinStep:=FALSE;
													END_IF											
													TailCurlStep3:=251;	
													CurlingneedleLineEnable:=TRUE;//长、短卷针平移电子齿轮耦合启动
									END_IF						
						END_IF	
					
						
				251://长、短卷针电子齿轮耦合，移动至尾卷补偿位
						IF NOT TailCurlSinStep THEN		
								
						
								IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving AND CurlingneedleLine_GearIn.InGear THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[3] THEN
										arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=0;
										CurlingneedleLineEnable:=FALSE;//长、短卷针平移电子齿轮耦合启动
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF	
										//IF NOT CurlingneedleLine_GearIn.InGear THEN
											TailCurlStep3:=252;
										//END_IF
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=3;
									END_IF
								END_IF	
						END_IF
						
		    	252:
					IF NOT CurlingneedleLine_GearIn.InGear AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.NoMoving AND 
							(ABS((ABS(arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.fActPos-arrAxisPar[AxiseNo.AxisName.SCurlingneedleLine].arrTargetPoint[2] )-
							ABS(arrAxisPar[AxiseNo.AxisName.LCurlingneedleLine].arrTargetPoint[3]-arrAxisPar[AxiseNo.AxisName.LCurlingneedleLine].arrTargetPoint[2])))<=0.5) THEN
					    TailCurlStep3:=253;
					END_IF
				
				253:
					TailCurlStep0:=50;
					TailCurlStep3:=254;
				254:
					IF TailCurlStep0=6666 THEN
						TailCurlStep3:=255;
					END_IF
				255: 
				  IF  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.fActPos<=arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[5]+1 THEN
						TailCurlStart:=TRUE;//启动尾卷
						TailCurlStep3:=256;
				END_IF 	
				256:
					IF NOT TailCurlSinStep THEN	
						IF arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF	
									TailCurlStep3:=260;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=1;
								END_IF		
						END_IF				
					END_IF					
										
		
				260://等待尾卷完成信号
				
					IF Mach_Control.WJ_b.TailCurlDone (*AND TailCurlStep6=666*) THEN
						TailCurlStart:=FALSE;//启动尾卷
						// Mach_Control.DT_b.OffloadDone:=TRUE;//(已经在TailCurlStep6子程序里置位)
						 arrCyCtrl[arrCyNo.ElectValveName.PoleSplintVacuum_D].Cmd.bOFF:=TRUE;//夹膜下夹板真空	
						IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
							TailCurlSinStep:=TRUE;
						ELSE
							TailCurlSinStep:=FALSE;
						END_IF
						Mach_Control.WJ_b.TailCurlDone	:=FALSE;						
						TailCurlStep3:=271;
					END_IF
					
				270://尾卷取电芯夹爪气缸平夹紧
						IF NOT TailCurlSinStep THEN				
							arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Cmd.bOFF:=TRUE;//尾卷取料夹爪气缸夹紧
							IF arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.OFFState THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF										
								TailCurlStep3:=271;
							END_IF
						END_IF
				
				271://长、短卷针电子齿轮耦合，移动至尾卷补偿位
						IF NOT TailCurlSinStep THEN		
								CurlingneedleLineEnable:=TRUE;//长、短卷针平移电子齿轮耦合启动
								IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving AND CurlingneedleLine_GearIn.InGear  THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=0;
										CurlingneedleLineEnable:=FALSE;//长、短卷针平移电子齿轮耦合启动
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF	
										TailCurlStep3:=272;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=4;
									END_IF
								END_IF	
						END_IF					
					
				272://尾卷夹电芯升降到尾卷完下电芯位
					IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
						IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[7] THEN
							arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
							IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
							ELSE
								TailCurlSinStep:=FALSE;
							END_IF	
							TailCurlStep3:=275;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=7;
						END_IF
					END_IF	
	                           
				275://尾卷取电芯夹爪张开，尾卷夹电芯平移至尾卷取电芯位下电芯
					IF NOT TailCurlSinStep THEN		
                               				
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Cmd.bOFF:=TRUE;//尾卷取料夹爪气缸张开
							IF  arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving  THEN
								TailCurlStep3:=278;
							END_IF		
						END_IF		
				278:
				     IF NOT TailCurlSinStep THEN	
									IF ABS(arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.fActPos - (arrAxisPar[AxiseNo.AxisName.LCurlingneedleWhirling].arrTargetPoint[1]+360)) <=1 AND 					
										arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Io.biHomeSwitch AND
										ABS(arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.fActPos - (arrAxisPar[AxiseNo.AxisName.SCurlingneedleWhirling].arrTargetPoint[1]+360))<=1  AND
										arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Io.biHomeSwitch AND
									    arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Io.biHomeSwitch     AND   arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState AND
                                  		arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Status.ONState AND arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Status.ONState AND  
                                       NOT  arrCyCtrl[arrCyNo.ElectValveName.WJShortvacuum].Io.DOStatus1  AND 
                                       arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed THEN
																IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving  THEN
																	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
																		IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
																			TailCurlSinStep:=TRUE;
																		ELSE
																			TailCurlSinStep:=FALSE;
																		END_IF											
																				TailCurlStep3:=280;
																ELSE
																	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=4;//尾卷夹电芯平移至取电芯位
																END_IF
					
									ELSE
										Mach_Control.WJ_b.Error[7]:=TRUE;//尾卷下料时卷针旋转不满足下料角度----20240116
									END_IF	
				     END_IF	
			(*	279:
					IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[4] THEN
						arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
							IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
							ELSE
								TailCurlSinStep:=FALSE;
							END_IF											
									TailCurlStep3:=280;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=4;//尾卷夹电芯平移至取电芯位
					END_IF*)
				
				280://尾卷取电芯夹爪气缸平夹紧
						IF NOT TailCurlSinStep THEN				
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Cmd.bON:=TRUE;//尾卷取料夹爪气缸夹紧
							IF arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Io.DIOnSwitch THEN
								arrCyCtrl[arrCyNo.ElectValveName.WJ_blow].Cmd.bON:=TRUE;//	夹膜电芯吹气开
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
								TailCurlStep3:=283;
							END_IF
						END_IF
				
				283://夹膜打开
						IF NOT TailCurlSinStep THEN				
							arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Cmd.bOFF:=TRUE;
							
							IF arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.OFFState THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF
								//arrCyCtrl[arrCyNo.ElectValveName.WJ_blow].Cmd.bON:=FALSE;//	夹膜电芯吹气关
								//arrCyCtrl[arrCyNo.ElectValveName.WJ_blow].Cmd.bOFF:=TRUE;//	夹膜电芯吹气关										
								TailCurlStep3:=287;
							END_IF
						END_IF
					
				287:	
					IF arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.OFFState AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Coupled AND 
							NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Coupled THEN
						IF 	 arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
							IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=1;//尾卷夹隔膜平移初始位
							END_IF
						END_IF	
						IF 	 arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
							IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=1;//尾卷夹隔膜升降初始位
							END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1]  THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF				
								TailCurlStep3:=290;	
						END_IF	
					END_IF			








					290://尾卷压轮升降气缸收回、平移气缸收回
						IF NOT TailCurlSinStep THEN		
								arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Cmd.bOFF:=TRUE;//尾卷压轮升降气缸收回
								IF arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Io.DIOFFSwitch THEN
									arrCyCtrl[arrCyNo.CylinderName.TailCurlLineCy].Cmd.bOFF:=TRUE;//尾卷压轮平移气缸收回		
									IF arrCyCtrl[arrCyNo.CylinderName.TailCurlLineCy].Io.DIOFFSwitch THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF	
										TailCurlStep3:=300;
									END_IF
								END_IF
						END_IF
				300://长、短卷针夹电芯气缸泄压、长、短卷针伸缩轴移动至初始位
						IF NOT TailCurlSinStep THEN			
									IF NOT TON_TailCurl[3].Q THEN
										arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Cmd.bFree:=TRUE;//尾卷长卷针泄压
										arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Cmd.bFree:=TRUE;//尾卷短卷针泄压
										//arrCyCtrl[arrCyNo.ElectValveName.WJShortvacuum].Cmd.bON:=TRUE;//短卷针张开真空开
										//arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S_1].Cmd.bOFF:=TRUE;//尾卷短卷针泄压
										TON_TailCurl[3].IN:=TRUE;
									ELSE
										IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving THEN
											IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] THEN
												arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.iGoSetPos:=1;
											END_IF
										END_IF
										IF 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.NoMoving THEN
											IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] THEN
												arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.iGoSetPos:=1;
											END_IF
										END_IF
										IF  arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] THEN
											TON_TailCurl[3].IN:=FALSE;
											arrCyCtrl[arrCyNo.ElectValveName.WJShortvacuum].Cmd.bON:=TRUE;//短卷针张开真空开
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF												
											TailCurlStep3:=305;
										END_IF			
									END_IF
							END_IF	
							
				
							
							
							
							
							
							
							
							
							
				310://尾卷夹电芯平移至初始位
						IF NOT TailCurlSinStep THEN				
								IF 	arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Io.DIOnSwitch AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND
                                         arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]  THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF										
										TailCurlStep3:=315;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=1;//尾卷夹电芯平移至初始位
									END_IF
								END_IF
						END_IF
				
					
						
						315://尾卷夹电芯升降至下电芯位      
						  IF NOT TailCurlSinStep THEN		                                                                                                                                                                                                                                                                                                                                                                                                   		
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[3] THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF									
											TailCurlStep3:=320;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=3;//尾卷夹电芯升降至下电芯位
										END_IF
									END_IF
							END_IF	
						
						
						
						
				320://尾卷夹电芯旋转至下电芯位
						IF NOT TailCurlSinStep THEN				
								IF 	arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.ONState AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed 
									AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND
									arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.fActPos<=arrAxispar[AxiseNo.AxisName.GluingLine].arrTargetPoint[10] 
									AND NOT Mach_Control.TJ_b.StickerFlag  THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF										
										TailCurlStep3:=325;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=2;//尾卷夹电芯平移至下电芯位
									END_IF
								END_IF
						END_IF		
						
				
						
			
				325:
				//尾卷夹电芯去避让位   
					(*	  IF NOT TailCurlSinStep THEN		                                                                                                                                                                                                                                                                                                                                                                                                   		
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[5] THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF									
											TailCurlStep3:=330;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=5;//尾卷夹电芯平移至避让位
										END_IF
									END_IF
							END_IF*)
				//尾卷夹电芯去下料避让位
							IF NOT TailCurlSinStep THEN		                                                                                                                                                                                                                                                                                                                                                                                                   		
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[10] THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF									
											TailCurlStep3:=330;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=10;//尾卷夹电芯平移至避让位
										END_IF
									END_IF
							END_IF
				330:
						IF NOT TailCurlSinStep THEN
								Mach_Control.WJ_b.TailCultOffloading:=TRUE;//下电芯请求														
								TailCurlStep3:=332;
								
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF					
						END_IF				
						

				332:   ///////////////////
						
					IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[8] AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving
						AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving
						AND arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.ONState AND NOT arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.Error2 
						AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving	
						AND NOT Mach_Control.TJ_b.StickerDone  AND NOT Mach_Control.TJ_b.StickerFlag
						AND NOT CellMemory[Mach_Control.TJ_b.TJ_Memory].Cell AND NOT Mach_Control.se.GluebHave	THEN
						TailCurlStep3:=335;

					END_IF
						
				335:
						IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[6] THEN
							arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
							IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
							ELSE
								TailCurlSinStep:=FALSE;
							END_IF									
							TailCurlStep3:=336;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=6;//尾卷夹电芯平移至下电芯位
						END_IF
						
				336:
							IF NOT TailCurlSinStep THEN		
									IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[8] AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving
										AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving
										AND arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.ONState AND NOT arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.Error2 
										AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving		THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[3] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF									
										TailCurlStep3:=337;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=3;//尾卷夹电芯伸缩至下电芯位
										END_IF
									END_IF
							END_IF	
				337:
							IF NOT TailCurlSinStep THEN			
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving  THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[4] THEN
													arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
													IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
													TailCurlSinStep:=TRUE;
													ELSE
														TailCurlSinStep:=FALSE;
													END_IF	
													TailCurlStep3:=338;
									ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=4;//尾卷夹电芯升降至下电芯位
									END_IF
								END_IF	
						END_IF				
						
						
						
						
						
						
				338:
				
						IF NOT TailCurlSinStep THEN				
							arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Cmd.bOFF:=TRUE;//贴胶治具气缸闭合
							IF arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.OFFState THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF										
								TailCurlStep3:=339;
							END_IF
						END_IF


				339:
				

					IF NOT TailCurlSinStep THEN				
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Cmd.bOFF:=TRUE;//尾卷夹爪气缸打开
							IF arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState THEN
								arrCyCtrl[arrCyNo.ElectValveName.WJ_blow].Cmd.bOFF:=TRUE;//	夹膜电芯吹气关
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
								Mach_Control.TJ_b.StickerFlag:=TRUE;//置位贴胶夹爪有料标记
								TailCurlStep3:=340;
							END_IF
						END_IF

				340:
					IF NOT TailCurlSinStep THEN			
						IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving  AND
							arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[4] THEN
							arrAxisPar[AxiseNo.AxisName.TailCurlUpDown].fVelocity_of_Rel := 20   ;
							arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.fPosition_of_Rel :=3 ;
							arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.bMoveRel :=  TRUE ;
						END_IF
							IF arrAxis[AxiseNo.AxisName.TailCurlUpDown].NcToPlc.SetPos-arrAxisPar[AxiseNo.AxisName.TailCurlUpDown].arrTargetPoint[4] >=3  
							AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF
								TailCurlStep3:=341;
							END_IF
					END_IF	
							
				341:// 尾卷夹电芯平移至避让位

						IF NOT TailCurlSinStep THEN			
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[10] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
										TailCurlStep3:=343;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=10;//尾卷夹电芯平移至避让位
									END_IF
								END_IF	
						END_IF	
				343:	
					CellMemory[Mach_Control.TJ_b.TJ_Memory]:=CellMemory[Mach_Control.WJ_b.WJ_Memory];
					MEMSET(ADR(CellMemory[Mach_Control.WJ_b.WJ_Memory]),0,SIZEOF(CellMemory[Mach_Control.WJ_b.WJ_Memory]));		
					TailCurlStep3:=345;		
						
						
						
						
						
						
						
				345:
		
						IF NOT TailCurlSinStep THEN			
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
										
										TailCurlStep3:=350;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=1;//尾卷夹电芯伸缩回到初始位
									END_IF
								END_IF	
						END_IF	
						
						
						
						
				350:
				IF NOT TailCurlSinStep THEN		
					 IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.fActPos<=arrAxispar[AxiseNo.AxisName.GluingLine].arrTargetPoint[10] 
						AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND NOT Mach_Control.WJ_b.TailCultOffloading AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed 
						AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
						
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
									arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
									
									TailCurlStep3:=355;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=1;//尾卷夹电芯平移至初始位
								END_IF
						END_IF	
				END_IF	

				355:
							IF NOT TailCurlSinStep THEN			
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving  THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[4] THEN
													arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
													IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
													TailCurlSinStep:=TRUE;
													ELSE
														TailCurlSinStep:=FALSE;
													END_IF	
													TailCurlStep3:=360;
									ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=4;//尾卷夹电芯升降至下电芯位
									END_IF
								END_IF	
						END_IF
				360:
					IF NOT TailCurlSinStep THEN		
					 IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.fActPos<=arrAxispar[AxiseNo.AxisName.GluingLine].arrTargetPoint[10] 
						AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND NOT Mach_Control.WJ_b.TailCultOffloading AND arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed 
						AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] THEN
						
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
									arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
									//Mach_Control.WJ_b.TailCultOffloadingDone:=TRUE;
									TailCurlStep3:=370;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=1;//尾卷夹电芯旋转至取电芯位
								END_IF
						END_IF	
				END_IF	
                
				 370://尾卷夹电芯平移去取电芯等待位
					 IF NOT TailCurlSinStep THEN	
							 IF  arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
											IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] THEN
												arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=1;//尾卷夹升降去取电芯高度
											END_IF
							 END_IF
						 
						   IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] AND
							  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] AND
							  arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND
							  arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Io.DIOFFSwitch AND arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Io.DIOFFSwitch AND
							  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving  THEN
								   IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[11]  THEN
									  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										   TailCurlSinStep:=TRUE;
										ELSE
										   TailCurlSinStep:=FALSE;
										END_IF									
										   TailCurlStep3:=0;
										   TailCurlTorMark:=FALSE;//尾卷夹电芯平移力矩判断标志位
								   ELSE
									   arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=11;//尾卷夹电芯平移去取电芯等待位
									   TailCurlTorMark:=TRUE;//尾卷夹电芯平移力矩判断标志位
								   END_IF   
							END_IF
						END_IF
				//////////////////////////////////////////////////////////////////////////////////////
				///////////////////////////////////叠台空叠隔膜不尾卷/////////////////////////////////////////////////////
				900:
					    IF NOT TailCurlSinStep THEN
							IF  Mach_Control.DT_b.OffloadRequest AND DP_Step0=6040  THEN
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] THEN//尾卷夹电芯升降初始位
											arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=1;
										END_IF
									END_IF	
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] THEN//夹膜升降初始位
											arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=1;
										END_IF
									END_IF	
									IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] 
										AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1]	THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF								
										TailCurlStep3:=1010;	
										TON_TailCurl[6].IN:=FALSE;
									END_IF
							ELSE
								TailCurlStep3:=0;
							END_IF	
					END_IF
					
				
				
				
				/////////////////////////////////////////////////////////////////////////////////////////////////////
				/////////////////////////////////////////////////////////////////////////////////////////////////////////
				(*1000:
					Par.stDT_date.BH_Thickness :=((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.An_Quantity+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*Par.stDT_date.Ca_Quantity)-((Par.stDT_date.An_Thickness+Par.stDT_date.SEPTA_Thickness)*Mach_Control.An_b.An_Quantited+(Par.stDT_date.Ca_Thickness+Par.stDT_date.SEPTA_Thickness)*Mach_Control.Ca_b.Ca_Quantited);
					TailCurlStep3:=1001;

				1001:
					arrAxispar[AxiseNo.AxisName.TailCurlUpDown].arrTargetPoint[6]:=arrAxispar[AxiseNo.AxisName.TailCurlUpDown].arrTargetPoint[1]-Par.stDT_date.BH_Thickness;
					arrAxispar[AxiseNo.AxisName.TailCurlSEPTAUpDown].arrTargetPoint[3]:=arrAxispar[AxiseNo.AxisName.TailCurlSEPTAUpDown].arrTargetPoint[1]+Par.stDT_date.BH_Thickness;
					TailCurlStep3:=1005;*)




				1000://夹膜升降去取电芯位，夹电芯升降去取电芯位	
						
					    IF NOT TailCurlSinStep THEN
							IF  Mach_Control.DT_b.OffloadRequest THEN
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[6] THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=6;
										END_IF
									END_IF	
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[3] THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=3;
										END_IF
									END_IF	
									IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[6]  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving
										AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[3]  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving	THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF								
										TailCurlStep3:=1010;	
									END_IF
								ELSE
								TailCurlStep3:=0;
								END_IF	
					END_IF
					
		
					
				1010://负极叠片搬运平移轴在安全位置，尾卷夹电芯平移至取电芯位 、尾卷夹电芯伸缩至取电芯位 、尾卷夹膜平移至隔膜切断位///////////////////
	                 IF    NOT TailCurlSinStep AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND  
                           arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] AND
                             arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] AND
							 arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[3] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[6] AND
							  arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]   AND
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.OFFState  AND
                            arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState   THEN			
			
									IF 	 Mach_Control.DT_b.OffloadRequest THEN	
										TailCurlStep3:=1016;		
										(*	
											arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.fOverride:=100;
											arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.fOverride:=100;
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=100;
											
											IF   arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
												IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[2] THEN
													arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=2;//尾卷夹隔膜平移取芯位
												END_IF
											END_IF
											IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
												IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[2] THEN
													arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=2;//尾卷夹电芯伸缩至取电芯位
												END_IF
											END_IF					
											IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
												IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[2] THEN
													arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=2;//尾卷夹电芯平移至取电芯位
												END_IF
											END_IF						
											IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[2] AND
												arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[2]  THEN
												IF  Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
													TailCurlSinStep:=TRUE;
												ELSE
													TailCurlSinStep:=FALSE;
												END_IF	
												TailCurlStep3:=1020;
												TailCurlSplintCy_TON.IN:=FALSE;	
											END_IF
										*)
									ELSE
										TailCurlStep3:=0;
									END_IF	
						ELSE
										Mach_Control.WJ_b.Error[11]:=TRUE;	//尾卷夹电芯平移至取电芯位时条件不满足报警									
						END_IF	

				1016:
					tailCurlGearInEnable1:=TRUE;//夹电芯平移与夹膜平移电子齿轮----取料
					tailRetGearInEnable:=TRUE;//夹电芯平移与夹电芯伸缩电子齿轮
					IF tailCurl_GearIn1.InGear AND tailRetGearIn.InGear THEN
						TailCurlStep3:=1017;
					END_IF			
				1017:
					IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND 
                           arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingUpDown].Cmd.arrbRealPoint[5] AND
                             arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.arrbRealPoint[1] AND
							 arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[3] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[6] AND
							  arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]   AND
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.OFFState  AND
                            arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState       THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
										TailCurlTorMark:=FALSE;//尾卷夹电芯平移力矩判断标志位
										arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
										TailCurlStep3:=1018;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=2;//尾卷夹电芯平移至取电芯位
										TailCurlTorMark:=TRUE;//尾卷夹电芯平移力矩判断标志位
									END_IF
					ELSE
										Mach_Control.WJ_b.Error[11]:=TRUE;	//尾卷夹电芯平移至取电芯位时条件不满足报警
					END_IF		
				1018:
					IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[2] AND
						arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[2]  THEN
						tailCurlGearInEnable1:=FALSE;//夹电芯平移与夹膜平移电子齿轮----取料
						tailRetGearInEnable:=FALSE;//夹电芯平移与夹电芯伸缩电子齿轮
					END_IF
					IF NOT tailCurl_GearIn1.InGear AND NOT tailRetGearIn.InGear THEN
						TailCurlStep3:=1020;
					END_IF			




				
				1020://尾卷夹电芯气缸夹紧//////////////////////////////
						arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.fOverride:=100;
						arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.fOverride:=100;
						arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=100;
						IF NOT TailCurlSinStep THEN					
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Cmd.bON:=TRUE;//尾卷取料夹爪气缸夹紧
							TailCurlSplintCy_TON.IN:=TRUE;					
							IF (*arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Io.DIOnSwitch OR*) TailCurlSplintCy_TON.Q THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF								
								TailCurlStep3:=1030;
								Mach_Control.DT_b.OffloadRequest:=FALSE;//复位电芯下料请求
								TailCurlSplintCy_TON.IN:=FALSE;	
							END_IF
						END_IF
				1030://叠台升降下降至下电芯位	
					IF NOT TailCurlSinStep THEN				
								IF 	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.Homed   THEN
										arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bHome:=FALSE;//叠台升降下降至下电芯位回原点
												IF arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.NoMoving THEN
															IF arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.arrbRealPoint[2] THEN
																arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.iGoSetPos:=0;
																IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
																	TailCurlSinStep:=TRUE;
																ELSE
																	TailCurlSinStep:=FALSE;
																END_IF									
																TailCurlStep3:=1040;
															ELSE
																arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.iGoSetPos:=2;//叠台升降下降至下电芯位
															END_IF
											END_IF
								ELSE
										arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.bHome:=TRUE;//叠台升降下降至下电芯位回原点
								END_IF	
					END_IF
				1040://左、右压刀升降轴上升至抽刀高度
						IF NOT TailCurlSinStep THEN						
								IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=4;//左压刀升降轴上升至抽刀高度
									END_IF
								END_IF					
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[4] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=4;//右压好升降上升至抽刀高度
									END_IF
								END_IF				
								IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[4] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[4] THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF	
									TailCurlStep3:=1050;
								END_IF
						END_IF
				1050://左、右压刀开合轴至张开位
						IF NOT TailCurlSinStep THEN					
								IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=2;//左压刀开合至张开位
									END_IF
								END_IF					
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[3] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=3;//右压刀开合至张开位
									END_IF
								END_IF				
								IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[3] THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF										
									TailCurlStep3:=1060;
								END_IF	
						END_IF
						
				1060:
						IF NOT TailCurlSinStep THEN		
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[5] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=5;//右压好升降上升至下料张开位
									END_IF
								END_IF				
								IF  arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[5] THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF	
									TailCurlStep3:=1070;
								END_IF

						END_IF
		
				1065:
					
						(*IF NOT TailCurlSinStep THEN	
							arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bON:=TRUE;//叠台压隔膜气缸
							IF arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.ONState THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF									
								TailCurlStep3:=1070;	
							END_IF	
						END_IF	*)			
									
						
				1070://尾卷夹电芯平移至拉膜位、尾卷夹电芯伸缩至初始位、
						IF NOT TailCurlSinStep THEN	
							tailCult_GearInMultiMaster.Enable:=TRUE;//启动尾卷拉膜凸轮耦合
							fbGearInGMvirbEnable:=TRUE;//尾卷拉膜纠偏
							arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=30;
							arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.fOverride:=30;
							IF  tailCult_GearInMultiMaster.InGear THEN
								
							
										IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
										
											IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] THEN
												arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=1;//尾卷夹电芯伸缩移至初始位
											END_IF
										END_IF				
									
										IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND
                                               arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]  THEN
											IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[9] THEN
												arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
											ELSE
												arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=9;//尾卷夹电芯平移至对齐度NG切膜位
											END_IF
										END_IF																		
									IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[9]  THEN
											tailCult_GearInMultiMaster.Enable:=FALSE;//启动尾卷拉膜凸轮耦合
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF
											fbGearInGMvirbEnable	:=FALSE;
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=100;
											arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.fOverride:=100;									
											TailCurlStep3:=1075;
											NGcount:=NGcount+1;
								END_IF	
						END_IF
						END_IF
		

					1075:	
							arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.fOverride:=100;
							arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.fOverride:=100;
							IF NOT TailCurlSinStep THEN			
										IF arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.NoMoving THEN
													IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[4] THEN
														arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
														IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
															TailCurlSinStep:=TRUE;
														ELSE
															TailCurlSinStep:=FALSE;
														END_IF	
														TailCurlStep3:=1080;
													ELSE
														arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=4;
													END_IF						
									END_IF
								END_IF
						
	
						
					1080://左、右压刀开合至张开位
						IF NOT TailCurlSinStep THEN		
								
								IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=2;//左压刀升降轴上升至下料高度
									END_IF
								END_IF					
								IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=2;//右压好升降上升至下料高度
									END_IF
								END_IF																	
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=2;//
									END_IF
								END_IF					
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=2;//
									END_IF
								END_IF									
								
								IF  arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[2] AND
									arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[2] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[2]  THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF		
									TailCurlStep3:=1085;
								END_IF
						END_IF		
				1085:
						IF NOT TailCurlSinStep THEN	
							arrCyCtrl[arrCyNo.ElectValveName.PoleSplintVacuum_D].Cmd.bON:=TRUE;//夹膜下夹板真空	
							arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Cmd.bON:=TRUE;//夹膜下夹板上升
								IF arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.ONState THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF									
									TailCurlStep3:=1090;	
								END_IF	
						END_IF	
	
				1090:
					
						IF NOT TailCurlSinStep THEN	
							arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bON:=TRUE;//叠台压隔膜气缸
							IF arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.ONState THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF									
								TailCurlStep3:=1100;
							END_IF	
						END_IF							
			


				1100://左、右压刀开合移至初始位，叠台上升至初始位
						IF NOT TailCurlSinStep THEN		
									IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.iGoSetPos:=1;//左压刀开合至初始位
										END_IF
									END_IF					
									IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.iGoSetPos:=1;//右压刀开合至初始位
										END_IF
									END_IF
									IF 	arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.iGoSetPos:=1;//叠台升降上升至初始位
										END_IF
									END_IF
									IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDLine].Cmd.arrbRealPoint[1] AND 
										arrAxisCtrl[AxiseNo.AxisName.DTUpDown].Cmd.arrbRealPoint[1] THEN
												TailCurlStep3:=1110;
												IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
													TailCurlSinStep:=TRUE;
												ELSE
													TailCurlSinStep:=FALSE;
												END_IF	
									END_IF	
						END_IF
				
					



				1110://左、右压刀升降下降至初始位，压隔膜
						IF NOT TailCurlSinStep THEN			
									IF 	arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.iGoSetPos:=1;//左压刀升降轴下降至初始高度
										END_IF
									END_IF					
									IF 	arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
											arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=0;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.iGoSetPos:=1;//右压好升降下降至初始高度
										END_IF
									END_IF				
									IF arrAxisCtrl[AxiseNo.AxisName.LeftYDUpDown].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.RightYDUpDown].Cmd.arrbRealPoint[1] THEN
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF											
										TailCurlStep3:=1120;
										hot_time_ton.IN:=FALSE;
									END_IF
						END_IF
						
					(*1120:
						Mach_Control.WJ_b.HotCut:=TRUE;//启动热切
						WJ_TON[1].IN:=TRUE;
						TailCurlStep3:=1130;		
					
						
				1130://热切丝加热、热切升降气缸下降，切隔膜///////////////////////////////
					IF NOT TailCurlSinStep THEN	
					arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bON:=TRUE;//隔膜热切升降气缸伸出
								IF arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.ONState  THEN
										Mach_Control.WJ_b.HotCut:=FALSE;//启动热切
						                WJ_TON[1].IN:=FALSE;
							IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
							ELSE
								TailCurlSinStep:=FALSE;
							END_IF							
									TailCurlStep3:=1140;	
								END_IF	
					END_IF*)	
				
				1140://热切升降气缸下降/////////////////////////////////////////
				IF NOT TailCurlSinStep THEN	
					Blueflaging:=FALSE;
					arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bOFF:=TRUE;//隔膜热切升降气缸缩回	
						IF arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.OFFState THEN
							IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
							ELSE
								TailCurlSinStep:=FALSE;
							END_IF									
							TailCurlStep3:=1142;	
						END_IF	
				END_IF	

				1142://叠台真空打开
					arrCyCtrl[arrCyNo.ElectValveName.DTVacuum].Cmd.bON:=TRUE;
					arrCyCtrl[arrCyNo.ElectValveName.DTVacuum].Cmd.bOFF:=FALSE;
					TailCurlStep3:=1145;
					
				1145:
						IF NOT TailCurlSinStep THEN	
							arrCyCtrl[arrCyNo.ElectValveName.PoleSplintVacuum_D].Cmd.bOFF:=TRUE;//夹膜下夹板真空	
							arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Cmd.bOFF:=TRUE;//夹膜下夹板上升
								IF arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.OFFState THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
										TailCurlSinStep:=TRUE;
									ELSE
										TailCurlSinStep:=FALSE;
									END_IF									
									TailCurlStep3:=1148;	
								END_IF	
						END_IF							
				
				1148:
					IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
						IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] THEN
							arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=1;//
						END_IF
					END_IF
					IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] THEN
						TailCurlStep3:=1150;	
					END_IF
	

				1150:
					CellMemory[Mach_Control.WJ_b.WJ_Memory]:=CellMemory[Mach_Control.DT_b.DT_Memory];
					MEMSET(ADR(CellMemory[Mach_Control.DT_b.DT_Memory]),0,SIZEOF(CellMemory[Mach_Control.DT_b.DT_Memory]));
					TailCurlStep3:=1160;
		
				1160:
					
						IF NOT TailCurlSinStep THEN	
							arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Cmd.bOFF:=TRUE;//
							IF arrCyCtrl[arrCyNo.CylinderName.PreDiaph].Status.OFFState THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF									
								TailCurlStep3:=1170;
								TailCurlStep6:=10;//启动判断夹膜平移是否已经在安全位置叠台下料完成	
							END_IF	
						END_IF

				1170:
					IF NOT TailCurlSinStep THEN	
					
						IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND
                                arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1]  AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND
                                 arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1]  THEN
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=1;//尾卷夹电芯平移至初始位
								END_IF
							END_IF	
						IF   arrAxis[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed 
								AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.fActPos<arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[7] THEN
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=1;//尾卷夹隔膜平移至初始位
								END_IF
						END_IF
						IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving 
							AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving AND
							TailCurlStep6=666  THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF									
								TailCurlStep3:=1180;
							END_IF
					END_IF
				1180://尾卷夹电芯升降至下电芯位      
						  IF NOT TailCurlSinStep THEN		                                                                                                                                                                                                                                                                                                                                                                                                   		
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[3] THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;	
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=3;//尾卷夹电芯升降至下电芯位
										END_IF
									END_IF
							IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] THEN
									arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=1;
								END_IF
							END_IF
							IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[3] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving
								AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF									
											TailCurlStep3:=1190;
							END_IF	
						END_IF
						
						
						
				1190://尾卷夹电芯旋转至下电芯位
						IF NOT TailCurlSinStep THEN				
								IF 	(*arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.ONState AND*)  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed 
									AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND
									arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.fActPos<=arrAxispar[AxiseNo.AxisName.GluingLine].arrTargetPoint[10] 
									AND NOT Mach_Control.TJ_b.StickerFlag  THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[2] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF										
										TailCurlStep3:=1200;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=2;//尾卷夹电芯平移至下电芯位
									END_IF
								END_IF
						END_IF		
						
				
						
			
				1200:
				//尾卷夹电芯去下料避让位   
						  IF NOT TailCurlSinStep THEN		                                                                                                                                                                                                                                                                                                                                                                                                   		
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
										IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[10] THEN
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF									
											TailCurlStep3:=1210;
										ELSE
											arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=10;//尾卷夹电芯平移至避让位
										END_IF
									END_IF
							END_IF
				1210:
						IF NOT TailCurlSinStep THEN
								Mach_Control.WJ_b.TailCultOffloading:=TRUE;//下电芯请求														
								TailCurlStep3:=1220;
								
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF					
						END_IF				
						

				1220:   ///////////////////
						
					IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[8] AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving
						AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving
						AND arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.ONState AND NOT arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.Error2 
						AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving	
						AND NOT Mach_Control.TJ_b.StickerDone  AND NOT Mach_Control.TJ_b.StickerFlag
						AND NOT CellMemory[Mach_Control.TJ_b.TJ_Memory].Cell AND NOT Mach_Control.se.GluebHave	THEN
						TailCurlStep3:=1225;
					ELSIF Mach_Control.se.GluebHave AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving THEN
						Mach_Control.TJ_b.Error[9]:=TRUE; //贴胶夹爪有信号无记忆报警
					END_IF
						
				1225:
						IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[6] THEN
							arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
							IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
							ELSE
								TailCurlSinStep:=FALSE;
							END_IF									
							TailCurlStep3:=1230;
						ELSE
							arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=6;//尾卷夹电芯平移至下电芯位
						END_IF
						
						
				1230:
							IF NOT TailCurlSinStep THEN		
									IF 	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.arrbRealPoint[8] AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.NoMoving
										AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Cmd.arrbRealPoint[5] AND arrAxisCtrl[AxiseNo.AxisName.GluingWhirling].Status.NoMoving
										AND arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.ONState AND NOT arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.Error2 
										AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving		THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[3] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											TailCurlSinStep:=TRUE;
										ELSE
											TailCurlSinStep:=FALSE;
										END_IF									
										TailCurlStep3:=1240;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=3;//尾卷夹电芯伸缩至下电芯位
										END_IF
									END_IF
							END_IF	
				1240:
							IF NOT TailCurlSinStep THEN			
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving  THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[4] THEN
													arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
													IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
													TailCurlSinStep:=TRUE;
													ELSE
														TailCurlSinStep:=FALSE;
													END_IF	
													TailCurlStep3:=1260;
									ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=4;//尾卷夹电芯升降至下电芯位
									END_IF
								END_IF	
						END_IF									
(*						
				1250:
				
						IF NOT TailCurlSinStep THEN				
							arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Cmd.bOFF:=TRUE;//贴胶治具气缸闭合
							IF arrCyCtrl[arrCyNo.CylinderName.PullGlueModelCy].Status.OFFState THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF										
								TailCurlStep3:=1260;
							END_IF
						END_IF
*)

				1260:
				

					IF NOT TailCurlSinStep THEN				
							arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Cmd.bOFF:=TRUE;//尾卷夹爪气缸打开
							IF arrCyCtrl[arrCyNo.CylinderName.TailCurlSplintCy].Status.OFFState THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
								Mach_Control.TJ_b.StickerFlag:=TRUE;//置位贴胶夹爪有料标记
								TailCurlStep3:=1265;
							END_IF
						END_IF

				1265:
					IF NOT TailCurlSinStep THEN			
						IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving  AND
							arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[4] THEN
							arrAxisPar[AxiseNo.AxisName.TailCurlUpDown].fVelocity_of_Rel := 20   ;
							arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.fPosition_of_Rel :=3 ;
							arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.bMoveRel :=  TRUE ;
						END_IF
							IF arrAxis[AxiseNo.AxisName.TailCurlUpDown].NcToPlc.SetPos-arrAxisPar[AxiseNo.AxisName.TailCurlUpDown].arrTargetPoint[4] >=3  
							AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF
								TailCurlStep3:=1270;
							END_IF
					END_IF	
									
							
				1270:// 尾卷夹电芯平移至下料避让位
						IF NOT TailCurlSinStep THEN			
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[10] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
										TailCurlStep3:=1280;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=10;//尾卷夹电芯平移至下料避让位
									END_IF
								END_IF	
						END_IF	



				1280:	
					CellMemory[Mach_Control.TJ_b.TJ_Memory]:=CellMemory[Mach_Control.WJ_b.WJ_Memory];
					MEMSET(ADR(CellMemory[Mach_Control.WJ_b.WJ_Memory]),0,SIZEOF(CellMemory[Mach_Control.WJ_b.WJ_Memory]));		
					TailCurlStep3:=1290;		
						
						
						
						
						
						
						
				1290:
		
						IF NOT TailCurlSinStep THEN			
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Status.NoMoving THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.arrbRealPoint[1] THEN
										arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=0;
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
										
										TailCurlStep3:=1300;
									ELSE
										arrAxisCtrl[AxiseNo.AxisName.TailCurlRetracting].Cmd.iGoSetPos:=1;//尾卷夹电芯伸缩回到初始位
									END_IF
								END_IF	
						END_IF	
						
						
						
						
				1300:
				IF NOT TailCurlSinStep THEN		
					 IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.fActPos<=arrAxispar[AxiseNo.AxisName.GluingLine].arrTargetPoint[10] 
						AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND NOT Mach_Control.WJ_b.TailCultOffloading AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed 
						AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving THEN
						
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
									arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
									//Mach_Control.WJ_b.TailCultOffloadingDone:=TRUE;
									TailCurlStep3:=1305;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=1;//尾卷夹电芯平移至初始位
								END_IF
						END_IF	
				END_IF	

				1305:
							IF NOT TailCurlSinStep THEN			
								IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving  THEN
									IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[4] THEN
													arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
													IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
													TailCurlSinStep:=TRUE;
													ELSE
														TailCurlSinStep:=FALSE;
													END_IF	
													TailCurlStep3:=1310;
									ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=4;//尾卷夹电芯升降至下电芯位
									END_IF
								END_IF	
						END_IF	
				
				1310:
					IF NOT TailCurlSinStep THEN		
					 IF arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.fActPos<=arrAxispar[AxiseNo.AxisName.GluingLine].arrTargetPoint[10] 
						AND arrAxisCtrl[AxiseNo.AxisName.GluingLine].Status.Homed AND NOT Mach_Control.WJ_b.TailCultOffloading AND arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed 
						AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[1] THEN
						
								IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] THEN
									IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF	
									arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=0;
									
									TailCurlStep3:=1320;
								ELSE
									arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.iGoSetPos:=1;//尾卷夹电芯旋转至取电芯位
								END_IF
						END_IF	
				END_IF	
	
	            1320://尾卷夹电芯平移去取电芯等待位
					 IF NOT TailCurlSinStep THEN	
								 IF  arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Status.NoMoving THEN
												IF arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] THEN
													arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=0;
												ELSE
													arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.iGoSetPos:=1;//尾卷夹升降去取电芯高度
												END_IF
								 END_IF
							 
							   IF arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.TailCurlUpDown].Cmd.arrbRealPoint[1] AND
								  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] AND
								  arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1] AND
								  arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Io.DIOFFSwitch AND arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Io.DIOFFSwitch AND
								  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Status.NoMoving  THEN
									   IF arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.arrbRealPoint[11]  THEN
										  arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=0;
											IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
											   TailCurlSinStep:=TRUE;
											ELSE
											   TailCurlSinStep:=FALSE;
											END_IF									
											   TailCurlStep3:=0;
											   TailCurlTorMark:=FALSE;//尾卷夹电芯平移力矩判断标志位
									   ELSE
										   arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.iGoSetPos:=11;//尾卷夹电芯平移去取电芯等待位
										   TailCurlTorMark:=TRUE;//尾卷夹电芯平移力矩判断标志位
									   END_IF   
								END_IF
					  END_IF
	
	
	END_CASE	
ELSE
	//tailCult_GearInMultiMaster.Enable:=FALSE;//尾卷拉膜耦合放卷虚轴
//	tailCurlGearInEnable:=FALSE;//夹电芯平移轴与夹隔膜平移轴电子齿轮耦合
//	fbGearInGMvirbEnable	:=FALSE;	//隔膜纠䐔
;
END_IF	

CASE TailCurlStep3 OF 
	
		

	   200:
	   				IF NOT TailCurlSinStep THEN	
						
							hot_time_ton.IN:=TRUE;
							IF NOT arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bON AND NOT  arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.ONState AND NOT hot_time_ton.Q THEN
								Mach_Control.WJ_b.HotCut:=TRUE;//启动热切
							END_IF
							
							IF hot_time_ton.Q THEN
							arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bON:=TRUE;//隔膜热切升降气缸伸出
							END_IF
							
							IF arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.ONState  THEN
									Mach_Control.WJ_b.HotCut:=FALSE;//启动热切
									WJ_TON[1].IN:=FALSE;
									hot_time_ton.IN:=FALSE;
									TailCurlStep3:=205;	
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF								
							END_IF	
					END_IF
					


		305:
		
						
			SLCurlingneedleLine_TON.IN:=arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Status.OFFState ;
				arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Cmd.bOFF:=TRUE;//尾卷长卷针张开
				arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Cmd.bOFF:=TRUE;//尾卷短卷针张开
				//arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S_1].Cmd.bON:=TRUE;//尾卷短卷针泄压关闭
				IF 	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.NoMoving THEN
					IF arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.arrbRealPoint[1] THEN
						arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.iGoSetPos:=0;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Cmd.iGoSetPos:=1;//长卷针旋转至初始位
					END_IF
				END_IF										
				IF 	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.NoMoving THEN
					IF arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.arrbRealPoint[1] THEN
						arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.iGoSetPos:=0;
					ELSE
						arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Cmd.iGoSetPos:=1;//短卷针旋转至初始位
					END_IF
				END_IF
				IF 	 arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Moving AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Moving AND
					arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_L].Status.OFFState AND arrCyCtrl[arrCyNo.CylinderName.CurlingSplintCy_S].Status.OFFState THEN														
					TailCurlStep3:=310;
				END_IF	
						

		1120:
	   				IF NOT TailCurlSinStep THEN	
						
							hot_time_ton.IN:=TRUE;
							IF NOT arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bON AND NOT  arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.ONState AND NOT hot_time_ton.Q THEN
								Mach_Control.WJ_b.HotCut:=TRUE;//启动热切
							END_IF
							
							IF hot_time_ton.Q THEN
							arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Cmd.bON:=TRUE;//隔膜热切升降气缸伸出
							END_IF
							
							IF arrCyCtrl[arrCyNo.CylinderName.PoleHotCutterCy].Status.ONState  THEN
									Mach_Control.WJ_b.HotCut:=FALSE;//启动热切
									WJ_TON[1].IN:=FALSE;
									hot_time_ton.IN:=FALSE;
									TailCurlStep3:=1140;	
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF								
							END_IF	
					END_IF			
				
				
				
END_CASE

 CASE TailCurlStep6 OF
10:
	IF (arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.fActPos<=(arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[1]+1)) OR Mach_Control.WJ_b.TailCurlDone  THEN
						 Mach_Control.DT_b.OffloadDone:=TRUE;
						 TailCurlStep6:=20;
					END_IF
					
20:
	TailCurlStep6:=666;

END_CASE 













//尾卷拉膜耦合放卷虚轴			
tailCult_GearInMultiMaster(
	Master1:=arrAxis[AxiseNo.AxisName.TailCurlRetracting] , 
	Master2:=arrAxis[AxiseNo.AxisName.TailCurlLine]  , 
	Master3:=arrAxis[AxiseNo.VirAxisName.VirDriver]  , 
	Master4:=arrAxis[AxiseNo.VirAxisName.VirDriver]  , 
	Slave:=arrAxis[AxiseNo.VirAxisName.VirDriver], 
	Enable:=tailCult_GearInMultiMaster.Enable , 
	GearRatio1:=-1 , 
	GearRatio2:=-1 , 
	GearRatio3:=0 , 
	GearRatio4:=0, 
	Acceleration:= , 
	Deceleration:= , 
	Jerk:= , 
	BufferMode:= , 
	Options:= , 
	InGear=> , 
	Busy=> , 
	Active=> , 
	CommandAborted=> , 
	Error=> , 
	ErrorID=> );				
tailCult_GearInMultiMaster.Error;
tailCult_GearInMultiMaster.Busy;	

//放卷虚轴解除耦合
fTailCurl_TRIG(CLK:=tailCult_GearInMultiMaster.Enable , Q=> );
tailCurl_CamOut(
	Slave:=arrAxis[AxiseNo.VirAxisName.VirDriver]  , 
	Execute:=fTailCurl_TRIG.Q , 
	Options:= , 
	Done=> , 
	Busy=> , 
	Error=> , 
	ErrorID=> );	
	
	
		
//夹电芯平移轴与夹隔膜平移轴电子齿轮耦合
	
	tailCurl_GearIn(
	Reset:=        stSysState.bReset  , 
	fratio1:= 1, 
	bError=> , 
	bReady=> , 
	InGear=> , 
	bEnable:=     tailCurlGearInEnable    , 
	master:=       arrAxis[AxiseNo.AxisName.TailCurlLine]  , 
	slave1:=        arrAxis[AxiseNo.AxisName.TailCurlSEPTALine], );
	tailCurl_GearIn.InGear;
	tailCurl_GearIn.bError;
	tailCurl_GearIn.bReady;
	
	
//夹电芯平移轴与夹隔膜平移轴电子齿轮耦合--取料
tailCurl_GearIn1.fratio1:=(arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[2]-arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[1])/(arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[2]-arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[11]);;
tailCurl_GearIn1(
	Reset:=        stSysState.bReset  , 
	fratio1:= , 
	bError=> , 
	bReady=> , 
	InGear=> , 
	bEnable:=     tailCurlGearInEnable1    , 
	master:=       arrAxis[AxiseNo.AxisName.TailCurlLine]  , 
	slave1:=        arrAxis[AxiseNo.AxisName.TailCurlSEPTALine], );
	tailCurl_GearIn1.InGear;
	tailCurl_GearIn1.bError;
	tailCurl_GearIn1.bReady;
		
	
	
//尾卷夹电芯伸缩取料齿轮耦合
tailRetGearIn.fratio1:=(arrAxisPar[AxiseNo.AxisName.TailCurlRetracting].arrTargetPoint[2]-arrAxisPar[AxiseNo.AxisName.TailCurlRetracting].arrTargetPoint[1])/(arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[2]-arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[11]);
	tailRetGearIn(
	Reset:=        stSysState.bReset  , 
	fratio1:= , 
	bError=> , 
	bReady=> , 
	InGear=> , 
	bEnable:=     tailRetGearInEnable    , 
	master:=       arrAxis[AxiseNo.AxisName.TailCurlLine]  , 
	slave1:=        arrAxis[AxiseNo.AxisName.TailCurlRetracting], );
	tailRetGearIn.InGear;
	tailRetGearIn.bError;
	tailRetGearIn.bReady;
	


//长、短卷针平移电子齿轮耦合  CurlingneedleLine    FB_GearInDyn
	CurlingneedleLine_GearIn(
	Reset:=        stSysState.bReset  , 
	fratio1:= -1, 
	bError=> , 
	bReady=> , 
	InGear=> , 
	bEnable:=     CurlingneedleLineEnable    , 
	master:=       arrAxis[AxiseNo.AxisName.LCurlingneedleLine]  , 
	slave1:=        arrAxis[AxiseNo.AxisName.SCurlingneedleLine], );
	
	CurlingneedleLine_GearIn.InGear;
	CurlingneedleLine_GearIn.bError;
	CurlingneedleLine_GearIn.bReady;
	
	
	
	
]]></ST>
      </Implementation>
    </Action>
    <Action Name="TailCurl_Auto2" Id="{49b6b37e-6406-4c24-824b-d60494d0c243}" FolderPath="04TailCurl\">
      <Implementation>
        <ST><![CDATA[//判断尾卷是否有轴在耕合中
IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Coupled OR arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Coupled OR  
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Coupled OR arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Coupled THEN
	TailCurlCoupling:=TRUE;//尾卷轴耦合中
ELSE
	TailCurlCoupling:=FALSE;
END_IF



IF Mach_Control.U.WJ_iMode=1  THEN//在自动状态下
//尾卷电芯自动
		CASE TailCurlStep4 OF
			0://判断尾卷是否启动
					IF TailCurlStart THEN
						TailCurlStart:=FALSE;//复位尾卷启动
						Mach_Control.WJ_b.TailCurlDone:=FALSE;	//尾卷完成
						arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bMoveAbs:=FALSE;//主轴启动
						TailCurlStep4:=10;
					END_IF
			10://尾卷凸轮耦合，判断尾卷主轴是停止、当前位置是否为0
				 	IF arrAxis[AxiseNo.VirAxisName.VirTailCurl].Status.NotMoving AND ABS(arrAxis[AxiseNo.VirAxisName.VirTailCurl].NcToPlc.ActPos)<=0.1 AND NOT TailCurlCoupling THEN
						TailCurlStep4:=30;
					ELSE
						TailCurlStep0:=50;
						TailCurlStep4:=20;			
					END_IF		
			20://等待主轴停止并且清零完成
					IF TailCurlStep0=6666 THEN
						TailCurlStep4:=30;	
					END_IF
					
			30://凸轮耦合
					fbCamInEndWindX.bCamInExecute:=TRUE;//夹膜平移轴凸轮耦合
					fbCamInEndWindY.bCamInExecute:=TRUE;//夹膜升降轴凸轮耦合
					tailCurl1_GearIn.Execute:=TRUE;//短卷针齿轮耦合
					tailCurl2_GearIn.Execute:=TRUE;//长卷针齿轮耦合
					IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Coupled AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Coupled AND   
						arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Coupled AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Coupled THEN
						TailCurlStep4:=40;	
					END_IF
			40://主轴启动
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bDynamitcsParSel:=2;
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.fPositon_of_Abs:=359.5*Par.stWJ_date.SumNo;
					arrAxisPar[AxiseNo.VirAxisName.VirTailCurl].fTagatTime:=Par.stWJ_date.CoeSpeed;
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bMoveAbs:=TRUE;
					TailCurlStep4:=50;	
					TailCurlStep5:=10;//夹膜平移超限凸轮解除耦合
			50://	解除夹隔平移、夹隔升降凸轮耦合	
				IF NOT TailCurlSinStep THEN
					IF arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.fSetPos=359.5*Par.stWJ_date.SumNo AND arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.NoMoving AND 
                       TailCurlStep5=6666 THEN				
						fbCamInEndWindX.bCamInExecute:=FALSE;//夹膜平移轴凸轮耦合					
						fbCamInEndWindY.bCamInExecute:=FALSE;//夹膜升降轴凸轮耦合
						IF NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Coupled THEN
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
									TailCurlSinStep:=TRUE;
								ELSE
									TailCurlSinStep:=FALSE;
								END_IF
							TailCurlStep0 :=50;
							TailCurlStep4:=60;	
						END_IF
					END_IF
				END_IF
			60:
				IF TailCurlStep0=6666 THEN
					Mach_Control.WJ_b.TailCurlDone	:=TRUE;	//尾卷完成
					TailCurlStep4:=0;
				END_IF
			(*60://压隔膜平移气缸伸出、压隔膜平移升降气缸	
				arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Cmd.bOFF:=TRUE;//尾卷夹隔膜下夹板收回位
				//arrCyCtrl[arrCyNo.CylinderName.TailCurlLineCy].Cmd.bON:=TRUE;//尾卷压轮平移气缸伸出
				//IF arrCyCtrl[arrCyNo.CylinderName.TailCurlLineCy].Status.ONState THEN
					//arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Cmd.bON:=TRUE;//尾卷压轮升降气缸下降
					//IF arrCyCtrl[arrCyNo.CylinderName.TailCurlUpdownCy].Status.ONState THEN
						TailCurlStep4:=70;
				//	END_IF				
				//END_IF
			70://夹隔膜平移至初始位，夹隔膜升降至初始位
				
				IF arrCyCtrl[arrCyNo.CylinderName.PoleSplintCy_D].Status.OFFState THEN
						IF 	 arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
							IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.iGoSetPos:=1;//尾卷夹隔膜平移初始位
							END_IF
						END_IF	
						IF 	 arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.NoMoving THEN
							IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1] THEN
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=0;
							ELSE
								arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.iGoSetPos:=1;//尾卷夹隔膜升降初始位
							END_IF
						END_IF
						IF 	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.arrbRealPoint[1] AND  arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Cmd.arrbRealPoint[1]  THEN
							TailCurlStep0 :=50;
							Mach_Control.WJ_b.TailCurlDone	:=TRUE;	//尾卷完成
							TailCurlStep4:=0;
						END_IF	
				END_IF		
			80://启动主轴
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bDynamitcsParSel:=2;
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.fPositon_of_Abs:=540;
					arrAxisPar[AxiseNo.VirAxisName.VirTailCurl].fTagatTime:=20;
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bMoveAbs:=TRUE;	
					TailCurlStep4:=90;
			90://判断主轴运动是否完成
					IF arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.fSetPos=540 AND arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.NoMoving THEN
							tailCurl1_GearIn.Execute:=FALSE;//短卷针齿轮耦合
							tailCurl2_GearIn.Execute:=FALSE;//长卷针齿轮耦合
							IF NOT arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleWhirling].Status.Coupled AND NOT arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleWhirling].Status.Coupled  THEN
								Mach_Control.WJ_b.TailCurlDone	:=TRUE;	//尾卷完成
								TailCurlStep0 :=50;
								TailCurlStep4:=0;	
							END_IF
					END_IF	*)		
		END_CASE
		
//尾卷主轴停止，当前位置清零
		CASE TailCurlStep0 OF
				50:
					TailCurlStep0:=100;
					
				100://判断主轴是否在运动中
					IF NOT TailCurlSinStep THEN
						IF arrAxis[AxiseNo.VirAxisName.VirTailCurl].Status.NotMoving  THEN
							arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bStop:=FALSE;
							TailCurlStep0:=110;
								IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF
						ELSE
							arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bStop:=TRUE;//尾卷主轴停止
						END_IF
						END_IF
				110://判断尾卷轴是否在耦合中
					IF NOT TailCurlSinStep THEN
						IF TailCurlCoupling  THEN
								TailCurlStep0:=120;
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF
						ELSE
								TailCurlStep0:=130;
										IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
												TailCurlSinStep:=TRUE;
											ELSE
												TailCurlSinStep:=FALSE;
											END_IF
						END_IF
						END_IF
				120://尾卷凸轮解除耦合
						fbCamInEndWindX.bCamInExecute:=FALSE;
						fbCamInEndWindY.bCamInExecute:=FALSE;
						tailCurl1_GearIn.Execute:=FALSE;//短卷针齿轮耦合
						tailCurl2_GearIn.Execute:=FALSE;//长卷针齿轮耦合
						IF  NOT TailCurlCoupling THEN
							TailCurlStep0:=125;
						END_IF
						
				125:
					IF NOT TailCurlSinStep THEN
						arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bStop:=TRUE;
						IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Coupled THEN
							
							IF Mach_Control.WJ_b.SinStepMode THEN//尾卷单步模式
								TailCurlSinStep:=TRUE;
							ELSE
								TailCurlSinStep:=FALSE;
							END_IF	
							arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bStop:=FALSE;
							TailCurlStep0:=130;
						END_IF
					END_IF
				130://主轴当前位置清零
						IF NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Coupled AND 
							NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTAUpDown].Status.Coupled THEN
									arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.fSetPos:=0;
									arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bSetPos:=TRUE;	
									TailCurlStep0:=140;
						END_IF
				140://判断主轴清零是否完成
						//IF arrAxis[AxiseNo.VirAxisName.VirTailCurl].Status.NotMoving  AND arrAxis[AxiseNo.VirAxisName.VirTailCurl].NcToPlc.SetPos=0 THEN		
							TailCurlStep0:=150;
						//END_IF
						
						
				150:
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bEnable:=FALSE;
					WJ_TON[3](IN:=NOT arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bEnable, PT:=T#20MS, Q=> , ET=> );	
					IF WJ_TON[3].Q  THEN
						arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bSetPos:=FALSE;
						arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bStop:=FALSE;	
						WJ_TON[3](IN:=FALSE);	
						TailCurlStep0:=160;
					END_IF
				160:
					WJ_TON[4](IN:=FALSE);	
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bEnable:=TRUE;	
					TailCurlStep0:=170;
				170:
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bReset:=TRUE;
					WJ_TON[4](IN:=TRUE, PT:=T#20MS, Q=> , ET=> );	
					IF WJ_TON[4].Q THEN
						WJ_TON[4](IN:=FALSE);	
						TailCurlStep0:=180;
					END_IF
				180:	
					arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bReset:=FALSE;	
					TailCurlStep0:=190;
						
				190:		
					IF arrAxis[AxiseNo.VirAxisName.VirTailCurl].Status.NotMoving  AND arrAxis[AxiseNo.VirAxisName.VirTailCurl].NcToPlc.SetPos=0 
						AND arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Cmd.bEnable THEN
						TailCurlStep0:=6666;
					END_IF		
						
		END_CASE
END_IF


CASE  TailCurlStep5 OF
10:
	IF arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.fActPos>0  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.fSetPos<=(par.stWJ_date.WJ_PoistCamOut+2 ) 
		AND arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.fActPos<=357 THEN//解耦
		fbCamInEndWindX.bGearOutMode:=TRUE;//夹膜平移轴凸轮耦合
		fbCamInEndWindX.bCamInExecute:=FALSE;//夹膜平移轴凸轮耦合
		
		IF NOT fbCamInEndWindX.bCamInExecute THEN
			TailCurlStep5:=100;
		END_IF
	ELSIF arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.fActPos>357 AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.fSetPos>=par.stWJ_date.WJ_PoistCamOut THEN//不解耦
		TailCurlStep5:=6666;
	END_IF
	
100:
	IF NOT  fbCamInEndWindX.bCamInExecute AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.Coupled AND NOT fbCamInEndWindX.bInSync  THEN
		TailCurlStep5:=200;
	END_IF
200://高速定位停止
	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bDynamitcsParSel:=2;
	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.fPositon_of_Abs:=par.stWJ_date.WJ_PoistCamOut-1;
	arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fTagatTime:= 0.02;//3.33333/arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].fVelocity_of_Abs+0.01 
	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bMoveAbs:=TRUE;
	TailCurlStep5:=300;
300:
	IF ABS(arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.fActPos+1-par.stWJ_date.WJ_PoistCamOut)<=0.5 AND NOT arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bMoveAbs
	AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.NoMoving THEN
		arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bMoveAbs:=FALSE;
		TailCurlStep5:=400;
	END_IF
400:
	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bDynamitcsParSel:=1;
	fbCamInEndWindX.bGearOutMode:=FALSE;//夹膜平移轴凸轮耦合
	IF arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.bDynamitcsParSel=1 THEN
		TailCurlStep5:=6666;
	END_IF
END_CASE

(*
CASE  TailCurlStep5 OF
			10:
					IF 	 arrAxisCtrl[AxiseNo.VirAxisName.VirTailCurl].Status.fActPos>0  AND arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Status.fSetPos<=par.stWJ_date.WJ_PoistCamOut   THEN
							fbCamInEndWindX.bCamInExecute:=FALSE;//夹膜平移轴凸轮耦合
							//arrAxisCtrl[AxiseNo.AxisName.SEPTATLine].Cmd.bStop:=TRUE;
					END_IF
					IF NOT fbCamInEndWindX.bCamInExecute THEN
						TailCurlStep5:=6666;
					END_IF
END_CASE
*)
(**************************************夹膜平移正常解耦位计算******************************************************)
arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[4]:=arrAxisPar[AxiseNo.AxisName.TailCurlSEPTALine].arrTargetPoint[2]
								-(arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[7]-arrAxisPar[AxiseNo.AxisName.TailCurlLine].arrTargetPoint[4])
								-(fbRoll_New.AxisXmm*2);





]]></ST>
      </Implementation>
    </Action>
    <Action Name="TailCurl_Condition" Id="{7a4142b8-c225-48ac-8d7f-359b5d374af4}" FolderPath="04TailCurl\">
      <Implementation>
        <ST><![CDATA[//尾卷夹电芯平移轴移动至初始位置的安全件件
(*
IF  arrAxis[AxiseNo.AxisName.TailCurlWhirling].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.NoMoving AND
	(arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[1] OR arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Cmd.arrbRealPoint[2]) AND	
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Cmd.arrbRealPoint[1] AND 
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Cmd.arrbRealPoint[1]  
OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.GoPoint_Condition[1]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.GoPoint_Condition[1]:=FALSE;
END_IF

//尾卷夹隔膜轴移动至取电芯位的安全条件
IF arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.Homed AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Status.NoMoving AND arrAxisCtrl[AxiseNo.AxisName.CaDTCarryingLine].Cmd.arrbRealPoint[1] 
OR Mach_Control.WJ_b.AxisConditionEN THEN	
	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.GoPoint_Condition[2]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.TailCurlSEPTALine].Cmd.GoPoint_Condition[2]:=FALSE;	
END_IF
*)

/////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////
////////////////////////////////////////////电机条件
//尾卷夹电芯平移 
IF  Mach_Control.U.WJ_iMode=3 AND 
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.fActPos<=arrAxisPar[AxiseNo.AxisName.LCurlingneedleLine].arrTargetPoint[1]+1 AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed  AND
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.fActPos <=arrAxisPar[AxiseNo.AxisName.SCurlingneedleLine] .arrTargetPoint[1]+1 AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed AND 
	(arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fActPos<=arrAxisPar[AxiseNo.AxisName.TailCurlWhirling].arrTargetPoint[1]+1 AND
	arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fActPos>=arrAxisPar[AxiseNo.AxisName.TailCurlWhirling].arrTargetPoint[1]-1	) OR 
	(arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fActPos<=arrAxisPar[AxiseNo.AxisName.TailCurlWhirling].arrTargetPoint[2]+1 AND
	arrAxisCtrl[AxiseNo.AxisName.TailCurlWhirling].Status.fActPos>=arrAxisPar[AxiseNo.AxisName.TailCurlWhirling].arrTargetPoint[2]-1	) 
    OR Mach_Control.WJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.Home_Condition:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.Home_Condition:=FALSE;	
END_IF

IF Mach_Control.U.WJ_iMode=3 AND
	arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.fActPos<=arrAxisPar[AxiseNo.AxisName.LCurlingneedleLine].arrTargetPoint[1]+1 AND arrAxisCtrl[AxiseNo.AxisName.LCurlingneedleLine].Status.Homed  AND
	arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.fActPos <=arrAxisPar[AxiseNo.AxisName.SCurlingneedleLine] .arrTargetPoint[1]+1 AND arrAxisCtrl[AxiseNo.AxisName.SCurlingneedleLine].Status.Homed 
 THEN
   arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.JogP_Condition:=TRUE;
   arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.JogN_Condition:=TRUE;
   ELSE 
   arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.JogP_Condition:=FALSE;
   arrAxisCtrl[AxiseNo.AxisName.TailCurlLine].Cmd.JogN_Condition:=FALSE;
 END_IF

