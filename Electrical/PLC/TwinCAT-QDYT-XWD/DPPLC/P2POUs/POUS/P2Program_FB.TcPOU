 OR Mach_Control.TJ_b.AxisConditionEN THEN
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[5]:=TRUE;
ELSE
	arrAxisCtrl[AxiseNo.AxisName.GluingLine].Cmd.GoPoint_Condition[5]:=FALSE;	
