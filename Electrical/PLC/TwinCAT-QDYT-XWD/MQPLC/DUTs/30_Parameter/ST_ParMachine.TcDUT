	   fBelt2Scaling                      :REAL:=1   ;  //踢废倒装皮带定长比例系数
	   fBelt3Scaling                      :REAL:=1   ;  //上表面除尘皮带定长比例系数
	   fBelt4Scaling                      :REAL:=1   ;  //下表面除尘倒装皮带定长比例系数
	   fBelt5Scaling                      :REAL:=1   ;  //送料分段皮带1定长比例系数	   
	   fBelt6Scaling                      :REAL:=1   ;  //送料分段皮带2定长比例系数	   
	   fBelt7Scaling                      :REAL:=1   ;  //送料分段皮带3定长比例系数	  	   
//叠片主驱动  70
//叠片辅驱动  30
//NG皮带 46































END_STRUCT
END_TYPE]]></Declaration>
