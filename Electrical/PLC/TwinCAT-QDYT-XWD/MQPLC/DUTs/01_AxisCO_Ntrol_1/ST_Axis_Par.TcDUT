	fVelocity_of_Mod	 :REAL:=5;				
	fVelocity_of_Rel	 :REAL:=5;				
	fVelocity_of_Velo	 :REAL:=5;				
	fVelocity_of_Jog	 :REAL:=10;			
	fInchingDistance	 :REAL:=5;				

	arrTargetPoint: ARRAY [0..10] OF REAL;
	//fMaxVelocity:        REAL:=0;	
