    fMaxAccDec                              :LREAL:=50000;//最大加速度
    fMaxVel                                   :LREAL:=2000;//最大速度

	fHomePosition                     :REAL:=10 ;	                          
	fHomeFastSpeed                  :REAL:=20 ;	 
	fHomeSlowSpeed                 :REAL:=10;	 
    HomeLimitDis                       :REAL:=5;	 

	

END_STRUCT
END_TYPE]]></Declaration>
