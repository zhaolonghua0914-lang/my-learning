<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_CCDComCuter" Id="{16e91578-ac2d-46df-954f-55c8f9902c16}">
    <Declaration><![CDATA[TYPE ST_CCDComCuter :
STRUCT
	fTabWidth:REAL;  //裁切定位CCD结果(极耳间距)
	fTabXOffset:REAL;  //裁切定位CCD结果(极片行进方向偏移)
	fTabYOffset:REAL;  //裁切定位CCD结果(极片横幅方向偏移)
	fTabXOffsetDeg:REAL;  //裁切定位CCD结果(极片行进方向角度)
	iFinish:INT;  //裁切定位CCD结果指示(1=视野内抓到极耳任意一个边   ;   2=视野内存在极耳，但极耳两个边都抓不到   ;   3:视野内不存在极耳;  )	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>