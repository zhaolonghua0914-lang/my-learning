	NightRunTimeTotal			:REAL;(*夜班总运行时间合计*)
	DayAlarmTimeTotal			:REAL;(*白班总报警时间合计*)
	NightAlarmTimeTotal			:REAL;(*夜班总报警时间合计*)
	DayWaitTimeTotal			:REAL;(*白班总待料时间合计*)
	NightWaitTimeTotal			:REAL;(*夜班总待料时间合计*)
	RunTimeTotal				:REAL;(*总运行时间合计*)
	WaitTimeTotal				:REAL;(*总待料时间合计*)
	AlarmTimeTotal				:REAL;(*总报警时间合计*)
	(*历史数据变量汇总1-7天*)
	(*白班*)
	DayReadDayHistory			:ARRAY[1..7 ] 	OF INT;(*历史日*)
	DayReadMonthHistory			:ARRAY[1..7 ] 	OF INT;(*历史月*)
	DayCountTotalHistory		:ARRAY[1..7 ] 	OF REAL ;(*历史白班每天生产总数*)
	HMI_DayOkCountHistory		:ARRAY[1..7 ] 	OF REAL ;(*历史白班每天生产OK总数*)
	HMI_DayNgCountHistory		:ARRAY[1..7 ] 	OF REAL ;(*历史白班每天生产NG总数*)
	HMI_DayQualifiedHistory		:ARRAY[1..7 ] 	OF REAL ;  (*历史白班每天良率*)
	DayRunTimeTotalHistory		:ARRAY[1..7 ] 	OF REAL ;(*历史每天白板总运行时间合计*)
	DayWaitTimeTotalHistory		:ARRAY[1..7 ] 	OF REAL ;(*历史每天白板总待料时间合计*)
	DayAlarmTimeTotalHistory	:ARRAY[1..7 ] 	OF REAL ;(*历史每天白板总报警时间合计*)
	NgPerHourDayCountHistory	:ARRAY[1..7,1..50 ] 	OF REAL ;(*历史每天白班各类NG数量*)
	HourTimeDayCountHistory		:ARRAY[1..7,8..19 ] 	OF REAL ;(*历史每天白班每小时产量*)
	(*夜班*)
	NightCountTotalHistory		:ARRAY[1..7 ] 	OF REAL ;
	HMI_NightOkCountHistory		:ARRAY[1..7 ] 	OF REAL ;
	HMI_NightNgCountHistory		:ARRAY[1..7 ] 	OF REAL ;
	HMI_NightQualifiedHistory	:ARRAY[1..7 ] 	OF REAL ;
	NightRunTimeTotalHistory	:ARRAY[1..7 ] 	OF REAL ;
	NightWaitTimeTotalHistory	:ARRAY[1..7 ] 	OF REAL ;
	NightAlarmTimeTotalHistory	:ARRAY[1..7 ] 	OF REAL ;
	NgPerHourNightCountHistory	:ARRAY[1..7,1..50 ] 	OF REAL ;
	HourTimeNightCountHistory	:ARRAY[1..7,0..23] 	OF REAL ;
	(*历史数据变量汇总1-7天*)


(**********************************生产统计数据********************************************)
	DayRunTime_min:ARRAY[8..19] 	OF REAL;	(*白班每小时运行时间*)
	NightRunTime_min:ARRAY[0..23] 	OF REAL;	(*夜班每小时运行时间*)
	AllDayRunTime_min: REAL;	(*白班总运行时间*)
	AllNightRunTime_min: REAL;	(*夜班总运行时间*)

	DayWaitTime_min:ARRAY[8..19] 	OF REAL;	(*白班待料每小时时间*)
	NightWaitTime_min:ARRAY[0..23] 	OF REAL;	(*夜班待料每小时时间*)
	AllDayWaitTime_min: REAL;(*白班总待料时间*)
	AllNightWaitTime_min: REAL;(*夜班总待料时间*)

	DayAlmTime_min:ARRAY[8..19] 	OF REAL;	(*白班每小时报警时间*)
	NightAlmTime_min:ARRAY[0..23] OF REAL;	(*夜班每小时报警时间*)
	AllDayAlmTime_min: REAL;	(*白班总报警时间*)
	AllNightAlmTime_min: REAL;	(*夜班总报警时间*)

	DayBlockTime_min:ARRAY[0..23] 	OF REAL;(*白班每小时堵料时间*)
	NightBlockTime_min:ARRAY[0..23] 	OF REAL;(*夜班每小时堵料时间*)
	AllDayBlockTime_min: REAL;(*白班总堵料时间*)
	AllNightBlockTime_min: REAL;(*夜班总堵料时间*)
	
	HMINgClassCount_Day:ARRAY[1..50,0..23] 	OF REAL;(*白班每种NG类型每小时统计 ,,,NG类型，小时*)
	HMINgClassCount_Night:ARRAY[1..50,0..23] 	OF REAL;(*夜班每种NG类型每小时统计 ,,,NG类型，小时*)
	
	
	

	HisDayRunTime_min	:ARRAY[1..7,8..19 ] OF REAL ; (*历史白班每小时运行时间*)
	HisNightRunTime_min	:ARRAY[1..7,0..23 ] OF REAL ; (*历史夜班每小时运行时间*)
	HisAllDayRunTime_min:ARRAY[1..7] OF REAL ;	(*历史白班总运行时间*)
	HisAllNightRunTime_min:ARRAY[1..7 ] OF REAL ;	(*历史夜班总运行时间*)

	HisDayWaitTime_min	:ARRAY[1..7,8..19 ] OF REAL ; (*历史白班每小时待料时间*)
	HisNightWaitTime_min:ARRAY[1..7,0..23 ] OF REAL ; (*历史夜班每小时待料时间*)
	HisAllDayWaitTime_min:ARRAY[1..7] OF REAL ;	(*历史白班总待料时间*)
	HisAllNightWaitTime_min:ARRAY[1..7 ] OF REAL ;	(*历史夜班总待料时间*)

	HisDayAlmTime_min	:ARRAY[1..7,8..19 ] OF REAL ; (*历史白班每小时报警时间*)
	HisNightAlmTime_min	:ARRAY[1..7,0..23 ] OF REAL ; (*历史夜班每小时报警时间*)
	HisAllDayAlmTime_min:ARRAY[1..7] OF REAL ;	(*历史白班总报警时间*)
	HisAllNightAlmTime_min:ARRAY[1..7 ] OF REAL ;(*历史夜班总报警时间*)

	HisHMINgClassCount_Day:ARRAY[1..50,0..23,1..7] 	OF REAL;(*历史白班每种NG类型每小时统计,,,NG类型，小时，天*)
	HisHMINgClassCount_Night:ARRAY[1..50,0..23,1..7] 	OF REAL;(*历史夜班每种NG类型每小时统计,,,NG类型，小时，天*)

	
	HMI_TodayNGQualified:ARRAY[1..50] OF REAL;//当天白班各种NG类型NG率
	HMI_NightNGQualified:ARRAY[1..50] OF REAL;//当天夜班各种NG类型NG率	
	
	HMI_HisTodayNGQualified:ARRAY[1..50,1..7] OF REAL;//历史白班各种NG类型NG率
	HMI_HisNightNGQualified:ARRAY[1..50,1..7] OF REAL;//历史夜班各种NG类型NG率
	
END_STRUCT
END_TYPE
