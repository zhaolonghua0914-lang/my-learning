	NightCountTotal				:REAL;(*夜班产量合计*)
	SaveNowDay					:INT;
	SaveNowMonth				:INT;
	nDayRunTimeCnt				:ARRAY[8..19 ] 	OF UDINT;		(*白班运行时间统计*)
	nDayAlarmTimeCnt			:ARRAY[8..19 ] 	OF UDINT;		(*白班报警时间统计*)
	nDayWaitTimeCnt				:ARRAY[8..19 ] 	OF UDINT;		(*白班待料时间统计*)
	nNightRunTimeCnt			:ARRAY[0..23 ] OF UDINT;		(*夜班运行时间统计*)
	nNightAlarmTimeCnt			:ARRAY[0..23 ] OF UDINT;		(*夜班报警时间统计*)
	nNightWaitTimeCnt			:ARRAY[0..23 ] OF UDINT;		(*夜班待料时间统计*)
	HourTimeDayCount			:ARRAY[8..19 ] 	OF REAL;		(*白班每小时产量*)
	HourTimeNightCount			:ARRAY[0..23] 	OF REAL;		(*夜班每小时产量*)
	NgPerHourDayCount			:ARRAY[1..50 ] 	OF REAL;		(*白班1-30种类的不良分类*)
	NgPerHourNightCount			:ARRAY[1..50 ] 	OF REAL;		(*夜班1-30种类的不良分类*)
	HMI_TotalCount				:REAL;(*总产量*)
	HMI_OkCount					:REAL;(*OK产量*)
	HMI_NgCount					:REAL;(*Ng产量*)
	HMI_Qualified 				:REAL;(*良率*)
	HMI_NG_Qualified 			:REAL;(*不良率*)
