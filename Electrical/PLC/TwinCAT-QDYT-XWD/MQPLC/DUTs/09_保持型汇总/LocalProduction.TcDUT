	HMI_NGClearPMBtn:ARRAY[1..50] OF BOOL;//夜班NG类型计数清零
	
//产能清零
	HMI_DelDataAMBtn			:BOOL;//白班产能清零
	HMI_DelDataPMBtn			:BOOL;//夜班产能清零
(*产能统计*)
	HMI_TodayTotal				:REAL;(*当天24H生产总数*)
	HMI_TodayOK					:REAL; (*当天24H生产OK总数*)
	HMI_TodayNG 				:REAL; (*当天24H生产NG总数*)
	
	HMI_HistoryTotal			:ARRAY[1..7 ] 	OF REAL ;(*历史每天24H生产总数ARRAY[1..7 ]*)
	HMI_HistoryOK				:ARRAY[1..7 ] 	OF REAL ;(*历史每天24H生产OK总数ARRAY[1..7 ]*)
	HMI_HistoryNG 				:ARRAY[1..7 ] 	OF REAL ; (*历史每天24H生产NG总数ARRAY[1..7 ]*)
