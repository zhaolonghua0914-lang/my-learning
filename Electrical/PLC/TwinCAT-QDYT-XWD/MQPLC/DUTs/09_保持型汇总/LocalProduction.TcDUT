  <DUT Name="LocalProduction" Id="{90a5dfed-20bd-47a9-968a-01a8b81a299b}">
    <Declaration><![CDATA[TYPE  LocalProduction :
STRUCT
	OutFlag1:BOOL;(*产量计数标志1*)
	OutFlag2:BOOL;(*产量计数标志2*)
	NGFlag:ARRAY[1..50] OF BOOL;(*NG1计数标志*)

	RunFlag:BOOL;(*运行标志*)
	WaitFlag:BOOL;(*待料标志*)
	AlarmFlag:BOOL;(*故障标志*)
	DelDataAMBtn:BOOL;(*白班数据清除按钮*)
	DelDataPMBtn:BOOL;(*夜班数据清除按钮*)
	NowOutTotal:REAL;(*当前班次加工总数*)
	NowRate:REAL;(*当前班次良率*)
