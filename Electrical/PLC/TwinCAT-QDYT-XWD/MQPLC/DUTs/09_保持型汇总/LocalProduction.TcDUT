	HMI_DayOkCount				:REAL;(*白班OK产量*)
	HMI_DayNgCount				:REAL;(*白班Ng产量*)
	HMI_DayQualified 			:REAL;(*白班良率*)
	HMI_DayNG_Qualified 		:REAL;(*白班不良率*)
	HMI_NightOkCount			:REAL;(*夜班OK产量*)
	HMI_NightNgCount			:REAL;(*夜班Ng产量*)
	HMI_NightQualified 			:REAL;(*夜班良率*)
	HMI_NightNG_Qualified 		:REAL;(*夜班不良率*)
