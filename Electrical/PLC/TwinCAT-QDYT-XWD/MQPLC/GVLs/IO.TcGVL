YL_INT2     		AT %I*:ARRAY[1..50] OF INT  ; //预留输出INT；
YL_GVL  :ARRAY [1..60] OF BOOL;//内部预留；

//////////////////////////叠片交互////////////////////////////////
D_Pro    AT %I*: DToM_Process;//只读 叠片生产过程信号
D_Sys    AT %I*: DToM_System;//只读 叠片系统信号
M_Pro    AT %Q*: MToD_Process;//只写 模切生产过程信号
M_Sys    AT %Q*: MToD_System;//只写 模切系统信号
MTD_Mes1	 AT %Q*: MTD_Mes1;	//发送模切数据XFP20240315
DTM_Mes1	 AT %I*: DTM_Mes1;	//接收叠台数据XFP20240315

I30101	 AT %I*:BOOL ; //1号叠台:正极模切送料分段皮带1有料感应
