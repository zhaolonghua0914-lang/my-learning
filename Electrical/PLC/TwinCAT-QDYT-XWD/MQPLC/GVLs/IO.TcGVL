//模切、叠台条码交互
	DT_To_MQ_MES AT %I*:ST_DT_To_MQ_MES;
	MQ_To_DT_MES AT %Q*:ST_MQ_To_DT_MES;
//预留数据交互
YL_Q        			AT %Q*:ARRAY[1..50] OF BOOL ; //1、气压不足报警;
