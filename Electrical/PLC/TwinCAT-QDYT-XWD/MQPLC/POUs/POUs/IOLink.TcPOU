			I207[16]	;//		
			CaSenser.aThrow:=	I204[9]	;//负极上表面毛刷除尘升降气缸伸出位(踢废失败报警解除专用)					
			CaSenser.biCutPoleHave	:=	I208[1]	;	//裁切后极片有无检测	
			CaSenser.bKick :=I208[2]	;//	踢废工位有无料检测；		
