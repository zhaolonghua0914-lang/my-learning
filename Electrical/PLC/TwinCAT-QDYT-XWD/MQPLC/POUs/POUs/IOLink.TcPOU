		CaSenser.biDoor[2]:=	I206[11]	;//	负极外罩门禁2		
		CaSenser.biDoor[3]:=	I206[12]	;//	负极外罩门禁3		
		CaSenser.biDoor[4]:=	I206[13]	;//	负极外罩门禁4		
