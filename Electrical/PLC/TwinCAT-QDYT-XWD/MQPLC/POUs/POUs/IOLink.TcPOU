    <Action Name="LimitSwitch" Id="{92482269-ece1-468d-ae71-4e56a7046c81}">
      <Implementation>
        <ST><![CDATA[//正极极片张力
arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Io.DigitalInputs;
//arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Io.biHomeSwitch:=arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Io.DigitalInputs.2;
arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Io.biNegLimit:=arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Io.biPosLimit:=arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Io.DigitalInputs.16;
//arrAxisPar[NameNo.AnAxisNo.PoleTension].bLimitSwitchEn:=TRUE;//开启限位保护

//正极极片缓存
arrAxisCtrl[NameNo.AnAxisNo.BuffeLine].Io.DigitalInputs;
arrAxisCtrl[NameNo.AnAxisNo.BuffeLine].Io.biHomeSwitch:=arrAxisCtrl[NameNo.AnAxisNo.BuffeLine].Io.DigitalInputs.2;
arrAxisCtrl[NameNo.AnAxisNo.BuffeLine].Io.biNegLimit:= arrAxisCtrl[NameNo.AnAxisNo.BuffeLine].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.AnAxisNo.BuffeLine].Io.biPosLimit:= arrAxisCtrl[NameNo.AnAxisNo.BuffeLine].Io.DigitalInputs.18;
arrAxisPar[NameNo.AnAxisNo.BuffeLine].bLimitSwitchEn:=TRUE;//开启限位保护

//正极模具纠偏X轴(肩宽)
arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_X].Io.DigitalInputs;
arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_X].Io.biHomeSwitch:=arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_X].Io.DigitalInputs.2;
arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_X].Io.biNegLimit:=arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_X].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_X].Io.biPosLimit:=arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_X].Io.DigitalInputs.16;
arrAxisPar[NameNo.AnAxisNo.MouldRectify_X].bLimitSwitchEn:=TRUE;//开启限位保护

//正极模具纠偏Y轴(切刀深度)   负限当作原点&负限
arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_Y].Io.DigitalInputs;
arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_Y].Io.biHomeSwitch:=arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_Y].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_Y].Io.biNegLimit:=arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_Y].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_Y].Io.biPosLimit:=arrAxisCtrl[NameNo.AnAxisNo.MouldRectify_Y].Io.DigitalInputs.16;
arrAxisPar[NameNo.AnAxisNo.MouldRectify_Y].bLimitSwitchEn:=TRUE;//开启限位保护

//正极模具
arrAxisCtrl[NameNo.AnAxisNo.Mould].Io.DigitalInputs;
arrAxisCtrl[NameNo.AnAxisNo.Mould].Io.biHomeSwitch:=arrAxisCtrl[NameNo.AnAxisNo.Mould].Io.DigitalInputs.2;
//arrAxisCtrl[AnAxisNo.Mould].Io.biNegLimit:=arrAxisCtrl[AnAxisNo.Mould].Io.DigitalInputs.0;
//arrAxisCtrl[AnAxisNo.Mould].Io.biPosLimit:=arrAxisCtrl[AnAxisNo.Mould].Io.DigitalInputs.1;

//正极裁切
arrAxisCtrl[NameNo.AnAxisNo.Cuter].Io.DigitalInputs;
arrAxisCtrl[NameNo.AnAxisNo.Cuter].Io.biHomeSwitch:=arrAxisCtrl[NameNo.AnAxisNo.Cuter].Io.DigitalInputs.2;
//arrAxisCtrl[AnAxisNo.Cuter].Io.biNegLimit:=arrAxisCtrl[AnAxisNo.Cuter].Io.DigitalInputs.0;
//arrAxisCtrl[AnAxisNo.Cuter].Io.biPosLimit:=arrAxisCtrl[AnAxisNo.Cuter].Io.DigitalInputs.1;

//正极裁切角度纠偏   负限当作原点&负限
arrAxisCtrl[NameNo.AnAxisNo.CuterDegRectify].Io.DigitalInputs;
arrAxisCtrl[NameNo.AnAxisNo.CuterDegRectify].Io.biHomeSwitch:=arrAxisCtrl[NameNo.AnAxisNo.CuterDegRectify].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.AnAxisNo.CuterDegRectify].Io.biNegLimit:=arrAxisCtrl[NameNo.AnAxisNo.CuterDegRectify].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.AnAxisNo.CuterDegRectify].Io.biPosLimit:=arrAxisCtrl[NameNo.AnAxisNo.CuterDegRectify].Io.DigitalInputs.16;
arrAxisPar[NameNo.AnAxisNo.CuterDegRectify].bLimitSwitchEn:=TRUE;//开启限位保护

//正极裁切换型
arrAxisCtrl[NameNo.AnAxisNo.CuterBeltChange].Io.DigitalInputs;
arrAxisCtrl[NameNo.AnAxisNo.CuterBeltChange].Io.biHomeSwitch:=arrAxisCtrl[NameNo.AnAxisNo.CuterBeltChange].Io.DigitalInputs.2;
arrAxisCtrl[NameNo.AnAxisNo.CuterBeltChange].Io.biNegLimit:=arrAxisCtrl[NameNo.AnAxisNo.CuterBeltChange].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.AnAxisNo.CuterBeltChange].Io.biPosLimit:=arrAxisCtrl[NameNo.AnAxisNo.CuterBeltChange].Io.DigitalInputs.16;
arrAxisPar[NameNo.AnAxisNo.CuterBeltChange].bLimitSwitchEn:=TRUE;//开启限位保护

//正极初始踢废料
//arrAxisCtrl[NameNo.AnAxisNo.NGPush1].Io.DigitalInputs;
//arrAxisCtrl[NameNo.AnAxisNo.NGPush1].Io.biHomeSwitch:=NOT arrAxisCtrl[NameNo.AnAxisNo.NGPush1].Io.DigitalInputs.2;
//arrAxisCtrl[AnAxisNo.NGPush1].Io.biNegLimit:=arrAxisCtrl[AnAxisNo.NGPush1].Io.DigitalInputs.0;
//arrAxisCtrl[AnAxisNo.NGPush1].Io.biPosLimit:=arrAxisCtrl[AnAxisNo.NGPush1].Io.DigitalInputs.1;

//正极踢废料
//arrAxisCtrl[NameNo.AnAxisNo.NGPush2].Io.DigitalInputs;
//arrAxisCtrl[NameNo.AnAxisNo.NGPush2].Io.biHomeSwitch:=NOT arrAxisCtrl[NameNo.AnAxisNo.NGPush2].Io.DigitalInputs.2;
//arrAxisCtrl[AnAxisNo.NGPush2].Io.biNegLimit:=arrAxisCtrl[AnAxisNo.NGPush2].Io.DigitalInputs.0;
//arrAxisCtrl[AnAxisNo.NGPush2].Io.biPosLimit:=arrAxisCtrl[AnAxisNo.NGPush2].Io.DigitalInputs.1;

//正极CCD压片升降
arrAxisCtrl[NameNo.AnAxisNo.CCDPressPush].Io.DigitalInputs;
arrAxisCtrl[NameNo.AnAxisNo.CCDPressPush].Io.biHomeSwitch:=NOT arrAxisCtrl[NameNo.AnAxisNo.CCDPressPush].Io.DigitalInputs.2;
//arrAxisCtrl[AnAxisNo.CCDPressPush].Io.biNegLimit:=arrAxisCtrl[AnAxisNo.CCDPressPush].Io.DigitalInputs.0;
//arrAxisCtrl[AnAxisNo.CCDPressPush].Io.biPosLimit:=arrAxisCtrl[AnAxisNo.CCDPressPush].Io.DigitalInputs.1;


//负极极片张力
arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Io.DigitalInputs;
//arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Io.biHomeSwitch:=arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Io.DigitalInputs.2;
arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Io.biNegLimit:=arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Io.biPosLimit:=arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Io.DigitalInputs.16;

//负极极片缓存
arrAxisCtrl[NameNo.CaAxisNo.BuffeLine].Io.DigitalInputs;
arrAxisCtrl[NameNo.CaAxisNo.BuffeLine].Io.biHomeSwitch:=arrAxisCtrl[NameNo.CaAxisNo.BuffeLine].Io.DigitalInputs.2;
arrAxisCtrl[NameNo.CaAxisNo.BuffeLine].Io.biNegLimit:= arrAxisCtrl[NameNo.CaAxisNo.BuffeLine].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.CaAxisNo.BuffeLine].Io.biPosLimit:= arrAxisCtrl[NameNo.CaAxisNo.BuffeLine].Io.DigitalInputs.18;
arrAxisPar[NameNo.CaAxisNo.BuffeLine].bLimitSwitchEn:=TRUE;//开启限位保护

//负极模具纠偏X轴(肩宽)
arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_X].Io.DigitalInputs;
arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_X].Io.biHomeSwitch:=arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_X].Io.DigitalInputs.2;
arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_X].Io.biNegLimit:=arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_X].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_X].Io.biPosLimit:=arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_X].Io.DigitalInputs.16;
arrAxisPar[NameNo.CaAxisNo.MouldRectify_X].bLimitSwitchEn:=TRUE;//开启限位保护

//负极模具纠偏Y轴(切刀深度) 负限当作原点&负限
arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_Y].Io.DigitalInputs;
arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_Y].Io.biHomeSwitch:=arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_Y].Io.DigitalInputs.17;//arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_Y].Io.DigitalInputs.2;
arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_Y].Io.biNegLimit:=arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_Y].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_Y].Io.biPosLimit:=arrAxisCtrl[NameNo.CaAxisNo.MouldRectify_Y].Io.DigitalInputs.16;
arrAxisPar[NameNo.CaAxisNo.MouldRectify_Y].bLimitSwitchEn:=TRUE;//开启限位保护

//负极模具
arrAxisCtrl[NameNo.CaAxisNo.Mould].Io.DigitalInputs;
arrAxisCtrl[NameNo.CaAxisNo.Mould].Io.biHomeSwitch:=arrAxisCtrl[NameNo.CaAxisNo.Mould].Io.DigitalInputs.2;
//arrAxisCtrl[NameNo.CaAxisNo.Mould].Io.biNegLimit:=arrAxisCtrl[NameNo.CaAxisNo.Mould].Io.DigitalInputs.0;
//arrAxisCtrl[NameNo.CaAxisNo.Mould].Io.biPosLimit:=arrAxisCtrl[NameNo.CaAxisNo.Mould].Io.DigitalInputs.1;

//负极裁切
arrAxisCtrl[NameNo.CaAxisNo.Cuter].Io.DigitalInputs;
arrAxisCtrl[NameNo.CaAxisNo.Cuter].Io.biHomeSwitch:=arrAxisCtrl[NameNo.CaAxisNo.Cuter].Io.DigitalInputs.2;
//arrAxisCtrl[NameNo.CaAxisNo.Cuter].Io.biNegLimit:=arrAxisCtrl[NameNo.CaAxisNo.Cuter].Io.DigitalInputs.0;
//arrAxisCtrl[NameNo.CaAxisNo.Cuter].Io.biPosLimit:=arrAxisCtrl[NameNo.CaAxisNo.Cuter].Io.DigitalInputs.1;

//负极裁切角度纠偏   负限当作原点&负限
arrAxisCtrl[NameNo.CaAxisNo.CuterDegRectify].Io.DigitalInputs;
arrAxisCtrl[NameNo.CaAxisNo.CuterDegRectify].Io.biHomeSwitch:=arrAxisCtrl[NameNo.CaAxisNo.CuterDegRectify].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.CaAxisNo.CuterDegRectify].Io.biNegLimit:=arrAxisCtrl[NameNo.CaAxisNo.CuterDegRectify].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.CaAxisNo.CuterDegRectify].Io.biPosLimit:=arrAxisCtrl[NameNo.CaAxisNo.CuterDegRectify].Io.DigitalInputs.16;
arrAxisPar[NameNo.CaAxisNo.CuterDegRectify].bLimitSwitchEn:=TRUE;//开启限位保护

//负极裁切换型
arrAxisCtrl[NameNo.CaAxisNo.CuterBeltChange].Io.DigitalInputs;
arrAxisCtrl[NameNo.CaAxisNo.CuterBeltChange].Io.biHomeSwitch:=arrAxisCtrl[NameNo.CaAxisNo.CuterBeltChange].Io.DigitalInputs.2;
arrAxisCtrl[NameNo.CaAxisNo.CuterBeltChange].Io.biNegLimit:=arrAxisCtrl[NameNo.CaAxisNo.CuterBeltChange].Io.DigitalInputs.17;
arrAxisCtrl[NameNo.CaAxisNo.CuterBeltChange].Io.biPosLimit:=arrAxisCtrl[NameNo.CaAxisNo.CuterBeltChange].Io.DigitalInputs.16;
arrAxisPar[NameNo.CaAxisNo.CuterBeltChange].bLimitSwitchEn:=TRUE;//开启限位保护

//负极初始踢废料
//arrAxisCtrl[NameNo.CaAxisNo.NGPush1].Io.DigitalInputs;
//arrAxisCtrl[NameNo.CaAxisNo.NGPush1].Io.biHomeSwitch:=NOT arrAxisCtrl[NameNo.CaAxisNo.NGPush1].Io.DigitalInputs.2;
//arrAxisCtrl[NameNo.CaAxisNo.NGPush1].Io.biNegLimit:=arrAxisCtrl[NameNo.CaAxisNo.NGPush1].Io.DigitalInputs.0;
//arrAxisCtrl[NameNo.CaAxisNo.NGPush1].Io.biPosLimit:=arrAxisCtrl[NameNo.CaAxisNo.NGPush1].Io.DigitalInputs.1;

//负极踢废料
//arrAxisCtrl[NameNo.CaAxisNo.NGPush2].Io.DigitalInputs;
//arrAxisCtrl[NameNo.CaAxisNo.NGPush2].Io.biHomeSwitch:=NOT arrAxisCtrl[NameNo.CaAxisNo.NGPush2].Io.DigitalInputs.2;
//arrAxisCtrl[NameNo.CaAxisNo.NGPush2].Io.biNegLimit:=arrAxisCtrl[NameNo.CaAxisNo.NGPush2].Io.DigitalInputs.0;
//arrAxisCtrl[NameNo.CaAxisNo.NGPush2].Io.biPosLimit:=arrAxisCtrl[NameNo.CaAxisNo.NGPush2].Io.DigitalInputs.1;

//负极CCD压片升降
arrAxisCtrl[NameNo.CaAxisNo.CCDPressPush].Io.DigitalInputs;
arrAxisCtrl[NameNo.CaAxisNo.CCDPressPush].Io.biHomeSwitch:=NOT arrAxisCtrl[NameNo.CaAxisNo.CCDPressPush].Io.DigitalInputs.2;
//arrAxisCtrl[NameNo.CaAxisNo.CCDPressPush].Io.biNegLimit:=arrAxisCtrl[NameNo.CaAxisNo.CCDPressPush].Io.DigitalInputs.0;
//arrAxisCtrl[NameNo.CaAxisNo.CCDPressPush].Io.biPosLimit:=arrAxisCtrl[NameNo.CaAxisNo.CCDPressPush].Io.DigitalInputs.1;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="OutPut" Id="{788dc975-422b-4dc9-a35e-a6baacf3cef4}">
      <Implementation>
        <ST><![CDATA[//输出映射	正极									
		Q101[1]	:=	arrCyCtrl[NameNo.AnCYNo.Inflation_L].Io.DOStatus1	;//	正极左放卷气涨轴张开				
		Q101[2]	:=	arrCyCtrl[NameNo.AnCYNo.Inflation_L].Io.DOStatus2	;//	正极左放卷气涨轴缩回				
		Q101[3]	:=	arrCyCtrl[NameNo.AnCYNo.Inflation_R].Io.DOStatus1	;//	正极右放卷气涨轴张开				
		Q101[4]	:=	arrCyCtrl[NameNo.AnCYNo.Inflation_R].Io.DOStatus2	;//	正极右放卷气涨轴缩回				
		Q101[5]	:=	arrCyCtrl[NameNo.AnCYNo.BoardPressL].Io.DOStatus1	;//	正极极片左接带气缸伸出				
		Q101[6]	:=	arrCyCtrl[NameNo.AnCYNo.BoardPressL].Io.DOStatus2	;//	正极极片左接带气缸缩回				
		Q101[7]	:=	arrCyCtrl[NameNo.AnCYNo.BoardPressR].Io.DOStatus1	;//	正极极片右接带气缸伸出				
		Q101[8]	:=	arrCyCtrl[NameNo.AnCYNo.BoardPressR].Io.DOStatus2	;//	正极极片右接带气缸缩回				
		Q101[9]	:=	arrCyCtrl[NameNo.AnEVNo.ConnectDustVacuo].Io.DOStatus1	;//	正极极片接带平台除尘真空打开				
		Q101[10]	:=	AnBtn.PoleBoxStartLight	;//	正极放卷启动按钮灯				
		Q101[11]	:=	AnBtn.CoderRollPressLight		;//	正极编码器压辊按钮灯			
		Q101[12]			;//					
		Q101[13]	:=	arrCyCtrl[NameNo.AnCYNo.DriverPressAux].Io.DOStatus1	;//	正极辅助驱动压辊伸出				
		Q101[14]	:=	arrCyCtrl[NameNo.AnCYNo.DriverPressAux].Io.DOStatus2	;//	正极辅助驱动压辊缩回				
		Q101[15]	:=	arrCyCtrl[NameNo.AnCYNo.CoderRollPress].Io.DOStatus1	;//	正极前线扫编码器压辊伸出				
		Q101[16]	:=	arrCyCtrl[NameNo.AnCYNo.CoderRollPress].Io.DOStatus2	;//	正极前线扫编码器压辊缩回				
										
		Q102[1]			;//					
		Q102[2]	:=	arrCyCtrl[NameNo.AnEVNo.LineSceneDustBlow].Io.DOStatus1	;//	正极线扫相机镜头除尘吹气				
		Q102[3]	:=	arrCyCtrl[NameNo.AnEVNo.LineSceneDustVacuo].Io.DOStatus1	;//	正极线扫相机镜头除尘真空				
		Q102[4]			;//					
		Q102[5]	:=	arrRecCtrl[NameNo.AnRecNo.PoleWind].Io.boManual	;//	正极放卷纠偏手动				
		Q102[6]	:=	arrRecCtrl[NameNo.AnRecNo.PoleWind].Io.boCentre	;//	正极放卷纠偏居中				
		Q102[7]	:=	arrRecCtrl[NameNo.AnRecNo.PoleWind].Io.boLock	;//	正极放卷纠偏外部锁定				
		Q102[8]	:=	arrRecCtrl[NameNo.AnRecNo.PoleWind].Io.boAuto	;//	正极放卷纠偏自动				
		Q102[9]	:=	arrRecCtrl[NameNo.AnRecNo.PoleProcess].Io.boManual	;//	正极行进纠偏手动				
		Q102[10]	:=	arrRecCtrl[NameNo.AnRecNo.PoleProcess].Io.boCentre	;//	正极行进纠偏居中				
		Q102[11]	:=	arrRecCtrl[NameNo.AnRecNo.PoleProcess].Io.boLock	;//	正极行进纠偏外部锁定				
		Q102[12]	:=	arrRecCtrl[NameNo.AnRecNo.PoleProcess].Io.boAuto	;//	正极行进纠偏自动				
		Q102[13]	:=	AnCCDIO.boChamferPhoto	;//	正极CCD冲R角定位拍照触发				
		Q102[14]	:=	AnCCDIO.boCuterPhoto	;//	正极CCD裁切定位拍照触发				
		Q102[15]	:=	AnCCDIO.boSizePhoto	;//	正极CCD尺寸检测拍照触发				
		Q102[16]			;//					
										
		Q103[1]	:=	arrCyCtrl[NameNo.AnCYNo.DriverPressDDR].Io.DOStatus1	;//	正极主驱动压辊伸出				
		Q103[2]	:=	arrCyCtrl[NameNo.AnCYNo.DriverPressDDR].Io.DOStatus2	;//	正极主驱动压辊缩回				
		Q103[3]	:=	AnBtn.DriverPressDDRLight	;//	正极主驱动压辊按钮灯				
		Q103[4]	:=	arrCyCtrl[NameNo.AnEVNo.AreaArrayDustBlow].Io.DOStatus1	;//	正极模切相机镜头除尘吹气				
		Q103[5]	:=	arrCyCtrl[NameNo.AnEVNo.MouldUpBlow].Io.DOStatus1	;//	正极模具上模吹气打开				
		Q103[6]	:=	arrCyCtrl[NameNo.AnEVNo.MouldDownVacuo].Io.DOStatus1	;//	正极模具下模真空				
