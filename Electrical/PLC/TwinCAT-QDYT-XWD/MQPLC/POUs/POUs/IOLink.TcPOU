		Q205[9]	:=	arrCyCtrl[NameNo.CaEVNo.WindDustVacuo_U].Io.DOStatus1	;//	负极上表面风刀除尘真空				
		Q205[10]	:=	arrDustMotor[NameNo.CaMotorNo.DedustBeltDust].bo_Pul	;//	负极上表面除尘皮带除尘毛刷正转				
		Q205[11]	:=	arrDustMotor[NameNo.CaMotorNo.DedustBeltDust].bo_Dir	;//	负极上表面除尘皮带除尘毛刷反转				
		Q205[12]	:=	arrDustMotor[NameNo.CaMotorNo.PoleBrushDust_U].bo_Pul	;//	负极上表面极片除尘毛刷正转				
		Q205[13]	:=	arrDustMotor[NameNo.CaMotorNo.PoleBrushDust_U].bo_Dir	;//	负极上表面极片除尘毛刷反转				
		Q205[14]	:=	arrDustMotor[NameNo.CaMotorNo.DDR_Dust].bo_Pul	;//	负极主驱辊除尘毛刷正转					
		Q205[15]	:=	arrDustMotor[NameNo.CaMotorNo.DDR_Dust].bo_Dir	;//	负极主驱辊除尘毛刷正转			;//					
		Q205[16]			;//					
										
		Q206[1]	:=	CaBtn.PoleBrushDustPush_DLight	;//	负极下表面毛刷除尘升降气缸按钮灯				
		Q206[2]	:=	CaBtn.PoleWindDustPush_DLight	;//	负极下表面超声波除尘升降气缸按钮灯				
		Q206[3]	:=	arrCyCtrl[NameNo.CaCYNo.PoleBrushDustPush_D].Io.DOStatus1	;//	负极下表面毛刷除尘升降气缸伸出				
		Q206[4]	:=	arrCyCtrl[NameNo.CaCYNo.PoleBrushDustPush_D].Io.DOStatus2	;//	负极下表面毛刷除尘升降气缸缩回				
		Q206[5]	:=	arrCyCtrl[NameNo.CaCYNo.PoleWindDustPush_D].Io.DOStatus1	;//	负极下表面风刀除尘升降气缸伸出				
		Q206[6]	:=	arrCyCtrl[NameNo.CaCYNo.PoleWindDustPush_D].Io.DOStatus2	;//	负极下表面风刀除尘升降气缸缩回				
		Q206[7]	:=	arrCyCtrl[NameNo.CaCYNo.DustRevBeltUpDown].Io.DOStatus1	;//	负极下表面除尘倒装皮带升降气缸伸出				
		Q206[8]	:=	arrCyCtrl[NameNo.CaCYNo.DustRevBeltUpDown].Io.DOStatus2	;//	负极下表面除尘倒装皮带升降气缸缩回				
		Q206[9]	:=	arrCyCtrl[NameNo.CaEVNo.BrushDustVacuo_D].Io.DOStatus1	;//	负极下表面毛刷除尘真空				
		Q206[10]	:=	arrCyCtrl[NameNo.CaEVNo.WindDustBlow_D].Io.DOStatus1	;//	负极下表面风刀除尘吹气				
		Q206[11]	:=	arrCyCtrl[NameNo.CaEVNo.WindDustVacuo_D].Io.DOStatus1	;//	负极下表面风刀除尘真空				
		Q206[12]	:=	arrDustMotor[NameNo.CaMotorNo.DedustReverseBeltDust].bo_Pul	;//	负极下表面除尘皮带除尘毛刷正转				
		Q206[13]	:=	arrDustMotor[NameNo.CaMotorNo.DedustReverseBeltDust].bo_Dir	;//	负极下表面除尘皮带除尘毛刷反转				
		Q206[14]	:=	arrDustMotor[NameNo.CaMotorNo.PoleBrushDust_D].bo_Pul	;//	负极下表面极片除尘毛刷正转				
		Q206[15]	:=	arrDustMotor[NameNo.CaMotorNo.PoleBrushDust_D].bo_Dir	;//	负极下表面极片除尘毛刷反转				
		Q206[16]			;//					
										
		Q207[1]	:=	CaSys.boStartLight	;//	负极控制面板启动按钮灯				
		Q207[2]	:=	CaSys.boResetLight	;//	负极控制面板复位按钮灯				
		Q207[3]	:=	CaSys.boStopLight	;//	负极控制面板停止按钮灯				
		Q207[4]	:=	stSysState.boYellowLight	;//	负极三色灯_黄				
		Q207[5]	:=	stSysState.boGreenLight	;//	负极三色灯_绿				
		Q207[6]	:=	stSysState.boRedLight	;//	负极三色灯_红				
		Q207[7]	:=	stSysState.boBuzzer AND NOT ProductPar.iModeEN.bBuzzerEN	;//	负极三色灯_蜂鸣器				
		Q207[8]				;//		
		Q207[9]	:=	arrCyCtrl[NameNo.CaEVNo.RJ_Blow].Io.DOStatus1		;//	负极R角吹气					
		Q207[10]	:=	arrCyCtrl[NameNo.CaEVNo.RJDustBlow].Io.DOStatus1		;//R角风刀吹气		
		Q207[11]			;//	负极激光指示器				
