<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="IOLink" Id="{e08d9d3f-296c-459c-81df-748d7c709426}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM IOLink
VAR
//	tFlash: TON;
//	bFlash:BOOL;
//	bIOinit: BOOL;
	XXX: INT;
	Q20815: BOOL;
	AA: INT;

     arrFilter_AD               : ARRAY[1..MaxAINo]  OF  FB_Filter_AD ;

      arrFilter_ADV2               : ARRAY[1..2]  OF  FB_Filter_ADV2 ;

	I1: INT;

    rt01   :Tc2_Standard.R_TRIG;
    rt02   :Tc2_Standard.R_TRIG;

     parDAOld                   :ARRAY[1..8] OF INT;   
	test1: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[

InPut();

OutPut();

AI();

LimitSwitch();

IF fbPulseCtrl[4].RT THEN
      AO();
END_IF
(*
rt01(CLK:=arrCyCtrl[P3CYNo.RollPress].Cmd.bON , Q=> );
rt02(CLK:=arrCyCtrl[P3CYNo.RollPress].Cmd.bOFF , Q=> );
IF rt01.Q THEN
    P3EL4004S[3,1]:=parDA[33]	 ;//重力补偿
  //  P3EL4004S[3,2]:=parDA[34]	 ;
END_IF
IF rt02.Q THEN
    P3EL4004S[3,1]:=22000;//重力补偿
 //   P3EL4004S[3,2]:=20000;
END_IF
*)
//正极数据IOLink
ProductPar.AnPar.fSpeed:=GVL_Par.ProductPar.AnPar.iMainVel;
ProductPar.AnPar.fTension:=ProductPar.parFilterAD[3].Out_Value;

//负极数据IOLink
ProductPar.CaPar.fSpeed:=GVL_Par.ProductPar.CaPar.iMainVel;
ProductPar.CaPar.fTension:=ProductPar.parFilterAD[15].Out_Value;












]]></ST>
    </Implementation>
    <Action Name="AI" Id="{eac25eb3-d560-4edd-bfb4-c595f8f0e948}">
      <Implementation>
        <ST><![CDATA[
//正极
arrFilter_AD[1].AD	:=	AI101[0];//	正极左放卷卷径超声波检测
arrFilter_AD[2].AD	:=	AI101[1];//	正极右放卷卷径超声波检测
//arrFilter_AD[3].AD	:=	AI101[2];//	正极辅驱前料带张力检测
arrFilter_ADV2[1].AD	:=	AI101[2];//	正极辅驱前料带张力检测
arrFilter_AD[4].AD	:=	AI101[3];//	备用
			
arrFilter_AD[5].AD	:=	AI102[0];//	正极后摆杆电位计检测
arrFilter_AD[6].AD	:=	AI102[1];//	正极倒角深度前纠偏检测
arrFilter_AD[7].AD	:=	AI102[2];//	正极倒角深度后纠偏检测
arrFilter_AD[8].AD	:=	AI102[3];//	备用

arrFilter_AD[9].AD		;//	正极
arrFilter_AD[10].AD		;//	正极
arrFilter_AD[11].AD		;//	正极
arrFilter_AD[12].AD		;//	正极

//负极
arrFilter_AD[13].AD	:=	AI201[0];//	负极左放卷卷径超声波检测
arrFilter_AD[14].AD	:=	AI201[1];//	负极右放卷卷径超声波检测
//arrFilter_AD[15].AD	:=	AI201[2];//	负极辅驱前料带张力检测
 arrFilter_ADV2[2].AD	:=	AI201[2];//	负极辅驱前料带张力检测
 
arrFilter_AD[16].AD	:=	AI201[3];//	备用
arrFilter_AD[17].AD	:=	AI202[0];//	负极后摆杆电位计检测
arrFilter_AD[18].AD	:=	AI202[1];//	负极倒角深度前纠偏检测
arrFilter_AD[19].AD	:=	AI202[2];//	负极倒角深度后纠偏检测
arrFilter_AD[20].AD	:=	AI202[3];//	备用

arrFilter_AD[21].AD		;//	负极
arrFilter_AD[22].AD		;//	负极
arrFilter_AD[23].AD		;//	负极
arrFilter_AD[24].AD		;//	负极

//转换
FOR  I1:=1 TO MaxAINo   DO
(*	
     arrFilter_AD[I1].fPointNum:=10;
	IF  I1=6 OR I1=7  OR  I1=18 OR I1=19  THEN         
         arrFilter_AD[I1].fPointNum:=20;
	END_IF	 
		 
   IF I1=3 OR I1=15  THEN
	    arrFilter_ADV2[I1].fPointNum:=1500;
	END_IF	
	*)
	IF  I1=6 OR I1=7  OR  I1=18 OR I1=19  THEN         
         arrFilter_AD[I1].fPointNum:=20;
   ELSIF I1=3 OR I1=15  THEN
	    arrFilter_ADV2[1].fPointNum:=1000;
		arrFilter_ADV2[2].fPointNum:=1000;
   ELSE
	   arrFilter_AD[I1].fPointNum:=10;
   END_IF

   IF I1=3   THEN
		   //arrFilter_AD[3].AD	:=	AI101[2];//	正极辅驱前料带张力检测
	   arrFilter_ADV2[1](   
		  iMode:=         2, 
		  AD:=               , 
		  iLimitH:=         ProductPar.parFilterAD[3].iLimitH  , 
		  iLimitL:=          ProductPar.parFilterAD[3].iLimitL   , 
		  fRangeH:=      ProductPar.parFilterAD[3].fRangeH , 
		  fRangeL:=       ProductPar.parFilterAD[3].fRangeL , 
		  fPointNum:=    , 
		  Out_Value=>   ProductPar.parFilterAD[3].Out_Value  );
		  
		//arrFilter_AD[15].AD	:=	AI201[2];//	负极辅驱前料带张力检测
	ELSIF I1=15   THEN
	  arrFilter_ADV2[2](   
		  iMode:=         2, 
		  AD:=               , 
		  iLimitH:=         ProductPar.parFilterAD[15].iLimitH  , 
		  iLimitL:=          ProductPar.parFilterAD[15].iLimitL   , 
		  fRangeH:=      ProductPar.parFilterAD[15].fRangeH , 
		  fRangeL:=       ProductPar.parFilterAD[15].fRangeL , 
		  fPointNum:=    , 
		  Out_Value=>   ProductPar.parFilterAD[15].Out_Value  );	
   ELSE
	  arrFilter_AD[I1](
		  iMode:=         2, 
		  AD:=               , 
		  iLimitH:=         ProductPar.parFilterAD[I1].iLimitH  , 
		  iLimitL:=          ProductPar.parFilterAD[I1].iLimitL   , 
		  fRangeH:=      ProductPar.parFilterAD[I1].fRangeH , 
		  fRangeL:=       ProductPar.parFilterAD[I1].fRangeL , 
		  fPointNum:=    , 
		  Out_Value=>   ProductPar.parFilterAD[I1].Out_Value  );
   END_IF	  
	  
END_FOR

  
	  
	  
	  


////////////////引用///////////////////////////
stAnUwindTen.fWindDiameter:=ProductPar.parFilterAD[1].Out_Value	;	//	正极左放卷卷径超声波检测
stAnUwindTen.fWindDiameter:=ProductPar.parFilterAD[2].Out_Value		;	//	正极右放卷卷径超声波检测
AnSenser.aiPoleTensionFr:=ProductPar.parFilterAD[3].Out_Value		;	//	正极辅驱前料带张力检测
ProductPar.parFilterAD[4].Out_Value	;	//	备用

stAnAuxDriverTen.fDanserDegree:=ProductPar.parFilterAD[5].Out_Value	;	//	正极后摆杆电位计检测
AnSenser.aiMouldRectifyFr:=ProductPar.parFilterAD[6].Out_Value	;	//	正极倒角深度前纠偏检测
AnSenser.aiMouldRectifyBe:=ProductPar.parFilterAD[7].Out_Value	;	//	正极倒角深度后纠偏检测
ProductPar.parFilterAD[8].Out_Value	;	//	备用

ProductPar.parFilterAD[9].Out_Value	;	//	正极
ProductPar.parFilterAD[10].Out_Value	;	//	正极
ProductPar.parFilterAD[11].Out_Value	;	//	正极
ProductPar.parFilterAD[12].Out_Value	;	//	正极

stCaUwindTen.fWindDiameter:=ProductPar.parFilterAD[13].Out_Value	;	//	负极左放卷卷径超声波检测
stCaUwindTen.fWindDiameter:=ProductPar.parFilterAD[14].Out_Value	;	//	负极右放卷卷径超声波检测
CaSenser.aiPoleTensionFr:=ProductPar.parFilterAD[15].Out_Value	;	//	负极辅驱前料带张力检测
ProductPar.parFilterAD[16].Out_Value	;	//	备用

stCaAuxDriverTen.fDanserDegree:=ProductPar.parFilterAD[17].Out_Value	;	//	负极后摆杆电位计检测
CaSenser.aiMouldRectifyFr:=ProductPar.parFilterAD[18].Out_Value		;	//	负极倒角深度前纠偏检测
CaSenser.aiMouldRectifyBe:=ProductPar.parFilterAD[19].Out_Value		;	//	负极倒角深度后纠偏检测
ProductPar.parFilterAD[20].Out_Value	;	//	备用

ProductPar.parFilterAD[21].Out_Value	;	//	负极	
ProductPar.parFilterAD[22].Out_Value	;	//	负极		
ProductPar.parFilterAD[23].Out_Value	;	//	负极		
ProductPar.parFilterAD[24].Out_Value	;	//	负极		





(*
//正极
arrFilter_AD[1].AD	:=	AI101[0];//	正极左放卷卷径超声波检测
arrFilter_AD[2].AD	:=	AI101[1];//	正极右放卷卷径超声波检测
arrFilter_AD[3].AD	:=	AI101[2];//	正极辅驱前料带张力检测
arrFilter_AD[4].AD	:=	AI101[3];//	备用
			
arrFilter_AD[5].AD	:=	AI102[0];//	正极后摆杆电位计检测
arrFilter_AD[6].AD	:=	AI102[1];//	正极倒角深度前纠偏检测
arrFilter_AD[7].AD	:=	AI102[2];//	正极倒角深度后纠偏检测
arrFilter_AD[8].AD	:=	AI102[3];//	备用

arrFilter_AD[9].AD		;//	正极
arrFilter_AD[10].AD		;//	正极
arrFilter_AD[11].AD		;//	正极
arrFilter_AD[12].AD		;//	正极

//负极
arrFilter_AD[13].AD	:=	AI201[0];//	负极左放卷卷径超声波检测
arrFilter_AD[14].AD	:=	AI201[1];//	负极右放卷卷径超声波检测
arrFilter_AD[15].AD	:=	AI201[2];//	负极辅驱前料带张力检测
arrFilter_AD[16].AD	:=	AI201[3];//	备用
			
arrFilter_AD[17].AD	:=	AI202[0];//	负极后摆杆电位计检测
arrFilter_AD[18].AD	:=	AI202[1];//	负极倒角深度前纠偏检测
arrFilter_AD[19].AD	:=	AI202[2];//	负极倒角深度后纠偏检测
arrFilter_AD[20].AD	:=	AI202[3];//	备用

arrFilter_AD[21].AD		;//	负极
arrFilter_AD[22].AD		;//	负极
arrFilter_AD[23].AD		;//	负极
arrFilter_AD[24].AD		;//	负极

//转换
FOR  I1:=1 TO MaxAINo   DO
	
	IF  I1=6 OR I1=7  OR  I1=18 OR I1=19  THEN         
         arrFilter_AD[I1].fPointNum:=40;
   ELSE
	   arrFilter_AD[I1].fPointNum:=10;
   END_IF
	
  arrFilter_AD[I1](
	  iMode:=         2, 
	  AD:=               , 
	  iLimitH:=         ProductPar.parFilterAD[I1].iLimitH  , 
	  iLimitL:=          ProductPar.parFilterAD[I1].iLimitL   , 
	  fRangeH:=      ProductPar.parFilterAD[I1].fRangeH , 
	  fRangeL:=       ProductPar.parFilterAD[I1].fRangeL , 
	  fPointNum:=    , 
	  Out_Value=>   ProductPar.parFilterAD[I1].Out_Value  );
END_FOR
////////////////引用///////////////////////////
stAnUwindTen.fWindDiameter:=ProductPar.parFilterAD[1].Out_Value	;	//	正极左放卷卷径超声波检测
stAnUwindTen.fWindDiameter:=ProductPar.parFilterAD[2].Out_Value		;	//	正极右放卷卷径超声波检测
AnSenser.aiPoleTensionFr:=ProductPar.parFilterAD[3].Out_Value		;	//	正极辅驱前料带张力检测
ProductPar.parFilterAD[4].Out_Value	;	//	备用

stAnAuxDriverTen.fDanserDegree:=ProductPar.parFilterAD[5].Out_Value	;	//	正极后摆杆电位计检测
AnSenser.aiMouldRectifyFr:=ProductPar.parFilterAD[6].Out_Value	;	//	正极倒角深度前纠偏检测
AnSenser.aiMouldRectifyBe:=ProductPar.parFilterAD[7].Out_Value	;	//	正极倒角深度后纠偏检测
ProductPar.parFilterAD[8].Out_Value	;	//	备用

ProductPar.parFilterAD[9].Out_Value	;	//	正极
ProductPar.parFilterAD[10].Out_Value	;	//	正极
ProductPar.parFilterAD[11].Out_Value	;	//	正极
ProductPar.parFilterAD[12].Out_Value	;	//	正极

stCaUwindTen.fWindDiameter:=ProductPar.parFilterAD[13].Out_Value	;	//	负极左放卷卷径超声波检测
stCaUwindTen.fWindDiameter:=ProductPar.parFilterAD[14].Out_Value	;	//	负极右放卷卷径超声波检测
CaSenser.aiPoleTensionFr:=ProductPar.parFilterAD[15].Out_Value	;	//	负极辅驱前料带张力检测
ProductPar.parFilterAD[16].Out_Value	;	//	备用

stCaAuxDriverTen.fDanserDegree:=ProductPar.parFilterAD[17].Out_Value	;	//	负极后摆杆电位计检测
CaSenser.aiMouldRectifyFr:=ProductPar.parFilterAD[18].Out_Value		;	//	负极倒角深度前纠偏检测
CaSenser.aiMouldRectifyBe:=ProductPar.parFilterAD[19].Out_Value		;	//	负极倒角深度后纠偏检测
ProductPar.parFilterAD[20].Out_Value	;	//	备用

ProductPar.parFilterAD[21].Out_Value	;	//	负极	
ProductPar.parFilterAD[22].Out_Value	;	//	负极		
ProductPar.parFilterAD[23].Out_Value	;	//	负极		
ProductPar.parFilterAD[24].Out_Value	;	//	负极		
*)]]></ST>
      </Implementation>
    </Action>
    <Action Name="AO" Id="{737c51e7-0292-4740-bf7f-eca0a05e9126}">
      <Implementation>
        <ST><![CDATA[////////模切AO部分////////				
AO101[0]:=REAL_TO_INT(ProductPar.parDA[1]*0.1+parDAOld[1]*0.9)			;	//	正极后摆杆比例阀
AO101[1]:=REAL_TO_INT(ProductPar.parDA[2]*0.1+parDAOld[2]*0.9)			;	//	正极主驱压辊比例阀
AO101[2]:=REAL_TO_INT(ProductPar.parDA[3]*0.1+parDAOld[3]*0.9)			;	//	正极
AO101[3]:=REAL_TO_INT(ProductPar.parDA[4]*0.1+parDAOld[4]*0.9)			;	//	正极
		
parDAOld[1]:=AO101[0];
parDAOld[2]:=AO101[1];
parDAOld[3]:=AO101[2];
parDAOld[4]:=AO101[3];
				
AO201[0]:=REAL_TO_INT(ProductPar.parDA[5]*0.1+parDAOld[5]*0.9)			;	//	负极后摆杆比例阀
AO201[1]:=REAL_TO_INT(ProductPar.parDA[6]*0.1+parDAOld[6]*0.9)			;	//	负极主驱压辊比例阀
AO201[2]:=REAL_TO_INT(ProductPar.parDA[7]*0.1+parDAOld[7]*0.9)			;	//	负极
AO201[3]:=REAL_TO_INT(ProductPar.parDA[8]*0.1+parDAOld[8]*0.9)			;	//	负极

parDAOld[5]:=AO201[0];
parDAOld[6]:=AO201[1];
parDAOld[7]:=AO201[2];
parDAOld[8]:=AO201[3];





///////////////正极张力转换///////////////////////////////
ProductPar.parFilterDA[1].bMode;  //TRUE 为标定模式      标定完成后一定要复位      

ProductPar.parFilterDA[1].X0;   //料带张力低限值    g
ProductPar.parFilterDA[1].Y0;    //料带张力低限值 DA输出   
ProductPar.parFilterDA[1].X1;  //料带张力高限值    g
ProductPar.parFilterDA[1].Y1;   //料带张力高限值   DA输出 
ProductPar.parFilterDA[1].iDAValue;   //标定DA值     

ProductPar.parDA[1]:=REAL_TO_INT(FC_Filter_AA(ProductPar.AnPar.fFr_TenValuehmi,0,0,100,30000));//	正极后摆杆比例阀
(*
ProductPar.parDA[1]:= SEL(ProductPar.parFilterDA[1].bMode,    
                                 REAL_TO_INT(FC_Filter_AA(ProductPar.AnPar.fFr_TenValuehmi,ProductPar.parFilterDA[1].X0,ProductPar.parFilterDA[1].Y0,ProductPar.parFilterDA[1].X1,ProductPar.parFilterDA[1].Y1)  ) ,     
                                 REAL_TO_INT (ProductPar.parFilterDA[1].iDAValue)   );                 //               REAL_TO_INT(FC_Filter_AA(ProductPar.AnPar.fFr_TenValuehmi,0,0,100,30000));//	正极后摆杆比例阀
*)
								 
ProductPar.parDA[2]:=REAL_TO_INT(FC_Filter_AA(ProductPar.AnPar.fPressDDRhmi,0,0,100,2000));//	正极主驱压辊比例阀
//AnPar.fBe_TenValue:=FC_Filter_AA(AnPar.fBe_TenValuehmi,0,0,100,100);//	正极前摆杆扭矩设置

///////////////负极张力转换///////////////////////////////
ProductPar.parFilterDA[2].bMode;  //TRUE 为标定模式      标定完成后一定要复位      

ProductPar.parFilterDA[2].X0;   //料带张力低限值    g
ProductPar.parFilterDA[2].Y0;    //料带张力低限值 DA输出   
ProductPar.parFilterDA[2].X1;  //料带张力高限值    g
ProductPar.parFilterDA[2].Y1;   //料带张力高限值   DA输出 
ProductPar.parFilterDA[2].iDAValue;   //标定DA值     
   
ProductPar.parDA[5]:=REAL_TO_INT(FC_Filter_AA(ProductPar.CaPar.fFr_TenValuehmi,0,0,100,30000));//	负极后摆杆比例阀
(*
ProductPar.parDA[5]:= SEL(ProductPar.parFilterDA[2].bMode,    
                                 REAL_TO_INT(FC_Filter_AA(ProductPar.CaPar.fFr_TenValuehmi,ProductPar.parFilterDA[2].X0,ProductPar.parFilterDA[2].Y0,ProductPar.parFilterDA[2].X1,ProductPar.parFilterDA[2].Y1)  ) ,     
                                  REAL_TO_INT(ProductPar.parFilterDA[2].iDAValue)  ) ;  
*)								  
								  
ProductPar.parDA[6]:=REAL_TO_INT(FC_Filter_AA(ProductPar.CaPar.fPressDDRhmi,0,0,100,2000));//	负极主驱压辊比例阀
//CaPar.fBe_TenValue:=FC_Filter_AA(CaPar.fBe_TenValuehmi,0,0,100,100);//	负极前摆杆扭矩设置]]></ST>
      </Implementation>
    </Action>
    <Action Name="InPut" Id="{e4d88748-4d47-44ee-8362-0ef5f4cb6785}">
      <Implementation>
        <ST><![CDATA[

//输入映射	正极
		arrCyCtrl[NameNo.AnCYNo.BoardPressL].Io.DIONSwitch:=	I101[1]	;//	正极极片左接带气缸伸出位		
		arrCyCtrl[NameNo.AnCYNo.BoardPressL].Io.DIOFFSwitch:=	I101[2]	;//	正极极片左接带气缸缩回位		
		arrCyCtrl[NameNo.AnCYNo.BoardPressR].Io.DIONSwitch:=	I101[3]	;//	正极极片右接带气缸伸出位		
		arrCyCtrl[NameNo.AnCYNo.BoardPressR].Io.DIOFFSwitch:=	I101[4]	;//	正极极片右接带气缸缩回位		
		AnBtn.PoleBoxBit1:=	I101[5]	;//	正极放卷按钮BIT1		
		AnBtn.PoleBoxBit2:=	I101[6]	;//	正极放卷按钮BIT2		
		AnBtn.PoleBoxBit3:=	I101[7]	;//	正极放卷按钮BIT3		
		AnBtn.PoleBoxBit4:=	I101[8]	;//	正极放卷按钮BIT4		
		AnBtn.PoleBoxStart:=	I101[9]	;//	正极放卷启动按钮		
		AnBtn.PoleBoxEStop:=	I101[10]	;//	正极片放卷急停		
		AnBtn.CoderRollPress:=	I101[11]	;//	正极编码器压辊按钮		
			I101[12]	;//			
		arrCyCtrl[NameNo.AnCYNo.DriverPressAux].Io.DIONSwitch:=arrCyCtrl[NameNo.AnCYNo.DriverPressAux].Io.DOStatus1	;//I101[13]	;//	正极辅助驱动压辊伸出位		
		arrCyCtrl[NameNo.AnCYNo.DriverPressAux].Io.DIOFFSwitch:=NOT arrCyCtrl[NameNo.AnCYNo.DriverPressAux].Io.DOStatus1	;//I101[14]	;//	正极辅助驱动压辊缩回位		
		arrCyCtrl[NameNo.AnCYNo.CoderRollPress].Io.DIONSwitch:=	arrCyCtrl[NameNo.AnCYNo.CoderRollPress].Io.DOStatus1;//I101[15]	;//	正极前线扫编码器压辊伸出位		
		arrCyCtrl[NameNo.AnCYNo.CoderRollPress].Io.DIOFFSwitch:=	NOT arrCyCtrl[NameNo.AnCYNo.CoderRollPress].Io.DOStatus1;//I101[16]	;//	正极前线扫编码器压辊缩回位		
							
		AnBtn.DriverPress_Aux:=	I102[1]	;//	正极辅驱压辊旋钮		
		AnBtn.DriverJogFw_Aux:=	I102[2]	;//	正极辅驱正转旋钮		
		AnBtn.DriverJogBw_Aux:=	I102[3]	;//	正极辅驱反转旋钮		
			I102[4]	;//			
		arrRecCtrl[NameNo.AnRecNo.PoleWind].Io.biAutoDone:=	I102[5]	;//	正极放卷纠偏自动模式		
