		CaSys.btnEstop:=	I206[5] AND I206[9]	;//	负极控制面板急停按钮		
		CaBtn.EncloserEstop[1]:=	I206[6]	;//	负极外罩急停1		
		CaBtn.EncloserEstop[2]:=	I206[7]	;//	负极外罩急停2		
		CaBtn.EncloserEstop[3]:=	I206[8]	;//	负极外罩急停3		
			//I206[9]	;//			
