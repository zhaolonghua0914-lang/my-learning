			//CaSenser.bPoleCheck_R:=I208[5]	;//	负极倒角前极耳检测感应器
			CaSenser.bYellowCheck_R2:=I208[6]	;//	负极倒角前接带检测感应器下
			CaSenser.MouldInsensor:=I208[7]	;//	R角模具到位感应		
			CaSenser.CuterInsensor:=I208[8]	;//	裁切切刀到位感应		
			I208[9]	;//			
