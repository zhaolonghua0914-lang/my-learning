	cbBufLen:=SIZEOF(SEPTATCache_fSmoothValue[1]),    
	bExecute:= SEPTATCache_bWriteCoeValue[1],    
	tTimeout:= T#3S, 
	bBusy=> , 
	bError=> , 
	nErrId=> );
