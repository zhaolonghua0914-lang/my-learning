    </Action>
    <Action Name="Condition" Id="{f7c3c673-ccf9-4740-950e-c5d8fbe37c32}">
      <Implementation>
        <ST><![CDATA[//按钮汇总
stSysState.btnAuto:=AnSys.btnAuto AND CaSys.btnAuto ;
stSysState.btnStart:=AnSys.btnStart OR CaSys.btnStart;
stSysState.btnStop:=AnSys.btnStop OR CaSys.btnStop;
stSysState.btnReset:=AnSys.btnReset OR CaSys.btnReset;
bEncloserEstop:=(NOT AnBtn.EncloserEstop[1] OR NOT AnBtn.EncloserEstop[2] OR NOT AnBtn.EncloserEstop[3] OR 
						  NOT CaBtn.EncloserEstop[1] OR NOT CaBtn.EncloserEstop[2] OR NOT CaBtn.EncloserEstop[3])AND test[1] ;
bBoxEstop:=NOT AnBtn.PoleBoxEStop OR NOT AnBtn.NGBoxEStop OR  NOT CaBtn.PoleBoxEStop OR NOT CaBtn.NGBoxEStop ;

stSysState.btnEstop:=(NOT AnSys.btnEstop OR NOT CaSys.btnEstop //面板急停
								OR bEncloserEstop//外罩急停
								(*OR bBoxEstop//按钮盒急停*)
								) ;//常闭
//面板按钮灯控制
bAnReady:=AnSys.bAutoCondition1 AND AnSys.Homed AND NOT AnSys.hmiDisCamAll;
bCaReady:=CaSys.bAutoCondition1 AND CaSys.Homed AND NOT CaSys.hmiDisCamAll;

AnSys.boStartLight:=stSysState.boGreenLight OR bAnReady AND Pulse._500ms.Q OR AnSys.btnStart;
CaSys.boStartLight:=stSysState.boGreenLight OR bCaReady AND Pulse._500ms.Q OR AnSys.btnStart;

AnSys.boStopLight:=AnSys.Stoping AND Pulse._250ms.Q OR AnSys.btnStop;
CaSys.boStopLight:=CaSys.Stoping AND Pulse._250ms.Q OR CaSys.btnStop;

AnSys.boResetLight:=stSysState.boRedLight AND Pulse._500ms.Q OR AnSys.btnReset;
CaSys.boResetLight:=stSysState.boRedLight AND Pulse._500ms.Q OR CaSys.btnReset;		
////////////////////////////////////////////设备状态//////////////////////
	IF stSysState.btnEstop THEN
		stSysState.iModehmi:=4;
	ELSIF NOT stSysState.btnEstop AND stSysState.bErrorStop THEN
		stSysState.iModehmi:=5;
	ELSIF NOT stSysState.btnEstop AND NOT stSysState.bErrorStop AND stSysState.FlgManua AND stSysState.iMode=3THEN
		stSysState.iModehmi:=3;
	ELSIF NOT stSysState.btnEstop AND NOT stSysState.bErrorStop AND ((NOT stSysState.FlgManua AND stSysState.FlgAuto AND stSysState.iMode=1) OR stSysState.iMode=1) THEN
		stSysState.iModehmi:=1;
	ELSIF NOT stSysState.btnEstop AND NOT stSysState.bErrorStop AND NOT stSysState.FlgManua AND stSysState.FlgAuto AND stSysState.iMode<>1 AND
		 	((ProductPar.iModeEN.iModeRun=0 AND bAnReady AND bCaReady) OR (ProductPar.iModeEN.iModeRun=1 AND bAnReady) OR (ProductPar.iModeEN.iModeRun=2 AND bCaReady))
			THEN	
		stSysState.iModehmi:=2;	
	ELSE
		stSysState.iModehmi:=6;	
	END_IF		
	P2Interaction.bP1Runing:=stSysState.iModehmi=1;
////////////////////////////////////////////主流程与分模块交互//////////////////////
(*
stSysState.bAutoCondition:=((AnSys.bAutoCondition1 AND AnSys.Homed AND NOT AnSys.hmiDisCamAll AND 
			CaSys.bAutoCondition1 AND CaSys.Homed AND NOT CaSys.hmiDisCamAll AND
			ProductPar.iModeEN.iModeRun=0) OR//正负同时启用
			(AnSys.bAutoCondition1 AND AnSys.Homed AND NOT AnSys.hmiDisCamAll AND
			ProductPar.iModeEN.iModeRun=1) OR//仅正极启用
			(CaSys.bAutoCondition1 AND CaSys.Homed AND NOT CaSys.hmiDisCamAll AND
			ProductPar.iModeEN.iModeRun=2))//仅负极启用
			AND NOT stSysState.bErrorStop;
*)
stSysState.bAutoCondition:=	(AnSys.bAutoCondition1 AND AnSys.Homed AND NOT AnSys.hmiDisCamAll AND CaSys.bAutoCondition1 AND CaSys.Homed AND NOT CaSys.hmiDisCamAll AND ProductPar.iModeEN.iModeRun=0 
	AND	( (ProductPar.AnPar.MQ.bWindSelect AND  Ansys.PolePieceNumberOK1)  OR ( NOT ProductPar.AnPar.MQ.bWindSelect AND  Ansys.PolePieceNumberOK2) )
	AND  ( ( ProductPar.CaPar.MQ.bWindSelect AND  Casys.PolePieceNumberOK1 ) OR (  NOT ProductPar.CaPar.MQ.bWindSelect AND  Casys.PolePieceNumberOK2 ) ) ) OR //正负同时启用

		(AnSys.bAutoCondition1 AND AnSys.Homed AND NOT AnSys.hmiDisCamAll AND ProductPar.iModeEN.iModeRun=1  AND
		 ( ( ProductPar.AnPar.MQ.bWindSelect AND  Ansys.PolePieceNumberOK1 ) OR (  NOT ProductPar.AnPar.MQ.bWindSelect AND  Ansys.PolePieceNumberOK2 ) )) OR//仅正极启用
	
		(CaSys.bAutoCondition1 AND CaSys.Homed AND NOT CaSys.hmiDisCamAll AND ProductPar.iModeEN.iModeRun=2 AND 
		  ( ( ProductPar.CaPar.MQ.bWindSelect AND  Casys.PolePieceNumberOK1 ) OR (  NOT ProductPar.CaPar.MQ.bWindSelect AND  Casys.PolePieceNumberOK2 )  ) )//仅负极启用
		  AND NOT stSysState.bErrorStop; 			
Ansys.bAutoTen:=stSysState.iMode=1 AND (ProductPar.iModeEN.iModeRun=0 OR ProductPar.iModeEN.iModeRun=1);
Casys.bAutoTen:=stSysState.iMode=1 AND (ProductPar.iModeEN.iModeRun=0 OR ProductPar.iModeEN.iModeRun=2);
Ansys.bAutoMain:=AnSys.bAutoCondition2 AND ((ProductPar.iModeEN.iModeRun=0 AND CaSys.bAutoCondition2) OR ProductPar.iModeEN.iModeRun=1);
Casys.bAutoMain:=CaSys.bAutoCondition2 AND ((ProductPar.iModeEN.iModeRun=0 AND AnSys.bAutoCondition2) OR ProductPar.iModeEN.iModeRun=2);

stSysState.bStopFinished:=(AnSys.bStopFinished AND CaSys.bStopFinished  AND ProductPar.iModeEN.iModeRun=0) OR//正负同时启用
			(AnSys.bStopFinished AND ProductPar.iModeEN.iModeRun=1) OR//仅正极启用
			(CaSys.bStopFinished AND ProductPar.iModeEN.iModeRun=2);//仅负极启用

///////////////////////////////////交互映射/////////////////////////////////////
//////////叠片TO模切//////////
//一号叠台正极
AnInter.M1Done:=D_Pro.bAn_M1Done;
AnInter.M1Safety:=D_Pro.bAn_M1Safety;
