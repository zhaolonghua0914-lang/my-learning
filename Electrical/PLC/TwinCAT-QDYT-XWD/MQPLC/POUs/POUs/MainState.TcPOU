	sNetId:= '192.168.10.10.4.1', 
	nSlaveAddr:=1025,   //模切缓存
	nSubIndex:=0 , 
	nIndex:=16#2109 ,   // 平滑方式
	pSrcBuf:=ADR(wSaveCoeCode),      //保存参数值
	cbBufLen:=SIZEOF(wSaveCoeCode),    
	bExecute:=SEPTATCache_SavePara[2],    
	tTimeout:= T#3S, 
