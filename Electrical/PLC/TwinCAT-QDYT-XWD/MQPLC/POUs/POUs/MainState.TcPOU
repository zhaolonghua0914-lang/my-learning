	cbBufLen:=SIZEOF(SEPTATCache_fSmoothValue[2]),    
	bExecute:=SEPTATCache_bWriteCoeValue[2],    
	tTimeout:= T#3S, 
	bBusy=> , 
	bError=> , 
	nErrId=> );	
//保存
