	cbBufLen:=SIZEOF(wSaveCoeCode),    
	bExecute:= DriverDDR_SavePara[1],    
	tTimeout:= T#3S, 
	bBusy=> , 
	bError=> , 
	nErrId=> );	
	
	
	
	
//写入	
