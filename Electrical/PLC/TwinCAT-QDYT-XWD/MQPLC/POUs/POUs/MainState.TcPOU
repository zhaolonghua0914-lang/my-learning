	sNetId:='192.168.10.10.4.1', 
	nSlaveAddr:=1026 ,   //模切主驱
	nSubIndex:=0 , 
	nIndex:=16#2109 ,   // 平滑方式
	pSrcBuf:=ADR(DriverDDR_fSmoothValue[2]), 
	cbBufLen:=SIZEOF(DriverDDR_fSmoothValue[2]),    
