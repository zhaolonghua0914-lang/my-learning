    <Action Name="Pusle" Id="{ed1aaec7-93f9-45d4-9266-e4f9208b4061}">
      <Implementation>
        <ST><![CDATA[
/////////////////////////////////////////时钟脉冲////////////////////////////////////////////////////////////
//fbPulseCtrl1(PT_OFF:=T#2MS, PT_ON:=T#2MS, Q=>, RT=>);
fbPulseCtrl[1](PT_OFF:=T#2MS, PT_ON:=T#2MS,   );
fbPulseCtrl[2](PT_OFF:=T#4MS, PT_ON:=T#4MS,    );
fbPulseCtrl[3](PT_OFF:=T#10MS, PT_ON:=T#10MS,   );

fbPulseCtrl[4](PT_OFF:=T#50MS, PT_ON:=T#50MS,   );
fbPulseCtrl[5](PT_OFF:=T#3S, PT_ON:=T#3S,    );
fbPulseCtrl[6](PT_OFF:=T#5S, PT_ON:=T#5S,   );

fbPulseCtrl[8](PT_OFF:=T#250MS, PT_ON:=T#250MS,   );

fbPulseCtrl[9](PT_OFF:=T#2S, PT_ON:=T#200MS,   );
fbPulseCtrl[10](PT_OFF:=T#10S, PT_ON:=T#10S,   );
fbPulseCtrl[1].Q;
fbPulseCtrl[1].RT;
fbPulseCtrl[2].Q;
fbPulseCtrl[2].RT;
fbPulseCtrl[3].Q;
fbPulseCtrl[3].RT;
fbPulseCtrl[4].Q;
fbPulseCtrl[4].RT;
fbPulseCtrl[5].Q;
fbPulseCtrl[5].RT;
fbPulseCtrl[6].Q;
fbPulseCtrl[6].RT;

fbPulseCtrl[8].Q;
fbPulseCtrl[8].RT;
fbPulseCtrl[9].Q;
fbPulseCtrl[9].RT;
fbPulseCtrl[10].Q;
fbPulseCtrl[10].RT;
(*
IF bWaterOn AND ( bWaterOn2   OR    ABS( arrAxisCtrl[P1AxisNo.GMWind_U].Status.fActVelo)>=5 AND  ABS (arrAxisCtrl[P1AxisNo.GMWind_D].Status.fActVelo)>=5 )   THEN
  //P3EL2889S[3,5]:= fbPulseCtrl[9].Q;
   P1EL2889S[3,1]:= fbPulseCtrl[9].Q;
   P1EL2889S[3,2]:= fbPulseCtrl[9].Q;

   P2EL2889S[4,1]:=fbPulseCtrl[9].Q	;	
   P2EL2889S[4,2]:=fbPulseCtrl[9].Q;	

   P2EL2889S[4,3]:=fbPulseCtrl[9].Q	;	
   P2EL2889S[4,4]:=fbPulseCtrl[9].Q;	

ELSE
  //P3EL2889S[3,5]:= FALSE;
   P1EL2889S[3,1]:= FALSE;
   P1EL2889S[3,2]:= FALSE;
   P2EL2889S[4,1]:= FALSE	;	
   P2EL2889S[4,2]:= FALSE;	

   P2EL2889S[4,3]:=FALSE	;	
   P2EL2889S[4,4]:=FALSE;	
END_IF


//P1EL2889S[3,1]

*)














]]></ST>
      </Implementation>
    </Action>
    <Action Name="RecBasic" Id="{e63bc7b7-ea9e-475f-ad46-8a86744fc463}">
      <Implementation>
        <ST><![CDATA[//纠偏控制
FOR i:=1 TO MaxRec DO
    fbRec[i]( RecCtrl:=arrRecCtrl[i] );
END_FOR












]]></ST>
      </Implementation>
    </Action>
