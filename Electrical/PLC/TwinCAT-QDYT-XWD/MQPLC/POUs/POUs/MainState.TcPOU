<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MainState" Id="{6ef34fba-d1da-4e27-9ef0-ec34a9427286}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MainState
VAR
	iMainSetp :INT;
	I1: UINT;
	iErrorSetp: INT;
	iLightSel: INT;
	bTurnOn: BOOL;
	bDoor_Stop: BOOL;
	I2: INT;
	I4: INT;
	I5: INT;
	i: UINT;
	iCode2: ICode;
	ExtSetVel: LREAL;
	ExtSetPos: LREAL;
	ExtSetAcc: LREAL;
	ExtSetDec: DINT;
	InitSetp: INT;
	rtStoping: R_TRIG;
	iMainInitSetp: INT;
	iMainEStopSetp: INT;
	K1: UINT;
	bInitReset: BOOL;
	DA1: INT;
	Code1: BOOL;
	Code2: BOOL;
	Code3: BOOL;
	Code4: BOOL;
	CyCtrl: INT;
	bWaterOn: BOOL;
	
	Execute: BOOL;
	bCoeWrite_GlueFeed: BOOL;
	bWaterOn2: BOOL;
	arrError:					ARRAY[1..10]OF BOOL;
	bEncloserEstop:BOOL;//外罩急停汇总
	bBoxEstop:BOOL;//按钮盒急停汇总
	F: INT;
	D195: MS_Alarm;
	D196: MS_Alarm;
	D197: MS_Alarm;
	D198: MS_Alarm;
	D199: MS_Alarm;
	D200: MS_Alarm;
	D201: MS_Alarm;
	D202: MS_Alarm;
	D203: MS_Alarm;
	D204: MS_Alarm;
	D205: MS_Alarm;
	D206: MS_Alarm;
	AnFD1: MS_Alarm;
	AnFD2: MS_Alarm;
	AnFD3: MS_Alarm;
	CaFD1: MS_Alarm;
	CaFD2: MS_Alarm;
	CaFD3: MS_Alarm;
	K2:INT;
	tCycleTimer: TON;
	bSave: BOOL;
	testii2: INT;
	bReadDataFirstCyle: BOOL;
	bReadDataCyle2: BOOL;
	bSaveTest: BOOL;
	rtSaveData: R_TRIG;
	CleanTrig: R_TRIG;
	CaCibang: R_TRIG;
	AnCibang: R_TRIG;
	CaCleanBrush:R_TRIG;
	AnCleanBrush:R_TRIG;
	
END_VAR

VAR
	R_TRIG_Bt: 			ARRAY[1..10]OF R_TRIG;
	TON20:Tc2_Standard.TON;	
//	TON21:Tc2_Standard.TON;	
	rt100:Tc2_Standard.R_TRIG;
	rt101:Tc2_Standard.R_TRIG;

	tDelayBuzze:TON;
	FanTon:TON;//除尘风机计时
	FanTonS:REAL;//除尘风机寿命秒
	FanTonH:REAL;//除尘风机寿命小时
	FanTonH_Set:REAL;//除尘风机寿命设定小时
	aAirAlarm_TON:TON;//气压报警延时；
	aTime:ARRAY[1..99] OF TON;//延时备用，1-16风速仪报警延时；
	aAlarm:ARRAY[1..99] OF BOOL;//报警预留;   1、气压不足报警；2、正极R角清废料报警；3、负极R角清废料报警；4、正极R角清废料计数错误；5、负极R角清废料计数错误；6、风机未启用报警；7、风机故障报警； 16-19、安全光栅报警；20-29、风速仪报警；30-47毛刷旋转感应报警，48毛刷旋转感应报警汇总,50:模切通道安全门报警；
	RT200:ARRAY[1..4] OF Tc2_Standard.R_TRIG;
	K3:INT;
	K4:INT;
	
	csAxis                 :ARRAY[1..MaxAxes] OF   CS_AxisCtrl;
	fbCy                   :ARRAY[1..MaxCy]    OF   FB_CylinderV2;
    fbRec                 :ARRAY[1..MaxRec]   OF   FB_Rectify;
	fbDustMotor       :ARRAY[1..MaxDust]   OF   CS_DustMoter;


    csCodeTcp:CS_CodeTcp;
    fbCamInTest: MC_CamIn;//主轴与驱动凸轮耦合

//速度模式验证
	MC_ExtSetPointGenDisable: MC_ExtSetPointGenDisable;
	MC_ExtSetPointGenEnable: MC_ExtSetPointGenEnable;
    MC_ExtSetPointGenOut:        Tc2_MC2.ST_McOutputs;
    MC_ExtSetPointGenOut2:        Tc2_MC2.ST_McOutputs;

    tonEStop:                     Tc2_Standard.TON;
   
  fbAnSetp1Moter  : CS_SetpMoter;
  fbCaSetp1Moter:CS_SetpMoter;
 // fbP4CutElectric_CY   :FB_Electric_CY;   电缸


	mc_Home    :MC_Home;

     fbCoeWrite_GlueFeed:       FB_EcCoeSdoWrite;
     	wEncodeHome                    :WORD:=6;
	test:ARRAY[1..10] OF BOOL;
	bAnReady:BOOL;//正极准备好
	bCaReady:BOOL;//负极准备好
	//fbDataXML       : FB_DataXML;
	rt10:Tc2_Standard.R_TRIG;
	testii:INT:=0;
	
	Code_MES				:ARRAY[1..20]OF  R_TRIG;
	fCode_MES				:ARRAY[1..20]OF  F_TRIG;
	tCode_MES				:ARRAY[1..20]OF  TON;
	
//模切直线电机COE寻址修改参数
	FB_EcCoESdoWrite_AnSEPTATCache : ARRAY[1..4] OF FB_EcCoESdoWrite; //正极极片缓存参数修改
	FB_EcCoESdoWrite_AnDriverDDR : ARRAY[1..4] OF FB_EcCoESdoWrite;	  //正极主驱参数修改
	FB_EcCoESdoWrite_CaSEPTATCache : ARRAY[1..4] OF FB_EcCoESdoWrite; //正极极片缓存参数修改
	FB_EcCoESdoWrite_CaDriverDDR : ARRAY[1..4] OF FB_EcCoESdoWrite;	  //正极主驱参数修改
	
	wSaveCoeCode  :DWORD:=16#65766173;    //电机参数保存
	
	SEPTATCache_fSmoothValue   :ARRAY[1..4] OF REAL;    //隔膜缓存写入参数值
	SEPTATCache_bWriteCoeValue  :ARRAY[1..4] OF BOOL;    //隔膜缓存写入执行	
	SEPTATCache_SavePara  :ARRAY[1..4] OF BOOL;   //隔膜缓存参数保存
	
	DriverDDR_fSmoothValue   :ARRAY[1..4] OF REAL;    //主驱写入参数值
	DriverDDR_bWriteCoeValue  :ARRAY[1..4] OF BOOL;    //主驱写入执行	
	DriverDDR_SavePara  :ARRAY[1..4] OF BOOL;   //主驱参数保存
	
	ExcelRate_R	:R_TRIG;	//Mes读取优报表	xfp20240316
	MTDWtStep: UINT;
	rDoorAlm :ARRAY[1..2]OF R_TRIG;
END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[	aAirAlarm_TON(IN:=NOT I205[5],PT:=T#1S,Q=>);											
R_TRIG_Bt[1](CLK:= stSysState.btnStart OR stSysState.hmiStart);//启动上升沿
R_TRIG_Bt[2](CLK:= stSysState.btnStop  OR  stSysState.hmiStop);//停止上升沿
R_TRIG_Bt[4](CLK:=  stSysState.btnAuto OR  stSysState.hmiAuto);//手自动切换上升沿
R_TRIG_Bt[5](CLK:=  NOT stSysState.btnAuto);
R_TRIG_Bt[6](CLK:=stSysState.btnEstop);
R_TRIG_Bt[7](CLK:=stSysState.btnReset OR  stSysState.hmiReset );
R_TRIG_Bt[8](CLK:=  NOT stSysState.hmiAuto);



IF R_TRIG_Bt[4].Q THEN  //自动
	stSysState.FlgAuto:=TRUE;
	stSysState.FlgManua:=FALSE;
END_IF
IF R_TRIG_Bt[5].Q  OR  R_TRIG_Bt[8].Q   THEN  //手动
	stSysState.FlgAuto:=FALSE;
	stSysState.FlgManua:=TRUE;
	stSysState.bwindow:=FALSE;
END_IF
stSysState.bReset:=R_TRIG_Bt[7].Q  OR  bInitReset    ;  //复位

stSysState.bAnccdstate:= NOT AnAlarm.arrFlowAlarm[8] AND NOT AnAlarm.arrFlowAlarm[14] AND  ((NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bSizeCCDEN  AND 
                         NOT  ProductPar.iModeEN.bChamferCCDEN AND NOT  ProductPar.iModeEN.bCuterCCDEN(* AND NOT  ProductPar.iModeEN.bLineScanCCDEN*)) OR  ProductPar.iModeEN.bP2PartEN);
stSysState.bCaccdstate:= NOT CaAlarm.arrFlowAlarm[8] AND NOT CaAlarm.arrFlowAlarm[14] AND  ((NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bSizeCCDEN  AND 
                         NOT  ProductPar.iModeEN.bChamferCCDEN AND NOT  ProductPar.iModeEN.bCuterCCDEN (*AND NOT  ProductPar.iModeEN.bLineScanCCDEN*)) OR  ProductPar.iModeEN.bP2PartEN);

//////////////////////////////////系统流程///////////////////////
CASE iMainSetp OF 
0://   INIT
    Init();
    stSysState.iMode:=0;
 IF  stSysState.bInitDone THEN
     iMainSetp:=88;	
  END_IF
88://切换手动
  IF  stSysState.FlgManua THEN
	  iMainSetp:=300;
  END_IF
   
 (***********************手动*********************************) 
300:
   stSysState.iMode:=3;
   iMainSetp:=350;  
   
350: 
  	IF  R_TRIG_Bt[1].Q  AND stSysState.FlgAuto THEN  //启动按钮  
		IF stSysState.bAutoCondition THEN
		  stSysState.bwindow:=TRUE;	
	      iMainSetp:=90;
	    END_IF
	END_IF 
	
	IF  stSysState.FlgManua AND TON20.Q THEN  //系统清除
	   iMainSetp:=999;
	END_IF

 90:	
  	IF  R_TRIG_Bt[1].Q  AND stSysState.FlgAuto AND NOT stSysState.bwindow  THEN  //启动按钮  
		IF stSysState.bAutoCondition AND (stSysState.bAnccdstate OR ProductPar.iModeEN.iModeRun=1) AND (stSysState.bCaccdstate OR ProductPar.iModeEN.iModeRun=2) THEN
	      iMainSetp:=100;
	    END_IF
		
	ELSIF stSysState.FlgManua OR  stSysState.btnStop  OR  stSysState.hmiStop   OR   stSysState.bErrorStop OR 
          stSysState.btnEstop OR NOT stSysState.bAnccdstate OR NOT stSysState.bCaccdstate  THEN
		  iMainSetp:=300;
	END_IF 	
	
 (************************自动********************************) 
100:
   stSysState.iMode:=1;
   iMainSetp:=150;  
150:  //系统停止中......
    rtStoping(Clk:=stSysState.FlgManua OR  stSysState.btnStop  OR  stSysState.hmiStop   OR   stSysState.bErrorStop OR stSysState.btnEstop);  //自动中触发手动 停止 按钮  stSysRun.bErrorStop 包括正极和负极
    IF stSysState.FlgManua OR  stSysState.btnStop  OR  stSysState.hmiStop   OR   stSysState.bErrorStop OR stSysState.btnEstop THEN //自动触发停止 rtStoping.Q
		stSysState.Stoping:=TRUE;
		iMainSetp:=160; //
	END_IF;
	
160: //判断停止完成
   	IF  stSysState.bStopFinished  THEN
		AnSys.bStopFinished:=FALSE; 
		CaSys.bStopFinished:=FALSE;
       	stSysState.Stoping:=FALSE;
		IF NOT  stSysState.btnEstop THEN
			iMainSetp:=300; 
		ELSE
			stSysState.bInitDone:=FALSE;
			iMainSetp:=400; 	
		END_IF
	END_IF;
	
 (************************急停********************************) 
400://Stoping
   stSysState.iMode:=4;
    EStop();  
   iMainSetp:=450; 
      
450: //急停跳出 
	IF  NOT  stSysState.btnEstop  THEN  
        tonEStop(IN:=FALSE , PT:=T#50MS );
	    iMainSetp:=0;
    ELSE
         tonEStop(IN:=TRUE , PT:=T#50MS );
         IF  tonEStop.Q THEN
              tonEStop(IN:=FALSE , PT:=T#50MS );
              iMainSetp:=400;   
         END_IF
   	 END_IF

END_CASE


IF   stSysState.btnEstop   THEN  //AND  stSysState.iMode=3
	  iMainSetp:=400;
END_IF



(***************程序调用*********************)



AnPart(iMode:=stSysState.iMode);
CaPart(iMode:=stSysState.iMode);
//	XML();
   Condition();
    MotionBasic();
    CyBasic();
    RecBasic();
     Alarm();
     Pusle();
	 MS_Alarm();
	 Motion_coe();
	 MesCollect();
//PoleData.AnBeltData[1].Meney.SizeResults;]]></ST>
    </Implementation>
    <Action Name="Alarm" Id="{4b075792-06ef-4c2e-843f-ecf9e6644509}">
      <Implementation>
        <ST><![CDATA[
IF NOT ProductPar.iModeEN.bDoorEN THEN
	IF NOT I206[15] THEN
		aAlarm[49]:=TRUE;//模切通道安全门报警
	END_IF
END_IF



IF R_TRIG_Bt[7].Q THEN
	FOR K1:=1 TO MaxAxes DO 
     arrAxisAlarm[K1]:=  FALSE ;
END_FOR
END_IF
(******************气缸报警*******************)
FOR K1:=1 TO MaxCy DO 
     arrCYOnAlarm[K1]:=  arrCyCtrl[K1] .Status.Error1;
     arrCYOFFAlarm[K1]:=  arrCyCtrl[K1] .Status.Error2;
END_FOR
(******************正极气缸报警*******************)
bAnCYHaveAlarm:=FALSE;
FOR K1:=1 TO 20 DO 
      bAnCYHaveAlarm:=(bAnCYHaveAlarm OR arrCYOnAlarm[K1] OR  arrCYOFFAlarm[K1]) ;
END_FOR
FOR K1:=41 TO 60 DO 
      bAnCYHaveAlarm:=(bAnCYHaveAlarm OR arrCYOnAlarm[K1] OR  arrCYOFFAlarm[K1]) ;
END_FOR
(******************负极气缸报警*******************)
bCaCYHaveAlarm:=FALSE;
FOR K1:=21 TO 40 DO 
      bCaCYHaveAlarm:=(bCaCYHaveAlarm OR arrCYOnAlarm[K1] OR  arrCYOFFAlarm[K1]) ;
END_FOR
FOR K1:=61 TO MaxCy DO 
      bCaCYHaveAlarm:=(bCaCYHaveAlarm OR arrCYOnAlarm[K1] OR  arrCYOFFAlarm[K1]) ;
END_FOR

(******************切刀计数报警*************)
IF ProductPar.AnPar.iMouldCount1>= ProductPar.AnPar.iMouldCountAlarm1 THEN   //正极前模具切刀计数报警
	CuterCountAlarm[1]:=TRUE;
	ELSE
	CuterCountAlarm[1]:=FALSE;	
END_IF
(*IF ProductPar.AnPar.iMouldCount2>= ProductPar.AnPar.iMouldCountAlarm2 THEN   //正极后模具切刀计数报警
	CuterCountAlarm[2]:=TRUE;
	ELSE
	CuterCountAlarm[2]:=FALSE;	
END_IF*)
IF ProductPar.AnPar.iCuterCount>= ProductPar.AnPar.iCuterCountAlarm THEN   //正极裁切切刀计数报警
	CuterCountAlarm[3]:=TRUE;
	ELSE
	CuterCountAlarm[3]:=FALSE;	
END_IF
IF ProductPar.CaPar.iMouldCount1>= ProductPar.CaPar.iMouldCountAlarm1 THEN   //负极前模具切刀计数报警
	CuterCountAlarm[4]:=TRUE;
	ELSE
	CuterCountAlarm[4]:=FALSE;	
END_IF
(*IF ProductPar.CaPar.iMouldCount2>= ProductPar.CaPar.iMouldCountAlarm2 THEN   //负极后模具切刀计数报警
	CuterCountAlarm[5]:=TRUE;
	ELSE
	CuterCountAlarm[5]:=FALSE;	
END_IF*)
IF ProductPar.CaPar.iCuterCount>= ProductPar.CaPar.iCuterCountAlarm THEN   //负极裁切切刀计数报警
	CuterCountAlarm[6]:=TRUE;
	ELSE
	CuterCountAlarm[6]:=FALSE;	
END_IF

IF CuterCountAlarm[1] OR CuterCountAlarm[3] OR CuterCountAlarm[4] OR CuterCountAlarm[6] THEN// OR CuterCountAlarm[2] OR CuterCountAlarm[5]
	b_lifetime:=TRUE;
	ELSE
	b_lifetime:=FALSE;	
END_IF

IF ProductPar.AnPar.iCuterCount>= ProductPar.AnPar.iCuterCountWarning THEN    //正极裁切切刀计数预警
	CuterCountAlarm[7]:=TRUE;
	ELSE
	CuterCountAlarm[7]:=FALSE;	
END_IF
IF ProductPar.CaPar.iCuterCount>= ProductPar.CaPar.iCuterCountWarning THEN   //负极裁切切刀计数预警
	CuterCountAlarm[8]:=TRUE;
	ELSE
	CuterCountAlarm[8]:=FALSE;	
END_IF

(****************轴报警**************)
(*
FOR K1:=1 TO MaxAxes DO 
     arrAxisAlarm[K1]:=  arrAxis[K1] .Status.Error AND  arrAxis[K1] .Status.ErrorID<>16#42A0 OR NOT arrAxisCtrl[K1] .Status.Enabled ;
END_FOR
*)
(****************正极轴报警**************)
bAnAxisHaveAlarm:=FALSE;
FOR K1:=1 TO 15 DO 
		IF K1<>3 AND K1<>4 THEN
				arrAxisAlarm[K1]:=  arrAxis[K1] .Status.Error AND  arrAxis[K1] .Status.ErrorID<>16#42A0  ;//OR NOT arrAxisCtrl[K1] .Status.Enabled
				bAnAxisHaveAlarm:=bAnAxisHaveAlarm OR arrAxisAlarm[K1]  ;//OR arrAxisCtrl[K1] .Status.ErrorLimitSwitch
		END_IF
END_FOR

FOR K1:=18 TO 22 DO 
	  arrAxisAlarm[K1]:=  arrAxis[K1] .Status.Error AND  arrAxis[K1] .Status.ErrorID<>16#42A0  ;//OR NOT arrAxisCtrl[K1] .Status.Enabled
      bAnAxisHaveAlarm:=bAnAxisHaveAlarm OR arrAxisAlarm[K1]  ;//OR arrAxisCtrl[K1] .Status.ErrorLimitSwitch
END_FOR

FOR K1:=50 TO 52 DO 
	  arrAxisAlarm[K1]:=  arrAxis[K1] .Status.Error AND  arrAxis[K1] .Status.ErrorID<>16#42A0  ;//OR NOT arrAxisCtrl[K1] .Status.Enabled
      bAnAxisHaveAlarm:=bAnAxisHaveAlarm OR arrAxisAlarm[K1]  ;//OR arrAxisCtrl[K1] .Status.ErrorLimitSwitch
END_FOR

(****************负极轴报警**************)
bCaAxisHaveAlarm:=FALSE;
FOR K1:=25 TO 39 DO 
		IF K1<>27 AND K1<>28 THEN
				arrAxisAlarm[K1]:=  arrAxis[K1] .Status.Error AND  arrAxis[K1] .Status.ErrorID<>16#42A0  ;//OR NOT arrAxisCtrl[K1] .Status.Enabled
				bCaAxisHaveAlarm:=bCaAxisHaveAlarm OR arrAxisAlarm[K1]  ;//OR arrAxisCtrl[K1] .Status.ErrorLimitSwitch
		END_IF
END_FOR

FOR K1:=42 TO 46 DO 
	  arrAxisAlarm[K1]:=  arrAxis[K1] .Status.Error AND  arrAxis[K1] .Status.ErrorID<>16#42A0  ;//OR NOT arrAxisCtrl[K1] .Status.Enabled
      bCaAxisHaveAlarm:=bCaAxisHaveAlarm OR arrAxisAlarm[K1]  ;//OR arrAxisCtrl[K1] .Status.ErrorLimitSwitch
END_FOR

FOR K1:=56 TO 58 DO
	  arrAxisAlarm[K1]:=  arrAxis[K1] .Status.Error AND  arrAxis[K1] .Status.ErrorID<>16#42A0  ; //OR NOT arrAxisCtrl[K1] .Status.Enabled
      bCaAxisHaveAlarm:=bCaAxisHaveAlarm OR arrAxisAlarm[K1]  ;//OR arrAxisCtrl[K1] .Status.ErrorLimitSwitch
END_FOR

(******************张力报警*******************)
bAnTenHaveAlarm :=FALSE;
bCaTenHaveAlarm :=FALSE;
FOR K1:=1 TO 15 DO 
      bAnTenHaveAlarm:=bAnTenHaveAlarm OR AnAlarm.arrTenAlarm[K1];
	  bCaTenHaveAlarm:=bCaTenHaveAlarm OR CaAlarm.arrTenAlarm[K1];
END_FOR

(******************凸轮报警*******************)
bAnCreatTableHaveAlarm :=FALSE;
bCaCreatTableHaveAlarm :=FALSE;
bAnCamHaveAlarm :=FALSE;
bCaCamHaveAlarm :=FALSE;
FOR K1:=1 TO 30 DO 
      bAnCreatTableHaveAlarm:=bAnCreatTableHaveAlarm OR AnAlarm.arrCreatTableAlarm[K1];
	  bCaCreatTableHaveAlarm:=bCaCreatTableHaveAlarm OR CaAlarm.arrCreatTableAlarm[K1];
	  bAnCamHaveAlarm:=bAnCamHaveAlarm OR AnAlarm.arrCamInAlarm[K1];
	  bCaCamHaveAlarm:=bAnCamHaveAlarm OR CaAlarm.arrCamInAlarm[K1];
END_FOR

(******************齿轮报警*******************)
bAnGearHaveAlarm :=FALSE;
bCaGearHaveAlarm :=FALSE;
FOR K1:=1 TO 25 DO 
      bAnGearHaveAlarm:=bAnGearHaveAlarm OR AnAlarm.arrGearAlarm[K1];
	  bCaGearHaveAlarm:=bCaGearHaveAlarm OR CaAlarm.arrGearAlarm[K1];
END_FOR

(******************流程报警*******************)
bAnFlowHaveAlarm :=FALSE;
bCaFlowHaveAlarm :=FALSE;
FOR K1:=1 TO 50 DO 
      bAnFlowHaveAlarm:=bAnFlowHaveAlarm OR AnAlarm.arrFlowAlarm[K1];
	  bCaFlowHaveAlarm:=bCaFlowHaveAlarm OR CaAlarm.arrFlowAlarm[K1];
END_FOR

(******************提示*******************)
bAnHaveLightWarn :=FALSE;
bCaHaveLightWarn :=FALSE;
FOR K1:=1 TO 50 DO 
      bAnHaveLightWarn:=bAnHaveLightWarn OR AnAlarm.arrLightWarn[K1];
	  bCaHaveLightWarn:=bCaHaveLightWarn OR CaAlarm.arrLightWarn[K1];
END_FOR
(***DDR负数报警***)
(***DDR负数报警***)
IF arrAxisCtrl[NameNo.CaAxisNo.DriverDDR].Status.fActPos<-1 THEN
	CaAlarm.arrFlowAlarm[30]:=TRUE;
END_IF
IF arrAxisCtrl[NameNo.AnAxisNo.DriverDDR].Status.fActPos<-1 THEN
	AnAlarm.arrFlowAlarm[30]:=TRUE;
END_IF

 IF   stSysState.bReset AND  AnAlarm.arrFlowAlarm[30] THEN
	    arrAxisCtrl[NameNo.AnAxisNo.DriverDDR].Cmd.fSetPos:=360;
		arrAxisCtrl[NameNo.AnAxisNo.DriverDDR].Cmd.bSetPos:=TRUE;
		AnAlarm.arrFlowAlarm[30]:=FALSE;
ELSIF  stSysState.bReset AND CaAlarm.arrFlowAlarm[30] THEN
	    arrAxisCtrl[NameNo.CaAxisNo.DriverDDR].Cmd.fSetPos:=360;
		arrAxisCtrl[NameNo.CaAxisNo.DriverDDR].Cmd.bSetPos:=TRUE;
		CaAlarm.arrFlowAlarm[30]:=FALSE;
 END_IF

 (******************报警复位*****************)
 FOR K3:=1 TO 98 DO 
	IF   stSysState.bReset AND  aAlarm[K3]AND NOT aAlarm[52] AND NOT aAlarm[53] AND NOT aAlarm[54]  THEN
			aAlarm[K3]:=FALSE;
	END_IF
END_FOR

(***气压不足报警***)
IF aAirAlarm_TON.Q THEN
	aAlarm[1]:=TRUE;
END_IF
YL_Q[1]:=aAlarm[1];//气压报警传给叠台；
(*
(*** R角废料清洁提示***)
IF  YL_GVL2[1]>=YL_GVL2[2] THEN//正极R角清废料报警；
	aAlarm[2]:=TRUE;
END_IF

IF  YL_GVL2[1]< 0 THEN//正极R角清废料计数错误；
	aAlarm[4]:=TRUE;
END_IF
///////////////////////////
IF    YL_GVL2[3] >=YL_GVL2[4] THEN//负极R角清废料报警；
	aAlarm[3]:=TRUE;
END_IF

IF  YL_GVL2[3] < 0 THEN//负极R角清废料计数错误；
	aAlarm[5]:=TRUE;
END_IF
/////////////////////////////
//复位
IF   stSysState.bReset AND  (aAlarm[2] OR  aAlarm[4] )THEN
		YL_GVL2[1]:=0;
		aAlarm[2]:=FALSE;
		aAlarm[4]:=FALSE;
END_IF

IF   stSysState.bReset AND  (aAlarm[3] OR  aAlarm[5] )THEN
		YL_GVL2[3]:=0;
		aAlarm[3]:=FALSE;
		aAlarm[5]:=FALSE;
END_IF
*)
(*** 除尘风机报警提示***)
aAlarm[6];//风机未启用报警；
IF NOT ProductPar.iModeEN.bFounctionClose[2] THEN
		IF NOT YL_I[1] OR NOT YL_I[3] OR NOT YL_I[5] OR NOT YL_I[7] THEN//2个5.5KW的吸片风机,2个除尘风机；
			aAlarm[6]:=TRUE;//风机未启用报警；
		END_IF
		IF  YL_I[2] OR YL_I[4] OR YL_I[6] OR YL_I[8]  THEN
			aAlarm[7]:=TRUE;// 风机故障报警；
		END_IF
END_IF
FanTon(IN:=NOT aAlarm[6]AND NOT FanTon.Q,PT:=T#1S,Q=>);
IF FanTon.Q THEN
	FanTonS:=FanTonS+1;
END_IF
IF FanTonS>=3600 THEN
	FanTonH:=FanTonH+1;
	FanTonS:=0;
END_IF
IF FanTonH_Set>=FanTonH THEN
	aAlarm[61]:=TRUE;;//风机寿命报警
END_IF



(*** 除尘毛刷气缸没有升起报警***)

IF stSysState.iMode=1 AND NOT 	arrCyCtrl[NameNo.AnCYNo.PoleBrushDustPush_U].Io.DIOFFSwitch THEN
				aAlarm[8]:=TRUE;//	正极上表面毛刷除尘升降气缸位置异常；
END_IF
IF stSysState.iMode=1 AND NOT	arrCyCtrl[NameNo.AnCYNo.PoleWindDustPush_U].Io.DIOFFSwitch THEN
				aAlarm[9]:=TRUE;//	正极上表面风刀除尘升降气缸位置异常;
END_IF
IF stSysState.iMode=1 AND NOT	arrCyCtrl[NameNo.AnCYNo.PoleBrushDustPush_D].Io.DIOFFSwitch THEN
				aAlarm[10]:=TRUE;//	正极下表面毛刷除尘升降气缸位置异常;
END_IF
IF stSysState.iMode=1 AND NOT	arrCyCtrl[NameNo.AnCYNo.PoleWindDustPush_D].Io.DIOFFSwitch THEN
				aAlarm[11]:=TRUE;//	//	正极下表面风刀除尘升降气缸位置异常;
END_IF
////////////////////////
IF stSysState.iMode=1 AND NOT 	arrCyCtrl[NameNo.CaCYNo.PoleBrushDustPush_U].Io.DIOFFSwitch THEN
				aAlarm[12]:=TRUE;//	负极上表面毛刷除尘升降气缸位置异常；
END_IF
IF stSysState.iMode=1 AND NOT	arrCyCtrl[NameNo.CaCYNo.PoleWindDustPush_U].Io.DIOFFSwitch THEN
				aAlarm[13]:=TRUE;//	负极上表面风刀除尘升降气缸位置异常;
END_IF
IF stSysState.iMode=1 AND NOT	arrCyCtrl[NameNo.CaCYNo.PoleBrushDustPush_D].Io.DIOFFSwitch THEN
				aAlarm[14]:=TRUE;//	负极下表面毛刷除尘升降气缸位置异常;
END_IF
IF stSysState.iMode=1 AND NOT	arrCyCtrl[NameNo.CaCYNo.PoleWindDustPush_D].Io.DIOFFSwitch THEN
				aAlarm[15]:=TRUE;//	负极下表面风刀除尘升降气缸位置异常;
END_IF

(*** 安全光栅报警***)
IF NOT AnSenser.biSafetyCurtain_M THEN
	aAlarm[16]:=TRUE;
END_IF
IF NOT AnSenser.biSafetyCurtain_C THEN
	aAlarm[17]:=TRUE;
END_IF		
	
IF NOT CaSenser.biSafetyCurtain_M THEN
	aAlarm[18]:=TRUE;
END_IF
IF NOT CaSenser.biSafetyCurtain_C THEN
	aAlarm[19]:=TRUE;
END_IF	
	
(***************风速仪报警**************)
(***************风速仪报警**************)

aTime[1](IN:=I107[8],PT:=T#20S,Q=>	);
aTime[2](IN:=I107[9],PT:=T#20S,Q=>	);
aTime[3](IN:=I107[10],PT:=T#20S,Q=>	);
aTime[4](IN:=I107[11],PT:=T#20S,Q=>	);
aTime[5](IN:=I107[12],PT:=T#20S,Q=>	);

aTime[6](IN:=I207[8],PT:=T#20S,Q=>	);
aTime[7](IN:=I207[9],PT:=T#20S,Q=>	);
aTime[8](IN:=I207[10],PT:=T#20S,Q=>	);
aTime[9](IN:=I207[11],PT:=T#20S,Q=>	);
aTime[10](IN:=I207[12],PT:=T#20S,Q=>);

IF NOT ProductPar.iModeEN.bFounctionClose[1] THEN//风速仪屏蔽
	IF aTime[1].Q THEN
		aAlarm[20]:=TRUE;
	END_IF
	IF aTime[2].Q THEN
		aAlarm[21]:=TRUE;
	END_IF
	IF aTime[3].Q THEN
		aAlarm[22]:=TRUE;
	END_IF
	IF aTime[4].Q THEN
		aAlarm[23]:=TRUE;
	END_IF
	IF aTime[5].Q THEN
		aAlarm[24]:=TRUE;
	END_IF
	IF aTime[6].Q THEN
		aAlarm[25]:=TRUE;
	END_IF
	IF aTime[7].Q THEN
		aAlarm[26]:=TRUE;
	END_IF
	IF aTime[8].Q THEN
		aAlarm[27]:=TRUE;
	END_IF
	IF aTime[9].Q THEN
		aAlarm[28]:=TRUE;
	END_IF
	IF aTime[10].Q THEN
		aAlarm[29]:=TRUE;
	END_IF
ELSE
	FOR i:=20 TO 29 DO
		aAlarm[i]:=FALSE;
	END_FOR	
END_IF
(******************毛刷感应报警********************)
FOR K4:=30 TO 47 DO 
     aAlarm[48]:=  aAlarm[K4];
END_FOR
(*
(***********摆杆电机扭矩值设置过小报警************)
IF iTargetTorque[1]>-20 THEN
	aAlarm[50]:=TRUE;//正极；
END_IF
IF iTargetTorque[2]>-20 THEN
	aAlarm[51]:=TRUE;//负极；
END_IF
*)
(****************模切清洁报警*********************)

CleanTrig(CLK:= (ProductPar.CleanTimeHMIHour1 = System.StTime.wHour AND ProductPar.CleanTimeHMIMin1 =System.stTime.wMinute)
OR (ProductPar.CleanTimeHMIHour2 = System.StTime.wHour AND ProductPar.CleanTimeHMIMin2 =System.stTime.wMinute)
OR (ProductPar.CleanTimeHMIHour3 = System.StTime.wHour AND ProductPar.CleanTimeHMIMin3 =System.stTime.wMinute)
OR (ProductPar.CleanTimeHMIHour4 = System.StTime.wHour AND ProductPar.CleanTimeHMIMin4 =System.stTime.wMinute));
IF CleanTrig.Q THEN
	aAlarm[52]:=TRUE;//请清洁机台
END_IF
(****************磁棒校验时间报警******************)
AnCibang(CLK:= (ProductPar.CibangTimeHMIHour1 = System.StTime.wHour AND ProductPar.CibangTimeHMIDay1 =System.stTime.wDay));
CaCibang(CLK:= (ProductPar.CibangTimeHMIHour2 = System.StTime.wHour AND ProductPar.CibangTimeHMIDay2 =System.stTime.wDay));
IF AnCibang.Q THEN
	aAlarm[53]:=TRUE;//正极磁棒校验时间报警
END_IF
IF CaCibang.Q THEN
	aAlarm[54]:=TRUE;//负极磁棒校验时间报警
END_IF
(****************模切毛刷清洁时间****************)
AnCleanBrush(CLK:= (ProductPar.BrushTimeHMIHour1 = System.StTime.wHour AND ProductPar.BrushTimeHMIDay1 =System.stTime.wDay));
CaCleanBrush(CLK:= (ProductPar.BrushTimeHMIHour2 = System.StTime.wHour AND ProductPar.BrushTimeHMIDay2 =System.stTime.wDay));
IF AnCleanBrush.Q THEN
	aAlarm[62]:=TRUE;//正极毛刷清洁时间报警
END_IF
IF CaCleanBrush.Q THEN
	aAlarm[63]:=TRUE;//负极毛刷清洁时间报警
END_IF

IF NOT  DTM_Mes1.bFuncEN[0] AND NOT ProductPar.iModeEN.bP2PartEN AND (DTM_Mes1.bFuncEN[1] OR DTM_Mes1.bFuncEN[2] OR DTM_Mes1.bFuncEN[3] OR
	        DTM_Mes1.bFuncEN[4] OR DTM_Mes1.bFuncEN[5] OR DTM_Mes1.bFuncEN[6] OR DTM_Mes1.bFuncEN[7] )  THEN
		 aAlarm[64]:=TRUE;//模切有功能屏蔽报警
END_IF		
			


 AnAlarm.arrFlowAlarm[9];
AnAlarm.arrFlowAlarm[10];
AnAlarm.arrFlowAlarm[11];
AnAlarm.arrFlowAlarm[12];
AnAlarm.arrFlowAlarm[13];
CaAlarm.arrFlowAlarm[9];
CaAlarm.arrFlowAlarm[10];
CaAlarm.arrFlowAlarm[11];
CaAlarm.arrFlowAlarm[12];
CaAlarm.arrFlowAlarm[13];
(*===============================================报警信息============================================================*)
(*****************报警汇总****************)////根据实际情况汇总
//正极报警汇总
arrError[1]:=bAnAxisHaveAlarm OR bAnCYHaveAlarm OR bAnTenHaveAlarm OR bAnCreatTableHaveAlarm OR bAnCamHaveAlarm OR bAnGearHaveAlarm OR bAnFlowHaveAlarm OR aAlarm[16] OR aAlarm[17] OR aAlarm[49]
		OR AnAlarm.arrFlowAlarm[9] OR AnAlarm.arrFlowAlarm[10] OR AnAlarm.arrFlowAlarm[11] OR AnAlarm.arrFlowAlarm[12] OR AnAlarm.arrFlowAlarm[13]
		OR CaAlarm.arrFlowAlarm[9] OR CaAlarm.arrFlowAlarm[10] OR CaAlarm.arrFlowAlarm[11] OR CaAlarm.arrFlowAlarm[12] OR CaAlarm.arrFlowAlarm[13] OR CuterCountAlarm[3];
//负极报警汇总
arrError[2]:=bCaAxisHaveAlarm OR bCaCYHaveAlarm OR bCaTenHaveAlarm OR bCaCreatTableHaveAlarm OR bCaCamHaveAlarm OR bCaGearHaveAlarm OR bCaFlowHaveAlarm OR aAlarm[18] OR aAlarm[19] OR aAlarm[49]
		OR AnAlarm.arrFlowAlarm[9] OR AnAlarm.arrFlowAlarm[10] OR AnAlarm.arrFlowAlarm[11] OR AnAlarm.arrFlowAlarm[12] OR AnAlarm.arrFlowAlarm[13]
		OR CaAlarm.arrFlowAlarm[9] OR CaAlarm.arrFlowAlarm[10] OR CaAlarm.arrFlowAlarm[11] OR CaAlarm.arrFlowAlarm[12] OR CaAlarm.arrFlowAlarm[13] OR CuterCountAlarm[6];
//提示
arrError[3]:=(ProductPar.iModeEN.iModeRun=0 AND (bAnHaveLightWarn OR bCaHaveLightWarn)) OR
				   (ProductPar.iModeEN.iModeRun=1 AND bAnHaveLightWarn) OR 
				   (ProductPar.iModeEN.iModeRun=2 AND bCaHaveLightWarn);

arrError[4];
arrError[5]:=CaAlarm.arrFlowAlarm[30] OR AnAlarm.arrFlowAlarm[30] OR aAlarm[1] OR aAlarm[2] OR aAlarm[3] OR aAlarm[4] OR aAlarm[5]  OR aAlarm[6] OR aAlarm[7] OR aAlarm[8] OR aAlarm[9]
					OR aAlarm[10] OR aAlarm[11] OR aAlarm[12] OR aAlarm[13] OR aAlarm[14] OR aAlarm[15]OR aAlarm[52]OR aAlarm[53]OR aAlarm[54] ;

stSysState.bErrorStop:=(ProductPar.iModeEN.iModeRun=0 AND (arrError[1] OR arrError[2])) OR
								   (ProductPar.iModeEN.iModeRun=1 AND arrError[1]) OR 
								   (ProductPar.iModeEN.iModeRun=2 AND arrError[2])OR arrError[5] OR aAlarm[64];
								   
								   
rDoorAlm[1](CLK:=(AnAlarm.arrFlowAlarm[9] OR AnAlarm.arrFlowAlarm[10] OR AnAlarm.arrFlowAlarm[11] OR AnAlarm.arrFlowAlarm[12] OR AnAlarm.arrFlowAlarm[13]) AND NOT
                            bAnAxisHaveAlarm AND NOT bAnCYHaveAlarm AND NOT bAnTenHaveAlarm AND NOT bAnCreatTableHaveAlarm AND NOT bAnCamHaveAlarm AND NOT
                           bAnGearHaveAlarm AND NOT bAnFlowHaveAlarm AND NOT aAlarm[16] AND NOT aAlarm[17] AND NOT aAlarm[49]  AND NOT CuterCountAlarm[3] );
rDoorAlm[2](CLK:=(CaAlarm.arrFlowAlarm[9] OR CaAlarm.arrFlowAlarm[10] OR CaAlarm.arrFlowAlarm[11] OR CaAlarm.arrFlowAlarm[12] OR CaAlarm.arrFlowAlarm[13]) AND NOT 
                            bCaAxisHaveAlarm AND NOT bCaCYHaveAlarm AND NOT bCaTenHaveAlarm AND NOT bCaCreatTableHaveAlarm AND NOT bCaCamHaveAlarm AND NOT 
                            bCaGearHaveAlarm AND NOT bCaFlowHaveAlarm AND NOT aAlarm[18] AND NOT aAlarm[19] AND NOT aAlarm[49]AND NOT CuterCountAlarm[6] );
IF 	rDoorAlm[1].Q OR bCaDoorALM THEN						
	bAnDoorALM:=TRUE;
END_IF			

IF 	rDoorAlm[1].Q THEN						
	bCaDoorALM:=TRUE;
END_IF		

IF NOT stSysState.bErrorStop AND bAnDoorALM THEN
	bAnDoorALM:=FALSE;
END_IF		
	
IF NOT stSysState.bErrorStop AND bCaDoorALM THEN
	bCaDoorALM:=FALSE;
END_IF				
(*==============报警复位=========================*)
//轴  气缸报警  红灯亮       蜂鸣器 0.5秒 频率 响 8 秒后停止    

IF stSysState.iMode=3 THEN
	stSysState.bReset:=stSysState.btnReset;
END_IF

(*****蜂鸣器*****)
rt100(CLK:=stSysState.bErrorStop, Q=> );
rt101(CLK:=arrError[3]  , Q=> );
IF rt100.Q THEN
	iErrorSetp:=100;//故障报警
END_IF

IF rt101.Q THEN
	iErrorSetp:=200;//警告报警
END_IF


tDelayBuzze(IN:= , PT:= , Q=> , ET=> );
CASE iErrorSetp   OF
100:
  tDelayBuzze.PT:=T#8S;
  tDelayBuzze.IN:=TRUE;
  iErrorSetp:=500;
200:
  tDelayBuzze.PT:=T#4S;
   tDelayBuzze.IN:=TRUE;
  iErrorSetp:=600;
500:
		stSysState.boBuzzer:= Pulse._250ms.Q;  //   (NOT bError1 AND NOT bError2) AND
		IF tDelayBuzze.Q  THEN
			iErrorSetp:=0;
			tDelayBuzze.IN:=FALSE;
			stSysState.boBuzzer:=FALSE;
		END_IF
600:
	IF stSysState.iMode=1 AND NOT stSysState.bErrorStop THEN
		stSysState.boRedLight:=Pulse._1s.Q;
	END_IF
		stSysState.boBuzzer:= Pulse._1s.Q;  //    (NOT bError1 AND NOT bError2) AND
		IF tDelayBuzze.Q  THEN
			iErrorSetp:=0;
			tDelayBuzze.IN:=FALSE;
			IF stSysState.iMode=1 AND NOT stSysState.bErrorStop THEN
				stSysState.boRedLight:=FALSE;
			END_IF
			stSysState.boBuzzer:=FALSE;
		END_IF

END_CASE


(*****三色灯控制*********)
//自动   绿
    RT200[1](CLK:=stSysState.iMode=1 AND NOT stSysState.bErrorStop , Q=> ); 
   IF RT200[1].Q THEN
	  bTurnOn:=TRUE;
      iLightSel:=3;
   END_IF       
//手动  黄
    RT200[2](CLK:=stSysState.iMode=3 AND NOT stSysState.bErrorStop , Q=> ); 
   IF RT200[2].Q THEN
	  bTurnOn:=TRUE;
      iLightSel:=2;
   END_IF 

//暂停   黄
    RT200[3](CLK:=stSysState.iMode=2 AND NOT stSysState.bErrorStop , Q=> ); 
   IF RT200[3].Q THEN
	  bTurnOn:=TRUE;
      iLightSel:=2;
   END_IF 
   
//暂停   红   //急停 OR 故障
    RT200[4](CLK:=stSysState.iMode=4  OR stSysState.bErrorStop  , Q=> ); 
   IF RT200[4].Q THEN
	  bTurnOn:=TRUE;
      iLightSel:=1;
   END_IF    
   
IF bTurnOn THEN
	CASE iLightSel OF 
	  1: //红灯
		stSysState.boGreenLight:=FALSE;
		stSysState.boRedLight:=TRUE;
		stSysState.boYellowLight:=FALSE;
	
	  2://黄灯
		stSysState.boGreenLight:=FALSE;
		stSysState.boRedLight:=FALSE;
		stSysState.boYellowLight:=TRUE;
	
	  3://绿灯
		stSysState.boGreenLight:=TRUE;
		stSysState.boRedLight:=FALSE;
		stSysState.boYellowLight:=FALSE;
	
	END_CASE
   bTurnOn:=FALSE;
END_IF
arrAxis[4].Status.Homed;
arrAxis[5].Status.Homed;
arrAxis[6].Status.Homed;
