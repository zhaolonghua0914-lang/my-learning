	sNetId:= '192.168.10.10.4.1', 
	nSlaveAddr:=1026 ,   //模切主驱
	nSubIndex:=0 , 
	nIndex:=16#2109 ,   // 平滑方式
	pSrcBuf:=ADR(wSaveCoeCode),  
	cbBufLen:=SIZEOF(wSaveCoeCode),    
	bExecute:= DriverDDR_SavePara[2],    
	tTimeout:= T#3S, 
	bBusy=> , 
	bError=> , 
	nErrId=> );	
			
	



	
	
	
	
	
	
	
	
	
	

//////////////////////////////////////////////////////////////////////负极////////////////////////////////////////////////////////////////////

//负极模切缓存
