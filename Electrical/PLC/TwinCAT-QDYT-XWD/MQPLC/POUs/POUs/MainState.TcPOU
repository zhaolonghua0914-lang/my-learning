    <Action Name="MotionBasic" Id="{3a0b1861-7a08-44c7-b364-48f37a0928ea}">
      <Implementation>
        <ST><![CDATA[

//
FOR i:=1 TO MaxAxes DO
IF i<>9 AND i<>33 AND i<>20 AND i<>21 AND i<>22 AND i<>44 AND i<>45 AND i<>46   THEN
  	arrAxisCtrl[i].Cmd.JogN_Condition:=NOT arrAxisCtrl[i].Io.biNegLimit;
	arrAxisCtrl[i].Cmd.JogP_Condition:=NOT arrAxisCtrl[i].Io.biPosLimit;
END_IF		
	csAxis[i](bReset:=stSysState.bReset , Axis:=arrAxis[i] , stAxisCtrl:=arrAxisCtrl[i] , stAxisPar:=arrAxisPar[i] );
	arrAxisPar[i].fHomeSlowSpeed:=arrAxisPar[i].fHomeFastSpeed/5;
END_FOR

FOR i:=1 TO MaxDust DO
  fbDustMotor[i](stSetpMotor:=arrDustMotor[i]);
END_FOR

FOR i:=1 TO NumOfDrives DO
  arrAxisCtrl[i].Status.bDrivesOP:=DrivesOP[i]=8;//(DrivesOP[i]=8 AND i<>3 AND i<>27) OR (DrivesOP[i]=10 AND (i=3 OR i=27));
END_FOR

fbAnSetp1Moter(stSetpMotor:=AnSetpMotor );//正极NG排杆电机
fbCaSetp1Moter(stSetpMotor:=CaSetpMotor );//负极NG排杆电机

IF ABS(iTargetTorque[1])>150 THEN
	iTargetTorque[1]:=0;
END_IF
IF ABS(iTargetTorque[2])>150 THEN
	iTargetTorque[2]:=0;
END_IF

//////////////张力摆杆超速后断开使能////////
IF (arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Io.biNegLimit OR arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Io.biPosLimit) AND arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Status.fActVelo>500 THEN
	arrAxisCtrl[NameNo.AnAxisNo.PoleTension].Cmd.bEnable:=FALSE;
END_IF
IF (arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Io.biNegLimit OR arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Io.biPosLimit) AND arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Status.fActVelo>500 THEN
	arrAxisCtrl[NameNo.CaAxisNo.PoleTension].Cmd.bEnable:=FALSE;
END_IF

//////////主轴参数放大////////
arrAxisPar[NameNo.AnVirAxisNo.VirMain].fMaxVel:=8000;
arrAxisPar[NameNo.AnVirAxisNo.VirMain].fMaxAccDec:=300000;
arrAxisPar[NameNo.AnVirAxisNo.VirMain].fConVelPercentage:=0.8;
arrAxisPar[NameNo.CaVirAxisNo.VirMain].fMaxVel:=8000;
arrAxisPar[NameNo.CaVirAxisNo.VirMain].fMaxAccDec:=300000;
arrAxisPar[NameNo.CaVirAxisNo.VirMain].fConVelPercentage:=0.8;]]></ST>
      </Implementation>
    </Action>
