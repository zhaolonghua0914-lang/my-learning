			MTD_Mes1.rExcelRate[56]:=Ca_Production.NgPerHourNightCount[25];//	负极线扫黄标	
			MTD_Mes1.rExcelRate[57]:=Ca_Production.NgPerHourNightCount[31];//	负极线扫碎屑
			MTD_Mes1.rExcelRate[58]:=Ca_Production.NgPerHourNightCount[33];//	负极线扫脱碳
			MTD_Mes1.uOther[0]:=2;	//plc数据写入完成
			MTDWtStep:=20;
		END_IF			
	20:
		IF DTM_Mes1.uOther[0]=0 THEN
			MTD_Mes1.uOther[0]:=0;
			MTDWtStep:=0;
		END_IF
END_CASE
(*
//功能开关状态
        MTD_Mes1.bFuncEN[1]:=ProductPar.iModeEN.bCcdTcpEN;
		MTD_Mes1.bFuncEN[2]:=ProductPar.iModeEN.bLineScanCCDEN;
	    MTD_Mes1.bFuncEN[3]:=ProductPar.iModeEN.bChamferCCDEN;		
	    MTD_Mes1.bFuncEN[4]:=ProductPar.iModeEN.bCuterCCDEN;		
	    MTD_Mes1.bFuncEN[5]:=ProductPar.iModeEN.bSizeCCDEN;	
        MTD_Mes1.bFuncEN[6]:=ProductPar.iModeEN.PartNumberOff;
		MTD_Mes1.bFuncEN[7]:=ProductPar.iModeEN.bTabWidtNGoff;*)
		
//模具切刀计数		
		MTD_Mes1.uOther[1]:=ProductPar.AnPar.iCuterCount;
		MTD_Mes1.uOther[2]:=ProductPar.CaPar.iCuterCount;
		MTD_Mes1.uOther[3]:=ProductPar.AnPar.iMouldCount1;
		MTD_Mes1.uOther[4]:=ProductPar.CaPar.iMouldCount1;		
	    MTD_Mes1.uOther[5]:=ProductPar.AnPar.iCuterCountAlarm;
		MTD_Mes1.uOther[6]:=ProductPar.CaPar.iCuterCountAlarm;
		MTD_Mes1.uOther[7]:=ProductPar.AnPar.iMouldCountAlarm1;
		MTD_Mes1.uOther[8]:=ProductPar.CaPar.iMouldCountAlarm1;
		MTD_Mes1.bFuncEN[8]:=ProductPar.AnPar.iCuterclear;
		MTD_Mes1.bFuncEN[9]:=ProductPar.CaPar.iCuterclear;
		MTD_Mes1.bFuncEN[10]:=ProductPar.AnPar.iMouldclear1;
		MTD_Mes1.bFuncEN[11]:=ProductPar.CaPar.iMouldclear1;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Motion_coe" Id="{576cd356-9582-442a-bbbc-8efa32d5392c}">
      <Implementation>
        <ST><![CDATA[
//nSlaveAddr :ARRAY[1..6] OF INT :=[1003,1008,1018,1019,1020,1021] ;     //EtherCAT支路驱动器ID



//////////////////////////////////////////////////////////////////////正极////////////////////////////////////////////////////////////////
(*
//正极模切缓存
//写入
FB_EcCoESdoWrite_AnSEPTATCache[1](
	sNetId:= '192.168.10.10.4.1', 
	nSlaveAddr:=1025,   //模切缓存
	nSubIndex:=0 , 
	nIndex:=16#2108 ,   //  平滑时间
