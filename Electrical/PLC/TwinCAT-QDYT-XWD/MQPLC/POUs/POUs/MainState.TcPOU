//正极左卷料号OK
IF  (ProductPar.AnPar.MQ.bWindSelect AND arrCyCtrl[NameNo.AnCYNo.Inflation_L].Status.ONState 
 AND DT_To_MQ_MES.Mes_PcToPlc1 AND  LEN(DT_To_MQ_MES.PostiveCode1)>6  )  OR ProductPar.iModeEN.PartNumberOff THEN
	Ansys.PolePieceNumberOK1:=TRUE;
ELSE
	Ansys.PolePieceNumberOK1:=FALSE;
END_IF

//正极右卷料号OK
IF  (NOT ProductPar.AnPar.MQ.bWindSelect AND arrCyCtrl[NameNo.AnCYNo.Inflation_R].Status.ONState
  AND DT_To_MQ_MES.Mes_PcToPlc2 AND LEN(DT_To_MQ_MES.PostiveCode2)>6  )  OR ProductPar.iModeEN.PartNumberOff THEN
	Ansys.PolePieceNumberOK2:=TRUE;
ELSE
	Ansys.PolePieceNumberOK2:=FALSE;
END_IF

//当前使用左卷
IF ProductPar.AnPar.MQ.bWindSelect THEN
	IF Ansys.PolePieceNumberOK1 THEN
		PoleData.AnBeltData[1].Code:=DT_To_MQ_MES.PostiveCode1;
	ELSE
		PoleData.AnBeltData[1].Code:='';//当前卷物料码异常
	END_IF
ELSE//当前使用右卷
	IF Ansys.PolePieceNumberOK2 THEN
		PoleData.AnBeltData[1].Code:=DT_To_MQ_MES.PostiveCode2;
	ELSE
		PoleData.AnBeltData[1].Code:='';//当前卷物料码异常
	END_IF
END_IF

//正极右卷换左卷---正常换卷
Code_MES[1](CLK:=ProductPar.AnPar.MQ.bWindSelect , Q=> );//AND arrCyCtrl[NameNo.AnCYNo.Inflation_L].Status.ONState  AND  stAnUwindTen.bTensionOK 
IF Code_MES[1].Q THEN
	Ansys.PolePieceNumberOK2:=FALSE;//正极右卷料号OK
	MQ_To_DT_MES.Mes_PlcToPc1:=FALSE;//正极左卷换卷请求
	MQ_To_DT_MES.Mes_PlcToPc2:=TRUE;//正极右卷换卷请求触发
END_IF
//正极左卷换右卷---正常换卷
Code_MES[2](CLK:=NOT ProductPar.AnPar.MQ.bWindSelect  , Q=> );//AND arrCyCtrl[NameNo.AnCYNo.Inflation_R].Status.ONState  AND  stAnUwindTen.bTensionOK
IF Code_MES[2].Q THEN
	Ansys.PolePieceNumberOK1:=FALSE;//正极左卷料号OK
	MQ_To_DT_MES.Mes_PlcToPc1:=TRUE;//正极左卷换卷请求触发
	MQ_To_DT_MES.Mes_PlcToPc2:=FALSE;//正极右卷换卷请求
END_IF

//正极气涨轴切换换卷
Code_MES[3](CLK:=arrCyCtrl[NameNo.AnCYNo.Inflation_L].Io.DOStatus1, Q=> );//左卷
Code_MES[4](CLK:=arrCyCtrl[NameNo.AnCYNo.Inflation_R].Io.DOStatus1, Q=> );//右卷
IF Code_MES[3].Q THEN//左卷请求
	Ansys.PolePieceNumberOK1:=FALSE;//正极左卷料号OK
	MQ_To_DT_MES.Mes_PlcToPc1:=TRUE;//正极左卷换卷请求触发
	MQ_To_DT_MES.Mes_PlcToPc2:=FALSE;//正极右卷换卷请求
END_IF
IF Code_MES[4].Q THEN//右卷请求
	Ansys.PolePieceNumberOK2:=FALSE;//正极右卷料号OK
	MQ_To_DT_MES.Mes_PlcToPc1:=FALSE;//正极左卷换卷请求
	MQ_To_DT_MES.Mes_PlcToPc2:=TRUE;//正极右卷换卷请求触发
END_IF



//负极左卷料号OK
IF  (ProductPar.CaPar.MQ.bWindSelect AND arrCyCtrl[NameNo.CaCYNo.Inflation_L].Status.ONState 
 AND DT_To_MQ_MES.Mes_PcToPlc3 AND  LEN(DT_To_MQ_MES.NegativeCode1)>6  )  OR ProductPar.iModeEN.PartNumberOff THEN
	Casys.PolePieceNumberOK1:=TRUE;
ELSE
	Casys.PolePieceNumberOK1:=FALSE;
END_IF

//负极右卷料号OK
IF  (NOT ProductPar.CaPar.MQ.bWindSelect AND arrCyCtrl[NameNo.CaCYNo.Inflation_R].Status.ONState
  AND DT_To_MQ_MES.Mes_PcToPlc4 AND LEN(DT_To_MQ_MES.NegativeCode2)>6  )  OR ProductPar.iModeEN.PartNumberOff THEN
	Casys.PolePieceNumberOK2:=TRUE;
ELSE
	Casys.PolePieceNumberOK2:=FALSE;
END_IF

IF ProductPar.CaPar.MQ.bWindSelect THEN
	IF  Casys.PolePieceNumberOK1 THEN
		PoleData.CaBeltData[1].Code:=DT_To_MQ_MES.NegativeCode1;
	ELSE
		PoleData.CaBeltData[1].Code:='';//当前卷物料码异常
	END_IF
ELSE
	IF  Casys.PolePieceNumberOK2 THEN
		PoleData.CaBeltData[1].Code:=DT_To_MQ_MES.NegativeCode2;
	ELSE
		PoleData.CaBeltData[1].Code:='';//当前卷物料码异常
	END_IF
END_IF

//负极右卷换左卷---正常换卷
Code_MES[5](CLK:=ProductPar.CaPar.MQ.bWindSelect  , Q=> );//AND arrCyCtrl[NameNo.CaCYNo.Inflation_L].Status.ONState  AND  stCaUwindTen.bTensionOK
IF Code_MES[5].Q THEN
	Casys.PolePieceNumberOK2:=FALSE;//负极右卷料号OK
	MQ_To_DT_MES.Mes_PlcToPc3:=FALSE;//负极左卷换卷请求
	MQ_To_DT_MES.Mes_PlcToPc4:=TRUE;//负极右卷换卷请求触发
END_IF
//正极左卷换右卷---正常换卷
Code_MES[6](CLK:=NOT ProductPar.CaPar.MQ.bWindSelect  , Q=> );//AND arrCyCtrl[NameNo.CaCYNo.Inflation_R].Status.ONState  AND  stCaUwindTen.bTensionOK
IF Code_MES[6].Q THEN
	Casys.PolePieceNumberOK1:=FALSE;//负极左卷料号OK
	MQ_To_DT_MES.Mes_PlcToPc3:=TRUE;//负极左卷换卷请求触发
	MQ_To_DT_MES.Mes_PlcToPc4:=FALSE;//负极右卷换卷请求
END_IF


//负极气涨轴切换换卷
Code_MES[7](CLK:=arrCyCtrl[NameNo.CaCYNo.Inflation_L].Io.DOStatus1, Q=> );//左卷
Code_MES[8](CLK:=arrCyCtrl[NameNo.CaCYNo.Inflation_R].Io.DOStatus1, Q=> );//右卷
IF Code_MES[7].Q THEN//左卷请求
	Casys.PolePieceNumberOK1:=FALSE;//负极左卷料号OK
	MQ_To_DT_MES.Mes_PlcToPc3:=TRUE;//负极左卷换卷请求触发
	MQ_To_DT_MES.Mes_PlcToPc4:=FALSE;//负极右卷换卷请求
END_IF
IF Code_MES[8].Q THEN//右卷请求
	Casys.PolePieceNumberOK2:=FALSE;//负极右卷料号OK
	MQ_To_DT_MES.Mes_PlcToPc3:=FALSE;//负极左卷换卷请求
	MQ_To_DT_MES.Mes_PlcToPc4:=TRUE;//负极右卷换卷请求触发
END_IF



//条码校验未完成提示
IF ProductPar.AnPar.MQ.bWindSelect AND  NOT Ansys.PolePieceNumberOK1  AND NOT ProductPar.iModeEN.PartNumberOff THEN
	AnAlarm.arrLightWarn[41]:=TRUE;//正极左卷物料码校验未通过
ELSE
	AnAlarm.arrLightWarn[41]:=FALSE;//正极左卷物料码校验未通过
END_IF
IF NOT ProductPar.AnPar.MQ.bWindSelect AND NOT Ansys.PolePieceNumberOK2  AND NOT ProductPar.iModeEN.PartNumberOff THEN
	AnAlarm.arrLightWarn[42]:=TRUE;//正极右卷物料码校验未通过
ELSE
	AnAlarm.arrLightWarn[42]:=FALSE;//正极右卷物料码校验未通过
END_IF

IF ProductPar.CaPar.MQ.bWindSelect AND  NOT Casys.PolePieceNumberOK1  AND NOT ProductPar.iModeEN.PartNumberOff THEN
	CaAlarm.arrLightWarn[41]:=TRUE;//负极左卷物料码校验未通过
ELSE
	CaAlarm.arrLightWarn[41]:=FALSE;//负极左卷物料码校验未通过
END_IF
IF NOT  ProductPar.CaPar.MQ.bWindSelect AND NOT Casys.PolePieceNumberOK2  AND NOT ProductPar.iModeEN.PartNumberOff THEN
	CaAlarm.arrLightWarn[42]:=TRUE;//负极右卷物料码校验未通过
ELSE
	CaAlarm.arrLightWarn[42]:=FALSE;//负极右卷物料码校验未通过
END_IF


//触发信号清除
tCode_MES[1](IN:=MQ_To_DT_MES.Mes_PlcToPc1 , PT:=T#0.2S , Q=> , ET=> );
tCode_MES[2](IN:=MQ_To_DT_MES.Mes_PlcToPc2 , PT:=T#0.2S , Q=> , ET=> );
tCode_MES[3](IN:=MQ_To_DT_MES.Mes_PlcToPc3 , PT:=T#0.2S , Q=> , ET=> );
tCode_MES[4](IN:=MQ_To_DT_MES.Mes_PlcToPc4 , PT:=T#0.2S , Q=> , ET=> );
IF tCode_MES[1].Q THEN
	MQ_To_DT_MES.Mes_PlcToPc1:=FALSE;//正极左卷换卷请求触发
END_IF
IF tCode_MES[2].Q THEN
	MQ_To_DT_MES.Mes_PlcToPc2:=FALSE;//正极右卷换卷请求触发
END_IF
IF tCode_MES[3].Q THEN
	MQ_To_DT_MES.Mes_PlcToPc3:=FALSE;//负极左卷换卷请求触发
END_IF
IF tCode_MES[4].Q THEN
	MQ_To_DT_MES.Mes_PlcToPc4:=FALSE;//负极右卷换卷请求触发
END_IF


//料号相同检测
IF  NOT ProductPar.iModeEN.PartNumberOff  THEN
	IF DT_To_MQ_MES.PostiveCode1 =DT_To_MQ_MES.PostiveCode2 AND DT_To_MQ_MES.PostiveCode1<>''  THEN
		aAlarm[55]:=TRUE;;//正极左卷和正极右卷料号相同
	END_IF
	IF DT_To_MQ_MES.PostiveCode1 =DT_To_MQ_MES.NegativeCode1 AND DT_To_MQ_MES.PostiveCode1<>''  THEN
		aAlarm[56]:=TRUE;;//正极左卷和负极左卷料号相同
	END_IF
	IF DT_To_MQ_MES.PostiveCode1 =DT_To_MQ_MES.NegativeCode2 AND DT_To_MQ_MES.PostiveCode1<>''  THEN
		aAlarm[57]:=TRUE;;//正极左卷与负极右卷料号相同
	END_IF
	
	IF DT_To_MQ_MES.PostiveCode2 =DT_To_MQ_MES.NegativeCode1 AND DT_To_MQ_MES.PostiveCode2<>''  THEN
		aAlarm[58]:=TRUE;;//正极右卷和负极左卷料号相同
	END_IF
	IF DT_To_MQ_MES.PostiveCode2 =DT_To_MQ_MES.NegativeCode2 AND DT_To_MQ_MES.PostiveCode2<>'' THEN
		aAlarm[59]:=TRUE;;//正极右卷和负极右卷料号相同
	END_IF
	
	IF DT_To_MQ_MES.NegativeCode1= DT_To_MQ_MES.NegativeCode2 AND DT_To_MQ_MES.NegativeCode1<>'' THEN 
		aAlarm[60]:=TRUE;;//负极左卷和负极右卷料号相同
	END_IF
END_IF

IF YL_I[20] THEN//叠台一正极送片流水线安全点动条件 
		arrAxisCtrl[20].Cmd.JogN_Condition:=TRUE;
		arrAxisCtrl[20].Cmd.JogP_Condition:=TRUE;
ELSE
		arrAxisCtrl[20].Cmd.JogN_Condition:=FALSE;
		arrAxisCtrl[20].Cmd.JogP_Condition:=FALSE;	
END_IF
IF YL_I[21] THEN//叠台一负极送片流水线安全点动条件 
		arrAxisCtrl[44].Cmd.JogN_Condition:=TRUE;
		arrAxisCtrl[44].Cmd.JogP_Condition:=TRUE;
ELSE
		arrAxisCtrl[44].Cmd.JogN_Condition:=FALSE;
		arrAxisCtrl[44].Cmd.JogP_Condition:=FALSE;		
END_IF

IF YL_I[22] THEN//叠台二正极送片流水线安全点动条件 
		arrAxisCtrl[21].Cmd.JogN_Condition:=TRUE;
		arrAxisCtrl[21].Cmd.JogP_Condition:=TRUE;
ELSE
		arrAxisCtrl[21].Cmd.JogN_Condition:=FALSE;
		arrAxisCtrl[21].Cmd.JogP_Condition:=FALSE;	
END_IF
IF YL_I[23] THEN//叠台二负极送片流水线安全点动条件 
		arrAxisCtrl[45].Cmd.JogN_Condition:=TRUE;
		arrAxisCtrl[45].Cmd.JogP_Condition:=TRUE;
ELSE
		arrAxisCtrl[45].Cmd.JogN_Condition:=FALSE;
		arrAxisCtrl[45].Cmd.JogP_Condition:=FALSE;	
END_IF

IF YL_I[24] THEN//叠台三正极送片流水线安全点动条件 
		arrAxisCtrl[22].Cmd.JogN_Condition:=TRUE;
		arrAxisCtrl[22].Cmd.JogP_Condition:=TRUE;
ELSE
		arrAxisCtrl[22].Cmd.JogN_Condition:=FALSE;
		arrAxisCtrl[22].Cmd.JogP_Condition:=FALSE;	
END_IF
IF YL_I[25] THEN//叠台三负极送片流水线安全点动条件
		arrAxisCtrl[46].Cmd.JogN_Condition:=TRUE;
		arrAxisCtrl[46].Cmd.JogP_Condition:=TRUE;
ELSE
		arrAxisCtrl[46].Cmd.JogN_Condition:=FALSE;
		arrAxisCtrl[46].Cmd.JogP_Condition:=FALSE;	
END_IF









]]></ST>
      </Implementation>
    </Action>
    <Action Name="CyBasic" Id="{d7ad8c6c-fc6e-4e69-870d-5eea8b8486ad}">
      <Implementation>
        <ST><![CDATA[
//气缸控制   刷新周期可以慢
FOR i:=1 TO MaxCy DO
    fbCy[i](bReset:=stSysState.bReset , CyCtrl:=arrCyCtrl[i] );
END_FOR










































]]></ST>
      </Implementation>
    </Action>
    <Action Name="EStop" Id="{b7a6d35a-ed44-46ea-a2dd-d41fc75526df}">
      <Implementation>
        <ST><![CDATA[ FOR I1:=1 TO MaxAxes BY 1 DO
	arrAxisCtrl[I1].Cmd. bHome:=FALSE;
	arrAxisCtrl[I1].Cmd. bJog_Bw:=FALSE;	
	arrAxisCtrl[I1].Cmd. bJog_Fw:=FALSE;		
    arrAxisCtrl[I1].Cmd. bMoveAbs:=FALSE;		
    arrAxisCtrl[I1].Cmd. bMoveRel:=FALSE;	
    arrAxisCtrl[I1].Cmd. bMoveVelo:=FALSE;		
    arrAxisCtrl[I1].Cmd.bMoveModulo:=FALSE;	
    arrAxisCtrl[I1].Cmd. bSetPos:=FALSE;	    	
    arrAxisCtrl[I1].Cmd. iGoSetPos:=0;	  		
	arrAxisCtrl[NameNo.AnAxisNo.PoleTension].cmd.bEnable:=FALSE;
	arrAxisCtrl[NameNo.CaAxisNo.PoleTension].cmd.bEnable:=FALSE;
	arrAxisCtrl[I1].Cmd. bStop:=TRUE;		
  END_FOR;
 FOR I1:=1 TO MaxDust BY 1 DO
	arrDustMotor[I1].bRun_BW:=FALSE;
	arrDustMotor[I1].bRun_FW:=FALSE;	
  END_FOR
  
stAnUwindTen.bTenExecute:=FALSE;//正极放卷张力
stAnAuxDriverTen.bTenExecute:=FALSE;//正极张力辅助驱动			
		
stCaUwindTen.bTenExecute:=FALSE;//负极放卷张力						
stCaAuxDriverTen.bTenExecute:=FALSE;//负极张力辅助驱动
 



  stSysState.bInitDone:=FALSE;
  AnSys.bStopFinished:=FALSE; 
  CaSys.bStopFinished:=FALSE;
  stSysState.Stoping:=FALSE;
  AnSys.Homed:=FALSE;
  CaSys.Homed:=FALSE;


///////
	arrAxisCtrl[NameNo. AnVirAxisNo.VirMain].cmd.bEnable:=FALSE;
	arrAxisCtrl[NameNo. AnVirAxisNo.VirMain].cmd.bHalt:=FALSE;

	arrAxisCtrl[NameNo. CaVirAxisNo.VirMain].cmd.bEnable:=FALSE;
	arrAxisCtrl[NameNo. CaVirAxisNo.VirMain].cmd.bHalt:=FALSE;	
	
	
	
	
	
	
	
	
	
	
	
	






]]></ST>
      </Implementation>
    </Action>
    <Action Name="Init" Id="{633e6e37-7817-421e-8123-21afc873bea3}">
      <Implementation>
        <ST><![CDATA[
//整机初始化
//所有轴上使能，凸轮创建，时间轴跑速度

CASE iMainInitSetp OF
0:
    IF  NOT   stSysState.bInitDone THEN
         iMainInitSetp:=10;
    END_IF
10:
    FOR i:=1 TO MaxAxes DO 
		arrAxisCtrl[i].Cmd.bEnable:=TRUE;
		arrAxisCtrl[i].Cmd.bEnableFw:=TRUE;
		arrAxisCtrl[i].Cmd.bEnableBw:=TRUE;
	(*其他操作指令*)  
		arrAxisCtrl[i].Cmd.bHome:=FALSE;
		arrAxisCtrl[i].Cmd.bJog_Bw:=FALSE;
		arrAxisCtrl[i].Cmd.bHalt:=FALSE;
		arrAxisCtrl[i].Cmd.bJog_Fw:=FALSE;
		arrAxisCtrl[i].Cmd.bMoveAbs:=FALSE;
		arrAxisCtrl[i].Cmd.bMoveVelo:=FALSE;
		arrAxisCtrl[i].Cmd.bMoveRel:=FALSE;
		arrAxisCtrl[i].Cmd.bReset:=FALSE;
		arrAxisCtrl[i].Cmd.bStop:=FALSE;
		arrAxisCtrl[i].Cmd.bSetPos:=FALSE;
		
		//arrAxisCtrl[i].Cmd.JogN_Condition:=TRUE;
		//arrAxisCtrl[i].Cmd.JogP_Condition:=TRUE;
		arrAxisCtrl[i].Cmd.Home_Condition:=TRUE;
		
		
    END_FOR
    K1:=0;
    iMainInitSetp:=20;
20: //复位一次
   bInitReset:=TRUE;
   iMainInitSetp:=30;
30:
   K1:=K1+1;
   IF  K1>=10 THEN
        bInitReset:=FALSE;
        iMainInitSetp:=40;
   ELSE
     iMainInitSetp:=20;
   END_IF

40://正负极 Init
   AnSys.bInit:=TRUE;
   CaSys.bInit:=TRUE;
   AnSys.bInitDone:=FALSE;
   CaSys.bInitDone:=FALSE;
   iMainInitSetp:=50;
50:
   IF  AnSys.bInitDone AND CaSys.bInitDone THEN //  
        iMainInitSetp:=60;
	   // AnSys.bInitDone:=FALSE;
	   // CaSys.bInitDone:=FALSE;		
    END_IF

60: //复位一次
   bInitReset:=TRUE;
   iMainInitSetp:=70;
   
70: //Time 轴跑速度
  IF  arrAxis[NameNo.VirTimeWind].Status.ControlLoopClosed THEN
	  arrAxisPar[NameNo.VirTimeWind].fVelocity_of_Velo:=100;
	  arrAxisCtrl[NameNo.VirTimeWind].Cmd.bMoveVelo:=TRUE;
      bInitReset:=FALSE;
	  iMainInitSetp:=80;
  END_IF
 
80:
  IF arrAxis[NameNo.VirTimeWind].Status.ConstantVelocity THEN
        stSysState.bInitDone:=TRUE;
        iMainInitSetp:=0;
  END_IF

END_CASE


























]]></ST>
      </Implementation>
    </Action>
    <Action Name="MesCollect" Id="{6bd430c5-ec81-43cd-9ebc-4ae4a6278f2c}">
