P2Interaction.bP2ClearDone:=D_Sys.bP2ClearDone;
P2Interaction.P2M1Enable:=D_Sys.bP2M1Enable;//叠台工位：1=屏蔽   模切工位：1=启用，故取反。
P2Interaction.P2M2Enable:=D_Sys.bP2M2Enable;//叠台工位：1=屏蔽   模切工位：1=启用，故取反。
P2Interaction.P2M3Enable:=D_Sys.bP2M3Enable;//叠台工位：1=屏蔽   模切工位：1=启用，故取反。
P2Interaction.bP2Estop:=D_Sys.bP2Estop;
P2Interaction.bP2Runing:=D_Sys.bP2Runing;
