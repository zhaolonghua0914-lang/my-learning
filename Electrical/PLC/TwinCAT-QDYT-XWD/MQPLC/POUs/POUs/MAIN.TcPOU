NameNo.	CaTabNo.MouldPhoto	:=1	;	//	倒角前拍照位置	
NameNo.	CaTabNo.CuterPhoto	:=6	;	//	裁切前拍照位置	
						
	//////极耳间距工位号//////					
NameNo.	AnIntervalNo.First	:=1	;	//	蓝胶位置	
NameNo.	AnIntervalNo.Mould	:=5	;	//	冲R角位置	
NameNo.	AnIntervalNo.Cuter	:=10	;	//	裁切位置	
						
NameNo.	CaIntervalNo.First	:=1	;	//	蓝胶位置	
NameNo.	CaIntervalNo.Mould	:=5	;	//	冲R角位置	
NameNo.	CaIntervalNo.Cuter	:=10	;	//	裁切位置	
						
	//////除尘电机号//////	
NameNo.	AnMotorNo.	DDR_Dust	:=	1	;	//主驱辊除尘				
NameNo.	AnMotorNo.	CuterBeltDust	:=	2	;	//裁切输送皮带除尘
NameNo.	AnMotorNo.	NGReverseBeltDust	:=	3	;	//踢废倒装皮带除尘
NameNo.	AnMotorNo.	DedustBeltDust	:=	4	;	//极片上表面除尘皮带除尘
NameNo.	AnMotorNo.	DedustReverseBeltDust	:=	5	;	//极片下表面除尘倒装皮带除尘
NameNo.	AnMotorNo.	PoleBrushDust_U	:=	6	;	//极片上表面毛刷除尘
NameNo.	AnMotorNo.	PoleBrushDust_D	:=	7	;	//极片下表面毛刷除尘
NameNo.	AnMotorNo.	FeduanbeltDust1	:= 15;//正极分段皮带1毛刷
NameNo.	AnMotorNo.	FeduanbeltDust2	:= 16;//正极分段皮带2毛刷
NameNo.	AnMotorNo.	FeduanbeltDust3	:= 17;//正极分段皮带3毛刷

NameNo.	CaMotorNo.	DDR_Dust	:=	8	;	//主驱辊除尘							
NameNo.	CaMotorNo.	CuterBeltDust	:=	9	;	//裁切输送皮带除尘
NameNo.	CaMotorNo.	NGReverseBeltDust	:=	10	;	//踢废倒装皮带除尘
NameNo.	CaMotorNo.	DedustBeltDust	:=	11	;	//极片上表面除尘皮带除尘
NameNo.	CaMotorNo.	DedustReverseBeltDust	:=	12	;	//极片下表面除尘倒装皮带除尘
NameNo.	CaMotorNo.	PoleBrushDust_U	:=	13	;	//极片上表面毛刷除尘
NameNo.	CaMotorNo.	PoleBrushDust_D	:=	14	;	//极片下表面毛刷除尘
NameNo.	CaMotorNo.	FeduanbeltDust1	:=	18	;	//负极分段皮带1毛刷
NameNo.	CaMotorNo.	FeduanbeltDust2	:=	19	;	//负极分段皮带2毛刷
NameNo.	CaMotorNo.	FeduanbeltDust3	:=	20	;	//负极分段皮带3毛刷

IF ProductPar.parPublic.fMainPos <>250 THEN
	ProductPar.parPublic.fMainPos:=250;
END_IF
IF ProductPar.AnPar.fPoleWidth=0 THEN
	ProductPar.AnPar.fPoleWidth:=186;
END_IF
IF ProductPar.CaPar.fPoleWidth=0 THEN
	ProductPar.CaPar.fPoleWidth:=188;
END_IF
IF ProductPar.AnPar.Machine.fMQDriverDiameter=0 THEN
	ProductPar.AnPar.Machine.fMQDriverDiameter:=71.62;
END_IF
IF ProductPar.CaPar.Machine.fMQDriverDiameter=0 THEN
	ProductPar.CaPar.Machine.fMQDriverDiameter:=71.62;
END_IF
IF ProductPar.AnPar.iMainVel=0 THEN
	ProductPar.AnPar.iMainVel:=10;
END_IF
IF ProductPar.CaPar.iMainVel=0 THEN
	ProductPar.CaPar.iMainVel:=10;
END_IF


(***DDR位置上电清零***)
arrAxisCtrl[NameNo.AnAxisNo.DriverDDR].Cmd.fSetPos:=360;
arrAxisCtrl[NameNo.AnAxisNo.DriverDDR].Cmd.bSetPos:=TRUE;

arrAxisCtrl[NameNo.CaAxisNo.DriverDDR].Cmd.fSetPos:=360;
arrAxisCtrl[NameNo.CaAxisNo.DriverDDR].Cmd.bSetPos:=TRUE;

IF arrAxisCtrl[NameNo.AnAxisNo.DriverDDR].Cmd.fSetPos>=0 AND arrAxisCtrl[NameNo.CaAxisNo.DriverDDR].Cmd.fSetPos>=0 THEN
	arrAxisCtrl[NameNo.AnAxisNo.DriverDDR].Cmd.bSetPos:=FALSE;
	arrAxisCtrl[NameNo.CaAxisNo.DriverDDR].Cmd.bSetPos:=FALSE;
	iPowerSetp:=666;
	PowerOnDone:=TRUE;
END_IF
//////////////////////////////////////////////////////////////

END_CASE
 
bytePower.0;
bytePower.1;
bytePower.2;
bytePower.3;
bytePower.4;
bytePower.5;
bytePower.6;
bytePower.7;


























]]></ST>
      </Implementation>
    </Action>
    <Action Name="TwinCAT_Nt" Id="{049845fb-5455-4567-bcc9-ba28c9543710}">
      <Implementation>
        <ST><![CDATA[//fPlcCycleTime_ms:=UDINT_TO_LREAL(_TaskInfo[0].CycleTime)/10000;

(***********************  保存掉电保持数据   **************************************)
tCycleTimer(IN:=NOT tCycleTimer.Q , PT:=T#356S , Q=>bWrite , ET=> );
rt[1](CLK:=tCycleTimer.ET>=T#1M , Q=>bWrite );
FB_WritePersistentData1(
	NETID:='' ,
	PORT:=851 ,
	START:=bWrite OR  stHmiSysCmd.bSaveData  ,//OR    _TaskInfo[1].FirstCycle 
	TMOUT:=t#500ms ,
	MODE:=SPDM_2PASS ,
	BUSY=>BUSY ,
	ERR=> ERR,
	ERRID=>ERRID );
ft[1](CLK:=BUSY , Q=> );
IF ft[1].Q THEN
	bDataValid:=TRUE;
END_IF	
	
	
	
(********************** 获取系统时间   ***************************************)
NT_GetTime1(
	NETID:='' ,
	START:=Pulse._1s.RT ,
	TMOUT:= ,
	BUSY=> ,
	ERR=> ,
	ERRID=> ,
	TIMESTR=>stTime );

	strTime:=CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT( CONCAT(CONCAT( WORD_TO_STRING(stTime.wYear),'-'), WORD_TO_STRING(stTime.wMonth)),'-'),WORD_TO_STRING(stTime.wDay)),
             '-'),WORD_TO_STRING(stTime.wHour)),'-'),WORD_TO_STRING(stTime.wMinute)),'-'),WORD_TO_STRING(stTime.wSecond));
	

	PLC_wYear:=stTime.wYear;//PLC时间年
	PLC_wMonth:=stTime.wMonth;//PLC时间月
	PLC_wDay:=stTime.wDay;//PLC时间日
	PLC_wHour:=stTime.wHour;//PLC时间时
	PLC_wMinute:=stTime.wMinute;//PLC时间分
	PLC_wSecond:=stTime.wSecond;//PLC时间秒	
	PLC_wMilliseconds:=stTime.wMilliseconds;//PLC时间秒	
		 

(********************************** Systemfunctions **********************************************************)
	SysInfo(
		Reset				:= ,
		TimeStampTrig		:= Pulse._100ms.RT,
		//RunTimeNo			=> ,
		//ProjectName			=> ,
		//NumberOfTasks		=> ,
		//OnlineChangeCount	=> ,
		RetainVarErr		=> ,
		PersistenVarErr		=> ,
		TimeStampDT			=> ,
		TimeStamp			=> ,
		TimeStr				=> ,
		DateStr				=> ,
		TimeStamp2			=> ,
		TimeStruct			=> ,
		MonthDays			=> ,
		LeapYear			=> ,
		WeekOfYear			=> ,
		timezoneId			=>);

	TaskInfo(
		index				=> ,
		active				=> ,
		taskName			=> ,
		firstCycle			=> ,
		cycleTimeExceeded	=> ,
		cycleTime			=> ,
		lastExecTime		=> ,
		priority			=> ,
		cycleCount			=> );

	Pulse(
		BlinkSlow			=> ,
		Blink				=> ,
		BlinkFast			=> );	
		
	(*系统重启，CE远程桌面，系统时间，定时保存掉电数据，等系统常规动作*)
(**********************  通讯心跳信号   ***************************************)
TonHeartBeat(IN:=NOT TonHeartBeat.Q , PT:=tHeartBeatTime , Q=> , ET=> );
IF TonHeartBeat.Q THEN
	bHeartBeat:=NOT bHeartBeat;
END_IF

tNtDelayReset(IN:=stHmiSysCmd.bRebootPc OR bReboot , PT:=T#1S , Q=> , ET=> );
NT_Reboot1(
	NETID:='' ,
	DELAY:= ,
	START:=tNtDelayReset.Q  ,
	TMOUT:=DEFAULT_ADS_TIMEOUT ,
	BUSY=> ,
	ERR=> ,
	ERRID=> );

tNtDelayShutdown(IN:=stHmiSysCmd.bShutDownPc OR bShutDown , PT:=T#1S , Q=> , ET=> );	(*触摸屏上已经做了延时*)
NT_Shutdown1(
	NETID:= ,
	DELAY:= ,
	START:=tNtDelayShutdown.Q,
	TMOUT:=DEFAULT_ADS_TIMEOUT ,
	BUSY=> ,
	ERR=> ,
	ERRID=> );
	

	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	


	





]]></ST>
      </Implementation>
    </Action>
    <Action Name="XML" Id="{88381a7a-b57d-4d74-a080-8324bda9c311}">
      <Implementation>
        <ST><![CDATA[
IF NOT  bReadDataFirstCyle THEN //testii:=testii+1;
	//fbDataXML.bRead:=NOT bDataValid;
	bReadDataFirstCyle:=TRUE;
END_IF


IF fbDataXML.bReadParDone AND bReadDataFirstCyle   AND   NOT bReadDataCyle2      THEN
	PoleData:= ProductPar.PoleData;
	YL_GVL2:=ProductPar.YL_GVL2;
	iTargetTorque:=ProductPar.iTargetTorque;
	bReadDataCyle2:=TRUE;
END_IF
	 


rt[2](CLK:=tCycleTimer.ET>=T#2M , Q=> );
rtSaveData(CLK:=stHmiSysCmd.bSaveData , Q=> );
IF  rtSaveData.Q THEN
	bSaveTest:=TRUE;
END_IF


IF  rt[2].Q  OR bSaveTest THEN
	ProductPar.PoleData:=PoleData  ;
	ProductPar.YL_GVL2 :=YL_GVL2  ;
	ProductPar.iTargetTorque:=iTargetTorque   ;	 
	bSaveTest:=FALSE;
	fbDataXML.bSave:=TRUE;
	testii2:=testii2+1;
END_IF

rt[4](CLK:=stHmiSysCmd.bReadData (*AND  stSysState.iMode=3*), Q=> );
rt[5](CLK:=PowerOnDone , Q=> );
tRead(IN:=PowerOnDone, PT:=T#3S , Q=> , ET=> );
IF   tRead.Q AND NOT fbDataXML.bReadParDone THEN
	  breadALM:=TRUE;//上电后模切参数读取失败，请手动点读取参数
END_IF

IF  stSysState.bReset THEN
	 breadALM:=FALSE;
END_IF
fbDataXML(bSave:=fbDataXML.bSave AND NOT breadALM, bRead:=fbDataXML.bRead OR rt[4].Q OR rt[5].Q, bSaveParDone=> , bReadParDone=> );

fbDataXML.bReadParDone;
fbDataXML.bSaveParDone;

(*
//fbPulseCtrl[7](PT_OFF:=T#30M, PT_ON:=T#30M, );
//fbPulseCtrl[7].Q;
//fbPulseCtrl[7].RT;


tCycleTimer(IN:=NOT tCycleTimer.Q , PT:=T#311S , Q=>bSave , ET=> );
rt10(clk:=bSave);
IF NOT  bReadDataFirstCyle THEN //testii:=testii+1;
	 	 fbDataXML.bRead:=TRUE;
	     testii:=testii+1;
	    bReadDataFirstCyle:=TRUE;
		
END_IF


IF fbDataXML.bReadParDone AND bReadDataFirstCyle   AND   NOT bReadDataCyle2      THEN
     aAnDay_date:=ProductPar.aAnDay_date;
     aCaDay_date:=ProductPar.aCaDay_date;
     cCn_An:=ProductPar.cCn_An;
     cCn_Ca:=ProductPar.cCn_Ca;
	 PoleData:= ProductPar.PoleData;
	 
     YL_GVL2:=ProductPar.YL_GVL2;
	 
     HMI_AnTodayNGClass_AM:=ProductPar.HMI_AnTodayNGClass_AM;
     HMI_AnTodayNGClass_PM:=ProductPar.HMI_AnTodayNGClass_PM;
     HMI_AnTodayNG_AM:=ProductPar.HMI_AnTodayNG_AM;
     HMI_AnTodayNG_PM:=ProductPar.HMI_AnTodayNG_PM;
     HMI_CaTodayNGClass_AM:=ProductPar.HMI_CaTodayNGClass_AM;
     HMI_CaTodayNGClass_PM:=ProductPar.HMI_CaTodayNGClass_PM;
     HMI_CaTodayNG_AM:=ProductPar.HMI_CaTodayNG_AM;
     HMI_CaTodayNG_PM:=ProductPar.HMI_CaTodayNG_PM;
	  iTargetTorque:=ProductPar.iTargetTorque;
	 

	 bReadDataCyle2:=TRUE;
  END_IF
	 



rtSaveData(CLK:=stHmiSysCmd.bSaveData , Q=> );
IF  rtSaveData.Q THEN
	bSaveTest:=TRUE;
END_IF


IF  rt10.Q  OR bSaveTest    THEN
     ProductPar.aAnDay_date:=aAnDay_date   ;
     ProductPar.aCaDay_date:=aCaDay_date ;
     ProductPar.cCn_An:=cCn_An   ;
     ProductPar.cCn_Ca:=cCn_Ca  ;
	 ProductPar.PoleData:=PoleData  ;
	 
     ProductPar.YL_GVL2 :=YL_GVL2  ;
	 
     HMI_AnTodayNGClass_AM := ProductPar.HMI_AnTodayNGClass_AM   ;
     HMI_AnTodayNGClass_PM:=ProductPar.HMI_AnTodayNGClass_PM  ;                      ;
     ProductPar.HMI_AnTodayNG_AM :=HMI_AnTodayNG_AM  ;
     ProductPar.HMI_AnTodayNG_PM:=HMI_AnTodayNG_PM   ;
     ProductPar.HMI_CaTodayNGClass_AM:=HMI_CaTodayNGClass_AM   ;
     ProductPar.HMI_CaTodayNGClass_PM:=HMI_CaTodayNGClass_PM ;
     ProductPar.HMI_CaTodayNG_AM:=HMI_CaTodayNG_AM   ;
     ProductPar.HMI_CaTodayNG_PM:=HMI_CaTodayNG_PM   ;	 
     ProductPar.iTargetTorque:=iTargetTorque   ;	 

     bSaveTest:=FALSE;
	fbDataXML.bSave:=TRUE;
	testii2:=testii2+1;
END_IF

fbDataXML(bSave:=fbDataXML.bSave AND D_Sys.P3ReadParDone, 
                     bRead:=fbDataXML.bRead , 
                     bSaveParDone=> ,
                     bReadParDone=> );
					 

M_Sys.P1ReadParDone:=fbDataXML.bReadParDone;
M_Sys.P1SaveParDone:=fbDataXML.bSaveParDone;
*)









]]></ST>
      </Implementation>
    </Action>
