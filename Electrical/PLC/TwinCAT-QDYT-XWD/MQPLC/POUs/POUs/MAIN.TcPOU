    <Action Name="Power" Id="{958c42ad-1c52-4fe7-b086-8ab0f01c6e48}">
      <Implementation>
        <ST><![CDATA[(***系统延时启动***)

tonPower(IN:= , PT:=T#1.5S , Q=> , ET=> );

CASE iPowerSetp OF
0:
    tonPower.IN:=TRUE;
    iPowerSetp:=10;
10:
   IF   tonPower.Q  THEN
      bytePower:=SHL(bytePower,1);
     
      tonPower(IN:=FALSE );
      k:=k+1;
     iPowerSetp:=20;
  END_IF
20:
    bytePower.0:=1;
    tonPower.IN:=TRUE;
    iPowerSetp:=30;
30:
   IF  k>=8 THEN
        iPowerSetp:=40;
       // bytePower:=16#00;
        //PowerOnDone:=TRUE;
   ELSE
      iPowerSetp:=10;
   END_IF
  40:
  	(********************** Name赋值   ***************************************)
	//////轴号//////					
NameNo.	AnAxisNo.	UnWind_L	:=	1	;//模切左放卷	
NameNo.	AnAxisNo.	UnWind_R	:=	2	;//模切右放卷	
