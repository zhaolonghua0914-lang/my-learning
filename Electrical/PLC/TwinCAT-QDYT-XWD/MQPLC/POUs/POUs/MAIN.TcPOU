NameNo.	CaBeltNo.	NGBox2	:=6	;	//	踢废工位2（单片）
NameNo.	CaBeltNo.	BrushDustU	:=7	;	//	极片上表面毛刷除尘工位
NameNo.	CaBeltNo.	WindDustU	:=8	;	//	极片上表面风刀除尘工位
NameNo.	CaBeltNo.	BrushDustD	:=9	;	//	极片下表面毛刷除尘工位
NameNo.	CaBeltNo.	WindDustD	:=10	;	//	极片下表面风刀除尘工位(除尘倒装皮带末位)
NameNo.	CaBeltNo.	SubBelt1	:=12	;	//	分段皮带1取料工位
NameNo.	CaBeltNo.	SubBelt2	:=20	;	//	分段皮带2取料工位
NameNo.	CaBeltNo.	SubBelt3	:=28	;	//	分段皮带3取料工位
						
	//////极耳工位号//////					
NameNo.	AnTabNo.MouldPhoto	:=1	;	//	倒角前拍照位置	
