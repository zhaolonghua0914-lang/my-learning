		END_IF
		IF stUwindLTen.fWindDiameter<PolePar.fDiameterAlarm_L AND PolePar.fDiameterAlarm_L>0 THEN
			stAlarm.arrFlowAlarm[15]:=TRUE;//左极片料卷已用完，请停机处理！
		END_IF	
	
		IF stUwindRTen.fWindDiameter<PolePar.fDiameterWarn_R AND PolePar.fDiameterWarn_R>0 THEN
			stAlarm.arrLightWarn[15]:=TRUE;
		END_IF
		IF stUwindRTen.fWindDiameter<PolePar.fDiameterAlarm_R AND PolePar.fDiameterAlarm_R>0 THEN
			stAlarm.arrFlowAlarm[16]:=TRUE;//右极片料卷已用完，请停机处理！
		END_IF*)


(*/////////卷径报警&警告/////////
IF NOT ProductPar.iModeEN.bEmptyRunEN THEN
	IF PolePar.MQ.bWindSelect THEN
		IF stUwindLTen.fWindDiameter<PolePar.fDiameterWarn_L AND PolePar.fDiameterWarn_L>0 THEN
			stAlarm.arrLightWarn[14]:=TRUE;//左极片料卷即将用完！
		END_IF
		IF stUwindLTen.fWindDiameter<PolePar.fDiameterAlarm_L AND PolePar.fDiameterAlarm_L>0 THEN
			stAlarm.arrFlowAlarm[15]:=TRUE;//左极片料卷已用完，请停机处理！
		END_IF	
	ELSE	
		IF stUwindRTen.fWindDiameter<PolePar.fDiameterWarn_R AND PolePar.fDiameterWarn_R>0 THEN
			stAlarm.arrLightWarn[15]:=TRUE;//右极片料卷即将用完！
		END_IF
		IF stUwindRTen.fWindDiameter<PolePar.fDiameterAlarm_R AND PolePar.fDiameterAlarm_R>0 THEN
			stAlarm.arrFlowAlarm[16]:=TRUE;//右极片料卷已用完，请停机处理！
		END_IF
	END_IF
END_IF*)

//////////////////////////////////偏心轮类电机处理//////////////////////////////////
//////////////冲R角模具////////////
FOR i2:=0 TO 10 BY 1 DO			
	IF arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloGo[i2] AND arrAxis[AxisNo.Mould].Status.StandStill THEN		
		IF NOT arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloPoint[i2] THEN	
			arrAxisCtrl[AxisNo.Mould].Cmd.fPositon_of_Mod:=arrAxisPar[AxisNo.Mould].arrTargetPoint[i2];//绝对模长位置定位
			arrAxisCtrl[AxisNo.Mould].Cmd.bMoveModulo:=TRUE;
			arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloGo[i2]:=FALSE;
		ELSE	
			arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloGo[i2]:=FALSE;
		END_IF	
	END_IF		
	IF arrAxisPar[AxisNo.Mould].arrTargetPoint[i2]-0.1<= arrAxisCtrl[AxisNo.Mould].Status.fModuloActPos AND		
		arrAxisPar[AxisNo.Mould].arrTargetPoint[i2]+0.1>=arrAxisCtrl[AxisNo.Mould].Status.fModuloActPos AND	
		NOT arrAxisCtrl[AxisNo.Mould].Cmd.bMoveModulo THEN	
		arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloPoint[i2]:=TRUE;	
	ELSE		
		arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloPoint[i2]:=FALSE;	
	END_IF		
END_FOR
//////////////裁切////////////
FOR i2:=0 TO 10 BY 1 DO			
	IF arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloGo[i2] AND arrAxis[AxisNo.Cuter].Status.StandStill THEN		
		IF NOT arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloPoint[i2] THEN	
			arrAxisCtrl[AxisNo.Cuter].Cmd.fPositon_of_Mod:=arrAxisPar[AxisNo.Cuter].arrTargetPoint[i2];//绝对模长位置定位
			arrAxisCtrl[AxisNo.Cuter].Cmd.bMoveModulo:=TRUE;
			arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloGo[i2]:=FALSE;
		ELSE	
			arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloGo[i2]:=FALSE;
		END_IF	
	END_IF		
	IF arrAxisPar[AxisNo.Cuter].arrTargetPoint[i2]-0.1<= arrAxisCtrl[AxisNo.Cuter].Status.fModuloActPos AND		
		arrAxisPar[AxisNo.Cuter].arrTargetPoint[i2]+0.1>=arrAxisCtrl[AxisNo.Cuter].Status.fModuloActPos AND	
		NOT arrAxisCtrl[AxisNo.Cuter].Cmd.bMoveModulo THEN	
		arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloPoint[i2]:=TRUE;	
	ELSE		
		arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloPoint[i2]:=FALSE;	
	END_IF		
END_FOR			
//////////////CCD压片升降////////////
FOR i2:=0 TO 10 BY 1 DO			
	IF arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloGo[i2] AND arrAxis[AxisNo.CCDPressPush].Status.StandStill THEN		
		IF NOT arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloPoint[i2] THEN	
			arrAxisCtrl[AxisNo.CCDPressPush].Cmd.fPositon_of_Mod:=arrAxisPar[AxisNo.CCDPressPush].arrTargetPoint[i2];//绝对模长位置定位
			arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bMoveModulo:=TRUE;
			arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloGo[i2]:=FALSE;
		ELSE	
			arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloGo[i2]:=FALSE;
		END_IF	
	END_IF		
	IF arrAxisPar[AxisNo.CCDPressPush].arrTargetPoint[i2]-0.1<= arrAxisCtrl[AxisNo.CCDPressPush].Status.fModuloActPos AND		
		arrAxisPar[AxisNo.CCDPressPush].arrTargetPoint[i2]+0.1>=arrAxisCtrl[AxisNo.CCDPressPush].Status.fModuloActPos AND	
		NOT arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bMoveModulo THEN	
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloPoint[i2]:=TRUE;	
	ELSE		
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloPoint[i2]:=FALSE;	
	END_IF		
END_FOR						


///////////////////////////////////////////////////////////纠偏控制信号自动复位///////////////////////////////////////////////////////////////////
IF tonCondition[5].Q THEN
	arrRecCtrl[RecNo.PoleWind].Cmd.bCentre:=FALSE;
END_IF
IF tonCondition[6].Q THEN
	arrRecCtrl[RecNo.PoleWind].Cmd.bAuto:=FALSE;
END_IF
IF tonCondition[7].Q THEN
	arrRecCtrl[RecNo.PoleWind].Cmd.bManual:=FALSE;
END_IF
IF tonCondition[8].Q THEN
	arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=FALSE;
END_IF
IF tonCondition[9].Q THEN
	arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto:=FALSE;
END_IF
IF tonCondition[10].Q THEN
	arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=FALSE;
END_IF

///////////////////////////////////////////////////////////切刀计数///////////////////////////////////////////////////////////////////
rtCount1(CLK:=arrAxisCtrl[AxisNo.Mould].Status.fModuloActPos>=170 AND arrAxisCtrl[AxisNo.Mould].Status.fModuloActPos<=190);
IF rtCount1.Q THEN
	PolePar.iMouldCount1:=PolePar.iMouldCount1+1;
	PolePar.iMouldCount2:=PolePar.iMouldCount2+1;
	IF iPartSelect =1 THEN
			YL_GVL2[1]:=YL_GVL2[1]+1;
	ELSIF iPartSelect =2 THEN
			YL_GVL2[3]:=YL_GVL2[3]+1;
	END_IF

END_IF

IF rtCount2.Q THEN
	PolePar.iCuterCount:=PolePar.iCuterCount+1;
END_IF
///////////////////////////////////////////////////////////切刀计数清零//////////////////////////////////////////////////////////
rtMouldClear1( CLK := PolePar.iMouldclear1    ); //前模具切刀
rtMouldClear2( CLK := PolePar.iMouldclear2    );  //后模具切刀   
rtCuterClear( CLK := PolePar.iCuterclear    );    
IF rtMouldClear1.Q THEN          //前倒角模具切刀清零
	PolePar.iMouldCount1:=0;
END_IF
IF rtMouldClear2.Q THEN          //后倒角模具切刀清零
	PolePar.iMouldCount2:=0;
END_IF
IF rtCuterClear.Q THEN          //裁切切刀清零
	PolePar.iCuterCount:=0;
END_IF




//////////////轴位置赋初值////////////
IF arrAxisPar[AxisNo.BuffeLine].arrTargetPoint[1]=0 THEN
	arrAxisPar[AxisNo.BuffeLine].arrTargetPoint[1]:=20;
END_IF
IF arrAxisPar[AxisNo.Mould].arrTargetPoint[1]=0 THEN
	arrAxisPar[AxisNo.Mould].arrTargetPoint[1]:=230;
END_IF
IF arrAxisPar[AxisNo.Mould].arrTargetPoint[2]=0 THEN
	arrAxisPar[AxisNo.Mould].arrTargetPoint[2]:=130;
END_IF
IF arrAxisPar[AxisNo.Cuter].arrTargetPoint[1]=0 THEN
	arrAxisPar[AxisNo.Cuter].arrTargetPoint[1]:=230;
END_IF
IF arrAxisPar[AxisNo.Cuter].arrTargetPoint[2]=0 THEN
	arrAxisPar[AxisNo.Cuter].arrTargetPoint[2]:=130;
END_IF
IF arrAxisPar[AxisNo.CCDPressPush].arrTargetPoint[1]=0 THEN
	arrAxisPar[AxisNo.CCDPressPush].arrTargetPoint[1]:=200;
END_IF
IF arrAxisPar[AxisNo.CCDPressPush].arrTargetPoint[2]=0 THEN
	arrAxisPar[AxisNo.CCDPressPush].arrTargetPoint[2]:=180;
END_IF
