	arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1]:=1;
END_IF
IF arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[2]=0 THEN
	arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[2]:=2;
END_IF
IF arrAxisPar[AxisNo.MouldRectify_Y].arrTargetPoint[1]=0 THEN
	arrAxisPar[AxisNo.MouldRectify_Y].arrTargetPoint[1]:=1;
END_IF
IF arrAxisPar[AxisNo.MouldRectify_Y].arrTargetPoint[2]=0 THEN
	arrAxisPar[AxisNo.MouldRectify_Y].arrTargetPoint[2]:=2;
END_IF
IF arrAxisPar[AxisNo.CuterBeltChange].arrTargetPoint[1]=0 THEN
	arrAxisPar[AxisNo.CuterBeltChange].arrTargetPoint[1]:=1;
END_IF
IF arrAxisPar[AxisNo.CuterBeltChange].arrTargetPoint[2]=0 THEN
	arrAxisPar[AxisNo.CuterBeltChange].arrTargetPoint[2]:=2;
END_IF
IF arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[1]=0 THEN
	arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[1]:=0.1;
END_IF
IF arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[2]=0 THEN
	arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[2]:=0.2;
END_IF
//监控极耳数据
TabData[1].fPhotoPosC;TabData[1].fPhotoPosM;TabData[1].fTab_OffsetC;TabData[1].fTab_OffsetM;
TabData[2].fPhotoPosC;TabData[2].fPhotoPosM;TabData[2].fTab_OffsetC;TabData[2].fTab_OffsetM;
TabData[3].fPhotoPosC;TabData[3].fPhotoPosM;TabData[3].fTab_OffsetC;TabData[3].fTab_OffsetM;
TabData[4].fPhotoPosC;TabData[4].fPhotoPosM;TabData[3].fTab_OffsetC;TabData[4].fTab_OffsetM;
TabData[5].fPhotoPosC;TabData[5].fPhotoPosM;TabData[5].fTab_OffsetC;TabData[5].fTab_OffsetM;
TabData[6].fPhotoPosC;TabData[6].fPhotoPosM;TabData[6].fTab_OffsetC;TabData[6].fTab_OffsetM;
TabData[7].fPhotoPosC;TabData[7].fPhotoPosM;TabData[7].fTab_OffsetC;TabData[7].fTab_OffsetM;
TabData[8].fPhotoPosC;TabData[8].fPhotoPosM;TabData[8].fTab_OffsetC;TabData[8].fTab_OffsetM;
TabData[9].fPhotoPosC;TabData[9].fPhotoPosM;TabData[9].fTab_OffsetC;TabData[9].fTab_OffsetM;
TabData[10].fPhotoPosC;TabData[10].fPhotoPosM;TabData[10].fTab_OffsetC;TabData[10].fTab_OffsetM;
//监控极耳间距数据
InteData[1].fTabIntervalC;InteData[1].fTabIntervalM;InteData[1].bLineScanNG;
InteData[2].fTabIntervalC;InteData[2].fTabIntervalM;InteData[2].bLineScanNG;
InteData[3].fTabIntervalC;InteData[3].fTabIntervalM;InteData[3].bLineScanNG;
InteData[4].fTabIntervalC;InteData[4].fTabIntervalM;InteData[4].bLineScanNG;
InteData[5].fTabIntervalC;InteData[5].fTabIntervalM;InteData[5].bLineScanNG;
InteData[6].fTabIntervalC;InteData[6].fTabIntervalM;InteData[6].bLineScanNG;
InteData[7].fTabIntervalC;InteData[7].fTabIntervalM;InteData[7].bLineScanNG;
InteData[8].fTabIntervalC;InteData[8].fTabIntervalM;InteData[8].bLineScanNG;
InteData[9].fTabIntervalC;InteData[9].fTabIntervalM;InteData[9].bLineScanNG;
InteData[10].fTabIntervalC;InteData[10].fTabIntervalM;InteData[10].bLineScanNG;

IF bTest[1] THEN
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos-arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos+720;
	//arrAxisPar[VirAxisNo.VirMain].fTagatTime:=((arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs-arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos)/360) *60/PolePar.iMainVel+0.05 ;
	arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Abs:=PolePar.iMainVel*6;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs:=TRUE;
	bTest[1]:=FALSE;
END_IF

ftest1:=FC_LengthToAngle(CCD_COM.fDemLength,PolePar.Machine.fMQDriverDiameter);
(*
arrAxisCtrl[VirAxisNo.VirMain].Status.Moving;     arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos;
IF bTest[2] THEN
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
	ftest2:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos+360;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs:=ftest2;
	//arrAxisPar[VirAxisNo.VirMain].fTagatTime:=((arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs-arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos)/360) *60/PolePar.iMainVel+0.05 ;
	arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Abs:=20;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs:=TRUE;
	itest:=2;
bTest[2]:=FALSE;
END_IF
IF bTest[3] THEN
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
	ftest3:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos-arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos+720;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs:=ftest3;
	//arrAxisPar[VirAxisNo.VirMain].fTagatTime:=((arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs-arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos)/360) *60/PolePar.iMainVel+0.05 ;
	arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Abs:=20;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs:=TRUE;
	itest:=3;
bTest[3]:=FALSE;
END_IF
*)
IF btest[2] THEN
	MEMSET(ADR(fM_TabInterData),0,SIZEOF(fM_TabInterData)); //  
	btest[2]:=FALSE;
END_IF
IF btest[3] THEN
	MEMSET(ADR(fDriverOffsetData),0,SIZEOF(fDriverOffsetData)); //  
	btest[3]:=FALSE;
END_IF
IF btest[4] THEN
	//MEMSET(ADR(),0,SIZEOF()); //  
	btest[4]:=FALSE;
END_IF
IF btest[5] THEN
	//MEMSET(ADR(),0,SIZEOF()); //  
	btest[5]:=FALSE;
	fDegreeRec1:=FC_Variance(fOffsetDeg);		
END_IF



(*
IF NOT InterPart.M1Safety THEN
   arrAxisCtrl[AxisNo.SubBelt1].Cmd.JogP_Condition:=TRUE;
   arrAxisCtrl[AxisNo.SubBelt1].Cmd.JogN_Condition:=TRUE;
ELSE 
   arrAxisCtrl[AxisNo.SubBelt1].Cmd.JogP_Condition:=FALSE;
   arrAxisCtrl[AxisNo.SubBelt1].Cmd.JogN_Condition:=FALSE;
END_IF

IF NOT InterPart.M2Safety THEN
   arrAxisCtrl[AxisNo.SubBelt2].Cmd.JogP_Condition:=TRUE;
   arrAxisCtrl[AxisNo.SubBelt2].Cmd.JogN_Condition:=TRUE;
ELSE 
   arrAxisCtrl[AxisNo.SubBelt2].Cmd.JogP_Condition:=FALSE;
   arrAxisCtrl[AxisNo.SubBelt2].Cmd.JogN_Condition:=FALSE;
END_IF
 
IF NOT InterPart.M3Safety THEN
   arrAxisCtrl[AxisNo.SubBelt3].Cmd.JogP_Condition:=TRUE;
   arrAxisCtrl[AxisNo.SubBelt3].Cmd.JogN_Condition:=TRUE;
ELSE 
   arrAxisCtrl[AxisNo.SubBelt3].Cmd.JogP_Condition:=FALSE;
   arrAxisCtrl[AxisNo.SubBelt3].Cmd.JogN_Condition:=FALSE;
END_IF
*)



////位置参数固定
arrAxisPar[AxisNo.Mould].arrTargetPoint[1]:=270;
arrAxisPar[AxisNo.Mould].arrTargetPoint[2]:=120;
arrAxisPar[AxisNo.Cuter].arrTargetPoint[1]:=270;
arrAxisPar[AxisNo.Cuter].arrTargetPoint[2]:=70;

arrAxisPar[AxisNo.BuffeLine].arrTargetPoint[1]:=arrAxisPar[AxisNo.BuffeLine].arrTargetPoint[2]+61.5;




]]></ST>
      </Implementation>
    </Action>
    <Action Name="F09INIT" Id="{3694dc3b-44dc-46c1-b718-edddb24dbb6f}">
      <Implementation>
        <ST><![CDATA[rtInit(CLK:=SysPart.hmiInit, Q=> );
tonInit[1](In:=,PT:=T#800MS);
tonInit[2](In:=,PT:=T#100MS);
CASE iInitstep OF
0:
	IF (SysPart.bInit AND NOT SysPart.bInitDone) OR rtInit.Q THEN
		SysPart.bInitDone:=FALSE;
		SysPart.bIniting:=TRUE;
		iInitstep:=10;
	END_IF
10://气缸类型初始化
//1:有磁性开关双控；2：有磁性开关单控；3：无磁性开关双控；4：无磁性开关单控；默认为1
	arrCyCtrl[CyNo.	Inflation_L	].Cmd.iType:=3;	(*左放卷气胀轴气缸*)	
	arrCyCtrl[CyNo.	Inflation_R	].Cmd.iType:=3;	(*右放卷气胀轴气缸*)	
	arrCyCtrl[CyNo.	BoardPressL	].Cmd.iType:=1;	(*左接带压板气缸*)	
	arrCyCtrl[CyNo.	BoardPressR	].Cmd.iType:=1;	(*右接带压板气缸*)	
	arrCyCtrl[CyNo.	DriverPressAux	].Cmd.iType:=1;	(*辅助驱动压辊气缸*)	
	arrCyCtrl[CyNo.	CoderRollPress	].Cmd.iType:=1;	(*编码器辊压辊气缸*)	
	arrCyCtrl[CyNo.	DriverPressDDR	].Cmd.iType:=1;	(*主驱动压辊气缸*)	
	arrCyCtrl[CyNo.	NGRevBeltUpDown	].Cmd.iType:=1;	(*踢废倒装皮带升降气缸*)	
	arrCyCtrl[CyNo.	NGRevBeltTension	].Cmd.iType:=3;	(*踢废倒装皮带张紧气缸*)	
	arrCyCtrl[CyNo.	PoleBrushDustPush_U	].Cmd.iType:=1;	(*极片上表面毛刷除尘升降缸*)	
	arrCyCtrl[CyNo.	PoleWindDustPush_U	].Cmd.iType:=1;	(*极片上表面风刀除尘升降缸*)	
	arrCyCtrl[CyNo.	PoleBrushDustPush_D	].Cmd.iType:=1;	(*极片下表面毛刷除尘升降缸*)	
	arrCyCtrl[CyNo.	PoleWindDustPush_D	].Cmd.iType:=1;	(*极片下表面风刀除尘升降缸*)	
	arrCyCtrl[CyNo.	DustRevBeltUpDown	].Cmd.iType:=1;	(*极片下表面除尘倒装皮带升降气缸*)	
	arrCyCtrl[CyNo.	NGBoxLock1	].Cmd.iType:=4;	(*NG料盒归正气缸1*)	
	arrCyCtrl[CyNo.	NGBoxLock2	].Cmd.iType:=4;	(*NG料盒归正气缸2*)	
	arrCyCtrl[CyNo.	WasteBoxPush	].Cmd.iType:=4;	(*连续废料收集箱推料气缸*)	
	
	arrCyCtrl[EvNo.	ConnectDustVacuo	].Cmd.iType:=4;	//	极片接带平台除尘真空	
	arrCyCtrl[EvNo.	LineSceneDustBlow	].Cmd.iType:=4;	//	线扫相机镜头除尘吹气	
	arrCyCtrl[EvNo.	LineSceneDustVacuo	].Cmd.iType:=4;	//	线扫相机镜头除尘真空	
	arrCyCtrl[EvNo.	AreaArrayDustBlow	].Cmd.iType:=4;	//	模切面阵相机镜头除尘吹气	
	arrCyCtrl[EvNo.	MouldUpBlow	].Cmd.iType:=3;	//	模具上模吹气	
	arrCyCtrl[EvNo.	MouldDownVacuo	].Cmd.iType:=4;	//	模具下模真空	
	arrCyCtrl[EvNo.	MouldDownAir	].Cmd.iType:=4;	//	模具下模破真空	
	arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.iType:=4;	//	NG踢废腔室破真空	
	arrCyCtrl[EvNo.	NGPushInsideVacuo	].Cmd.iType:=4;	//	NG踢废腔室真空	
	arrCyCtrl[EvNo.	BrushDustVacuo_U	].Cmd.iType:=4;	//	上表面毛刷除尘真空	
	arrCyCtrl[EvNo.	WindDustBlow_U	].Cmd.iType:=4;	//	上表面风刀除尘吹气	
	arrCyCtrl[EvNo.	WindDustVacuo_U	].Cmd.iType:=4;	//	上表面风刀除尘真空	
	arrCyCtrl[EvNo.	BrushDustVacuo_D	].Cmd.iType:=4;	//	下表面毛刷除尘真空	
	arrCyCtrl[EvNo.	WindDustBlow_D	].Cmd.iType:=4;	//	下表面风刀除尘吹气	
	arrCyCtrl[EvNo.	WindDustVacuo_D	].Cmd.iType:=4;	//	下表面风刀除尘真空	
	arrCyCtrl[EvNo.	RJ_Blow	].Cmd.iType:=4;	//	下表面风刀除尘真空		
	arrCyCtrl[EvNo.	RJDustBlow  ].Cmd.iType:=4;	//R角风刀吹气	
	
	iInitstep:=20;

20://判断是否在耦合中
	IF arrAxis[AxisNo.BuffeLine].Status.Coupled THEN
		arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop:=TRUE;
	END_IF
	IF arrAxis[AxisNo.DriverDDR].Status.Coupled THEN
		arrAxisCtrl[AxisNo.DriverDDR].Cmd.bStop:=TRUE;
	END_IF	
	IF arrAxis[AxisNo.Mould].Status.Coupled THEN
		arrAxisCtrl[AxisNo.Mould].Cmd.bStop:=TRUE;
	END_IF		
	IF arrAxis[AxisNo.Cuter].Status.Coupled THEN
		arrAxisCtrl[AxisNo.Cuter].Cmd.bStop:=TRUE;
	END_IF		
	IF arrAxis[AxisNo.CCDPressPush].Status.Coupled THEN
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop:=TRUE;
	END_IF	
	IF arrAxis[VirAxisNo.VirBelt].Status.Coupled THEN
		arrAxisCtrl[VirAxisNo.VirBelt].Cmd.bStop:=TRUE;
	END_IF	
	(*
	IF arrAxis[AxisNo.NGPush2].Status.Coupled THEN
		arrAxisCtrl[AxisNo.NGPush2].Cmd.bStop:=TRUE;
	END_IF	
	*)
	IF NOT arrAxis[AxisNo.BuffeLine].Status.Coupled AND NOT arrAxis[AxisNo.DriverDDR].Status.Coupled AND NOT arrAxis[AxisNo.Mould].Status.Coupled AND
		NOT arrAxis[AxisNo.Cuter].Status.Coupled AND NOT arrAxis[AxisNo.CCDPressPush].Status.Coupled AND NOT arrAxis[VirAxisNo.VirBelt].Status.Coupled(* AND
		NOT arrAxis[AxisNo.NGPush2].Status.Coupled *)THEN
		iInitstep:=30;
	END_IF
	
30://凸轮创建信号复位
	stPoleBufferCam.bCreatTable:=FALSE;
	stVirBeltCam.bCreatTable:=FALSE;
	//stNGPushCam.bCreatTable:=FALSE;
	stCuterCam.bCreatTable:=FALSE;
	stDriverCam.bCreatTable:=FALSE;
	stMouldCam.bCreatTable:=FALSE;
	stCCDPressCam.bCreatTable:=FALSE;
	stPoleBufferCam_1.bCreatTable:=FALSE;
	stVirDriverCam.bCreatTable:=FALSE;
	
	FOR i:=1 TO 50 DO//NG类型标志位复位
		Production.NGFlag[i]:=FALSE;
	END_FOR
	iInitstep:=40;
	
40://凸轮创建
	stVirBeltCam.bCreatTable:=TRUE;
	//stNGPushCam.bCreatTable:=TRUE;
	stCuterCam.bCreatTable:=TRUE;
	stDriverCam.bCreatTable:=TRUE;
	stMouldCam.bCreatTable:=TRUE;
	stCCDPressCam.bCreatTable:=TRUE;
	stVirDriverCam.bCreatTable:=TRUE;
	iInitstep:=50;
	
50://凸轮创建判断
IF NOT tonInit[2].Q THEN
	tonInit[2].IN:=TRUE;
ELSE
	IF stVirBeltCam.bCreatTableDone (*AND stNGPushCam.bCreatTableDone*) AND
		stCuterCam.bCreatTableDone AND stDriverCam.bCreatTableDone AND stMouldCam.bCreatTableDone AND
		stCCDPressCam.bCreatTableDone AND stVirDriverCam.bCreatTableDone THEN
		stVirBeltCam.bCreatTable:=FALSE;
		//stNGPushCam.bCreatTable:=FALSE;
		stCuterCam.bCreatTable:=FALSE;
		stDriverCam.bCreatTable:=FALSE;
		stMouldCam.bCreatTable:=FALSE;
		stCCDPressCam.bCreatTable:=FALSE;	
		stVirDriverCam.bCreatTable:=FALSE;
		tonInit[2].IN:=FALSE;	
		iInitstep:=60;
	END_IF
END_IF

60://极片缓存凸轮创建
	stPoleBufferCam.bCreatTable:=TRUE;
	stPoleBufferCam_1.bCreatTable:=TRUE;
	iInitstep:=70;
	
70://判断极片缓存凸轮创建	
	IF stPoleBufferCam.bCreatTableDone AND stPoleBufferCam_1.bCreatTableDone THEN
		stPoleBufferCam.bCreatTable:=FALSE;	
		stPoleBufferCam_1.bCreatTable:=FALSE;	
		iInitstep:=80;
	END_IF

80://完成
	SysPart.bInit:=FALSE;
	IF stSysState.iMode=0 THEN
		SysPart.bInitDone:=TRUE;
		SysPart.bIniting:=FALSE;
		iInitstep:=0;
	ELSE
		IF NOT tonInit[1].Q THEN
			tonInit[1].IN:=TRUE;
		ELSE
			SysPart.hmiInit:=FALSE;
			SysPart.bIniting:=FALSE;
			SysPart.bInitDone:=TRUE;
			tonInit[1].IN:=FALSE;
			iInitstep:=0;	
		END_IF	
	END_IF
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="F10GearCall" Id="{21106b04-cadb-4aee-a9ed-00cdd1d15078}">
      <Implementation>
        <ST><![CDATA[(*
//虚拟放卷
fbVirDriverGear(
	Reset:=stSysState.bReset , 
	fratio1:= , 
	bError=>stVirDriverGear.bError , 
	bReady=>stVirDriverGear.bReady , 
	InGear=>stVirDriverGear.bInGear , 
	bEnable:=stVirDriverGear.bEnable , 
	bGearOutMode:=stVirDriverGear.bGearOutMode , 
	master:=arrAxis[VirAxisNo.VirMain] , 
	slave1:=arrAxis[VirAxisNo.VirDriver] );
*)
fbVDriverCam(
	Reset:=stSysState.bReset , 
	bCamInExecute:=FALSE , //stVirDriverCam.bCamInExecute
	bCreatTable:=stVirDriverCam.bCreatTable , 
	iTable:=TableNo.VirDirver , 
	fCompensation:= , //主驱运动时片宽的补偿值
	fDiameterDriver:=PolePar.Machine.fMQDriverDiameter , 
	fPoleWidth:=PolePar.fPoleWidth , 
	fMainPos:=ProductPar.parPublic.fMainPos , 
	
	axisSlave:=arrAxis[VirAxisNo.VirDriver]   , 
	axisMaster:= arrAxis[VirAxisNo.VirMain], 
	
	bCreatTableDone=>stVirDriverCam.bCreatTableDone , 
	bCreatTableError=>stVirDriverCam.bCreatTableError , 
	bError=>stVirDriverCam.bError , 
	bReady=>stVirDriverCam.bReady , 
	bInSync=>stVirDriverCam.bInSync );	


	

	
	
//裁切输送皮带	
fbCuterBeltGear(	
	Reset:=stSysState.bReset , 
	fratio1:=PolePar.Machine.fBelt5Scaling   ,  //PolePar.Machine.fBelt1Scaling
	bError=>stCuterBeltGear.bError , 
	bReady=>stCuterBeltGear.bReady , 
	InGear=>stCuterBeltGear.bInGear , 
	bEnable:=stCuterBeltGear.bEnable , 
	bGearOutMode:=stCuterBeltGear.bGearOutMode , 
	master:=arrAxis[VirAxisNo.VirBelt] , 
	slave1:=arrAxis[AxisNo.CuterBelt] );
	PolePar.Machine.fBelt1Scaling:=1;
//踢废倒装皮带	
fbNGReverseBeltGear(	
	Reset:=stSysState.bReset , 
	fratio1:=PolePar.Machine.fBelt5Scaling , 
	bError=>stNGReverseBeltGear.bError , 
	bReady=>stNGReverseBeltGear.bReady , 
	InGear=>stNGReverseBeltGear.bInGear , 
	bEnable:=stNGReverseBeltGear.bEnable , 
	bGearOutMode:=stNGReverseBeltGear.bGearOutMode , 
	master:=arrAxis[VirAxisNo.VirBelt] , 
	slave1:=arrAxis[AxisNo.NGPushReverseBelt] );
	PolePar.Machine.fBelt2Scaling:=1;
//上表面除尘皮带	
fbDedustBeltGear(	
	Reset:=stSysState.bReset , 
	fratio1:=PolePar.Machine.fBelt5Scaling , 
	bError=>stDedustBeltGear.bError , 
	bReady=>stDedustBeltGear.bReady , 
	InGear=>stDedustBeltGear.bInGear , 
	bEnable:=stDedustBeltGear.bEnable , 
	bGearOutMode:=stDedustBeltGear.bGearOutMode , 
	master:=arrAxis[VirAxisNo.VirBelt] , 
	slave1:=arrAxis[AxisNo.DedustBelt] );
	PolePar.Machine.fBelt3Scaling:=1;
//下表面除尘倒装皮带	
fbDedustReverseBeltGear(	
	Reset:=stSysState.bReset , 
	fratio1:=PolePar.Machine.fBelt5Scaling , 
	bError=>stDedustReverseBeltGear.bError , 
	bReady=>stDedustReverseBeltGear.bReady , 
	InGear=>stDedustReverseBeltGear.bInGear , 
	bEnable:=stDedustReverseBeltGear.bEnable , 
	bGearOutMode:=stDedustReverseBeltGear.bGearOutMode , 
	master:=arrAxis[VirAxisNo.VirBelt] , 
	slave1:=arrAxis[AxisNo.DedustReverseBelt] );
	PolePar.Machine.fBelt4Scaling:=1;
	arrAxisCtrl[AxisNo.DedustReverseBelt].Status.Moving;
//分段主皮带1	
bSubBelt1fratio:=TRUE;//屏蔽1号皮带时，置false
IF bSubBelt1fratio THEN
	fbSubBelt1Gear.fratio1:=PolePar.Machine.fBelt5Scaling;
ELSE
	fbSubBelt1Gear.fratio1:=0;
END_IF
fbSubBelt1Gear(	
	Reset:=stSysState.bReset , 
	fratio1:= , 
	bError=>stSubBelt1Gear.bError , 
	bReady=>stSubBelt1Gear.bReady , 
	InGear=>stSubBelt1Gear.bInGear , 
	bEnable:=stSubBelt1Gear.bEnable , 
	bGearOutMode:=stSubBelt1Gear.bGearOutMode , 
	master:=arrAxis[VirAxisNo.VirBelt] , 
	slave1:=arrAxis[AxisNo.SubBelt1] );
	
//分段主皮带2	
IF bSubBelt2fratio THEN
	fbSubBelt2Gear.fratio1:=PolePar.Machine.fBelt6Scaling;
ELSE
	fbSubBelt2Gear.fratio1:=0;
END_IF
fbSubBelt2Gear(	
	Reset:=stSysState.bReset , 
	fratio1:= , 
	bError=>stSubBelt2Gear.bError , 
	bReady=>stSubBelt2Gear.bReady , 
	InGear=>stSubBelt2Gear.bInGear , 
	bEnable:=stSubBelt2Gear.bEnable , 
	bGearOutMode:=stSubBelt2Gear.bGearOutMode , 
	master:=arrAxis[VirAxisNo.VirBelt] , 
	slave1:=arrAxis[AxisNo.SubBelt2] );
	
//分段主皮带3	
IF bSubBelt3fratio THEN
	fbSubBelt3Gear.fratio1:=PolePar.Machine.fBelt7Scaling;
ELSE
	fbSubBelt3Gear.fratio1:=0;
END_IF
fbSubBelt3Gear(	
	Reset:=stSysState.bReset , 
	fratio1:= , 
	bError=>stSubBelt3Gear.bError , 
	bReady=>stSubBelt3Gear.bReady , 
	InGear=>stSubBelt3Gear.bInGear , 
	bEnable:=stSubBelt3Gear.bEnable , 
	bGearOutMode:=stSubBelt3Gear.bGearOutMode , 
	master:=arrAxis[VirAxisNo.VirBelt] , 
	slave1:=arrAxis[AxisNo.SubBelt3] );
]]></ST>
      </Implementation>
    </Action>
    <Action Name="F11CamCall" Id="{0d2bf613-8ddc-4699-a88f-83f349d84534}">
      <Implementation>
        <ST><![CDATA[//极片缓存 V1

fbPoleBufferCam(
