IF arrAxisPar[AxisNo.NGPush1].arrTargetPoint[1]=0 THEN
	arrAxisPar[AxisNo.NGPush1].arrTargetPoint[1]:=1;
END_IF
IF arrAxisPar[AxisNo.NGPush1].arrTargetPoint[2]=0 THEN
	arrAxisPar[AxisNo.NGPush1].arrTargetPoint[2]:=180;
END_IF
IF arrAxisPar[AxisNo.NGPush2].arrTargetPoint[1]=0 THEN
	arrAxisPar[AxisNo.NGPush2].arrTargetPoint[1]:=270;
END_IF
IF arrAxisPar[AxisNo.NGPush2].arrTargetPoint[2]=0 THEN
	arrAxisPar[AxisNo.NGPush2].arrTargetPoint[2]:=90;
END_IF
*)
