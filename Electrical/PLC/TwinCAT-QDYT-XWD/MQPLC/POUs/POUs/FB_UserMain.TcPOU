    <Action Name="F12TensionCall" Id="{773d1077-f8f5-4c07-aa80-533245b96411}">
      <Implementation>
        <ST><![CDATA[

	fbPoleBufferTen.bTensionOK:=stUwindTen.bTensionOK;
	
	fbPoleBufferTen(
	bReset:=                               stSysState.bReset , 
	fAuxDriverDiameter:=            PolePar.Machine.fAuxDriverInDiameter ,  
	fDDRDiameter:=                    PolePar.Machine.fMQDriverDiameter ,  
	fPoleWith:=                           PolePar.fPoleWidth , 
    fCompensation:=                   fPoleBufferCompensation , 
    fDanceBlancePos:=                arrAxisPar[AxisNo.BuffeLine].arrTargetPoint[1] ,  
   	bPositiveLimit:=                     arrAxisCtrl[AxisNo.BuffeLine].Io.biPosLimit   , 
	bNegativeLimit:=                   arrAxisCtrl[AxisNo.BuffeLine].Io.biNegLimit      , 
	bTensionOK:=                       fbPoleBufferTen.bTensionOK     , 
	fMainVel:=                            PolePar.iMainVel         , 
	bReady=>                            stBufferTen.bReady , 
	bError=>                              stBufferTen.bError , 
	bInSync=>                            stBufferTen.bInSync, 
	VirMain:=                             arrAxis[VirAxisNo.VirMain], 
	//AuxDriver:=                          arrAxis[AxisNo.DriverAux] ,
	DDRDriver:=                         arrAxis[AxisNo.DriverDDR]  ,
	VirDriver:=                           arrAxis[VirAxisNo.VirDriver]  ,
	BufferLine:=                         arrAxis[AxisNo.BuffeLine] ,  
	bTenExecute:=                     stBufferTen.bExecute   );
	
	//放卷张力
PolePar.MQ.TenCcw_WindL:=PolePar.MQ.TenCcw_WindR:=FALSE;
	fbUwindTen(
		bReset:=stSysState.bReset , 
		bCcwL:=PolePar.MQ.TenCcw_WindL, //左放卷方向
		bCcwR:=PolePar.MQ.TenCcw_WindR,//右放卷方向
		bWindSel:=PolePar.MQ.bWindSelect, //左右卷选择
		fDiaMin:=250,//最小卷径		
		fDiaMax:=800,//最大卷径
		//fDanserDegree:=arrAxisCtrl[AxisNo.PoleTension].Status.fActPos , 
		fActTorque:= SEL(iPartSelect=1   , iActDriveTorque[2],    iActDriveTorque[1] )    , 
		fSetTorque:= SEL(iPartSelect=1   , iTargetTorque[2],       iTargetTorque[1] )      , 
		PidSwitch:=PolePar.MQ.WindPidSwitch ,
		bTenExecute:=stUwindTen.bTenExecute , 
		bStudyExecute:=stUwindTen.bStudyExecute AND stUwindTen.fStudyDiameter>0, 
		fStudyDiameter:=stUwindTen.fStudyDiameter , 
		fDriveDiameter:=PolePar.Machine.fMQDriverDiameter, 
		fPoleWith:=PolePar.fPoleWidth , 
		fCompensation:= , 
		fDancerMinPos:=PolePar.MQ.AuxDriverTenMinPos,//摆杆最小角度
		fDancerMaxPos:=PolePar.MQ.AuxDriverTenMaxPos,//摆杆最大角度
		fDanceBlancePos:=PolePar.MQ.AuxDriverTenBlancePos , //摆杆平衡角度
		fDanserDegree:=stAuxDriverTen.fDanserDegree , //摆杆实时角度
		//fDancerMinPos:=PolePar.MQ.WindTenMinPos , 
		//fDancerMaxPos:=PolePar.MQ.WindTenMaxPos , 
		//fDanceBlancePos:=PolePar.MQ.WindTenBlancePos , 
		bReady=>stUwindTen.bReady , 
		bTensionOK=>stUwindTen.bTensionOK , 
		bError=>stUwindTen.bError , 
		fWindDiameterTemp=>stUwindTen.fWindDiameter,
		VirMain:=arrAxis[VirAxisNo.VirMain] , 
		Master:=arrAxis[VirAxisNo.VirDriver] , 
		SlaveL:=arrAxis[AxisNo.UnWind_L], 
		SlaveR:=arrAxis[AxisNo.UnWind_R], 
		Driver:=arrAxis[AxisNo.DriverDDR] , 
		TimerAxis:=arrAxis[NameNo.VirTimeWind] , 
		TensionAxis:=arrAxis[AxisNo.PoleTension] , 
		Table:=PolePar.MQ.WindTenTable ,
		AxisNoBuffeLine :=AxisNo.BuffeLine);
	

		
		
(*
//左放卷张力

fbUwindLTen(
	bReset:=stSysState.bReset , 
	bCcw:=PolePar.MQ.TenCcw_WindL , 
	fDanserDegree:=stUwindLTen.fDanserDegree , 
	//fWindDiameter:=stUwindLTen.fWindDiameter  , 
	fActTorque:= SEL(iPartSelect=1   , iActDriveTorque[2],    iActDriveTorque[1] )    , 
	fSetTorque:= SEL(iPartSelect=1   , iTargetTorque[2],       iTargetTorque[1] )      , 
	PidSwitch:=TRUE , //PolePar.MQ.WindPidSwitch
	bTenExecute:=stUwindLTen.bTenExecute , 
	bStudyExecute:=stUwindLTen.bStudyExecute , 
	fStudyDiameter:=stUwindLTen.fStudyDiameter , 
	fDriveDiameter:=PolePar.Machine.fAuxDriverInDiameter , 
	fPoleWith:=PolePar.fPoleWidth , 
	fCompensation:= , 
	fDancerMinPos:=PolePar.MQ.WindTenMinPos , 
	fDancerMaxPos:=PolePar.MQ.WindTenMaxPos , 
	fDanceBlancePos:=PolePar.MQ.WindTenBlancePos , 
	bReady=>stUwindLTen.bReady , 
	bTensionOK=>stUwindLTen.bTensionOK , 
	bError=>stUwindLTen.bError , 
	VirMain:=arrAxis[VirAxisNo.VirMain] , 
	Master:=arrAxis[VirAxisNo.VirDriver] , 
	Slave:=arrAxis[AxisNo.UnWind_L] , 
	Driver:=arrAxis[AxisNo.DriverAux] , 
	TimerAxis:=arrAxis[NameNo.VirTimeWind] , 
	TensionAxis:=arrAxis[AxisNo.PoleTension] , 
	Table:=PolePar.MQ.WindTenTable );
	stUwindLTen.fDanserDegree:=arrAxisCtrl[AxisNo.PoleTension].Status.fActPos;
	PolePar.MQ.TenCcw_WindL:=FALSE;
	
	stUwindLTen.fWindDiameter  ;
	fbUwindLTen.fWindDiameter;
	fbUwindLTen.fDiameterCalculate;
	fbUwindLTen.fWindDiameterTemp;
	
//右放卷张力
fbUwindRTen(	
	bReset:=stSysState.bReset , 
	bCcw:=PolePar.MQ.TenCcw_WindR , 
	fDanserDegree:=stUwindRTen.fDanserDegree , 
	//fWindDiameter:=stUwindRTen.fWindDiameter , 
	fActTorque:= SEL(iPartSelect=1   , iActDriveTorque[2],    iActDriveTorque[1] )    , 
	fSetTorque:= SEL(iPartSelect=1   , iTargetTorque[2],       iTargetTorque[1] )      , 
	PidSwitch:=TRUE, //PolePar.MQ.WindPidSwitch 
	bTenExecute:=stUwindRTen.bTenExecute , 
	bStudyExecute:=stUwindRTen.bStudyExecute , 
	fStudyDiameter:=stUwindRTen.fStudyDiameter , 
	fDriveDiameter:=PolePar.Machine.fAuxDriverInDiameter , 
	fPoleWith:=PolePar.fPoleWidth , 
	fCompensation:= ,
	fDancerMinPos:=PolePar.MQ.WindTenMinPos , 
	fDancerMaxPos:=PolePar.MQ.WindTenMaxPos , 
	fDanceBlancePos:=PolePar.MQ.WindTenBlancePos , 
	bReady=>stUwindRTen.bReady , 
	bTensionOK=>stUwindRTen.bTensionOK , 
	bError=>stUwindRTen.bError , 
	VirMain:=arrAxis[VirAxisNo.VirMain] , 
	Master:=arrAxis[VirAxisNo.VirDriver] , 
	Slave:=arrAxis[AxisNo.UnWind_R]  , 
	Driver:=arrAxis[AxisNo.DriverAux] , 
	TimerAxis:=arrAxis[NameNo.VirTimeWind], 
	TensionAxis:=arrAxis[AxisNo.PoleTension] , 
	Table:=PolePar.MQ.WindTenTable );
	
	
	
	stUwindRTen.fDanserDegree:=arrAxisCtrl[AxisNo.PoleTension].Status.fActPos;
	PolePar.MQ.TenCcw_WindR:=FALSE;
	
	stUwindRTen.fWindDiameter  ;
	fbUwindRTen.fWindDiameter;
	fbUwindRTen.fDiameterCalculate;
	fbUwindRTen.fWindDiameterTemp;
*)	
//辅驱张力
stAuxDriverTen.fWindDiameter:=stAuxDriverTen.fStudyDiameter:=PolePar.Machine.fAuxDriverInDiameter;
PolePar.MQ.TenCcw_AuxDriver:=FALSE;
fbAuxDriverTen(
	bReset:=stSysState.bReset , 
	bCcw:=PolePar.MQ.TenCcw_AuxDriver , 
	fDanserDegree:=stAuxDriverTen.fDanserDegree , 
	fWindDiameter:=stAuxDriverTen.fWindDiameter , 
	PidSwitch:=FALSE , //PolePar.MQ.AuxDriverPidSwitch
	bTenExecute:=stAuxDriverTen.bTenExecute , 
	bStudyExecute:=FALSE, //stAuxDriverTen.bStudyExecute
	fStudyDiameter:=stAuxDriverTen.fStudyDiameter , 
	fPoleWith:=PolePar.fPoleWidth , 
	fCompensation:= , 
	fDancerMinPos:=PolePar.MQ.AuxDriverTenMinPos , 
	fDancerMaxPos:=PolePar.MQ.AuxDriverTenMaxPos , 
	fDanceBlancePos:=PolePar.MQ.AuxDriverTenBlancePos , 
	bReady=>stAuxDriverTen.bReady , 
	bTensionOK=>stAuxDriverTen.bTensionOK , 
	bError=>stAuxDriverTen.bError , 
	VirMain:=arrAxis[VirAxisNo.VirMain] , 
	Master:=arrAxis[VirAxisNo.VirDriver] , 
	Slave:=arrAxis[AxisNo.DriverAux] , 
	TimerAxis:=arrAxis[NameNo.VirTimeWind] , 
	Table:=PolePar.MQ.AuxDriverTenTable );	













]]></ST>
      </Implementation>
    </Action>
    <Action Name="F13ClearBelt" Id="{d22918f8-1cb8-494b-a07f-103510ff5d58}">
      <Implementation>
        <ST><![CDATA[//一键皮带清料
rtClearBelt[1](CLK:=SysPart.hmiClearBelt , Q=> );
rtClearBelt[2](CLK:= , Q=> );
rtClearBelt[3](CLK:= , Q=> );
rtClearBelt[4](CLK:= , Q=> );
rtClearBelt[5](CLK:= , Q=> );
tonClearBelt[1](In:=,PT:=T#200MS);
tonClearBelt[2](In:=,PT:=T#200MS);
tonClearBelt[3](In:=,PT:=T#200MS);
tonClearBelt[4](In:=,PT:=T#200MS);	
tonClearBelt[5](In:=,PT:=T#200MS);	
tonClearBelt[6](In:=,PT:=T#200MS);	
tonClearBelt[7](In:=,PT:=T#200MS);
tonClearBelt[8](In:=,PT:=T#200MS);
tonClearBelt[9](In:=,PT:=T#200MS);
tonClearBelt[10](In:=,PT:=T#200MS);
IF rtClearBelt[1].Q THEN
	iClearBeltStep:=88;//皮带清料触发
END_IF;

CASE iClearBeltStep OF
///////////////////////////////////////////////////////////凸轮耦合/////////////////////////////////////////////////////
88://有关气缸动作
	arrCyCtrl[CYNo.NGRevBeltTension].Cmd.bON:=TRUE;
	arrCyCtrl[CYNo.NGRevBeltUpDown].Cmd.bON:=TRUE;
	arrCyCtrl[CYNo.DustRevBeltUpDown].Cmd.bON:=TRUE;
	IF	arrCyCtrl[CyNo.NGRevBeltUpDown].Status.ONState AND arrCyCtrl[CYNo.DustRevBeltUpDown].Status.ONState THEN
		iClearBeltStep:=90;//		
	END_IF
	
90://凸轮/张力解耦
	bMethodTenBufferDisEnable:=TRUE;
	bMethodCamDisEnable:=TRUE;
	iClearBeltStep:=100;//	
	
100://判断是否解耦完成
	IF NOT bMethodTenBufferDisEnable AND NOT bMethodCamDisEnable THEN
		iClearBeltStep:=110;
	END_IF
110://主轴清0
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<>0 THEN
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.fSetPos:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos-arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos+360;
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bSetPos:=TRUE;
	END_IF
	iClearBeltStep:=120;
120://皮带虚轴耦合
	IF NOT stVirBeltCam.bInSync THEN
		stVirBeltCam.bCamInExecute:=TRUE;
	ELSE
		iClearBeltStep:=130;
	END_IF	
130://皮带齿合
	IF NOT stCuterBeltGear.bInGear THEN
		stCuterBeltGear.bEnable:=TRUE;
	END_IF	
	IF NOT stNGReverseBeltGear.bInGear THEN
		stNGReverseBeltGear.bEnable:=TRUE;
	END_IF		
	IF NOT stDedustBeltGear.bInGear THEN
		stDedustBeltGear.bEnable:=TRUE;
	END_IF
	IF NOT stDedustReverseBeltGear.bInGear THEN
		stDedustReverseBeltGear.bEnable:=TRUE;
	END_IF

	IF NOT stSubBelt1Gear.bInGear THEN
		stSubBelt1Gear.bEnable:=TRUE;
	END_IF

	IF NOT stSubBelt2Gear.bInGear THEN
		bSubBelt2fratio:=TRUE;
		stSubBelt2Gear.bEnable:=TRUE;
	END_IF	
	
	IF NOT stSubBelt3Gear.bInGear THEN
		bSubBelt3fratio:=TRUE;
		stSubBelt3Gear.bEnable:=TRUE;
	END_IF		

	IF stCuterBeltGear.bInGear AND stNGReverseBeltGear.bInGear AND stDedustBeltGear.bInGear AND stDedustReverseBeltGear.bInGear AND 
	     stSubBelt1Gear.bInGear AND  stSubBelt2Gear.bInGear AND  stSubBelt3Gear.bInGear THEN
    	iClearBeltStep:=140;		
	END_IF
140://主轴运动40个周期
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos-arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos+40*360;
	arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Abs:=PolePar.iMainVel*6;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs:=TRUE;
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.Moving THEN
		iClearBeltStep:=150;
	END_IF
150://判断主轴运动完成
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving AND NOT arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs THEN
		iClearBeltStep:=160;
	END_IF
160://清除皮带记忆
	MEMSET(ADR(BeltData),0,SIZEOF(BeltData));
	iClearBeltStep:=170;
170://
	SysPart.hmiClearBelt:=FALSE;
	iClearBeltStep:=666;

END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="Product" Id="{50221cb1-87b1-443c-9509-e84508d0df40}">
      <Implementation>
        <ST><![CDATA[
//切刀计数
rtCount2(CLK:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=10 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<=100);
IF rtCount2.Q THEN
	Production.OutFlag1:=TRUE;//产能计数
END_IF

////////////////////////////////////////////////////////////////NG剔废////////// NG分类 //////////////////////////////////////////////////////
ProductPar.iModeEN.bNG1PushEN:=ProductPar.iModeEN.bNG2PushEN;
CASE iNGStep OF 
10://判断NG1&NG2是否动作 主轴静止或运行中
	IF (  NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bSizeCCDEN AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>30 ) THEN//BeltData[BeltNo.NGBox].iPanoramaNG<>1
		 iNGStep:=200;
	ELSIF  BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo<>30   AND NOT ProductPar.iModeEN.bLineScanCCDEN  THEN //XianSaong_Up[2]<>30 OR XianSaong_Down[0]<>30  
		iNGStep:=300;
	ELSIF  BeltData[BeltNo.NGBox1+2].bYellowMark    OR  BeltData[BeltNo.NGBox1+2].bBlueMark  THEN//黄标
		iNGStep:=300;
	ELSE
		nInt[3]:=0;
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=FALSE;//踢NG料打开
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=TRUE;//踢NG料关闭		
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bON:=TRUE;//踢NG料真空打开
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bOFF:=FALSE;//踢NG料真空关闭		
		iNGStep:=666;
	END_IF

200:
	IF  NOT ProductPar.iModeEN.bEmptyRunEN   THEN//AND NOT  ProductPar.iModeEN.bP2PartEN
			IF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=1 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[1]:=TRUE;//极片长度不良
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=2 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[2]:=TRUE;//极片CIL宽度不良
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=3 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[3]:=TRUE;//极片宽度不良标志位
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=4 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[4]:=TRUE;//极耳宽度不良
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=5 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[5]:=TRUE;//极耳高度不良
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=6 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[6]:=TRUE;//极耳侧边距不良
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=7 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[7]:=TRUE;//极耳面积不良
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=8 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[8]:=TRUE;//圆角深度不良
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=9 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[9]:=TRUE;//极耳边缘角度不良
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=10 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[10]:=TRUE;//圆角宽度不良
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=11 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[11]:=TRUE;//圆角轮廓不良	
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=12 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[12]:=TRUE;//圆角面积不良		
			ELSIF REAL_TO_INT(BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo)=13 THEN
				Production.NGFlag[49]:=TRUE;//尺寸总不良
				Production.NGFlag[13]:=TRUE;//圆角余料不良		
			ELSIF (BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>1 AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>2 AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>3
				AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>4 AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>5 AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>6
				 AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>7  AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>8  AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>9
				 AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>11  AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>12  AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>13
				) OR  BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo=33  THEN  //尺寸检测其他不良 ,,,CCD超时
				Production.NGFlag[49]:=TRUE;//尺寸检测其他不良 ,,,CCD超时
				Production.NGFlag[14]:=TRUE;
			END_IF
	END_IF
		FOR i:=1 TO 20 DO
			IF i<20 THEN
				XianSaong[21-i]:=XianSaong[20-i];
				XianSaong1[21-i]:=XianSaong1[20-i];
			ELSE
				XianSaong[1]:=BeltData[BeltNo.NGBox1].iPanoramaNG;
				XianSaong1[1]:=REAL_TO_INT(BeltData[BeltNo.NGBox1].fPoleNGSizeNo);
			END_IF
		END_FOR
		iNGStep:=400;
300:
	 IF NOT ProductPar.iModeEN.bEmptyRunEN  THEN//AND NOT  ProductPar.iModeEN.bP2PartEN
			IF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=1 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[21]:=TRUE;//抓边失败
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=2 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[22]:=TRUE;//直边不良标志位
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=3 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[23]:=TRUE;//极片缺失
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=4 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[24]:=TRUE;//接带
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=5 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[25]:=TRUE;//线扫黄标
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=6 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[26]:=TRUE;//漏金属
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=7 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[27]:=TRUE;//气泡
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=8 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[28]:=TRUE;//暗条痕
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=9 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[29]:=TRUE;//亮条痕
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=10 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[30]:=TRUE;//破损
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=11 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[31]:=TRUE;//碎屑
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=12 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[33]:=TRUE;//脱碳
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=29 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[34]:=TRUE;//其他
			ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=33 THEN
				Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[32]:=TRUE;//通讯超时
(*			ELSIF BeltData[BeltNo.NGBox1+2].bYellowMark  THEN
				//Production.NGFlag[48]:=TRUE;//线扫总不良
				Production.NGFlag[33]:=TRUE;//感应器黄标*)
			END_IF
	END_IF
		iNGStep:=400;
400:
	arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=TRUE;//踢NG料破真空打开
	arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=FALSE;//踢NG料破真空关闭
	arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bON:=FALSE;//踢NG料真空打开
	arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bOFF:=TRUE;//踢NG料真空关闭
	BeltData[BeltNo.NGBox1+2].bHavePole:=FALSE;	
	BeltData[BeltNo.NGBox1+2].stPoleNo:='';
	nInt[3]:=1;		
	//BeltData[BeltNo.NGBox1].bHavePole:=FALSE;
	FOR i:=1 TO 50 DO//NG类型标志位复位
		Production.NGFlag[i]:=FALSE;
    	END_FOR
	iNGStep:=666;
END_CASE

IF iNGStep=300 THEN
	IF BeltData[BeltNo.NGBox1+1].bBlueMark OR BeltData[BeltNo.NGBox1+2].bBlueMark OR BeltData[BeltNo.NGBox1+3].bBlueMark THEN
		iNGState:=1;//接带踢废
	ELSIF BeltData[BeltNo.NGBox1+2].bYellowMark THEN
		IF BeltData[BeltNo.NGBox1+1].bYellowMark THEN
			iNGState:=2;//黄标跳切踢废
		ELSIF NOT BeltData[BeltNo.NGBox1+3].bYellowMark THEN
			iNGState:=3;//黄标单张踢废
		END_IF
	ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=4 THEN
		iNGState:=4;//线扫接带
	ELSIF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo=5 THEN
		iNGState:=5;//线扫黄标
	END_IF
END_IF

aFB_ProductionDataLocal(
	NowTimeData:=System.StTime, (*当前系统时间*)
	OutFlag1:=Production.OutFlag1, (*产量计数标志1*)
	OutFlag2:=Production.OutFlag2, (*产量计数标志1*)
	NGFlag:=Production.NGFlag ,(*NG1计数标志*)(*扫码NG*)
	RunFlag:=stSysState.iMode=1,(*运行标志*)
	WaitFlag:=stSysState.iMode<>1 AND NOT stSysState.Alarming ,(*待料标志*)
	AlarmFlag:=stSysState.Alarming, (*故障标志*)
	DelDataAMBtn:= Production.HMI_DelDataAMBtn,(*白班数据清除按钮*)//HMI_DayCountZero
	DelDataPMBtn:= Production.HMI_DelDataPMBtn,(*夜班数据清除按钮*)//HMI_NightCountZero
	NowOutTotal=>Production.HMI_TotalCount ,(*当前班次加工总数*)
	NowRate=> Production.HMI_Qualified,(*当前班次良率*)
	NGClearAMBtn:=Production.HMI_NGClearAMBtn,//白班NG类型计数清零
	NGClearPMBtn:=Production.HMI_NGClearPMBtn,//夜班NG类型计数清零
	NowDay:= Production.SaveNowDay,(*数据移位时所保存当前日*)
	NowMonth:=Production.SaveNowMonth ,(*数据移位时所保存当前月*)
	DayHistory:= Production.DayReadDayHistory, (*历史日*)
	MonthHistory:= Production.DayReadMonthHistory,(*历史月*)
	TodayTotal:=Production.HMI_TodayTotal ,(*当天24H生产总数*)
	TodayOK:=Production.HMI_TodayOK , (*当天24H生产OK总数*)
	TodayNG:=Production.HMI_TodayNG , (*当天24H生产NG总数*)
	TodayTotal_AM:= Production.DayCountTotal,(*当天白班生产总数*)
	TodayTotal_PM:=Production.NightCountTotal,(*当天夜班生产总数*)
	TodayRate_AM:= Production.HMI_DayQualified,(*当天白班良率*)
	TodayRate_PM:=Production.HMI_NightQualified ,(*当天夜班良率*)
	OEE=> Production.HMI_OEE,//设备稼动率/稼动率
	TodayOK_AM:=Production.HMI_DayOkCount ,(*当天白班生产OK总数*)
	TodayOK_PM:= Production.HMI_NightOkCount,(*当天夜班生产OK总数*)
	TodayNG_AM:=Production.HMI_DayNgCount ,(*当天白班生产NG总数*)
	TodayNG_PM:=Production.HMI_NightNgCount , (*当天夜班生产NG总数*)
	TodayHour_AM:= Production.HourTimeDayCount,(*当天白班每小时产量ARRAY[8..19 ]*)
	TodayHour_PM:=Production.HourTimeNightCount ,(*当天夜班每小时产量ARRAY[0..23]*)
	TodayNGClass_AM:=Production.NgPerHourDayCount , (*当天白班各类NG数量ARRAY[1..30 ]*)
	TodayNGClass_PM:= Production.NgPerHourNightCount,(*当天夜班各类NG数量ARRAY[1..30 ]*)
	TodayRun_AM:= Production.DayRunTimeTotal,(*当天白班总运行时间合计/分*)
	TodayRun_PM:= Production.NightRunTimeTotal,(*当天夜班总运行时间合计/分*)
	TodayWait_AM:=Production.DayWaitTimeTotal , (*当天白班总待料时间合计/分*)
	TodayWait_PM:=Production.NightWaitTimeTotal , (*当天夜班总待料时间合计/分*)
	TodayAlarm_AM:=Production.DayAlarmTimeTotal ,(*当天白班总报警时间合计/分*)
	TodayAlarm_PM:=Production.NightAlarmTimeTotal, (*当天夜班总报警时间合计/分*)
	
	TodayRun_AMH:=Production.DayRunTime_min,(*当天白班每小时运行时间合计/分*)
	TodayRun_PMH:=Production.NightRunTime_min,(*当天夜班每小时运行时间合计/分*)
	TodayWait_AMH:=Production.DayWaitTime_min,(*当天白班每小时待料时间合计/分*)
	TodayWait_PMH:=Production.NightWaitTime_min,(*当天夜班每小时待料时间合计/分*)
	TodayAlarm_AMH:=Production.DayAlmTime_min,(*当天白班每小时报警时间合计/分*)
	TodayAlarm_PMH:=Production.NightAlmTime_min,(*当天夜班每小时报警时间合计/分*)
	
	HistoryRun_AMH:=Production.HisDayRunTime_min,(*历史每天白班每小时运行时间合计ARRAY[1..7 ]*)
	HistoryRun_PMH:=Production.HisNightRunTime_min,(*历史每天夜班每小时运行时间合计ARRAY[1..7 ]*)
	HistoryWait_AMH:=Production.HisDayWaitTime_min,(*历史每天白班每小时待料时间合计ARRAY[1..7 ]*)
	HistoryWait_PMH:=Production.HisNightWaitTime_min,(*历史每天夜班每小时待料时间合计ARRAY[1..7 ]*)
	HistoryAlarm_AMH:=Production.HisDayAlmTime_min,(*历史每天白班每小时报警时间合计ARRAY[1..7 ]*)
	HistoryAlarm_PMH:=Production.HisNightAlmTime_min,(*历史每天夜班每小时报警时间合计ARRAY[1..7 ]*)
	
	RunCnt_AM:=Production.nDayRunTimeCnt , (*白班运行时间计数*)
	RunCnt_PM:=Production.nNightRunTimeCnt ,(*夜班运行时间计数*)
	WaitCnt_AM:= Production.nDayWaitTimeCnt, (*白班待料时间计数*)
	WaitCnt_PM:=Production.nNightWaitTimeCnt ,(*夜班待料时间计数*)
	AlarmCnt_AM:=Production.nDayAlarmTimeCnt , (*白班报警时间计数*)
	AlarmCnt_PM:= Production.nNightAlarmTimeCnt,(*夜班报警时间计数*)
	
	HistoryTotal:=Production.HMI_HistoryTotal ,(*历史每天24H生产总数ARRAY[1..7 ]*)
	HistoryOK:=Production.HMI_HistoryOK ,(*历史每天24H生产OK总数ARRAY[1..7 ]*)
	HistoryNG:=Production.HMI_HistoryNG , (*历史每天24H生产NG总数ARRAY[1..7 ]*)
	HistoryTotal_AM:=Production.DayCountTotalHistory ,(*历史每天白班生产总数ARRAY[1..7 ]*)
	HistoryTotal_PM:=Production.NightCountTotalHistory ,(*历史每天夜班生产总数ARRAY[1..7 ]*)
	HistoryRate_AM:=Production.HMI_DayQualifiedHistory , (*历史每天白班良率ARRAY[1..7 ]*)
	HistoryRate_PM:=Production.HMI_NightQualifiedHistory,(*历史每天夜班良率ARRAY[1..7 ]*)
	HistoryOK_AM:=Production.HMI_DayOkCountHistory , (*历史每天白班生产OK总数ARRAY[1..7 ]*)
	HistoryOK_PM:=Production.HMI_NightOkCountHistory , (*历史每天夜班生产OK总数ARRAY[1..7 ]*)
	HistoryNG_AM:=Production.HMI_DayNgCountHistory ,(*历史每天白班生产NG总数ARRAY[1..7 ]*)
	HistoryNG_PM:= Production.HMI_NightNgCountHistory,(*历史每天夜班生产NG总数ARRAY[1..7 ]*)
	HistoryHour_AM:=Production.HourTimeDayCountHistory ,(*历史每天白班每小时产量ARRAY[1..7,8..19 ]*)
	HistoryHour_PM:=Production.HourTimeNightCountHistory ,(*历史每天夜班每小时产量ARRAY[1..7,0..23]*)
	HistoryNGClass_AM:= Production.NgPerHourDayCountHistory,(*历史每天白班各类NG数量ARRAY[1..7,1..30 ]*)
	HistoryNGClass_PM:= Production.NgPerHourNightCountHistory,(*历史每天夜班各类NG数量ARRAY[1..7,1..30 ]*)
	HistoryRun_AM:=Production.DayRunTimeTotalHistory , (*历史每天白班总运行时间合计ARRAY[1..7 ]*)
	HistoryRun_PM:= Production.NightRunTimeTotalHistory, (*历史每天夜班总运行时间合计ARRAY[1..7 ]*)
	HistoryWait_AM:= Production.DayWaitTimeTotalHistory,(*历史每天白班总待料时间合计ARRAY[1..7 ]*)
	HistoryWait_PM:= Production.NightWaitTimeTotalHistory, (*历史每天夜班总待料时间合计ARRAY[1..7 ]*)
	HistoryAlarm_AM:= Production.DayAlarmTimeTotalHistory,(*历史每天白班总报警时间合计ARRAY[1..7 ]*)
	HistoryAlarm_PM:= Production.NightAlarmTimeTotalHistory,(*历史每天夜班总报警时间合计ARRAY[1..7 ]*)

	TodayNgHour_Day:=Production.HMINgClassCount_Day,(*白班每种NG类型每小时统计 ,,,NG类型，小时*)
	TodayNgHour_Night:=Production.HMINgClassCount_Night,(*夜班每种NG类型每小时统计 ,,,NG类型，小时*)
	HisTodayNgHour_Day:=Production.HisHMINgClassCount_Day,//l历史白班每小时NG类型统计,,
	HisTodayNgHour_Night:=Production.HisHMINgClassCount_Night,//历史夜班每小时NG类型统计,,
		
	TodayNGQualified:=Production.HMI_TodayNGQualified,//当天白班各种NG类型NG率
	NightNGQualified:=Production.HMI_NightNGQualified,//当天夜班各种NG类型NG率	
	HisTodayNGQualified:=Production.HMI_HisTodayNGQualified,//历史白班各种NG类型NG率
	HisNightNGQualified:=Production.HMI_HisNightNGQualified,//历史夜班各种NG类型NG率
	
	);

	
	
	
]]></ST>
      </Implementation>
    </Action>
