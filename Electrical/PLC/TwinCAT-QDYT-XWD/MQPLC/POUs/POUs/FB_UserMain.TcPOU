	fReadDriverPos2: REAL;//读取极耳下降沿主驱凸轮表位置
	fTabWidth: REAL;//极耳标准宽
	fCalueTabWidth: REAL;//计算极耳宽度
	fDriverStanderBasePos: REAL;//极耳下降沿基准主驱凸轮位置
	fTabOffset: REAL; 
	bDriverStanderBasePosEN: BOOL;  //极耳大范围调整屏蔽
	bFlgTabPosOver: BOOL;//极耳位置超限标志  给Auto4用
	fDriverOffset: REAL;  //极耳位置偏移量  给Auto4用
	fbReadTabCamSlavePos :Tc2_MC2_Camming.MC_ReadCamTableSlaveDynamics;////
	
	
	iCount100: DINT;
	iCount101: DINT;
	
	iTabWidth_JS: INT;

	iStopCount2: DINT;
	iStopCount3: INT;
	iStopCount4: INT;
	UnWind_L: INT;
	
	bLineScanResult1_UP: BOOL;
	bLineScanResult2_UP: BOOL;
	bLineScanResult1_Down: BOOL;
	bLineScanResult2_Down: BOOL;
	rLineScanOK_UP: R_TRIG;
	rLineScanNG_UP: R_TRIG;
	rLineScanOK_Down: R_TRIG;
	rLineScanNG_Down: R_TRIG;
	r1aser:ARRAY[0..7] OF R_TRIG;
	
	 fDA1: REAL;
	fDA2: REAL;
	bFlgLineScanOver: BOOL;
	rLineScan_UPTCP: R_TRIG;
	rLineScan_DownTCP: R_TRIG;
	
				//4连黄标尾料检测  SJ
		rtTabSenser2: R_TRIG;
		ftTabSenser2: F_TRIG;
    	iEndYellowMackStep: INT;	
		arrbRecordPos:  ARRAY[1..4] OF   BOOL;  //记录黄标下降沿标志
	 	fbReadTabCamSlavePos2 :Tc2_MC2_Camming.MC_ReadCamTableSlaveDynamics;////
		arrfVirMainSenserPos:       ARRAY[1..4] OF  LREAL;  //黄标下降沿主虚轴位置
	    K2: INT;
	    fD12:    REAL;   //黄标1与黄标2 的间距
	    fD23:    REAL;  //  //黄标2与黄标3的间距
	    fD34:    REAL;    //黄标3与黄标4的间距
		
	
	  bYellowMackAlarm: BOOL;
	
	
	
	aYellowPosTemp1: LREAL;
	bYellowPosTemp1: BOOL;
	aYellowPosTemp2: LREAL;
	bYellowPosTemp2: BOOL;

	bAnLaser:BOOL;
	bCaLaser:BOOL;

	fSumDriverOffsetData: REAL;
	fArvDriverOffsetData: REAL;
	bMA1: BOOL;
	fTab_OffsetC: REAL;
	
	
	iFlgCompCount: INT;
	iCompCount: INT;
	iRTransCompCount: INT:=1;//R角横深补偿次数
	arrOffset :ARRAY[0..20] OF REAL;	
	i30: INT;
	iCount20: DINT;
	fSumTransverData: REAL;//R角横深求和
	fArvTransverData: REAL;//R角横深平均值
	iNGState:INT;//踢废状态
	bFourYellowFlg:BOOL;	
	bYellowPosTemp3: BOOL;
	bYellowPosTemp4: BOOL;
	bYellowPosTemp5: BOOL;
	bYellowPosTemp6: BOOL;
	fBelt1Pos:ARRAY [0..10] OF LREAL;
	fBelt2Pos:ARRAY [0..10] OF LREAL;
	fBelt3Pos:ARRAY [0..10] OF LREAL;
	
	fSumTransverData2: REAL;//R角纵深求和
	fArvTransverData2: REAL;//R角纵深平均值
	iRTransCompCount2: INT:=1;//R角横深补偿次数
	fRSizeBase  :REAL;
	 K3: INT;
	bComMode: BOOL;
	
	K4: INT;
	
	tonBtn: ARRAY [1..10] OF TON;
	
	arrModPos: ARRAY[1..500] OF STRING(50);
	K10: INT:=1;		

	bMA10: BOOL;
	bTapeMark: BOOL;//接带标志
	aTapepos2: LREAL;//接带后
	bSubBelt1Alarm1: BOOL;
	bSubBelt1Alarm2: BOOL;
	bSubBelt2Moving1 : BOOL;
	bSubBelt2Moving2 : BOOL;
	bSubBelt3Moving1 : BOOL;
	bSubBelt3Moving2 : BOOL;
    iRuningFlg: INT;
	
END_VAR
VAR PERSISTENT
		fDriverDDRActPos:REAL;//主驱动当前位置(mm)	
		
		fLugActPos: REAL;//极耳位置记录
		bLugActPosMark_r:BOOL;//上升沿极耳位置已记录标志位
		bLugActPosMark_f:BOOL;//下降沿极耳位置已记录标志位
		bYellowActPosMark:BOOL;//黄标位置已记录标志位
		fYellowMarkActPos: REAL;//黄标位置记录
		bYellowMark:ARRAY[1..50] OF BOOL;//极片黄标标志-----切刀到黄标感应器直接极片个数
		aFB_ProductionDataLocal:FB_ProductionDataLocal;
		pRollWind:POINTER TO AXIS_REF;//放卷轴指针
		
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE stSysState.iMode OF
0:
     F09INIT();
   
1://自动
   F0500MainAuto();
   F0501MainAuto1();
   F0502MainAuto2();
   F0503MainAuto3();
   F0504MainAuto4();
   F0505MainAuto5();
   F0506MainAuto6();
3://手动
   F00Home();
   F01MotionManual();
   F02CylinderManual();
   F09INIT();
   F13ClearBelt();
4://停止
;
END_CASE
F10GearCall();
F11CamCall();
F12TensionCall();
F03FunctionTen();
F04FunctionCam();
F05Rectifydev();
F07Condition();
F0511CCDAuto();
F0512CarryAuto();
F0599AutoAux();
Alarm();
Product();




]]></ST>
    </Implementation>
    <Folder Name="F05Auto" Id="{210754a1-66db-40ea-b245-f03d86e51ef2}" />
    <Action Name="Alarm" Id="{0dd32a61-1957-4014-a4d5-7c49efa314d3}">
      <Implementation>
        <ST><![CDATA[
/////////凸轮创建报警/////////
stAlarm.arrCreatTableAlarm[1]:=stPoleBufferCam.bCreatTableError OR stPoleBufferCam_1.bCreatTableError;//极片缓存电机创建凸轮报警
stAlarm.arrCreatTableAlarm[2]:=stDriverCam.bCreatTableError;//主驱动电机创建凸轮报警
stAlarm.arrCreatTableAlarm[3]:=stMouldCam.bCreatTableError;//模具切刀电机创建凸轮报警
stAlarm.arrCreatTableAlarm[4]:=stCuterCam.bCreatTableError;//裁切切刀电机创建凸轮报警
stAlarm.arrCreatTableAlarm[5]:=stCCDPressCam.bCreatTableError;//CCD压片升降电机创建凸轮报警
stAlarm.arrCreatTableAlarm[6]:=stVirBeltCam.bCreatTableError;//皮带虚轴电机创建凸轮报警
//stAlarm.arrCreatTableAlarm[7]:=stNGPushCam.bCreatTableError;//NG踢料电机创建凸轮报警

/////////凸轮耦合报警/////////
stAlarm.arrCamInAlarm[1]:=stPoleBufferCam.bError OR stPoleBufferCam_1.bError;//极片缓存电机凸轮耦合报警
stAlarm.arrCamInAlarm[2]:=stDriverCam.bError;//主驱动电机凸轮耦合报警
stAlarm.arrCamInAlarm[3]:=stMouldCam.bError;//模具切刀电机凸轮耦合报警
stAlarm.arrCamInAlarm[4]:=stCuterCam.bError;//裁切切刀电机凸轮耦合报警
stAlarm.arrCamInAlarm[5]:=stCCDPressCam.bError;//CCD压片升降电机凸轮耦合报警
stAlarm.arrCamInAlarm[6]:=stVirBeltCam.bError;//皮带虚轴电机凸轮耦合报警
//stAlarm.arrCamInAlarm[7]:=stNGPushCam.bError;//NG踢料电机凸轮耦合报警

/////////张力报警/////////
stAlarm.arrTenAlarm[1]:=stUwindTen.bError AND PolePar.MQ.bWindSelect;//左放卷张力报警
stAlarm.arrTenAlarm[2]:=stUwindTen.bError AND NOT PolePar.MQ.bWindSelect;//右放卷张力报警
stAlarm.arrTenAlarm[3]:=stAuxDriverTen.bError;//辅驱张力报警
stAlarm.arrTenAlarm[4];//前摆杆张力电机张力报警
/////////齿轮报警/////////
//stAlarm.arrGearAlarm[1]:=stVirDriverGear.bError;//虚拟放卷电机齿轮报警
stAlarm.arrGearAlarm[2]:=stCuterBeltGear.bError;//裁切输送皮带电机齿轮报警
stAlarm.arrGearAlarm[3]:=stNGReverseBeltGear.bError;//踢废倒装皮带电机齿轮报警
stAlarm.arrGearAlarm[4]:=stDedustBeltGear.bError;//上表面除尘皮带电机齿轮报警
stAlarm.arrGearAlarm[5]:=stDedustReverseBeltGear.bError;//下表面除尘倒装皮带电机齿轮报警
stAlarm.arrGearAlarm[6]:=stSubBelt1Gear.bError;//分段主皮带1电机齿轮报警
stAlarm.arrGearAlarm[7]:=stSubBelt2Gear.bError;//分段主皮带2电机齿轮报警
stAlarm.arrGearAlarm[8]:=stSubBelt3Gear.bError;//分段主皮带3电机齿轮报警
/////////流程报警/////////
stAlarm.arrFlowAlarm[1];//自动已占用    料盒排杆电机去工作位超时
stAlarm.arrFlowAlarm[2];	//极片放卷按钮盒急停已按下
stAlarm.arrFlowAlarm[3];	//NG料盒按钮盒急停已按下
stAlarm.arrFlowAlarm[4];	//面板急停已按下
stAlarm.arrFlowAlarm[5];	//外罩急停1处已按下
stAlarm.arrFlowAlarm[6];	//外罩急停2处已按下
stAlarm.arrFlowAlarm[7];	//外罩急停3处已按下
stAlarm.arrFlowAlarm[8];	//线扫CCD软件心跳超时
stAlarm.arrFlowAlarm[9];	//外罩门禁1已开
stAlarm.arrFlowAlarm[10];	//外罩门禁2已开
stAlarm.arrFlowAlarm[11];	//外罩门禁3已开
stAlarm.arrFlowAlarm[12];	//外罩门禁4已开
stAlarm.arrFlowAlarm[13];	//外罩门禁5已开
stAlarm.arrFlowAlarm[14];	//面阵CCD软件心跳超时
stAlarm.arrFlowAlarm[15];	//左极片料卷已用完，请停机处理！
stAlarm.arrFlowAlarm[16];	//右极片料卷已用完，请停机处理！
//stAlarm.arrFlowAlarm[17]:=SetpMotor.bError[1];	//料盒排杆电机回原超时，请查看！
stAlarm.arrFlowAlarm[18];	//放卷纠偏故障
stAlarm.arrFlowAlarm[19];	//过程纠偏故障
stAlarm.arrFlowAlarm[20];   //连续尺寸NG，请报警处理
stAlarm.arrFlowAlarm[21];   //CCD尺寸检测出无片，请查看是否堵片。
stAlarm.arrFlowAlarm[22]:=RecY.bError AND NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bMouldYRecEN;//   模具Y纠偏    报错
stAlarm.arrFlowAlarm[23];//分段皮带堵片报警
//stAlarm.arrFlowAlarm[24];//线扫NG报警
stAlarm.arrFlowAlarm[25];//上线扫超时报警
stAlarm.arrFlowAlarm[26];//在设定的时间内，正极模切NG数大于NG报警个数，检查模切异常后，复位启动。
stAlarm.arrFlowAlarm[27];//下线扫超时报警
stAlarm.arrFlowAlarm[28];	//Event 547
stAlarm.arrFlowAlarm[29];	//Event 548
stAlarm.arrFlowAlarm[30];	//模切主驱动位置错误，请手动复位。
stAlarm.arrFlowAlarm[31];	//分段皮带1取料位置异常。
stAlarm.arrFlowAlarm[32];	//分段皮带2取料位置异常。
stAlarm.arrFlowAlarm[33];	//分段皮带3取料位置异常。
stAlarm.arrFlowAlarm[34];	//Event 553
stAlarm.arrFlowAlarm[35];	//裁切切刀堵料，请人工清理后开机！！！-------------暂时屏蔽
stAlarm.arrFlowAlarm[36];	//堵料感应器异常，请检查感应器是否损坏；
stAlarm.arrFlowAlarm[37];	//NG片踢废失败报警，请检查并把NG片拿掉-------------暂时屏蔽
stAlarm.arrFlowAlarm[38];	//踢废失败感应器未检测到极片，请确认感应器是否安装正确；-------------暂时屏蔽
stAlarm.arrFlowAlarm[39];//NG料盒料满报警
stAlarm.arrFlowAlarm[40];	//极片极耳超出CCD检测范围
stAlarm.arrFlowAlarm[41];	//极片来料不良，请检查
stAlarm.arrFlowAlarm[42];	//当前料卷检测到四连标
stAlarm.arrFlowAlarm[43];	//分段皮带3料盒满料报警
stAlarm.arrFlowAlarm[44];	///NG踢废堵料报警
stAlarm.arrFlowAlarm[45];	//线扫检测连续NG多少片后，报警
stAlarm.arrFlowAlarm[46];	//Event 565
stAlarm.arrFlowAlarm[47];	//Event 566
stAlarm.arrFlowAlarm[48];	//Event 567
stAlarm.arrFlowAlarm[49];	//Event 568
stAlarm.arrFlowAlarm[50];	//Event 569

/////////提示////////
stAlarm.arrLightWarn[1];//自动已占用   冲R角CCD定位检测NG，请查看！
stAlarm.arrLightWarn[2];//自动已占用	冲R角CCD定位检测超时，请查看！		
stAlarm.arrLightWarn[3];//自动已占用    裁切CCD定位检测NG，请查看！
stAlarm.arrLightWarn[4];//自动已占用    裁切CCD定位检测超时，请查看！		
stAlarm.arrLightWarn[5];//自动已占用    尺寸CCD检测超时，请查看！
stAlarm.arrLightWarn[6];//自动已占用     模具前CCD检测计算极耳间距异常！
stAlarm.arrLightWarn[7];//自动已占用     主驱补偿量超过半个片宽，请查看！
stAlarm.arrLightWarn[8];//自动已占用     模具X补偿量超过纠偏电机行程
stAlarm.arrLightWarn[9];//自动已占用     裁切角度纠偏量超过纠偏电机行程
stAlarm.arrLightWarn[10] ;//   空
stAlarm.arrLightWarn[11] ;// 自动已占用    皮带运行出现记忆紊乱，请查看！
stBtn.NGBoxStartLight:=stAlarm.arrLightWarn[12] AND fbPulseCtrl[4].Q;// NG料盒已满
stAlarm.arrLightWarn[13];// NG料盒未到位
stAlarm.arrLightWarn[14];//左极片料卷即将用完！
stAlarm.arrLightWarn[15];//右极片料卷即将用完！
stAlarm.arrLightWarn[16];//备用
stAlarm.arrLightWarn[17];//备用
stAlarm.arrLightWarn[18];//主轴定位运算警告
stAlarm.arrLightWarn[19];//模具纠偏X轴定位运算警告
stAlarm.arrLightWarn[20];//裁切角度纠偏轴定位运算警告
stAlarm.arrLightWarn[21];//NG1轴定位运算警告
stAlarm.arrLightWarn[22];//线扫NG警告
stAlarm.arrLightWarn[23];//倒装皮带被抬起，请拿走倒装皮带的首尾两块极片
stAlarm.arrLightWarn[24];//分段皮带1有极片无极片编号提示
stAlarm.arrLightWarn[25];//分段皮带2有极片无极片编号提示
//NG料盒满料报警
IF tonAuto[23].Q THEN
	stAlarm.arrFlowAlarm[39]:=TRUE;//NG料盒料满报警
END_IF

///NG踢废堵料报警
IF tonAuto[31].Q THEN
	stAlarm.arrFlowAlarm[44]:=TRUE;//NG踢废堵料报警
END_IF

//分段皮带3料盒满料报警
IF (iPartSelect=1 AND tonAuto[28].Q) OR (iPartSelect=2 AND  tonAuto[29].Q) THEN
	stAlarm.arrFlowAlarm[43]:=TRUE;//分段皮带3料盒满料报警
END_IF

//单位时间内NG个数
IF NOT tonAuto[22].Q THEN
	tonAuto[22].IN:=TRUE;
ELSE
	IF NG_Sum>=ProductPar.iModeEN.iNGPole THEN
		stAlarm.arrFlowAlarm[26]:=TRUE;
	END_IF
	NG_Sum:=0;
	tonAuto[22].IN:=FALSE;
END_IF
IF arrCyCtrl[CYNo.NGRevBeltUpDown].Cmd.bOFF THEN
	stAlarm.arrLightWarn[23]:=TRUE;
END_IF


//分段皮带堵片报警
IF NOT ProductPar.iModeEN.bEmptyRunEN THEN
	IF iPeaceAlarmCount1>=5 OR iPeaceAlarmCount2>5 OR iPeaceAlarmCount3>5 THEN
		stAlarm.arrFlowAlarm[23]:=TRUE;//分段皮带堵片报警
		;
	END_IF
ELSE
	stAlarm.arrFlowAlarm[23]:=FALSE;//分段皮带堵片报警
END_IF

IF (BeltData[BeltNo.SubBelt1].bHavePole AND BeltData[BeltNo.SubBelt1].stPoleNo='') 
OR (BeltData[BeltNo.SubBelt1].bHavePole AND BeltData[BeltNo.SubBelt1].stPoleNo='')   THEN
	stAlarm.arrLightWarn[24]:=TRUE;//分段皮带1有极片无极片编号提示
END_IF

IF (BeltData[BeltNo.SubBelt2].bHavePole AND BeltData[BeltNo.SubBelt2].stPoleNo='') 
OR (BeltData[BeltNo.SubBelt2].bHavePole AND BeltData[BeltNo.SubBelt2].stPoleNo='')  THEN
	stAlarm.arrLightWarn[25]:=TRUE;//分段皮带2有极片无极片编号提示
	END_IF


/////////急停/门禁/光幕报警/////////

IF NOT stbtn.PoleBoxEStop THEN
	stAlarm.arrFlowAlarm[2]:=TRUE;
END_IF
IF NOT stbtn.NGBoxEStop THEN
	;//stAlarm.arrFlowAlarm[3]:=TRUE;
END_IF
IF NOT SysPart.btnEstop THEN
	stAlarm.arrFlowAlarm[4]:=TRUE;
END_IF

IF FALSE THEN
	IF NOT stbtn.EncloserEstop[1] THEN
		stAlarm.arrFlowAlarm[5]:=TRUE;
	END_IF
	IF NOT stbtn.EncloserEstop[2] THEN
		stAlarm.arrFlowAlarm[6]:=TRUE;
	END_IF
	IF NOT stbtn.EncloserEstop[3] THEN
		stAlarm.arrFlowAlarm[7]:=TRUE;
	END_IF
END_IF
IF NOT ProductPar.iModeEN.bDoorEN THEN
	IF NOT stSenser.biDoor[1] THEN	
		stAlarm.arrFlowAlarm[9]:=TRUE;
	END_IF	
	IF NOT stSenser.biDoor[2] THEN	
		stAlarm.arrFlowAlarm[10]:=TRUE;
	END_IF	
	IF NOT stSenser.biDoor[3] THEN	
		stAlarm.arrFlowAlarm[11]:=TRUE;
	END_IF	
	IF NOT stSenser.biDoor[4] THEN	
		stAlarm.arrFlowAlarm[12]:=TRUE;
	END_IF	
//	IF iPartSelect=1 THEN
		IF NOT stSenser.biDoor[5] THEN	
			stAlarm.arrFlowAlarm[13]:=TRUE;
		END_IF	
//	END_IF
END_IF


//////////////裁切后皮带堵料///////////////
IF NOT ProductPar.iModeEN.bPoleCheckEN THEN
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=CS[iPartSelect] AND 
		arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<CS[iPartSelect]+30 AND NOT  stSenser.biCutPoleHave THEN
		stAlarm.arrFlowAlarm[35]:=TRUE;//堵料报警；
		aAq1:=TRUE;
		stCuterCam.bCamInExecute:=FALSE;//裁切切刀解耦;
	END_IF
ELSE
	aAq1:=FALSE;
	stAlarm.arrFlowAlarm[35]:=FALSE;//堵料报警；
END_IF
IF aAq1 THEN
//stAlarm.arrFlowAlarm[35]:=TRUE;	
;
END_IF
IF NOT  stSenser.biSafetyCurtain_C THEN
	aAq1:=FALSE;
END_IF	

(*****************踢废工位检测有无料******************)
//踢废失败检测；
IF NOT ProductPar.iModeEN.bPoleCheckEN THEN
	IF ((arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=280 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<330) OR 
		(arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=5 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<95) )
		AND (stSenser.bKick AND NOT BeltData[BeltNo.NGBox1+3].bHavePole) THEN
		stAlarm.arrFlowAlarm[37]:=TRUE;//踢废失败报警；
		aAq2:=TRUE;
	END_IF
	IF aAq2 THEN
		stAlarm.arrFlowAlarm[37]:=TRUE;	
	END_IF
	IF  stSenser.aThrow THEN
		aAq2:=FALSE;
	END_IF	
END_IF
//感应器坏了也报警；
IF NOT ProductPar.iModeEN.bPoleCheckEN THEN
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=280 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<330
		
		AND  ( NOT stSenser.bKick AND  BeltData[BeltNo.NGBox1+3].bHavePole ) THEN
		stAlarm.arrFlowAlarm[38]:=TRUE;//踢废失败感应器坏了或安装位置错误；
	END_IF
ELSE
		stAlarm.arrFlowAlarm[38]:=FALSE;//踢废失败感应器坏了或安装位置错误；
END_IF
(*****************线扫超时踢废******************)
//线扫超时报警
IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=5 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<10AND stAlarm.arrFlowAlarm[25] OR stAlarm.arrFlowAlarm[27] THEN
	BeltData[BeltNo.NGBox1+2].iPanoramaNG:=2;
	BeltData[BeltNo.NGBox1+1].iPanoramaNG:=2;
	BeltData[BeltNo.NGBox1].iPanoramaNG:=2;
	BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo:=14;
	BeltData[BeltNo.NGBox1+1].fPoleNGSizeNo:=14;
	BeltData[BeltNo.NGBox1].fPoleNGSizeNo:=14;
	BeltData[BeltNo.NGBox1+2].stPoleNo:='';
	BeltData[BeltNo.NGBox1+1].stPoleNo:='';
	BeltData[BeltNo.NGBox1].stPoleNo:='';
	BeltData[BeltNo.NGBox1+2].iFinish:=2;
	BeltData[BeltNo.NGBox1+1].iFinish:=2;
	BeltData[BeltNo.NGBox1].iFinish:=2;
END_IF


/////////软件报警/////////
IF  NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bEmptyRunEN THEN
	IF (tonCondition[1].Q OR tonCondition[2].Q) AND NOT ProductPar.iModeEN.bLineScanCCDEN THEN
		stAlarm.arrFlowAlarm[8]:=TRUE;//线扫CCD软件心跳超时
	END_IF
	IF (tonCondition[3].Q OR tonCondition[4].Q) AND (NOT ProductPar.iModeEN.bChamferCCDEN OR NOT ProductPar.iModeEN.bCuterCCDEN OR  NOT ProductPar.iModeEN.bSizeCCDEN) THEN
		stAlarm.arrFlowAlarm[14]:=TRUE;//面阵CCD软件心跳超时
	END_IF
END_IF


/////////轴报警&警告/////////
IF NOT ProductPar.iModeEN.bEmptyRunEN THEN
	IF PolePar.MQ.bWindSelect THEN
		IF  stUwindTen.fWindDiameter<PolePar.fDiameterWarn_L AND PolePar.fDiameterWarn_L>0    AND stUwindTen.bTensionOK        THEN
			IF NOT MQ_alarm_ton[1].Q THEN
				MQ_alarm_ton[1].IN:=TRUE;
			ELSE
				stAlarm.arrLightWarn[14]:=TRUE;//左极片料卷即将用完！
			END_IF
		ELSE
				MQ_alarm_ton[1].IN:=FALSE;
		END_IF	
		IF  stUwindTen.fWindDiameter<PolePar.fDiameterAlarm_L AND PolePar.fDiameterAlarm_L>0   AND stUwindTen.bTensionOK      THEN
			IF NOT MQ_alarm_ton[2].Q THEN
				MQ_alarm_ton[2].IN:=TRUE;
			ELSE
				stAlarm.arrFlowAlarm[15]:=TRUE;//左极片料卷已用完，请停机处理！
			END_IF
		ELSE
				MQ_alarm_ton[2].IN:=FALSE;
		END_IF
	ELSE	
		IF  stUwindTen.fWindDiameter<PolePar.fDiameterWarn_R AND PolePar.fDiameterWarn_R>0  AND stUwindTen.bTensionOK  THEN
			IF NOT MQ_alarm_ton[3].Q THEN
				MQ_alarm_ton[3].IN:=TRUE;
			ELSE
				stAlarm.arrLightWarn[15]:=TRUE;//右极片料卷即将用完！
			END_IF
		ELSE
			MQ_alarm_ton[3].IN:=FALSE;
		END_IF
	
		IF  stUwindTen.fWindDiameter<PolePar.fDiameterAlarm_R AND PolePar.fDiameterAlarm_R>0  AND stUwindTen.bTensionOK THEN
			IF NOT MQ_alarm_ton[4].Q THEN
				MQ_alarm_ton[4].IN:=TRUE;
			ELSE
				stAlarm.arrFlowAlarm[16]:=TRUE;//右极片料卷已用完，请停机处理！
			END_IF
		ELSE
			MQ_alarm_ton[4].IN:=FALSE;
		END_IF	
	END_IF
END_IF
/////////纠偏报警/////////
IF arrRecCtrl[RecNo.PoleWind].Io.biAlarm THEN
	stAlarm.arrFlowAlarm[18]:=TRUE;
END_IF
IF arrRecCtrl[RecNo.PoleProcess].Io.biAlarm THEN
	stAlarm.arrFlowAlarm[19]:=TRUE;
END_IF
/////////尺寸NG报警/////////
IF iNGSize>=ProductPar.iModeEN.iNgSizeEN AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bSizeCCDEN THEN
	stAlarm.arrFlowAlarm[20]:=TRUE;
END_IF

//线扫检测连续NG多少片后，报警
IF iNGScane>=ProductPar.iModeEN.iNgScaneEN AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bLineScanCCDEN THEN
	stAlarm.arrFlowAlarm[45]:=TRUE;
END_IF
IF stAlarm.arrFlowAlarm[45] THEN
	iNGScane:=0;
END_IF


IF CCD_COM.Cuter.iFinish=3 AND CCD_COM.Chamfer.iFinish=3 THEN
	//stAlarm.arrFlowAlarm[40]:=TRUE;//极片极耳超出CCD检测范围
END_IF
//极耳超出视野,复位时启动CCD裁切定位和R角定位拍照
IF stAlarm.arrFlowAlarm[40] AND rtbtnRest.Q THEN
	CCD_IO.boChamferPhoto:=TRUE;
	CCD_IO.boCuterPhoto:=TRUE;
END_IF

/////////轴警告/////////
stAlarm.arrLightWarn[18]:=arrAxisCtrl[VirAxisNo.VirMain].Status.WarningDynamitcsPar;//主轴定位运算警告
stAlarm.arrLightWarn[19]:=arrAxisCtrl[AxisNo.MouldRectify_X].Status.WarningDynamitcsPar;//模具纠偏X轴定位运算警告
stAlarm.arrLightWarn[20]:=arrAxisCtrl[AxisNo.CuterDegRectify].Status.WarningDynamitcsPar;//裁切角度纠偏轴定位运算警告
//stAlarm.arrLightWarn[21]:=arrAxisCtrl[AxisNo.NGPush1].Status.WarningDynamitcsPar;//NG1轴定位运算警告

/////////报警提示复位/////////
IF rtbtnRest.Q THEN
	//SetpMotor.bError[1]:=FALSE;
	IF stAlarm.arrFlowAlarm[20] THEN
		iNGSize:=0;
	END_IF
	FOR i2:=1 TO 50 BY 1 DO
		IF i2<>42 THEN 
			stAlarm.arrFlowAlarm[i2]:=FALSE;
		END_IF
		stAlarm.arrLightWarn[i2]:=FALSE;
	END_FOR
    IF NOT arrAxis[NameNo.VirTimeWind].Status.ConstantVelocity THEN
	  arrAxisPar[NameNo.VirTimeWind].fVelocity_of_Velo:=100;
	  arrAxisCtrl[NameNo.VirTimeWind].Cmd.bMoveVelo:=TRUE;
	 END_IF
END_IF



(*
//分段皮带1追片报警   20240430SJ
//  bSubBelt2fratio
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=50 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<60   AND   arrAxisCtrl[AxisNo.SubBelt1].Status.Coupled  AND 
	    arrAxisCtrl[AxisNo.SubBelt1].Status.fActVelo>=1  AND  arrAxisCtrl[AxisNo.SubBelt2].Status.fActVelo<=1  AND 
		BeltData[BeltNo.SubBelt1].bHavePole  THEN
		bSubBelt1Alarm1:=TRUE;
		IF   arrAxisCtrl[AxisNo.SubBelt3].Status.fActVelo>=1 THEN
		    bSubBelt3Moving1:=TRUE;
		END_IF
	END_IF
		

//  bSubBelt2fratio
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=50 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<60   AND   arrAxisCtrl[AxisNo.SubBelt1].Status.Coupled  AND   arrAxisCtrl[AxisNo.SubBelt2].Status.Coupled AND 
	   bSubBelt1fratio  AND NOT  bSubBelt2fratio  AND  
		BeltData[BeltNo.SubBelt1].bHavePole  THEN
			bSubBelt1Alarm2:=TRUE;
		IF   arrAxisCtrl[AxisNo.SubBelt3].Status.fActVelo>=1 THEN
		    bSubBelt3Moving2:=TRUE;
		END_IF			
			
	END_IF	

*)





(*
(****************************************皮带堵料报警************************************************************)

rtVirMainCount(CLK:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=354 , Q=> );
IF rtVirMainCount.Q THEN
	iVirMainCycleCount:=iVirMainCycleCount+1;   
END_IF

IF  iVirMainCycleCount<>iVirMainCycleCountTemp1 THEN
     iVirMainCycleCountTemp1:=iVirMainCycleCount;
    iVirMainCycleCountRel:=iVirMainCycleCountRel+1; //主轴周期计数 相对
END_IF
  IF iPeaceAlarmCount1<>iPeaceAlarmCount1Temp  THEN
      iPeaceAlarmCount1Temp:=iPeaceAlarmCount1;
     iPeaceAlarmCount1Rel:=iPeaceAlarmCount1Rel+1;//2号感应极片异常计数 相对
   END_IF
  IF iPeaceAlarmCount2<>iPeaceAlarmCount2Temp  THEN
      iPeaceAlarmCount2Temp:=iPeaceAlarmCount2;
     iPeaceAlarmCount2Rel:=iPeaceAlarmCount2Rel+1;//2号感应极片异常计数 相对
   END_IF
    IF iPeaceAlarmCount3<>iPeaceAlarmCount3Temp  THEN
      iPeaceAlarmCount3Temp:=iPeaceAlarmCount3;
     iPeaceAlarmCount3Rel:=iPeaceAlarmCount3Rel+1;//2号感应极片异常计数 相对
   END_IF 
   
   IF  iVirMainCycleCountRel>=10 THEN
	iVirMainCycleCountRel:=0;
	iPeaceAlarmCount1Rel:=0;
	iPeaceAlarmCount2Rel:=0;
	iPeaceAlarmCount3Rel:=0;
END_IF
   
   
IF iVirMainCycleCountRel<=10 THEN
   IF iPeaceAlarmCount1Rel>=5 THEN   
        bBelte1PeaceAlarm:=TRUE;
   END_IF
   IF iPeaceAlarmCount2Rel>=5 THEN   
        bBelte2PeaceAlarm:=TRUE;
   END_IF
     IF iPeaceAlarmCount3Rel>=5 THEN   
        bBelte3PeaceAlarm:=TRUE;
   END_IF
   
   
END_IF


rtPeaceMoveAlarm(CLK:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=20  AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<=28 , Q=> );
	  IF rtPeaceMoveAlarm.Q    THEN
	      IF bSubBelt1fratio  AND  NOT  bSubBelt2fratio  AND    BeltData[BeltNo.SubBelt1].bHavePole  AND 
              stSubBelt1Gear.bInGear AND  stSubBelt2Gear.bInGear  AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving  THEN   //1 与2 堵料报警
              iPeaceMoveAlarm1:=iPeaceMoveAlarm1+1;
	      END_IF
		  
		   IF bSubBelt2fratio  AND  NOT  bSubBelt3fratio  AND    BeltData[BeltNo.SubBelt2].bHavePole  AND 
              stSubBelt2Gear.bInGear AND  stSubBelt3Gear.bInGear  AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving   THEN  //2与3 堵料报警
              iPeaceMoveAlarm2:=iPeaceMoveAlarm2+1;
	      END_IF

	END_IF
*)

]]></ST>
      </Implementation>
    </Action>
    <Action Name="F00Home" Id="{9fe7157e-5263-4fea-8306-1300724fdeaa}">
      <Implementation>
        <ST><![CDATA[//一键回原点
rtHome[1](CLK:=SysPart.hmiGoHome , Q=> );
tonHome[1](In:=,PT:=T#200MS);
tonHome[2](In:=,PT:=T#200MS);
tonHome[3](In:=iHomestep=130,PT:=T#200MS);
tonHome[4](In:=iHomestep=140,PT:=T#200MS);
tonHome[5](In:=iHomestep=90,PT:=T#200MS);
IF rtHome[1].Q  THEN
	iHomestep:=88;
END_IF
CASE iHomestep OF
88://检查轴使能
	SysPart.Homeing:=TRUE;
	SysPart.Homed:=FALSE;
	stUwindTen.bTenExecute:=FALSE;
	stAuxDriverTen.bTenExecute:=FALSE;
	IF NOT arrAxisCtrl[AxisNo.Mould].Status.Enabled THEN
		arrAxisCtrl[AxisNo.Mould].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.MouldRectify_X].Status.Enabled THEN
		arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bEnable:=TRUE;
	END_IF	
	IF NOT arrAxisCtrl[AxisNo.MouldRectify_Y].Status.Enabled THEN
		arrAxisCtrl[AxisNo.MouldRectify_Y].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.Cuter].Status.Enabled THEN
		arrAxisCtrl[AxisNo.Cuter].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.CuterDegRectify].Status.Enabled THEN
		arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.CuterBeltChange].Status.Enabled THEN
		arrAxisCtrl[AxisNo.CuterBeltChange].Cmd.bEnable:=TRUE;
	END_IF
(*	
	IF NOT arrAxisCtrl[AxisNo.NGPush1].Status.Enabled THEN
		arrAxisCtrl[AxisNo.NGPush1].Cmd.bEnable:=TRUE;
	END_IF

	IF NOT arrAxisCtrl[AxisNo.NGPush2].Status.Enabled THEN
		arrAxisCtrl[AxisNo.NGPush2].Cmd.bEnable:=TRUE;
	END_IF
	*)	
	IF NOT arrAxisCtrl[AxisNo.CCDPressPush].Status.Enabled THEN
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.UnWind_L].Status.Enabled THEN
		arrAxisCtrl[AxisNo.UnWind_L].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.UnWind_R].Status.Enabled THEN
		arrAxisCtrl[AxisNo.UnWind_R].Cmd.bEnable:=TRUE;
	END_IF
	(*
	IF NOT arrAxisCtrl[AxisNo.DriverAux].Status.Enabled THEN
		arrAxisCtrl[AxisNo.DriverAux].Cmd.bEnable:=TRUE;
	END_IF	
	*)
	IF NOT arrAxisCtrl[AxisNo.DriverDDR].Status.Enabled THEN
		arrAxisCtrl[AxisNo.DriverDDR].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.BuffeLine].Status.Enabled THEN
		arrAxisCtrl[AxisNo.BuffeLine].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.CuterBelt].Status.Enabled THEN
		arrAxisCtrl[AxisNo.CuterBelt].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.NGPushReverseBelt].Status.Enabled THEN
		arrAxisCtrl[AxisNo.NGPushReverseBelt].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.DedustBelt].Status.Enabled THEN
		arrAxisCtrl[AxisNo.DedustBelt].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.DedustReverseBelt].Status.Enabled THEN
		arrAxisCtrl[AxisNo.DedustReverseBelt].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.SubBelt1].Status.Enabled THEN
		arrAxisCtrl[AxisNo.SubBelt1].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.SubBelt2].Status.Enabled THEN
		arrAxisCtrl[AxisNo.SubBelt2].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.SubBelt3].Status.Enabled THEN
		arrAxisCtrl[AxisNo.SubBelt3].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[VirAxisNo.VirBelt].Status.Enabled THEN
		arrAxisCtrl[VirAxisNo.VirBelt].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[VirAxisNo.VirDriver].Status.Enabled THEN
		arrAxisCtrl[VirAxisNo.VirDriver].Cmd.bEnable:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[VirAxisNo.VirMain].Status.Enabled THEN
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bEnable:=TRUE;
	END_IF	
	iHomestep:=90;
90://停止
	IF 	tonHome[5].Q THEN
		IF arrAxisCtrl[AxisNo.Mould].Status.Enabled AND arrAxisCtrl[AxisNo.MouldRectify_X].Status.Enabled AND arrAxisCtrl[AxisNo.MouldRectify_Y].Status.Enabled AND 
			arrAxisCtrl[AxisNo.Cuter].Status.Enabled AND arrAxisCtrl[AxisNo.CuterDegRectify].Status.Enabled AND arrAxisCtrl[AxisNo.CuterBeltChange].Status.Enabled AND
			(*arrAxisCtrl[AxisNo.NGPush1].Status.Enabled AND arrAxisCtrl[AxisNo.NGPush2].Status.Enabled AND*) arrAxisCtrl[AxisNo.CCDPressPush].Status.Enabled AND
			arrAxisCtrl[AxisNo.UnWind_L].Status.Enabled AND arrAxisCtrl[AxisNo.UnWind_R].Status.Enabled (*AND arrAxisCtrl[AxisNo.DriverAux].Status.Enabled*) AND
			arrAxisCtrl[AxisNo.DriverDDR].Status.Enabled AND arrAxisCtrl[AxisNo.BuffeLine].Status.Enabled AND arrAxisCtrl[AxisNo.CuterBelt].Status.Enabled AND 
			arrAxisCtrl[AxisNo.NGPushReverseBelt].Status.Enabled AND arrAxisCtrl[AxisNo.DedustBelt].Status.Enabled AND arrAxisCtrl[AxisNo.DedustReverseBelt].Status.Enabled AND 
			arrAxisCtrl[AxisNo.SubBelt1].Status.Enabled AND arrAxisCtrl[AxisNo.SubBelt2].Status.Enabled AND arrAxisCtrl[AxisNo.SubBelt3].Status.Enabled AND
			arrAxisCtrl[VirAxisNo.VirBelt].Status.Enabled AND arrAxisCtrl[VirAxisNo.VirDriver].Status.Enabled AND arrAxisCtrl[VirAxisNo.VirMain].Status.Enabled THEN
			iHomestep:=100;
		ELSE
			SysPart.Homeing:=FALSE;
			iHomestep:=9999;
		END_IF
	END_IF
100://停止复位
	IF NOT tonHome[1].Q THEN
		arrAxisCtrl[AxisNo.Mould].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.MouldRectify_Y].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.Cuter].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.CuterBeltChange].Cmd.bStop:=FALSE;
		//arrAxisCtrl[AxisNo.NGPush1].Cmd.bStop:=FALSE;
		//arrAxisCtrl[AxisNo.NGPush2].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.UnWind_L].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.UnWind_R].Cmd.bStop:=FALSE;
		//arrAxisCtrl[AxisNo.DriverAux].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.DriverDDR].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.CuterBelt].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.NGPushReverseBelt].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.DedustBelt].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.DedustReverseBelt].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.SubBelt1].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.SubBelt2].Cmd.bStop:=FALSE;
		arrAxisCtrl[AxisNo.SubBelt3].Cmd.bStop:=FALSE;
		arrAxisCtrl[VirAxisNo.VirBelt].Cmd.bStop:=FALSE;
		arrAxisCtrl[VirAxisNo.VirDriver].Cmd.bStop:=FALSE;
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bStop:=FALSE;
		RecY.bEnable:=FALSE;
		tonHome[1].IN:=TRUE;
	ELSE
		tonHome[1].IN:=FALSE;
		iHomestep:=102;
	END_IF
102://
	arrAxisCtrl[AxisNo.Mould].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.MouldRectify_Y].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.Cuter].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.CuterBeltChange].Cmd.bStop:=TRUE;
	//arrAxisCtrl[AxisNo.NGPush1].Cmd.bStop:=TRUE;
	//arrAxisCtrl[AxisNo.NGPush2].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.UnWind_L].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.UnWind_R].Cmd.bStop:=TRUE;
	//arrAxisCtrl[AxisNo.DriverAux].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.DriverDDR].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.CuterBelt].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.NGPushReverseBelt].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.DedustBelt].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.DedustReverseBelt].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.SubBelt1].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.SubBelt2].Cmd.bStop:=TRUE;
	arrAxisCtrl[AxisNo.SubBelt3].Cmd.bStop:=TRUE;
	arrAxisCtrl[VirAxisNo.VirBelt].Cmd.bStop:=TRUE;
	arrAxisCtrl[VirAxisNo.VirDriver].Cmd.bStop:=TRUE;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bStop:=TRUE;
	iHomestep:=104;
104://检查停止是否复位
	IF NOT	arrAxisCtrl[AxisNo.Mould].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.MouldRectify_Y].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.Cuter].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.CuterBeltChange].Cmd.bStop	AND
		(*NOT	arrAxisCtrl[AxisNo.NGPush1].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.NGPush2].Cmd.bStop	AND	*)NOT	arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.UnWind_L].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.UnWind_R].Cmd.bStop	(*AND	NOT	arrAxisCtrl[AxisNo.DriverAux].Cmd.bStop*)	AND
		NOT	arrAxisCtrl[AxisNo.DriverDDR].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.CuterBelt].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.NGPushReverseBelt].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.DedustBelt].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.DedustReverseBelt].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.SubBelt1].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.SubBelt2].Cmd.bStop	AND	NOT	arrAxisCtrl[AxisNo.SubBelt3].Cmd.bStop	AND
		NOT	arrAxisCtrl[VirAxisNo.VirBelt].Cmd.bStop	AND	NOT	arrAxisCtrl[VirAxisNo.VirDriver].Cmd.bStop	AND	NOT	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bStop
	THEN
		iHomestep:=110;
	END_IF	
110://复位bHome/bSetPos
	IF NOT tonHome[2].Q THEN
		arrAxisCtrl[AxisNo.Mould].Cmd.bHome:=FALSE;
		arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bHome:=FALSE;
		arrAxisCtrl[AxisNo.MouldRectify_Y].Cmd.bHome:=FALSE;
		arrAxisCtrl[AxisNo.Cuter].Cmd.bHome:=FALSE;
		arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bHome:=FALSE;
		arrAxisCtrl[AxisNo.CuterBeltChange].Cmd.bHome:=FALSE;
		//arrAxisCtrl[AxisNo.NGPush1].Cmd.bHome:=FALSE;
		//arrAxisCtrl[AxisNo.NGPush2].Cmd.bHome:=FALSE;
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bHome:=FALSE;
		//SetpMotor.bHome:=FALSE;
		//SetpMotor.HomeDone:=FALSE;
		//SetpMotor.WorkPosDone:=FALSE;
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bSetPos:=FALSE;
		arrAxisCtrl[AxisNo.Mould].Cmd.bMoveModulo:=FALSE;
		arrAxisCtrl[AxisNo.Cuter].Cmd.bMoveModulo:=FALSE;
		//arrAxisCtrl[AxisNo.NGPush1].Cmd.bMoveAbs:=FALSE;
		//arrAxisCtrl[AxisNo.NGPush2].Cmd.bMoveModulo:=FALSE;
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bMoveModulo:=FALSE;
		//arrRecCtrl[RecNo.PoleWind].Cmd.bCentre:=FALSE;
		//arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=FALSE;
		 tonHome[2].IN:=TRUE;
	ELSE
		tonHome[2].IN:=FALSE;
		iHomestep:=120;
	END_IF
120://回原
	arrAxisCtrl[AxisNo.Mould].Cmd.bHome:=TRUE;
	arrAxisCtrl[AxisNo.Mould].Status.Homed:=FALSE;
	arrAxisCtrl[AxisNo.Cuter].Cmd.bHome:=TRUE;
	arrAxisCtrl[AxisNo.Cuter].Status.Homed:=FALSE;
	//arrAxisCtrl[AxisNo.NGPush1].Cmd.bHome:=TRUE;
	//arrAxisCtrl[AxisNo.NGPush1].Status.Homed:=FALSE;
	//arrAxisCtrl[AxisNo.NGPush2].Cmd.bHome:=TRUE;
	//arrAxisCtrl[AxisNo.NGPush2].Status.Homed:=FALSE;
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bHome:=TRUE;
	arrAxisCtrl[AxisNo.CCDPressPush].Status.Homed:=FALSE;
	//IF NOT ProductPar.iModeEN.bNG2PushEN THEN
		//SetpMotor.bHome:=TRUE;
	//END_IF
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<>0 THEN
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.fSetPos:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos-arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos+360;
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bSetPos:=TRUE;
	END_IF
	iHomestep:=130;
130://模具&裁切-纠偏&换型回原
	IF  tonHome[3].Q THEN
		IF arrAxisCtrl[AxisNo.Cuter].Status.Homed AND ABS(arrAxisCtrl[AxisNo.Cuter].Status.fSetPos)<0.1 AND arrAxisCtrl[AxisNo.Mould].Status.Homed AND ABS(arrAxisCtrl[AxisNo.Mould].Status.fSetPos)<0.1 THEN
			IF NOT arrAxisCtrl[AxisNo.MouldRectify_X].Status.Homed THEN
				arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bHome:=TRUE;
			END_IF
			IF NOT arrAxisCtrl[AxisNo.MouldRectify_Y].Status.Homed THEN
				arrAxisCtrl[AxisNo.MouldRectify_Y].Cmd.bHome:=TRUE;
			END_IF			
			IF NOT arrAxisCtrl[AxisNo.CuterBeltChange].Status.Homed THEN
				arrAxisCtrl[AxisNo.CuterBeltChange].Cmd.bHome:=TRUE;
			END_IF	
			IF NOT arrAxisCtrl[AxisNo.CuterDegRectify].Status.Homed THEN
				arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bHome:=TRUE;
			END_IF				
			IF arrAxisCtrl[AxisNo.MouldRectify_X].Status.Homed AND arrAxisCtrl[AxisNo.MouldRectify_Y].Status.Homed AND
				arrAxisCtrl[AxisNo.CuterBeltChange].Status.Homed AND arrAxisCtrl[AxisNo.CuterDegRectify].Status.Homed THEN
				iHomestep:=140;
			END_IF
		END_IF	
	END_IF
140://模具&裁切-纠偏&换型去初始位
	IF  tonHome[4].Q THEN
		IF NOT arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.arrbRealPoint[1] THEN
			arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.iGoSetPos:=1;
		END_IF
		IF NOT arrAxisCtrl[AxisNo.MouldRectify_Y].Cmd.arrbRealPoint[1] THEN
			arrAxisCtrl[AxisNo.MouldRectify_Y].Cmd.iGoSetPos:=1;
		END_IF
		IF NOT arrAxisCtrl[AxisNo.CuterBeltChange].Cmd.arrbRealPoint[1] THEN
			arrAxisCtrl[AxisNo.CuterBeltChange].Cmd.iGoSetPos:=1;
		END_IF

		IF NOT arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.arrbRealPoint[1] THEN
			arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.iGoSetPos:=1;
		END_IF
		iHomestep:=150;
	END_IF
150://判断模具纠偏换型是否到位
	IF arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxisNo.MouldRectify_Y].Cmd.arrbRealPoint[1] AND
		arrAxisCtrl[AxisNo.CuterBeltChange].Cmd.arrbRealPoint[1] AND arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.arrbRealPoint[1] THEN
		iHomestep:=160;
	END_IF
160://模具&裁切去初始位
	IF arrAxisCtrl[AxisNo.Mould].Status.Homed AND NOT arrAxisCtrl[AxisNo.Mould].Cmd.bHome AND 
		arrAxisCtrl[AxisNo.Cuter].Status.Homed AND NOT arrAxisCtrl[AxisNo.Cuter].Cmd.bHome AND 
		(*arrAxisCtrl[AxisNo.NGPush1].Status.Homed AND NOT arrAxisCtrl[AxisNo.NGPush1].Cmd.bHome AND	
		arrAxisCtrl[AxisNo.NGPush2].Status.Homed AND NOT arrAxisCtrl[AxisNo.NGPush2].Cmd.bHome AND *)
		arrAxisCtrl[AxisNo.CCDPressPush].Status.Homed AND NOT arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bHome(* AND
		(SetpMotor.HomeDone OR ProductPar.iModeEN.bNG2PushEN) *)THEN
		arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloGo[1]:=TRUE;
		arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloGo[1]:=TRUE;
		//arrAxisCtrl[AxisNo.NGPush1].Cmd.arrbModuloGo[1]:=TRUE;
		//arrAxisCtrl[AxisNo.NGPush2].Cmd.arrbModuloGo[1]:=TRUE;
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloGo[1]:=TRUE;
		IF NOT ProductPar.iModeEN.bNG2PushEN AND FALSE THEN
			;//SetpMotor.bGoWorkPos:=TRUE;
		END_IF
		iHomestep:=170;	
	END_IF
170://判断模具&裁切去初始位
	IF arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloPoint[1] AND arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloPoint[1] AND (*arrAxisCtrl[AxisNo.NGPush1].Cmd.arrbModuloPoint[1] AND
		 arrAxisCtrl[AxisNo.NGPush2].Cmd.arrbModuloPoint[1] AND*) arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloPoint[1] AND ((*SetpMotor.WorkPosDone OR*) ProductPar.iModeEN.bNG2PushEN OR TRUE) THEN
		iHomestep:=180;
	END_IF
180://判断主轴是否完成
	IF NOT arrAxisCtrl[VirAxisNo.VirMain].Cmd.bSetPos AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos=0 THEN
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.fSetPos:=0;	
		iHomestep:=190;
	END_IF	
190://气缸动作   倒吸升降/毛刷&风刀升降，初始化时不动作
	IF PolePar.MQ.bWindSelect THEN
		arrCyCtrl[CYNo.Inflation_L].Cmd.bON:=TRUE;
		arrCyCtrl[CYNo.Inflation_R].Cmd.bOFF:=TRUE;
	ELSE
		arrCyCtrl[CYNo.Inflation_L].Cmd.bOFF:=TRUE;
		arrCyCtrl[CYNo.Inflation_R].Cmd.bON:=TRUE;
	END_IF
	arrCyCtrl[CYNo.BoardPressL].Cmd.bON:=TRUE;
	arrCyCtrl[CYNo.BoardPressR].Cmd.bON:=TRUE;
	//arrCyCtrl[CYNo.DriverPressAux].Cmd.bON:=TRUE;
	//arrCyCtrl[CYNo.CoderRollPress].Cmd.bON:=TRUE;
	arrCyCtrl[CYNo.DriverPressDDR].Cmd.bON:=TRUE;//下降；
	arrCyCtrl[CYNo.NGRevBeltTension].Cmd.bON:=TRUE;
	//arrCyCtrl[CYNo.NGBoxLock1].Cmd.bOFF:=TRUE;
	//arrCyCtrl[CYNo.NGBoxLock2].Cmd.bOFF:=TRUE;	
	arrCyCtrl[CYNo.WasteBoxPush].Cmd.bOFF:=TRUE;
	iHomestep:=200;
200://气缸是否到位	
	IF arrCyCtrl[CYNo.BoardPressL].Status.ONState AND arrCyCtrl[CYNo.BoardPressR].Status.ONState AND (arrCyCtrl[CYNo.DriverPressAux].Status.ONState OR TRUE)AND
		(arrCyCtrl[CYNo.CoderRollPress].Status.ONState OR TRUE) AND arrCyCtrl[CYNo.DriverPressDDR].Status.ONState (*AND arrCyCtrl[CYNo.NGBoxLock1].Status.OFFState AND
		arrCyCtrl[CYNo.NGBoxLock2].Status.OFFState*) THEN
		iHomestep:=210;
	END_IF	
210://放卷纠偏回中	行进纠偏回中
	//arrRecCtrl[RecNo.PoleWind].Cmd.bCentre:=TRUE;
	//arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=TRUE;
	iHomestep:=220;
220://行进纠偏回中
	iHomestep:=225;
	
225://缓存回原点
	IF NOT arrAxisCtrl[AxisNo.BuffeLine].Status.Homed THEN
		arrAxisCtrl[AxisNo.BuffeLine].Cmd.bHome:=TRUE;
	END_IF				
	IF arrAxisCtrl[AxisNo.BuffeLine].Status.Homed THEN
		iHomestep:=230;
	END_IF
	
	
	
	
230://	
	SysPart.Homeing:=FALSE;
	SysPart.Homed:=TRUE;
	Syspart.hmiGoHome:=FALSE;
	iHomestep:=666;		
END_CASE
]]></ST>
      </Implementation>
    </Action>
    <Action Name="F01MotionManual" Id="{899cecb5-0461-4078-9f42-e4d36a44648f}">
      <Implementation>
        <ST><![CDATA[//编码开关
fbRotateSwitchCode(Code1:=stBtn.PoleBoxBit1 ,Code2:=stBtn.PoleBoxBit2 ,Code3:=stBtn.PoleBoxBit3,Code4:=stBtn.PoleBoxBit4 , iCodeOut=> );
rtPoleBtn(CLK:=stBtn.PoleBoxStart , Q=> );
ftPoleBtn(CLK:=stBtn.PoleBoxStart , Q=> );
stBtn.iPoleBoxCode:=fbRotateSwitchCode.iCodeOut;
CASE fbRotateSwitchCode.iCodeOut OF
5://左放卷电机 正转
	IF rtPoleBtn.Q THEN
		arrAxisCtrl[AxisNo.UnWind_L].Cmd.bJog_Fw:=TRUE;
	END_IF
	IF ftPoleBtn.Q THEN
		arrAxisCtrl[AxisNo.UnWind_L].Cmd.bJog_Fw:=FALSE;
	END_IF
	stBtn.PoleBoxStartLight:=arrAxisCtrl[AxisNo.UnWind_L].Cmd.bJog_Fw;
4://左放卷电机 反转	
	IF rtPoleBtn.Q THEN	
		arrAxisCtrl[AxisNo.UnWind_L].Cmd.bJog_Bw:=TRUE;
	END_IF	
	IF ftPoleBtn.Q THEN	
		arrAxisCtrl[AxisNo.UnWind_L].Cmd.bJog_Bw:=FALSE;
	END_IF	
	stBtn.PoleBoxStartLight:=arrAxisCtrl[AxisNo.UnWind_L].Cmd.bJog_Bw;
9://右放卷电机 正转	
	IF rtPoleBtn.Q THEN	
		arrAxisCtrl[AxisNo.UnWind_R].Cmd.bJog_Fw:=TRUE;
	END_IF	
	IF ftPoleBtn.Q THEN	
		arrAxisCtrl[AxisNo.UnWind_R].Cmd.bJog_Fw:=FALSE;
	END_IF	
	stBtn.PoleBoxStartLight:=arrAxisCtrl[AxisNo.UnWind_R].Cmd.bJog_Fw;
2://右放卷电机 反转	
	IF rtPoleBtn.Q THEN	
		arrAxisCtrl[AxisNo.UnWind_R].Cmd.bJog_Bw:=TRUE;
	END_IF	
	IF ftPoleBtn.Q THEN	
		arrAxisCtrl[AxisNo.UnWind_R].Cmd.bJog_Bw:=FALSE;
	END_IF	
	stBtn.PoleBoxStartLight:=arrAxisCtrl[AxisNo.UnWind_R].Cmd.bJog_Bw;
END_CASE	

(*
//辅驱 正转
rtMotionBtn[5](CLK:=stBtn.DriverJogFw_Aux , Q=> );	
ftMotionBtn[5](CLK:=stBtn.DriverJogFw_Aux , Q=> );
IF rtMotionBtn[5].Q THEN	
	arrAxisCtrl[AxisNo.DriverAux].Cmd.bJog_Fw:=TRUE;
END_IF	
IF ftMotionBtn[5].Q THEN	
	arrAxisCtrl[AxisNo.DriverAux].Cmd.bJog_Fw:=FALSE;
END_IF	

//辅驱 反转
rtMotionBtn[6](CLK:=stBtn.DriverJogBw_Aux , Q=> );	
ftMotionBtn[6](CLK:=stBtn.DriverJogBw_Aux , Q=> );
IF rtMotionBtn[6].Q THEN	
	arrAxisCtrl[AxisNo.DriverAux].Cmd.bJog_Bw:=TRUE;
END_IF	
IF ftMotionBtn[6].Q THEN	
	arrAxisCtrl[AxisNo.DriverAux].Cmd.bJog_Bw:=FALSE;
END_IF	

//NG排杆电机上升
rtMotionBtn[1](CLK:=stBtn.NGBoxMotor_JogUp , Q=> );	
ftMotionBtn[1](CLK:=stBtn.NGBoxMotor_JogUp , Q=> );
IF rtMotionBtn[1].Q THEN	
	SetpMotor.bJog_Up:=TRUE;
END_IF	
IF ftMotionBtn[1].Q THEN	
	SetpMotor.bJog_Up:=FALSE;
END_IF
stBtn.NGBoxMotor_JogUpLight:=SetpMotor.bJog_Up;

//NG排杆电机下降
rtMotionBtn[2](CLK:=stBtn.NGBoxMotor_JogDown , Q=> );	
ftMotionBtn[2](CLK:=stBtn.NGBoxMotor_JogDown , Q=> );
IF rtMotionBtn[2].Q THEN	
	SetpMotor.bJog_Down:=TRUE;
END_IF	
IF ftMotionBtn[2].Q THEN	
	SetpMotor.bJog_Down:=FALSE;
END_IF
stBtn.NGBoxMotor_JogDownLight:=SetpMotor.bJog_Down;
*)
IF arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloPoint[1] 
AND arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloPoint[1] 
AND arrCyCtrl[CYNo.BoardPressL].Io.DOStatus1 
AND arrCyCtrl[CYNo.BoardPressR].Io.DOStatus1 
AND arrCyCtrl[CYNo.DriverPressDDR].Io.DOStatus1 THEN
arrAxisCtrl[AxisNo.DriverDDR].Cmd.JogN_Condition:=TRUE;
arrAxisCtrl[AxisNo.DriverDDR].Cmd.JogP_Condition:=TRUE;
ELSE
arrAxisCtrl[AxisNo.DriverDDR].Cmd.JogN_Condition:=FALSE;
arrAxisCtrl[AxisNo.DriverDDR].Cmd.JogP_Condition:=FALSE;	
END_IF

///////////////////////////////////////////////////////////驱一片////////////////////////////////////////////////////////////////////
//驱一片
 rtMQDriverOnce(CLK:=SysPart.hmiMQDriverOnce    , Q=> );
	IF  rtMQDriverOnce.Q AND arrAxisCtrl[AxisNo.DriverDDR].Status.NoMoving AND iTensionStep=666 AND arrCyCtrl[CYNo.DriverPressDDR] .Status.ONState    THEN                              
        iMQDriverOnceSetp1:=10;
    END_IF


rtEarCheck1(CLK:=stSenser.biTabHave , Q=> );
CASE  iMQDriverOnceSetp1 OF 
10://模切解耦 
    bMethodCamDisEnable:=TRUE;
	
   arrAxisCtrl[AxisNo.Cuter].Cmd.bMoveModulo:=FALSE;
   arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveRel:=FALSE;
    iMQDriverOnceSetp1:=20;
	
20://
  IF NOT    bMethodCamDisEnable   AND    NOT  arrAxisCtrl[AxisNo.DriverDDR].Status.Coupled  AND   NOT  arrAxisCtrl[AxisNo.Cuter].Status.Coupled   THEN
         IF  ABS(arrAxisCtrl[AxisNo.Cuter].Status.fModuloActPos-arrAxisPar[AxisNo.Cuter].arrTargetPoint[1])<=1    THEN    
             ;
         ELSE
			  arrAxisCtrl[AxisNo.Cuter].Cmd.fPositon_of_Mod:=arrAxisPar[AxisNo.Cuter].arrTargetPoint[1];
			  arrAxisPar[AxisNo.Cuter].fVelocity_of_Mod:=60;
			  arrAxisCtrl[AxisNo.Cuter].Cmd.bMoveModulo:=TRUE;
         END_IF
         iMQDriverOnceSetp1:=25;
  END_IF
25://
    IF     ABS(arrAxisCtrl[AxisNo.Cuter].Status.fModuloActPos-arrAxisPar[AxisNo.Cuter].arrTargetPoint[1])<=1   THEN  
           iMQDriverOnceSetp1:=40;
    END_IF

40:
   IF  NOT  PolePar.bEarCheckMode THEN  //定切
		  arrAxisCtrl[AxisNo.DriverDDR].Cmd.fPosition_of_Rel:=FC_LengthToAngle( PolePar.fPoleWidth,PolePar.Machine.fMQDriverDiameter);
		  arrAxisPar[AxisNo.DriverDDR].fVelocity_of_Rel:=30;
		  arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveRel:=TRUE;
		  iMQDriverOnceSetp1:=666;
  ELSE    //极耳裁切
		  arrAxisCtrl[AxisNo.DriverDDR].Cmd.fPositon_of_Abs:= arrAxis[AxisNo.DriverDDR].NcToPlc.ActPos+ FC_LengthToAngle(PolePar.fPoleWidth*2,PolePar.Machine.fMQDriverDiameter); //最多走2个偏宽   没检测到极耳则报警
		  arrAxisPar[AxisNo.DriverDDR].fVelocity_of_Abs:=30;
		  arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveAbs:=TRUE;
		  iMQDriverOnceSetp1:=50;
 END_IF
50:
   IF  arrAxisCtrl[AxisNo.DriverDDR].Status.fActVelo>=2 THEN
         arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveAbs:=FALSE;
          iMQDriverOnceSetp1:=55;
   END_IF

55://  parProduct
   IF rtEarCheck1.Q THEN
  	   arrAxisCtrl[AxisNo.DriverDDR].Cmd.fPosition_of_Rel:=FC_LengthToAngle( PolePar.fEarCheckLength ,PolePar.Machine.fMQDriverDiameter); //最多走2个偏宽   没检测到极耳则报警
	   arrAxisPar[AxisNo.DriverDDR].fVelocity_of_Rel:=3060;
	   arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveRel:=TRUE;    
         iMQDriverOnceSetp1:=667;
  END_IF

END_CASE


//切一片  
 rtMQCutOnce(CLK:=SysPart.hmiMQCutOnce    , Q=> );
	IF   rtMQCutOnce.Q   AND  arrAxisCtrl[AxisNo.Cuter].Status.NoMoving     THEN
          iP1MQCutOnce:=10;
    END_IF

CASE  iP1MQCutOnce OF 
10://模切解耦 
    bMethodCamDisEnable:=TRUE;
	
   arrAxisCtrl[AxisNo.Cuter].Cmd.bMoveModulo:=FALSE;
   arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveRel:=FALSE;
    iP1MQCutOnce:=20;
20://判断当前位置
    IF NOT    bMethodCamDisEnable   AND    NOT  arrAxisCtrl[AxisNo.DriverDDR].Status.Coupled  AND   NOT  arrAxisCtrl[AxisNo.Cuter].Status.Coupled   THEN
         IF ABS(arrAxisCtrl[AxisNo.Cuter].Status.fModuloActPos-arrAxisPar[AxisNo.Cuter].arrTargetPoint[1])<=1   THEN    
              iP1MQCutOnce:=30;
         ELSE
			  arrAxisCtrl[AxisNo.Cuter].Cmd.fPositon_of_Mod:=arrAxisPar[AxisNo.Cuter].arrTargetPoint[1];
			  arrAxisPar[AxisNo.Cuter].fVelocity_of_Mod:=60;
			  arrAxisCtrl[AxisNo.Cuter].Cmd.bMoveModulo:=TRUE;
			   iP1MQCutOnce:=25;
         END_IF
    END_IF
25://判断当前位置
  IF  ABS(arrAxisCtrl[AxisNo.Cuter].Status.fModuloActPos-arrAxisPar[AxisNo.Cuter].arrTargetPoint[1])<=1 THEN    
              iP1MQCutOnce:=30;
   END_IF

30://走相对360
    arrAxisCtrl[AxisNo.Cuter].Cmd.fPosition_of_Rel:=360;
    arrAxisPar[AxisNo.Cuter].fVelocity_of_Rel:=60;
    arrAxisCtrl[AxisNo.Cuter].Cmd.bMoveRel:=TRUE;
     iP1MQCutOnce:=666;
END_CASE


















///////////////////////////////////////////////////////////相机手动拍照////////////////////////////////////////////////////////////////////
IF CCD_IO.hmiChamferPhoto THEN
	CCD_IO.boChamferPhoto:=TRUE;
ELSE
	CCD_IO.boChamferPhoto:=FALSE;
END_IF
IF CCD_IO.hmiCuterPhoto THEN
	CCD_IO.boCuterPhoto:=TRUE;
ELSE
	CCD_IO.boCuterPhoto:=FALSE;
END_IF
IF CCD_IO.hmiSizePhoto THEN
	CCD_IO.boSizePhoto:=TRUE;
ELSE
	CCD_IO.boSizePhoto:=FALSE;
END_IF	



         ]]></ST>
      </Implementation>
    </Action>
    <Action Name="F02CylinderManual" Id="{051cf36c-698c-410d-b744-a8fb64c5fc87}">
      <Implementation>
        <ST><![CDATA[

CASE fbRotateSwitchCode.iCodeOut OF
0://接带平台抽真空吸尘
IF rtPoleBtn.Q THEN
	IF arrCyCtrl[EVNo.ConnectDustVacuo].Io.DOStatus1 THEN
		arrCyCtrl[EVNo.ConnectDustVacuo].Cmd.bOFF:=TRUE;
	ELSIF arrCyCtrl[EVNo.ConnectDustVacuo].Io.DOStatus2 THEN
		arrCyCtrl[EVNo.ConnectDustVacuo].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[EVNo.ConnectDustVacuo].Cmd.bON:=TRUE;
	END_IF
END_IF;
stBtn.PoleBoxStartLight:=arrCyCtrl[EVNo.ConnectDustVacuo].Io.DOStatus1;
11://左放卷气涨轴
IF rtPoleBtn.Q THEN
	IF arrCyCtrl[CYNo.Inflation_L].Io.DOStatus1 THEN
		arrCyCtrl[CYNo.Inflation_L].Cmd.bOFF:=TRUE;
	ELSIF arrCyCtrl[CYNo.Inflation_L].Io.DOStatus2 THEN
		arrCyCtrl[CYNo.Inflation_L].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.Inflation_L].Cmd.bON:=TRUE;
	END_IF
END_IF;
stBtn.PoleBoxStartLight:=arrCyCtrl[CYNo.Inflation_L].Io.DOStatus1;
3://右放卷气涨轴
IF rtPoleBtn.Q THEN
	IF arrCyCtrl[CYNo.Inflation_R].Io.DOStatus1 THEN
		arrCyCtrl[CYNo.Inflation_R].Cmd.bOFF:=TRUE;
	ELSIF arrCyCtrl[CYNo.Inflation_R].Io.DOStatus2 THEN
		arrCyCtrl[CYNo.Inflation_R].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.Inflation_R].Cmd.bON:=TRUE;
	END_IF
END_IF;
stBtn.PoleBoxStartLight:=arrCyCtrl[CYNo.Inflation_R].Io.DOStatus1;
13://接带平台左压板气缸
IF rtPoleBtn.Q THEN
	IF arrCyCtrl[CYNo.BoardPressL].Io.DOStatus1 THEN
		arrCyCtrl[CYNo.BoardPressL].Cmd.bOFF:=TRUE;
	ELSIF arrCyCtrl[CYNo.BoardPressL].Io.DOStatus2 THEN
		arrCyCtrl[CYNo.BoardPressL].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.BoardPressL].Cmd.bON:=TRUE;
	END_IF
END_IF;
stBtn.PoleBoxStartLight:=arrCyCtrl[CYNo.BoardPressL].Io.DOStatus1;
1://接带平台右压板气缸
IF rtPoleBtn.Q THEN
	IF arrCyCtrl[CYNo.BoardPressR].Io.DOStatus1 THEN
		arrCyCtrl[CYNo.BoardPressR].Cmd.bOFF:=TRUE;
	ELSIF arrCyCtrl[CYNo.BoardPressR].Io.DOStatus2 THEN
		arrCyCtrl[CYNo.BoardPressR].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.BoardPressR].Cmd.bON:=TRUE;
	END_IF
END_IF;
stBtn.PoleBoxStartLight:=arrCyCtrl[CYNo.BoardPressR].Io.DOStatus1;
12://放卷纠偏回中
IF rtPoleBtn.Q THEN
	arrRecCtrl[RecNo.PoleWind].Cmd.bCentre:=TRUE;
END_IF
IF ftPoleBtn.Q THEN
	arrRecCtrl[RecNo.PoleWind].Cmd.bCentre:=FALSE;
END_IF
stBtn.PoleBoxStartLight:=arrRecCtrl[RecNo.PoleWind].Cmd.bCentre;
8://行进纠偏回中
IF rtPoleBtn.Q THEN
	arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=TRUE;
END_IF
IF ftPoleBtn.Q THEN
	arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=FALSE;
END_IF
stBtn.PoleBoxStartLight:=arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre;
END_CASE	

//辅驱压辊
rtCyBtn[7](CLK:=stBtn.DriverPress_Aux, Q=> );
ftCyBtn[7](CLK:=stBtn.DriverPress_Aux, Q=> );
IF rtCyBtn[7].Q THEN
	arrCyCtrl[CYNo.DriverPressAux].Cmd.bON:=TRUE;		
END_IF
IF ftCyBtn[7].Q THEN
	arrCyCtrl[CYNo.DriverPressAux].Cmd.bOff:=TRUE;		
END_IF

//主驱压辊
rtCyBtn[8](CLK:=stBtn.DriverPressDDR, Q=> );
IF rtCyBtn[8].Q THEN
	IF arrCyCtrl[CYNo.DriverPressDDR].IO.DOStatus1 THEN
		arrCyCtrl[CYNo.DriverPressDDR].Cmd.bOFF:=TRUE;			
	ELSIF arrCyCtrl[CYNo.DriverPressDDR].IO.DOStatus2 THEN
		arrCyCtrl[CYNo.DriverPressDDR].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.DriverPressDDR].Cmd.bON:=TRUE;
	END_IF			
END_IF
stBtn.DriverPressDDRLight:=arrCyCtrl[CYNo.DriverPressDDR].IO.DOStatus1;

tonBtn[1](In:=stBtn.PoleBrushDustPush_U,PT:=T#1S);//上表面除尘毛刷升降气缸延时
tonBtn[2](In:=stBtn.PoleWindDustPush_U,PT:=T#1S);//上表面除尘风刀升降气缸延时
tonBtn[3](In:=stBtn.PoleBrushDustPush_D,PT:=T#1S);//下表面除尘毛刷升降气缸延时
tonBtn[4](In:=stBtn.PoleWindDustPush_D,PT:=T#1S);//下表面除尘风刀升降气缸延时

//上表面除尘毛刷升降气缸
rtCyBtn[1](CLK:=tonBtn[1].Q, Q=> );
IF rtCyBtn[1].Q THEN
	IF arrCyCtrl[CYNo.PoleBrushDustPush_U].IO.DOStatus1 THEN
		arrCyCtrl[CYNo.PoleBrushDustPush_U].Cmd.bOFF:=TRUE;			
	ELSIF arrCyCtrl[CYNo.PoleBrushDustPush_U].IO.DOStatus2 THEN
		arrCyCtrl[CYNo.PoleBrushDustPush_U].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.PoleBrushDustPush_U].Cmd.bON:=TRUE;
	END_IF			
END_IF
stBtn.PoleBrushDustPush_ULight:=arrCyCtrl[CYNo.PoleBrushDustPush_U].IO.DOStatus1;

//上表面除尘风刀升降气缸
rtCyBtn[2](CLK:=tonBtn[2].Q, Q=> );
IF rtCyBtn[2].Q THEN
	IF arrCyCtrl[CYNo.PoleWindDustPush_U].IO.DOStatus1 THEN
		arrCyCtrl[CYNo.PoleWindDustPush_U].Cmd.bOFF:=TRUE;			
	ELSIF arrCyCtrl[CYNo.PoleWindDustPush_U].IO.DOStatus2 THEN
		arrCyCtrl[CYNo.PoleWindDustPush_U].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.PoleWindDustPush_U].Cmd.bON:=TRUE;
	END_IF			
END_IF
stBtn.PoleWindDustPush_ULight:=arrCyCtrl[CYNo.PoleWindDustPush_U].IO.DOStatus1;

//下表面除尘毛刷升降气缸
rtCyBtn[3](CLK:=tonBtn[3].Q, Q=> );
IF rtCyBtn[3].Q THEN
	IF arrCyCtrl[CYNo.PoleBrushDustPush_D].IO.DOStatus1 THEN
		arrCyCtrl[CYNo.PoleBrushDustPush_D].Cmd.bOFF:=TRUE;			
	ELSIF arrCyCtrl[CYNo.PoleBrushDustPush_D].IO.DOStatus2 THEN
		arrCyCtrl[CYNo.PoleBrushDustPush_D].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.PoleBrushDustPush_D].Cmd.bON:=TRUE;
	END_IF			
END_IF
stBtn.PoleBrushDustPush_DLight:=arrCyCtrl[CYNo.PoleBrushDustPush_D].IO.DOStatus1;

//下表面除尘风刀升降气缸
rtCyBtn[4](CLK:=tonBtn[4].Q, Q=> );
IF rtCyBtn[4].Q THEN
	IF arrCyCtrl[CYNo.PoleWindDustPush_D].IO.DOStatus1 THEN
		arrCyCtrl[CYNo.PoleWindDustPush_D].Cmd.bOFF:=TRUE;			
	ELSIF arrCyCtrl[CYNo.PoleWindDustPush_D].IO.DOStatus2 THEN
		arrCyCtrl[CYNo.PoleWindDustPush_D].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.PoleWindDustPush_D].Cmd.bON:=TRUE;
	END_IF			
END_IF
stBtn.PoleWindDustPush_DLight:=arrCyCtrl[CYNo.PoleWindDustPush_D].IO.DOStatus1;

//编码器压辊气缸
rtCyBtn[5](CLK:=stBtn.CoderRollPress, Q=> );
IF rtCyBtn[5].Q THEN
	IF arrCyCtrl[CYNo.CoderRollPress].IO.DOStatus1 THEN
		arrCyCtrl[CYNo.CoderRollPress].Cmd.bOFF:=TRUE;			
	ELSIF arrCyCtrl[CYNo.CoderRollPress].IO.DOStatus2 THEN
		arrCyCtrl[CYNo.CoderRollPress].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.CoderRollPress].Cmd.bON:=TRUE;
	END_IF			
END_IF
stBtn.CoderRollPressLight:=arrCyCtrl[CYNo.CoderRollPress].IO.DOStatus1;

//分段皮带堵片报警
IF stSysState.btnReset AND stAlarm.arrFlowAlarm[23] THEN
	iPeaceAlarmCount1:=0;
	iPeaceAlarmCount2:=0;
	iPeaceAlarmCount3:=0;
	stAlarm.arrFlowAlarm[23]:=FALSE;//分段皮带堵片报警
END_IF


//激光指示器开关控制
r1aser[0](CLK:=arrCyCtrl[NameNo.AnCYNo.Inflation_L].Io.DOStatus1, Q=> );
r1aser[1](CLK:=arrCyCtrl[NameNo.AnCYNo.Inflation_R].Io.DOStatus1, Q=> );
r1aser[2](CLK:=arrCyCtrl[NameNo.AnCYNo.Inflation_L].Io.DOStatus2, Q=> );
r1aser[3](CLK:=arrCyCtrl[NameNo.AnCYNo.Inflation_R].Io.DOStatus2, Q=> );
r1aser[4](CLK:=arrCyCtrl[NameNo.CaCYNo.Inflation_L].Io.DOStatus1, Q=> );
r1aser[5](CLK:=arrCyCtrl[NameNo.CaCYNo.Inflation_R].Io.DOStatus1, Q=> );
r1aser[6](CLK:=arrCyCtrl[NameNo.CaCYNo.Inflation_L].Io.DOStatus2, Q=> );
r1aser[7](CLK:=arrCyCtrl[NameNo.CaCYNo.Inflation_R].Io.DOStatus2, Q=> );
//////////
IF r1aser[0].Q OR r1aser[1].Q THEN//
	bAnLaser:=TRUE;
ELSIF tonAuto[24].Q THEN
	bAnLaser:=FALSE;
END_IF 

IF (tonAuto[24].Q AND arrCyCtrl[NameNo.AnCYNo.Inflation_L].Io.DOStatus1 AND arrCyCtrl[NameNo.AnCYNo.Inflation_R].Io.DOStatus1) OR rMQUse[10].Q THEN
	Q107[11]:=FALSE;
ELSIF r1aser[2].Q OR r1aser[3].Q THEN
	Q107[11]:=TRUE;
	bAnLaser:=FALSE;
END_IF 

//////////
IF r1aser[4].Q OR r1aser[5].Q THEN
	bCaLaser:=TRUE;
ELSIF tonAuto[25].Q THEN
	bCaLaser:=FALSE;
END_IF 

IF (tonAuto[25].Q AND arrCyCtrl[NameNo.CaCYNo.Inflation_L].Io.DOStatus1 AND arrCyCtrl[NameNo.CaCYNo.Inflation_R].Io.DOStatus1) OR rMQUse[10].Q THEN
	Q207[11]:=FALSE;
ELSIF r1aser[6].Q OR r1aser[7].Q THEN
	Q207[11]:=TRUE;
	bCaLaser:=FALSE;
END_IF ]]></ST>
      </Implementation>
    </Action>
    <Action Name="F03FunctionTen" Id="{0e98ed10-037e-4015-85d2-f5f1da96dc98}">
      <Implementation>
        <ST><![CDATA[//一键张力耦合
rtTension[1](CLK:=SysPart.hmiTenAll , Q=> );
rtTension[2](CLK:=bMethodTenBufferEnable , Q=> );
rtTension[3](CLK:=SysPart.hmiDisTenAll , Q=> );
rtTension[4](CLK:=bMethodTenBufferDisEnable , Q=> );
tonTension[1](In:=iTensionStep=115,PT:=T#200MS);
tonTension[2](In:=iTensionStep=230,PT:=T#200MS);
tonTension[3](In:=iTensionStep=240,PT:=T#200MS);
tonTension[4](In:=iTensionStep=250,PT:=T#200MS);	
tonTension[5](In:=iTensionStep=666,PT:=T#200MS);	
tonTension[6](In:=iTensionStep=1010,PT:=T#200MS);	
IF rtTension[2].Q OR 
	(stSysState.iMode=3  AND rtTension[1].Q AND (iTensionStep=0 OR iTensionStep=1666)) THEN
	iTensionStep:=88;//耦合触发
END_IF;
IF rtTension[4].Q OR 
	(stSysState.iMode=3  AND rtTension[3].Q )THEN
	iTensionStep:=1000;//解耦触发
END_IF;
IF tonTension[5].Q THEN
	SysPart.hmiTenAll:=FALSE;
END_IF

CASE iTensionStep OF
///////////////////////////////////////////////////////////张力耦合/////////////////////////////////////////////////////
88://张力有关气缸动作
	arrCyCtrl[CYNo.DriverPressAux].Cmd.bON:=TRUE;
	arrCyCtrl[CYNo.BoardPressL].Cmd.bON:=TRUE;
	arrCyCtrl[CYNo.BoardPressR].Cmd.bON:=TRUE;
//	arrCyCtrl[CYNo.CoderRollPress].Cmd.bON:=TRUE;
	arrCyCtrl[CYNo.DriverPressDDR].Cmd.bON:=TRUE;
	IF PolePar.MQ.bWindSelect THEN
		arrCyCtrl[CYNo.Inflation_L].Cmd.bON:=TRUE;
	ELSE
		arrCyCtrl[CYNo.Inflation_R].Cmd.bON:=TRUE;
	END_IF
	//PolePar.MQ.WindPidSwitch:=TRUE;
	//PolePar.MQ.AuxDriverPidSwitch:=TRUE;
	IF  arrCyCtrl[CYNo.DriverPressAux].Status.ONState AND arrCyCtrl[CYNo.BoardPressL].Status.ONState AND 
		arrCyCtrl[CYNo.BoardPressR].Status.ONState AND (arrCyCtrl[CYNo.CoderRollPress].Status.ONState OR TRUE) AND
		arrCyCtrl[CYNo.DriverPressDDR].Status.ONState THEN
		iTensionStep:=90;
	END_IF
90://判断前张力是否正常
	IF stUwindTen.bTensionOK THEN// 		
		iTensionStep:=220;//
	ELSE
		iTensionStep:=100;//
	END_IF;
	
	
100://关闭纠偏
	//arrRecCtrl[RecNo.PoleWind].Cmd.bManual:=TRUE;
	//arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=TRUE;
	iTensionStep:=110;
110://复位有关信号
	IF NOT  stUwindTen.bTensionOK THEN  //放卷	张力
		stUwindTen.bTenExecute:=FALSE;	
	END_IF;	
	iTensionStep:=115;//
115://放卷张力使能
	IF tonTension[1].Q THEN
		IF stUwindTen.bTensionOK THEN
			iTensionStep:=220;//
		ELSE
			IF ABS(Polepar.fPoleWithOffset)<=0.5*PolePar.fPoleWidth AND NOT ProductPar.iModeEN.bEmptyRunEN AND
				NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bCuterOffsetEN THEN
				fbUwindTen.fCompensation:=Polepar.fPoleWithOffset;
			ELSE
				fbUwindTen.fCompensation:=0;
			END_IF
			stUwindTen.bTenExecute:=TRUE;
			iTensionStep:=120;//
		END_IF
	END_IF
120://放卷张力判断
	IF stUwindTen.bTensionOK THEN
		iTensionStep:=220;//
	END_IF
	IF (stUwindTen.bTensionOK AND NOT stUwindTen.bTenExecute) THEN
		iTensionStep:=999;//张力使能失败
	END_IF

220:
	  	iTensionStep:=320;//	
320://打开纠偏	
	//arrRecCtrl[RecNo.PoleWind].Cmd.bAuto:=TRUE;
	//arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto:=TRUE;	
	iTensionStep:=330;
330://结束
	bMethodTenBufferEnable:=FALSE;
	iTensionStep:=666;
	
	
///////////////////////////////////////////////////////////张力解耦/////////////////////////////////////////////////////
1000://
	arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop:=FALSE;
	arrAxisCtrl[VirAxisNo.VirDriver].Cmd.bStop:=FALSE;
	
	//arrRecCtrl[RecNo.PoleWind].Cmd.bManual:=TRUE;
	//arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=TRUE;	
	iTensionStep:=1010;//
	
1010://
	IF tonTension[6].Q THEN
		IF NOT stBufferTen.bInSync THEN	
			iTensionStep:=1020;//
		ELSE
			//stPoleBufferCam.bCamInExecute:=FALSE;	
			//arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop:=TRUE;
			stBufferTen.bExecute:=FALSE;
		END_IF
	END_IF
1020://
	//IF NOT arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop THEN
		stUwindTen.bTenExecute:=FALSE;
	//	stAuxDriverTen.bTenExecute:=FALSE;
		iTensionStep:=1040;//
	//END_IF	
	
1040://
	IF NOT  stUwindTen.bTensionOK  THEN
		bMethodTenBufferDisEnable:=FALSE;
		SysPart.hmiTenAll:=FALSE;
		SysPart.hmiDisTenAll:=FALSE;
		iTensionStep:=1666;//
	END_IF

END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="F04FunctionCam" Id="{d40e8d1d-579a-4abd-8f8c-68db7e4f1147}">
      <Implementation>
        <ST><![CDATA[//一键凸轮耦合				
rtCam[1](CLK:=SysPart.hmiCamAll , Q=> );				
rtCam[2](CLK:=bMethodCamEnable , Q=> );				
rtCam[3](CLK:=SysPart.hmiDisCamAll , Q=> );				
rtCam[4](CLK:=bMethodCamDisEnable , Q=> );				
tonCam[1](PT:=T#200MS);				
tonCam[2](PT:=T#3S);		
tonCam[3](In:=iCamStep=1050,PT:=T#200MS);				
tonCam[4](PT:=T#3S);	
tonCam[5](In:=iCamStep=1666,PT:=T#50MS);						
IF rtCam[2].Q OR 				
	(stSysState.iMode=3  AND rtCam[1].Q AND (iCamStep=0 OR iCamStep=1666)) THEN			
	iCamStep:=88;//耦合触发			
END_IF;				
IF rtCam[4].Q OR 				
	(stSysState.iMode=3  AND rtCam[3].Q )THEN			
	iCamStep:=1000;//解耦触发			
END_IF;				
IF tonCam[5].Q THEN				
	SysPart.hmiCamAll:=FALSE;			
END_IF				
				
CASE iCamStep OF	
///////////////////////////////////////////////////////////凸轮耦合/////////////////////////////////////////////////////
88://
	stDriverCam.bCamInExecute:=FALSE;
	stCuterCam.bCamInExecute:=FALSE;
	stVirBeltCam.bCamInExecute:=FALSE;
	//stNGPushCam.bCamInExecute:=FALSE;
	stMouldCam.bCamInExecute:=FALSE;
	stCCDPressCam.bCamInExecute:=FALSE;
	stCuterBeltGear.bEnable:=FALSE;
	stNGReverseBeltGear.bEnable:=FALSE;
	stDedustBeltGear.bEnable:=FALSE;
	stDedustReverseBeltGear.bEnable:=FALSE;
	stSubBelt1Gear.bEnable:=FALSE;
	stSubBelt2Gear.bEnable:=FALSE;
	stSubBelt3Gear.bEnable:=FALSE;
	//stVirDriverCam.bCamInExecute:=FALSE;
	 stBufferTen.bExecute:=FALSE; 
	
	iCamStep:=100;
90://
	arrAxisCtrl[AxisNo.DriverDDR].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.Cuter].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.Mould].Cmd.bStop:=FALSE;
	arrAxisCtrl[VirAxisNo.VirBelt].Cmd.bStop:=FALSE;
	
	//arrAxisCtrl[AxisNo.NGPush2].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.CuterBelt].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.NGPushReverseBelt].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.DedustBelt].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.DedustReverseBelt].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.SubBelt1].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.SubBelt2].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.SubBelt3].Cmd.bStop:=FALSE;
	arrAxisCtrl[VirAxisNo.VirDriver].Cmd.bStop:=FALSE;
	
     arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop:=FALSE;
   IF NOT arrAxisCtrl[AxisNo.BuffeLine].Status.Homed THEN
			arrAxisCtrl[AxisNo.BuffeLine].Cmd.bHome:=FALSE;
 	END_IF	
	
	IF NOT tonCam[1].Q THEN
		tonCam[1].IN:=TRUE;
	ELSE
		iCamStep:=100;
		tonCam[1].IN:=FALSE;
	END_IF
100://
	IF NOT arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloPoint[1] THEN
		arrAxisCtrl[AxisNo.Cuter].Cmd.bStop:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloPoint[1] THEN
		arrAxisCtrl[AxisNo.Mould].Cmd.bStop:=TRUE;
	END_IF
	IF NOT arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloPoint[1] THEN
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop:=TRUE;
	END_IF

     IF NOT arrAxisCtrl[AxisNo.BuffeLine].Status.Homed THEN
		arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop:=TRUE;
		iCamStep:=105;
	ELSE	
		  iCamStep:=110;
 	END_IF	
	
105:
   IF NOT arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop THEN
	   arrAxisCtrl[AxisNo.BuffeLine].Cmd.bHome:=TRUE;
	   iCamStep:=106;
   END_IF
106:	
      IF  arrAxisCtrl[AxisNo.BuffeLine].Status.Homed THEN
		   iCamStep:=110;
	  END_IF

110://
	IF NOT arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloPoint[1] AND NOT arrAxisCtrl[AxisNo.Cuter].Cmd.bStop THEN
		arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloGo[1]:=TRUE;
	END_IF	
	IF NOT arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloPoint[1] AND NOT arrAxisCtrl[AxisNo.Mould].Cmd.bStop THEN
		arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloGo[1]:=TRUE;
	END_IF	
	IF NOT arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloPoint[1] AND NOT arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop THEN
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloGo[1]:=TRUE;
	END_IF	

	IF arrAxisCtrl[AxisNo.Cuter].Cmd.arrbModuloPoint[1] AND 
		(*arrAxisCtrl[AxisNo.NGPush2].Cmd.arrbModuloPoint[1] AND *)arrAxisCtrl[AxisNo.Mould].Cmd.arrbModuloPoint[1] AND
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.arrbModuloPoint[1] THEN
		iCamStep:=120;	
		tonCam[2].IN:=FALSE;
	ELSE
		IF NOT tonCam[2].Q THEN
			tonCam[2].IN:=TRUE;
		ELSE
			iCamStep:=90;
			tonCam[2].IN:=FALSE;		
		END_IF
	END_IF
120://裁切凸轮改变
	IF NOT stCuterCam.bInSync THEN
			IF (InteData[InteNo.Cuter-1].bLineScanNG AND NOT ProductPar.iModeEN.bLineScanCCDEN) OR  aYellowJump_C[1]   OR   aTapeJump_C[1]     THEN	 //(*InteData[InteNo.Cuter-1].bBlueNG ANDNOT ProductPar.iModeEN.bFlgBlueEN) OR*)	//AND NOT ProductPar.iModeEN.bEmptyRunEN																																																																					
					fbCuterCam.iTableSel:=3; 																																										
			ELSE																									
					fbCuterCam.iTableSel:=1;//裁切凸轮切换为正常																								
			END_IF		
			stCuterCam.bCamInExecute:=TRUE;//
	END_IF
(*
		IF (InteData[InteNo.Cuter-1].bBlueNG AND NOT ProductPar.iModeEN.bFlgBlueEN )OR ( InteData[InteNo.Mould-1].bLineScanNG AND NOT ProductPar.iModeEN.bLineScanCCDEN) AND NOT ProductPar.iModeEN.bEmptyRunEN THEN
			fbCuterCam.iTableSel:=3;
		ELSE
			fbCuterCam.iTableSel:=1;
		END_IF
		stCuterCam.bCamInExecute:=TRUE;//
	END_IF
*)
//模具凸轮改变
		IF NOT stMouldCam.bInSync THEN
				IF ( aYellowJump_R[1]    OR   aTapeJump_C[1]    OR bCyDDRMark    )THEN      	//   CutMark_R[2]  OR    AND NOT ProductPar.iModeEN.bEmptyRunEN 	AND NOT ProductPar.iModeEN.bFlgBlueEN 	(*InteData[InteNo.Mould-1].bBlueNG OR *)																																		
						fbMouldCam.iTableSel:=3; 																																											
				ELSE																									
						fbMouldCam.iTableSel:=1; //模具凸轮切换为正常																								
				END_IF		
				stMouldCam.bCamInExecute:=TRUE;//
		END_IF
(*
		IF ( (  InteData[InteNo.Mould-1].bBlueNG AND NOT ProductPar.iModeEN.bFlgBlueEN )OR (InteData[InteNo.Cuter-1].bLineScanNG AND NOT ProductPar.iModeEN.bLineScanCCDEN  ) OR CutMark_R[2] )AND NOT ProductPar.iModeEN.bEmptyRunEN THEN
			fbMouldCam.iTableSel:=3;
		ELSE
			fbMouldCam.iTableSel:=1;	
		END_IF
		stMouldCam.bCamInExecute:=TRUE;//
*)

	IF NOT stCCDPressCam.bInSync THEN
		stCCDPressCam.bCamInExecute:=TRUE;
	END_IF	
	
	IF NOT stDriverCam.bInSync THEN
		IF ABS(Polepar.fPoleWithOffset)<=0.5*PolePar.fPoleWidth AND NOT ProductPar.iModeEN.bEmptyRunEN THEN
			fbDriverCam.fCompensation:=Polepar.fPoleWithOffset;
		ELSE
			fbDriverCam.fCompensation:=0;
		END_IF
		stDriverCam.bCamInExecute:=TRUE;
	END_IF
	
	IF NOT stVirBeltCam.bInSync THEN
		stVirBeltCam.bCamInExecute:=TRUE;
	END_IF	

	IF NOT ProductPar.iModeEN.bEmptyRunEN THEN	
		IF NOT stBufferTen.bInSync THEN
			//stVirDriverCam.bCamInExecute:=TRUE;
			stBufferTen.bExecute:=TRUE;
		END_IF		
	END_IF
	
	IF stCuterCam.bInSync AND stMouldCam.bInSync AND
		(*stNGPushCam.bInSync AND*) stCCDPressCam.bInSync AND
		stDriverCam.bInSync	AND stVirBeltCam.bInSync  AND   (stBufferTen.bInSync  OR ProductPar.iModeEN.bEmptyRunEN)    THEN
		iCamStep:=130;
	END_IF
130://
	IF NOT stCuterBeltGear.bInGear THEN
		stCuterBeltGear.bEnable:=TRUE;
	END_IF	
	IF NOT stNGReverseBeltGear.bInGear THEN
		stNGReverseBeltGear.bEnable:=TRUE;
	END_IF		
	IF NOT stDedustBeltGear.bInGear THEN
		stDedustBeltGear.bEnable:=TRUE;
	END_IF
	IF NOT stDedustReverseBeltGear.bInGear THEN
		stDedustReverseBeltGear.bEnable:=TRUE;
	END_IF

	IF NOT stSubBelt1Gear.bInGear THEN
		stSubBelt1Gear.bEnable:=TRUE;
	END_IF

	IF NOT stSubBelt2Gear.bInGear THEN
		bSubBelt2fratio:=false;
		stSubBelt2Gear.bEnable:=TRUE;
	END_IF	
	
	IF NOT stSubBelt3Gear.bInGear THEN
		bSubBelt3fratio:=false;
		stSubBelt3Gear.bEnable:=TRUE;
	END_IF		

	IF stCuterBeltGear.bInGear AND stNGReverseBeltGear.bInGear AND stDedustBeltGear.bInGear AND stDedustReverseBeltGear.bInGear AND 
	     stSubBelt1Gear.bInGear AND  stSubBelt2Gear.bInGear AND  stSubBelt3Gear.bInGear THEN
		bMethodCamEnable:=FALSE;
    	iCamStep:=666;		
	END_IF
///////////////////////////////////////////////////////////凸轮解耦/////////////////////////////////////////////////////	
1000://
	arrAxisCtrl[AxisNo.DriverDDR].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.Cuter].Cmd.bStop:=FALSE;
	arrAxisCtrl[VirAxisNo.VirBelt].Cmd.bStop:=FALSE;
	//arrAxisCtrl[AxisNo.NGPush2].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.Mould].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.CuterBelt].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.NGPushReverseBelt].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.DedustBelt].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.DedustReverseBelt].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.SubBelt1].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.SubBelt2].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.SubBelt3].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop:=FALSE;
	arrAxisCtrl[VirAxisNo.VirDriver].Cmd.bStop:=FALSE;

	

	stDriverCam.bCamInExecute:=FALSE;
	stCuterCam.bCamInExecute:=FALSE;
	stVirBeltCam.bCamInExecute:=FALSE;
	stMouldCam.bCamInExecute:=FALSE;
	stCCDPressCam.bCamInExecute:=FALSE;
	stCuterBeltGear.bEnable:=FALSE;
	stNGReverseBeltGear.bEnable:=FALSE;
	stDedustBeltGear.bEnable:=FALSE;
	stDedustReverseBeltGear.bEnable:=FALSE;
	stSubBelt1Gear.bEnable:=FALSE;
	stSubBelt2Gear.bEnable:=FALSE;
	stSubBelt3Gear.bEnable:=FALSE;
	stBufferTen.bExecute:=FALSE;

	iCamStep:=1050;
1050://
	IF 	tonCam[3].Q THEN
		arrAxisCtrl[AxisNo.DriverDDR].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.Cuter].Cmd.bStop:=TRUE;
		arrAxisCtrl[VirAxisNo.VirBelt].Cmd.bStop:=TRUE;
		//arrAxisCtrl[AxisNo.NGPush2].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.Mould].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.CuterBelt].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.NGPushReverseBelt].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.DedustBelt].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.DedustReverseBelt].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.SubBelt1].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.SubBelt2].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.SubBelt3].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.SubBelt3].Cmd.bStop:=TRUE;
		arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop:=TRUE;
		arrAxisCtrl[VirAxisNo.VirDriver].Cmd.bStop:=TRUE;
		iCamStep:=1100;
END_IF
1100://
	IF	NOT	arrAxisCtrl[AxisNo.DriverDDR].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.Cuter].Cmd.bStop	AND
		NOT	arrAxisCtrl[VirAxisNo.VirBelt].Cmd.bStop	AND
		(*NOT	arrAxisCtrl[AxisNo.NGPush2].Cmd.bStop	AND*)
		NOT	arrAxisCtrl[AxisNo.Mould].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.CuterBelt].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.NGPushReverseBelt].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.DedustBelt].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.DedustReverseBelt].Cmd.bStop	AND
		
		NOT	arrAxisCtrl[AxisNo.SubBelt1].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.SubBelt2].Cmd.bStop	AND
		NOT	arrAxisCtrl[AxisNo.SubBelt3].Cmd.bStop	AND
		NOT arrAxisCtrl[AxisNo.BuffeLine].Cmd.bStop AND
		NOT arrAxisCtrl[VirAxisNo.VirDriver].Cmd.bStop THEN	
		SysPart.hmiCamAll :=FALSE;
		SysPart.hmiDisCamAll :=FALSE;
		bMethodCamDisEnable:=FALSE;
		iCamStep:=1666;
		tonCam[4].IN:=FALSE;
	ELSE
		IF NOT tonCam[4].Q THEN
			tonCam[4].IN:=TRUE;
		ELSE
			iCamStep:=1000;
			tonCam[4].IN:=FALSE;
		END_IF
	END_IF
END_CASE
	
	
	

		
	
	
	
	
	
	
	
	
	
	
	
	
	
	]]></ST>
      </Implementation>
    </Action>
    <Action Name="F0500MainAuto" Id="{4bd03534-9f1c-4caf-84b4-910a0cc987a6}" FolderPath="F05Auto\">
      <Implementation>
        <ST><![CDATA[

iMainVel:=PolePar.iMainVel;
///////////////////////////////////////////////////////////主自动///////////////////////////////////////////////////////////////////
CASE iAutoRunStep OF 
0:////主轴处于静止
	IF rtAuto[1].Q THEN
		iAutoRunStep:=88;
	END_IF
88://主轴处于静止
	iAutoRunStep:=1000;//主轴运行前准，主轴模长清0/气缸&阀类动作/排杆准备1000~1999

100://主轴处于静止
	iAutoRunStep:=2000;//  判断皮带耦合状况，主轴运行模式判断   2000~2999
	
188://走绝对
	IF   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>0 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<20    THEN
		stAlarm.arrLightWarn[22]:=FALSE;		
		IF  arrAxisCtrl[AxisNo.SubBelt1].Status.Coupled  AND arrAxisCtrl[AxisNo.SubBelt2].Status.Coupled AND  
			bSubBelt1fratio  AND NOT  bSubBelt2fratio  AND  BeltData[BeltNo.SubBelt1].bHavePole AND NOT bSubBelt1Alarm1     THEN    //20240527SJ
			bSubBelt1Alarm1:=TRUE;
			iRuningFlg:=itest2;
			IF   bSubBelt3fratio THEN
		         bSubBelt3Moving1:=TRUE;
		    END_IF	
		END_IF

		iAutoRunStep:=250;
	END_IF	
	
	
150://跑速度
	bFristPole:=TRUE;
	iNGStep:=10;	
  	IF NOT bFlgStoping THEN
		arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Velo:=PolePar.iMainVel*6;
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveVelo:=TRUE;
		itest:=3;
	END_IF
	
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.Moving    THEN
		iAutoRunStep:=190;
	END_IF
190:
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=0 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<10 THEN		
		(*线扫数据清零*)
		stAlarm.arrLightWarn[22]:=FALSE;
		IF  arrAxisCtrl[AxisNo.SubBelt1].Status.Coupled  AND arrAxisCtrl[AxisNo.SubBelt2].Status.Coupled AND  
			bSubBelt1fratio  AND NOT  bSubBelt2fratio  AND  BeltData[BeltNo.SubBelt1].bHavePole  AND NOT bSubBelt1Alarm2   THEN  // //20240527SJ
			bSubBelt1Alarm2:=TRUE;
			iRuningFlg:=itest2;
			IF   bSubBelt3fratio THEN
		         bSubBelt3Moving2:=TRUE;
		    END_IF	
		END_IF
		iAutoRunStep:=250;
	END_IF

	
	
250://主轴运行中且模长0-10度，主驱&皮带刚开始启动
   IF  arrAxisCtrl[VirAxisNo.VirMain].Status.Error OR  arrAxisCtrl[VirAxisNo.VirDriver].Status.Error OR 
       arrAxisCtrl[AxisNo.BuffeLine].Status.Error  OR  arrAxisCtrl[AxisNo.DriverDDR].Status.Error  OR  
       arrAxisCtrl[AxisNo.UnWind_L].Status.Error  OR   arrAxisCtrl[AxisNo.UnWind_R].Status.Error OR 
       NOT stBufferTen.bInSync OR NOT  stUwindTen.bTensionOK THEN
	    arrAxisCtrl[VirAxisNo.VirMain].Cmd.bStop:=TRUE;
		stAlarm.arrFlowAlarm[46]:=TRUE; 
	    iAutoRunStep:=9999;
	ELSE
	 iAutoRunStep:=3000;
	END_IF
	
300://主轴运行中且模长240-268度，主驱&皮带刚停止
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=ProductPar.parPublic.fMainPos AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<ProductPar.parPublic.fMainPos+8 THEN
		iAutoRunStep:=4000;
	END_IF
350://主轴运行中且模长大于340度，主轴周期即将结束
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=340 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<350 THEN//330 350

		iAutoRunStep:=5000;
	END_IF


400://主轴运动中，ABS模式运行
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos-arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos+720;
	//arrAxisPar[VirAxisNo.VirMain].fTagatTime:=((arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs-arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos)/360) *60/PolePar.iMainVel ;
	arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Abs:=PolePar.iMainVel*6;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs:=TRUE;
	bFlgStoping:=TRUE;
	itest:=2;
	 iNGStep:=10;	
	iAutoRunStep:=188;
	
420://主轴静止中，ABS模式运行
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos-arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos+360;
	//arrAxisPar[VirAxisNo.VirMain].fTagatTime:=((arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs-arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos)/360) *60/PolePar.iMainVel ;
	arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Abs:=PolePar.iMainVel*6;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs:=TRUE;
	bFlgStoping:=TRUE;
	itest:=1;
	 iNGStep:=10;	
	iAutoRunStep:=188;
	

450://等待主轴运动正常停止
  IF  arrAxis[VirAxisNo.VirMain].Status.ConstantVelocity AND  arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving    THEN
	  //AA1:=AA1+1;
	  ;
  END_IF
  
  rMQUse[15](CLK:= arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=5 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<=15 );////PLC_To_PC上位机的发送数据标志
   IF  rMQUse[15].Q THEN
	  AA1:=AA1+1;
	  IF AA1>=5 THEN 
		  iStopCount4:=iStopCount4+1;
		  stAlarm.arrLightWarn[11]:=TRUE; 
		  AA1:=0;
		  iAutoRunStep:=420;
	  END_IF
  END_IF 
  

	IF arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving AND NOT arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs THEN	
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
		arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bDynamitcsParSel:=1;
		arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bDynamitcsParSel:=1;
		//arrAxisCtrl[AxisNo.NGPush1].Cmd.bDynamitcsParSel:=1;		
		bFlgStoping:=FALSE;
		itest:=0;
		IF bSysStoping THEN
			iAutoRunStep:=600;	//人为停止&报警引起的停止
		ELSE
			iAutoRunStep:=6000;//由于皮带料满，非人为手动主轴运动自动停止,判断皮带耦合状况.        6000~6999
		END_IF		
	END_IF
//6000流程走向跳步100:返回继续切片送料




500://异常，主轴当前周期立即停止
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=2;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos-arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos+360;
	//arrAxisPar[VirAxisNo.VirMain].fTagatTime:=((arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs-arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos)/360) *60/PolePar.iMainVel+0.05 ;
	arrAxisPar[VirAxisNo.VirMain].fTagatTime:= 3.33333/PolePar.iMainVel+0.006 ;//3.33333/PolePar.iMainVel+0.01
	//arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Abs:=PolePar.iMainVel*6;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs:=TRUE;
	itest:=4;
	iAutoRunStep:=550;
550://等待主轴运动停止
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving AND NOT arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs THEN	
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
		arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bDynamitcsParSel:=1;
		arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bDynamitcsParSel:=1;
		//arrAxisCtrl[AxisNo.NGPush1].Cmd.bDynamitcsParSel:=1;
		bFlgStoping:=FALSE;
		itest:=0;
		IF bSysStoping THEN 
			iAutoRunStep:=600;	
		ELSE
			//stAlarm.arrLightWarn[11]:=TRUE;//皮带运行出现记忆紊乱，请查看！
			iAutoRunStep:=100;//报警
			//iAutoRunStep:=600;	
		END_IF		
	END_IF	
		
	
600://停止时解除凸轮
   IF tonAuto[21].Q THEN
	  iAutoRunStep:=610;  
   END_IF
610:
	IF stSysState.Stoping THEN
		IF stSysState.btnEstop THEN
			bMethodTenBufferDisEnable:=TRUE;
		END_IF
		bMethodCamDisEnable:=TRUE;
		bMethodTenBufferEnable:=FALSE;
		bMethodCamEnable:=FALSE ;
		iAutoRunStep:=650;
	END_IF
650://凸轮是否解除完成
	IF NOT bMethodCamDisEnable AND NOT bMethodTenBufferDisEnable THEN
		iAutoRunStep:=0;
		iAutoAuxStep1:=0;
	//	iAutoAuxStep2:=0;
		iAutoAuxStep10:=0;

		//RecY.bEnable:=FALSE;
		SysPart.bStopFinished:=TRUE;
		//SetpMotor.WorkPosDone:=FALSE;
		//SetpMotor.bGoWorkPos:=FALSE;
		bFlgStoping:=FALSE;
		bSysStoping:=FALSE;
		itest:=0;
		tonAuto[1].In:=FALSE;
		nInt[3]:=0;
		arrDustMotor[MotorNo.DDR_Dust].bRun_FW:=FALSE;																			
		arrDustMotor[MotorNo.CuterBeltDust].bRun_FW:=FALSE;																									
		arrDustMotor[MotorNo.NGReverseBeltDust].bRun_FW:=FALSE;																									
		arrDustMotor[MotorNo.DedustBeltDust].bRun_FW:=FALSE;																									
		arrDustMotor[MotorNo.DedustReverseBeltDust].bRun_FW:=FALSE;																									
		arrDustMotor[MotorNo.PoleBrushDust_U].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.PoleBrushDust_D].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.FeduanbeltDust1].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.FeduanbeltDust2].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.FeduanbeltDust3].bRun_FW:=FALSE;																										
		arrCyCtrl[EVNo.BrushDustVacuo_U].Cmd.bOFF:=TRUE;																									
		arrCyCtrl[EVNo.WindDustBlow_U].Cmd.bOFF:=TRUE;																									
		arrCyCtrl[EVNo.WindDustVacuo_U].Cmd.bOFF:=TRUE;																																																	
		arrCyCtrl[EVNo.BrushDustVacuo_D].Cmd.bOFF:=TRUE;																									
		arrCyCtrl[EVNo.WindDustBlow_D].Cmd.bOFF:=TRUE;																									
		arrCyCtrl[EVNo.WindDustVacuo_D].Cmd.bOFF:=TRUE;
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=FALSE;//踢NG料打开
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=TRUE;//踢NG料关闭	
		arrCyCtrl[EVNo.RJDustBlow  ].Cmd.bOFF:=TRUE;
		arrCyCtrl[EVNo.RJDustBlow  ].Cmd.bON:=FALSE;				
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
		arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bDynamitcsParSel:=1;
		arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bDynamitcsParSel:=1;
		//arrAxisCtrl[AxisNo.NGPush1].Cmd.bDynamitcsParSel:=1;
	END_IF
999://报警
	IF  (stSysState.btnStart OR stSysState.hmiStart)THEN //NOT stAlarm.arrLightWarn[11] AND
		iAutoRunStep:=88;//
	END_IF
	IF stSysState.Stoping THEN
		iAutoRunStep:=600;//
	END_IF
END_CASE





(*

500://异常，主轴当前周期立即停止
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos-arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos+360;
	//arrAxisPar[VirAxisNo.VirMain].fTagatTime:=((arrAxisCtrl[VirAxisNo.VirMain].Cmd.fPositon_of_Abs-arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos)/360) *60/PolePar.iMainVel+0.05 ;
	arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Abs:=PolePar.iMainVel*6;
	arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs:=TRUE;
	itest:=3;
	iAutoRunStep:=550;
550://等待主轴运动停止
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving AND NOT arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveAbs THEN	
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bDynamitcsParSel:=1;
		arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bDynamitcsParSel:=1;
		arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bDynamitcsParSel:=1;
		//arrAxisCtrl[AxisNo.NGPush1].Cmd.bDynamitcsParSel:=1;
		bFlgStoping:=FALSE;
		IF bSysStoping THEN 
			iAutoRunStep:=600;	
		ELSE
			//stAlarm.arrLightWarn[11]:=TRUE;//皮带运行出现记忆紊乱，请查看！
			iAutoRunStep:=100;//报警
		END_IF		
	END_IF	
*)













(*
(*产能请勿删除*尺寸NG且线扫NG统一记尺寸NG*)
aAnDay_date.rTCount:=AnPart.fbAnPart.ttLinePhoto.Q ;//切次数计数；
aCaDay_date.rTCount:=CaPart.fbCaPart.ttLinePhoto.Q ;//切次数计数；

aCaDay_date.iFinish:=CaPart.fbCaPart.BeltData[BeltNo.NGBox1+2].iFinish;//尺寸NG计数；
aAnDay_date.iFinish:=AnPart.fbAnPart.BeltData[BeltNo.NGBox1+2].iFinish;//尺寸NG计数；

aAnDay_date.K8:=AnPart.fbAnPart.BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo;//尺寸NG详细分类；
aCaDay_date.K8:=CaPart.fbCaPart.BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo;//尺寸NG详细分类；

aAnDay_date.K9:=AnPart.fbAnPart.BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo;//线扫瑕疵
aCaDay_date.K9:=CaPart.fbCaPart.BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo;//线扫瑕疵

aAnDay_date.K7:=GMotion.arrAxisCtrl[51].Status.fModuloActPos;
aCaDay_date.K7:=GMotion.arrAxisCtrl[56].Status.fModuloActPos;
*)



(*
////////////////////////////////////////////////////////////////NG剔废////////// NG分类 //////////////////////////////////////////////////////
CASE iNGStep OF 
10://判断NG1&NG2是否动作 主轴静止或运行中
	IF  (*	(BeltData[BeltNo.NGBox1+2].iJumpCutNG<>1 AND NOT ProductPar.iModeEN.bNG1PushEN AND NOT ProductPar.iModeEN.bEmptyRunEN
		AND (NOT ProductPar.iModeEN.bLineScanCCDEN OR NOT ProductPar.iModeEN.bFlgBlueEN)  )   *)   FALSE       THEN
			iNGStep:=185;
	ELSIF ( NOT ProductPar.iModeEN.bNG2PushEN AND NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bSizeCCDEN AND																									
	     BeltData[BeltNo.NGBox1+2].iPanoramaNG<>1  ) THEN
		 	iNGStep:=185;
	ELSIF   ProductPar.iModeEN.bSizeCCDEN AND  BeltData[BeltNo.NGBox1+2].iPanoramaNG=2 THEN
		 	iNGStep:=185;	
	ELSIF ((XianSaong_Up[1]<>8 OR XianSaong_Down[0]<>8 OR XianSaong1[3]=1) AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN ) THEN
			iNGStep:=185;
	ELSIF  (  YellowmarkNG[2]<>1 AND NOT ProductPar.iModeEN.bEmptyRunEN )THEN
		    iNGStep:=185;
	ELSIF   BeltData[BeltNo.NGBox1+2].bYellowMark THEN
			iNGStep:=185;
	ELSE
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=FALSE;//踢NG料打开
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=TRUE;//踢NG料关闭			
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bON:=TRUE;//踢NG料真空打开
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bOFF:=FALSE;//踢NG料真空关闭	
		iNGStep:=190;
	END_IF
185:
	arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=TRUE;//踢NG料破真空打开
	arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=FALSE;//踢NG料破真空关闭
	arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bON:=FALSE;//踢NG料真空打开
	arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bOFF:=TRUE;//踢NG料真空关闭
	BeltData[BeltNo.NGBox1+2].bHavePole:=FALSE;
	BeltData[BeltNo.NGBox1+2].stPoleNo:='';
	iNGStep:=666;
END_CASE
*)

(*
////////////////////////////////////////////////////////////////蓝胶检测////////////////////////////////////////////////////////////////
IF NOT ProductPar.iModeEN.bEmptyRunEN AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND arrAxisCtrl[AxisNo.DriverDDR].Status.Moving THEN
	IF rtAuto[3].Q AND NOT ProductPar.iModeEN.bFlgBlueEN THEN
		FOR i4:=1 TO 20 BY 1 DO
			IF i4<20 THEN 
				 fBluePos[21-i4]:=fBluePos[20-i4];
			ELSE
				 fBluePos[1]:=fDriverDDRActPos;
			END_IF; 
		END_FOR
	END_IF
	
	
	(*
////////////////////////////////////////////////////////////////线扫检测////////////////////////////////////////////////////////////////
	IF (rtAuto[4].Q OR rtAuto[5].Q) AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN AND
		arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND arrAxisCtrl[AxisNo.DriverDDR].Status.Moving THEN
		FOR i5:=1 TO 20 BY 1 DO
			IF i5<20 THEN 
				 fLineScanPos[21-i5]:=fLineScanPos[20-i5];
			ELSE
				 fLineScanPos[1]:=fDriverDDRActPos;
			END_IF; 
		END_FOR
	END_IF
	*)
END_IF
*)









]]></ST>
      </Implementation>
    </Action>
    <Action Name="F0501MainAuto1" Id="{9418259e-13d2-47ae-a72e-4ee7e4cb4033}" FolderPath="F05Auto\">
      <Implementation>
        <ST><![CDATA[
////////////////////////////////////////////主轴运行前准备，主轴模长清0/气缸&阀类动作/排杆准备//////////////////////////////////////////////////////
CASE iAutoRunStep OF 
1000://判断主轴是否在停止中
	IF 	arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving THEN
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bStop:=FALSE;
		iAutoRunStep:=1001;//
	ELSE
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bStop:=TRUE;
	END_IF
1001://
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos=0 THEN
		iAutoRunStep:=1030;
	ELSE
		bMethodTenBufferDisEnable:=TRUE;
		bMethodCamDisEnable:=TRUE;
		iAutoRunStep:=1010;//
	END_IF
1010://
	IF NOT bMethodTenBufferDisEnable AND NOT bMethodCamDisEnable THEN
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.fSetPos:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos-arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos+360;
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.bSetPos:=TRUE;
		//arrAxisCtrl[VirAxisNo.VirDriver].Cmd.bSetPos:=TRUE;
		//arrAxisCtrl[VirAxisNo.VirBelt].Cmd.bSetPos:=TRUE;
		iAutoRunStep:=1020;//
	END_IF
1020://
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos=0 (*AND arrAxisCtrl[VirAxisNo.VirDriver].Status.fModuloActPos=0 AND arrAxisCtrl[VirAxisNo.VirBelt].Status.fModuloActPos=0*) THEN
		arrAxisCtrl[VirAxisNo.VirMain].Cmd.fSetPos:=0;
		iAutoRunStep:=1030;//
	END_IF
1030://
   	IF PolePar.MQ.  bWindSelect THEN
		arrCyCtrl[CYNo.Inflation_L].Cmd.bON:=TRUE;
	ELSE	
	        arrCyCtrl[CYNo.Inflation_R].Cmd.bON:=TRUE;
	END_IF
	arrCyCtrl[CYNo.BoardPressL].Cmd.bON:=TRUE;  
	arrCyCtrl[CYNo.BoardPressR].Cmd.bON:=TRUE;  
	//IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bMouldYRecEN THEN
		//RecY.bEnable:=TRUE;
	//END_IF
	arrCyCtrl[CYNo.NGRevBeltTension].Cmd.bON:=TRUE;
	//arrCyCtrl[CYNo.NGBoxLock1].Cmd.bOFF:=TRUE;
	//arrCyCtrl[CYNo.NGBoxLock2].Cmd.bOFF:=TRUE;	
	arrCyCtrl[CYNo.WasteBoxPush].Cmd.bOFF:=TRUE;
	arrCyCtrl[CYNo.NGRevBeltUpDown].Cmd.bON:=TRUE;
	arrCyCtrl[CYNo.DustRevBeltUpDown].Cmd.bON:=TRUE;
	arrCyCtrl[CYNo.PoleBrushDustPush_U].Cmd.bOFF:=TRUE;
	//arrCyCtrl[CYNo.PoleWindDustPush_U].Cmd.bON:=TRUE;
	arrCyCtrl[CYNo.PoleBrushDustPush_D].Cmd.bOFF:=TRUE;
	//arrCyCtrl[CYNo.PoleWindDustPush_D].Cmd.bON:=TRUE;	
	IF	(*arrCyCtrl[CyNo.NGBoxLock1].Status.OFFState AND arrCyCtrl[CyNo.NGBoxLock2].Status.OFFState AND*)
		arrCyCtrl[CyNo.BoardPressL].Status.ONState AND  arrCyCtrl[CyNo.BoardPressR].Status.ONState AND 
		arrCyCtrl[CyNo.NGRevBeltUpDown].Status.ONState AND arrCyCtrl[CYNo.DustRevBeltUpDown].Status.ONState AND 
		arrCyCtrl[CyNo.PoleBrushDustPush_U].Status.OFFState AND  arrCyCtrl[CyNo.PoleBrushDustPush_D].Status.OFFState AND 
		(arrCyCtrl[CyNo.PoleWindDustPush_U].Status.ONState AND arrCyCtrl[CyNo.PoleWindDustPush_D].Status.ONState OR TRUE) THEN
		iAutoRunStep:=1040;//		
	END_IF
1040://
	//IF NOT SetpMotor.WorkPosDone AND NOT ProductPar.iModeEN.bNG2PushEN AND NOT ProductPar.iModeEN.bEmptyRunEN  AND FALSE THEN		
		//SetpMotor.bGoWorkPos:=TRUE;	
	//END_IF;	
	tonAuto[1].In:=FALSE;	
	iAutoRunStep:=1050;//
1050://排杆电机动作
	arrAxisCtrl[AxisNo.DedustReverseBelt].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.SubBelt1].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.SubBelt2].Cmd.bStop:=FALSE;
	arrAxisCtrl[AxisNo.SubBelt3].Cmd.bStop:=FALSE;
	IF (*SetpMotor.WorkPosDone OR ProductPar.iModeEN.bNG2PushEN OR*) ProductPar.iModeEN.bEmptyRunEN OR TRUE THEN
		iAutoRunStep:=1060;//
		bFindTab:=FALSE;		
		tonAuto[1].In:=FALSE;
	ELSE
		IF NOT tonAuto[1].Q THEN
			tonAuto[1].IN:=TRUE;
		ELSE
			stAlarm.arrFlowAlarm[1]:=TRUE;//料盒排杆电机去工作位超时
		END_IF	
	END_IF
1060://开机后首次拍照，确认极耳是否OK
	IF 	(NOT ProductPar.iModeEN.bChamferCCDEN OR NOT ProductPar.iModeEN.bCuterCCDEN) AND NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN THEN
	///////////////////////冲R角定位检测/////////////////////////																																																		
		CCD_IO.boChamferPhoto:=TRUE;																									
		TabData[TabNo.MouldPhoto].bCCDed_M:=TRUE;		
		TabData[TabNo.MouldPhoto].bTabOffsetNG_M:=FALSE;																			
		CCD_COM.Chamfer.iFinish:=0;																																																																					
		iAutoRunStep:=1070;//
		tonAuto[19].IN:=FALSE;	
	ELSE
		iAutoRunStep:=1800;//		
	END_IF	
1070://判断拍照完成
	IF NOT tonAuto[19].Q THEN
		tonAuto[19].IN:=TRUE;
		IF CCD_COM.Chamfer.iFinish<>0 THEN
			iAutoRunStep:=1080;//
			tonAuto[19].IN:=FALSE;
		END_IF 
	ELSE
		tonAuto[19].IN:=FALSE;
		iAutoRunStep:=1100;
	END_IF
1080://分析结果
	IF CCD_COM.Chamfer.iFinish=1 THEN
		TabData[TabNo.MouldPhoto].fTab_OffsetM:=CCD_COM.Chamfer.fTabXOffset;
		iAutoRunStep:=1800;
	ELSE
		iAutoRunStep:=1100;//需要进行找极耳流程
	END_IF
1100://
	bFindTab:=TRUE;
	iAutoRunStep:=1800;
	

1800://判断一键张力
   IF NOT ProductPar.iModeEN.bEmptyRunEN THEN
		 IF stUwindTen.bTensionOK AND NOT bMethodTenBufferEnable AND iTensionStep=666 THEN
			iAutoRunStep:=1820; 
		ELSE
			bMethodTenBufferEnable:=TRUE;//一键上张力
			iAutoRunStep:=1810; 
		 END_IF
	ELSE
		iAutoRunStep:=1820;//
	END_IF

	
1810://
   	IF stUwindTen.bTensionOK AND NOT bMethodTenBufferEnable AND iTensionStep=666 THEN//	stAuxDriverTen.bTensionOK
		iAutoRunStep:=1820;//
	END_IF
		
1820:
	iAutoAuxStep1:=100;//凸轮
	iAutoRunStep:=1830;

1830:	
	IF   iCamStep=666   AND SysPart.bAutoMain    THEN//iAutoAuxStep1=666   AND 
		bFlgStoping:=FALSE;
		bSysStoping:=FALSE;
		//bBelt1Gearask:=FALSE;
		bBelt2Gearask:=FALSE;
		bBelt3Gearask:=FALSE;
		iAutoRunStep:=1840;
	END_IF
	
(*	
1820://
	IF iAutoAuxStep1=666 AND iAutoAuxStep2=666  AND SysPart.bAutoMain THEN
		iAutoRunStep:=1840;
		bFlgStoping:=FALSE;
		bSysStoping:=FALSE;
		bBelt1Gearask:=FALSE;
		bBelt2Gearask:=FALSE;
		bBelt3Gearask:=FALSE;
	END_IF
	*)
	
	
1840://
	//iRTransCompCount:=16;
	//fArvTransverData:=0;	
    RecY.bEnable:= NOT ProductPar.iModeEN.bMouldYRecEN; // stUwindTen.bTensionOK
	IF NOT bFristPole THEN
		bSubBelt2fratio:=TRUE;
		bSubBelt3fratio:=TRUE;
		iAutoRunStep:=420;
	ELSE
		iAutoRunStep:=100;
	END_IF
	
	
	
	
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="F0502MainAuto2" Id="{2dfdd34e-1280-4a35-9637-7024e7eba164}" FolderPath="F05Auto\">
      <Implementation>
        <ST><![CDATA[
////////////////////////////////////////////////////////主轴静止,判断皮带耦合状况，主轴运行模式判断 /////////////////////////////////////////////////////////////
CASE iAutoRunStep OF 
2000://判断皮带料况,皮带耦合请求
      IF  NOT bBelt1Taking   AND  NOT   InterPart.M1Allow    AND 
		NOT bBelt2Taking   AND  NOT   InterPart.M2Allow    AND 		
		NOT bBelt3Taking  AND   NOT   InterPart.M3Allow    AND
              	arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving    THEN        
              	iMainMode:=2;
              	iAutoRunStep:=2005;
       END_IF

2005:
	IF NOT BeltData[BeltNo.SubBelt1].bHavePole THEN//分段1运行							
		bBelt1Gearask:=TRUE;
		bBelt2Gearask:=FALSE;
		bBelt3Gearask:=FALSE;									
	ELSIF (*bBelt2Need AND*) BeltData[BeltNo.SubBelt1].bHavePole AND 										
		NOT BeltData[BeltNo.SubBelt2].bHavePole THEN 	//分段1/2运行										
		bBelt1Gearask:=TRUE;
		bBelt2Gearask:=TRUE;
		bBelt3Gearask:=FALSE;																		
	ELSIF (*bBelt2Need AND bBelt3Need AND*) 
		BeltData[BeltNo.SubBelt1].bHavePole AND 										
		BeltData[BeltNo.SubBelt2].bHavePole  AND  (   NOT BeltData[BeltNo.SubBelt3].bHavePole OR (BeltData[BeltNo.SubBelt3].bHavePole AND BeltData[BeltNo.SubBelt3].stPoleNo=''AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bSizeCCDEN)  OR     ProductPar.iModeEN.bP2PartEN    )       THEN 	//分段1/2/3运行									
		bBelt1Gearask:=TRUE;
		bBelt2Gearask:=TRUE;
		bBelt3Gearask:=TRUE;	
	ELSE
		bBelt1Gearask:=TRUE; //20240525 SJ
		bBelt2Gearask:=FALSE;
		bBelt3Gearask:=FALSE;
		iMainMode:=1;																		
	END_IF	
    	iAutoRunStep:=2010;
2010://综合判断皮带耦合
	IF bBelt1Gearask AND NOT bBelt2Gearask AND NOT bBelt3Gearask THEN//分段1运行	
		bSubBelt2fratio:=FALSE;
		bSubBelt3fratio:=FALSE;															
	ELSIF bBelt1Gearask AND bBelt2Gearask AND NOT bBelt3Gearask THEN //分段1/2运行		
		bSubBelt2fratio:=TRUE;
		bSubBelt3fratio:=FALSE;																			
	ELSIF bBelt1Gearask AND bBelt2Gearask AND bBelt3Gearask THEN //分段1/2/3运行		
		bSubBelt2fratio:=TRUE;
		bSubBelt3fratio:=TRUE;				
	END_IF	

	iPoleNoHave2:=iPoleNoHaveA;
	iAutoRunStep:=2020;

2020://判断运行模式,主轴静止中
	IF iMainMode=1 THEN
		iAutoRunStep:=450;//等待主轴停止
		itest2:=21;
	ELSE
		IF iPoleNoHave2=1 THEN
			iAutoRunStep:=420;//再走一个周期
			itest2:=22;
		ELSIF iPoleNoHave2=2 THEN
			bFlgStoping:=FALSE;
			arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveVelo:=FALSE;
			iAutoRunStep:=150;//再走多个周期
			itest2:=23;
		ELSIF iPoleNoHave2=0 THEN
			iAutoRunStep:=450;///等待主轴停止
			itest2:=24;
		END_IF
	END_IF
   	//bBelt1Gearask:=FALSE;
	bBelt2Gearask:=FALSE;
	bBelt3Gearask:=FALSE;			
END_CASE













(*
////////////////////////////////////////////////////////主轴静止,判断皮带耦合状况，主轴运行模式判断 /////////////////////////////////////////////////////////////
CASE iAutoRunStep OF 
2000://判断皮带料况,皮带耦合请求

		IF NOT BeltData[BeltNo.SubBelt1].bHavePole THEN//分段1运行							
			bBelt1Gearask:=TRUE;
			bBelt2Gearask:=FALSE;
			bBelt3Gearask:=FALSE;									
		ELSIF bBelt2Need AND BeltData[BeltNo.SubBelt1].bHavePole AND 										
				 NOT BeltData[BeltNo.SubBelt2].bHavePole THEN 	//分段1/2运行										
			bBelt1Gearask:=TRUE;
			bBelt2Gearask:=TRUE;
			bBelt3Gearask:=FALSE;																		
		ELSIF bBelt2Need AND bBelt3Need AND 
				 BeltData[BeltNo.SubBelt1].bHavePole AND 										
				 BeltData[BeltNo.SubBelt2].bHavePole  AND  (   NOT BeltData[BeltNo.SubBelt3].bHavePole   OR     ProductPar.iModeEN.bP2PartEN    )             THEN 	//分段1/2/3运行									
			bBelt1Gearask:=TRUE;
			bBelt2Gearask:=TRUE;
			bBelt3Gearask:=TRUE;																	
		END_IF	

	iAutoRunStep:=2010;
2010://综合判断皮带耦合
IF  tonAuto[8].Q THEN
	
	IF bBelt1Gearask AND NOT bBelt2Gearask AND NOT bBelt3Gearask THEN//分段1运行	
		IF NOT bBelt1Taking THEN
			bSubBelt2fratio:=FALSE;
			bSubBelt3fratio:=FALSE;														
			iMainMode:=2;
		ELSE	
			bSubBelt2fratio:=FALSE;
			bSubBelt3fratio:=FALSE;											
			iMainMode:=1;			
		 END_IF	
					
	ELSIF bBelt1Gearask AND bBelt2Gearask AND NOT bBelt3Gearask THEN //分段1/2运行		
			IF NOT bBelt1Taking   AND NOT   bBelt2Taking     THEN
				bSubBelt2fratio:=TRUE;
				bSubBelt3fratio:=FALSE;																
				iMainMode:=2;
			ELSE
				bSubBelt2fratio:=FALSE;
				bSubBelt3fratio:=FALSE;										
				iMainMode:=1;									
			END_IF	
	ELSIF bBelt1Gearask AND bBelt2Gearask AND bBelt3Gearask THEN //分段1/2/3运行		
			IF NOT bBelt1Taking AND NOT bBelt2Taking  AND   NOT bBelt3Taking    THEN
				bSubBelt2fratio:=TRUE;
				bSubBelt3fratio:=TRUE;
				iMainMode:=2;															
			ELSE
				bSubBelt2fratio:=FALSE;
				bSubBelt3fratio:=FALSE;												
				iMainMode:=1;									
			END_IF						
	END_IF
	
	iPoleNoHave2:=iPoleNoHaveA;
	iAutoRunStep:=2020;
END_IF
2020://判断运行模式,主轴静止中
	IF iMainMode=1 THEN
		iAutoRunStep:=450;//等待主轴停止
	ELSE
		IF iPoleNoHave2=1 THEN
			iAutoRunStep:=420;//再走一个周期
		ELSIF iPoleNoHave2=2 THEN
			bFlgStoping:=FALSE;
			IF arrAxisCtrl[VirAxisNo.VirMain].Status.Moving THEN
				iAutoRunStep:=150;//再走多个周期
			ELSE
				arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Velo:=PolePar.iMainVel*6;
				arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveVelo:=TRUE;
			END_IF
		ELSIF iPoleNoHave2=0 THEN
			iAutoRunStep:=450;///等待主轴停止
		END_IF
	END_IF
    bBelt1Gearask:=FALSE;
	bBelt2Gearask:=FALSE;
	bBelt3Gearask:=FALSE;			
END_CASE
*)
]]></ST>
      </Implementation>
    </Action>
    <Action Name="F0503MainAuto3" Id="{03bd2d44-14eb-4799-82e4-91e79713d961}" FolderPath="F05Auto\">
      <Implementation>
        <ST><![CDATA[
///////////////////////////////////////////////////////驱&皮带运动开始，纠偏&除尘&阀类等动作////////////////////////////////////////////////////////
CASE iAutoRunStep OF 
3000:
	InterPart.M1Allow2:=FALSE;//三个叠台通用
	iAutoRunStep:=3010;
3010://
	arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[2]:=arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1]+fArvTransverData-Polepar.fMouldX_Offset;
	iAutoRunStep:=3020;
3020://纠偏&除尘
//模具X纠偏
	//arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[2]:=arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1]-Polepar.fMouldX_Offset;
	IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bMouldXOffsetEN THEN
		IF NOT arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.arrbRealPoint[2] THEN
			arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bDynamitcsParSel:=2;
			arrAxisPar[AxisNo.MouldRectify_X].fTagatTime:=0.65*60/PolePar.iMainVel;
			arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.iGoSetPos:=2;
		END_IF
	ELSE
		IF NOT arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.arrbRealPoint[1] THEN
			arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bDynamitcsParSel:=2;
			arrAxisPar[AxisNo.MouldRectify_X].fTagatTime:=0.65*60/PolePar.iMainVel;
			arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.iGoSetPos:=1;
		END_IF	
	END_IF	

//裁切角度纠偏
	arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[2]:=arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[1]-Polepar.fDegreeRectify;
	IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bDegreeRecEN THEN
		IF NOT arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.arrbRealPoint[2]  THEN
			arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bDynamitcsParSel:=2;
			arrAxisPar[AxisNo.CuterDegRectify].fTagatTime:=0.65*60/PolePar.iMainVel;
			arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.iGoSetPos:=2;
		END_IF
	ELSE
		IF NOT arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.arrbRealPoint[1] THEN
			arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.bDynamitcsParSel:=2;
			arrAxisPar[AxisNo.CuterDegRectify].fTagatTime:=0.65*60/PolePar.iMainVel;			
			arrAxisCtrl[AxisNo.CuterDegRectify].Cmd.iGoSetPos:=1;
		END_IF	
	END_IF	
   iAutoRunStep:=3025;
	
3025:
  IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=11  THEN  	
	 fbDriverCam.fCompensation:=0;
	 fPoleBufferCompensation:=0;																								
	 fbUwindTen.fCompensation:=0;																					
	 fbAuxDriverTen.fCompensation:=0;		
	 iAutoRunStep:=3030;
   END_IF
3030:	
	IF NOT ProductPar.iModeEN.bEmptyRunEN    THEN	//AND bMA15
		IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=40  THEN   
			IF  stSenser.biSubBelt1Have    AND  NOT    BeltData[BeltNo.SubBelt1-1].bHavePole    THEN//tonAuto[2].Q 
				BeltData[BeltNo.SubBelt1-1].bHavePole:=TRUE;
				iPeaceAlarmCount1:=iPeaceAlarmCount1+1;     //记忆与检测异常计数
			ELSIF NOT stSenser.biSubBelt1Have AND   BeltData[BeltNo.SubBelt1-1].bHavePole   THEN  //tonAuto[3].Q 
				BeltData[BeltNo.SubBelt1-1].bHavePole:=FALSE;
				iPeaceAlarmCount1:=iPeaceAlarmCount1+1;	   //记忆与检测异常计数
			ELSIF (stSenser.biSubBelt1Have  AND  BeltData[BeltNo.SubBelt1-1].bHavePole) THEN//tonAuto[2].Q 
				iPeaceAlarmCount1:=0;	   //记忆与检测异常计数
			END_IF
			
			IF stSenser.biSubBelt2Have      AND  NOT    BeltData[BeltNo.SubBelt2-1].bHavePole    THEN//tonAuto[4].Q 
				BeltData[BeltNo.SubBelt2-1].bHavePole:=TRUE;
				iPeaceAlarmCount2:=iPeaceAlarmCount2+1;  //记忆与检测异常计数
			ELSIF NOT stSenser.biSubBelt2Have AND              BeltData[BeltNo.SubBelt2-1].bHavePole   THEN//tonAuto[5].Q 
				BeltData[BeltNo.SubBelt2-1].bHavePole:=FALSE;
				iPeaceAlarmCount2:=iPeaceAlarmCount2+1;  //记忆与检测异常计数
			ELSIF (stSenser.biSubBelt2Have      AND  BeltData[BeltNo.SubBelt2-1].bHavePole) THEN//tonAuto[4].Q 
				iPeaceAlarmCount2:=0;  //记忆与检测异常计数
			END_IF		
			
			IF stSenser.biSubBelt3Have   AND  NOT    BeltData[BeltNo.SubBelt3-1].bHavePole    THEN//tonAuto[6].Q 
				BeltData[BeltNo.SubBelt3-1].bHavePole:=TRUE;
				iPeaceAlarmCount3:=iPeaceAlarmCount3+1;  //记忆与检测异常计数
			ELSIF NOT stSenser.biSubBelt3Have AND              BeltData[BeltNo.SubBelt3-1].bHavePole   THEN//tonAuto[7].Q 
				BeltData[BeltNo.SubBelt3-1].bHavePole:=FALSE;
				iPeaceAlarmCount3:=iPeaceAlarmCount3+1;  //记忆与检测异常计数
			ELSIF (stSenser.biSubBelt3Have  AND BeltData[BeltNo.SubBelt3-1].bHavePole  ) THEN//tonAuto[6].Q 
				iPeaceAlarmCount3:=0;  //记忆与检测异常计数
			END_IF	
			 IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=60  THEN 
				iAutoRunStep:=3100;	 
			 END_IF	
	      END_IF 
	ELSE
		iAutoRunStep:=3100;	
	END_IF
	
	
3100:
	CCD_COM.Scan.bLineScanNG:=FALSE;
    IF  iMainVel<=80 THEN
		nInt[1]:=20;
	ELSIF iMainVel>80  AND  iMainVel<=120 THEN
	    nInt[1]:=25;
	ELSIF iMainVel>120  AND  iMainVel<=150 THEN
	    nInt[1]:=30;		
	ELSIF iMainVel>150  AND  iMainVel<=180 THEN
	    nInt[1]:=36;	
   ELSE
	     nInt[1]:=36;	
	END_IF
	
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=ProductPar.parPublic.fMainPos-nInt[1] THEN  //nInt[1]*6/iMainVel 
		iAutoRunStep:=3200;
	END_IF	

3200://皮带数据提前移位
	IF bSubBelt3fratio AND fbSubBelt3Gear.InGear THEN																									
		FOR i1:=1 TO 41-BeltNo.SubBelt2 BY 1 DO 																								
			IF i1<41-BeltNo.SubBelt2 THEN 																							
				BeltData[41-i1]:=BeltData[40-i1];																						
			END_IF; 																							
	   	END_FOR; 																									
	END_IF																									
	IF bSubBelt2fratio AND fbSubBelt2Gear.InGear THEN																									
		FOR i1:=1 TO BeltNo.SubBelt2-BeltNo.SubBelt1+1 BY 1 DO 																								
			IF i1<BeltNo.SubBelt2-BeltNo.SubBelt1+1 THEN 																							
				BeltData[BeltNo.SubBelt2+1-i1]:=BeltData[BeltNo.SubBelt2-i1];																						
			END_IF; 																							
	   	END_FOR; 																									
	END_IF																									
	IF bSubBelt1fratio AND fbSubBelt1Gear.InGear THEN																									
		FOR i1:=1 TO BeltNo.SubBelt1-BeltNo.WindDustD+1 BY 1 DO 																								
			IF i1<BeltNo.SubBelt1-BeltNo.WindDustD+1 THEN 																							
				 BeltData[BeltNo.SubBelt1+1-i1]:=BeltData[BeltNo.SubBelt1-i1];																						
			END_IF; 																							
		END_FOR; 																								
	END_IF			
	iAutoRunStep:=3300;	
	
		
		
3300://150度收结果，此时当前片线扫未结束，收上一片的结果
 IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=ProductPar.parPublic.fMainPos-15 THEN
		//线扫控制模式选择及线扫结果判断
		IF ProductPar.iLineScanSel THEN
			
		  IF CCD_COM.Scan.iResult_UP<>33 AND CCD_COM.Scan.iResult_Down<>33 THEN
			  //上线扫结果判断	
				FOR i1:=1 TO 20 BY 1 DO 																									
					IF i1<20 THEN 																							
						 XianSaong_Up[20-i1]:=XianSaong_Up[19-i1];																						
					ELSE																				
						XianSaong_Up[0]:=CCD_COM.Scan.iResult_UP;																											
					END_IF; 																							
				 END_FOR; 
		  
		
			//下线扫结果判断	
				FOR i1:=1 TO 20 BY 1 DO 																									
					IF i1<20 THEN 																							
						 XianSaong_Down[20-i1]:=XianSaong_Down[19-i1];																						
					ELSE																						
						XianSaong_Down[0]:= CCD_COM.Scan.iResult_Down;																									
					END_IF; 																							
				 END_FOR;
		  END_IF		 
				 
					 
			IF  CCD_COM.Scan.iResult_UP<>33 AND CCD_COM.Scan.iResult_Down<>33 THEN
				 IF XianSaong_Down[0]=30 AND XianSaong_Up[1]=30 THEN//---------------------------------线扫OK结果由8改为30，，，CCD需要同步更改
					BeltData[BeltNo.NGBox1+1].fPoleNGSacnNo:=30; //线扫NG类型
			ELSE
					//剔废前一工位汇总结果，5号位置，，，，，剔废工位为6
						IF XianSaong_Down[0]<>30 AND XianSaong_Up[1]=30 THEN
							BeltData[BeltNo.NGBox1+1].fPoleNGSacnNo:=XianSaong_Down[0];
						END_IF
		
						IF XianSaong_Down[0]=30 AND XianSaong_Up[1]<>30 THEN
							BeltData[BeltNo.NGBox1+1].fPoleNGSacnNo:=XianSaong_Up[1];
						END_IF
		
						IF XianSaong_Down[0]<>30 AND XianSaong_Up[1]<>30 THEN
							BeltData[BeltNo.NGBox1+1].fPoleNGSacnNo:=XianSaong_Up[1];
						END_IF				
		          END_IF	
				  bFlgLineScanOver:=FALSE;
            ELSE 
	               bFlgLineScanOver:=TRUE;
		    END_IF
				  	  
			 //上、下线扫结果发送超时	
			CCD_COM.Scan.iResult;
			CCD_COM.Scan.iResult_UP; 
			CCD_COM.Scan.iResult_Down;
			CCD_COM.Scan.iResult_Start:=FALSE;//线扫软启动
			
		ELSE//线扫结果改 IO 控制
				//上线扫结果判断	
				 IF NOT bLineScanResult1_UP AND NOT bLineScanResult2_UP THEN //无效值
				 CCD_COM.Scan.iResult_IO_UP:=33;
				 ELSIF bLineScanResult1_UP AND NOT bLineScanResult2_UP THEN //OK
				 CCD_COM.Scan.iResult_IO_UP:=30;
				 ELSIF NOT bLineScanResult1_UP AND bLineScanResult2_UP THEN	// NG
				 CCD_COM.Scan.iResult_IO_UP:=31;
				 ELSIF bLineScanResult1_UP AND bLineScanResult2_UP THEN	 //无效值
				 CCD_COM.Scan.iResult_IO_UP:=33;
				 END_IF
				//下线扫结果判断	
				 IF NOT bLineScanResult1_Down AND NOT bLineScanResult2_Down THEN //无效值
				 CCD_COM.Scan.iResult_IO_Down:=33;
				 ELSIF bLineScanResult1_Down AND NOT bLineScanResult2_Down THEN //OK
				 CCD_COM.Scan.iResult_IO_Down:=30;
				 ELSIF NOT bLineScanResult1_Down AND bLineScanResult2_Down THEN	// NG
				 CCD_COM.Scan.iResult_IO_Down:=31;
				 ELSIF bLineScanResult1_Down AND bLineScanResult2_Down THEN	 //无效值
				 CCD_COM.Scan.iResult_IO_Down:=33;
				 END_IF
				
			IF  CCD_COM.Scan.iResult_IO_UP<>33 AND CCD_COM.Scan.iResult_IO_Down<>33 THEN	
				FOR i1:=1 TO 20 BY 1 DO 																									
					IF i1<20 THEN
						 XianSaong_Up[20-i1]:=XianSaong_Up[19-i1];																						
					ELSE																				
						XianSaong_Up[0]:=CCD_COM.Scan.iResult_IO_UP;																											
					END_IF; 																							
				 END_FOR; 
				
		
				FOR i1:=1 TO 20 BY 1 DO 																									
					IF i1<20 THEN
						 XianSaong_Down[20-i1]:=XianSaong_Down[19-i1];																						
					ELSE																						
						XianSaong_Down[0]:=CCD_COM.Scan.iResult_IO_Down;																									
					END_IF; 																							
				 END_FOR;
			END_IF	
				 
			IF  CCD_COM.Scan.iResult_IO_UP<>33 AND CCD_COM.Scan.iResult_IO_Down<>33 THEN
				 IF XianSaong_Down[0]=30 AND XianSaong_Up[1]=30 THEN//---------------------------------线扫OK结果由8改为30，，，CCD需要同步更改
					BeltData[BeltNo.NGBox1+1].fPoleNGSacnNo:=30; //线扫NG类型
				 ELSE
					//剔废前一工位汇总结果，5号位置，，，，，剔废工位为6
						IF XianSaong_Down[0]<>30 AND XianSaong_Up[1]=30 THEN
							BeltData[BeltNo.NGBox1+1].fPoleNGSacnNo:=XianSaong_Down[0];
						END_IF
		
						IF XianSaong_Down[0]=30 AND XianSaong_Up[1]<>30 THEN
							BeltData[BeltNo.NGBox1+1].fPoleNGSacnNo:=XianSaong_Up[1];
						END_IF
		
						IF XianSaong_Down[0]<>30 AND XianSaong_Up[1]<>30 THEN
							BeltData[BeltNo.NGBox1+1].fPoleNGSacnNo:=XianSaong_Up[1];
						END_IF			
				 END_IF	
				  bFlgLineScanOver:=FALSE;
			ELSE
                  bFlgLineScanOver:=TRUE;
	        END_IF
				 
					 //上、下线扫结果发送超时	
					CCD_COM.Scan.iResult;
					CCD_COM.Scan.iResult_IO_UP; 
					CCD_COM.Scan.iResult_IO_Down;
					CCD_COM.Scan.iResult_Start:=FALSE;//线扫软启动
		END_IF
				
			iAutoRunStep:=3400;
END_IF
		

3400://取料允许判断
	///////////////////////取料允许判断/////////////////////////																																														
	IF iPoleCarryEver=3 THEN
		IF BeltData[BeltNo.SubBelt1].bHavePole //AND (BeltData[BeltNo.SubBelt1].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN)
			AND BeltData[BeltNo.SubBelt2].bHavePole //AND (BeltData[BeltNo.SubBelt2].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN)
			AND BeltData[BeltNo.SubBelt3].bHavePole THEN//AND (BeltData[BeltNo.SubBelt3].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN) THEN
			InterPart.M1Allow2:=TRUE;//三个叠台通用
			iAutoAuxStep9:=100;	
		END_IF																						
	ELSIF iPoleCarryEver=2 THEN																									
		IF BeltData[BeltNo.SubBelt1].bHavePole //AND (BeltData[BeltNo.SubBelt1].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN)
			AND BeltData[BeltNo.SubBelt2].bHavePole THEN//AND (BeltData[BeltNo.SubBelt2].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN) THEN																								
			IF NOT bBelt1Taking THEN																							
				iAutoAuxStep6:=10;																						
				//bBelt1Taking:=TRUE;																						
			END_IF																							
		END_IF																								
		IF BeltData[BeltNo.SubBelt2].bHavePole THEN//AND (BeltData[BeltNo.SubBelt2].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN) THEN																								
			IF NOT bBelt2Taking THEN																							
				iAutoAuxStep7:=10;																						
				//bBelt2Taking:=TRUE;																						
			END_IF																							
		END_IF																								
	ELSE																									
		IF BeltData[BeltNo.SubBelt1].bHavePole AND (BeltData[BeltNo.SubBelt1].stPoleNo<>'' OR ProductPar.iModeEN.bCcdTcpEN OR ProductPar.iModeEN.bSizeCCDEN) THEN// (BeltData[BeltNo.SubBelt1].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN) THEN																								
			IF NOT bBelt1Taking THEN																							
				iAutoAuxStep6:=10;																						
				//bBelt1Taking:=TRUE;																						
			END_IF																							
		END_IF																								
	END_IF	
	iAutoRunStep:=300;	
	
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="F0504MainAuto4" Id="{3d3a323e-c4a0-4052-8891-4bef7111eefe}" FolderPath="F05Auto\">
      <Implementation>
        <ST><![CDATA[									
(*模切数据传出3个叠台获取极片数据*)
AnMQ_MES1:=AnPart.fbAnPart.BeltData[14];
CaMQ_MES1:=CaPart.fbCaPart.BeltData[12];
AnMQ_MES2:=AnPart.fbAnPart.BeltData[22];
CaMQ_MES2:=CaPart.fbCaPart.BeltData[20];
AnMQ_MES3:=AnPart.fbAnPart.BeltData[30];
CaMQ_MES3:=CaPart.fbCaPart.BeltData[28];

 PolePar.fYellowBreadth:=55;														
////////////////////////////////////////////主驱&皮带运动停止，CCD&皮带/间距/极耳数据处理&叠片交互&纠偏/补偿计算&凸轮切换等动作/////////////////////////////////////////////																										
CASE iAutoRunStep OF 		
(*************************************************************************数据移位********************************************************************************************)																																																	
4000://数据移位		
	//黄标标志数据移位
	FOR i10:=1 TO 30 BY 1 DO
		IF i10<30 THEN 		
			aYellowMark[31-i10]:=aYellowMark[30-i10];
		ELSE
			aYellowMark[1]:=FALSE;
		END_IF
	END_FOR
	//黄标R角跳切标记记录移位
	FOR i11:=1 TO 30 BY 1 DO
		IF i11<30 THEN 		
			aYellowJump_R[31-i11]:=aYellowJump_R[30-i11];
		ELSE
			aYellowJump_R[1]:=FALSE;
		END_IF
	END_FOR
	//黄标裁切跳切标记记录移位
	FOR i12:=1 TO 30 BY 1 DO
		IF i12<30 THEN 		
			aYellowJump_C[31-i12]:=aYellowJump_C[30-i12];
		ELSE
			aYellowJump_C[1]:=FALSE;
		END_IF
	END_FOR

	
	//接带标志数据移位
	FOR i10:=1 TO 30 BY 1 DO
		IF i10<30 THEN 		
			aTapeMark[31-i10]:=aTapeMark[30-i10];
		ELSE
			aTapeMark[1]:=FALSE;
		END_IF
	END_FOR
	//黄标R角跳切标记记录移位
	FOR i11:=1 TO 30 BY 1 DO
		IF i11<30 THEN 		
			aTapeJump_R[31-i11]:=aTapeJump_R[30-i11];
		ELSE
			aTapeJump_R[1]:=FALSE;
		END_IF
	END_FOR
	//黄标裁切跳切标记记录移位
	FOR i12:=1 TO 30 BY 1 DO
		IF i12<30 THEN 		
			aTapeJump_C[31-i12]:=aTapeJump_C[30-i12];
		ELSE
			aTapeJump_C[1]:=FALSE;
		END_IF
	END_FOR	
	
	
	//极耳检测跳切
	FOR i:=9 TO 0 BY -1 DO
		CutMark_R[i+1]:=CutMark_R[i];
	END_FOR
	 arrAxisCtrl[AxisNo.MouldRectify_X].Cmd.bStop:=TRUE;					
	FOR i1:=1 TO BeltNo.WindDustD BY 1 DO 																									
		IF i1<BeltNo.WindDustD THEN 																							
			 BeltData[BeltNo.WindDustD+1-i1]:=BeltData[BeltNo.WindDustD-i1];																						
		ELSE																							
			 BeltData[1].bHavePole:=FALSE;																						
			 BeltData[1].stPoleNo:='';																						
			 BeltData[1].iPanoramaNG:=0;																						
			 BeltData[1].fPoleHeigh:=0;																						
			 BeltData[1].fPoleWidth:=0;																						
			 BeltData[1].iJumpCutNG:=0;																						
		END_IF; 																							
	END_FOR; 
	
	//裁断前数据移位
	IF 	arrAxis[AxisNo.DriverDDR].Status.Coupled THEN	//主驱不在耦合中，切断前数据不移位，首位不置1
		BeltData[1].bHavePole:=TRUE;																					
		FOR i1:=1 TO 20 BY 1 DO 																									
			IF i1<20 THEN 																							
				 TabData[21-i1]:=TabData[20-i1];																						
				 InteData[21-i1]:=InteData[20-i1];																						
			ELSE																							
				TabData[1].fPhotoPosM:=0;																						
				TabData[1].fPhotoPosC:=0;																						
				TabData[1].fTab_OffsetM:=0;																						
				TabData[1].fTab_OffsetC:=0;																						
				InteData[1].fTabIntervalM:=0;																						
				InteData[1].fTabIntervalC:=0;																						
			END_IF; 																							
		END_FOR; 
	END_IF
		FOR i:=10 TO 2 BY -1 DO
			fBelt1Pos[i]:=fBelt1Pos[i-1];
			fBelt2Pos[i]:=fBelt2Pos[i-1];
			fBelt3Pos[i]:=fBelt3Pos[i-1];
		END_FOR
		fBelt1Pos[1]:=arrAxis[AxisNo.SubBelt1].NcToPlc.ActPos-fBelt1Pos[0];
		IF bSubBelt2fratio THEN
			fBelt2Pos[1]:=arrAxis[AxisNo.SubBelt2].NcToPlc.ActPos-fBelt2Pos[0];
		END_IF
		IF bSubBelt3fratio THEN
			fBelt3Pos[1]:=arrAxis[AxisNo.SubBelt3].NcToPlc.ActPos-fBelt3Pos[0];
		END_IF
																	
	iAutoRunStep:=4005;	
																						
4005:
  (****************黄标*********************)
	//t跳切连续两片黄标置位
	IF NOT aYellowMark[5] AND   aYellowJump_R[6] AND aYellowMark[6] THEN
		aYellowMark[5]:=TRUE;
	END_IF
	//裁断后极片黄标标志,,,用于后期踢废
	IF aYellowMark[7] THEN
		BeltData[1].bYellowMark:=TRUE;
	ELSE
		BeltData[1].bYellowMark:=FALSE;
	END_IF
	
	(****************接带*********************)
		//t跳切连续两片黄标置位
	IF NOT aTapeMark[5] AND   aTapeJump_R[6] AND aTapeMark[6] THEN
		aTapeMark[5]:=TRUE;
	END_IF
	//裁断后极片黄标标志,,,用于后期踢废
	IF aTapeMark[7] THEN
		BeltData[1].bBlueMark:=TRUE;
	ELSE
		BeltData[1].bBlueMark:=FALSE;
	END_IF
	fBelt1Pos[0]:=arrAxis[AxisNo.SubBelt1].NcToPlc.ActPos;
	fBelt2Pos[0]:=arrAxis[AxisNo.SubBelt2].NcToPlc.ActPos;
	fBelt3Pos[0]:=arrAxis[AxisNo.SubBelt3].NcToPlc.ActPos;		
	iAutoRunStep:=4010;																									
4010://主驱&皮带运动停止后动作																										
	IF iNormalCuter>=1 THEN																									
		bJumpCut:=FALSE;																								
	END_IF	
	
(*************************************************************************CCD拍照触发*********************************************************************************************)																								
//尺寸检测
	CCD_Rounde.CCD_Enable:=FALSE;//R纠偏闭环数据记录开始																											
	IF BeltData[BeltNo.OverHang].bHavePole  AND NOT ProductPar.iModeEN.bSizeCCDEN AND NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN THEN		//AND BeltData[BeltNo.OverHang].iJumpCutNG=1																							
		CCD_IO.boSizePhoto:=TRUE;																										
		fRecordOverHangInMainPos:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos;																								
		fRecordOverHangInMainPosMod:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos;		
		MEMSET(ADR(CCD_COM.Size),0,SIZEOF(CCD_COM.Size));
		CCD_COM.Size.fPoleNGSizeNo:=33;			//1203SJ			
												
		CCD_COM.Size.iFinish:=0;																								
		iAutoAuxStep3:=10;																								
	END_IF																				
					
//冲R角定位检测																							
	IF NOT ProductPar.iModeEN.bChamferCCDEN AND NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN THEN																									
		CCD_IO.boChamferPhoto:=TRUE;																								
		fRecordMouldCCDInMainPos:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos;																								
		fRecordMouldCCDInMainPosMod:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos;																								
		TabData[TabNo.MouldPhoto].fPhotoPosM:=fDriverDDRActPos;		
		TabData[TabNo.MouldPhoto].bCCDed_M:=TRUE;		
		TabData[TabNo.MouldPhoto].bTabOffsetNG_M:=FALSE;	
		MEMSET(ADR(CCD_COM.Chamfer),0,SIZEOF(CCD_COM.Chamfer));																		
		CCD_COM.Chamfer.iFinish:=0;																								
		iAutoAuxStep4:=10;																								
	END_IF																									
//裁切定位检测																								
	IF NOT ProductPar.iModeEN.bCuterCCDEN AND NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN AND TabData[TabNo.CuterPhoto].bCCDed_M THEN																									
		CCD_IO.boCuterPhoto:=TRUE;																								
		fRecordCuterCCDInMainPos:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos;																								
		fRecordCuterCCDInMainPosMod:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos;																								
		TabData[TabNo.CuterPhoto].fPhotoPosC:=fDriverDDRActPos;
		InteData[InteNo.Cuter-2].bIntervalFail_C:=FALSE;
		TabData[TabNo.CuterPhoto].bTabOffsetNG_C:=FALSE;	
		TabData[TabNo.CuterPhoto].bCCDed_C:=TRUE;																							
		CCD_COM.Cuter.iFinish:=0;																								
		iAutoAuxStep5:=10;																								
	END_IF																									
																				
	//************************************************************************NG踢废********************************************************************************************																									
	IF  (NOT ProductPar.iModeEN.bSizeCCDEN AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>30  
		AND NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN ) 		 
		OR			
	 	( BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo <>30 AND NOT bFlgLineScanOver AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN AND NOT ProductPar.iModeEN.bEmptyRunEN)  
		OR  
		(BeltData[BeltNo.NGBox1+2].bYellowMark)  OR 
         (BeltData[BeltNo.NGBox1+2].bBlueMark)  THEN	
		NG_Sum:=NG_Sum+1;
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=TRUE;//踢NG料打开
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=FALSE;//踢NG料关闭		
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bON:=FALSE;//踢NG料真空打开
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bOFF:=TRUE;//踢NG料真空关闭																	
		BeltData[BeltNo.NGBox1+2].bHavePole:=FALSE;	
		BeltData[BeltNo.NGBox1+2].stPoleNo:='';																							
	ELSE	
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=FALSE;//踢NG料打开
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=TRUE;//踢NG料关闭		
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bON:=TRUE;//踢NG料真空打开
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bOFF:=FALSE;//踢NG料真空关闭																					
	END_IF		
												
	//iNGStep:=10;
	(*IF BeltData[BeltNo.NGBox1+2].bYellowMark THEN
		Production.NGFlag[33]:=TRUE;//感应器黄标计数;
	END_IF	*)	
																
																																																																	
(*************************************************************************裁切补偿，R角补偿计算********************************************************************************************)																									
IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN THEN				
	(*
		//////////////////////驱动辊补偿量////////////V1////////////	
	 IF  NOT   bFlgTabPosOver THEN		
			 IF TabData[TabNo.CuterPhoto+2].bCCDed_C AND NOT TabData[TabNo.CuterPhoto+2].bTabOffsetNG_C THEN
							fDriverOffset7:=TabData[TabNo.CuterPhoto+2].fTab_OffsetC-(fDriverOffsetData[1]+fDriverOffsetData[2]);
			ELSE
						   IF ABS(fDriverOffsetData[1])<0.4 THEN
								fDriverOffset7:=fDriverOffsetData[1]*0.8;
							ELSIF ABS(fDriverOffsetData[2])<0.4 THEN
								fDriverOffset7:=fDriverOffsetData[2]*0.8;
							ELSE
								fDriverOffset7:=0;
							END_IF
			 END_IF 	
			
			IF ABS(fDriverOffset7)<10 THEN
							IF ABS(fDriverOffset7)<0.6 THEN
								Polepar.fPoleWithOffset:=LIMIT(-0.35, fDriverOffset7,0.35);
							ELSE
								Polepar.fPoleWithOffset:=fDriverOffset7;  
							END_IF
			ELSE
							IF fDriverOffset7>0 THEN
								Polepar.fPoleWithOffset:=10;
							ELSIF fDriverOffset7<0 THEN
								Polepar.fPoleWithOffset:=-10;
							END_IF	
			END_IF	

	  ELSE
					 fDriverOffset7:=fDriverOffset;
					 Polepar.fPoleWithOffset:=LIMIT(-23,fDriverOffset7,23);	
	  END_IF	
	  *)
	

	  TabData[TabNo.CuterPhoto].fTab_OffsetC;  //
	  fTab_OffsetC; //裁切下个工位反馈的极耳偏移量
		//////////////////////驱动辊补偿量////////////V1////////////			
		IF TabData[TabNo.CuterPhoto+2].bCCDed_C AND NOT TabData[TabNo.CuterPhoto+2].bTabOffsetNG_C THEN
			fDriverOffset7:=TabData[TabNo.CuterPhoto+2].fTab_OffsetC-(fDriverOffsetData[1]+fDriverOffsetData[2]);
		ELSE
			IF ABS(fDriverOffsetData[1])<0.4 THEN
				fDriverOffset7:=fDriverOffsetData[1]*0.8;
			ELSIF ABS(fDriverOffsetData[2])<0.4 THEN
				fDriverOffset7:=fDriverOffsetData[2]*0.8;
			ELSE
				fDriverOffset7:=0;
			END_IF
		END_IF 		
			
			
IF NOT 	bMA1	 THEN	
	IF  NOT   bFlgTabPosOver THEN		//计算当前片下个周期补偿量   	 
				IF ABS(fDriverOffset7)<15 THEN
								IF ABS(fDriverOffset7)<1 THEN
									//bMA1:=FALSE;
									Polepar.fPoleWithOffset:=LIMIT(-0.35, fDriverOffset7,0.35);
								ELSE
									 bMA1:=TRUE;
									 iFlgCompCount:=3;
									 iCompCount:=3;
									 arrOffset[3]:=fDriverOffset7;//+fArvDriverOffsetData ;
									 arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;	  
									//Polepar.fPoleWithOffset:=fDriverOffset7    ;  
								END_IF		
				ELSE
								iCount20:=iCount20+1;
								 IF  ABS(fDriverOffset7)>15   AND  ABS(fDriverOffset7)<30 THEN
									  iFlgCompCount:=4;
									  iCompCount:=4;
									   bMA1:=TRUE;
									  arrOffset[4]:= SEL( fDriverOffset7>0,-15,15 )  ;
		                                                         arrOffset[3]:=SEL(fDriverOffset7>0,   fDriverOffset7+15  , fDriverOffset7-15 )  ;                         
	                                                                arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;	  
								 ELSIF ABS(fDriverOffset7)>30   AND  ABS(fDriverOffset7)<45 THEN
									   iFlgCompCount:=5;
									   iCompCount:=5;
									    bMA1:=TRUE;
									   arrOffset[5]:=SEL( fDriverOffset7>0,-15,15 ) ;
									   arrOffset[4]:=SEL( fDriverOffset7>0,-15,15 ) ;
		                                                           arrOffset[3]:=SEL(fDriverOffset7>0,   fDriverOffset7+30  , fDriverOffset7-30 )  ;       
	                                                                    arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;	  	
		 										 
								 ELSIF ABS(fDriverOffset7)>45   AND ABS(fDriverOffset7)<60 THEN
									   iFlgCompCount:=6;		
									    iCompCount:=6;	
									     bMA1:=TRUE;
									   arrOffset[6]:=SEL( fDriverOffset7>0,-15,15 ) ;
									   arrOffset[5]:=SEL( fDriverOffset7>0,-15,15 ) ;
									   arrOffset[4]:=SEL( fDriverOffset7>0,-15,15 ) ;									   
		                                                           arrOffset[3]:=SEL(fDriverOffset7>0,   fDriverOffset7+45  , fDriverOffset7-45 )  ;    
	                                                                  arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;	  		 
								 ELSIF ABS(fDriverOffset7)>60   AND  ABS(fDriverOffset7)<75 THEN
									   iFlgCompCount:=7;		
									   iCompCount:=7;	
                                                                          bMA1:=TRUE;	 
									   arrOffset[7]:=SEL( fDriverOffset7>0,-15,15 ) ;
									   arrOffset[6]:=SEL( fDriverOffset7>0,-15,15 ) ;
									   arrOffset[5]:=SEL( fDriverOffset7>0,-15,15 ) ;		
									   arrOffset[4]:=SEL( fDriverOffset7>0,-15,15 ) ;						   
		                                                            arrOffset[3]:=SEL(fDriverOffset7>0,   fDriverOffset7+60  , fDriverOffset7-60 )  ;    
	                                                                   arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;										   
								ELSIF  ABS(fDriverOffset7)>75  THEN
									   iFlgCompCount:=7;		
									   iCompCount:=7;	
                                                                           bMA1:=TRUE;	 
									   arrOffset[7]:=SEL( fDriverOffset7>0,-15,15 ) ;
									   arrOffset[6]:=SEL( fDriverOffset7>0,-15,15 ) ;
									   arrOffset[5]:=SEL( fDriverOffset7>0,-15,15 ) ;		
									   arrOffset[4]:=SEL( fDriverOffset7>0,-15,15 ) ;						   
		                                                           arrOffset[3]:=SEL(fDriverOffset7>0,   fDriverOffset7+60  , fDriverOffset7-60 )  ;    
	                                                                  arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;		      
								 END_IF
								
				END_IF	
	ELSE	
					                       fDriverOffset7:=fDriverOffset;
								 IF  ABS(fDriverOffset7)>30   AND  ABS(fDriverOffset7)<60 THEN
									  iFlgCompCount:=4;
									  iCompCount:=4;
									   bMA1:=TRUE;
									  arrOffset[4]:= SEL( fDriverOffset7>0,-30,30 )  ;
		                                                         arrOffset[3]:=SEL(fDriverOffset7>0,   fDriverOffset7+30  , fDriverOffset7-30 )  ;                         
	                                                                arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;	  
								 ELSIF ABS(fDriverOffset7)>60   AND  ABS(fDriverOffset7)<90 THEN
									   iFlgCompCount:=5;
									   iCompCount:=5;
									    bMA1:=TRUE;
									   arrOffset[5]:=SEL( fDriverOffset7>0,-30,30 ) ;
									   arrOffset[4]:=SEL( fDriverOffset7>0,-30,30 ) ;
		                                                           arrOffset[3]:=SEL(fDriverOffset7>0,   fDriverOffset7+60  , fDriverOffset7-60 )  ;       
	                                                                    arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;	  	
		 										 
								 ELSIF ABS(fDriverOffset7)>90   AND ABS(fDriverOffset7)<120 THEN
									   iFlgCompCount:=6;		
									    iCompCount:=6;	
									     bMA1:=TRUE;
									   arrOffset[6]:=SEL( fDriverOffset7>0,-30,30 ) ;
									   arrOffset[5]:=SEL( fDriverOffset7>0,-30,30 ) ;
									   arrOffset[4]:=SEL( fDriverOffset7>0,-30,30 ) ;									   
		                                                           arrOffset[3]:=SEL(fDriverOffset7>0,   fDriverOffset7+90  , fDriverOffset7-90 )  ;    
	                                                                  arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;	  		 
								 ELSIF ABS(fDriverOffset7)>120   AND  ABS(fDriverOffset7)<150 THEN
									   iFlgCompCount:=7;		
									   iCompCount:=7;	
                                                                          bMA1:=TRUE;	 
									   arrOffset[7]:=SEL( fDriverOffset7>0,-30,30 ) ;
									   arrOffset[6]:=SEL( fDriverOffset7>0,-30,30 ) ;
									   arrOffset[5]:=SEL( fDriverOffset7>0,-30,30 ) ;		
									   arrOffset[4]:=SEL( fDriverOffset7>0,-30,30 ) ;						   
		                                                            arrOffset[3]:=SEL(fDriverOffset7>0,   fDriverOffset7+120  , fDriverOffset7-120 )  ;    
	                                                                   arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;										   
								ELSIF  ABS(fDriverOffset7)>150  THEN
						                           iFlgCompCount:=7;		
									   iCompCount:=7;	
                                                                           bMA1:=TRUE;	 
									   arrOffset[7]:=SEL( fDriverOffset7>0,-30,30 ) ;
									   arrOffset[6]:=SEL( fDriverOffset7>0,-30,30 ) ;
									   arrOffset[5]:=SEL( fDriverOffset7>0,-30,30 ) ;		
									   arrOffset[4]:=SEL( fDriverOffset7>0,-30,30 ) ;						   
		                                                            arrOffset[3]:=SEL(fDriverOffset7>0,   fDriverOffset7+120  , fDriverOffset7-120 )  ;    
	                                                                   arrOffset[2]:=arrOffset[1]:=fArvDriverOffsetData;			      
								 END_IF								 
					                //Polepar.fPoleWithOffset:=LIMIT(-23,fDriverOffset7,23);	
	 END_IF		
	 
END_IF

	(************补偿大偏移量后面的极片模糊补偿 *****************)
	IF  bMA1 THEN
		 Polepar.fPoleWithOffset:=arrOffset[iCompCount]; 
		IF 	iCompCount<=1 THEN
			bMA1:=FALSE;
			iFlgCompCount:=0;
			MEMSET(ADR(arrOffset),0,SIZEOF(arrOffset));
		END_IF
	END_IF			
		
(************计算近10次补偿有效值的平均值******************)
   K2:=0;
   fSumDriverOffsetData:=0;
	FOR i30:=1 TO 10 BY 1 DO
		IF  ABS( fDriverOffsetData[i30])  <0.3   AND  ABS( fDriverOffsetData[i30])  >0  THEN 		//
			K2:=K2+1;
		    fSumDriverOffsetData:=fSumDriverOffsetData+fDriverOffsetData[i30];
		END_IF
		
		IF  i30=10   THEN
			IF K2>=1 THEN 
			   fArvDriverOffsetData:=fSumDriverOffsetData/K2;
			ELSE
			   fArvDriverOffsetData:=0;
			END_IF
		END_IF		
	END_FOR	
	

				
(*-----------20240404
//裁切补偿计算																								
IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bCuterCCDEN   THEN			
	IF   ProductPar.bCompSel OR TRUE THEN	  //极耳定位补偿方式																				
	(*	IF TabData[TabNo.CuterPhoto+2].bCCDed_C AND NOT TabData[TabNo.CuterPhoto+2].bTabOffsetNG_C THEN
			fDriverOffset7:=TabData[TabNo.CuterPhoto+2].fTab_OffsetC-(fDriverOffsetData[1]+fDriverOffsetData[2]);
		ELSE
			fDriverOffset7:=0;
		END_IF*)
		
	   
	    	 IF  NOT   bFlgTabPosOver THEN
					 
						(*IF TabData[TabNo.CuterPhoto+2].bCCDed_C AND NOT TabData[TabNo.CuterPhoto+2].bTabOffsetNG_C THEN
							fDriverOffset7:=TabData[TabNo.CuterPhoto+2].fTab_OffsetC-(fDriverOffsetData[1]+fDriverOffsetData[2]);
						ELSE
						fDriverOffset7:=0;
					  END_IF*)
			 
					 IF TabData[TabNo.CuterPhoto+2].bCCDed_C AND NOT TabData[TabNo.CuterPhoto+2].bTabOffsetNG_C THEN
							fDriverOffset7:=TabData[TabNo.CuterPhoto+2].fTab_OffsetC-(fDriverOffsetData[1]+fDriverOffsetData[2]);
					  ELSE
						   IF ABS(fDriverOffsetData[1])<0.4 THEN
								fDriverOffset7:=fDriverOffsetData[1]*0.8;
							ELSIF ABS(fDriverOffsetData[2])<0.4 THEN
								fDriverOffset7:=fDriverOffsetData[2]*0.8;
							ELSE
								fDriverOffset7:=0;
							END_IF
					  END_IF 
				  
				  
				  
                   (*   IF TabData[TabNo.CuterPhoto+2].bCCDed_C AND NOT TabData[TabNo.CuterPhoto+2].bTabOffsetNG_C THEN
							
								IF TabData[TabNo.CuterPhoto+3].bCCDed_C AND NOT TabData[TabNo.CuterPhoto+3].bTabOffsetNG_C  THEN
									fDriverOffset7:=(TabData[TabNo.CuterPhoto+2].fTab_OffsetC+TabData[TabNo.CuterPhoto+3].fTab_OffsetC)/2 - (fDriverOffsetData[1]+fDriverOffsetData[2]);
							ELSE
									fDriverOffset7:=TabData[TabNo.CuterPhoto+2].fTab_OffsetC-(fDriverOffsetData[1]+fDriverOffsetData[2]);
							END_IF
						ELSE
							IF ABS(fDriverOffsetData[1])<0.4 THEN
									fDriverOffset7:=fDriverOffsetData[1]*0.8;
								ELSIF ABS(fDriverOffsetData[2])<0.4 THEN
								fDriverOffset7:=fDriverOffsetData[2]*0.8;
							ELSE
								fDriverOffset7:=0;
								END_IF
							
						END_IF 	*)
				
					
						(*	
						IF ABS(fDriverOffset7)<10 THEN
							Polepar.fPoleWithOffset:=fDriverOffset7;
						ELSE
							IF fDriverOffset7>0 THEN
								Polepar.fPoleWithOffset:=10;
							ELSIF fDriverOffset7<0 THEN
								Polepar.fPoleWithOffset:=-10;
							END_IF	
						END_IF*)
						
								
						IF ABS(fDriverOffset7)<10 THEN
							IF ABS(fDriverOffset7)<0.6 THEN
								Polepar.fPoleWithOffset:=LIMIT(-0.35, fDriverOffset7,0.35);
							ELSE
								Polepar.fPoleWithOffset:=fDriverOffset7;  
							END_IF
						ELSE
							IF fDriverOffset7>0 THEN
								Polepar.fPoleWithOffset:=10;
							ELSIF fDriverOffset7<0 THEN
								Polepar.fPoleWithOffset:=-10;
							END_IF	
						END_IF	
				 ELSE
						  fDriverOffset7:=fDriverOffset;
						  Polepar.fPoleWithOffset:=LIMIT(-23,fDriverOffset7,23);	
				END_IF				
	ELSE//尺寸检测闭环纠偏
				 IF  NOT   bFlgTabPosOver THEN
						IF  ( BeltData[BeltNo.OverHang+1].iTabNGSizeNo=1  OR  BeltData[BeltNo.OverHang+1].iTabNGSizeNo=6 )  
							AND 0<=BeltData[BeltNo.OverHang+1].fTabSite AND BeltData[BeltNo.OverHang+1].fTabSite<90 THEN
						
							fDriverOffset7:=(PolePar.TabSitebace-BeltData[BeltNo.OverHang+1].fTabSite-fDriverOffsetData[1]-fDriverOffsetData[2]);
							
							//fDriverOffset7:=(PolePar.TabSitebace-BeltData[BeltNo.OverHang+1].fTabSite-
                                                                       //         LIMIT(-2, fDriverOffsetData[1] ,2) - LIMIT(-2, fDriverOffsetData[2] ,2)  ) ;
						ELSE
							fDriverOffset7:=0;
						END_IF		
				
						IF ABS(fDriverOffset7)<0.5 THEN
							Polepar.fPoleWithOffset:=LIMIT(-0.18,fDriverOffset7,0.18);
						ELSE
							Polepar.fPoleWithOffset:=LIMIT(-25,fDriverOffset7,25);
						END_IF
				 ELSE
						  fDriverOffset7:=fDriverOffset;
						  Polepar.fPoleWithOffset:=LIMIT(-25,fDriverOffset7,25);	
				END_IF
	END_IF
----------------20240404*)			
(*																						
	//模具前计算模具X纠偏补偿量
	IF TabData[TabNo.MouldPhoto+2].bCCDed_M AND NOT TabData[TabNo.MouldPhoto+2].bTabOffsetNG_M AND NOT ProductPar.iModeEN.bMouldXOffsetEN THEN
		fMouldXOffset7:=TabData[TabNo.MouldPhoto+2].fTab_OffsetM-(fDriverOffsetData[1]+fDriverOffsetData[2]+fDriverOffsetData[3]);
	ELSE
		fMouldXOffset7:=0;
	END_IF
*)	
	//模具前计算模具X纠偏补偿量	
	
	(*
	IF TabData[TabNo.MouldPhoto+2].bCCDed_M AND NOT TabData[TabNo.MouldPhoto+2].bTabOffsetNG_M AND NOT ProductPar.iModeEN.bMouldXOffsetEN THEN
		fMouldXOffset7:=TabData[TabNo.MouldPhoto+2].fTab_OffsetM-(fDriverOffsetData[1]+fDriverOffsetData[2]+fDriverOffsetData[3]);
	ELSE
		fMouldXOffset7:=0;
	END_IF	*)
										(*****************************R角补偿****************************************)	
     IF TabData[TabNo.MouldPhoto+2].bCCDed_M AND NOT TabData[TabNo.MouldPhoto+2].bTabOffsetNG_M AND NOT ProductPar.iModeEN.bMouldXOffsetEN THEN
		fMouldXOffset7:=TabData[TabNo.MouldPhoto+2].fTab_OffsetM-
                                             ( LIMIT( -1,  fDriverOffsetData[1] ,1 ) + LIMIT( -1,  fDriverOffsetData[2] ,1)+ LIMIT( -1,  fDriverOffsetData[3] ,1)  );
	ELSE
		fMouldXOffset7:=0;
	END_IF	
	
    IF TabData[TabNo.MouldPhoto+2].bCCDed_M AND NOT TabData[TabNo.MouldPhoto+2].bTabOffsetNG_M AND NOT ProductPar.iModeEN.bMouldXOffsetEN THEN
		fMouldXOffset8:= TabData[TabNo.MouldPhoto+2].fTab_OffsetY ;
                                         
	ELSE
		
		IF  NOT TabData[TabNo.MouldPhoto+3].bTabOffsetNG_M THEN
		    fMouldXOffset8:= TabData[TabNo.MouldPhoto+3].fTab_OffsetY ;
		ELSIF NOT TabData[TabNo.MouldPhoto+4].bTabOffsetNG_M THEN
			fMouldXOffset8:= TabData[TabNo.MouldPhoto+4].fTab_OffsetY ;
		ELSE
			fMouldXOffset8:=0;
		END_IF
			
	END_IF	 
	
	
	
	
	
	IF NOT ProductPar.iModeEN.bMouldXclosureEN AND NOT bCyDDRMark THEN
		IF iRTransCompCount=1  THEN
			iRTransCompCount:=28;
			(************计算近10次R角横深有效值的平均值******************)
		   K4:=0;
		   fSumTransverData:=0;
			FOR i30:=3 TO 22 BY 1 DO
				IF iPartSelect=1 THEN//正极      2---4
					IF BeltData[i30].fPoleNGSizeNo=30 THEN
						K4:=K4+1;
						(*正极RoundedSize7为叠片侧、RoundedSize8为切刀侧，故RoundedSize7-RoundedSize8*)	
						fSumTransverData:=fSumTransverData+(BeltData[i30].RoundedSize7-BeltData[i30].RoundedSize8)/2;			
					END_IF
				ELSE//负极     1.8----3.8
					IF BeltData[i30].fPoleNGSizeNo=30 THEN
						K4:=K4+1;
						(*负极RoundedSize8为叠片侧、RoundedSize7为切刀侧，故RoundedSize8-RoundedSize7*)	
						fSumTransverData:=fSumTransverData+(BeltData[i30].RoundedSize8-BeltData[i30].RoundedSize7)/2;				
					END_IF			
				END_IF		
		
				IF  i30=22   THEN
					IF K4>=15 THEN 
					  // fArvTransverData:=fArvTransverData+LIMIT(-0.1,fSumTransverData/K4*0.3,0.1);  //(-0.25,fSumTransverData/K4*0.3,0.25)
					   fArvTransverData:=fArvTransverData+SEL( ABS(fSumTransverData/K4)>=0.1,0,LIMIT(-0.25,fSumTransverData/K4*0.3,0.25));
					ELSE
					   fArvTransverData:=0;//???
					END_IF
				END_IF		
			END_FOR		
		END_IF
		IF iRTransCompCount>=1 THEN	
			iRTransCompCount:=iRTransCompCount-1;
		END_IF
	ELSE
		iRTransCompCount:=28;
		fArvTransverData:=0;	
	END_IF

	
	
	(***************************R角纵深闭环**********************************)
	bComMode:=TRUE;
IF NOT ProductPar.iModeEN.bMouldYclosureEN AND NOT bCyDDRMark THEN
	
 IF iRTransCompCount2=1  THEN
			iRTransCompCount2:=28;
			
			(************计算近10次R角纵深有效值的平均中值******************)
		   K3:=0;
		   fSumTransverData2:=0;
	FOR i30:=3 TO 22 BY 1 DO
									
			IF NOT bComMode THEN  //纵深
				(*
				IF iPartSelect=1 THEN//正极             4.7----6.3  
					(*   V1 角纵深       正极RoundedSize3为叠片侧R角纵深    、RoundedSize4为切刀侧R角纵深 ，RoundedSize3+RoundedSize4    *)
	                 IF 4.7<=BeltData[i30].RoundedSize3   AND  BeltData[i30].RoundedSize4<=6.3 THEN 
				         fSumTransverData:=fSumTransverData+(BeltData[i30].RoundedSize3+BeltData[i30].RoundedSize4)/2;		
						 K3:=K3+1;
					END_IF				
				ELSIF  iPartSelect=2 THEN//负极        1.8----3.4
					(*   V1 角纵深       正极RoundedSize3为叠片侧R角纵深    、RoundedSize4为切刀侧R角纵深 ，RoundedSize3+RoundedSize4    *)
	                 IF 1.8<=BeltData[i30].RoundedSize3   AND  BeltData[i30].RoundedSize4<=3.4 THEN 
				         fSumTransverData:=fSumTransverData+(BeltData[i30].RoundedSize3+BeltData[i30].RoundedSize4)/2;		
						 K3:=K3+1;
					END_IF			
			   END_IF
				*)
               ;	
		   ELSE//面积
				IF iPartSelect=1 THEN//正极             C+D=32.972   
				   (*   V2角面积     正极RoundedSize1为叠片侧R角面积  、RoundedSize2为切刀侧R角面积 ，RoundedSize3+RoundedSize4    *)	
				   (* IF BeltData[i30].fPoleNGSizeNo=30   THEN 	
					    fSumTransverData2:=fSumTransverData2+( (BeltData[i30].RoundedSize1+BeltData[i30].RoundedSize2)-32.972 );	
					    K3:=K3+1;
					END_IF*)	
				    IF BeltData[i30].fPoleNGSizeNo=30   THEN 	
					    fSumTransverData2:=fSumTransverData2+(BeltData[i30].RoundedSize1+BeltData[i30].RoundedSize2);	
					    K3:=K3+1;
					END_IF					
					
				ELSIF  iPartSelect=2 THEN//负极     //C+D=11.608   //C+D=11.877
				   (*   V2角面积     正极RoundedSize1为叠片侧R角面积  、RoundedSize2为切刀侧R角面积 ，RoundedSize3+RoundedSize4    *)	
				   (* IF BeltData[i30].fPoleNGSizeNo=30THEN 	
					    fSumTransverData2:=fSumTransverData2+( (BeltData[i30].RoundedSize1+BeltData[i30].RoundedSize2)-11.877 );	
					    K3:=K3+1;
					END_IF*)		
				    IF BeltData[i30].fPoleNGSizeNo=30THEN 	
					    fSumTransverData2:=fSumTransverData2+(BeltData[i30].RoundedSize1+BeltData[i30].RoundedSize2);	
					    K3:=K3+1;
					END_IF						
				END_IF	
			END_IF
							
				IF  i30=22  THEN
					IF  iPartSelect=1 THEN//正极  
							IF K3>=15 THEN 
								IF NOT bComMode THEN  //V1 角纵深    补偿方式
									(*fArvTransverData2:=fArvTransverData2+LIMIT( -0.1,   fSumTransverData2/K3-fRSizeBase   , 0.1 )  ;*)
									;
								ELSE    //V2 角面积  补偿方式
									//fArvTransverData2:=fSumTransverData2/K3;
									//   fArvTransverData2:=fArvTransverData2+LIMIT(-0.25,fSumTransverData2/K3*0.3,0.25);
								    //fArvTransverData2:=SEL( ABS(fSumTransverData2/K3-32.972)>=1.2 ,0 ,fArvTransverData2+LIMIT(-0.1,(fSumTransverData2/K3-32.972)*0.3,0.1));
									 IF ABS(fSumTransverData2/K3-32.972)>=1.2 THEN
										fArvTransverData2:=fArvTransverData2+LIMIT(-0.1,(fSumTransverData2/K3-32.972)*0.3,0.1); 
									 END_IF
									
									
								END_IF		   
							ELSE
							   fArvTransverData2:=0;
							END_IF
					ELSIF  iPartSelect=2 THEN//负极  
								IF K3>=15 THEN 
									IF NOT bComMode THEN  //V1 角纵深    补偿方式
										(*fArvTransverData2:=fArvTransverData2+LIMIT( -0.1,   fSumTransverData2/K3-fRSizeBase   , 0.1 )  ;*)
										;
									ELSE    //V2 角面积  补偿方式
										//fArvTransverData2:=fSumTransverData2/K3;
										//   fArvTransverData2:=fArvTransverData2+LIMIT(-0.25,fSumTransverData2/K3*0.3,0.25);
										//fArvTransverData2:=SEL( ABS(fSumTransverData2/K3-11.877)>=0.55 ,0 ,fArvTransverData2+LIMIT(-0.1,(fSumTransverData2/K3-11.877)*0.3,0.1));
										IF ABS(fSumTransverData2/K3-11.877)>=0.55 THEN
											fArvTransverData2:=fArvTransverData2+LIMIT(-0.1,(fSumTransverData2/K3-11.877)*0.3,0.1);
										END_IF
									END_IF		   
							ELSE
							   fArvTransverData2:=0;
							END_IF						
					END_IF		
				END_IF	
				
		END_FOR		
			
	END_IF	
		
		IF iRTransCompCount2>=1 THEN	
			iRTransCompCount2:=iRTransCompCount2-1;
		END_IF
		
ELSE
		iRTransCompCount2:=28;
		fArvTransverData2:=0;	
END_IF
	
	
	
	
	
	
	
	IF arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1]-fMouldXOffset7>arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[3] OR
		arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1]-fMouldXOffset7<arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[4] AND NOT ProductPar.iModeEN.bMouldXOffsetEN 
	THEN
		Polepar.fMouldX_Offset:=arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1]-arrAxisCtrl[AxisNo.MouldRectify_X].Status.fSetPos;
		stAlarm.arrLightWarn[8]:=TRUE;//模具X补偿量超过纠偏电机行程
	ELSE
		Polepar.fMouldX_Offset:=fMouldXOffset7;
	END_IF
	
	//arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[2]:=arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1]+fArvTransverData-Polepar.fMouldX_Offset;   //V1
	
	                            //TabData[TabNo.MouldPhoto+2].fTab_OffsetM
	//arrAxisPar[AxisNo.MouldRectify_Y].arrTargetPoint[2]:=arrAxisPar[AxisNo.MouldRectify_Y].arrTargetPoint[1]-  (TabData[TabNo.MouldPhoto+2].fTab_OffsetM + TabData[TabNo.MouldPhoto+2].fTab_OffsetM )/2     ;   //V1
								
	
(*	
  IF   NOT CutMark_R[0] THEN
	arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[2]:=arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1]-Polepar.fMouldX_Offset;
  ELSE
      arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[2]:=arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1];
 END_IF		
*)   //V2		


(*
  IF  ABS(   PolePar.TabSitebace-BeltData[BeltNo.OverHang+1].fTabSite )<=4    AND     BeltData[BeltNo.OverHang+1].iTabNGSizeNo=1    THEN
	arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[2]:=arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1]-Polepar.fMouldX_Offset;
  ELSE
      arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[2]:=arrAxisPar[AxisNo.MouldRectify_X].arrTargetPoint[1];
 END_IF	
*)//V3



	
ELSE
	Polepar.fPoleWithOffset:=0;
	Polepar.fMouldX_Offset:=0;
END_IF	
																						
//记录模具，切刀当前的凸轮																								
	iMouldRunTableSel:=fbMouldCam.iTableSel;																									
	iCuterRunTableSel:=fbCuterCam.iTableSel;																									
	iAutoRunStep:=4015;		

	(*************************************************************************黄标位置判断*******************************************************************************************)	
4015: 
	//	PolePar.YellScope;//黄标检测有效范围,,mm	------R角
	FOR i8:=20 TO 1 BY -1 DO	
		IF ( PolePar.fPoleWidth-PolePar.fYellowBreadth<=(aYellowPos[i8]+PolePar.fBlue_Mould-fDriverDDRActPos)  )    AND
		    (  ( aYellowPos[i8]+PolePar.fBlue_Mould-fDriverDDRActPos)<=PolePar.fPoleWidth+PolePar.fYellowBreadth  )  AND  
			aYellowPos[i8]>0 THEN
			aYellowJump_R[1]:=TRUE;//极片黄标R角跳切标志
			aYellowMark[1]:=TRUE;//第1片黄标
			aYellowPos_R[1]:=aYellowPos[i8]+PolePar.fBlue_Mould-fDriverDDRActPos;
			Production.NGFlag[44]:=TRUE;//黄黄标跳切计数
			//Production.NGFlag[45]:=TRUE;//黄黄标计数
			EXIT;		
		END_IF			
	END_FOR
	
	FOR i21:=20 TO 1 BY -1 DO	
		IF aYellowPos[i21]+PolePar.fBlue_Mould-fDriverDDRActPos < PolePar.fPoleWidth  AND  aYellowPos[i21]+PolePar.fBlue_Mould-fDriverDDRActPos>0  THEN
			aYellowMark[1]:=TRUE;//第1片黄标
			EXIT;		
		END_IF
	END_FOR
		
	//	PolePar.YellScope;//黄标检测有效范围,,mm	------裁切
	FOR i9:=20 TO 1 BY -1 DO	
		IF (PolePar.fPoleWidth-PolePar.fYellowBreadth<=(aYellowPos[i9]+PolePar.fBlue_Mould+5*PolePar.fPoleWidth-fDriverDDRActPos ))
			AND ( (aYellowPos[i9]+PolePar.fBlue_Mould+5*PolePar.fPoleWidth-fDriverDDRActPos)<=PolePar.fPoleWidth+PolePar.fYellowBreadth )
			AND aYellowPos[i9]>0 THEN						
			aYellowJump_C[1]:=TRUE;//极片黄标R角跳切标志
			aYellowPos_C[1]:=aYellowPos[i9]+PolePar.fBlue_Mould+5*PolePar.fPoleWidth-fDriverDDRActPos;
			//aYellowPos[i9]:=0;
			EXIT;
		END_IF
	END_FOR	
	
	FOR i9:=20 TO 1 BY -1 DO	//清除超范围黄标位置
		IF  ( ((aYellowPos[i9]+PolePar.fBlue_Mould+5*PolePar.fPoleWidth-fDriverDDRActPos ) <= -(PolePar.fPoleWidth+100)     )  OR 
			(ABS(aYellowPos[i9]-fDriverDDRActPos)>=PolePar.fBlue_Mould+5*PolePar.fPoleWidth+200)  )
			AND aYellowPos[i9]>0 THEN						
			aYellowPos[i9]:=0;
		END_IF
	END_FOR		
	
    FOR i9:=20 TO 2 BY -1 DO	//清除超范围置差很小的值
		IF ABS (aYellowPos[i9]- aYellowPos[i9-1] )<=6 
		   AND aYellowPos[i9]>0 AND aYellowPos[i9-1]>0   THEN						
			aYellowPos[i9]:=(aYellowPos[i9]+ aYellowPos[i9-1])/2 ;
			aYellowPos[i9-1]:= 0  ;
		END_IF
	END_FOR		
	
	
	FOR i9:=20 TO 1 BY -1 DO	 //输出黄标到裁切的距离    同时输出皮带上黄标MACK标志
		IF   aYellowPos[i9]>0 THEN						
			  aYellowPos_R2[i9]:=aYellowPos[i9]+PolePar.fBlue_Mould+5*PolePar.fPoleWidth-fDriverDDRActPos;
		ELSE
	        aYellowPos_R2[i9]:=0;
		END_IF
	END_FOR		
	
	(*********************************************接带处理****************************************************)
	FOR i8:=20 TO 1 BY -1 DO	 //-----R角
		IF ( PolePar.fPoleWidth-160<=(aTapePos[i8]+PolePar.fTape_Mould-fDriverDDRActPos)  )    AND
		    (  ( aTapePos[i8]+PolePar.fTape_Mould-fDriverDDRActPos)<=PolePar.fPoleWidth+160  )  AND  
			aTapePos[i8]>0 THEN
			aTapeJump_R[1]:=TRUE;//极片接带R角跳切标志
			aTapeMark[1]:=TRUE;//第1片黄标
			EXIT;		
		END_IF			
	END_FOR
	
	FOR i9:=20 TO 1 BY -1 DO	 	//		------裁切
		IF (PolePar.fPoleWidth-160<=(aTapePos[i9]+PolePar.fTape_Mould+5*PolePar.fPoleWidth-fDriverDDRActPos ))
			AND ( (aTapePos[i9]+PolePar.fTape_Mould+5*PolePar.fPoleWidth-fDriverDDRActPos)<=PolePar.fPoleWidth+160 )
			AND aTapePos[i9]>0 THEN						
			aTapeJump_C[1]:=TRUE;//极片接带跳切标志
			EXIT;
		END_IF
	END_FOR	
	
	FOR i9:=20 TO 1 BY -1 DO	//清除超范围黄标位置
		IF  ( ((aTapePos[i9]+PolePar.fTape_Mould+5*PolePar.fPoleWidth-fDriverDDRActPos ) <= -(PolePar.fPoleWidth+100)     )  OR 
			(ABS(aTapePos[i9]-fDriverDDRActPos)>=PolePar.fTape_Mould+5*PolePar.fPoleWidth+200)  )
			AND aTapePos[i9]>0 THEN						
			aTapePos[i9]:=0;
		END_IF
	END_FOR		
	
    FOR i9:=20 TO 2 BY -1 DO	//清除超范围置差很小的值
		IF ABS (aTapePos[i9]- aTapePos[i9-1] )<=8 
		   AND aTapePos[i9]>0 AND aTapePos[i9-1]>0   THEN						
			aTapePos[i9]:=(aTapePos[i9]+ aTapePos[i9-1])/2 ;
			aTapePos[i9-1]:=0  ;
		END_IF
	END_FOR	
	
	FOR i9:=20 TO 1 BY -1 DO	 //输出黄标到裁切的距离    同时输出皮带上黄标MACK标志
		IF   aTapePos[i9]>0 THEN						
			  aTapePos_R2[i9]:=aTapePos[i9]+PolePar.fTape_Mould+5*PolePar.fPoleWidth-fDriverDDRActPos;
	    ELSE
			  aTapePos_R2[i9]:=0;
		END_IF
	END_FOR	

	iAutoRunStep:=4020;		
		
(*************************************************************************裁切角度补偿计算*******************************************************************************************)																
4020://																	
////////////////////裁切前计算裁切角度纠偏量//////////////////////////正极:CCD发正值，意指角度纠偏往逆时针转	,而电机JOG+为顺时针，故初始位置减纠偏量   
                                                                       //            	负极:CCD发正值，意指角度纠偏往顺时针转,而电机JOG+为逆时针，故初始位置减纠偏量																									
	IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bDegreeRecEN THEN																	
		fDegreeRec1:=FC_Variance(fOffsetDeg);						//方差只能体现偏移大小。																		
	ELSE																									
		fDegreeRec1:=0;																								
	END_IF																									
	IF fDegreeRec1>=0.005 AND NOT ProductPar.iModeEN.bEmptyRunEN THEN   //方差大于0.05  相当于偏差值-平均值达到了0.1°																									
		fDegreeRec2:=(fOffsetDeg[1]+fOffsetDeg[2]+fOffsetDeg[3]+fOffsetDeg[4]+fOffsetDeg[5]+fOffsetDeg[6]+fOffsetDeg[7]+fOffsetDeg[8])/8;
	ELSE
		fDegreeRec2:=Polepar.fDegreeRectify;//	方差小于门槛值，取上次的纠偏量																						
	END_IF			
																						
	IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bDegreeRecEN  AND FALSE     THEN	
		IF arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[1]-fDegreeRec2> arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[3] OR 
			arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[1]-fDegreeRec2< arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[4] THEN	
																							
			  Polepar.fDegreeRectify:=arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[1]-arrAxisCtrl[AxisNo.CuterDegRectify].Status.fSetPos;
			  stAlarm.arrLightWarn[9]:=TRUE;//裁切角度纠偏量超过纠偏电机行程																										
		ELSE
			Polepar.fDegreeRectify:=fDegreeRec2;	
			MEMSET(ADR(fOffsetDeg),0,SIZEOF(fOffsetDeg));
		END_IF	
		arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[2]:=arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[1]-Polepar.fDegreeRectify;																																											
	ELSE																									
		arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[2]:=arrAxisPar[AxisNo.CuterDegRectify].arrTargetPoint[1];																								
	END_IF		

(*************************************************************************凸轮切换*******************************************************************************************)
//模具凸轮判断			
	IF ((*InteData[InteNo.Mould-1].bBlueNG OR*)  aYellowJump_R[1]   OR   aTapeJump_R[1]  OR bCyDDRMark  )         THEN		// AND NOT ProductPar.iModeEN.bEmptyRunEN     CutMark_R[2]  OR
		iCount10:=	iCount10+1;		   																		
		IF iMouldRunTableSel=1 THEN																								
			fbMouldCam.iTableSel:=2;																							
		ELSE																					
			fbMouldCam.iTableSel:=3; 																							
		END_IF;//模具凸轮切换为stop																								
	ELSE																									
		fbMouldCam.iTableSel:=1; //模具凸轮切换为正常																								
	END_IF		
																				
//裁切凸轮判断	
	IF (InteData[InteNo.Cuter-1].bLineScanNG AND NOT ProductPar.iModeEN.bLineScanCCDEN) OR aYellowJump_C[1]  OR   aTapeJump_C[1]        THEN		 //(*InteData[InteNo.Cuter-1].bBlueNG AND NOT ProductPar.iModeEN.bFlgBlueEN) OR *)																							
		IF iCuterRunTableSel=1 THEN																								
			fbCuterCam.iTableSel:=2;																							
		ELSE																								
			fbCuterCam.iTableSel:=3; 																							
		END_IF;//裁切凸轮切换为stop																								
	ELSE																									
			fbCuterCam.iTableSel:=1;//裁切凸轮切换为正常																								
	END_IF
																
(*************************************************************************补偿值更新*****************************************************************************************)		
	IF   ProductPar.bCompSel THEN		
		IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bCuterOffsetEN THEN																									
			fbDriverCam.fCompensation:=Polepar.fPoleWithOffset;////修改关键点																								
		ELSE																									
			fbDriverCam.fCompensation:=0;//不修改关键点																								
		END_IF																									
																												
		IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bCuterOffsetEN THEN																									
			fPoleBufferCompensation:=Polepar.fPoleWithOffset;																								
			fbUwindTen.fCompensation:=SEL(fbCuterCam.iTableSel=1,fDriverOffsetData[1],Polepar.fPoleWithOffset);																											
			fbAuxDriverTen.fCompensation:=Polepar.fPoleWithOffset;																								
		ELSE																									
			fPoleBufferCompensation:=0;																								
			fbUwindTen.fCompensation:=0;																						
			fbAuxDriverTen.fCompensation:=0;																								
		END_IF		
	ELSE
		  IF  NOT   bFlgTabPosOver THEN
					IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bCuterOffsetEN  THEN	//AND fbCuterCam.iTableSel=1		
						//fbDriverCam.fCompensation:=SEL(fbCuterCam.iTableSel=1 ,fDriverOffsetData[1],Polepar.fPoleWithOffset);	////修改关键点																												
						fbDriverCam.fCompensation:=SEL(fbCuterCam.iTableSel=1 AND PolePar.TabSitebace<>BeltData[BeltNo.OverHang+1].fTabSite ,SEL(ABS(fDriverOffsetData[1])<0.18,0,fDriverOffsetData[1]),Polepar.fPoleWithOffset);	////修改关键点																										
					ELSE
						fbDriverCam.fCompensation:=0;//不修改关键点																								
					END_IF																															
				//////////////////////极片缓存凸轮缩放,放卷张力&辅驱张力缩放///////////////////////																										
					IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bCuterOffsetEN  THEN		//AND fbCuterCam.iTableSel=1																							
						fPoleBufferCompensation:=SEL(fbCuterCam.iTableSel=1 AND PolePar.TabSitebace<>BeltData[BeltNo.OverHang+1].fTabSite ,SEL(ABS(fDriverOffsetData[1])<0.18,0,fDriverOffsetData[1]),Polepar.fPoleWithOffset);																							
						fbUwindTen.fCompensation:=SEL(fbCuterCam.iTableSel=1 AND PolePar.TabSitebace<>BeltData[BeltNo.OverHang+1].fTabSite ,SEL(ABS(fDriverOffsetData[1])<0.18,0,fDriverOffsetData[1]),Polepar.fPoleWithOffset);																						
						fbAuxDriverTen.fCompensation:=SEL(fbCuterCam.iTableSel=1 AND PolePar.TabSitebace<>BeltData[BeltNo.OverHang+1].fTabSite ,SEL(ABS(fDriverOffsetData[1])<0.18,0,fDriverOffsetData[1]),Polepar.fPoleWithOffset);																						
					ELSE																									
						fPoleBufferCompensation:=0;																								
						fbUwindTen.fCompensation:=0;																								
						fbAuxDriverTen.fCompensation:=0;																								
					END_IF	
		 ELSE
			IF NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bCuterOffsetEN THEN																									
					fPoleBufferCompensation:=Polepar.fPoleWithOffset;																								
					fbUwindTen.fCompensation:=Polepar.fPoleWithOffset;																											
					fbAuxDriverTen.fCompensation:=Polepar.fPoleWithOffset;			
			   fbDriverCam.fCompensation:=Polepar.fPoleWithOffset;////修改关键点																								
				ELSE																									
					fPoleBufferCompensation:=0;																								
					fbUwindTen.fCompensation:=0;																						
					fbAuxDriverTen.fCompensation:=0;				
					  fbDriverCam.fCompensation:=0;////修改关键点																			
			END_IF	
		
		END_IF		
	END_IF
	

	//////////////////////模具前CCD检测计算极耳间距////////////////////////																								
			IF TabData[TabNo.MouldPhoto+1].bCCDed_M AND TabData[TabNo.MouldPhoto+2].bCCDed_M AND NOT TabData[TabNo.MouldPhoto+1].bTabOffsetNG_M AND NOT TabData[TabNo.MouldPhoto+2].bTabOffsetNG_M THEN																									
				fTabInteM_1:=PolePar.fPoleWidth+fDriverOffsetData[2]+(TabData[TabNo.MouldPhoto+1].fTab_OffsetM-TabData[TabNo.MouldPhoto+2].fTab_OffsetM);																								
			ELSE																									
				fTabInteM_1:=PolePar.fPoleWidth;																								
			END_IF																																																		
			InteData[InteNo.Mould-1].fTabIntervalM:=fTabInteM_1;																								
		
			IF TabData[TabNo.MouldPhoto+1].fPhotoPosM>TabData[TabNo.MouldPhoto+2].fPhotoPosM AND TabData[TabNo.MouldPhoto+1].bCCDed_M AND TabData[TabNo.MouldPhoto+2].bCCDed_M AND NOT TabData[TabNo.MouldPhoto+1].bTabOffsetNG_M AND NOT TabData[TabNo.MouldPhoto+2].bTabOffsetNG_M THEN																									
				fTabInteM_2:=TabData[TabNo.MouldPhoto+1].fPhotoPosM-TabData[TabNo.MouldPhoto+2].fPhotoPosM+(TabData[TabNo.MouldPhoto+2].fTab_OffsetM-TabData[TabNo.MouldPhoto+1].fTab_OffsetM);																								
			ELSE																									
				fTabInteM_2:=PolePar.fPoleWidth;																								
			END_IF																																																																						
		//////////////////////模具前极耳间距内前后肩宽状况判断////////////////////////	
			IF NOT ProductPar.iModeEN.bMouldXOffsetEN THEN																										
				IF ABS(InteData[InteNo.Mould-1].fTabIntervalM-PolePar.fPoleWidth)<=0.5 THEN//片宽偏差小于等于0.5																									
					InteData[InteNo.Mould-1].bTabInteFr_M:=FALSE;																								
					InteData[InteNo.Mould-1].bTabInteBe_M:=FALSE;																								
				ELSE																									
					IF NOT InteData[InteNo.Mould].bTabInteBe_M THEN																								
						InteData[InteNo.Mould-1].bTabInteFr_M:=FALSE;																							
						InteData[InteNo.Mould-1].bTabInteBe_M:=TRUE;																							
					ELSE																								
						InteData[InteNo.Mould-1].bTabInteFr_M:=TRUE;																							
						InteData[InteNo.Mould-1].bTabInteBe_M:=FALSE;																							
					END_IF																								
				END_IF		
			END_IF																							
		
			FOR i1:=1 TO 50 BY 1 DO 																									
					IF i1<50 THEN 																							
						 fM_TabInterData[51-i1]:=fM_TabInterData[50-i1];																																											
					ELSE																							
						fM_TabInterData[1]:=fTabInteM_1;																																											
					END_IF; 																							
			END_FOR; 
	FOR i1:=1 TO 50 BY 1 DO //主驱补偿值记录																									
		IF i1<50 THEN 																							
		   	fDriverOffsetData[51-i1]:=fDriverOffsetData[50-i1];																																											
		ELSIF   ProductPar.bCompSel THEN																						
			fDriverOffsetData[1]:=Polepar.fPoleWithOffset;	//裁切定位补偿
		ELSE
			fDriverOffsetData[1]:=fPoleBufferCompensation;//尺寸检测闭环补偿																																										
		END_IF; 																							
	END_FOR; 	
	 IF     iCompCount>=1 THEN	
            iCompCount:=iCompCount-1;
     END_IF																																																													
	iAutoRunStep:=4050;		


4050:	
(*
	IF stAlarm.arrFlowAlarm[35] OR stAlarm.arrFlowAlarm[37] OR stAlarm.arrFlowAlarm[38] THEN
		iAutoRunStep:=500;
		;
	ELSIF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=310 THEN																	
		iAutoRunStep:=350;	
	END_IF	
	
*)

	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=300 THEN																	
		iAutoRunStep:=4060;	
	END_IF		
	
	Production.OutFlag1:=FALSE;//产能计数
	Production.OutFlag2:=FALSE;//产能计数
	FOR i:=1 TO 50 DO//NG类型标志位复位
		Production.NGFlag[i]:=FALSE;
	END_FOR		

4060:
 IF ProductPar.iLineScanSel THEN
    IF  bFlgLineScanOver  THEN  //通讯线扫超240周期给结果      数据移位需要单独处理
		
			  //上线扫结果判断	
				FOR i1:=1 TO 20 BY 1 DO 																									
					IF i1<20 THEN 																							
						 XianSaong_Up[20-i1]:=XianSaong_Up[19-i1];																						
					ELSE																				
						XianSaong_Up[0]:=CCD_COM.Scan.iResult_UP;																											
					END_IF; 																							
				 END_FOR; 
		
			//下线扫结果判断	
				FOR i1:=1 TO 20 BY 1 DO 																									
					IF i1<20 THEN 																							
						 XianSaong_Down[20-i1]:=XianSaong_Down[19-i1];																						
					ELSE																						
						XianSaong_Down[0]:= CCD_COM.Scan.iResult_Down;																									
					END_IF; 																							
				 END_FOR;
				 
				
          	     IF XianSaong_Down[0]=30 AND XianSaong_Up[1]=30 THEN//---------------------------------线扫OK结果由8改为30，，，CCD需要同步更改
					    BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo:=30; //线扫NG类型
			    ELSE
					//剔废前一工位汇总结果，5号位置，，，，，剔废工位为6
						IF XianSaong_Down[0]<>30 AND XianSaong_Up[1]=30 THEN
							BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo:=XianSaong_Down[0];
						END_IF
		
						IF XianSaong_Down[0]=30 AND XianSaong_Up[1]<>30 THEN
							BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo:=XianSaong_Up[1];
						END_IF
		
						IF XianSaong_Down[0]<>30 AND XianSaong_Up[1]<>30 THEN
							BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo:=XianSaong_Up[1];
						END_IF				
		        END_IF	
			
			IF CCD_COM.Scan.iResult_UP=33 AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN THEN
				fDA1:=        arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos;
				stAlarm.arrFlowAlarm[25]:=TRUE;//上线扫超时报警
			END_IF	
			IF CCD_COM.Scan.iResult_Down=33 AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN THEN
				fDA2:=        arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos;
				stAlarm.arrFlowAlarm[27]:=TRUE;//下线扫超时报警
			END_IF	
	(*
			IF  CCD_COM.Scan.iResult_UP<>33 AND CCD_COM.Scan.iResult_Down<>33 THEN
				bFlgLineScanOver:=FALSE;	
			END_IF*)
		
	        iAutoRunStep:=4070;	 

	ELSE  
       iAutoRunStep:=4080;	 
	END_IF
	
 ELSE   //IO线扫超240周期给结果      数据移位需要单独处理
	     IF  bFlgLineScanOver  THEN  //线扫超240周期给结果      数据移位需要单独处理
		
		 		FOR i1:=1 TO 20 BY 1 DO 																									
					IF i1<20 THEN
						 XianSaong_Up[20-i1]:=XianSaong_Up[19-i1];																						
					ELSE																				
						XianSaong_Up[0]:=CCD_COM.Scan.iResult_IO_UP;																											
					END_IF; 																							
				 END_FOR; 
				
				FOR i1:=1 TO 20 BY 1 DO 																									
					IF i1<20 THEN
						 XianSaong_Down[20-i1]:=XianSaong_Down[19-i1];																						
					ELSE																						
						XianSaong_Down[0]:=CCD_COM.Scan.iResult_IO_Down;																									
					END_IF; 																							
				 END_FOR;
		 	 
		 
			     IF XianSaong_Down[0]=30 AND XianSaong_Up[1]=30 THEN//---------------------------------线扫OK结果由8改为30，，，CCD需要同步更改
					   BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo:=30; //线扫NG类型
				 ELSE
					//剔废前一工位汇总结果，5号位置，，，，，剔废工位为6
						IF XianSaong_Down[0]<>30 AND XianSaong_Up[1]=30 THEN
							BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo:=XianSaong_Down[0];
						END_IF
		
						IF XianSaong_Down[0]=30 AND XianSaong_Up[1]<>30 THEN
							BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo:=XianSaong_Up[1];
						END_IF
		
						IF XianSaong_Down[0]<>30 AND XianSaong_Up[1]<>30 THEN
							BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo:=XianSaong_Up[1];
						END_IF			
				 END_IF	
				 
				 IF CCD_COM.Scan.iResult_IO_UP=33 AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN THEN
					stAlarm.arrFlowAlarm[25]:=TRUE;//上线扫超时报警
				END_IF	
				IF CCD_COM.Scan.iResult_IO_Down=33 AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN THEN
					stAlarm.arrFlowAlarm[27]:=TRUE;//下线扫超时报警
				END_IF	
			(*
           IF  CCD_COM.Scan.iResult_IO_UP<>33 AND CCD_COM.Scan.iResult_IO_Down<>33 THEN	
			     bFlgLineScanOver:=FALSE;	
		   END_IF*)
	 
	        iAutoRunStep:=4070;	 
	     ELSE  
             iAutoRunStep:=4080;	 
	    END_IF
 
 END_IF

 
 4070:
 	(*************************************************************************NG踢废********************************************************************************************)																										
	IF  (NOT ProductPar.iModeEN.bSizeCCDEN AND BeltData[BeltNo.NGBox1+2].fPoleNGSizeNo<>30  
		AND NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN ) 		 
		OR			
	 	( BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo <>30 AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN AND NOT ProductPar.iModeEN.bEmptyRunEN)  
		OR  
		(BeltData[BeltNo.NGBox1+2].bYellowMark)  OR 
	    (BeltData[BeltNo.NGBox1+2].bBlueMark)  THEN
		NG_Sum:=NG_Sum+1;
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=TRUE;//踢NG料打开
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=FALSE;//踢NG料关闭		
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bON:=FALSE;//踢NG料真空打开
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bOFF:=TRUE;//踢NG料真空关闭																	
		BeltData[BeltNo.NGBox1+2].bHavePole:=FALSE;	
		BeltData[BeltNo.NGBox1+2].stPoleNo:='';		
		nInt[3]:=1;																					
	ELSE	
		nInt[3]:=0;
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=FALSE;//踢NG料打开
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=TRUE;//踢NG料关闭		
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bON:=TRUE;//踢NG料真空打开
		arrCyCtrl[EVNo.NGPushInsideVacuo].Cmd.bOFF:=FALSE;//踢NG料真空关闭																					
	END_IF	
	

    iAutoRunStep:=4080;	 
 
 
4080:


     Production.NGFlag[44]:=FALSE;//黄黄标跳切计数
	// Production.NGFlag[45]:=FALSE;//黄黄标计数
 	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=310 THEN	
		bFlgLineScanOver:=FALSE;
	     CCD_COM.Scan.iResult_UP:=33; 
		 CCD_COM.Scan.iResult_Down:=33;	
	
		CCD_COM.Scan.iResult_IO_UP:=33;//复位线扫IO结果
		CCD_COM.Scan.iResult_IO_Down:=33;
		bLineScanResult1_UP:=FALSE;
		bLineScanResult2_UP:=FALSE;
		bLineScanResult1_Down:=FALSE;
		bLineScanResult2_Down:=FALSE;

		IF  NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN AND NOT ProductPar.iModeEN.bEmptyRunEN THEN
		    IF BeltData[BeltNo.NGBox1+2].fPoleNGSacnNo = 30 THEN
        	  iNGScane:=0;
			ELSE
              iNGScane:=iNGScane+1;
			END_IF  
		END_IF
													
		iAutoRunStep:=350;	
	END_IF	
 
																								
END_CASE	























(*
	//////////////////////模具前CCD检测计算极耳间距////////////////////////																								
			IF TabData[TabNo.MouldPhoto+1].bCCDed_M AND TabData[TabNo.MouldPhoto+2].bCCDed_M AND NOT TabData[TabNo.MouldPhoto+1].bTabOffsetNG_M AND NOT TabData[TabNo.MouldPhoto+2].bTabOffsetNG_M THEN																									
				fTabInteM_1:=PolePar.fPoleWidth+fDriverOffsetData[2]+(TabData[TabNo.MouldPhoto+2].fTab_OffsetM-TabData[TabNo.MouldPhoto+1].fTab_OffsetM);																								
			ELSE																									
				fTabInteM_1:=PolePar.fPoleWidth;																								
			END_IF																																																		
			InteData[InteNo.Mould-1].fTabIntervalM:=fTabInteM_1;																								
		
			IF TabData[TabNo.MouldPhoto+1].fPhotoPosM>TabData[TabNo.MouldPhoto+2].fPhotoPosM AND TabData[TabNo.MouldPhoto+1].bCCDed_M AND TabData[TabNo.MouldPhoto+2].bCCDed_M AND NOT TabData[TabNo.MouldPhoto+1].bTabOffsetNG_M AND NOT TabData[TabNo.MouldPhoto+2].bTabOffsetNG_M THEN																									
				fTabInteM_2:=TabData[TabNo.MouldPhoto+1].fPhotoPosM-TabData[TabNo.MouldPhoto+2].fPhotoPosM+(TabData[TabNo.MouldPhoto+2].fTab_OffsetM-TabData[TabNo.MouldPhoto+1].fTab_OffsetM);																								
			ELSE																									
				fTabInteM_2:=PolePar.fPoleWidth;																								
			END_IF																																																																						
		//////////////////////模具前极耳间距内前后肩宽状况判断////////////////////////	
			IF NOT ProductPar.iModeEN.bMouldXOffsetEN THEN																										
				IF ABS(InteData[InteNo.Mould-1].fTabIntervalM-PolePar.fPoleWidth)<=0.5 THEN//片宽偏差小于等于0.5																									
					InteData[InteNo.Mould-1].bTabInteFr_M:=FALSE;																								
					InteData[InteNo.Mould-1].bTabInteBe_M:=FALSE;																								
				ELSE																									
					IF NOT InteData[InteNo.Mould].bTabInteBe_M THEN																								
						InteData[InteNo.Mould-1].bTabInteFr_M:=FALSE;																							
						InteData[InteNo.Mould-1].bTabInteBe_M:=TRUE;																							
					ELSE																								
						InteData[InteNo.Mould-1].bTabInteFr_M:=TRUE;																							
						InteData[InteNo.Mould-1].bTabInteBe_M:=FALSE;																							
					END_IF																								
				END_IF		
			END_IF																							
		
			FOR i1:=1 TO 50 BY 1 DO 																									
					IF i1<50 THEN 																							
						 fM_TabInterData[51-i1]:=fM_TabInterData[50-i1];																																											
					ELSE																							
						fM_TabInterData[1]:=fTabInteM_1;																																											
					END_IF; 																							
			END_FOR; 

*)


(*																																														
//////////////////////蓝胶判断////////////////////////																										
	FOR i6:=1 TO 20 BY 1 DO																									
		IF fBluePos[21-i6]+PolePar.fBlue_Mould-PolePar.fPoleWidth<=TabData[TabNo.MouldPhoto+1].fPhotoPosM AND 																								
			fBluePos[21-i6]+PolePar.fBlue_Mould-PolePar.fPoleWidth>=TabData[TabNo.MouldPhoto+2].fPhotoPosM AND																							
			TabData[TabNo.MouldPhoto+1].fPhotoPosM>TabData[TabNo.MouldPhoto+2].fPhotoPosM AND																							
			TabData[TabNo.MouldPhoto+2].fPhotoPosM>0 AND																							
			fBluePos[21-i6]>0 THEN																							
			InteData[InteNo.Mould-1].bBlueNG:=TRUE;																							
			fBluePos[21-i6]:=0;																							
			EXIT;																							
		ELSE																								
			InteData[InteNo.Mould-1].bBlueNG:=FALSE;																							
		END_IF																								
	END_FOR		
*)			
(*																				
//////////////////////线扫判断////////////////////////																										
	FOR i7:=1 TO 20 BY 1 DO																									
		IF fLineScanPos[21-i7]+PolePar.fLineNG_Mould-PolePar.fPoleWidth<=TabData[TabNo.MouldPhoto+1].fPhotoPosM AND 																								
			fLineScanPos[21-i7]+PolePar.fLineNG_Mould-PolePar.fPoleWidth>=TabData[TabNo.MouldPhoto+2].fPhotoPosM AND																							
			TabData[TabNo.MouldPhoto+1].fPhotoPosM>TabData[TabNo.MouldPhoto+2].fPhotoPosM AND																							
			TabData[TabNo.MouldPhoto+2].fPhotoPosM>0 AND																							
			fLineScanPos[21-i7]>0 THEN																							
			InteData[InteNo.Mould-1].bLineScanNG:=TRUE;																							
			fLineScanPos[21-i7]:=0;																							
			EXIT;																							
		ELSE																								
			InteData[InteNo.Mould-1].bLineScanNG:=FALSE;																							
		END_IF																								
	END_FOR		
*)

   (*
//////////////裁切前黄标检测//////////
     FOR i1:=1 TO 10 BY 1 DO 																									
				IF i1<10 THEN 	
		           YellowmarkNG[11-i1]:=YellowmarkNG[10-i1];
				ELSE  
				   YellowmarkNG[1]:=1;
				END_IF;		
     END_FOR; 	
*)											

//裁断后数据移位													
///////////////////////首位给记忆/////////////////////////		
(*																																																
	IF arrAxisCtrl[AxisNo.Cuter].Status.NoMoving OR fbCuterCam.iTableSel<>1 THEN																									
		iNormalCuter:=0;																								
		bJumpCut:=TRUE;																								
	ELSE																									
		iNormalCuter:=iNormalCuter+1;																								
	END_IF																									
	IF NOT bJumpCut THEN																									
		BeltData[1].iJumpCutNG:=1;//判断切刀NoMoving+1个周期，给2																								
	ELSE																									
		BeltData[1].iJumpCutNG:=2;																								
	END_IF			
*)



(*																								
	IF (InteData[InteNo.Cuter-1].bBlueNG AND NOT ProductPar.iModeEN.bFlgBlueEN OR InteData[InteNo.Cuter-1].bLineScanNG AND NOT ProductPar.iModeEN.bLineScanCCDEN) AND NOT ProductPar.iModeEN.bEmptyRunEN THEN																									
		IF iCuterRunTableSel=1 THEN																								
			fbCuterCam.iTableSel:=2;																							
		ELSE																								
			fbCuterCam.iTableSel:=3; 																							
		END_IF;//裁切凸轮切换为stop																								
	ELSE																									
		fbCuterCam.iTableSel:=1;//裁切凸轮切换为正常																								
	END_IF		
*)		


(*
///////////////////////监测皮带上的记忆/////////////////////////																				
	iBeltNoPeaceCount:=0;																									
	bPeaceBelt1Front:=FALSE;																									
	FOR i1:=1 TO BeltNo.SubBelt1 BY 1 DO 																									
		   bPeaceBelt1Front:=bPeaceBelt1Front OR BeltData[i1].bHavePole ;																								
		   IF iPoleCarryEver=1 AND NOT BeltData[i1].bHavePole THEN																								
			   iBeltNoPeaceCount:=iBeltNoPeaceCount+1;																							
		   END_IF		   																						
	END_FOR;																									
	bPeaceBelt2Front:=FALSE;																									
	FOR i1:=1 TO BeltNo.SubBelt2 BY 1 DO 																									
		   bPeaceBelt2Front:=bPeaceBelt2Front OR BeltData[i1].bHavePole ;																								
		   IF iPoleCarryEver=2 AND NOT BeltData[i1].bHavePole THEN																								
			   iBeltNoPeaceCount:=iBeltNoPeaceCount+1;																							
		   END_IF																								
	END_FOR;																									
	bPeaceBelt3Front:=FALSE;																									
																										
	FOR i1:=1 TO BeltNo.SubBelt3 BY 1 DO 																									
		   bPeaceBelt3Front:=bPeaceBelt3Front OR BeltData[i1].bHavePole ;																								
		   IF iPoleCarryEver=3 AND NOT BeltData[i1].bHavePole THEN																								
			   iBeltNoPeaceCount:=iBeltNoPeaceCount+1;																							
		   END_IF																								
	END_FOR;																									
		bHavePeaceBelt:=FALSE;																								
	FOR i1:=1 TO BeltNo.SubBelt2 BY 1 DO 																									
		   bPeaceBelt2Front:=bPeaceBelt2Front OR BeltData[i1].bHavePole ;																								
	END_FOR;		
*)











]]></ST>
      </Implementation>
    </Action>
    <Action Name="F0505MainAuto5" Id="{b39cfad9-81c8-4946-bcd6-65c257ac9bf0}" FolderPath="F05Auto\">
      <Implementation>
        <ST><![CDATA[
///////////////////////////////////////////////////主轴运行中，主驱&皮带停止，主轴当前周期即将结束。判断皮带耦合状况，主轴运行模式判断 //////////////////////////////////////////////////////////
CASE iAutoRunStep OF 
	
5000://皮带耦合请求
    
   IF  bBelt1Taking  THEN	 ////////////////////////
	   		iMainMode:=1;	
			bBelt1Gearask:=TRUE;
			bBelt2Gearask:=FALSE;
			bBelt3Gearask:=FALSE;
			iStopCount2:=iStopCount2+1;
			iAutoRunStep:=5015;	
   ELSIF  bBelt2Taking  THEN		   /////////////////
		
		   IF NOT bBelt1Taking  THEN   // 1# 2#  
				IF  NOT	 BeltData[BeltNo.SubBelt1].bHavePole  THEN
					 bBelt1Gearask:=TRUE;
					 bBelt2Gearask:=FALSE;
					 bBelt3Gearask:=FALSE;	
					iMainMode:=2;	
					iAutoRunStep:=5015;	
			    ELSE
					iMainMode:=1;	
					bBelt1Gearask:=TRUE;
					bBelt2Gearask:=FALSE;
					bBelt3Gearask:=FALSE;
					iAutoRunStep:=5015;	
			    END_IF	
		   ELSE
				iMainMode:=1;	
				bBelt1Gearask:=TRUE;
				bBelt2Gearask:=FALSE;
				bBelt3Gearask:=FALSE;
				iAutoRunStep:=5015;	
           END_IF 	 
		   
		   
    ELSIF bBelt3Taking  THEN     //3# 取片中 //////////////////////
		
		 IF NOT BeltData[BeltNo.SubBelt1].bHavePole THEN//分段1运行							
			bBelt1Gearask:=TRUE;
			bBelt2Gearask:=FALSE;
			bBelt3Gearask:=FALSE;
			iMainMode:=2;						
		ELSIF BeltData[BeltNo.SubBelt1].bHavePole AND //	bBelt2Need AND 									
			NOT BeltData[BeltNo.SubBelt2].bHavePole THEN 	//分段1/2运行										
			bBelt1Gearask:=TRUE;
			bBelt2Gearask:=TRUE;
			bBelt3Gearask:=FALSE;	
			iMainMode:=2;	
        ELSIF BeltData[BeltNo.SubBelt1].bHavePole AND BeltData[BeltNo.SubBelt2].bHavePole  THEN   
         	bBelt1Gearask:=TRUE;
			bBelt2Gearask:=FALSE;
			bBelt3Gearask:=FALSE;	
			iMainMode:=1; 													
		END_IF	
		iAutoRunStep:=5015;	
				
   ELSE
	
		IF 	NOT BeltData[BeltNo.SubBelt1].bHavePole THEN//分段1运行							
			bBelt1Gearask:=TRUE;
			bBelt2Gearask:=FALSE;
			bBelt3Gearask:=FALSE;	
			 iMainMode:=2;					
		ELSIF BeltData[BeltNo.SubBelt1].bHavePole AND 	//bBelt2Need AND 									
			NOT BeltData[BeltNo.SubBelt2].bHavePole THEN 	//分段1/2运行										
			bBelt1Gearask:=TRUE;
			bBelt2Gearask:=TRUE;
			bBelt3Gearask:=FALSE;	
			 iMainMode:=2;														
		ELSIF bBelt2Need AND bBelt3Need AND 
			BeltData[BeltNo.SubBelt1].bHavePole AND 										
			BeltData[BeltNo.SubBelt2].bHavePole  AND    (   NOT BeltData[BeltNo.SubBelt3].bHavePole OR (BeltData[BeltNo.SubBelt3].bHavePole AND BeltData[BeltNo.SubBelt3].stPoleNo=''AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bSizeCCDEN)   OR     ProductPar.iModeEN.bP2PartEN    )    THEN 	//分段1/2/3运行									
			bBelt1Gearask:=TRUE;
			bBelt2Gearask:=TRUE;
			bBelt3Gearask:=TRUE; 
			 iMainMode:=2;	
        ELSIF   BeltData[BeltNo.SubBelt1].bHavePole  AND   BeltData[BeltNo.SubBelt2].bHavePole   AND  BeltData[BeltNo.SubBelt3].bHavePole AND BeltData[BeltNo.SubBelt3].stPoleNo<>'' AND NOT ProductPar.iModeEN.bP2PartEN   THEN
              iMainMode:=1;	
			  bBelt1Gearask:=TRUE;
			  bBelt2Gearask:=FALSE;
			  bBelt3Gearask:=FALSE;													
		END_IF	
		 iAutoRunStep:=5015;	   
END_IF

5015:
	IF bBelt1Gearask AND NOT bBelt2Gearask AND NOT bBelt3Gearask THEN//分段1运行	
		bSubBelt2fratio:=FALSE;
		bSubBelt3fratio:=FALSE;															
	ELSIF bBelt1Gearask AND bBelt2Gearask AND NOT bBelt3Gearask THEN //分段1/2运行		
		bSubBelt2fratio:=TRUE;
		bSubBelt3fratio:=FALSE;																			
	ELSIF bBelt1Gearask AND bBelt2Gearask AND bBelt3Gearask THEN //分段1/2/3运行		
		bSubBelt2fratio:=TRUE;
		bSubBelt3fratio:=TRUE;				
	END_IF	
	iAutoRunStep:=5020;	

	
5020:	
    	IF   bBelt1Taking  THEN
		iAutoAuxStep6Temp:=iAutoAuxStep6;     //记录超周期时候步序
		iOverCycleCount1:=iOverCycleCount1+1;//超周期计数
	END_IF
	 IF   bBelt2Taking  THEN
		   iAutoAuxStep7Temp:=iAutoAuxStep7;    //记录超周期时候步序
		   iOverCycleCount2:=iOverCycleCount2+1;//超周期计数
	 END_IF 
	 IF   bBelt3Taking  THEN
		  iAutoAuxStep8Temp:=iAutoAuxStep8;    //记录超周期时候步序
		  iOverCycleCount3:=iOverCycleCount3+1;//超周期计数
	 END_IF 
	
	(*
	  IF iMainMode=2 THEN 
		 IF  NOT bBelt1Taking  THEN
			iAutoAuxStep6:=0;
			InterPart.M1Allow:=FALSE;
		 END_IF
		 IF  NOT bBelt2Taking	AND NOT BeltData[BeltNo.SubBelt3].bHavePole  THEN
			iAutoAuxStep7:=0;
			InterPart.M2Allow:=FALSE;
		 END_IF 
		 //IF  NOT bBelt3Taking  THEN
				//iAutoAuxStep8:=0;
				//InterPart.M3Allow:=FALSE;
		 //END_IF
	  END_IF  *)  
	  
	  IF  itest=3 AND  iMainMode=1 THEN
		  iMainMode:=3;
		  iStopCount3:=iStopCount3+1;
		  stAlarm.arrLightWarn[11]:=TRUE; 
	  END_IF
	  
	  
	  IF bMA21 AND  itest=3 AND  iMainMode=2 THEN
	      iMainMode:=3;
	      stAlarm.arrLightWarn[11]:=TRUE; 
		  bMA21:=FALSE;
	  END_IF
	 
	iPoleNoHave1:=iPoleNoHaveA;
	iAutoRunStep:=5030;	
	
	
5030://判断运行模式
	IF stSysState.Stoping THEN
		(*
		IF NOT bFlgStoping THEN
			IF iMainMode=1 OR stSysState.btnEstop THEN
				iAutoRunStep:=500;//异常情况,主轴当前周期立即停止
				bSysStoping:=TRUE;
			ELSE
				iAutoRunStep:=400;//再走一个周期
				bSysStoping:=TRUE;					
			END_IF
		ELSE
			iAutoRunStep:=450;//等待主轴停止
			bSysStoping:=TRUE;
		END_IF *)
		
	   IF NOT bFlgStoping THEN
			IF iMainMode=1  THEN
				bSysStoping:=TRUE;
				iAutoRunStep:=450;
				itest2:=1;
			ELSIF iMainMode=2 THEN
				iAutoRunStep:=400;//再走一个周期
				bSysStoping:=TRUE;
                itest2:=2;	
			ELSIF iMainMode=3 THEN
				iAutoRunStep:=500;//
				bSysStoping:=TRUE;	
                itest2:=3;				
			END_IF
		ELSE
			iAutoRunStep:=450;//等待主轴停止
			bSysStoping:=TRUE;
			 itest2:=4;	 
		END_IF
	END_IF	
	
	
	
  IF NOT stSysState.Stoping THEN
		IF iMainMode=1 THEN
			IF NOT bFlgStoping THEN
				//iAutoRunStep:=500;//异常情况,主轴当前周期立即停止
				iAutoRunStep:=450;
				//itest1:=1;
				//itest2:=iPoleNoHave1;	
			   iStopCount:=iStopCount+1;
			    itest2:=11;	
			ELSE
				iStopCount:=iStopCount+1;
				iAutoRunStep:=450;//等待主轴停止
				  itest2:=12;	
			END_IF
			
		ELSIF iMainMode=2 THEN
			IF iPoleNoHave1=1 THEN
				iAutoRunStep:=400;//再走一个周期
				  itest2:=13;	
			ELSIF iPoleNoHave1=2 THEN
				bFlgStoping:=FALSE;
				arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveVelo:=FALSE;
				iAutoRunStep:=150;//再走多个周期	
				  itest2:=14;	
			ELSIF iPoleNoHave1=0 THEN
				IF NOT bFlgStoping THEN
					//iAutoRunStep:=500;//异常情况,主轴当前周期立即停止   400
					iAutoRunStep:=450;
					itest1:=itest1+1;
					  itest2:=15;	
					//itest2:=iPoleNoHave1;
					//itest3:=iPoleNoHaveA;
				ELSE
					//itest2:=itest2+1;
					iAutoRunStep:=450;//等待主轴停止
					  itest2:=16;	
				END_IF
			END_IF	
        ELSIF iMainMode=3 THEN
		   iAutoRunStep:=500;//异常情况,主轴当前周期立即停止
		     itest2:=17;	
		END_IF
  END_IF
	
	//bBelt1Gearask:=FALSE;
	bBelt2Gearask:=FALSE;
	bBelt3Gearask:=FALSE;		
END_CASE







(*
	
5030://判断运行模式
	IF stSysState.Stoping THEN
		IF NOT bFlgStoping THEN
			IF iMainMode=1 OR stSysState.btnEstop THEN
				iAutoRunStep:=500;//异常情况,主轴当前周期立即停止
				bSysStoping:=TRUE;
			ELSE
				iAutoRunStep:=400;//再走一个周期
				bSysStoping:=TRUE;					
			END_IF
		ELSE
			iAutoRunStep:=450;//等待主轴停止
			bSysStoping:=TRUE;
		END_IF
	END_IF	
	
	IF NOT stSysState.Stoping THEN
		IF iMainMode=1 THEN
			IF NOT bFlgStoping THEN
				//iAutoRunStep:=500;//异常情况,主轴当前周期立即停止
				iAutoRunStep:=400;
				itest1:=1;
				itest2:=iPoleNoHave1;	
			   iStopCount:=iStopCount+1;
			ELSE
				iAutoRunStep:=450;//等待主轴停止
			END_IF
		ELSIF iMainMode=2 THEN
			IF iPoleNoHave1=1 THEN
				iAutoRunStep:=400;//再走一个周期
			ELSIF iPoleNoHave1=2 THEN
				bFlgStoping:=FALSE;
				arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveVelo:=FALSE;
				iAutoRunStep:=150;//再走多个周期	
			ELSIF iPoleNoHave1=0 THEN
				IF NOT bFlgStoping THEN
					//iAutoRunStep:=500;//异常情况,主轴当前周期立即停止   400
					iAutoRunStep:=400;
					itest1:=2;
					itest2:=iPoleNoHave1;
					itest3:=iPoleNoHaveA;
				ELSE
					iAutoRunStep:=450;//等待主轴停止
				END_IF
			END_IF			
		END_IF
	 END_IF
	
	bBelt1Gearask:=FALSE;
	bBelt2Gearask:=FALSE;
	bBelt3Gearask:=FALSE;		
*)















(*
5000://皮带耦合请求
   IF   ( InterPart.M1Allow  OR  bBelt1Taking )  OR         //没取玩后者  锁定取片中
           ( InterPart.M2Allow  OR  bBelt2Taking )  OR     //没取玩后者  锁定取片中
            (InterPart.M3Allow  OR  bBelt3Taking )     THEN    //没取玩后者  锁定取片中  THEN
			 	bSubBelt2fratio:=FALSE;
				bSubBelt3fratio:=FALSE;	
            	iMainMode:=1;		
                iAutoRunStep:=5015;	
    ELSE	
		
			IF 	NOT BeltData[BeltNo.SubBelt1].bHavePole THEN//分段1运行							
				bBelt1Gearask:=TRUE;
				bBelt2Gearask:=FALSE;
				bBelt3Gearask:=FALSE;									
			ELSIF bBelt2Need AND BeltData[BeltNo.SubBelt1].bHavePole AND 										
					 NOT BeltData[BeltNo.SubBelt2].bHavePole THEN 	//分段1/2运行										
				bBelt1Gearask:=TRUE;
				bBelt2Gearask:=TRUE;
				bBelt3Gearask:=FALSE;																		
			ELSIF bBelt2Need AND bBelt3Need AND 
					 BeltData[BeltNo.SubBelt1].bHavePole AND 										
					 BeltData[BeltNo.SubBelt2].bHavePole  AND    (   NOT BeltData[BeltNo.SubBelt3].bHavePole   OR     ProductPar.iModeEN.bP2PartEN    )    THEN 	//分段1/2/3运行									
				bBelt1Gearask:=TRUE;
				bBelt2Gearask:=TRUE;
				bBelt3Gearask:=TRUE;																		
			END_IF	
		 iMainMode:=2;	
	     iAutoRunStep:=5010;
		 
  END_IF

*)


(*

5010:
	IF 	NOT BeltData[BeltNo.SubBelt1].bHavePole THEN//分段1运行							
		bBelt1Gearask:=TRUE;
		bBelt2Gearask:=FALSE;
		bBelt3Gearask:=FALSE;									
	ELSIF bBelt2Need AND BeltData[BeltNo.SubBelt1].bHavePole AND 										
		NOT BeltData[BeltNo.SubBelt2].bHavePole THEN 	//分段1/2运行										
		bBelt1Gearask:=TRUE;
		bBelt2Gearask:=TRUE;
		bBelt3Gearask:=FALSE;																					
	END_IF	
	iAutoRunStep:=5015;	

	
5011://综合判断皮带耦合
	IF 	NOT BeltData[BeltNo.SubBelt1].bHavePole THEN//分段1运行							
		bBelt1Gearask:=TRUE;
		bBelt2Gearask:=FALSE;
		bBelt3Gearask:=FALSE;									
	ELSIF bBelt2Need AND BeltData[BeltNo.SubBelt1].bHavePole AND 										
		NOT BeltData[BeltNo.SubBelt2].bHavePole THEN 	//分段1/2运行										
		bBelt1Gearask:=TRUE;
		bBelt2Gearask:=TRUE;
		bBelt3Gearask:=FALSE;																		
	ELSIF bBelt2Need AND bBelt3Need AND 
		BeltData[BeltNo.SubBelt1].bHavePole AND 										
		BeltData[BeltNo.SubBelt2].bHavePole  AND    (   NOT BeltData[BeltNo.SubBelt3].bHavePole   OR     ProductPar.iModeEN.bP2PartEN    )    THEN 	//分段1/2/3运行									
		bBelt1Gearask:=TRUE;
		bBelt2Gearask:=TRUE;
		bBelt3Gearask:=TRUE;																		
	END_IF	
	iAutoRunStep:=5015;		

*)









(*
	
5010://综合判断皮带耦合
//IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=345 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<355 THEN//345   355
	IF bBelt1Gearask AND NOT bBelt2Gearask AND NOT bBelt3Gearask THEN//分段1运行	
		IF NOT bBelt1Taking THEN
			bSubBelt2fratio:=FALSE;
			bSubBelt3fratio:=FALSE;														
			iMainMode:=2;
		ELSE	
			bSubBelt2fratio:=FALSE;
			bSubBelt3fratio:=FALSE;											
			iMainMode:=1;		
		 END_IF			
	ELSIF bBelt1Gearask AND bBelt2Gearask AND NOT bBelt3Gearask THEN //分段1/2运行		
			IF NOT bBelt1Taking  AND NOT   bBelt2Taking  THEN
				bSubBelt2fratio:=TRUE;
				bSubBelt3fratio:=FALSE;																			
				iMainMode:=2;				
			ELSE
				bSubBelt2fratio:=FALSE;
				bSubBelt3fratio:=FALSE;											
				iMainMode:=1;								
			END_IF	
	ELSIF bBelt1Gearask AND bBelt2Gearask AND bBelt3Gearask THEN //分段1/2/3运行		
			IF NOT bBelt1Taking AND NOT bBelt2Taking  AND NOT bBelt3Taking    THEN
				bSubBelt2fratio:=TRUE;
				bSubBelt3fratio:=TRUE;		
				iMainMode:=2;														
			ELSE
				bSubBelt2fratio:=FALSE;
				bSubBelt3fratio:=FALSE;												
				iMainMode:=1;							
			END_IF						
	END_IF
		iAutoRunStep:=5015;
//END_IF

5015:	
	(************************下个周期皮带启动异常报警************************)
		    IF   bBelt1Taking  THEN
				   iAutoAuxStep6Temp:=iAutoAuxStep6;     //记录超周期时候步序
				   iOverCycleCount1:=iOverCycleCount1+1;//超周期计数
			 END_IF
			  IF   bBelt2Taking  THEN
				   iAutoAuxStep7Temp:=iAutoAuxStep7;    //记录超周期时候步序
				   iOverCycleCount2:=iOverCycleCount2+1;//超周期计数
			 END_IF 
			 IF   bBelt3Taking  THEN
					  iAutoAuxStep8Temp:=iAutoAuxStep8;    //记录超周期时候步序
					  iOverCycleCount3:=iOverCycleCount3+1;//超周期计数
			 END_IF 
	
	  IF iMainMode=2 THEN 
			  IF  NOT bBelt1Taking  THEN
					iAutoAuxStep6:=0;
					InterPart.M1Allow:=FALSE;
			 END_IF
			  IF  NOT bBelt2Taking	AND NOT BeltData[BeltNo.SubBelt3].bHavePole  THEN
					iAutoAuxStep7:=0;
					InterPart.M2Allow:=FALSE;
			 END_IF 
			 //IF  NOT bBelt3Taking  THEN
					//iAutoAuxStep8:=0;
					//InterPart.M3Allow:=FALSE;
			 //END_IF
	  END_IF
	 
	iPoleNoHave1:=iPoleNoHaveA;
	iAutoRunStep:=5020;

5020://判断运行模式
	IF stSysState.Stoping THEN
		IF NOT bFlgStoping THEN
			IF iMainMode=1 OR stSysState.btnEstop THEN
				iAutoRunStep:=500;//异常情况,主轴当前周期立即停止
				bSysStoping:=TRUE;
			ELSE
				iAutoRunStep:=400;//再走一个周期
				bSysStoping:=TRUE;					
			END_IF
		ELSE
			iAutoRunStep:=450;//等待主轴停止
			bSysStoping:=TRUE;
		END_IF
	ELSE
		IF iMainMode=1 THEN
			IF NOT bFlgStoping THEN
				iAutoRunStep:=500;//异常情况,主轴当前周期立即停止
				itest1:=1;
				itest2:=iPoleNoHave1;
				bTest[11]:=bBelt1Gearask;
				bTest[12]:=bBelt2Gearask;
				bTest[13]:=bBelt3Gearask;
				bTest[14]:=bBelt1Taking;
				bTest[15]:=bBelt2Taking;		
               iStopCount:=iStopCount+1;
			ELSE
				iAutoRunStep:=450;//等待主轴停止
			END_IF
		ELSE
			IF iPoleNoHave1=1 THEN
				iAutoRunStep:=400;//再走一个周期
			ELSIF iPoleNoHave1=2 THEN
				bFlgStoping:=FALSE;
				iAutoRunStep:=150;//再走多个周期	
				(*
				IF arrAxisCtrl[VirAxisNo.VirMain].Status.Moving THEN
					iAutoRunStep:=150;//再走多个周期
				ELSE
					arrAxisPar[VirAxisNo.VirMain].fVelocity_of_Velo:=PolePar.iMainVel*6;
					arrAxisCtrl[VirAxisNo.VirMain].Cmd.bMoveVelo:=TRUE;
				END_IF	
				*)
			ELSIF iPoleNoHave1=0 THEN
				
				IF NOT bFlgStoping THEN
					iAutoRunStep:=400;//异常情况,主轴当前周期立即停止
					itest1:=2;
					itest2:=iPoleNoHave1;
					itest3:=iPoleNoHaveA;
					bTest[11]:=bBelt1Gearask;
					bTest[12]:=bBelt2Gearask;
					bTest[13]:=bBelt3Gearask;
					bTest[14]:=bBelt1Taking;
					bTest[15]:=bBelt2Taking;
				ELSE
					iAutoRunStep:=450;//等待主轴停止
				END_IF
			END_IF			
		END_IF
	END_IF
	bBelt1Gearask:=FALSE;
	bBelt2Gearask:=FALSE;
	bBelt3Gearask:=FALSE;			

*)

]]></ST>
      </Implementation>
    </Action>
    <Action Name="F0506MainAuto6" Id="{ced1a7f7-55cc-47a7-961f-0d671a532305}" FolderPath="F05Auto\">
      <Implementation>
        <ST><![CDATA[//////////////////////////////////////////////主轴静止中，由于皮带料满，主轴运动自动停止,判断皮带耦合状况. 继续与叠片交互//////////////////////////////////////////////////////

DelayStep6(IN:= , PT:=T#2MS , Q=> , ET=> );
CASE iAutoRunStep OF 
6000://
	IF iPoleNoHaveA=0 THEN
		iAutoRunStep:=6010;//皮带上料全满
	ELSIF    NOT bBelt1Taking  AND  NOT  InterPart.M1Allow   AND  
                NOT bBelt2Taking  AND  NOT  InterPart.M2Allow   AND 
                NOT bBelt3Taking  AND  NOT  InterPart.M3Allow   THEN
		iAutoAuxStep6:=0;
		InterPart.M1Allow:=FALSE;	
		iAutoAuxStep7:=0;
		InterPart.M2Allow:=FALSE;				
		iAutoAuxStep8:=0;
		InterPart.M3Allow:=FALSE;
		iAutoRunStep:=100;//皮带上料未满,返回继续切片送料
	END_IF	
6010://
	IF (iPoleCarryEver=3 AND 
        (NOT bBelt1Taking AND  NOT  InterPart.M1Allow  AND 
         NOT bBelt2Taking AND  NOT  InterPart.M2Allow  AND
         NOT bBelt3Taking AND  NOT  InterPart.M3Allow     )      ) OR
	
		(iPoleCarryEver=2 AND (NOT bBelt1Taking AND NOT bBelt2Taking )) OR
		(iPoleCarryEver=1 AND NOT bBelt1Taking )  THEN
		iAutoRunStep:=6020;//
	ELSE
		iAutoRunStep:=6000;//
	END_IF
	
6020://
	IF iPoleCarryEver=3 THEN
		IF BeltData[BeltNo.SubBelt1].bHavePole //AND ((*BeltData[BeltNo.SubBelt1].stPoleNo<>'' OR*) ProductPar.iModeEN.bCcdTcpEN)
			AND BeltData[BeltNo.SubBelt2].bHavePole //AND ((*BeltData[BeltNo.SubBelt2].stPoleNo<>'' OR*) ProductPar.iModeEN.bCcdTcpEN)
			AND BeltData[BeltNo.SubBelt3].bHavePole //AND ((*BeltData[BeltNo.SubBelt3].stPoleNo<>'' OR*) ProductPar.iModeEN.bCcdTcpEN)
			AND (iAutoAuxStep9=0 OR iAutoAuxStep9=666)  THEN
			iAutoAuxStep9:=100;
		END_IF			
	ELSIF iPoleCarryEver=2 THEN
		IF BeltData[BeltNo.SubBelt1].bHavePole AND (BeltData[BeltNo.SubBelt1].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN)
			AND BeltData[BeltNo.SubBelt2].bHavePole AND (BeltData[BeltNo.SubBelt2].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN)
			AND    NOT  bBelt1Taking AND   iAutoAuxStep6<>20     THEN
			iAutoAuxStep6:=10;
			//bBelt1Taking:=TRUE;
		END_IF
		IF BeltData[BeltNo.SubBelt2].bHavePole  AND  (BeltData[BeltNo.SubBelt2].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN)
			AND NOT  bBelt2Taking AND   iAutoAuxStep7<>20  THEN
			iAutoAuxStep7:=10;
			//bBelt2Taking:=TRUE;
		END_IF
	ELSE
		IF BeltData[BeltNo.SubBelt1].bHavePole AND (BeltData[BeltNo.SubBelt1].stPoleNo<>'' OR ProductPar.iModeEN.bCcdTcpEN OR ProductPar.iModeEN.bSizeCCDEN)
		AND  NOT  bBelt1Taking AND   iAutoAuxStep6<>20        THEN
			iAutoAuxStep6:=10;
			//bBelt1Taking:=TRUE;
		END_IF	
	END_IF	
	DelayStep6.IN:=TRUE;
	iAutoRunStep:=6030;		
(*	
6020://
		IF iPoleCarryEver=3 THEN
			IF BeltData[BeltNo.SubBelt1].bHavePole AND BeltData[BeltNo.SubBelt2].bHavePole AND BeltData[BeltNo.SubBelt3].bHavePole  THEN	
					IF (InterPart.M1LockReady OR InterPart.M1JumpReady) AND (InterPart.M2LockReady OR InterPart.M2JumpReady) AND
					   (InterPart.M3LockReady OR InterPart.M3JumpReady) THEN
							IF 	InterPart.M1LockReady AND NOT bBelt1Taking AND NOT  InterPart.M1Allow  THEN
								iAutoAuxStep6:=10;
							END_IF
							IF 	InterPart.M2LockReady AND NOT bBelt2Taking AND NOT  InterPart.M2Allow   THEN
								iAutoAuxStep7:=10;
							END_IF	
							IF 	InterPart.M3LockReady AND NOT bBelt3Taking AND NOT  InterPart.M3Allow   THEN
								iAutoAuxStep8:=10;
							END_IF		
					END_IF		
			END_IF			

	
		ELSIF iPoleCarryEver=2 THEN
			IF BeltData[BeltNo.SubBelt1].bHavePole AND BeltData[BeltNo.SubBelt2].bHavePole AND    NOT  bBelt1Taking AND   iAutoAuxStep6<>20     THEN
				iAutoAuxStep6:=10;
				//bBelt1Taking:=TRUE;
			END_IF
			IF BeltData[BeltNo.SubBelt2].bHavePole  AND    NOT  bBelt2Taking AND   iAutoAuxStep7<>20  THEN
				iAutoAuxStep7:=10;
				//bBelt2Taking:=TRUE;
			END_IF
		ELSE
			IF BeltData[BeltNo.SubBelt1].bHavePole  AND  NOT  bBelt1Taking AND   iAutoAuxStep6<>20        THEN
				iAutoAuxStep6:=10;
				//bBelt1Taking:=TRUE;
			END_IF	
		END_IF
		
		DelayStep6.IN:=TRUE;
		iAutoRunStep:=6030;
*)
6030:		
		IF DelayStep6.Q THEN
			DelayStep6.IN:=FALSE;
			iAutoRunStep:=6000;
		END_IF
				
END_CASE
]]></ST>
      </Implementation>
    </Action>
    <Action Name="F0511CCDAuto" Id="{f14efd26-61eb-4417-b8c9-391a17c82217}" FolderPath="F05Auto\">
      <Implementation>
        <ST><![CDATA[

///////////////////////////////////////////////////////////尺寸检测///////////////////////////////////////////////////////////////////
CASE iAutoAuxStep3 OF
10://
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos < fRecordOverHangInMainPos-fRecordOverHangInMainPosMod+360+ProductPar.parPublic.fMainPos-10 THEN//到下个周期250度以前有效
		IF arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos>=fRecordOverHangInMainPos+30 THEN
			IF CCD_COM.Size.iFinish=1 OR CCD_COM.Size.iFinish=2 OR CCD_COM.Size.iFinish=3 THEN
					IF 1<=CCD_COM.Size.fPoleNGSizeNo AND CCD_COM.Size.fPoleNGSizeNo<=30 THEN
						BeltData[BeltNo.OverHang].fPoleHeigh:=CCD_COM.Size.fPoleHeigh;//极片高；
						BeltData[BeltNo.OverHang].fPoleWidth:=CCD_COM.Size.fPoleWidth;//极片长（运行方向）；
						BeltData[BeltNo.OverHang].stPoleNo:=CCD_COM.Size.stPoleNo;//
						
						BeltData[BeltNo.OverHang].fTabWidth:=CCD_COM.Size.fTabWidth;  //尺寸检测CCD结果(极耳宽度)
						BeltData[BeltNo.OverHang].fTabHeigh:=CCD_COM.Size.fTabHeigh;  //尺寸检测CCD结果(极耳高度)
						BeltData[BeltNo.OverHang].fTabSite:=CCD_COM.Size.fTabSite; // 极耳左，右边距(就是极耳位置，不分左右)
						//BeltData[BeltNo.OverHang].fOffsetDeg:=CCD_COM.Size.fOffsetDeg; //尺寸检测CCD结果(极片裁切面角度偏移)
						
						BeltData[BeltNo.OverHang].RoundedSize1:=CCD_COM.Size.RoundedSize1   ;//        圆角尺寸1 面积   叠片侧(正极)       负极相反
						BeltData[BeltNo.OverHang].RoundedSize2:=CCD_COM.Size.RoundedSize2   ;//        圆角尺寸2 面积    切刀侧(正极)        负极相反
						BeltData[BeltNo.OverHang].RoundedSize3:=CCD_COM.Size.RoundedSize3  ;//        圆角尺寸3纵深 叠片侧(正极)        负极相反
						BeltData[BeltNo.OverHang].RoundedSize4:=CCD_COM.Size.RoundedSize4   ;//        圆角尺寸4纵深 切刀侧(正极)     负极相反
						BeltData[BeltNo.OverHang].RoundedSize5:=CCD_COM.Size.RoundedSize5   ;//        圆角尺寸5 横深
						BeltData[BeltNo.OverHang].RoundedSize6:=CCD_COM.Size.RoundedSize6  ;//        圆角尺寸6横深
						BeltData[BeltNo.OverHang].RoundedSize7:=CCD_COM.Size.RoundedSize7   ;//        圆角尺寸7横深 叠片侧(正极)     负极相反
						BeltData[BeltNo.OverHang].RoundedSize8:=CCD_COM.Size.RoundedSize8  ;//        圆角尺寸8横深 切刀侧(正极)     负极相反
						
						BeltData[BeltNo.OverHang].PolePlateAngle1 :=CCD_COM.Size.PolePlateAngle1 ;//        极片角度1  极片角度
						BeltData[BeltNo.OverHang].PolePlateAngle2:=CCD_COM.Size.PolePlateAngle2  ;//        极片角度2
						BeltData[BeltNo.OverHang].PolePlateAngle3:=CCD_COM.Size.PolePlateAngle3   ;//        极片角度3
						BeltData[BeltNo.OverHang].PolePlateAngle4:=CCD_COM.Size.PolePlateAngle4   ;//        极片角度4
						BeltData[BeltNo.OverHang].fPoleNGSizeNo:=CCD_COM.Size.fPoleNGSizeNo;  //尺寸检测CCD结果(NG分类编号)
						BeltData[BeltNo.OverHang].iPoleRAngleNG:=CCD_COM.Size.iPoleRAngleNG;//尺寸检测CCD结果(R角NG)
						BeltData[BeltNo.OverHang].iFinish:=CCD_COM.Size.iFinish;  //尺寸检测CCD结果指示(1=完成;2=NG;3=无片;0=无效)  SizeResults
						BeltData[BeltNo.OverHang].AppearanceResult:=CCD_COM.Size.AppearanceResult;// 极片外观判定结果   线扫NG、OK
						BeltData[BeltNo.OverHang].PolePlateLenth :=CCD_COM.Size.fTabWidth ;// 极片外观判定结果   线扫NG、OK
						//BeltData[BeltNo.OverHang].SlicingSpeed:=GVL_Par.ProductPar.AnPar.iMainVel;//切片速度PPM;
						//BeltData[BeltNo.OverHang].UnreelingTension :=ABS(GMotion.iTargetTorque[1]);//放卷张力  %；
						BeltData[BeltNo.OverHang].SlicingSpeed:=PolePar.fSpeed;//切片速度PPM;
						//BeltData[BeltNo.OverHang].UnreelingTension :=(480+ab);
						CCD_Rounde.CCD_Enable:=TRUE;//R纠偏闭环数据记录开始
						
						//BeltData[BeltNo.OverHang].UnreelingTension :=PolePar.fTension;//放卷张力
						BeltData[BeltNo.OverHang].UnreelingTension :=PolePar.fTension;//放卷张力	
						BeltData[BeltNo.OverHang].fPoleNGSizeNo:=CCD_COM.Size.fPoleNGSizeNo; 	
		                               BeltData[BeltNo.OverHang].iTabNGSizeNo:=CCD_COM.Size.iTabNGSizeNo; 	
					END_IF
					
		
						IF ABS(CCD_COM.Size.fOffsetDeg)<5 THEN
							FOR i3:=1 TO 10 BY 1 DO 
								IF i3<10 THEN 
									fOffsetDeg[11-i3]:=fOffsetDeg[10-i3];
								END_IF; 
							END_FOR; 
							fOffsetDeg[1]:=CCD_COM.Size.fOffsetDeg;		//偏移值正负要定好
						END_IF
						
						
						IF CCD_COM.Size.iFinish=1 THEN		//CCD结果OK
							BeltData[BeltNo.OverHang].iPanoramaNG:=1;
							BeltData[BeltNo.OverHang].iFinish:=CCD_COM.Size.iFinish;
							BeltData[BeltNo.OverHang].fPoleNGSizeNo:=CCD_COM.Size.fPoleNGSizeNo; 
							iAutoAuxStep3:=888;
							iNGSize:=0;
						ELSIF CCD_COM.Size.iFinish=2 THEN		//CCD结果NG
							BeltData[BeltNo.OverHang].iPanoramaNG:=2;
							BeltData[BeltNo.OverHang].iFinish:=CCD_COM.Size.iFinish;
							BeltData[BeltNo.OverHang].fPoleNGSizeNo:=CCD_COM.Size.fPoleNGSizeNo; 
							iAutoAuxStep3:=888;
							iNGSize:=iNGSize+1;	
						ELSIF CCD_COM.Size.iFinish=3 THEN		//无片
							BeltData[BeltNo.OverHang].iPanoramaNG:=3;
							BeltData[BeltNo.OverHang].iFinish:=CCD_COM.Size.iFinish;
							BeltData[BeltNo.OverHang].fPoleNGSizeNo:=CCD_COM.Size.fPoleNGSizeNo; 
							iNGSize:=iNGSize+1;	
							 
							stAlarm.arrFlowAlarm[21]:= (TRUE AND NOT ProductPar.iModeEN.bEmptyRunEN)  ;
							 
							iAutoAuxStep3:=888;
							iNGSize:=iNGSize+1;		
						END_IF	
				END_IF
			END_IF
	ELSE
		BeltData[BeltNo.OverHang].iPanoramaNG:=0;
		BeltData[BeltNo.OverHang].fPoleNGSizeNo:=CCD_COM.Size.fPoleNGSizeNo; 
		stAlarm.arrLightWarn[5]:=TRUE;//尺寸CCD检测超时，请查看！
		iAutoAuxStep3:=888;
		iNGSize:=iNGSize+1;
	END_IF
888://
;
END_CASE


///////////////////////////////////////////////////////////冲R角定位检测//////////////////////////////////////////////////////////////////
CASE iAutoAuxStep4 OF
10://
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos < fRecordMouldCCDInMainPos-fRecordMouldCCDInMainPosMod+360+ProductPar.parPublic.fMainPos-10 THEN//到下个周期250度以前有效			
		IF arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos>=fRecordMouldCCDInMainPos+30 THEN		
			IF CCD_COM.Chamfer.iFinish=1 THEN
				CutMark_R[0]:=FALSE;
				TabData[TabNo.MouldPhoto].fTab_OffsetM:=CCD_COM.Chamfer.fTabXOffset;
				TabData[TabNo.MouldPhoto].fTab_OffsetY:=CCD_COM.Chamfer.fTabYOffset; //20240524SJ
				iAutoAuxStep4:=888;
			ELSIF CCD_COM.Chamfer.iFinish=2 THEN
				CutMark_R[0]:=FALSE;
				TabData[TabNo.MouldPhoto].fTab_OffsetM:=CCD_COM.Chamfer.fTabXOffset;//CCD抓不到极耳时，给NG，纠偏量给1个片宽
				TabData[TabNo.MouldPhoto].fTab_OffsetY:=CCD_COM.Chamfer.fTabYOffset; //20240524SJ
				TabData[TabNo.MouldPhoto].bTabOffsetNG_M:=TRUE;
				//stAlarm.arrLightWarn[1]:=TRUE;//冲R角CCD定位检测NG，请查看！
				iAutoAuxStep4:=888;	
			ELSIF CCD_COM.Chamfer.iFinish=3 THEN
				TabData[TabNo.MouldPhoto].bTabOffsetNG_M:=TRUE;
				CutMark_R[0]:=TRUE;
				iAutoAuxStep4:=888;	
			END_IF	
		END_IF		
	ELSE			
		//TabData[TabNo.MouldPhoto].fTab_OffsetM:=PolePar.fPoleWidth;
		TabData[TabNo.MouldPhoto].fTab_OffsetM:=0;//20240524SJ
		TabData[TabNo.MouldPhoto].bTabOffsetNG_M:=TRUE;
		stAlarm.arrLightWarn[2]:=TRUE;//冲R角CCD定位检测超时，请查看！		
		iAutoAuxStep4:=889;			
	END_IF
888:
	;
END_CASE

///////////////////////////////////////////////////////////裁切定位检测////////////////////////////////////////////////////////////////////
CASE iAutoAuxStep5 OF
10://
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos < fRecordCuterCCDInMainPos-fRecordCuterCCDInMainPosMod+360+ProductPar.parPublic.fMainPos-10 THEN//到下个周期250度以前有效			
		IF arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos>=fRecordCuterCCDInMainPos+30 THEN		
			IF CCD_COM.Cuter.iFinish=1 THEN	
				TabData[TabNo.CuterPhoto].fTab_OffsetC:=CCD_COM.Cuter.fTabXOffset;
				InteData[InteNo.Cuter-2].fTabIntervalC:=CCD_COM.Cuter.fTabWidth;
				iAutoAuxStep5:=100;
			ELSIF CCD_COM.Cuter.iFinish=2 THEN	
				TabData[TabNo.CuterPhoto].fTab_OffsetC:=CCD_COM.Cuter.fTabXOffset;
				InteData[InteNo.Cuter-2].fTabIntervalC:=CCD_COM.Cuter.fTabWidth;//CCD抓不到极耳时，给NG，左侧相机纠偏量给1个片宽,,片宽给0
				InteData[InteNo.Cuter-2].bIntervalFail_C:=TRUE;
				TabData[TabNo.CuterPhoto].bTabOffsetNG_C:=TRUE;
				//stAlarm.arrLightWarn[3]:=TRUE;//裁切CCD定位检测NG，请查看！		
				iAutoAuxStep5:=888;
			ELSIF CCD_COM.Cuter.iFinish=3 THEN	
	                 	TabData[TabNo.CuterPhoto].fTab_OffsetC:=CCD_COM.Cuter.fTabXOffset;
				InteData[InteNo.Cuter-2].fTabIntervalC:=CCD_COM.Cuter.fTabWidth;//CCD抓不到极耳时，给NG，左侧相机纠偏量给1个片宽,,片宽给0
				InteData[InteNo.Cuter-2].bIntervalFail_C:=TRUE;
				TabData[TabNo.CuterPhoto].bTabOffsetNG_C:=TRUE;
				//stAlarm.arrLightWarn[3]:=TRUE;//裁切CCD定位检测NG，请查看！		
				iAutoAuxStep5:=888;					
			END_IF	
		END_IF		
	ELSE			
		TabData[TabNo.CuterPhoto].fTab_OffsetC:=PolePar.fPoleWidth;
		InteData[InteNo.Cuter-2].fTabIntervalC:=0;	
		InteData[InteNo.Cuter-2].bIntervalFail_C:=TRUE;
		TabData[TabNo.CuterPhoto].bTabOffsetNG_C:=TRUE;
		PolePar.AddAlarm  :=PolePar.AddAlarm +1;
		stAlarm.arrLightWarn[4]:=TRUE;//裁切CCD定位检测超时，请查看！					
		iAutoAuxStep5:=889;		
	END_IF
	
100:

	IF CCD_COM.Cuter.iFinish=1 AND ( ABS(CCD_COM.Cuter.fTabWidth-PolePar.TabWidthBace)>=0.5 ) THEN
		Production.NGFlag[15]:=TRUE;
		iTabWidth_JS:=iTabWidth_JS+1;
		iAutoAuxStep5:=200;	
	ELSE
		iTabWidth_JS:=0;
		iAutoAuxStep5:=300;	
	END_IF
200:		
	IF iTabWidth_JS >=10 AND NOT ProductPar.iModeEN.bTabWidtNGoff THEN
		stAlarm.arrFlowAlarm[41]:=TRUE;//极片来料不良，请检查
		iTabWidth_JS:=0;
	END_IF
	Production.NGFlag[15]:=FALSE;
	iAutoAuxStep5:=888;	

300:
	iTabWidth_JS:=0;
	iAutoAuxStep5:=888;	
888:
	;	
	
	
END_CASE

////////////////////////////////////////////////////////////////线扫拍照触发////////////////////////////////////////////////////////////////
ttLinePhoto(CLK:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=2  
						AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<=6 
						AND  arrAxisCtrl[VirAxisNo.VirMain].Status.Moving 
						AND  stDriverCam.bInSync         , Q=> );
IF ttLinePhoto.Q THEN
	CCD_COM.Scan.bSendMark:=FALSE;//PLC_To_PC上位机的发送数据标志
	IF NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN  THEN//线扫OK信号
		
		CCD_COM.Scan.iResult_IO_UP:=33;//复位线扫IO结果
		CCD_COM.Scan.iResult_IO_Down:=33;
		bLineScanResult1_UP:=FALSE;
		bLineScanResult2_UP:=FALSE;
		bLineScanResult1_Down:=FALSE;
		bLineScanResult2_Down:=FALSE;
		CCD_IO.boXSPhoto:=TRUE;//自动线扫启动
		CCD_Com.iLineScanPhotoCount:=CCD_Com.iLineScanPhotoCount+1;
		IF  NOT  ProductPar.iLineScanSel THEN
	    	iAutoAuxStep11:=10;
		END_IF
		fRecordLineineScanCCDInMainPos:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos;																								
		fRecordLineineScanCCDInMainPosMod:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos;		
	END_IF	
END_IF	

rLineScan_UPTCP(CLK:=CCD_COM.Scan.iResult_UP<>33      , Q=> );
rLineScan_DownTCP(CLK:=CCD_COM.Scan.iResult_Down<>33 , Q=> );

IF ProductPar.iLineScanSel THEN
     IF rLineScan_UPTCP.Q THEN
		 IF CCD_COM.Scan.iResult_UP<>0 THEN
		    CCD_Com.iLineScanReceiveResultCount_UP:=CCD_Com.iLineScanReceiveResultCount_UP+1;
		 END_IF
	 END_IF

     IF rLineScan_DownTCP.Q THEN
		  IF CCD_COM.Scan.iResult_Down<>0 THEN
		     CCD_Com.iLineScanReceiveResultCount_Down:=CCD_Com.iLineScanReceiveResultCount_Down+1;
		  END_IF
	 END_IF

ELSE 
			IF  rLineScanOK_UP.Q  OR rLineScanNG_UP.Q THEN
				CCD_Com.iLineScanReceiveResultCount_UP:=CCD_Com.iLineScanReceiveResultCount_UP+1;
				fDA1:=        arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos;
			END_IF

		    IF  rLineScanOK_Down.Q  OR rLineScanNG_Down.Q THEN
				CCD_Com.iLineScanReceiveResultCount_Down:=CCD_Com.iLineScanReceiveResultCount_Down+1;
				fDA2:=        arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos;
			END_IF

END_IF			
			
	IF CCD_Com.bLineScanPhotoCountClear THEN
       CCD_Com.iLineScanPhotoCount:=0;
	   CCD_Com.iLineScanReceiveResultCount_UP:=0;
	   CCD_Com.iLineScanReceiveResultCount_Down:=0;
    END_IF		
			
				
CASE iAutoAuxStep11 OF
10://
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>5 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos < ProductPar.parPublic.fMainPos-15 THEN//到下个周期判断结果前有效
			IF rLineScanOK_UP.Q THEN
				bLineScanResult1_UP:=TRUE;
			END_IF
			IF rLineScanNG_UP.Q THEN
				bLineScanResult2_UP:=TRUE;
			END_IF

			IF rLineScanOK_Down.Q THEN
				bLineScanResult1_Down:=TRUE;
			END_IF
			IF rLineScanNG_Down.Q THEN
				bLineScanResult2_Down:=TRUE;
			END_IF	
	
		IF (bLineScanResult1_UP OR bLineScanResult2_UP) AND (bLineScanResult1_Down OR bLineScanResult2_Down) THEN
			iAutoAuxStep11:=888;
		END_IF
	
	ELSIF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos > 320 THEN
		IF NOT (bLineScanResult1_UP OR bLineScanResult2_UP) AND (bLineScanResult1_Down OR bLineScanResult2_Down) THEN  //AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN
			stAlarm.arrFlowAlarm[25]:=TRUE;//上线扫超时报警
		END_IF
		IF (bLineScanResult1_UP OR bLineScanResult2_UP) AND NOT (bLineScanResult1_Down OR bLineScanResult2_Down) THEN//	AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bLineScanCCDEN 
			stAlarm.arrFlowAlarm[27]:=TRUE;//下线扫超时报警
		END_IF
		iAutoAuxStep11:=886;
	END_IF
	
END_CASE

///////////////////////////////////////////////////////////CCD标定流程////////////////////////////////////////////////////////////////////
IF stSysState.iMode=3 THEN
	CASE iAutoAuxStep10 OF 
	0://
		IF 	CCD_IO.bCalibrationsDo THEN
			bChaNoPhoto:=FALSE;
			bCutNoPhoto:=FALSE;			
			iAutoAuxStep10:=10;
		ELSIF NOT CCD_IO.bCalibrationsDo AND CCD_IO.bCalibrationsDo_Cha AND NOT CCD_IO.bCalibrationsDo_Cut THEN
			bChaNoPhoto:=FALSE;
			bCutNoPhoto:=TRUE;
			iAutoAuxStep10:=10;
		ELSIF NOT CCD_IO.bCalibrationsDo AND NOT CCD_IO.bCalibrationsDo_Cha AND CCD_IO.bCalibrationsDo_Cut THEN
			bChaNoPhoto:=TRUE;
			bCutNoPhoto:=FALSE;			
			iAutoAuxStep10:=10;
		END_IF
	10://
		CCD_IO.bDemRuning:=TRUE;
		CCD_COM.iDemCount:=1;//是否需要延时
		iAutoAuxStep10:=20;
	20://
		IF NOT bChaNoPhoto THEN
			CCD_COM.iDemResult_Cha:=0;
			CCD_IO.hmiChamferPhoto:=TRUE;
		END_IF
		IF NOT bCutNoPhoto THEN
			CCD_COM.iDemResult_Cut:=0;
			CCD_IO.hmiCuterPhoto:=TRUE;
		END_IF	
		iAutoAuxStep10:=30;
	30://
		IF tonAuto[17].Q THEN
			CCD_IO.hmiChamferPhoto:=FALSE;
			CCD_IO.hmiCuterPhoto:=FALSE;
			tonAuto[18].IN:=FALSE;
			iAutoAuxStep10:=40;
		END_IF
	40://
		IF (bChaNoPhoto  OR CCD_COM.iDemResult_Cha=1) AND (bCutNoPhoto OR CCD_COM.iDemResult_Cut=1) THEN
			tonAuto[18].IN:=FALSE;
			iAutoAuxStep10:=50;
		ELSIF (NOT bChaNoPhoto  AND CCD_COM.iDemResult_Cha=2) OR (NOT bCutNoPhoto AND CCD_COM.iDemResult_Cut=2) THEN
			tonAuto[18].IN:=FALSE;
			iAutoAuxStep10:=999;
		ELSE
			IF NOT tonAuto[18].Q THEN
				tonAuto[18].IN:=TRUE;
			ELSE
				tonAuto[18].IN:=FALSE;
				iAutoAuxStep10:=999;
			END_IF
		END_IF
	50://
		arrAxisCtrl[AxisNo.DriverDDR].Cmd.fPositon_of_Abs:=arrAxisCtrl[AxisNo.DriverDDR].Status.fActPos+FC_LengthToAngle(CCD_COM.fDemLength,PolePar.Machine.fMQDriverDiameter);
		arrAxisPar[AxisNo.DriverDDR].fVelocity_of_Abs:=5;
		arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveAbs:=TRUE;
		iAutoAuxStep10:=60;
	60://
		IF arrAxisCtrl[AxisNo.DriverDDR].Status.Moving THEN
			CCD_COM.iDemCount:=2;
			iAutoAuxStep10:=70;
		END_IF
	70://
		IF NOT arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveAbs AND arrAxisCtrl[AxisNo.DriverDDR].Status.NoMoving THEN
			iAutoAuxStep10:=80;
		END_IF
	80://
		IF NOT bChaNoPhoto THEN
			CCD_COM.iDemResult_Cha:=0;
			CCD_IO.hmiChamferPhoto:=TRUE;
		END_IF
		IF NOT bCutNoPhoto THEN
			CCD_COM.iDemResult_Cut:=0;
			CCD_IO.hmiCuterPhoto:=TRUE;
		END_IF	
		iAutoAuxStep10:=90;		
	90://
		IF tonAuto[17].Q THEN
			CCD_IO.hmiChamferPhoto:=FALSE;
			CCD_IO.hmiCuterPhoto:=FALSE;
			tonAuto[18].IN:=FALSE;
			iAutoAuxStep10:=100;
			arrAxisCtrl[AxisNo.DriverDDR].Cmd.fPositon_of_Abs:=arrAxisCtrl[AxisNo.DriverDDR].Status.fActPos-FC_LengthToAngle(CCD_COM.fDemLength,PolePar.Machine.fMQDriverDiameter);
			arrAxisPar[AxisNo.DriverDDR].fVelocity_of_Abs:=20;
			arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveAbs:=TRUE;			
		END_IF	
	100://
		IF (bChaNoPhoto  OR CCD_COM.iDemResult_Cha=1) AND (bCutNoPhoto OR CCD_COM.iDemResult_Cut=1) THEN
			tonAuto[18].IN:=FALSE;
			iAutoAuxStep10:=666;
		ELSIF (NOT bChaNoPhoto  AND CCD_COM.iDemResult_Cha=2) OR (NOT bCutNoPhoto AND CCD_COM.iDemResult_Cut=2) THEN
			tonAuto[18].IN:=FALSE;
			iAutoAuxStep10:=999;
		ELSE
			IF NOT tonAuto[18].Q THEN
				tonAuto[18].IN:=TRUE;
			ELSE
				tonAuto[18].IN:=FALSE;
				iAutoAuxStep10:=999;
			END_IF
		END_IF	
	666://
		CCD_COM.iDemCount:=999;
		IF NOT bChaNoPhoto THEN
			CCD_IO.bCalibrationsDone_Cha:=TRUE;
		END_IF
		IF NOT bCutNoPhoto THEN
			CCD_IO.bCalibrationsDone_Cut:=TRUE;
		END_IF
		CCD_IO.bDemRuning:=FALSE;
		IF NOT arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveAbs AND arrAxisCtrl[AxisNo.DriverDDR].Status.NoMoving THEN	
			iAutoAuxStep10:=0;
		END_IF
	999://
		CCD_COM.iDemCount:=999;
		IF NOT bChaNoPhoto THEN
			CCD_IO.bCalibrationsFals_Cha:=TRUE;
		END_IF
		IF NOT bCutNoPhoto THEN
			CCD_IO.bCalibrationsFals_Cut:=TRUE;
		END_IF
		CCD_IO.bDemRuning:=FALSE;	
		IF NOT arrAxisCtrl[AxisNo.DriverDDR].Cmd.bMoveAbs AND arrAxisCtrl[AxisNo.DriverDDR].Status.NoMoving THEN	
			iAutoAuxStep10:=0;
		END_IF
	END_CASE
ELSE
	CCD_COM.iDemCount:=999;
	CCD_IO.bDemRuning:=FALSE;
	iAutoAuxStep10:=0;		
END_IF


	(*
////////////////////////////////////////////////////////////////线扫拍照触发////////////////////////////////////////////////////////////////
ttLinePhoto(CLK:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=2  
						AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<=6 
						AND  arrAxisCtrl[VirAxisNo.VirMain].Status.Moving 
						AND  stDriverCam.bInSync         , Q=> );
IF ttLinePhoto.Q THEN
	IF NOT ProductPar.iModeEN.bCcdTcpEN   THEN//线扫OK信号  //AND NOT ProductPar.iModeEN.bLineScanCCDEN
			IF BeltData[BeltNo.LineScanUp].iJumpCutNG=1 AND BeltData[BeltNo.LineScanUp+1].iJumpCutNG=1 AND BeltData[BeltNo.LineScanUp].fPoleNGSizeNo=30 THEN
				CCD_IO.hmiXSPhotoUp:=TRUE;//自动线扫启动
				CCD_COM.Scan.stPoleNoUp:=BeltData[BeltNo.LineScanUp].stPoleNo;			
			END_IF
			IF BeltData[BeltNo.LineScanDown].iJumpCutNG=1 AND BeltData[BeltNo.LineScanDown+1].iJumpCutNG=1 AND BeltData[BeltNo.LineScanDown].fPoleNGSizeNo=30 THEN
				CCD_IO.hmiXSPhotoDown:=TRUE;//自动线扫启动
				CCD_COM.Scan.stPoleNoDown:=BeltData[BeltNo.LineScanDown].stPoleNo;		
			END_IF		
			fRecordLineineScanCCDInMainPos:=arrAxisCtrl[VirAxisNo.VirMain].Status.fActPos;																								
			fRecordLineineScanCCDInMainPosMod:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos;	
	END_IF	
END_IF	
	*)


	
	
	
	
	(*


CASE iAutoAuxStep2 OF
100://
	IF NOT ProductPar.iModeEN.bEmptyRunEN THEN
		bMethodTenBufferEnable:=TRUE;
		iAutoAuxStep2:=200;
	ELSE
		bMethodTenBufferDisEnable:=TRUE;
		iAutoAuxStep2:=300;
	END_IF	
200://
	IF NOT bMethodTenBufferEnable THEN
		iAutoAuxStep2:=666;
	END_IF
300://
	IF NOT bMethodTenBufferDisEnable THEN
		iAutoAuxStep2:=350;
	END_IF
350://	
	arrCyCtrl[CYNo.DriverPressDDR].Cmd.bOFF:=TRUE;
	IF arrCyCtrl[CYNo.DriverPressDDR].Status.OFFState THEN
		iAutoAuxStep2:=666;
	END_IF
END_CASE
	
	*)
	
	
	
	
	
	
	
	
	







]]></ST>
      </Implementation>
    </Action>
    <Action Name="F0512CarryAuto" Id="{67df423c-8635-4b02-afc7-784b57f3064b}" FolderPath="F05Auto\">
      <Implementation>
        <ST><![CDATA[////////////////////////////////////////////////////////////////送片模式选择////////////////////////////////////////////////////////////////
IF ProductPar.iModeEN.bP2PartEN THEN
	iPoleCarryEver:=3;
ELSE
	iPoleCarryEver:=ProductPar.iModeEN.iCarryPoleMode;
END_IF
////////////////////////////////////////////////////////////////料况转化////////////////////////////////////////////////////////////////
bBelt_1[1]:=BeltData[BeltNo.SubBelt1].bHavePole;
bBelt_2[1]:=BeltData[BeltNo.SubBelt1-1].bHavePole;
bBelt_1[2]:=BeltData[BeltNo.SubBelt2].bHavePole;
bBelt_2[2]:=BeltData[BeltNo.SubBelt2-1].bHavePole;
bBelt_1[3]:=BeltData[BeltNo.SubBelt3].bHavePole;
bBelt_2[3]:=BeltData[BeltNo.SubBelt3-1].bHavePole;
////////////////////////////////////////////////////////////////送片皮带要料逻辑(皮带耦合,无料统计)    纯靠料况////////////////////////////////////////////////////////////////

bBelt_NO1:=bBelt_2[1] AND NOT bBelt_1[1] AND (   (bBelt_1[2] AND bBelt_1[3])  ) ;
bBelt_NO2:=bBelt_2[2] AND NOT bBelt_1[2] AND (  (bBelt_1[1] AND  bBelt_1[3])   ) ; 
bBelt_NO3:= ( bBelt_2[3] AND NOT bBelt_1[3] AND (   (bBelt_1[1] AND bBelt_1[2])  )  ) OR
			( bBelt_2[3] AND bBelt_1[3] AND (BeltData[BeltNo.SubBelt3].stPoleNo=''AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bSizeCCDEN)
			AND (   (bBelt_1[1] AND bBelt_1[2]) ) ) ;


IF iPoleCarryEver=3 THEN
	bBelt3Need:=NOT BeltData[BeltNo.SubBelt3].bHavePole OR (BeltData[BeltNo.SubBelt3].bHavePole AND (BeltData[BeltNo.SubBelt3].stPoleNo=''AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bSizeCCDEN) ) OR ProductPar.iModeEN.bP2PartEN;					
	bBelt2Need:=NOT BeltData[BeltNo.SubBelt2].bHavePole OR	 bBelt3Need;	
	
	IF bBelt_1[1] AND bBelt_1[2] AND (bBelt_1[3] AND (BeltData[BeltNo.SubBelt3].stPoleNo<>'' OR ProductPar.iModeEN.bCcdTcpEN OR ProductPar.iModeEN.bSizeCCDEN)) AND NOT ProductPar.iModeEN.bP2PartEN THEN
		iPoleNoHaveA:=0;
	ELSIF (bBelt_NO1 OR bBelt_NO2  OR bBelt_NO3 ) AND NOT ProductPar.iModeEN.bP2PartEN THEN
		iPoleNoHaveA:=1;
	ELSE
		iPoleNoHaveA:=2;	
	END_IF
ELSIF iPoleCarryEver=2 THEN
	bBelt3Need:=FALSE;
	bBelt2Need:=NOT BeltData[BeltNo.SubBelt2].bHavePole OR	 bBelt3Need;
	
	IF bBelt_1[1] AND bBelt_1[2]  AND NOT ProductPar.iModeEN.bP2PartEN   THEN
		iPoleNoHaveA:=0;
	ELSIF(
             (  bBelt_2[1] AND NOT bBelt_1[1] AND (  bBelt_1[2]  )   ) OR
			 (  bBelt_2[2] AND NOT bBelt_1[2] AND (  bBelt_1[1]  )   )
            )  AND NOT ProductPar.iModeEN.bP2PartEN  THEN
		iPoleNoHaveA:=1;
	ELSE
		iPoleNoHaveA:=2;	
	END_IF	
ELSE
	bBelt3Need:=FALSE;
	bBelt2Need:=FALSE OR	bBelt3Need;
	IF bBelt_1[1]  AND NOT ProductPar.iModeEN.bP2PartEN   THEN
		iPoleNoHaveA:=0;
	ELSIF ( bBelt_2[1] AND NOT bBelt_1[1] )  AND NOT ProductPar.iModeEN.bP2PartEN       THEN
		iPoleNoHaveA:=1;
	ELSE
		iPoleNoHaveA:=2;	
	END_IF							
END_IF

//取料位置有无片信号清理
IF rMQUse[11].Q THEN//叠台1
	BeltData[BeltNo.SubBelt1].bHavePole:=FALSE ;	
END_IF
IF rMQUse[12].Q THEN//叠台2
	BeltData[BeltNo.SubBelt2].bHavePole:=FALSE ;	
END_IF
IF rMQUse[13].Q THEN//叠台3
	BeltData[BeltNo.SubBelt3].bHavePole:=FALSE ;	
END_IF

(*****************减少取片等待时间*****************)
CASE iAutoAuxStep9 OF	
	100:
		tMQUse[1](IN:=FALSE , PT:=T#5S , Q=> , ET=> );
		IF iPartSelect=2 THEN
			iAutoAuxStep9:=200;//负极
		ELSE
			iAutoAuxStep9:=200;//300;//正极 20240509 CF
		END_IF
	200://负极不判断叠片主轴位置
		tMQUse[1](IN:=TRUE , PT:=T#5S , Q=> , ET=> );
		IF (InterPart.M1LockReady OR InterPart.M1JumpReady) AND (InterPart.M2LockReady OR InterPart.M2JumpReady) AND
			(InterPart.M3LockReady OR InterPart.M3JumpReady) THEN//OR tMQUse[1].Q 
			iAutoAuxStep9:=400;
		END_IF
	300://正极判断叠片主轴位置
		tMQUse[1](IN:=TRUE , PT:=T#5S , Q=> , ET=> );
		IF InterPart.M1LockReady AND InterPart.M2LockReady AND InterPart.M3LockReady THEN
			IF ABS(D_Sys.fM1MainSetPos-D_Sys.fM2MainSetPos)<1 AND ABS(D_Sys.fM1MainSetPos-D_Sys.fM3MainSetPos)<1
				AND ABS(D_Sys.fM2MainSetPos-D_Sys.fM3MainSetPos)<1 THEN
				iAutoAuxStep9:=400;//三个叠台同步
			END_IF
		ELSIF InterPart.M1LockReady AND InterPart.M2LockReady AND InterPart.M3JumpReady THEN
			IF ABS(D_Sys.fM1MainSetPos-D_Sys.fM2MainSetPos)<1 THEN
				iAutoAuxStep9:=400;// 1、2叠台同步
			END_IF
		ELSIF InterPart.M1LockReady AND InterPart.M2JumpReady AND InterPart.M3LockReady THEN
			IF ABS(D_Sys.fM1MainSetPos-D_Sys.fM3MainSetPos)<1 THEN
				iAutoAuxStep9:=400;//1、3叠台同步
			END_IF
		ELSIF InterPart.M1JumpReady AND InterPart.M2LockReady AND InterPart.M3LockReady THEN
			IF ABS(D_Sys.fM2MainSetPos-D_Sys.fM3MainSetPos)<1 THEN
				iAutoAuxStep9:=400;//2、3叠台同步
			END_IF
		ELSIF (InterPart.M1LockReady AND InterPart.M2JumpReady AND InterPart.M3JumpReady) 
				OR (InterPart.M1JumpReady AND InterPart.M2LockReady AND InterPart.M3JumpReady)
				OR (InterPart.M1JumpReady AND InterPart.M2JumpReady AND InterPart.M3LockReady) OR tMQUse[1].Q THEN
				iAutoAuxStep9:=400;//单个叠台
		END_IF
	400://允许取片信号   
		arrModPos[K10]:='';
		IF 	InterPart.M1LockReady AND (BeltData[BeltNo.SubBelt1].stPoleNo<>'' OR ProductPar.iModeEN.bCcdTcpEN OR ProductPar.iModeEN.bSizeCCDEN)  AND NOT bBelt1Taking THEN
			arrModPos[K10]:= CONCAT( arrModPos[K10], CONCAT( '     1#: ',REAL_TO_STRING(D_Sys.fM1MainSetPos)));	
			bMA10:=TRUE;
			iAutoAuxStep6:=10;
		END_IF
		IF 	InterPart.M2LockReady AND (BeltData[BeltNo.SubBelt2].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN OR ProductPar.iModeEN.bSizeCCDEN) AND NOT bBelt2Taking THEN
			arrModPos[K10]:= CONCAT( arrModPos[K10], CONCAT( '     2#: ',REAL_TO_STRING(D_Sys.fM2MainSetPos)));	
			bMA10:=TRUE;
			iAutoAuxStep7:=10;
		END_IF	
		IF 	InterPart.M3LockReady AND (BeltData[BeltNo.SubBelt3].stPoleNo<>''OR ProductPar.iModeEN.bCcdTcpEN OR ProductPar.iModeEN.bSizeCCDEN) AND NOT bBelt3Taking THEN
			arrModPos[K10]:= CONCAT( arrModPos[K10], CONCAT( '     3#: ',REAL_TO_STRING(D_Sys.fM3MainSetPos)));	
			bMA10:=TRUE;
			iAutoAuxStep8:=10;
		END_IF
		
		IF bMA10 THEN
			K10:=K10+1;
			IF K10>500 THEN
				K10:=1;
				MEMSET(ADR(arrModPos),0,SIZEOF(arrModPos));			
			END_IF
		   bMA10:=FALSE;
		END_IF
		
		iAutoAuxStep9:=666;	
END_CASE


///////////////////////////////////////////////////////////允许1叠台取料信号复位///////////////////////////////////////////////////////////////////20221101BYSJ
rtBelt1TakingReset1(CLK:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=10  AND   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<=20  AND 
                                      arrAxisCtrl[VirAxisNo.VirMain].Status.fSetVelo>=0.5          AND    bSubBelt1fratio      , Q=> );
rtBelt1TakingReset2(CLK:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=10  AND   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<=20  AND 
                                      arrAxisCtrl[VirAxisNo.VirMain].Status.fSetVelo>=0.5          AND    bSubBelt2fratio      , Q=> );									  
rtBelt1TakingReset3(CLK:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=10  AND   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<=20  AND 
                                      arrAxisCtrl[VirAxisNo.VirMain].Status.fSetVelo>=0.5          AND    bSubBelt3fratio      , Q=> );								  									  
IF  rtBelt1TakingReset1.Q THEN
	  InterPart.M1Allow:=FALSE;
      iAutoAuxStep6:=886;
END_IF	  
IF  rtBelt1TakingReset2.Q THEN
	  InterPart.M2Allow:=FALSE;
      iAutoAuxStep7:=886;
END_IF	  	  
IF  rtBelt1TakingReset3.Q THEN
	  InterPart.M3Allow:=FALSE;
      iAutoAuxStep8:=886;
END_IF	  



///////////////////////////////////////////////////////////允许1号叠台取料///////////////////////////////////////////////////////////////////
bBelt1Taking:=InterPart.M1Safety;
//DelayM1(IN:= , PT:=T#15MS , Q=> , ET=> );
IF rtAuto[7].Q THEN
	iAutoAuxStep6:=887;
	InterPart.M1Allow:=FALSE;
	//IF NOT InterPart.M1JumpReady THEN
		//BeltData[BeltNo.SubBelt1].bHavePole:=FALSE;
	//END_IF
END_IF

CASE iAutoAuxStep6 OF
10://
	IF NOT ProductPar.iModeEN.bP2PartEN AND NOT ProductPar.iModeEN.bEmptyRunEN  THEN
		InterPart.M1Allow:=TRUE;
	    iAutoAuxStep6:=20;
	ELSE
		 InterPart.M1Allow:=FALSE;
		  iAutoAuxStep6:=999;
	END_IF

20://   等待取片中信号
	IF bBelt1Taking THEN
		iAutoAuxStep6:=35;
	ELSIF (stSysState.iMode=3 OR NOT P2Interaction.P2M1Enable)AND NOT bBelt1Taking  THEN
		InterPart.M1Allow:=FALSE;
		iAutoAuxStep6:=888;
	END_IF
		
35: 
	IF     (  InterPart.M1Done OR  NOT  bBelt1Taking ) THEN//arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving AND
		InterPart.M1Allow:=FALSE;
		//IF NOT InterPart.M1JumpReady THEN
		//BeltData[BeltNo.SubBelt1].bHavePole:=FALSE ;
		//END_IF
		iAutoAuxStep6:=888;
	END_IF
END_CASE

(*
IF stSysState.iMode=3 AND bBelt1Taking  THEN
	InterPart.M1Allow:=FALSE;
	iAutoAuxStep6:=888;
END_IF
*)

BeltData[BeltNo.SubBelt1].bHavePole;
BeltData[BeltNo.SubBelt1-1].bHavePole;
BeltData[BeltNo.SubBelt1-2].bHavePole;



///////////////////////////////////////////////////////////允许2号叠台取料///////////////////////////////////////////////////////////////////

bBelt2Taking:=InterPart.M2Safety;
IF rtAuto[8].Q THEN
   	iAutoAuxStep7:=887;
	InterPart.M2Allow:=FALSE;
	//IF NOT InterPart.M2JumpReady THEN
 	//BeltData[BeltNo.SubBelt2].bHavePole:=FALSE;
	//END_IF
END_IF

CASE iAutoAuxStep7 OF
10://
	IF NOT ProductPar.iModeEN.bP2PartEN AND NOT ProductPar.iModeEN.bEmptyRunEN  THEN
		InterPart.M2Allow:=TRUE;
	    	iAutoAuxStep7:=20;
	ELSE
		 InterPart.M2Allow:=FALSE;
		  iAutoAuxStep7:=999;
	END_IF

20:////   等待取片中信号	
	IF bBelt2Taking THEN
		iAutoAuxStep7:=35;
	ELSIF (stSysState.iMode=3 OR NOT P2Interaction.P2M2Enable) AND NOT bBelt2Taking THEN
		InterPart.M2Allow:=FALSE;
		iAutoAuxStep7:=888;
	END_IF
	
35: 
	IF     (  InterPart.M2Done OR  NOT  bBelt2Taking ) THEN //arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving AND
		InterPart.M2Allow:=FALSE;
		//IF NOT InterPart.M2JumpReady THEN
		//BeltData[BeltNo.SubBelt2].bHavePole:=FALSE ;
		//END_IF
		iAutoAuxStep7:=888;
	END_IF
	 
END_CASE
(*
IF stSysState.iMode=3 AND bBelt2Taking AND InterPart.M2Safety THEN
	InterPart.M2Allow:=FALSE;
	iAutoAuxStep7:=888;
END_IF
*)


///////////////////////////////////////////////////////////允许3号叠台取料///////////////////////////////////////////////////////////////////
bBelt3Taking:=InterPart.M3Safety;
IF rtAuto[9].Q THEN
 	iAutoAuxStep8:=887;
	InterPart.M3Allow:=FALSE;
	//IF NOT InterPart.M3JumpReady THEN
	//BeltData[BeltNo.SubBelt3].bHavePole:=FALSE;
	//END_IF
END_IF


CASE iAutoAuxStep8 OF
10://
	IF NOT ProductPar.iModeEN.bP2PartEN AND NOT ProductPar.iModeEN.bEmptyRunEN  THEN
		InterPart.M3Allow:=TRUE;
	    iAutoAuxStep8:=20;
	ELSE
		 InterPart.M3Allow:=FALSE;
		  iAutoAuxStep8:=999;
	END_IF

20:////   等待取片中信号	
	IF bBelt3Taking THEN
		iAutoAuxStep8:=35;
	ELSIF (stSysState.iMode=3 OR NOT P2Interaction.P2M3Enable) AND NOT bBelt3Taking THEN
		InterPart.M3Allow:=FALSE;
		iAutoAuxStep8:=888;
	END_IF

35: 
	IF     (  InterPart.M3Done OR  NOT  bBelt3Taking ) THEN//arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving AND
		InterPart.M3Allow:=FALSE;
		//IF NOT InterPart.M3JumpReady THEN
		//BeltData[BeltNo.SubBelt3].bHavePole:=FALSE ;
		//END_IF
		iAutoAuxStep8:=888;
	END_IF
			
END_CASE
(*
IF stSysState.iMode=3 AND bBelt3Taking AND InterPart.M3Safety THEN
	InterPart.M3Allow:=FALSE;
	//bBelt3Taking:=FALSE;
	iAutoAuxStep8:=888;
END_IF
*)




]]></ST>
      </Implementation>
    </Action>
    <Action Name="F0599AutoAux" Id="{fd0c7923-717c-41e5-9f37-2adcbf7f5731}" FolderPath="F05Auto\">
      <Implementation>
        <ST><![CDATA[(*自动辅助*)
////////////////////////////////////微分&延时////////////////////////////////////
rtAuto[1](CLK:=SysPart.bAutoTen , Q=> );//自动触发
rtAuto[2](CLK:=stSysState.iMode=3 , Q=> );//手动
//rtAuto[3](CLK:=stSenser.biFlgBlue , Q=> );//蓝胶检测
//rtAuto[4](CLK:=CCD_COM.Scan.bLineScanNG , Q=> );//上线扫NG
//rtAuto[5](CLK:=CCD_COM.Scan.bLineScanNG , Q=> );//下线扫NG
rtAuto[6](CLK:=arrAxisCtrl[AxisNo.DriverDDR].Status.Moving , Q=> );//
rtAuto[7](CLK:=InterPart.M1Done , Q=> );//一号叠台取片完成
rtAuto[8](CLK:=InterPart.M2Done , Q=> );//二叠台取片完成
rtAuto[9](CLK:=InterPart.M3Done , Q=> );//三叠台取片完成



tonAuto[1](PT:=T#15S);//等待气缸动作/料盒顶升动作的时间
tonAuto[2](In:=stSenser.biSubBelt1Have,PT:=T#4MS);//皮带1倒数第二个工位有料延时
tonAuto[3](In:=NOT stSenser.biSubBelt1Have,PT:=T#4MS);//皮带1倒数第二个工位无料延时
tonAuto[4](In:=stSenser.biSubBelt2Have,PT:=T#4MS);//皮带2倒数第二个工位有料延时
tonAuto[5](In:=NOT stSenser.biSubBelt2Have,PT:=T#4MS);//皮带2倒数第二个工位无料延时
tonAuto[6](In:=stSenser.biSubBelt3Have,PT:=T#4MS);//皮带3倒数第二个工位有料延时
tonAuto[7](In:=NOT stSenser.biSubBelt3Have,PT:=T#4MS);//皮带3倒数第二个工位无料延时
tonAuto[8](In:=iAutoRunStep=2010,PT:=T#5MS);//主流程自动步序延时
//tonAuto[9](In:=arrCyCtrl[CYNo.NGBoxLock1].Cmd.bON OR arrCyCtrl[CYNo.NGBoxLock2].Cmd.bON,PT:=T#100MS);//NG归整气缸延时
tonAuto[10](In:=CCD_IO.boSizePhoto,PT:=T#50MS);//CCD拍照延时
tonAuto[11](In:=CCD_IO.boChamferPhoto,PT:=T#50MS);//CCD拍照延时
tonAuto[12](In:=CCD_IO.boCuterPhoto,PT:=T#50MS);//CCD拍照延时
//tonAuto[13](In:=iAutoAuxStep9=30,PT:=T#50MS);//NG料盒流程自动步序延时
//tonAuto[14](In:=iAutoAuxStep9=50,PT:=T#50MS);//NG料盒流程自动步序延时
//tonAuto[15](In:=stBtn.NGBoxStart AND SetpMotor.biBoxSensor ,PT:=T#500MS);//NG料盒满料后确认继续延时
//tonAuto[16](In:=NOT SetpMotor.biBoxSensor ,PT:=T#500MS);//NG料盒未到位延时
tonAuto[17](In:=iAutoAuxStep10=30 OR iAutoAuxStep10=90,PT:=T#50MS);//CCD标定流程步序延时
tonAuto[18](PT:=T#5S);//CCD标定流程延时
tonAuto[19](PT:=T#5S);//开机首次拍照延时
tonAuto[20](In:=CCD_IO.boXSPhoto,PT:=T#50MS);//皮带3倒数第二个工位无料延时
tonAuto[21](In:=iAutoRunStep=600,PT:=T#600MS);//皮带3倒数第二个工位无料延时
tonAuto[22](In:=,PT:=INT_TO_TIME(ProductPar.iModeEN.iNGcyCout)*60000);//单位时间内NG报警时间设定MIN
tonAuto[23](In:=stSenser.NGBoxFull,PT:=T#5S);//NG料盒满料报警
tonAuto[24](In:=bAnLaser,PT:=T#10S);
tonAuto[25](In:=bCaLaser,PT:=T#10S);
tonAuto[26](In:=bYellowPosTemp3,PT:=T#100MS);//黄标提示复位
tonAuto[27](In:=bYellowPosTemp4,PT:=T#100MS);//接带提示复位
tonAuto[28](In:=NOT YL_I[18],PT:=T#5S);//分段皮带3料盒满料报警
tonAuto[29](In:=NOT YL_I[19],PT:=T#5S);//分段皮带3料盒满料报警
tonAuto[30](In:=bYellowPosTemp6,PT:=T#100MS);//接带提示复位
tonAuto[31](In:=stSenser.NGboxsensor,PT:=T#2S);///NG踢废堵料报警
//上升沿
rMQUse[1](CLK:=stSenser.bYellowCheck_R1 , Q=> );//倒角前接带检测感应器	上	
rMQUse[2](CLK:=stSenser.bYellowCheck_R2  , Q=> );//倒角前接带检测感应器下
rMQUse[3](CLK:=stSenser.biFlgBlue, Q=> );//--R角前放卷蓝胶检测		
rMQUse[4](CLK:= arrAxisCtrl[VirAxisNo.VirMain].Status.Moving);//主轴启动上升沿
rMQUse[5](CLK:=iAutoRunStep=3000);//主程序步判断
rMQUse[6](CLK:=PolePar.bDemarcateBtn);//初始卷径标定触发上升沿
rMQUse[7](CLK:=arrCyCtrl[CyNo.Inflation_L].Io.DOStatus1);//左放卷气涨轴
rMQUse[8](CLK:=arrCyCtrl[CyNo.Inflation_R].Io.DOStatus1);//左放卷气涨轴
rMQUse[9](CLK:=stUwindTen.bError);//张力报警
rMQUse[10](CLK:=stSysState.iMode=1);//自动
rMQUse[11](CLK:=InterPart.M1PoleHave);//收到信号上升沿清叠台1取料位置有物料信号
rMQUse[12](CLK:=InterPart.M2PoleHave);//收到信号上升沿清叠台2取料位置有物料信号
rMQUse[13](CLK:=InterPart.M3PoleHave);//收到信号上升沿清叠台3取料位置有物料信号
rMQUse[14](CLK:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=150);////PLC_To_PC上位机的发送数据标志
rMQUse[15];
//下降沿
fMQUse[1](CLK:=stSenser.bYellowCheck_R1 , Q=> );//黄标检测---R角前
fMQUse[2](CLK:=stSenser.bYellowCheck_R2  , Q=> );//黄标检测---R角前
fMQUse[3](CLK:=stSenser.biFlgBlue, Q=> );//接带检测----R角前
fMQUse[4](CLK:= arrAxisCtrl[AxisNo.DriverDDR].Status.Moving);//DDR启动下降沿
fMQUse[5](CLK:= arrAxisCtrl[VirAxisNo.VirMain].Status.Moving);//主轴启动下降沿
fMQUse[7](CLK:=arrCyCtrl[CyNo.Inflation_L].Io.DOStatus1);//左放卷气涨轴
fMQUse[8](CLK:=arrCyCtrl[CyNo.Inflation_R].Io.DOStatus1);//左放卷气涨轴
 
IF stSysState.iMode=1 THEN
	Q107[11]:=FALSE;
	Q207[11]:=FALSE;
END_IF
//--CountClear
	IF iStopCount2>=30000 THEN
		iStopCount2 :=0;
	END_IF
	IF iOverCycleCount1>=30000 THEN
		iOverCycleCount1 :=0;
	END_IF
	IF iOverCycleCount2>=30000 THEN
		iOverCycleCount2 :=0;
	END_IF
	IF iOverCycleCount3>=30000 THEN
		iOverCycleCount3 :=0;
	END_IF
	IF iStopCount3>=30000 THEN
		iStopCount3 :=0;
	END_IF
	IF iStopCount>=30000 THEN
		iStopCount :=0;
	END_IF
	IF iPeaceAlarmCount1>=30000 THEN
		iPeaceAlarmCount1 :=0;
	END_IF
	IF iPeaceAlarmCount2>=30000 THEN
		iPeaceAlarmCount2 :=0;
	END_IF
	IF iPeaceAlarmCount3>=30000 THEN
		iPeaceAlarmCount3 :=0;
	END_IF
	
	
///主驱当前位置(转化为mm)
//fDriverDDRActPos:=FC_AngleToLength(arrAxisCtrl[AxisNo.DriverDDR].Status.fActPos,PolePar.Machine.fMQDriverDiameter);
fDriverDDRActPos:=(PI*PolePar.Machine.fMQDriverDiameter*arrAxisCtrl[AxisNo.DriverDDR].Status.fActPos)/360;

//PPM转化为M/min(转化)
PolePar.fMainHmiVel:=PolePar.iMainVel*PolePar.fPoleWidth/1000;
IF tonAuto[10].Q THEN
	CCD_IO.boSizePhoto:=FALSE;
END_IF
IF tonAuto[11].Q THEN
	CCD_IO.boChamferPhoto:=FALSE;
END_IF
IF tonAuto[12].Q THEN
	CCD_IO.boCuterPhoto:=FALSE;
END_IF
 IF tonAuto[20].Q THEN
	CCD_IO.boXSPhoto:=FALSE;
END_IF

////////////////////////////////////停止////////////////////////////////////
IF stSysState.Stoping AND SysPart.bAutoTen AND arrAxisCtrl[VirAxisNo.VirMain].Status.NoMoving AND 
	(iAutoRunStep>0 AND iAutoRunStep<600 OR iAutoRunStep>700 ) THEN
	iAutoRunStep:=600;
END_IF 

(*
//黄标检测,接带检测主驱位置记录
IF (rMQUse[1].Q OR rMQUse[2].Q )AND arrAxisCtrl[AxisNo.DriverDDR].Status.Moving THEN
	aYellowPos[1]:=fDriverDDRActPos;	
	FOR i4:=30 TO 2 BY -1 DO
		aYellowPos[i4]:=aYellowPos[i4-1];
	END_FOR	
END_IF
*)

//黄标检测,接带检测主驱位置记录
IF rMQUse[3].Q AND arrAxisCtrl[AxisNo.DriverDDR].Status.Moving AND NOT bYellowPosTemp1   THEN
    aYellowPosTemp1:=fDriverDDRActPos;
	aYellowPos[1]:=fDriverDDRActPos;	
	FOR i4:=30 TO 2 BY -1 DO
		aYellowPos[i4]:=aYellowPos[i4-1];
	END_FOR	
	bYellowPosTemp1:=TRUE;
	bYellowPosTemp3:=TRUE;
	Production.NGFlag[45]:=TRUE;//黄标计数
END_IF

IF ABS(fDriverDDRActPos-aYellowPosTemp1)>=12 THEN
	bYellowPosTemp1:=FALSE;
	Production.NGFlag[45]:=FALSE;//黄标计数
END_IF

IF tonAuto[26].Q THEN
	bYellowPosTemp3:=FALSE;
END_IF
(*
IF rMQUse[3].Q AND arrAxisCtrl[AxisNo.DriverDDR].Status.Moving THEN
	aTapePos[1]:=fDriverDDRActPos;	
	FOR i4:=30 TO 2 BY -1 DO
		aTapePos[i4]:=aTapePos[i4-1];
	END_FOR		
END_IF*)


//上	接带检测
IF rMQUse[1].Q AND arrAxisCtrl[AxisNo.DriverDDR].Status.Moving AND NOT bYellowPosTemp2 THEN
	aYellowPosTemp2:=fDriverDDRActPos;	
	aTapePos[1]:=fDriverDDRActPos;	
	FOR i4:=30 TO 2 BY -1 DO
		aTapePos[i4]:=aTapePos[i4-1];
	END_FOR		
	bYellowPosTemp2:=TRUE;
	bYellowPosTemp4:=TRUE;
	Production.NGFlag[43]:=TRUE;//接带计数
END_IF

IF ABS(fDriverDDRActPos-aYellowPosTemp2)>=20 THEN
	bYellowPosTemp2:=FALSE;
	Production.NGFlag[43]:=FALSE;//接带计数
END_IF

IF tonAuto[27].Q THEN
	bYellowPosTemp4:=FALSE;
END_IF

PolePar.fTape1_2:=555;
//下接带检测
IF rMQUse[2].Q  AND arrAxisCtrl[AxisNo.DriverDDR].Status.Moving AND NOT bYellowPosTemp5 THEN
	aYellowPosTemp2:=fDriverDDRActPos;	
	IF NOT bTapeMark THEN
		aTapepos2:=fDriverDDRActPos;
	END_IF
	aTapePos[1]:=fDriverDDRActPos+PolePar.fTape1_2;	
	FOR i4:=30 TO 2 BY -1 DO
		aTapePos[i4]:=aTapePos[i4-1];
	END_FOR		
	bYellowPosTemp5:=TRUE;
	bYellowPosTemp6:=TRUE;
	bTapeMark:=TRUE;
	Production.NGFlag[43]:=TRUE;//接带计数
END_IF

IF ABS(fDriverDDRActPos-aTapepos2)>=1900 THEN
	bTapeMark:=FALSE;
END_IF

IF ABS(fDriverDDRActPos-aYellowPosTemp2)>=20 THEN
	bYellowPosTemp5:=FALSE;
	Production.NGFlag[43]:=FALSE;//接带计数
END_IF

IF tonAuto[30].Q THEN
	bYellowPosTemp6:=FALSE;
END_IF


////////////////////////////////////////////////////////////////模具上模吹气///////////////////////////////////////////////////////////////
IF  stSysState.iMode=1 THEN
	IF arrAxisCtrl[AxisNo.Mould].Status.fModuloActPos>=arrAxisPar[AxisNo.Mould].arrTargetPoint[3] AND arrAxisCtrl[AxisNo.Mould].Status.fModuloActPos<arrAxisPar[AxisNo.Mould].arrTargetPoint[4]AND arrAxisCtrl[AxisNo.Mould].Status.Moving THEN
		arrCyCtrl[EVNo.MouldUpBlow].Cmd.bON:=TRUE;
		arrCyCtrl[EVNo.MouldUpBlow].Cmd.bOFF:=FALSE;
	ELSE
		arrCyCtrl[EVNo.MouldUpBlow].Cmd.bOFF:=TRUE;
		arrCyCtrl[EVNo.MouldUpBlow].Cmd.bON:=FALSE;
	END_IF
	////////////////////////////////////////////////////////////////模具下模吹气///////////////////////////////////////////////////////////////
	IF arrAxisCtrl[AxisNo.Mould].Status.fModuloActPos>=arrAxisPar[AxisNo.Mould].arrTargetPoint[5] AND arrAxisCtrl[AxisNo.Mould].Status.fModuloActPos<arrAxisPar[AxisNo.Mould].arrTargetPoint[6]AND arrAxisCtrl[AxisNo.Mould].Status.Moving THEN
		arrCyCtrl[EVNo.RJ_Blow].Cmd.bON:=TRUE;
		arrCyCtrl[EVNo.RJ_Blow].Cmd.bOFF:=FALSE;
	ELSE
		arrCyCtrl[EVNo.RJ_Blow].Cmd.bOFF:=TRUE;
		arrCyCtrl[EVNo.RJ_Blow].Cmd.bON:=FALSE;
	END_IF
END_IF

////////////////////////////////////////////////////////////////R角风刀吹气///////////////////////////////////////////////////////////////
IF 	stSysState.iMode=1 THEN
    IF  arrAxisCtrl[VirAxisNo.VirMain].Status.Moving THEN
		arrCyCtrl[EVNo.RJDustBlow  ].Cmd.bON:=TRUE;
		arrCyCtrl[EVNo.RJDustBlow  ].Cmd.bOFF:=FALSE;
	ELSE
		arrCyCtrl[EVNo.RJDustBlow  ].Cmd.bOFF:=TRUE;
		arrCyCtrl[EVNo.RJDustBlow  ].Cmd.bON:=FALSE;
	END_IF
END_IF
	
///////////////////////////分段送料皮带除尘毛刷////////////////////////////
IF arrAxisCtrl[AxisNo.	SubBelt1].Status.Moving AND fbSubBelt1Gear.fratio1>0 THEN
	arrDustMotor[MotorNo.FeduanbeltDust1].bRun_FW :=TRUE;
ELSE
	arrDustMotor[MotorNo.FeduanbeltDust1].bRun_FW :=FALSE;
END_IF

IF arrAxisCtrl[AxisNo.	SubBelt2].Status.Moving AND fbSubBelt2Gear.fratio1>0 THEN
	arrDustMotor[MotorNo.FeduanbeltDust2].bRun_FW :=TRUE;
ELSE
	arrDustMotor[MotorNo.FeduanbeltDust2].bRun_FW:=FALSE;
END_IF

IF arrAxisCtrl[AxisNo.	SubBelt3].Status.Moving AND fbSubBelt3Gear.fratio1>0 THEN
	arrDustMotor[MotorNo.FeduanbeltDust3].bRun_FW :=TRUE;
ELSE
	arrDustMotor[MotorNo.FeduanbeltDust3].bRun_FW :=FALSE;
END_IF

////////////////////////////////////急停////////////////////////////////////
IF stSysState.btnEstop AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving THEN
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd. bHome:=FALSE;
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd. bJog_Bw:=FALSE;	
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd. bJog_Fw:=FALSE;		
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd. bMoveAbs:=FALSE;		
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd. bMoveRel:=FALSE;	
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd. bMoveVelo:=FALSE;		
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bMoveModulo:=FALSE;	
	arrAxisCtrl[AxisNo.CCDPressPush].Cmd. bSetPos:=FALSE;	 
	stCCDPressCam.bCamInExecute:=FALSE;   	
   	arrAxisCtrl[AxisNo.CCDPressPush].Cmd. iGoSetPos:=0;	  	
 	iHomestep:=0;
	iTensionStep:=0;
	iCamStep:=0;
	SysPart.Homeing:=FALSE;
	SysPart.Homed:=FALSE;	
	IF  arrAxisCtrl[AxisNo.CCDPressPush].Status.Moving  AND NOT arrAxisCtrl[AxisNo.CCDPressPush].Cmd.bStop   THEN//AND  NOT arrAxis[AxisNo.CCDPressPush] .Status.Coupled THEN   //对运动中的轴执行STOP
		arrAxisCtrl[AxisNo.CCDPressPush].Cmd. bStop:=TRUE;	
	END_IF;	
	arrAxisCtrl[AxisNo.Cuter].Cmd. bHome:=FALSE;
	arrAxisCtrl[AxisNo.Cuter].Cmd. bJog_Bw:=FALSE;	
	arrAxisCtrl[AxisNo.Cuter].Cmd. bJog_Fw:=FALSE;		
	arrAxisCtrl[AxisNo.Cuter].Cmd. bMoveAbs:=FALSE;		
	arrAxisCtrl[AxisNo.Cuter].Cmd. bMoveRel:=FALSE;	
	arrAxisCtrl[AxisNo.Cuter].Cmd. bMoveVelo:=FALSE;		
	arrAxisCtrl[AxisNo.Cuter].Cmd.bMoveModulo:=FALSE;	
	arrAxisCtrl[AxisNo.Cuter].Cmd. bSetPos:=FALSE;	    	
	arrAxisCtrl[AxisNo.Cuter].Cmd. iGoSetPos:=0;
	stCuterCam.bCamInExecute	:=FALSE;  		
	IF  arrAxisCtrl[AxisNo.Cuter].Status.Moving  AND NOT arrAxisCtrl[AxisNo.Cuter].Cmd.bStop   THEN//AND  NOT arrAxis[AxisNo.Cuter] .Status.Coupled THEN   //对运动中的轴执行STOP
	    	arrAxisCtrl[AxisNo.Cuter].Cmd. bStop:=TRUE;	
	END_IF;	
	arrAxisCtrl[AxisNo.Mould].Cmd. bHome:=FALSE;
	arrAxisCtrl[AxisNo.Mould].Cmd. bJog_Bw:=FALSE;	
	arrAxisCtrl[AxisNo.Mould].Cmd. bJog_Fw:=FALSE;		
	arrAxisCtrl[AxisNo.Mould].Cmd. bMoveAbs:=FALSE;		
	arrAxisCtrl[AxisNo.Mould].Cmd. bMoveRel:=FALSE;	
	arrAxisCtrl[AxisNo.Mould].Cmd. bMoveVelo:=FALSE;		
	arrAxisCtrl[AxisNo.Mould].Cmd.bMoveModulo:=FALSE;	
	arrAxisCtrl[AxisNo.Mould].Cmd. bSetPos:=FALSE;	    	
	arrAxisCtrl[AxisNo.Mould].Cmd. iGoSetPos:=0;	  
	stMouldCam.bCamInExecute:=FALSE;		
	IF  arrAxisCtrl[AxisNo.Mould].Status.Moving  AND NOT arrAxisCtrl[AxisNo.Mould].Cmd.bStop   THEN//AND  NOT arrAxis[AxisNo.Mould] .Status.Coupled THEN   //对运动中的轴执行STOP
	    	arrAxisCtrl[AxisNo.Mould].Cmd. bStop:=TRUE;	
	END_IF;		
	arrDustMotor[MotorNo.DDR_Dust].bRun_FW:=FALSE;																			
	arrDustMotor[MotorNo.CuterBeltDust].bRun_FW:=FALSE;																									
	arrDustMotor[MotorNo.NGReverseBeltDust].bRun_FW:=FALSE;																									
	arrDustMotor[MotorNo.DedustBeltDust].bRun_FW:=FALSE;																									
	arrDustMotor[MotorNo.DedustReverseBeltDust].bRun_FW:=FALSE;																									
	arrDustMotor[MotorNo.PoleBrushDust_U].bRun_FW:=FALSE;
	arrDustMotor[MotorNo.PoleBrushDust_D].bRun_FW:=FALSE;			
END_IF

//除尘启动  （包括皮带除尘电机）
IF NOT ProductPar.iModeEN.bDedustEN THEN
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.Moving THEN		
		arrDustMotor[MotorNo.PoleBrushDust_U].bRun_FW:=TRUE;
		arrCyCtrl[EVNo.BrushDustVacuo_U].Cmd.bON:=TRUE;		
	
		arrCyCtrl[EVNo.WindDustBlow_U].Cmd.bON:=TRUE;
		arrCyCtrl[EVNo.WindDustVacuo_U].Cmd.bON:=TRUE;
	
		arrDustMotor[MotorNo.PoleBrushDust_D].bRun_FW:=TRUE;
		arrCyCtrl[EVNo.BrushDustVacuo_D].Cmd.bON:=TRUE;		
	
		arrCyCtrl[EVNo.WindDustBlow_D].Cmd.bON:=TRUE;
		arrCyCtrl[EVNo.WindDustVacuo_D].Cmd.bON:=TRUE;	
			
		arrDustMotor[MotorNo.DDR_Dust].bRun_FW:=TRUE;
		arrDustMotor[MotorNo.CuterBeltDust].bRun_FW:=TRUE;
		arrDustMotor[MotorNo.NGReverseBeltDust].bRun_FW:=TRUE;
		arrDustMotor[MotorNo.DedustBeltDust].bRun_FW:=TRUE;
		arrDustMotor[MotorNo.DedustReverseBeltDust].bRun_FW:=TRUE;				
	END_IF
	IF fMQUse[5].Q  THEN
		arrDustMotor[MotorNo.PoleBrushDust_U].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.PoleBrushDust_D].bRun_FW:=FALSE;
		arrCyCtrl[EVNo.BrushDustVacuo_U].Cmd.bOff:=TRUE;		
		arrCyCtrl[EVNo.WindDustBlow_U].Cmd.bOff:=TRUE;
		arrCyCtrl[EVNo.WindDustVacuo_U].Cmd.bOff:=TRUE;		
		arrCyCtrl[EVNo.BrushDustVacuo_D].Cmd.bOff:=TRUE;	
		arrCyCtrl[EVNo.WindDustBlow_D].Cmd.bOff:=TRUE;
		arrCyCtrl[EVNo.WindDustVacuo_D].Cmd.bOff:=TRUE;
		
		arrDustMotor[MotorNo.DDR_Dust].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.CuterBeltDust].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.NGReverseBeltDust].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.DedustBeltDust].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.DedustReverseBeltDust].bRun_FW:=FALSE;			
	END_IF
ELSE
	IF  stSysState.iMode=1 THEN
		arrDustMotor[MotorNo.PoleBrushDust_U].bRun_FW:=FALSE;	
		arrDustMotor[MotorNo.PoleBrushDust_D].bRun_FW:=FALSE;		
		arrDustMotor[MotorNo.DDR_Dust].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.CuterBeltDust].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.NGReverseBeltDust].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.DedustBeltDust].bRun_FW:=FALSE;
		arrDustMotor[MotorNo.DedustReverseBeltDust].bRun_FW:=FALSE;			
	END_IF
END_IF

//皮带运行前，气阀类状态
	IF rMQUse[5].Q THEN
		arrCyCtrl[EVNo.AreaArrayDustBlow].Cmd.bOFF:=TRUE;
		arrCyCtrl[EVNo.ConnectDustVacuo].Cmd.bOFF:=TRUE;
		arrCyCtrl[EVNo.LineSceneDustBlow].Cmd.bOFF:=TRUE;
		arrCyCtrl[EVNo.LineSceneDustVacuo].Cmd.bOFF:=TRUE;
		arrCyCtrl[EVNo.MouldDownAir].Cmd.bOFF:=TRUE;
		arrCyCtrl[EVNo.MouldDownVacuo].Cmd.bOFF:=TRUE;
	END_IF

	
//初始卷径手动标定程序
pRollWind:=SEL(PolePar.MQ.bWindSelect,ADR(arrAxis[AxisNo.UnWind_R]),ADR(arrAxis[AxisNo.UnWind_L]));
IF rMQUse[6].Q THEN
		DemarcateStep:=100;
	END_IF
CASE DemarcateStep OF

100://判断张力是否完成
	IF  stUwindTen.bTensionOK THEN
		DemarcateStep:=400;	
	ELSE
		DemarcateStep:=0;	
	END_IF
400:
	
	DemarcateStep:=450;
450://通过缓存电机移动距离与放卷轴放卷监督计算初始卷径---缓存到负极限位
	IF  arrAxisCtrl[AxisNo.BuffeLine].Cmd.arrbRealPoint[2] THEN
		arrAxisCtrl[AxisNo.BuffeLine].Cmd.iGoSetPos:=0;
		DemarcateStep:=500;	
	ELSE
		arrAxisCtrl[AxisNo.BuffeLine].Cmd.iGoSetPos:=2;		
	END_IF
500://判断摆杆是否到平衡位置
	IF  ABS (stAuxDriverTen.fDanserDegree -PolePar.MQ.AuxDriverTenBlancePos)<=5 THEN
		PolePar.rRollStartView:=pRollWind^.NcToPlc.ActPos;
		DemarcateStep:=600;
	END_IF
600://通过缓存电机移动距离与放卷轴放卷监督计算初始卷径---缓存到正极限位
	IF  arrAxisCtrl[AxisNo.BuffeLine].Cmd.arrbRealPoint[3] THEN
		arrAxisCtrl[AxisNo.BuffeLine].Cmd.iGoSetPos:=0;
		DemarcateStep:=700;	
	ELSE
		arrAxisCtrl[AxisNo.BuffeLine].Cmd.iGoSetPos:=3;		
	END_IF
700://判断摆杆是否到平衡位置
	IF  ABS (stAuxDriverTen.fDanserDegree -PolePar.MQ.AuxDriverTenBlancePos)<=5 THEN
		PolePar.rRollFinishView:=pRollWind^.NcToPlc.ActPos;
		DemarcateStep:=800;
	END_IF
800://计算
	PolePar.rRollView:=ABS(PolePar.rRollFinishView-PolePar.rRollStartView);//放卷运动总角度  
	PolePar.rRoll_L:=2*ABS(arrAxisPar[AxisNo.BuffeLine].arrTargetPoint[2]-arrAxisPar[AxisNo.BuffeLine].arrTargetPoint[3]);//缓存极片总长度(mm)	
	DemarcateStep:=900;
900:
	PolePar.rRollDia:=(360*PolePar.rRoll_L)/(Tc2_System.PI*PolePar.rRollView);
	DemarcateStep:=0;
END_CASE
(*	
	rRoll_L:REAL:=1000;//缓存极片总长度(mm)
	rRollStartView:REAL;//放卷开始角度
        rRollFinishView:REAL;//放卷结束角度 
	rRollView :REAL;//放卷运动总角度  
	rRollDia:REAL;//初始卷径(计数输出)
	bDemarcateBtn:BOOL;//标定开始按钮
*)	
	
CASE iAutoAuxStep1 OF
100://
	bMethodCamEnable:=TRUE;
	iAutoAuxStep1:=200;
200://
	IF NOT bMethodCamEnable THEN
		iAutoAuxStep1:=666;
	END_IF
END_CASE







(*****************************************************极耳基准20240101SJ*********************************************************************)
  rtTabSenser(CLK:=stSenser.bPoleCheck_R , Q=> );
  ftTabSenser(CLK:=stSenser.bPoleCheck_R , Q=> );
  (*
  IF  rtTabSenser.Q THEN
	  iCount100:=iCount100+1;
  END_IF
   IF  ftTabSenser.Q THEN
	  iCount101:=iCount101+1;
  END_IF 
  *)
 
  PolePar.fTabWidth:=53; //标准极耳宽度
  PolePar.fDriverStanderBasePos;//主驱动标准极耳下降沿位置
  PolePar.bDriverStanderBasePosEN;//自动找极耳基准屏蔽    1.等料带正常寻基准用    2. 屏蔽后不会 调整极耳

IF bTapeMark  THEN  
CASE  iTabOffsetStep  OF
	0: 
		  IF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=2  AND   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<=10  AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  stDriverCam.bInSync   AND   
			   NOT ProductPar.iModeEN.bEmptyRunEN AND NOT ProductPar.iModeEN.bCcdTcpEN AND NOT ProductPar.iModeEN.bCuterOffsetEN AND stSysState.iMode=1     THEN
				 
			   bRecordPosM1:=FALSE;
			   bRecordPosM2:=FALSE;
			   fbReadTabCamSlavePos.Execute:=FALSE;
			   fVirMainSenserPos1:=0;
			   fVirMainSenserPos2:=0;  
			   IF K1>=50 THEN
				   K1:=1;
			   END_IF
	 
				IF  NOT   stSenser.bPoleCheck_R   THEN  
					 iTabOffsetStep:=100; // 启动前不在极耳上
				ELSE
					  iTabOffsetStep:=200; // 启动前就在极耳上
				END_IF
		   END_IF
	
	100:  //记录极耳上升沿，下降沿对应主轴位置
	   IF   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<= ProductPar.parPublic.fMainPos  THEN
				IF  rtTabSenser.Q  AND NOT bRecordPosM1  THEN
					 fVirMainSenserPos1:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos;
					 bRecordPosM1:=TRUE;
				END_IF
				IF  ftTabSenser.Q  AND NOT bRecordPosM2  THEN
					 fVirMainSenserPos2:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos;
					 bRecordPosM2:=TRUE;
				END_IF    
			  IF  bRecordPosM1 AND  bRecordPosM2 THEN
				   iTabOffsetStep:=110;
			  END_IF
	   ELSIF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>ProductPar.parPublic.fMainPos-40  AND (NOT bRecordPosM1 OR NOT  bRecordPosM2) THEN //极耳检测异常 跳转到下个周期检测
			iTabOffsetStep:=0;
	   END_IF
	
	   
	  (********************以下程序大约需要10个扫描周期刷完***************************) 
	110://读取上升沿 主驱位置
	  IF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=  ProductPar.parPublic.fMainPos-40  THEN   //避开Auto4   
	   fbReadTabCamSlavePos.MasterPosition:= fVirMainSenserPos1;
	   fbReadTabCamSlavePos.Execute:=TRUE;
	   iTabOffsetStep:=115;
	 END_IF  
	 115:
	  IF  fbReadTabCamSlavePos.Done THEN
		  fReadDriverPos1:= FC_AngleToLength(fbReadTabCamSlavePos.SlavePosition ,  PolePar.Machine.fMQDriverDiameter   )    ;
		  arrfReadDriverPos1[K1]:=fReadDriverPos1;
		  K1:=K1+1;
		  fbReadTabCamSlavePos.Execute:=FALSE;
		  iTabOffsetStep:=120;
	  ELSIF fbReadTabCamSlavePos.Error THEN //放弃此极耳检测
		  iTabOffsetStep:=0;
	  END_IF
	
	120://读取下降沿 主驱位置
	   fbReadTabCamSlavePos.MasterPosition:= fVirMainSenserPos2;
	   fbReadTabCamSlavePos.Execute:=TRUE;
	   iTabOffsetStep:=125;
	 125:
	  IF  fbReadTabCamSlavePos.Done THEN
		  fReadDriverPos2:=FC_AngleToLength( fbReadTabCamSlavePos.SlavePosition ,  PolePar.Machine.fMQDriverDiameter)  ;
		  arrfReadDriverPos2[K1]:=fReadDriverPos2;
		  fCalueTabWidth:=fReadDriverPos2-fReadDriverPos1;
		  iTabOffsetStep:=130;
	  ELSIF fbReadTabCamSlavePos.Error THEN //放弃此极耳检测
		  iTabOffsetStep:=0;
	  END_IF
	  
	  130: //判断极耳宽度是否在公差范围   如果在范围计算极耳下降沿主驱动位置与标准位置差值     
	   IF  fCalueTabWidth >=PolePar.fTabWidth-5 AND  fReadDriverPos2-fReadDriverPos1 <=PolePar.fTabWidth+5 THEN
			fTabOffset:= fReadDriverPos2- PolePar.fDriverStanderBasePos;      //如果>0 则 主驱补偿值>0才能让极耳恢复到标准值                      
		   iTabOffsetStep:=140;
	   ELSE  //极耳宽度异常
		   iTabOffsetStep:=0;
	  END_IF
	  
	  140:  //
		 IF  NOT   PolePar.bDriverStanderBasePosEN THEN
			 IF ABS(fTabOffset) >=30 THEN  //极耳严重偏离基准值
				  fDriverOffset:=            fTabOffset;  //给主驱补偿值用
				  bFlgTabPosOver:=TRUE;//  极耳严重偏移标志  给主驱补偿标志位用
				 // bFlgTabPosOver:=FALSE;//  极耳严重偏移标志  给主驱补偿标志位用
			ELSE
				  fDriverOffset:= 0;  //给主驱补偿值用
				  bFlgTabPosOver:=FALSE;//  极耳严重偏移标志  给主驱补偿标志位用	  
			 END_IF 	 
		ELSE
			 fDriverOffset:= 0;  //给主驱补偿值用
			 bFlgTabPosOver:=FALSE;//  极耳严重偏移标志
		 END_IF
		   iTabOffsetStep:=0;
			  
	200:	   
	   IF   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<= ProductPar.parPublic.fMainPos  THEN
				IF  ftTabSenser.Q  AND NOT bRecordPosM2  THEN
					 fVirMainSenserPos2:=arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos;
					 bRecordPosM2:=TRUE;
				END_IF    
			  IF    bRecordPosM2 THEN
				   iTabOffsetStep:=210;
			  END_IF
	   ELSIF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>ProductPar.parPublic.fMainPos-40   AND NOT  bRecordPosM2 THEN //极耳检测异常 跳转到下个周期检测
			iTabOffsetStep:=0;
	   END_IF  
		  
	  (********************以下程序大约需要10个扫描周期刷完***************************) 
	210://读取下降沿 主驱位置
	 IF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=ProductPar.parPublic.fMainPos-40  THEN   //避开Auto4   
	   fbReadTabCamSlavePos.MasterPosition:= fVirMainSenserPos2;
	   fbReadTabCamSlavePos.Execute:=TRUE;
	   iTabOffsetStep:=225;
	   END_IF
	 225:
	  IF  fbReadTabCamSlavePos.Done THEN
		  fReadDriverPos2:=FC_AngleToLength( fbReadTabCamSlavePos.SlavePosition ,  PolePar.Machine.fMQDriverDiameter);
		  arrfReadDriverPos2[K1]:=fReadDriverPos2;
		 // fCalueTabWidth:=fReadDriverPos2-fReadDriverPos1;
		  iTabOffsetStep:=230;
	  ELSIF fbReadTabCamSlavePos.Error THEN //放弃此极耳检测
		  iTabOffsetStep:=0;
	  END_IF
	 
	 230: //判断极耳宽度是否在公差范围   如果在范围计算极耳下降沿主驱动位置与标准位置差值     
	  // IF  fCalueTabWidth >=fTabWidth-5 AND  fReadDriverPos2-fReadDriverPos1 <=fTabWidth+5 THEN
		   fTabOffset:= fReadDriverPos2- PolePar.fDriverStanderBasePos;      //如果>0 则 主驱补偿值>0才能让极耳恢复到标准值                      
		   iTabOffsetStep:=240;
	 //  ELSE  //极耳宽度异常
		  // iTabOffsetStep:=240;
	 // END_IF
	  
	  240:  // 
		 IF  NOT   PolePar.bDriverStanderBasePosEN THEN
			 IF ABS(fTabOffset) >=30 THEN  //极耳严重偏离基准值
				  fDriverOffset:=            fTabOffset;  //给主驱补偿值用
				  bFlgTabPosOver:=TRUE;//  极耳严重偏移标志  给主驱补偿标志位用
				 // bFlgTabPosOver:=FALSE;//  极耳严重偏移标志  给主驱补偿标志位用
			ELSE
				  fDriverOffset:= 0;  //给主驱补偿值用
				  bFlgTabPosOver:=FALSE;//  极耳严重偏移标志  给主驱补偿标志位用	  
			 END_IF 	 
		ELSE
			 fDriverOffset:= 0;  //给主驱补偿值用
			 bFlgTabPosOver:=FALSE;//  极耳严重偏移标志
		 END_IF
		   iTabOffsetStep:=0;  
			   
	END_CASE
ELSE
	bFlgTabPosOver:=FALSE;
END_IF

IF    PolePar.bDriverStanderBasePosEN THEN
	  bFlgTabPosOver:=FALSE;
END_IF


fbReadTabCamSlavePos.MasterPosition;
fbReadTabCamSlavePos(
	Execute:= , 
	CamTableID:=TableNo.Dirver , 
	MasterPosition:= , 
	Done=> , 
	Busy=> , 
	Error=> , 
	ErrorID=> , 
	SlavePosition=> , 
	SlaveVelocity=> , 
	SlaveAcceleration=> );

fbReadTabCamSlavePos.Done;
fbReadTabCamSlavePos.Error;
fbReadTabCamSlavePos.SlavePosition;


PolePar.fReadDriverPos3:=fReadDriverPos2;






(*****************************************************4连黄标尾料检测  SJ*********************************************************************)

ftTabSenser2(CLK:=stSenser.bFourYellowUP , Q=> );

IF ftTabSenser2.Q AND arrAxisCtrl[VirAxisNo.VirDriver].Status.Moving AND NOT bFourYellowFlg THEN
	arrfVirMainSenserPos[1]:=FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos , (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
	bFourYellowFlg:=TRUE;
END_IF

arrfVirMainSenserPos[2]:=FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos , (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
IF arrfVirMainSenserPos[2]-arrfVirMainSenserPos[1]>=10 THEN
	bFourYellowFlg:=FALSE;
END_IF

rtTabSenser2(CLK:=bFourYellowFlg , Q=> );
ProductPar.fYellowMackLength1; //相邻黄标后边距离
  
  //ProductPar.fDriverStanderBasePos;//主驱动标准极耳下降沿位置
  //ProductPar.bDriverStanderBasePosEN;//自动找极耳基准屏蔽    1.等料带正常寻基准用    2. 屏蔽后不会 调整极耳
  
CASE  iEndYellowMackStep  OF
	0: 
		IF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=2  AND   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<=10  AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  stDriverCam.bInSync   THEN   
			iEndYellowMackStep:=100;
			nInt[2]	:=0;  
		END_IF
	
	100:  //记录极耳上升沿，下降沿对应主轴位置
		IF   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<353   THEN
			
			IF  rtTabSenser2.Q THEN
				CASE nInt[2] OF
					0:
						arrbRecordPos[1] :=TRUE;
						nInt[2]	:=1;
					1:
						arrbRecordPos[2] :=TRUE;
						nInt[2]	:=2;
					2:
						arrbRecordPos[3] :=TRUE;
						nInt[2]	:=3;	
					3:
						arrbRecordPos[4] :=TRUE;
						nInt[2]	:=4;					
				END_CASE
			END_IF
		
		ELSIF 	  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos> 353 	 AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 360 THEN  
		
			IF arrbRecordPos[1]  AND arrbRecordPos[2] AND arrbRecordPos[3]  THEN  //至少有3个连续黄标
				stAlarm.arrFlowAlarm[42]:=bYellowMackAlarm:=TRUE;
				arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
				iEndYellowMackStep:=0;
			ELSIF  arrbRecordPos[1]  AND arrbRecordPos[2] THEN    //当前周期检测出2个极耳 如果判定在设定间距则下个周期继续检
				nInt[2] :=2;
				iEndYellowMackStep:=200; //下个周期继续检测 极耳3
			ELSIF  arrbRecordPos[1]   THEN  // //当前周期检测出1个极耳  下个周期继续检黄标 2  3   4
				nInt[2] :=1;
				iEndYellowMackStep:=300; //下个周期继续检测 极耳2   3    4
			ELSE   //当前周期无黄标
				arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
				iEndYellowMackStep:=0;
			END_IF
		
		END_IF
	
	
	200:    //下个周期继续检测极耳3  4
		IF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=2  AND   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<=10  AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  stDriverCam.bInSync   THEN   
			iEndYellowMackStep:=210;   
		END_IF
		
	210:
		IF    arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 180  THEN
			
			IF  rtTabSenser2.Q THEN
				CASE nInt[2] OF
					2:
						arrfVirMainSenserPos[3]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
						arrbRecordPos[3] :=TRUE;
						nInt[2]	:=3;	
					3:
						arrfVirMainSenserPos[4]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
						arrbRecordPos[4] :=TRUE;
						nInt[2]	:=4;					
				END_CASE
			END_IF
		
		ELSIF 	  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos> 180 	 AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 190 THEN 
  			 
			IF arrbRecordPos[1]  AND arrbRecordPos[2] AND arrbRecordPos[3]  THEN  //至少有3个连续黄标
				stAlarm.arrFlowAlarm[42]:=bYellowMackAlarm:=TRUE;
				arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
				iEndYellowMackStep:=0;
			END_IF	
		
		ELSIF 	 arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos> 190 	 AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 200   THEN   		
			arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
			iEndYellowMackStep:=0;			
		END_IF
	
	300:  //下个周期继续检测 极耳2   3    4
		IF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=2  AND   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<=10  AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  stDriverCam.bInSync   THEN   
			iEndYellowMackStep:=310;   
		END_IF
	
	310:
		IF   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 180   THEN
			
			IF  rtTabSenser2.Q THEN
				CASE nInt[2] OF
					1:
						arrbRecordPos[2] :=TRUE;
						nInt[2]	:=2;
					2:
						arrbRecordPos[3] :=TRUE;
						nInt[2]	:=3;	
					3:
						arrbRecordPos[4] :=TRUE;
						nInt[2]	:=4;					
				END_CASE
			END_IF	   
		
		ELSIF 	  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos> 180 	 AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 190 THEN  
		
			IF arrbRecordPos[1]  AND arrbRecordPos[2] AND arrbRecordPos[3]  THEN  //至少有3个连续黄
				stAlarm.arrFlowAlarm[42]:=bYellowMackAlarm:=TRUE;  
				arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
				iEndYellowMackStep:=0;
			END_IF
			
		ELSIF 	  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos> 190 	 AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 200 THEN  			
			arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
			iEndYellowMackStep:=0;	
		END_IF


END_CASE

(*
IF nInt[3]=1 THEN
	IF 160<arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<310 THEN
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=FALSE;//踢NG料打开
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=TRUE;//踢NG料关闭		
	ELSE
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bON:=TRUE;//踢NG料打开
		arrCyCtrl[EvNo.	NGPushInsideAir	].Cmd.bOFF:=FALSE;//踢NG料关闭			
	END_IF
END_IF
BeltData[BeltNo.NGBox1+3].bHavePole;
BeltData[BeltNo.NGBox1+2].bHavePole;
*)


(*

(*****************************************************4连黄标尾料检测  SJ*********************************************************************)
  rtTabSenser2(CLK:=stSenser.bFourYellowUP , Q=> );
  ftTabSenser2(CLK:=stSenser.bFourYellowUP , Q=> );
  
  ProductPar.fYellowMackLength1; //相邻黄标后边距离
  
  //ProductPar.fDriverStanderBasePos;//主驱动标准极耳下降沿位置
  //ProductPar.bDriverStanderBasePosEN;//自动找极耳基准屏蔽    1.等料带正常寻基准用    2. 屏蔽后不会 调整极耳
  
CASE  iEndYellowMackStep  OF
0: 
      IF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=2  AND   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<=10  AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  stDriverCam.bInSync   THEN   
            iEndYellowMackStep:=100;
			nInt[2]	:=0;  
       END_IF

100:  //记录极耳上升沿，下降沿对应主轴位置
  IF   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 353   THEN
	  IF  ftTabSenser2.Q THEN
	  		CASE nInt[2] OF
				0:
					arrfVirMainSenserPos[1]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
					arrbRecordPos[1] :=TRUE;
					nInt[2]	:=1;
				1:
					arrfVirMainSenserPos[2]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
					arrbRecordPos[2] :=TRUE;
					nInt[2]	:=2;
				2:
					arrfVirMainSenserPos[3]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
					arrbRecordPos[3] :=TRUE;
					nInt[2]	:=3;	
				3:
					arrfVirMainSenserPos[4]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
					arrbRecordPos[4] :=TRUE;
					nInt[2]	:=4;					
			END_CASE
		END_IF
		(*
			IF  ftTabSenser2.Q  AND NOT arrbRecordPos[1]  THEN
				 arrfVirMainSenserPos[1]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
				 arrbRecordPos[1] :=TRUE;
			END_IF
			IF  ftTabSenser2.Q  AND  arrbRecordPos[1]  AND   NOT arrbRecordPos[2]  THEN
				 arrfVirMainSenserPos[2]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
				 arrbRecordPos[2] :=TRUE;
			END_IF			
			IF  ftTabSenser2.Q  AND  arrbRecordPos[1]  AND  arrbRecordPos[2]     AND   NOT arrbRecordPos[3]  THEN
				 arrfVirMainSenserPos[3]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
				 arrbRecordPos[3] :=TRUE;
			END_IF				
	    	IF  ftTabSenser2.Q  AND  arrbRecordPos[1]  AND  arrbRecordPos[2]    AND  arrbRecordPos[3]    AND   NOT arrbRecordPos[4]  THEN
				 arrfVirMainSenserPos[4]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
				 arrbRecordPos[4] :=TRUE;
			 END_IF	
		*)					
ELSIF 	  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos> 353 	 AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 360 THEN  
			 
			IF arrbRecordPos[1]  AND arrbRecordPos[2] AND arrbRecordPos[3]  THEN  //至少有3个连续黄标
				      fD12:=arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1];
			          fD23:=arrfVirMainSenserPos[3] -arrfVirMainSenserPos[2];
					  fD34:=arrfVirMainSenserPos[4] -arrfVirMainSenserPos[3];
					  
					 IF    ( arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1] >=ProductPar.fYellowMackLength1-5  AND   arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1] <=ProductPar.fYellowMackLength1+5 )  AND   
						   ( arrfVirMainSenserPos[3] -arrfVirMainSenserPos[2] >=ProductPar.fYellowMackLength1-5  AND   arrfVirMainSenserPos[3] -arrfVirMainSenserPos[2] <=ProductPar.fYellowMackLength1+5 )  THEN  //检测到3连黄标
						  bYellowMackAlarm:=TRUE;
						  
						   arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
						  arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;  
							iEndYellowMackStep:=0;
				    ELSE    //不满足3连黄标条件   
						  arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
						  arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;
						  iEndYellowMackStep:=0;
					 END_IF
			ELSIF  arrbRecordPos[1]  AND arrbRecordPos[2] THEN    //当前周期检测出2个极耳 如果判定在设定间距则下个周期继续检测
  		             fD12:=arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1];
					 IF    ( arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1] >=ProductPar.fYellowMackLength1-5  AND   arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1] <=ProductPar.fYellowMackLength1+5 )  THEN   
					
							iEndYellowMackStep:=200; //下个周期继续检测 极耳3
				     ELSE    //不满足3连黄标条件   
						  arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
						  arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;
						  iEndYellowMackStep:=0;
					 END_IF
					 
			ELSIF  arrbRecordPos[1]   THEN  // //当前周期检测出1个极耳  下个周期继续检黄标 2  3   4
		              iEndYellowMackStep:=300; //下个周期继续检测 极耳2   3    4
	
			ELSE   //当前周期无黄标
					 arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
					arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;
			         iEndYellowMackStep:=0;
			
			END_IF

   END_IF

  
200:    //下个周期继续检测极耳3  4
      IF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=2  AND   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<=10  AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  stDriverCam.bInSync   THEN   
            iEndYellowMackStep:=210;   
       END_IF
210:
IF    arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 180  THEN
	IF  ftTabSenser2.Q THEN
			CASE nInt[2] OF
				0:
					arrfVirMainSenserPos[1]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
					arrbRecordPos[1] :=TRUE;
					nInt[2]	:=1;
				1:
					arrfVirMainSenserPos[2]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
					arrbRecordPos[2] :=TRUE;
					nInt[2]	:=2;
				2:
					arrfVirMainSenserPos[3]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
					arrbRecordPos[3] :=TRUE;
					nInt[2]	:=3;	
				3:
					arrfVirMainSenserPos[4]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
					arrbRecordPos[4] :=TRUE;
					nInt[2]	:=4;					
			END_CASE
	END_IF
			(*
			IF  ftTabSenser2.Q  AND  arrbRecordPos[1]  AND  arrbRecordPos[2]     AND   NOT arrbRecordPos[3]  THEN
				 arrfVirMainSenserPos[3]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
				 arrbRecordPos[3] :=TRUE;
			END_IF				
	    	IF  ftTabSenser2.Q  AND  arrbRecordPos[1]  AND  arrbRecordPos[2]    AND  arrbRecordPos[3]    AND   NOT arrbRecordPos[4]  THEN
				 arrfVirMainSenserPos[4]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
				 arrbRecordPos[4] :=TRUE;
			 END_IF
		*)									 
ELSIF 	  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos> 180 	 AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 190 THEN   			 
			 	IF arrbRecordPos[1]  AND arrbRecordPos[2] AND arrbRecordPos[3]  THEN  //至少有3个连续黄标
				      fD12:=arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1];
			          fD12:=arrfVirMainSenserPos[3] -arrfVirMainSenserPos[2];
					  fD12:=arrfVirMainSenserPos[4] -arrfVirMainSenserPos[3];
					  
					 IF    ( arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1] >=ProductPar.fYellowMackLength1-5  AND   arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1] <=ProductPar.fYellowMackLength1+5 )  AND   
						   ( arrfVirMainSenserPos[3] -arrfVirMainSenserPos[2] >=ProductPar.fYellowMackLength1-5  AND   arrfVirMainSenserPos[3] -arrfVirMainSenserPos[2] <=ProductPar.fYellowMackLength1+5 )  THEN  //检测到3连黄标
						  bYellowMackAlarm:=TRUE;
						   arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
						  arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;  
							iEndYellowMackStep:=0;
				    ELSE    //不满足3连黄标条件   
						  arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
						  arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;
						  iEndYellowMackStep:=100;
					 END_IF			 	 
			    END_IF	
				
ELSIF 	 arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos> 190 	 AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 200   THEN   		
						  arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
						  arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;
						  iEndYellowMackStep:=100;			
 END_IF
   
 
 
 
 
 300:  //下个周期继续检测 极耳2   3    4
       IF  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=2  AND   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<=10  AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  stDriverCam.bInSync   THEN   
            iEndYellowMackStep:=310;   
       END_IF

 310:
   IF   arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 180   THEN
		IF  ftTabSenser2.Q THEN
				CASE nInt[2] OF
					0:
						arrfVirMainSenserPos[1]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
						arrbRecordPos[1] :=TRUE;
						nInt[2]	:=1;
					1:
						arrfVirMainSenserPos[2]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
						arrbRecordPos[2] :=TRUE;
						nInt[2]	:=2;
					2:
						arrfVirMainSenserPos[3]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
						arrbRecordPos[3] :=TRUE;
						nInt[2]	:=3;	
					3:
						arrfVirMainSenserPos[4]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
						arrbRecordPos[4] :=TRUE;
						nInt[2]	:=4;					
				END_CASE
		END_IF	   
(*	   
			IF  ftTabSenser2.Q  AND  arrbRecordPos[1]  AND   NOT arrbRecordPos[2]  THEN
				 arrfVirMainSenserPos[2]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
				 arrbRecordPos[2] :=TRUE;
			END_IF			
			IF  ftTabSenser2.Q  AND  arrbRecordPos[1]  AND  arrbRecordPos[2]     AND   NOT arrbRecordPos[3]  THEN
				 arrfVirMainSenserPos[3]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
				 arrbRecordPos[3] :=TRUE;
			END_IF				
	    	IF  ftTabSenser2.Q  AND  arrbRecordPos[1]  AND  arrbRecordPos[2]    AND  arrbRecordPos[3]    AND   NOT arrbRecordPos[4]  THEN
				 arrfVirMainSenserPos[4]:=     FC_AngleToLength(arrAxisCtrl[VirAxisNo.VirDriver].Status.fActPos ,     (PolePar.fPoleWidth+fbUwindTen.fCompensation)/Tc2_System.PI  )  ;
				 arrbRecordPos[4] :=TRUE;
			 END_IF
*)						
ELSIF 	  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos> 180 	 AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 190 THEN  
			 
			IF arrbRecordPos[1]  AND arrbRecordPos[2] AND arrbRecordPos[3]  THEN  //至少有3个连续黄标
				      fD12:=arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1];
			          fD12:=arrfVirMainSenserPos[3] -arrfVirMainSenserPos[2];
					  fD12:=arrfVirMainSenserPos[4] -arrfVirMainSenserPos[3];	  
					 IF    ( arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1] >=ProductPar.fYellowMackLength1-5  AND   arrfVirMainSenserPos[2] -arrfVirMainSenserPos[1] <=ProductPar.fYellowMackLength1+5 )  AND   
						   ( arrfVirMainSenserPos[3] -arrfVirMainSenserPos[2] >=ProductPar.fYellowMackLength1-5  AND   arrfVirMainSenserPos[3] -arrfVirMainSenserPos[2] <=ProductPar.fYellowMackLength1+5 )  THEN  //检测到3连黄标
						  bYellowMackAlarm:=TRUE;  
						   arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
						  arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;  
							iEndYellowMackStep:=0;
				    ELSE    //不满足3连黄标条件   
						  arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
						  arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;
						  iEndYellowMackStep:=100;
					 END_IF
		  ELSE   //当前周期无黄标
					 arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
					arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;
			         iEndYellowMackStep:=100;
			END_IF

ELSIF 	  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos> 190 	 AND  arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos< 200 THEN  			
			arrbRecordPos[1] :=arrbRecordPos[2] :=arrbRecordPos[3] :=arrbRecordPos[4]  := FALSE;
			arrfVirMainSenserPos[1] :=arrfVirMainSenserPos[2] :=arrfVirMainSenserPos[3] :=arrfVirMainSenserPos[4]  := 0;
		    iEndYellowMackStep:=100;	
 END_IF

   
END_CASE

*)




]]></ST>
      </Implementation>
    </Action>
    <Action Name="F05Rectifydev" Id="{6d1368d9-9736-4802-a465-2be8ef0291f5}">
      <Implementation>
        <ST><![CDATA[
(******************************************************************极片纠偏V2  SJ*****************************************************************************)
//极片纠偏条件
fbRectifyGM.bRecEn:=   (  (   (arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=5  AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<80) OR 
                                               (arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=180  AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<250)  )      AND
	                                          arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  stDriverCam.bInSync AND NOT ProductPar.iModeEN.bMouldYRecEN AND
                                              NOT bCyDDRMark AND NOT  RecYRules[1] )       ;
											  
(*fbRectifyGM.bRecEn:=   (  (   (arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=5  AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<80) OR 
                                               (arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=180  AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<250)  )      AND
	                                          arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  stDriverCam.bInSync AND NOT ProductPar.iModeEN.bMouldYRecEN  AND NOT  RecYRules[1] )       ;*)											  
								  
//黄标不纠偏范围判断,,,-170指黄标感应器高裁切距离-170=黄标感应器到纠偏传感器的距离,,,即纠偏传感器到裁切切刀距离为170
	FOR i9:=1 TO 20  DO	
		(*
		IF (PolePar.fPoleWidth-50<=(aYellowPos[i9]+PolePar.fBlue_Mould-165-fDriverDDRActPos ))
			AND ( (aYellowPos[i9]+PolePar.fBlue_Mould-165-fDriverDDRActPos)<=PolePar.fPoleWidth+50 )AND aYellowPos[i9]>0 THEN						
			RecYRules[1]:=TRUE;//不纠偏
			EXIT;
		ELSE
				RecYRules[1]:=FALSE;//纠偏
		END_IF*)	
		IF      aYellowPos[i9]+PolePar.fBlue_Mould-fDriverDDRActPos<=165+80   AND   aYellowPos[i9]+PolePar.fBlue_Mould-fDriverDDRActPos>=165-80   
                        AND  aYellowPos[i9]>0   THEN
		        RecYRules[1]:=TRUE;//不纠偏
			EXIT;
		ELSE	
		        RecYRules[1]:=FALSE;//纠偏
		END_IF
		
	END_FOR	

										 
fbRectifyGM(
	bReset:=                      stSysState.bReset  ,  
	Execute:=                    RecY.bEnable  , 
	bCcw:=                       TRUE,//PolePar.Rec.bRectifyDir ,
	iRectifyMode:=           2 , //PolePar.Rec.iMode,
	bRecEn:=                   ,                         //纠偏容许条件
	fSensorActValue:=       stSenser.aiMouldRectifyBe , 
	fSensorActValue1:=     stSenser.aiMouldRectifyFr , 
	fSensorMaxValue:=     PolePar.Rec.fRecAxisPos_H, //从轴纠偏行程上限
	fSensorMinValue:=      PolePar.Rec.fRecAxisPos_L ,  //从轴纠偏行程下限
	fSensorBalanceValue:= PolePar.Rec.fRecBaseValue1+fArvTransverData2,//纠偏平衡位置
	fTolerance:=                PolePar.Rec.fRecBaseRange   ,  //纠偏死区                        , 
	fGMLengthSet:=           300, //纠偏距离标定
	fTimeAdjust:=                PolePar.Rec.fRectifyCoe , //纠偏时间标定
	bReady=>                    RecY.bReady ,
	bAutoRunning=>          RecY.bRecOK, 
	Error=> , 
	Axis_Rectify1:=         arrAxis[AxisNo.MouldRectify_Y] ,    
	Axis_VirGM:=        arrAxis[AxisNo.DriverDDR] ,    
	Axis_Time:=          arrAxis[NameNo.VirTimeWind] ,     );

RecY.bError:=fbRectifyGM.Error;//隔膜纠偏报警



(******************************************************************放卷纠偏，过程纠偏*****************************************************************************)
// 注意 : PoleWind代表过程纠偏      PoleProcess代表放卷纠偏   
//rMQUse[9](CLK:=stUwindTen.bError);//张力报警
//rMQUse[10](CLK:=stSysState.iMode=1);//自动
tonRecDelay(IN:= , PT:=T#300MS , Q=> , ET=> );


 //rtBoardPressTurn(CLK:=  stSysState.iMode=3  AND  ( arrCyCtrl[CYNo.BoardPressR].Io.DIOFFSwitch  OR  arrCyCtrl[CYNo.BoardPressL].Io.DIOFFSwitch ) , Q=> ); //检测压板有下压动作
 rtBoardPressTurn(CLK:= ((arrCyCtrl[NameNo.AnCYNo.Inflation_L].Status.OFFState AND PolePar.MQ.bWindSelect)OR (arrCyCtrl[NameNo.AnCYNo.Inflation_R].Status.OFFState   AND NOT PolePar.MQ.bWindSelect) ) , Q=> ); //检测压板有下压动作
 rtBreakError(CLK:= stUwindTen.bError AND  ((stAuxDriverTen.fDanserDegree>PolePar.MQ.AuxDriverTenMaxPos-2)  OR  (stAuxDriverTen.fDanserDegree<PolePar.MQ.AuxDriverTenMinPos+2))   , Q=> ); //检测到断带
       IF   rtBoardPressTurn.Q OR rtBreakError.Q THEN
		    fCyDDRActPos:=fDriverDDRActPos;//记录主驱当前位置
			bCyDDRMark:=TRUE;//滞后纠偏标志
	   END_IF
  IF  bCyDDRMark  AND    fDriverDDRActPos-fCyDDRActPos >=2500     THEN  //料带走2500mm后恢复纠偏
       bCyDDRMark:=FALSE;//滞后纠偏标志复位
  END_IF
	IF  bCyDDRMark  AND    fDriverDDRActPos < fCyDDRActPos-2500     THEN  //主驱位置小于主驱记录位置，复位滞后纠偏
		bCyDDRMark:=FALSE;//滞后纠偏标志复位
	END_IF
	
 // rtRecManual1(CLK:=  stSysState.iMode=3 AND   arrAxis[VirAxisNo.VirMain].NcToPlc.SetVelo=0            , Q=> );  //手动状态
//  rtRecManual1(CLK:=   arrAxis[VirAxisNo.VirMain].NcToPlc.SetVelo=0            , Q=> );  //手动状态
  tonRecCenterDelay(IN:= , PT:=T#4.5S , Q=> , ET=> );  //居中移动延时
  
 
  CASE  RecSetp  OF
	    0:  //检查是否是处于手动状态
          tonRecDelay.IN:=FALSE;
          tonRecCenterDelay.IN:=FALSE;
          RecSetp:=1;
  
	  1:  //检查是否是处于手动状态
	       tonRecDelay.IN:=TRUE;
		   IF  tonRecDelay.Q THEN
			    IF (  (stSysState.iMode=3 AND   arrAxis[VirAxisNo.VirMain].NcToPlc.SetVelo=0)   OR 
                     stUwindTen.bError   OR
                     bCyDDRMark    )   AND     iRecStatus<>1     THEN// AND     iRecStatus<>1  
			         bFlgRecManual:=TRUE; 
		        END_IF
			    tonRecDelay.IN:=FALSE;
	           RecSetp:=2;
		   END_IF
	  2:  //纠偏居中
	       tonRecDelay.IN:=TRUE;
		   
	      IF stSysState.iMode=3    AND  (  (fbRotateSwitchCode.iCodeOut=11 OR fbRotateSwitchCode.iCodeOut=3)   AND rtPoleBtn.Q     )    THEN  //AND   iRecStatus<>3  
	            tonRecCenterDelay.IN:=TRUE;
				bFlgRecCenter:=TRUE;
			    bRecCenterMoving:=TRUE;
		  END_IF
		  
		  IF  bRecCenterMoving THEN
			    IF  tonRecCenterDelay.Q THEN
				     bRecCenterMoving:=FALSE;
					  tonRecCenterDelay.IN:=FALSE;
					   tonRecDelay.IN:=FALSE;
                     RecSetp:=3;	  		 
			   END_IF
		  ELSE  
			  IF  tonRecDelay.Q THEN
				   tonRecDelay.IN:=FALSE;
			      tonRecCenterDelay.IN:=FALSE;
			      RecSetp:=3;	  
		  	 END_IF		
		  END_IF
		   
	3:  //纠偏自动启动
	      tonRecDelay.IN:=TRUE;
		    IF  tonRecDelay.Q THEN
			     IF    stSysState.iMode=1 AND  stUwindTen.bTensionOK   AND   NOT  bCyDDRMark     THEN  // AND   iRecStatus<>2
			            bFlgRecAuto:=TRUE; 
		          END_IF		
				 tonRecDelay.IN:=FALSE;
	            RecSetp:=0;	   
		   END_IF
		   
  END_CASE
  
  
  
  IF  bFlgRecManual THEN
	  	arrRecCtrl[RecNo.PoleWind].Cmd.bCentre:=FALSE;
		arrRecCtrl[RecNo.PoleWind].Cmd.bAuto :=FALSE;
		//arrRecCtrl[RecNo.PoleWind].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleWind].Cmd.bManual:=TRUE;
		
		arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto :=FALSE;
	//	arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=TRUE;
		
		iRecStatus:=1;
		bFlgRecManual:=FALSE;
  END_IF
  
  
    IF  bFlgRecAuto THEN
	  	arrRecCtrl[RecNo.PoleWind].Cmd.bCentre:=FALSE;
		arrRecCtrl[RecNo.PoleWind].Cmd.bAuto :=TRUE;
		//arrRecCtrl[RecNo.PoleWind].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleWind].Cmd.bManual:=FALSE;
		
		arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto :=TRUE;
		//arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=FALSE;
		iRecStatus:=2;
		bFlgRecAuto:=FALSE;
  END_IF

  
   IF  bFlgRecCenter THEN
	  //	arrRecCtrl[RecNo.PoleWind].Cmd.bCentre:=TRUE;
		//arrRecCtrl[RecNo.PoleWind].Cmd.bAuto :=FALSE;
		//arrRecCtrl[RecNo.PoleWind].Cmd.bLock:=FALSE;
		//arrRecCtrl[RecNo.PoleWind].Cmd.bManual:=FALSE;
		
		arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=TRUE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto :=FALSE;
		//arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=FALSE;
		iRecStatus:=3;
		bFlgRecCenter:=FALSE;
  END_IF
  
  
 (* 
 	5:  //纠偏自动锁定
	      IF    stSysState.iMode=1   THEN
			     arrRecCtrl[RecNo.PoleWind].Cmd.bLock:=TRUE;
				 arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=TRUE;
		ELSE		 
			     arrRecCtrl[RecNo.PoleWind].Cmd.bLock:=FALSE;
				 arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=FALSE;	 	 
		  END_IF
		  
	     RecSetp:=0;	 
*)


(*

  CASE  RecSetp  OF
	    0:  //检查是否是处于手动状态
          tonRecDelay.IN:=FALSE;
          tonRecCenterDelay.IN:=FALSE;
          RecSetp:=1;
  
	  1:  //检查是否是处于手动状态
	       tonRecDelay.IN:=TRUE;
	      IF (  (stSysState.iMode=3 AND   arrAxis[VirAxisNo.VirMain].NcToPlc.SetVelo=0)   OR 
                stUwindTen.bError   OR
                bCyDDRMark    ) THEN// AND     iRecStatus<>1  
			    bFlgRecManual:=TRUE; 
		   END_IF
		   IF  tonRecDelay.Q THEN
			    tonRecDelay.IN:=FALSE;
	           RecSetp:=2;
		   END_IF
	  2:  //纠偏居中
	       tonRecDelay.IN:=TRUE;
		   
	      IF stSysState.iMode=3    AND  (  (fbRotateSwitchCode.iCodeOut=11 OR fbRotateSwitchCode.iCodeOut=3)   AND rtPoleBtn.Q     )    THEN  //AND   iRecStatus<>3  
	            tonRecCenterDelay.IN:=TRUE;
				bFlgRecCenter:=TRUE;
			    bRecCenterMoving:=TRUE;
		  END_IF
		  
		  IF  bRecCenterMoving THEN
			    IF  tonRecCenterDelay.Q THEN
				     bRecCenterMoving:=FALSE;
					  tonRecCenterDelay.IN:=FALSE;
					   tonRecDelay.IN:=FALSE;
                     RecSetp:=3;	  		 
			   END_IF
		  ELSE  
			  IF  tonRecDelay.Q THEN
				   tonRecDelay.IN:=FALSE;
			      tonRecCenterDelay.IN:=FALSE;
			      RecSetp:=3;	  
		  	 END_IF		
		  END_IF
		   
	3:  //纠偏自动启动
	      tonRecDelay.IN:=TRUE;
	      IF    stSysState.iMode=1 AND  stUwindTen.bTensionOK   AND   NOT  bCyDDRMark     THEN  // AND   iRecStatus<>2
			  bFlgRecAuto:=TRUE; 
		  END_IF
		    IF  tonRecDelay.Q THEN
				 tonRecDelay.IN:=FALSE;
	            RecSetp:=0;	   
		   END_IF
		   
  END_CASE

*)
















(*
//////////////////////////////////模具Y纠偏//////////////////////////////////
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos>=20  AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloSetPos<250 AND
	   arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND  stDriverCam.bInSync  AND NOT ProductPar.iModeEN.bMouldYRecEN AND NOT RecYRules[1] THEN
		RecY.bEnable:=TRUE;				
	ELSE
		RecY.bEnable:=FALSE;	
	END_IF


//黄标不纠偏范围判断,,,-170指黄标感应器高裁切距离-170=黄标感应器到纠偏传感器的距离,,,即纠偏传感器到裁切切刀距离为170
	FOR i9:=20 TO 1 BY -1 DO	
		IF (PolePar.fPoleWidth-35<=(aYellowPos[i9]+PolePar.fBlue_Mould+5*PolePar.fPoleWidth-170-fDriverDDRActPos ))
			AND ( (aYellowPos[i9]+PolePar.fBlue_Mould+5*PolePar.fPoleWidth-170-fDriverDDRActPos)<=PolePar.fPoleWidth+35 )
			AND aYellowPos[i9]>0 THEN						
				RecYRules[1]:=TRUE;//不纠偏
				EXIT;
		ELSE
				RecYRules[1]:=FALSE;//纠偏
		END_IF
	END_FOR	
	
	
	
	
	
fbTailCurl(
	Enable:=RecY.bEnable , 
	RestHMI:=stSysState.bReset , 
	MasterNo:=NameNo.VirTimeWind , 
	SlaveNo:=AxisNo.MouldRectify_Y , 
	MasterValue:=arrAxisCtrl[NameNo.VirTimeWind].Status.fActVelo , 
	RecDevEqupos1:=PolePar.Rec.fRecBaseValue1,//SEL(CCD_Rounde.CWW,PolePar.Rec.fRecBaseValue1+CCD_Rounde.ResultData,PolePar.Rec.fRecBaseValue1-CCD_Rounde.ResultData)  , 
	RecDevEqupos2:=PolePar.Rec.fRecBaseValue2 , 
	RecDevValueSet:=PolePar.Rec.fRecBaseRange , 
	RecDevPV1:=stSenser.aiMouldRectifyBe , 
	RecDevPV2:=stSenser.aiMouldRectifyFr , 
	RecDevSpeedCoe:=PolePar.Rec.fRectifyCoe , 
	CWW:=PolePar.Rec.bRectifyDir , 
	AxisintiPos:=arrAxisPar[AxisNo.MouldRectify_Y].arrTargetPoint[1] , 
	AxisPos_H:=PolePar.Rec.fRecAxisPos_H , 
	AxisPos_L:=PolePar.Rec.fRecAxisPos_L , 
	bMode:=PolePar.Rec.iMode,
	iMainVel := PolePar.iMainVel , 
	bError=>RecY.bError , 
	bRecOK=>RecY.bRecOK , 
	bReady=>RecY.bReady );
	PolePar.Rec.iMode:=1;



//CCD闭环补偿
CCD_Rounde(
	CCD_Enable:=CCD_Rounde.CCD_Enable , //启动
	CWW:= , //纠偏方向选择
	IntervalNum:=PolePar.IntervalNum , //片间距
	KI_Riao:=PolePar.KI_Riao , //比例系数
	Databace_R3:=PolePar.Databace_R3  , //CCD 非极耳侧纵深基准正极5.6  负极2.6
	Databace_R4:=PolePar.Databace_R4 , //CCD 极耳侧纵深基准正极5.6  负极2.6
	CCD_RoundedSize_R3:=CCD_COM.Size.RoundedSize1 , //CCD 非极耳侧纵深
	CCD_RoundedSize_R4:=CCD_COM.Size.RoundedSize2 , //CCD 极耳侧纵深
	Limt_Max:=PolePar.Limt_Max , //最大补偿值
	Limt_Min:=PolePar.Limt_Min, //最小补偿值
	JzData:=PolePar.Rec.fRecBaseValue1,
	ResultData=> );//补偿值输出
CCD_Rounde.KK;//启动开关；
*)


(*

IF stSysState.iMode=1 THEN
	IF (fCyDDRActPos+2900-fDriverDDRActPos<=0  ) AND NOT bCyDDRMark THEN
		bCyDDRMark:=TRUE;//设备自动时纠偏启动标志位
		arrRecCtrl[RecNo.PoleWind].Cmd.bCentre:=FALSE;
		arrRecCtrl[RecNo.PoleWind].Cmd.bAuto :=TRUE;
		arrRecCtrl[RecNo.PoleWind].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleWind].Cmd.bManual:=FALSE;
		
		arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto :=TRUE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=FALSE;
	END_IF
END_IF



//张力报警放卷剪片、行进纠偏回手动
IF rMQUse[9].Q THEN
	arrRecCtrl[RecNo.PoleWind].Cmd.bCentre:=FALSE;
	arrRecCtrl[RecNo.PoleWind].Cmd.bAuto :=FALSE;
	arrRecCtrl[RecNo.PoleWind].Cmd.bLock:=FALSE;
	arrRecCtrl[RecNo.PoleWind].Cmd.bManual:=TRUE;
	
	arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=FALSE;
	arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto :=FALSE;
	arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=FALSE;
	arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=TRUE;
END_IF


//气涨轴松开时放卷纠偏居中	
IF PolePar.MQ.bWindSelect THEN
	IF rMQUse[7].Q THEN	
		arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto :=TRUE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=FALSE;
	END_IF
	IF fMQUse[7].Q THEN	
		arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=TRUE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto :=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=FALSE;
	END_IF
ELSE	
	IF rMQUse[8].Q THEN	
		arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto :=TRUE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=FALSE;
	END_IF
	IF fMQUse[8].Q THEN	
		arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre:=TRUE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto :=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bLock:=FALSE;
		arrRecCtrl[RecNo.PoleProcess].Cmd.bManual:=FALSE;
	END_IF
END_IF

*)



]]></ST>
      </Implementation>
    </Action>
    <Action Name="F07Condition" Id="{051551c2-babe-4355-b6ce-48d75c0b401e}">
      <Implementation>
        <ST><![CDATA[MQ_alarm_ton[1](PT:=T#100MS);
MQ_alarm_ton[2](PT:=T#100MS);
MQ_alarm_ton[3](PT:=T#100MS);
MQ_alarm_ton[4](PT:=T#100MS);
MQ_alarm_ton[5](PT:=T#100MS);
MQ_alarm_ton[6](PT:=T#100MS);
MQ_alarm_ton[7](PT:=T#100MS);
MQ_alarm_ton[8](PT:=T#100MS);
MQ_alarm_ton[9](PT:=T#100MS);
MQ_alarm_ton[10](PT:=T#100MS);
MQ_alarm_ton[11](PT:=T#100MS);
MQ_alarm_ton[12](PT:=T#100MS);
MQ_alarm_ton[13](PT:=T#100MS);
MQ_alarm_ton[14](PT:=T#100MS);
MQ_alarm_ton[15](PT:=T#100MS);
MQ_alarm_ton[16](PT:=T#100MS);
MQ_alarm_ton[17](PT:=T#100MS);





////////////////////////////////////线扫IO触发////////////////////////////////////////
rLineScanOK_UP(CLK:=stSenser.bLineScanResult1_UP , Q=> );
rLineScanNG_UP(CLK:=stSenser.bLineScanResult2_UP , Q=> );
rLineScanOK_Down(CLK:=stSenser.bLineScanResult1_Down , Q=> );
rLineScanNG_Down(CLK:=stSenser.bLineScanResult2_Down , Q=> );
IF rLineScanOK_UP.Q THEN
	bLineScanResult1_UP:=TRUE;
END_IF
IF rLineScanNG_UP.Q THEN
	bLineScanResult2_UP:=TRUE;
END_IF
IF rLineScanOK_Down.Q THEN
	bLineScanResult1_Down:=TRUE;
END_IF
IF rLineScanNG_Down.Q THEN
	bLineScanResult2_Down:=TRUE;
END_IF


////////////////////////////////////微分&延时////////////////////////////////////
rtbtnRest(CLK:=stSysState.bReset , Q=> );
rtCondition[1](CLK:=bTest[1],Q=>);//测试1
tonCondition[1](In:=CCD_Com.bLineHeart,PT:=T#2S);//线扫软件心跳延时1
tonCondition[2](In:=NOT CCD_Com.bLineHeart,PT:=T#2S);//线扫软件心跳延时2
tonCondition[3](In:=CCD_Com.bAreaHeart,PT:=T#2S);//面阵软件心跳延时1
tonCondition[4](In:=NOT CCD_Com.bAreaHeart,PT:=T#2S);//面阵软件心跳延时2

tonCondition[5](In:=arrRecCtrl[RecNo.PoleWind].Cmd.bCentre,PT:=T#120MS);//放卷纠偏触发回中延时
tonCondition[6](In:=arrRecCtrl[RecNo.PoleWind].Cmd.bAuto,PT:=T#120MS);//放卷纠偏触发自动延时
tonCondition[7](In:=arrRecCtrl[RecNo.PoleWind].Cmd.bManual,PT:=T#120MS);//放卷纠偏触发手动延时
tonCondition[8](In:=arrRecCtrl[RecNo.PoleProcess].Cmd.bCentre,PT:=T#120MS);//过程纠偏触发回中延时
tonCondition[9](In:=arrRecCtrl[RecNo.PoleProcess].Cmd.bAuto,PT:=T#120MS);//过程纠偏触发自动延时
tonCondition[10](In:=arrRecCtrl[RecNo.PoleProcess].Cmd.bManual,PT:=T#120MS);//过程纠偏触发手动延时v


////////////////////////////////////////////自动运行准备好条件//////////////////////////////////
IF ((stUwindTen.bTensionOK AND  PolePar.MQ.bWindSelect) OR(stUwindTen.bTensionOK AND NOT  PolePar.MQ.bWindSelect))  THEN
	bAutoReadyTemp1:=TRUE;//张力准备好
ELSE
	bAutoReadyTemp1:=FALSE;
END_IF															
IF stPoleBufferCam.bCreatTableDone AND stDriverCam.bCreatTableDone AND stCuterCam.bCreatTableDone AND 
	stVirBeltCam.bCreatTableDone (*AND stNGPushCam.bCreatTableDone*) AND stMouldCam.bCreatTableDone AND
	stCCDPressCam.bCreatTableDone THEN
	bAutoReadyTemp2:=TRUE;	//凸轮创建OK
ELSE
	bAutoReadyTemp2:=FALSE;
END_IF	
IF 	arrCyCtrl[CYNo.DriverPressDDR].Status.ONState  THEN
	bAutoReadyTemp3:=TRUE;		//气缸准备OK
ELSE
	bAutoReadyTemp3:=FALSE;
END_IF

IF arrAxisCtrl[AxisNo.Mould].Status.Enabled AND arrAxisCtrl[AxisNo.MouldRectify_X].Status.Enabled AND arrAxisCtrl[AxisNo.MouldRectify_Y].Status.Enabled AND 
	arrAxisCtrl[AxisNo.Cuter].Status.Enabled AND arrAxisCtrl[AxisNo.CuterDegRectify].Status.Enabled AND arrAxisCtrl[AxisNo.CuterBeltChange].Status.Enabled AND
	(*arrAxisCtrl[AxisNo.NGPush1].Status.Enabled AND arrAxisCtrl[AxisNo.NGPush2].Status.Enabled AND *)arrAxisCtrl[AxisNo.CCDPressPush].Status.Enabled AND
	arrAxisCtrl[AxisNo.UnWind_L].Status.Enabled AND arrAxisCtrl[AxisNo.UnWind_R].Status.Enabled (*AND arrAxisCtrl[AxisNo.DriverAux].Status.Enabled *)AND
	arrAxisCtrl[AxisNo.DriverDDR].Status.Enabled AND arrAxisCtrl[AxisNo.BuffeLine].Status.Enabled AND arrAxisCtrl[AxisNo.CuterBelt].Status.Enabled AND 
	arrAxisCtrl[AxisNo.NGPushReverseBelt].Status.Enabled AND arrAxisCtrl[AxisNo.DedustBelt].Status.Enabled AND arrAxisCtrl[AxisNo.DedustReverseBelt].Status.Enabled AND 
	arrAxisCtrl[AxisNo.SubBelt1].Status.Enabled AND arrAxisCtrl[AxisNo.SubBelt2].Status.Enabled AND arrAxisCtrl[AxisNo.SubBelt3].Status.Enabled AND
	arrAxisCtrl[VirAxisNo.VirBelt].Status.Enabled AND arrAxisCtrl[VirAxisNo.VirDriver].Status.Enabled AND arrAxisCtrl[VirAxisNo.VirMain].Status.Enabled THEN
	bAutoReadyTemp4:=TRUE;		//轴准备OK
ELSE
	bAutoReadyTemp4:=FALSE;
END_IF

IF NOT arrAxisCtrl[AxisNo.Mould].Status.Error AND NOT arrAxisCtrl[AxisNo.Mould] .Status.ErrorLimitSwitch AND  
	NOT arrAxisCtrl[AxisNo.MouldRectify_X].Status.Error AND NOT arrAxisCtrl[AxisNo.MouldRectify_X] .Status.ErrorLimitSwitch AND  
	NOT arrAxisCtrl[AxisNo.MouldRectify_Y].Status.Error AND NOT arrAxisCtrl[AxisNo.MouldRectify_Y] .Status.ErrorLimitSwitch AND  
	NOT arrAxisCtrl[AxisNo.Cuter].Status.Error AND NOT arrAxisCtrl[AxisNo.Cuter] .Status.ErrorLimitSwitch AND 
	NOT arrAxisCtrl[AxisNo.CuterDegRectify].Status.Error AND NOT arrAxisCtrl[AxisNo.CuterDegRectify] .Status.ErrorLimitSwitch AND  	
	NOT arrAxisCtrl[AxisNo.CuterBeltChange].Status.Error AND NOT arrAxisCtrl[AxisNo.CuterBeltChange] .Status.ErrorLimitSwitch AND  
	NOT arrAxisCtrl[AxisNo.CCDPressPush].Status.Error AND NOT arrAxisCtrl[AxisNo.CCDPressPush] .Status.ErrorLimitSwitch AND   
	NOT arrAxisCtrl[AxisNo.UnWind_L].Status.Error AND NOT arrAxisCtrl[AxisNo.UnWind_L] .Status.ErrorLimitSwitch AND   
	NOT arrAxisCtrl[AxisNo.UnWind_R].Status.Error AND NOT arrAxisCtrl[AxisNo.UnWind_R] .Status.ErrorLimitSwitch AND   
	NOT arrAxisCtrl[AxisNo.DriverDDR].Status.Error AND NOT arrAxisCtrl[AxisNo.DriverDDR] .Status.ErrorLimitSwitch AND   
	NOT arrAxisCtrl[AxisNo.BuffeLine].Status.Error AND NOT arrAxisCtrl[AxisNo.BuffeLine] .Status.ErrorLimitSwitch AND    
	NOT arrAxisCtrl[AxisNo.CuterBelt].Status.Error AND NOT arrAxisCtrl[AxisNo.CuterBelt] .Status.ErrorLimitSwitch AND   
	NOT arrAxisCtrl[AxisNo.NGPushReverseBelt].Status.Error AND NOT arrAxisCtrl[AxisNo.NGPushReverseBelt] .Status.ErrorLimitSwitch AND    
	NOT arrAxisCtrl[AxisNo.DedustBelt].Status.Error AND NOT arrAxisCtrl[AxisNo.DedustBelt] .Status.ErrorLimitSwitch AND    
	NOT arrAxisCtrl[AxisNo.DedustReverseBelt].Status.Error AND NOT arrAxisCtrl[AxisNo.DedustReverseBelt] .Status.ErrorLimitSwitch AND     
	NOT arrAxisCtrl[AxisNo.SubBelt1].Status.Error AND NOT arrAxisCtrl[AxisNo.SubBelt1] .Status.ErrorLimitSwitch AND    
	NOT arrAxisCtrl[AxisNo.SubBelt2].Status.Error AND NOT arrAxisCtrl[AxisNo.SubBelt2] .Status.ErrorLimitSwitch AND    
	NOT arrAxisCtrl[AxisNo.SubBelt3].Status.Error AND NOT arrAxisCtrl[AxisNo.SubBelt3] .Status.ErrorLimitSwitch AND    
	NOT arrAxisCtrl[VirAxisNo.VirBelt].Status.Error AND NOT arrAxisCtrl[VirAxisNo.VirBelt] .Status.ErrorLimitSwitch AND   
	NOT arrAxisCtrl[VirAxisNo.VirDriver].Status.Error AND NOT arrAxisCtrl[VirAxisNo.VirDriver] .Status.ErrorLimitSwitch AND    
	NOT arrAxisCtrl[VirAxisNo.VirMain].Status.Error AND NOT arrAxisCtrl[VirAxisNo.VirMain] .Status.ErrorLimitSwitch THEN
		bAutoReadyTemp5:=TRUE;
ELSE
	bAutoReadyTemp5:=FALSE;
END_IF

IF 	bAutoReadyTemp2 AND NOT SysPart.bErrorStop AND SysPart.Homed AND bAutoReadyTemp4 AND bAutoReadyTemp5 THEN
	SysPart.bAutoCondition1:=TRUE;
ELSE
	SysPart.bAutoCondition1:=FALSE;		
END_IF
IF 	bAutoReadyTemp2 AND NOT SysPart.bErrorStop AND SysPart.Homed AND (ProductPar.iModeEN.bEmptyRunEN OR bAutoReadyTemp1 AND bAutoReadyTemp3 ) THEN
	SysPart.bAutoCondition2:=TRUE;
ELSE
	SysPart.bAutoCondition2:=FALSE;		
END_IF 


//新黄标、接带检测------------------------新
		PolePar.fLugBreadth;//极耳宽度
		PolePar.fCutBreadth;//极耳边到切刀切点宽度
		PolePar.fYellowBreadth;//黄标宽度
		//黄标第一片到R角距离5片，，，到裁切5片共10片，，，到踢废n片
ftAuto[1](CLK:=stSenser.bYellowCheck_C , Q=> );//黄标检测下降沿
ftAuto[2](CLK:=stSenser.biTabHave , Q=> );//极耳检测下降沿			
	//假设黄标感应器在第一片与第二片之间	
	IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=0 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<=260 AND arrAxisCtrl[VirAxisNo.VirMain].Status.Moving THEN
		IF NOT bLugActPosMark_f THEN		
			IF rtAuto[11].Q THEN
				fLugActPos:=arrAxisCtrl[AxisNo.DriverDDR].Status.fActPos;//极耳位置记录---------------P1
				bLugActPosMark_r:=TRUE;//上升沿极耳位置已记录标志位
			END_IF			
		END_IF
		IF NOT  bLugActPosMark_r THEN
			IF ftAuto[2].Q THEN
				fLugActPos:=arrAxisCtrl[AxisNo.DriverDDR].Status.fActPos-50;//极耳位置记录-----------------P1
				bLugActPosMark_f:=TRUE;//下降沿极耳位置已记录标志位
			END_IF
		END_IF
	//黄标位置记录
		IF 	rtAuto[10].Q  THEN//----黄标只取上升沿
			bYellowActPosMark:=TRUE;//黄标位置已记录标志位
			fYellowMarkActPos:=arrAxisCtrl[AxisNo.DriverDDR].Status.fActPos;//黄标位置记录	------------P2
		END_IF
	ELSIF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>270 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<300 THEN//-----------数据移位已经完成			
		IF bYellowActPosMark AND ( bLugActPosMark_r OR bLugActPosMark_f)  THEN//------------黄标有感应到，极耳有感应到		
			rYellowPosRel:=fYellowMarkActPos-fLugActPos;//黄标感应器相对于极耳位置的差-----------------------S黄标
			rYellowJumpPos1:=PolePar.fCutBreadth-PolePar.fYellowBreadth;//黄标跳切区间判断位置1-------------S1
			rYellowJumpPos2:=PolePar.fCutBreadth+PolePar.fYellowBreadth;//黄标跳切区间判断位置2------------S2							
			IF rYellowPosRel<0 THEN//黄标在极耳左侧---不跳切						
				bYellowMark[2]:=TRUE;//---------黄标在2#片
			ELSE//黄标在极耳右侧
				IF rYellowPosRel<rYellowJumpPos1 THEN//------------------------不跳切
					bYellowMark[2]:=TRUE;	//-------------黄标在2#片
				ELSIF rYellowPosRel>rYellowJumpPos2 THEN//---------------------不跳切
					bYellowMark[1]:=TRUE;	//-------------黄标在1#片
				ELSE//--------------黄标在极片1和极片2切刀位置
					bYellowMark[1]:=TRUE;	//-------------黄标在1#片		
					bYellowMark[2]:=TRUE;//	-------------黄标在2#片		
				END_IF
			END_IF
		ELSIF  bYellowActPosMark AND NOT bLugActPosMark_r AND NOT bLugActPosMark_f THEN //--------------黄标有感应到，极耳没有感应到
			bYellowMark[1]:=TRUE;	//-------------黄标在1#片		
			bYellowMark[2]:=TRUE;	//-------------黄标在2#片		
		ELSIF NOT bYellowActPosMark AND ( bLugActPosMark_r OR bLugActPosMark_f ) THEN//-------------------极耳有感应到，黄标没感应到，，正常片
			bLugActPosMark_r:=FALSE;//上升沿极耳位置已记录标志位
			bLugActPosMark_f:=FALSE;//下降沿极耳位置已记录标志位
			bYellowActPosMark:=FALSE;//黄标位置已记录标志位
			fLugActPos:=0;
			fYellowMarkActPos:=0;
			rYellowPosRel:=0;//黄标感应器相对于极耳位置的差
			rYellowJumpPos1:=0;//黄标跳切区间判断位置1
			rYellowJumpPos2:=0;//黄标跳切区间判断位置2
		ELSE//-----------黄标和极耳都没感应到
			bYellowMark[1]:=TRUE;	//-------------黄标在1#片		
			bYellowMark[2]:=TRUE;	//-------------黄标在2#片		
		END_IF
	ELSIF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>300 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<350 THEN//
		bLugActPosMark_r:=FALSE;//上升沿极耳位置已记录标志位
		bLugActPosMark_f:=FALSE;//下降沿极耳位置已记录标志位
		bYellowActPosMark:=FALSE;//黄标位置已记录标志位
		fLugActPos:=0;
		fYellowMarkActPos:=0;
		rYellowPosRel:=0;//黄标感应器相对于极耳位置的差
		rYellowJumpPos1:=0;//黄标跳切区间判断位置1
		rYellowJumpPos2:=0;//黄标跳切区间判断位置2
	END_IF
		
		
		
		
		
		
		

(*
//////////////裁切前黄标检测//////////-------------------原版
IF arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos>=0 AND arrAxisCtrl[VirAxisNo.VirMain].Status.fModuloActPos<260 AND
	arrAxisCtrl[VirAxisNo.VirMain].Status.Moving AND NOT stSenser.bYellowCheck_C  THEN
	YellowmarkNG[1]:=0;//裁切前黄标NG
END_IF
*)




