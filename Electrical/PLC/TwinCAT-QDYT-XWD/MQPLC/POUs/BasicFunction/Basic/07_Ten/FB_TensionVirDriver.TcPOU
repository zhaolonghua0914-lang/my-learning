<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_TensionVirDriver" Id="{d283f433-7760-40c6-8e51-01893a53724e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TensionVirDriver  //放卷虚轴张力联动
VAR_INPUT
	bReset			       :BOOL;	   
    PidSwitch              :BOOL;	
	fActBufferPos        :REAL;

	fBufferrMinPos	    :REAL;	
	fBufferMaxPos	    :REAL;	
	fBufferBlancePos	:REAL;	
	//fVirMainSpeed       :REAL;
	fWith                   :REAL;
END_VAR

VAR_OUTPUT
	bReady              :BOOL;  
	bTensionOK		 	:BOOL;	
	bError				:BOOL;	
          
END_VAR
VAR_IN_OUT
	virMain		       :axis_ref;		
	TimerAxis	       :axis_ref;	
    Slave		           :axis_ref;		
	bTenExecute		:BOOL;	
END_VAR


VAR


	bAxisError:BOOL;
	rtEnable		:R_TRIG;  
	ftEnable		:F_TRIG;

	TON02: TON;

	rTRIG100: R_TRIG;
	iTensionStep:UINT;


	fbGearOut						:MC_GearOut;		//Unwind
	//fbMoveTimer: MC_MoveVelocity;
	fRatio1: LREAL;
	fRatio2: LREAL;

	fKp2: LREAL;(*乘数系数*)
	Ti: LREAL;
	fbStop: MC_Stop; // Unwind
	bPosLimitError			:BOOL;		
	bNegLimitError			:BOOL;		

	fCalcDancerPos1: REAL;
	fCalcDancerPos2: REAL;

	Delay1,Delay2: TON;
	//bMoveTimer: BOOL;
//	fbhaltTimer: MC_Halt;//TimerAxis


	bFunBlokError: BOOL;

	fMasterLinerSpeed: REAL;
	TM: REAL;
	TM_old: REAL;
	fbGearDync :MC_GearInMultiMaster;
	
	iFlgStart: INT;
	
	bsaveArea: BOOL;
	fTRMax:Tc2_Standard.R_TRIG;
	fTRMin:Tc2_Standard.R_TRIG;
	fTRReset:Tc2_Standard.R_TRIG;	
	bFlgMoveTime:BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TON02(IN:= , PT:=T#10MS , Q=> , ET=> );

fCalcDancerPos1:=fBufferrMinPos+10;	
fCalcDancerPos2:=fBufferMaxPos-10;

rtEnable(CLK:=bTenExecute , Q=> );        
ftEnable(CLK:=bTenExecute , Q=> );    

bReady:= NOT bAxisError AND NOT bError 
         AND virMain.Status.NotMoving AND TimerAxis.Status.NotMoving AND NOT Slave.Status.Coupled AND Slave.Status.NotMoving
         AND virMain.Status.ControlLoopClosed AND TimerAxis.Status.ControlLoopClosed   AND Slave.Status.ControlLoopClosed ;
		   
IF rtEnable.Q AND bReady THEN
	  iFlgStart:=1;
	  iTensionStep:=100;
ELSIF rtEnable.Q AND NOT bReady THEN	 
   	  bTenExecute:=FALSE;			
ELSIF  ftEnable.Q THEN
     iFlgStart:=2;
     iTensionStep:=100;
END_IF

CASE iTensionStep OF
0:
	fbGearOut.Execute:=FALSE;
	fbStop.Execute:=FALSE;
	bTensionOK:=FALSE;
	TON02.IN:=FALSE;
     iTensionStep:=1;  
1:
  IF bTenExecute AND bReady THEN
    	iTensionStep:=120;  
  END_IF
  IF ftEnable.Q THEN
    	iTensionStep:=630; 
  END_IF


120:  
	 fbGearDync.Enable:=TRUE;    //开启耦合
	 iTensionStep:=550;  
550:
	IF  Slave.Status.Coupled  THEN
		IF   (fActBufferPos<fCalcDancerPos2 AND fActBufferPos>fCalcDancerPos1)    AND PidSwitch    THEN
			bTensionOK:=TRUE;
			iTensionStep:=600;
           ELSIF NOT PidSwitch THEN
			bTensionOK:=TRUE;
			iTensionStep:=600;
		END_IF
	ELSIF fbGearDync.Error OR fbGearDync.CommandAborted   THEN
		  iTensionStep:=630;
	END_IF
(******************************  进入平衡运行阶段   *************************************)
600:
	IF bPosLimitError OR bNegLimitError OR (NOT bTenExecute)  OR bAxisError OR TimerAxis.Status.NotMoving OR NOT Slave.Status.Coupled THEN  
	  TON02.IN:=TRUE;
    ELSIF  ( NOT bTenExecute  OR bAxisError  OR  NOT Slave.Status.Coupled ) AND  NOT  PidSwitch     THEN 
       TON02.IN:=TRUE;
	END_IF
	
	IF TON02.Q THEN   
		IF bPosLimitError  OR  bNegLimitError  OR  bAxisError    THEN
		   bError:=TRUE; 
		END_IF
	    iTensionStep:=630;
	    TON02.IN:=FALSE; 	
	END_IF
	

(******************************  解耦*************************************)
630:
     fbGearDync.Enable:=FALSE;    //开启耦合
     iTensionStep:=635;	
635:
	IF Slave.Status.Coupled THEN
		fbGearOut.Execute:=TRUE;
		iTensionStep:=700;
	ELSE
		iTensionStep:=700;	
	END_IF
700:
	IF NOT Slave.Status.Coupled THEN
		bTensionOK:=FALSE;
		fbStop.Execute:=TRUE;   
		iTensionStep:=750;	
	END_IF
750:
	IF Slave.Status.NotMoving    THEN  
	   fbStop.Execute:=FALSE;
	   iTensionStep:=0;  
	END_IF			
END_CASE



(*********************************** 耦合  *********************************************)
fTRMax(CLK:= fActBufferPos>=  (fBufferBlancePos+fWith/2)   AND bTensionOK , Q=> );  //正极限调节
fTRMin(CLK:= fActBufferPos<=   (fBufferBlancePos-fWith/2)     AND bTensionOK, Q=> );  //负限调节
fTRReset(CLK:= fActBufferPos>=fBufferBlancePos-20 AND fActBufferPos<=fBufferBlancePos+20, Q=> ); //
IF fTRMax.Q OR fTRMin.Q THEN
	bFlgMoveTime:=TRUE;
END_IF
IF fTRReset.Q THEN
	bFlgMoveTime:=FALSE;
END_IF


TM:=2;
fRatio1:=1;//*0.99230769
//fKp2:=SEL(bFlgMoveTime,0,(( fActBufferPos-fBufferBlancePos )*720 ) / (pi*fDriveDiameter*100*TM));//bFlgMoveTime
fKp2:=SEL(bFlgMoveTime,0,(( fActBufferPos-fBufferBlancePos )*720 ) / (fWith*100*TM));
fRatio2:=fKp2;
	

bAxisError:= Slave.Status.Error OR  virMain.Status.Error OR  TimerAxis.Status.Error ;//
bFunBlokError:=fbGearDync.Error OR fbGearOut.Error OR fbStop.Error   ;
rTRIG100(CLK:=bFunBlokError , Q=> );
IF rTRIG100.Q THEN
	bError:=TRUE;
	bTensionOK:=FALSE;
END_IF			
	
IF  bReset AND iTensionStep<>600  AND bError   THEN   //复位处理
    bError:=FALSE;
	iTensionStep:=630;
END_IF

(************************************  张力出错和取消的处理  ******************************************************)
Delay1(IN:=fActBufferPos>fBufferMaxPos AND bTensionOK , PT:=T#300MS , Q=> , ET=> );
bPosLimitError:=Delay1.Q;
Delay2(IN:=fActBufferPos<fBufferrMinPos AND bTensionOK , PT:=T#300MS , Q=> , ET=> );
bNegLimitError:=Delay2.Q;

Motion();






]]></ST>
    </Implementation>
    <Action Name="Motion" Id="{8bf07613-2adf-4f02-a977-fed5a2d3bda7}">
