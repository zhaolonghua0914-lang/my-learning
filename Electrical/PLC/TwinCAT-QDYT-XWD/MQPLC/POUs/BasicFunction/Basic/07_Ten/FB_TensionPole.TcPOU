<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_TensionPole" Id="{789ea768-0a43-47f8-80dd-ca5bf5494cba}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TensionPole  //只和Tim轴联动    学习放卷与摆杆的角度即可   张力使能直接开

VAR_INPUT
	bReset			           :BOOL;	 //复位       
	bCcw		                   :BOOL;	//放卷电机方向选择    
    fDanserDegree         :REAL;//摆杆实时位置
  
    fActTorque               :REAL; //当前力矩值
    fSetTorque               :REAL; //设定力矩值
	
    PidSwitch                    :BOOL;	   //PID功能选择
   

   	fStudyDiameter          :REAL;  //摆杆学习时放卷轴卷径   人工HMI输入
	
	fDriveDiameter	        :REAL:=80;//驱动实轴直径	计算卷径时使用
    fPoleWith                   :REAL;//片宽     下个周期主驱补偿，片宽变化，放卷也应相应变化才对。
 	fCompensation                          :REAL;//主驱补偿值
	fDancerMinPos	:REAL;	//摆杆最小值
	fDancerMaxPos	:REAL;	//摆杆最大值
	fDanceBlancePos	:REAL;	//摆杆平衡值
	bStudyExecute                      :BOOL;       //摆杆学习使能	
END_VAR

VAR_OUTPUT
	bReady                 :BOOL;  
	bTensionOK		 	:BOOL;	

	bError			   	:BOOL;		                          
END_VAR


VAR_IN_OUT
	VirMain         :axis_ref;	//虚拟主轴	   
	Master	     	:axis_ref;	//驱动放卷虚拟轴	   
    Slave		        :axis_ref;  //放卷实轴
	Driver		    :axis_ref; //驱动实轴
	TimerAxis	    :axis_ref;	// 摆杆张力放卷虚拟轴  
	TensionAxis   :axis_ref;  //张力轴

   	bTenExecute		        :BOOL;	//张力使能
	Table		    :ARRAY[0..105,1..2]OF REAL;	
END_VAR

VAR
	iFlgwind :INT;
    fWindDiameter         :REAL;//放卷轴实时卷径AI
	
	
	
	bAxisError:BOOL;
	rtEnable		:R_TRIG;  
	ftEnable		:F_TRIG;

	TON02: TON;
	
	rTRIG100: R_TRIG;
	iTensionStep:UINT;
	fCcw: REAL;	(*选择放卷方向后*)
	fbGearOut						:MC_GearOut;		//Unwind

	fRatio1: LREAL;
	fRatio2: LREAL;

	fbJogUnwind: MC_Jog;    //Unwind

	fKp2: LREAL;(*乘数系数*)
	Ti: LREAL;
	fbHalt: MC_Halt; // Unwind
    fbHaltTensionAxis: MC_Halt; // Unwind        
	
	
	bPosLimitError			:BOOL;		
	bNegLimitError			:BOOL;		
	bTorqueError			:BOOL;	
	bTenOKTimeError			:BOOL;
	
	fCalcDancerPos1: REAL;
	fCalcDancerPos2: REAL;


	Delay1,Delay2: TON;
	Delay3:            TON;
	Delay4:            TON;
	rtStudy	   :R_TRIG;
	ftStudy	   :F_TRIG;


	bStudyFinish: BOOL; 
	studyStage: INT;
	ad_Set_test: REAL;
	struckstudying: BOOL;
	structTime: INT;
	// 学习计数
	structPrinter: INT;
	structAcc: REAL;
	structAxisPosPast: LREAL;
	structAxisPosNow: LREAL;
	gear: REAL := 1;
	iwindJog: INT;// 1收卷  2放卷 3停止

	DA1: REAL;
	DA2: INT;
	DA3: INT;

	bFunBlokError: BOOL;

	fMasterLinerSpeed: REAL;
	TM: REAL:=1;
	TM_old: REAL;
	fbGearDync :MC_GearInMultiMaster;
	iFlgStart: INT;

	DelayDiaMeter:TON;
	RDiaMeter  :R_TRIG;
	RDiaMeter2  :R_TRIG;
    tonDiaMeter  :Tc2_Standard.TON;

	_fUwPos1,_fUwPos2,_fUwPos3	:LREAL;
	_fDancerPos1,_fDancerPos2,_fDancerPos3	:LREAL;
	_fDrivePos1,_fDrivePos2,_fDrivePos3	:LREAL;
    iUnwindStartPos: LREAL;
	iUnwindOldTurns: DINT;
	fDeltaUwPos1,_fDeltaUwPos1	:LREAL;
	fDeltaDrivePos1,_fDeltaDrivePos1	:LREAL;
	fDeltaDancerPos1,_fDeltaDancerPos1:LREAL;
	iUnwindStartTurns: DINT;


	fDiameterCalculate: LREAL;//放卷轴采样卷径
	fWindDiameterTemp: REAL;//放卷轴卷径-采用
	fWindFirstPos: LREAL;
	fWindLengh: LREAL;
	rtrigs		:ARRAY[1..3]OF R_TRIG;
	fFlgCalculateOnce: BOOL;
	fPos1Length: REAL;
	fPos2Length: REAL;
	fWindPos1Deg: REAL;
	fWindPos2Deg: REAL;
	fDanceBlancePosTemp: REAL;
	bFlgDiameterCalculate: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[

TON02(IN:= , PT:=T#10MS , Q=> , ET=> );

Study();
fCcw:=SEL(bCcw,1,-1);	

//fCalcDancerPos1:=0.75*fDancerMinPos+0.25*fDanceBlancePos;	
fCalcDancerPos1:=fDancerMinPos+5;	
//fCalcDancerPos2:=0.75*fDancerMaxPos+0.25*fDanceBlancePos;	
//fCalcDancerPos2:=0.65*fDancerMaxPos+0.25*fDanceBlancePos;	
fCalcDancerPos2:=fDancerMaxPos-20;
rtEnable(CLK:=bTenExecute , Q=> );        
ftEnable(CLK:=bTenExecute , Q=> );    
rtrigs	[1](CLK:=VirMain.Status.Moving AND  VirMain.NcToPlc.ModuloActPos>=355 AND VirMain.NcToPlc.ModuloActPos<360 OR rtEnable.Q AND VirMain.Status.NotMoving , Q=> ); 

bReady:= NOT bAxisError  AND NOT bError AND  iTensionStep=1 AND NOT bFunBlokError  
               AND Master.Status.NotMoving AND TimerAxis.Status.Moving  AND NOT Slave.Status.Coupled  AND Slave.Status.NotMoving
               AND Master.Status.ControlLoopClosed AND TimerAxis.Status.ControlLoopClosed   AND Slave.Status.ControlLoopClosed  AND 
               TimerAxis.Status.ConstantVelocity  AND 
                 ABS(fActTorque -fSetTorque )<10   ;
 
 fWindDiameter:= LIMIT(250,fWindDiameter,800);  //模糊卷径
				 			 
CASE iTensionStep OF
0:
    fbJogUnwind.Velocity:=15;
    fbGearDync.Enable:=FALSE;
	fbGearOut.Execute:=FALSE;
	fbHalt.Execute:=FALSE;
   fbHaltTensionAxis.Execute:=FALSE;    //停止张力轴
    iwindJog:=3;
	bTensionOK:=FALSE;
	TON02.IN:=FALSE;
    iTensionStep:=1;  
1:
  IF bTenExecute AND bReady THEN
    	iTensionStep:=120;  
  END_IF
  IF ftEnable.Q THEN
    	iTensionStep:=630; 
  END_IF
 
120:  //低位
     TM:=3;
	 fPos1Length:=0;
	 fPos2Length:=0;	 
	 fWindPos1Deg:=0;
	 fWindPos2Deg:=0;
     fDanceBlancePosTemp:=fCalcDancerPos1;
	 iTensionStep:=130;  		
130:  	
	 fbGearDync.Enable:=TRUE;    //开启耦合
     fWindFirstPos:=Slave.NcToPlc.ActPos;
	 iTensionStep:=140;  
140:  
	IF  Slave.Status.Coupled  AND bTenExecute AND NOT fbGearDync.Error AND NOT fbGearDync.CommandAborted   AND NOT bTenOKTimeError AND NOT  bTorqueError THEN
		IF   (fDanserDegree<fCalcDancerPos1+6  AND fDanserDegree>fCalcDancerPos1-6)     THEN
		     fPos1Length:=f_Length2(Table:=Table,X:=fDanserDegree);
			 fWindPos1Deg:=Slave.NcToPlc.ActPos;
		     iTensionStep:=200;
		END_IF	
	ELSIF fbGearDync.Error OR fbGearDync.CommandAborted   OR bTenOKTimeError OR  bTorqueError OR NOT bTenExecute     THEN
		  iTensionStep:=630;
	END_IF

      fWindLengh:= ABS( FC_AngleToLength(Slave.NcToPlc.ActPos,fWindDiameterTemp)- FC_AngleToLength(fWindFirstPos,fWindDiameterTemp) );
      IF fWindLengh>800 THEN
          bError:=TRUE;
          iTensionStep:=630;
     END_IF	 
	 
	 
	 
	200: 
	      fDanceBlancePosTemp:=fCalcDancerPos2;
	       iTensionStep:=210;  		
	210: 	 
	 IF  Slave.Status.Coupled  AND bTenExecute AND NOT fbGearDync.Error AND NOT fbGearDync.CommandAborted   AND NOT bTenOKTimeError AND NOT  bTorqueError THEN
		IF   (fDanserDegree<fCalcDancerPos2+6  AND fDanserDegree>fCalcDancerPos2-6)     THEN
		     fPos2Length:=f_Length2(Table:=Table,X:=fDanserDegree);
			 fWindPos2Deg:=Slave.NcToPlc.ActPos;
		     iTensionStep:=300;
		END_IF	
	ELSIF fbGearDync.Error OR fbGearDync.CommandAborted   OR bTenOKTimeError OR  bTorqueError OR NOT bTenExecute     THEN
		  iTensionStep:=630;
	END_IF
	 
	   fWindLengh:= ABS( FC_AngleToLength(Slave.NcToPlc.ActPos,fWindDiameterTemp)- FC_AngleToLength(fWindFirstPos,fWindDiameterTemp) );
      IF fWindLengh>800 THEN
          bError:=TRUE;
          iTensionStep:=630;
     END_IF	 
	 
 300:
       fWindDiameter:= ABS(   (fPos2Length-fPos1Length)*360 /  ( (fWindPos2Deg-fWindPos1Deg)*Tc2_System.PI )  ) ;
	 	fDanceBlancePosTemp:=fDanceBlancePos;
		 TM:=1;
	    iTensionStep:=550;  		
	 
550:

	IF  Slave.Status.Coupled  AND bTenExecute AND NOT fbGearDync.Error AND NOT fbGearDync.CommandAborted   AND NOT bTenOKTimeError AND NOT  bTorqueError THEN
		IF   (fDanserDegree<fDanceBlancePos+5  AND fDanserDegree>fDanceBlancePos-5)  AND PidSwitch   THEN
			bTensionOK:=TRUE;
			iTensionStep:=600;
        ELSIF NOT PidSwitch THEN
			bTensionOK:=TRUE;
			iTensionStep:=600;
		END_IF
	ELSIF fbGearDync.Error OR fbGearDync.CommandAborted   OR bTenOKTimeError OR  bTorqueError OR NOT bTenExecute     THEN
		  iTensionStep:=630;
	END_IF

	
      fWindLengh:= ABS( FC_AngleToLength(Slave.NcToPlc.ActPos,fWindDiameterTemp)- FC_AngleToLength(fWindFirstPos,fWindDiameterTemp) );
      IF fWindLengh>800 THEN
          bError:=TRUE;
          iTensionStep:=630;
     END_IF

(******************************  进入平衡运行阶段   *************************************)
600:
	IF ( bPosLimitError OR bNegLimitError OR  bTorqueError   OR bTenOKTimeError OR   (NOT bTenExecute)  OR bAxisError 
        OR TimerAxis.Status.NotMoving  ) AND PidSwitch     THEN  
	    TON02.IN:=TRUE;
    ELSIF  ( NOT bTenExecute  OR bAxisError  ) AND  NOT  PidSwitch     THEN 
       TON02.IN:=TRUE;
	END_IF
	
	IF TON02.Q THEN   
		IF ( bPosLimitError  OR bNegLimitError OR  bTorqueError  OR  bAxisError OR bFunBlokError OR bTenOKTimeError ) AND   PidSwitch   THEN
		   bError:=TRUE;
       ELSIF   (  bAxisError OR bFunBlokError  ) AND  NOT  PidSwitch     THEN
            bError:=TRUE;
		END_IF
	    iTensionStep:=630;
	    TON02.IN:=FALSE; 	
	END_IF
	
(******************************  解耦*************************************)
630:
     fbGearDync.Enable:=FALSE;    //开启耦合
	 bTenExecute:=FALSE;
     iTensionStep:=640;	
640:
     IF   NOT  fbGearDync.InGear  THEN
         iTensionStep:=650;	
     END_IF
650:
	IF Slave.Status.Coupled THEN
		fbGearOut.Execute:=TRUE;
		iTensionStep:=700;
	ELSE
		iTensionStep:=700;	
	END_IF
700:
	IF NOT Slave.Status.Coupled   THEN
        fbGearOut.Execute:=FALSE;
		bTensionOK:=FALSE;
		bFlgDiameterCalculate:=FALSE;
		fbHalt.Execute:=TRUE;   
		iTensionStep:=750;	
	END_IF
750:
	IF Slave.Status.NotMoving  THEN  
	   iTensionStep:=800;  //0
	END_IF		

800:
  IF NOT bTorqueError THEN  
	      iTensionStep:=0;  
 ELSE
	    fbHaltTensionAxis.Execute:=FALSE;    //停止张力轴
		 iTensionStep:=810;  //0
  END_IF
810:
       iTensionStep:=0;  //0
END_CASE

(*********************************** 耦合  *********************************************)
  // TM:=0.012*ABS(  f_Length2(Table:=Table,X:=fDanserDegree)-f_Length2(Table:=Table,X:=fDanceBlancePos))+0.4;
  
      IF  NOT  bFlgDiameterCalculate   THEN    //ABS(fWindDiameter-fDiameterCalculate)>=25
           fWindDiameterTemp:=fWindDiameter;
      ELSE
          fWindDiameterTemp:=fDiameterCalculate;
     END_IF

 // fWindDiameterTemp:=fWindDiameter;

//fRatio1:=fCcw*fDriveDiameter/fWindDiameterTemp;
IF fWindDiameterTemp<>0 THEN
	IF rtrigs	[1].Q THEN
		fRatio1:=fCcw*(fPoleWith+fCompensation)/(fWindDiameterTemp*Tc2_System.PI);     
	END_IF                   
	Ti:=1;
		fKp2:=(( f_Length2(Table:=Table,X:=fDanserDegree)-f_Length2(Table:=Table,X:=fDanceBlancePosTemp) )*360 ) / (Tc2_System.PI*fWindDiameterTemp*100*TM);
	IF ABS(fKp2)>0.005 THEN		
		fRatio2:=SEL(PidSwitch,0, fCcw*fKp2) ;
	ELSE
		fRatio2:=SEL(PidSwitch,0, 0) ;
	END_IF
END_IF

(********************************* 初始卷 后 循环更新半径  *********************************************)
DelayDiaMeter(IN:= bTensionOK, PT:=T#2S , Q=> , ET=> );
RDiaMeter(CLK:=DelayDiaMeter.Q , Q=> );
IF RDiaMeter.Q THEN
	_fDrivePos1:=Driver.NcToPlc.ActPos;		//驱动辊位置锁存
	_fUwPos1:=   Slave.NcToPlc.ActPos;        //放卷位置所存
   _fDancerPos1:=fDanserDegree;              //摆杆位置锁存

   iUnwindStartPos:= Slave.NcToPlc.ActPos;
   iUnwindOldTurns:=10;
END_IF

	IF  DelayDiaMeter.Q THEN  
        iUnwindStartTurns:=  ABS(  LREAL_TO_DINT ( (  FC_AngleToLength( Driver.NcToPlc.ActPos,fDriveDiameter)  - FC_AngleToLength( _fDrivePos1,fDriveDiameter) )/100 )  ) ;  
        //tonDiaMeter(IN:= ABS( Driver.NcToPlc.SetVelo)<0.2 , PT:=T#100MS , Q=> , ET=> );

		IF iUnwindStartTurns>=iUnwindOldTurns  AND  VirMain.NcToPlc.ModuloSetPos>=352   AND  VirMain.NcToPlc.ModuloSetPos<=360  THEN  //   计算一次卷径
			_fDeltaDrivePos1:=ABS(Driver.NcToPlc.ActPos-_fDrivePos1);
			_fDeltaUwPos1:=ABS(Slave.NcToPlc.ActPos-_fUwPos1);
			_fDeltaDancerPos1:=fDanserDegree;
            DA1:=     f_Length2(Table:=Table,X:=_fDeltaDancerPos1)-f_Length2(Table:=Table,X:=_fDancerPos1) ;
			IF _fDeltaUwPos1<>0 THEN
          			 fDiameterCalculate:= ( FC_AngleToLength(_fDeltaDrivePos1,fDriveDiameter)- ( f_Length2(Table:=Table,X:=_fDeltaDancerPos1)-f_Length2(Table:=Table,X:=_fDancerPos1))  ) *360/ (PI*_fDeltaUwPos1) ;
		   	END_IF
            // fDiameterCalculate:= ( FC_AngleToLength(_fDeltaDrivePos1,fDriveDiameter)  ) *360/ (PI*_fDeltaUwPos1) ;
			_fDrivePos1:=Driver.NcToPlc.ActPos;		
			_fUwPos1:=Slave.NcToPlc.ActPos;
			_fDancerPos1:=fDanserDegree;
			iUnwindOldTurns:=10;
			bFlgDiameterCalculate:=TRUE;
		END_IF
		
	END_IF


(***********************************错误报警*********************************************)	
bAxisError:=      Slave.Status.Error OR  Master.Status.Error OR  TimerAxis.Status.Error ;
bFunBlokError:=fbGearDync.Error OR fbGearOut.Error OR fbHalt.Error OR fbJogUnwind.Error  ;
			
IF  bReset AND iTensionStep<>600  AND bError   THEN   //复位处理
    bError:=FALSE;
	iTensionStep:=630;
END_IF

(************************************  张力出错和取消的处理  ******************************************************)
Delay1(IN:=fDanserDegree>fDancerMaxPos AND bTensionOK , PT:=T#300MS , Q=> , ET=> );
bPosLimitError:=Delay1.Q;
Delay2(IN:=fDanserDegree<fDancerMinPos AND bTensionOK , PT:=T#300MS , Q=> , ET=> );
bNegLimitError:=Delay2.Q;
Delay3(IN:=( ABS(fActTorque -fSetTorque )>=10 OR  fDanserDegree> fDancerMaxPos+35 OR  fDanserDegree< fDancerMinPos-35)   AND   bTensionOK , PT:=T#300MS , Q=> , ET=> );
bTorqueError:=Delay3.Q;
Delay4(IN:=( iTensionStep=550 OR  iTensionStep=600 ) AND  Master.Status.NotMoving   AND (fDanserDegree>fDanceBlancePos+20  OR fDanserDegree<fDanceBlancePos-20)  AND ABS(fRatio2)>0.005 AND PidSwitch , PT:=T#5S , Q=> , ET=> );
bTenOKTimeError:=Delay4.Q;

Jog();
Motion();
TM_old:=TM;






(*
TON02(IN:= , PT:=T#10MS , Q=> , ET=> );

Study();
fCcw:=SEL(bCcw,1,-1);	

fCalcDancerPos1:=0.75*fDancerMinPos+0.25*fDanceBlancePos;	
fCalcDancerPos2:=0.75*fDancerMaxPos+0.25*fDanceBlancePos;	

rtEnable(CLK:=bTenExecute , Q=> );        
ftEnable(CLK:=bTenExecute , Q=> );    
rtrigs	[1](CLK:=VirMain.Status.Moving AND  VirMain.NcToPlc.ModuloActPos>=355 AND VirMain.NcToPlc.ModuloActPos<360 OR rtEnable.Q AND VirMain.Status.NotMoving , Q=> ); 

bReady:= NOT bAxisError  AND NOT bError AND  iTensionStep=1 AND NOT bFunBlokError  
               AND Master.Status.NotMoving AND TimerAxis.Status.Moving  AND NOT Slave.Status.Coupled  AND Slave.Status.NotMoving
               AND Master.Status.ControlLoopClosed AND TimerAxis.Status.ControlLoopClosed   AND Slave.Status.ControlLoopClosed  AND 
               TimerAxis.Status.ConstantVelocity  AND 
                 ABS(fActTorque -fSetTorque )<10   ;
 
CASE iTensionStep OF
0:
    fbJogUnwind.Velocity:=15;
    fbGearDync.Enable:=FALSE;
	fbGearOut.Execute:=FALSE;
	fbHalt.Execute:=FALSE;
   fbHaltTensionAxis.Execute:=FALSE;    //停止张力轴
    iwindJog:=3;
	bTensionOK:=FALSE;
	TON02.IN:=FALSE;
    iTensionStep:=1;  
1:
  IF bTenExecute AND bReady THEN
    	iTensionStep:=120;  
  END_IF
  IF ftEnable.Q THEN
    	iTensionStep:=630; 
  END_IF
 
120:  
	 fbGearDync.Enable:=TRUE;    //开启耦合
     fWindFirstPos:=Slave.NcToPlc.ActPos;
	 iTensionStep:=550;  
550:

	IF  Slave.Status.Coupled  AND bTenExecute AND NOT fbGearDync.Error AND NOT fbGearDync.CommandAborted   AND NOT bTenOKTimeError AND NOT  bTorqueError THEN
		IF   (fDanserDegree<fDanceBlancePos+5  AND fDanserDegree>fDanceBlancePos-5)  AND PidSwitch   THEN
			bTensionOK:=TRUE;
			iTensionStep:=600;
        ELSIF NOT PidSwitch THEN
			bTensionOK:=TRUE;
			iTensionStep:=600;
		END_IF
	ELSIF fbGearDync.Error OR fbGearDync.CommandAborted   OR bTenOKTimeError OR  bTorqueError OR NOT bTenExecute     THEN
		  iTensionStep:=630;
	END_IF

      fWindLengh:= ABS( FC_AngleToLength(Slave.NcToPlc.ActPos,fWindDiameterTemp)- FC_AngleToLength(fWindFirstPos,fWindDiameterTemp) );
      IF fWindLengh>800 THEN
          bError:=TRUE;
          iTensionStep:=630;
     END_IF

(******************************  进入平衡运行阶段   *************************************)
600:
	IF ( bPosLimitError OR bNegLimitError OR  bTorqueError   OR bTenOKTimeError OR   (NOT bTenExecute)  OR bAxisError 
        OR TimerAxis.Status.NotMoving  ) AND PidSwitch     THEN  
	    TON02.IN:=TRUE;
    ELSIF  ( NOT bTenExecute  OR bAxisError  ) AND  NOT  PidSwitch     THEN 
       TON02.IN:=TRUE;
	END_IF
	
	IF TON02.Q THEN   
		IF ( bPosLimitError  OR bNegLimitError OR  bTorqueError  OR  bAxisError OR bFunBlokError OR bTenOKTimeError ) AND   PidSwitch   THEN
		   bError:=TRUE;
       ELSIF   (  bAxisError OR bFunBlokError  ) AND  NOT  PidSwitch     THEN
            bError:=TRUE;
		END_IF
	    iTensionStep:=630;
	    TON02.IN:=FALSE; 	
	END_IF
	
(******************************  解耦*************************************)
630:
     fbGearDync.Enable:=FALSE;    //开启耦合
	 bTenExecute:=FALSE;
     iTensionStep:=640;	
640:
     IF   NOT  fbGearDync.InGear  THEN
         iTensionStep:=650;	
     END_IF
650:
	IF Slave.Status.Coupled THEN
		fbGearOut.Execute:=TRUE;
		iTensionStep:=700;
	ELSE
		iTensionStep:=700;	
	END_IF
700:
	IF NOT Slave.Status.Coupled   THEN
        fbGearOut.Execute:=FALSE;
		bTensionOK:=FALSE;
		fFlgCalculateOnce:=FALSE;
		fbHalt.Execute:=TRUE;   
		iTensionStep:=750;	
	END_IF
750:
	IF Slave.Status.NotMoving  THEN  
	   iTensionStep:=800;  //0
	END_IF		

800:
  IF NOT bTorqueError THEN  
	      iTensionStep:=0;  
 ELSE
	    fbHaltTensionAxis.Execute:=FALSE;    //停止张力轴
		 iTensionStep:=810;  //0
  END_IF
810:
       iTensionStep:=0;  //0
END_CASE

(*********************************** 耦合  *********************************************)
  // TM:=0.012*ABS(  f_Length2(Table:=Table,X:=fDanserDegree)-f_Length2(Table:=Table,X:=fDanceBlancePos))+0.4;
TM:=1;
      IF NOT fFlgCalculateOnce THEN  //        ABS(fWindDiameter-fDiameterCalculate)>=80
           fWindDiameterTemp:=fWindDiameter;
      ELSE
          fWindDiameterTemp:=fDiameterCalculate;
     END_IF

 // fWindDiameterTemp:=fWindDiameter;

//fRatio1:=fCcw*fDriveDiameter/fWindDiameterTemp;
IF fWindDiameterTemp<>0 THEN
	IF rtrigs	[1].Q THEN
		fRatio1:=fCcw*(fPoleWith+fCompensation)/(fWindDiameterTemp*Tc2_System.PI);     
	END_IF                   
	Ti:=1;
		fKp2:=(( f_Length2(Table:=Table,X:=fDanserDegree)-f_Length2(Table:=Table,X:=fDanceBlancePos) )*360 ) / (Tc2_System.PI*fWindDiameterTemp*100*TM);
	IF ABS(fKp2)>0.005 THEN		
		fRatio2:=SEL(PidSwitch,0, fCcw*fKp2) ;
	ELSE
		fRatio2:=SEL(PidSwitch,0, 0) ;
	END_IF
END_IF

(********************************* 初始卷 后 循环更新半径  *********************************************)
DelayDiaMeter(IN:= bTensionOK, PT:=T#2S , Q=> , ET=> );
RDiaMeter(CLK:=DelayDiaMeter.Q , Q=> );
IF RDiaMeter.Q THEN
	_fDrivePos1:=Driver.NcToPlc.ActPos;		//驱动辊位置锁存
	_fUwPos1:=   Slave.NcToPlc.ActPos;        //放卷位置所存
   _fDancerPos1:=fDanserDegree;              //摆杆位置锁存

   iUnwindStartPos:= Slave.NcToPlc.ActPos;
   iUnwindOldTurns:=10;
END_IF

	IF  DelayDiaMeter.Q THEN  
        iUnwindStartTurns:=  ABS(  LREAL_TO_DINT ( (  FC_AngleToLength( Driver.NcToPlc.ActPos,fDriveDiameter)  - FC_AngleToLength( _fDrivePos1,fDriveDiameter) )/fPoleWith )  ) ;  
      
		IF iUnwindStartTurns>=iUnwindOldTurns  AND  
             ABS( Driver.NcToPlc.SetVelo)<1  AND  VirMain.NcToPlc.ModuloActPos>=354 AND VirMain.NcToPlc.ModuloActPos<360    THEN  //   计算一次卷径
			_fDeltaDrivePos1:=ABS(Driver.NcToPlc.ActPos-_fDrivePos1);
			_fDeltaUwPos1:=ABS(Slave.NcToPlc.ActPos-_fUwPos1);
			_fDeltaDancerPos1:=fDanserDegree;
            DA1:=     f_Length2(Table:=Table,X:=_fDeltaDancerPos1)-f_Length2(Table:=Table,X:=_fDancerPos1) ;
			IF _fDeltaUwPos1<>0 THEN
          			 fDiameterCalculate:= ( FC_AngleToLength(_fDeltaDrivePos1,fDriveDiameter)- ( f_Length2(Table:=Table,X:=_fDeltaDancerPos1)-f_Length2(Table:=Table,X:=_fDancerPos1))  ) *360/ (PI*_fDeltaUwPos1) ;
		   	END_IF
            // fDiameterCalculate:= ( FC_AngleToLength(_fDeltaDrivePos1,fDriveDiameter)  ) *360/ (PI*_fDeltaUwPos1) ;
			_fDrivePos1:=Driver.NcToPlc.ActPos;		
			_fUwPos1:=Slave.NcToPlc.ActPos;
			_fDancerPos1:=fDanserDegree;
			iUnwindOldTurns:=10;
			fFlgCalculateOnce:=TRUE;
		END_IF
		
	END_IF

















(***********************************错误报警*********************************************)	
bAxisError:=      Slave.Status.Error OR  Master.Status.Error OR  TimerAxis.Status.Error ;
bFunBlokError:=fbGearDync.Error OR fbGearOut.Error OR fbHalt.Error OR fbJogUnwind.Error  ;
			
IF  bReset AND iTensionStep<>600  AND bError   THEN   //复位处理
    bError:=FALSE;
	iTensionStep:=630;
END_IF

(************************************  张力出错和取消的处理  ******************************************************)
Delay1(IN:=fDanserDegree>fDancerMaxPos AND bTensionOK , PT:=T#300MS , Q=> , ET=> );
bPosLimitError:=Delay1.Q;
Delay2(IN:=fDanserDegree<fDancerMinPos AND bTensionOK , PT:=T#300MS , Q=> , ET=> );
bNegLimitError:=Delay2.Q;
Delay3(IN:=( ABS(fActTorque -fSetTorque )>=10 OR  fDanserDegree> fDancerMaxPos+35 OR  fDanserDegree< fDancerMinPos-35)   AND   bTensionOK , PT:=T#300MS , Q=> , ET=> );
bTorqueError:=Delay3.Q;
Delay4(IN:=( iTensionStep=550 OR  iTensionStep=600 ) AND  Master.Status.NotMoving   AND (fDanserDegree>fDanceBlancePos+20  OR fDanserDegree<fDanceBlancePos-20)  AND ABS(fRatio2)>0.005 AND PidSwitch , PT:=T#5S , Q=> , ET=> );
bTenOKTimeError:=Delay4.Q;

Jog();
Motion();
TM_old:=TM;
*)


]]></ST>
    </Implementation>
    <Action Name="Jog" Id="{ec91ea09-c82f-42d6-9b0b-78c8f5e3bcfd}">
      <Implementation>
        <ST><![CDATA[
CASE   iwindJog   OF
1: //收卷
    iFlgwind:=1;
	IF NOT bCcw THEN
	   fbJogUnwind.Jogbackwards :=TRUE;
		fbJogUnwind.JogForward:=FALSE;
	ELSE
		fbJogUnwind.JogForward:=TRUE;
		fbJogUnwind.Jogbackwards :=FALSE;
	END_IF
	iwindJog:=0;
2: //放卷
 iFlgwind:=2;
	IF NOT bCcw THEN
		fbJogUnwind.JogForward :=TRUE;
		fbJogUnwind.Jogbackwards:=FALSE;
	ELSE
		fbJogUnwind.Jogbackwards:=TRUE;
		fbJogUnwind.JogForward :=FALSE;
	END_IF
	iwindJog:=0;
3: //停止
     iFlgwind:=0;
	fbJogUnwind.Jogbackwards :=FALSE;
    fbJogUnwind.JogForward:=FALSE;
	iwindJog:=0;
END_CASE






]]></ST>
      </Implementation>
    </Action>
