    </Action>
    <Action Name="Study" Id="{ec7d30a2-ab8a-4041-8502-6018c736cd08}">
      <Implementation>
        <ST><![CDATA[
rtStudy(CLK:=bStudyExecute, Q=> );
ftStudy(CLK:=bStudyExecute, Q=> );
IF rtStudy.Q THEN
	fbJogUnwind.Velocity:=2;
	bStudyFinish:=FALSE;
	bStudyExecute:=FALSE;
    studyStage:=1;
END_IF

IF ftStudy.Q THEN
	struckstudying:=FALSE;  
	bStudyFinish:=FALSE;
    studyStage:=40;
END_IF


CASE studyStage  OF 
	1:     //初始化
       	MEMSET(ADR(Table),0,SIZEOF(Table)); //  
		struckstudying:=TRUE;  
		structTime:=0;
		structPrinter:=1;  
		structAcc:=(fDancerMaxPos - fDancerMinPos)/100;  
	    studyStage := 2; 
   2:				
      IF fDanserDegree <= fDancerMinPos-1  THEN
		  iwindJog:=1;                         
          studyStage := 5; 
	  ELSE
	     iwindJog:=2;  
		 studyStage := 3; 
	  END_IF
   3:		  
      IF fDanserDegree < fDancerMinPos-1 THEN        
		  iwindJog:=1;                          
          studyStage := 5; 
	  END_IF	  	  
   5:	   
	IF Slave.Status.Moving AND Slave.Status.HasJob AND iwindJog=0 THEN 
		studyStage := 10;
	END_IF    
	10:
		ad_Set_test:=fDancerMinPos + structPrinter*structAcc;
		studyStage:=20;
	20:
(*
		IF 	ABS(fDanserDegree - ad_Set_test) < 0.2 THEN   
			structTime:=structTime+1;
	    ELSE
		    structTime:=0;
		END_IF
		IF structTime >= 3 THEN
			structTime:=0;
			structAxisPosPast := structAxisPosNow;  
			structAxisPosNow := Slave.NcToPlc.ActPos;   
			studyStage:=30;
		END_IF
*)
		IF 	fDanserDegree - ad_Set_test >0.1 THEN
			structAxisPosPast :=   structAxisPosNow;  
			structAxisPosNow :=  Slave.NcToPlc.ActPos;   
			studyStage:=30;
		END_IF

	30:
		IF structPrinter = 1 THEN
			Table[structPrinter - 1,1] := 0;
			Table[structPrinter - 1,2] := 0;
		 ELSE
			Table[structPrinter - 1,1] := ad_Set_test ; 
			Table[structPrinter - 1,2] := fStudyDiameter*PI/360*ABS((structAxisPosNow - structAxisPosPast)/gear) + Table[structPrinter - 2,2] ;
		END_IF
		structPrinter := structPrinter+1;
		
		IF structPrinter < 101  THEN
		 studyStage:=10;
		END_IF	
		 
		IF structPrinter = 101 OR ad_Set_test >= fDancerMaxPos THEN
            iwindJog:=3;
     		Table[0,1] := 0;//fDancerMinPos-10;
		    Table[0,2] := 0;//Table[1,2]-0.5;     
  
     		Table[100,1] := fDancerMaxPos+20;
		    Table[100,2] := Table[99,2]+0.5;     

			studyStage:=40;
		END_IF	
	40:
	        iwindJog:=3;
			bStudyExecute:=FALSE;
			bStudyFinish:=TRUE;
			struckstudying:=FALSE;
			studyStage:=0;
END_CASE

IF struckstudying AND  fDanserDegree>=fDancerMaxPos+4 AND  studyStage>=5 AND  Slave.Status.HasJob  THEN
	  iwindJog:=3;
	  studyStage:=0;
END_IF



















]]></ST>
      </Implementation>
    </Action>
